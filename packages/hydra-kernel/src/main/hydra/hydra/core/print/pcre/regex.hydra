## Per-dialect printer rendering the hydra.core.regex AST into the PCRE / java.util.regex / ECMA family syntax (Java, Scala, Clojure, Python, Common Lisp, TypeScript). Differs from the canonical hydra.core.print.regex in exactly one place: Hydra's . (any character INCLUDING newline) renders as [\s\S] rather than a bare . (whose native meaning excludes newline in these engines). All other productions match the canonical form. See docs/specification/regex.md and issue #567.
module hydra.core.print.pcre.regex

import hydra.core.lib.equality
import hydra.core.lib.lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.strings as strings
import hydra.core.regex

## Render an alternation, joining its branches with the | operator. Branches are ordered by descending rendered length so that PCRE/ECMA's leftmost-first matching agrees with Hydra's leftmost-longest semantics for fixed-length alternatives.
term alternation =
  λalt.
    let rendered := `map` regexSequence alt, byLength := sortBy strings.length rendered
    in strings.join "|" (reverse byLength)

## Render a single atom; the . metacharacter renders as [\s\S] to preserve newline-inclusive 'any'.
term atom =
  λa.cases(Atom){
      literal=λc.escapeLiteral c,
      any=λ`_`."[\\s\\S]",
      anchorStart=λ`_`."^",
      anchorEnd=λ`_`."$",
      group=λg.strings.concat ["(", alternation g, ")"],
      class=λcc.characterClass cc}
      a

## Render a character class, including the leading ^ for a negated class.
term characterClass =
  λcc.strings.concat
      ["[", ifElse (CharacterClass[negated] cc) "^" "", strings.concat (`map` classItem (CharacterClass[items] cc)), "]"]

## Render one character-class member (a single character or an inclusive range).
term classItem =
  λitem.cases(ClassItem){
      character=λc.escapeClassChar c,
      range=λr.strings.concat
            [escapeClassChar (CharacterRange[`from`] r), "-", escapeClassChar (CharacterRange[to] r)]}
      item

## Render a code point inside a character class, uniformly escaping the class metacharacters \ ] ^ -.
term escapeClassChar =
  λc.
    let isMeta := foldl (λacc,m.or acc (equal c m)) false [92:int32, 93:int32, 94:int32, 45:int32]
    in ifElse isMeta (strings.concat2 "\\" (printCodePoint c)) (printCodePoint c)

## Render a literal code point in top-level context, backslash-escaping PCRE/ECMA metacharacters.
term escapeLiteral =
  λc.
    let isMeta := foldl
        (λacc,m.or acc (equal c m))
        false
        [
          46:int32,
          94:int32,
          36:int32,
          42:int32,
          43:int32,
          63:int32,
          40:int32,
          41:int32,
          91:int32,
          93:int32,
          123:int32,
          125:int32,
          124:int32,
          92:int32]
    in ifElse isMeta (strings.concat2 "\\" (printCodePoint c)) (printCodePoint c)

## Render a single Unicode code point as a one-character string.
term printCodePoint = λc.strings.fromList [c]

## Render a hydra.core.regex AST into PCRE / java.util.regex / ECMA syntax. Identical to the canonical printer except that . (any incl. newline) becomes [\s\S].
term printRegex = λr.alternation r

## Render an atom followed by its quantifier suffix.
term quantified = λqa.strings.concat2 (atom (Quantified[atom] qa)) (quantifier (Quantified[quantifier] qa))

## Render a quantifier suffix; the 'one' quantifier renders as the empty string.
term quantifier =
  λq.cases(Quantifier){
      one=λ`_`."",
      zeroOrOne=λ`_`."?",
      zeroOrMore=λ`_`."*",
      oneOrMore=λ`_`."+",
      exactly=λn.strings.concat ["{", printInt32 n, "}"],
      atLeast=λn.strings.concat ["{", printInt32 n, ",}"],
      range=λr.strings.concat
            ["{", printInt32 (QuantifierRange[min] r), ",", printInt32 (QuantifierRange[max] r), "}"]}
      q

## Render a sequence of quantified atoms by concatenation.
term regexSequence = λs.strings.concat (`map` quantified s)