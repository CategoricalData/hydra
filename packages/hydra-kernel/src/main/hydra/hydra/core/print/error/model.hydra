## String representations of hydra.core.error.model types
module hydra.core.print.error.model

import hydra.core.error.model
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.print.variants

## Show a constant condition error as a string
term constantConditionError =
  λe.strings.concat ["constant condition: ifElse with literal ", printBoolean (ConstantConditionError[value] e)]

## Show a duplicate binding error as a string
term duplicateBindingError = λe.strings.concat ["duplicate binding: ", Name[] (DuplicateBindingError[name] e)]

## Show a duplicate field error as a string
term duplicateFieldError = λe.strings.concat ["duplicate field: ", Name[] (DuplicateFieldError[name] e)]

## Show a duplicate record type field names error as a string
term duplicateRecordTypeFieldNamesError =
  λe.strings.concat ["duplicate field in record type: ", Name[] (DuplicateRecordTypeFieldNamesError[name] e)]

## Show a duplicate union type field names error as a string
term duplicateUnionTypeFieldNamesError =
  λe.strings.concat ["duplicate field in union type: ", Name[] (DuplicateUnionTypeFieldNamesError[name] e)]

## Show an empty case statement error as a string
term emptyCaseStatementError =
  λe.strings.concat ["empty case statement for type: ", Name[] (EmptyCaseStatementError[typeName] e)]

## Show an empty let bindings error as a string
term emptyLetBindingsError = λe."let expression with no bindings"

## Show an empty record type error as a string
term emptyRecordTypeError = λe."record type with no fields (use TypeUnit instead)"

## Show an empty term annotation error as a string
term emptyTermAnnotationError = λe."term annotation with empty annotation map"

## Show an empty type annotation error as a string
term emptyTypeAnnotationError = λe."type annotation with empty annotation map"

## Show an empty type name in term error as a string
term emptyTypeNameInTermError = λe."term with empty type name"

## Show an empty union type error as a string
term emptyUnionTypeError = λe."union type with no alternatives (use TypeVoid instead)"

## Show an extra record fields error as a string
term extraRecordFieldsError =
  λe.
    let tname := ExtraRecordFieldsError[typeName] e in
    let fieldNames := ExtraRecordFieldsError[fieldNames] e in
    strings.concat
      [
        "record term for type ",
        Name[] tname,
        " supplies undeclared field(s): ",
        strings.join ", " (lists.map Name[] fieldNames)]

## Show an invalid forall parameter name error as a string
term invalidForallParameterNameError =
  λe.strings.concat ["invalid forall parameter name: ", Name[] (InvalidForallParameterNameError[name] e)]

## Show an invalid lambda parameter name error as a string
term invalidLambdaParameterNameError =
  λe.strings.concat ["invalid lambda parameter name: ", Name[] (InvalidLambdaParameterNameError[name] e)]

## Show an invalid let binding name error as a string
term invalidLetBindingNameError =
  λe.strings.concat ["invalid let binding name: ", Name[] (InvalidLetBindingNameError[name] e)]

## Show an invalid term error as a string
term invalidTermError =
  λe.strings.concat2
      "invalid term: "
      (cases(InvalidTermError){
        constantCondition=constantConditionError,
        duplicateBinding=duplicateBindingError,
        duplicateField=duplicateFieldError,
        emptyCaseStatement=emptyCaseStatementError,
        emptyLetBindings=emptyLetBindingsError,
        emptyTermAnnotation=emptyTermAnnotationError,
        emptyTypeNameInTerm=emptyTypeNameInTermError,
        extraRecordFields=extraRecordFieldsError,
        invalidLambdaParameterName=invalidLambdaParameterNameError,
        invalidLetBindingName=invalidLetBindingNameError,
        invalidTypeLambdaParameterName=invalidTypeLambdaParameterNameError,
        missingCaseBranches=missingCaseBranchesError,
        missingRecordFields=missingRecordFieldsError,
        nestedTermAnnotation=nestedTermAnnotationError,
        nominalTypeKindMismatch=nominalTypeKindMismatchError,
        redundantWrapUnwrap=redundantWrapUnwrapError,
        selfApplication=selfApplicationError,
        termVariableShadowing=termVariableShadowingError,
        typeVariableShadowingInTypeLambda=typeVariableShadowingInTypeLambdaError,
        undeclaredVariant=undeclaredVariantError,
        undefinedTermVariable=undefinedTermVariableError,
        undefinedTypeVariableInBindingType=undefinedTypeVariableInBindingTypeError,
        undefinedTypeVariableInLambdaDomain=undefinedTypeVariableInLambdaDomainError,
        undefinedTypeVariableInTypeApplication=undefinedTypeVariableInTypeApplicationError,
        unknownCaseAlternative=unknownCaseAlternativeError,
        unknownPrimitiveName=unknownPrimitiveNameError,
        unknownProjectedField=unknownProjectedFieldError,
        unnecessaryIdentityApplication=unnecessaryIdentityApplicationError,
        unresolvedNominalType=unresolvedNominalTypeError,
        untypedTermVariable=untypedTermVariableError}
        e)

## Show an invalid type error as a string
term invalidTypeError =
  λe.strings.concat2
      "invalid type: "
      (cases(InvalidTypeError){
        duplicateRecordTypeFieldNames=duplicateRecordTypeFieldNamesError,
        duplicateUnionTypeFieldNames=duplicateUnionTypeFieldNamesError,
        emptyRecordType=emptyRecordTypeError,
        emptyTypeAnnotation=emptyTypeAnnotationError,
        emptyUnionType=emptyUnionTypeError,
        invalidForallParameterName=invalidForallParameterNameError,
        invalidTypeSchemeVariableName=invalidTypeSchemeVariableNameError,
        nestedTypeAnnotation=nestedTypeAnnotationError,
        nonComparableMapKeyType=nonComparableMapKeyTypeError,
        nonComparableSetElementType=nonComparableSetElementTypeError,
        singleVariantUnion=singleVariantUnionError,
        typeVariableShadowingInForall=typeVariableShadowingInForallError,
        undefinedTypeVariable=undefinedTypeVariableError,
        voidInNonBottomPosition=voidInNonBottomPositionError}
        e)

## Show an invalid type lambda parameter name error as a string
term invalidTypeLambdaParameterNameError =
  λe.strings.concat ["invalid type lambda parameter name: ", Name[] (InvalidTypeLambdaParameterNameError[name] e)]

## Show an invalid type scheme variable name error as a string
term invalidTypeSchemeVariableNameError =
  λe.strings.concat ["invalid type scheme variable name: ", Name[] (InvalidTypeSchemeVariableNameError[name] e)]

## Show a missing case branches error as a string
term missingCaseBranchesError =
  λe.
    let tname := MissingCaseBranchesError[typeName] e in
    let variantNames := MissingCaseBranchesError[variantNames] e in
    strings.concat
      [
        "case statement for type ",
        Name[] tname,
        " does not cover variant(s): ",
        strings.join ", " (lists.map Name[] variantNames)]

## Show a missing record fields error as a string
term missingRecordFieldsError =
  λe.
    let tname := MissingRecordFieldsError[typeName] e in
    let fieldNames := MissingRecordFieldsError[fieldNames] e in
    strings.concat
      [
        "record term for type ",
        Name[] tname,
        " is missing declared field(s): ",
        strings.join ", " (lists.map Name[] fieldNames)]

## Show a nested term annotation error as a string
term nestedTermAnnotationError = λe."nested term annotations should be merged"

## Show a nested type annotation error as a string
term nestedTypeAnnotationError = λe."nested type annotations should be merged"

## Show a nominal type kind mismatch error as a string
term nominalTypeKindMismatchError =
  λe.
    let tname := NominalTypeKindMismatchError[typeName] e in
    let expected := NominalTypeKindMismatchError[expectedVariant] e in
    let actual := NominalTypeKindMismatchError[actualVariant] e in
    strings.concat
      [
        "type name ",
        Name[] tname,
        " is expected to be a ",
        typeVariant expected,
        " type, but resolves to a ",
        typeVariant actual,
        " type"]

## Show a non-comparable map key type error as a string
term nonComparableMapKeyTypeError =
  λe.strings.concat ["map key type contains a function type: ", `type` (NonComparableMapKeyTypeError[keyType] e)]

## Show a non-comparable set element type error as a string
term nonComparableSetElementTypeError =
  λe.strings.concat
      ["set element type contains a function type: ", `type` (NonComparableSetElementTypeError[elementType] e)]

## Show a redundant wrap/unwrap error as a string
term redundantWrapUnwrapError =
  λe.strings.concat ["redundant wrap/unwrap for type: ", Name[] (RedundantWrapUnwrapError[typeName] e)]

## Show a self-application error as a string
term selfApplicationError =
  λe.strings.concat ["self-application of variable: ", Name[] (SelfApplicationError[name] e)]

## Show a single variant union error as a string
term singleVariantUnionError =
  λe.strings.concat ["union type with single variant: ", Name[] (SingleVariantUnionError[fieldName] e)]

## Show a term variable shadowing error as a string
term termVariableShadowingError =
  λe.strings.concat ["variable shadowing: ", Name[] (TermVariableShadowingError[name] e)]

## Show a type variable shadowing in forall error as a string
term typeVariableShadowingInForallError =
  λe.strings.concat ["type variable shadowing in forall: ", Name[] (TypeVariableShadowingInForallError[name] e)]

## Show a type variable shadowing in type lambda error as a string
term typeVariableShadowingInTypeLambdaError =
  λe.strings.concat ["type variable shadowing in type lambda: ", Name[] (TypeVariableShadowingInTypeLambdaError[name] e)]

## Show an undeclared variant error as a string
term undeclaredVariantError =
  λe.
    let tname := UndeclaredVariantError[typeName] e in
    let vname := UndeclaredVariantError[variantName] e in
    strings.concat ["injected variant ", Name[] vname, " is not declared by union type ", Name[] tname]

## Show an undefined field error as a string
term undefinedFieldError =
  λe.
    let fname := UndefinedFieldError[fieldName] e in
    let tname := UndefinedFieldError[typeName] e in
    strings.concat ["no such field \"", Name[] fname, "\" in type \"", Name[] tname, "\""]

## Show an undefined term variable error as a string
term undefinedTermVariableError =
  λe.strings.concat ["undefined term variable: ", Name[] (UndefinedTermVariableError[name] e)]

## Show an undefined type variable error as a string
term undefinedTypeVariableError =
  λe.strings.concat ["undefined type variable: ", Name[] (UndefinedTypeVariableError[name] e)]

## Show an undefined type variable in binding type error as a string
term undefinedTypeVariableInBindingTypeError =
  λe.strings.concat
      ["undefined type variable in binding type: ", Name[] (UndefinedTypeVariableInBindingTypeError[name] e)]

## Show an undefined type variable in lambda domain error as a string
term undefinedTypeVariableInLambdaDomainError =
  λe.strings.concat
      ["undefined type variable in lambda domain: ", Name[] (UndefinedTypeVariableInLambdaDomainError[name] e)]

## Show an undefined type variable in type application error as a string
term undefinedTypeVariableInTypeApplicationError =
  λe.strings.concat
      ["undefined type variable in type application: ", Name[] (UndefinedTypeVariableInTypeApplicationError[name] e)]

## Show an unexpected term variant error as a string
term unexpectedTermVariantError =
  λe.
    let expected := UnexpectedTermVariantError[expectedVariant] e in
    let actual := UnexpectedTermVariantError[actualTerm] e in
    strings.concat ["expected ", termVariant expected, " term but found ", `term` actual]

## Show an unexpected type variant error as a string
term unexpectedTypeVariantError =
  λe.
    let expected := UnexpectedTypeVariantError[expectedVariant] e in
    let actual := UnexpectedTypeVariantError[actualType] e in
    strings.concat ["expected ", typeVariant expected, " type but found ", `type` actual]

## Show an unknown case alternative error as a string
term unknownCaseAlternativeError =
  λe.
    let tname := UnknownCaseAlternativeError[typeName] e in
    let name := UnknownCaseAlternativeError[name] e in
    strings.concat ["case alternative ", Name[] name, " is not a variant of type ", Name[] tname]

## Show an unknown primitive name error as a string
term unknownPrimitiveNameError = λe.strings.concat ["unknown primitive: ", Name[] (UnknownPrimitiveNameError[name] e)]

## Show an unknown projected field error as a string
term unknownProjectedFieldError =
  λe.
    let tname := UnknownProjectedFieldError[typeName] e in
    let fname := UnknownProjectedFieldError[fieldName] e in
    strings.concat ["projected field ", Name[] fname, " is not declared by record type ", Name[] tname]

## Show an unnecessary identity application error as a string
term unnecessaryIdentityApplicationError = λe."unnecessary application of identity lambda"

## Show an unresolved nominal type error as a string
term unresolvedNominalTypeError =
  λe.strings.concat ["type name does not resolve to any declared type: ", Name[] (UnresolvedNominalTypeError[typeName] e)]

## Show an untyped term variable error as a string
term untypedTermVariableError =
  λe.strings.concat ["untyped term variable: ", Name[] (UntypedTermVariableError[name] e)]

## Show a void in non-bottom position error as a string
term voidInNonBottomPositionError = λe."TypeVoid in a position where no value can be constructed"