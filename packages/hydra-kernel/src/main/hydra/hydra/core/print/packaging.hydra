## String representations of hydra.core.packaging types
module hydra.core.print.packaging

import hydra.core.analysis as analysis
import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic as logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math as math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering as ordering
import hydra.core.lib.pairs as pairs
import hydra.core.lib.strings as strings
import hydra.core.model as model
import hydra.core.names as names
import hydra.core.packaging as packaging
import hydra.core.print.model as print.model

## Build a candidate alias from the last n dotted segments of a module's full name
term aliasFromSuffix = λsegs,n.let dropCount := math.sub (lists.length segs) n in strings.join "." (lists.drop dropCount segs)

## Show a definition as a string, shortening nominal references via the given import-alias map (#803)
term definition = λaliases,def.cases(packaging.Definition){`primitive`=λpd.primitiveDefinition aliases pd, `term`=λtd.termDefinition aliases td, `type`=λtyd.typeDefinition aliases tyd} def

## Split a (possibly multi-line) string into '## '-prefixed doc-comment lines, one per embedded newline
term docCommentLinesOf = λs.lists.map (λln.strings.concat2 "## " ln) (strings.splitOn "\n" s)

## Show an EntityMetadata as a block of '##' doc-comment lines
term entityMetadataDoc = λem.let descLine := optionals.match (packaging.EntityMetadata[description] em) [] (λd.docCommentLinesOf d) in let commentBlocks := lists.concat (lists.map docCommentLinesOf (packaging.EntityMetadata[comments] em)) in let seeAlsoLines := lists.map (λref.strings.concat ["## @seeAlso ", entityReferenceDoc ref]) (packaging.EntityMetadata[seeAlso] em) in let lifecycleLines := optionals.match (packaging.EntityMetadata[lifecycle] em) [] (λlc.let avail := optionals.match (packaging.LifecycleInfo[availableSince] lc) [] (λv.[strings.concat2 "## @availableSince " (packaging.Version[] v)]) in let depr := optionals.match (packaging.LifecycleInfo[deprecatedSince] lc) [] (λv.[strings.concat2 "## @deprecatedSince " (packaging.Version[] v)]) in lists.concat2 avail depr) in let provisionLines := lists.map (λp.let localName := names.localNameOf (packaging.Provision[name] p), tag := cases(packaging.ProvisionKind){requirement=λ`_`."@requirement", recommendation=λ`_`."@recommendation"} (packaging.Provision[kind] p) in strings.concat ["## ", tag, " ", localName, ": ", packaging.Provision[statement] p]) (packaging.EntityMetadata[provisions] em) in let keyLines := lists.concat [seeAlsoLines, lifecycleLines, provisionLines] in let sections := lists.filter (λs.logic.not (lists.isEmpty s)) [descLine, commentBlocks, keyLines] in strings.join "\n##\n" (lists.map (λs.strings.join "\n" s) sections)

## Show an EntityReference using the type/term/primitive/module/package/term-expr/type-expr tags
term entityReferenceDoc = λref.cases(packaging.EntityReference){definition=λdefRef.cases(packaging.DefinitionReference){`type`=λn.strings.concat2 "type " (model.Name[] n), `term`=λn.strings.concat2 "term " (model.Name[] n), `primitive`=λn.strings.concat2 "primitive " (model.Name[] n)} defRef, `module`=λmn.strings.concat2 "module " (packaging.ModuleName[] mn), package=λpn.strings.concat2 "package " (packaging.PackageName[] pn), termExpr=λt.strings.concat2 "term-expr " t, typeExpr=λt.strings.concat2 "type-expr " t} ref

## One growth round of the alias-collision fixed point: colliding non-shortest members grow
term growAliasesStep = λsegsMap,state,`_ign`.let nss := maps.keys segsMap in let segsFor := λnm.optionals.withDefault [] (maps.lookup nm segsMap) in let takenFor := λnm.optionals.withDefault 1:int32 (maps.lookup nm state) in let entries := lists.map (λnm.let segs := segsFor nm, n := takenFor nm, segCount := lists.length segs, aliasStr := aliasFromSuffix segs n in (nm, (n, (segCount, aliasStr)))) nss in let aliasKey := λe.pairs.second (pairs.second (pairs.second e)) in let segCountOf := λe.pairs.first (pairs.second (pairs.second e)) in let aliasCounts := lists.foldl (λm,e.maps.insert (aliasKey e) (math.add 1:int32 (optionals.withDefault 0:int32 (maps.lookup (aliasKey e) m))) m) maps.empty entries in let aliasMinSegs := lists.foldl (λm,e.let k := aliasKey e in let segCount := segCountOf e in maps.insert k (optionals.match (maps.lookup k m) segCount (λprev.logic.ifElse (ordering.lt segCount prev) segCount prev)) m) maps.empty entries in let aliasMinSegsCount := lists.foldl (λm,e.let k := aliasKey e in let segCount := segCountOf e in let minSegs := optionals.withDefault segCount (maps.lookup k aliasMinSegs) in logic.ifElse (equality.equal segCount minSegs) (maps.insert k (math.add 1:int32 (optionals.withDefault 0:int32 (maps.lookup k m))) m) m) maps.empty entries in maps.fromList (lists.map (λe.let nm := pairs.first e in let n := pairs.first (pairs.second e) in let segCount := segCountOf e in let aliasStr := aliasKey e in let count := optionals.withDefault 0:int32 (maps.lookup aliasStr aliasCounts) in let minSegs := optionals.withDefault segCount (maps.lookup aliasStr aliasMinSegs) in let minSegsCount := optionals.withDefault 0:int32 (maps.lookup aliasStr aliasMinSegsCount) in let canGrow := logic.and (ordering.gt count 1:int32) (logic.and (ordering.gt segCount n) (logic.or (ordering.gt segCount minSegs) (ordering.gt minSegsCount 1:int32))) in (nm, logic.ifElse canGrow (math.add n 1:int32) n)) entries)

## Show a module dependency as an import declaration, using the given alias map
term importDecl = λaliases,d.let depMod := packaging.ModuleDependency[`module`] d in let modNameStr := moduleNameString depMod in let aliasSuffix := optionals.match (maps.lookup depMod aliases) "" (λalias.logic.ifElse (strings.isEmpty alias) "" (strings.concat [" as ", alias])) in let pkgSuffix := optionals.match (packaging.ModuleDependency[package] d) "" (λpkg.strings.concat [" from ", packaging.PackageName[] pkg]) in strings.concat ["import ", modNameStr, aliasSuffix, pkgSuffix]

## Compute the printing alias for every module referenced by the given module's definitions, plus the module's own namespace (mapped to the empty alias, for self-reference shortening, #711)
term moduleAliases = λmod.let ownNs := packaging.Module[name] mod in let defs := packaging.Module[definitions] mod in let namesByModRaw := analysis.definitionDependencyNamesByModule defs in let namesByMod := maps.delete ownNs namesByModRaw in let nssAsList := lists.sortBy (λnm.packaging.ModuleName[] nm) (maps.keys namesByMod) in let aliasedList := nssAsList in let segmentsOf := λnm.strings.splitOn "." (packaging.ModuleName[] nm) in let segsMap := maps.fromList (lists.map (λnm.(nm, segmentsOf nm)) aliasedList) in let maxSegs := lists.foldl (λa,b.logic.ifElse (ordering.gt a b) a b) 1:int32 (lists.map (λnm.lists.length (segmentsOf nm)) aliasedList) in let initialState := maps.fromList (lists.map (λnm.(nm, 1:int32)) aliasedList) in let finalState := lists.foldl (growAliasesStep segsMap) initialState (lists.replicate maxSegs unit) in let otherAliases := maps.fromList (lists.map (λnm.(nm, aliasFromSuffix (optionals.withDefault [] (maps.lookup nm segsMap)) (optionals.withDefault 1:int32 (maps.lookup nm finalState)))) nssAsList) in maps.insert ownNs "" otherAliases

## Show a module as a string
term moduleDefinition = λmod.let headerStr := withDefinitionDoc (packaging.Module[metadata] mod) (strings.concat ["module ", moduleNameString (packaging.Module[name] mod)]) in let aliases := moduleAliases mod in let declaredByModule := maps.fromList (lists.map (λd.(packaging.ModuleDependency[`module`] d, d)) (packaging.Module[dependencies] mod)) in let ownNs := packaging.Module[name] mod in let usedDeps := lists.map (λnm.maps.findWithDefault packaging.ModuleDependency{`module` = nm, package = none} nm declaredByModule) (lists.filter (λnm.logic.not (equality.equal nm ownNs)) (maps.keys aliases)) in let importStrs := lists.map (importDecl aliases) usedDeps in let defStrs := lists.map (definition aliases) (packaging.Module[definitions] mod) in let sections := logic.ifElse (lists.isEmpty importStrs) defStrs (lists.cons (strings.join "\n" importStrs) defStrs) in strings.join "\n\n" (lists.cons headerStr sections)

## Show a module name as a string
term moduleNameString = λn.packaging.ModuleName[] n

## Show a primitive definition as a string, shortening nominal references via the given import-alias map (#803)
term primitiveDefinition = λaliases,pd.let localName := names.localNameOf (packaging.PrimitiveDefinition[name] pd) in let impureStr := logic.ifElse (packaging.PrimitiveDefinition[isPure] pd) "" "impure " in let partialStr := logic.ifElse (packaging.PrimitiveDefinition[isTotal] pd) "" "partial " in let sigStr := print.model.termSignatureAliased aliases (packaging.PrimitiveDefinition[signature] pd) in let implStr := optionals.match (packaging.PrimitiveDefinition[defaultImplementation] pd) "" (λimpl.strings.concat [" = ", print.model.termAliased aliases impl]) in withDefinitionDoc (packaging.PrimitiveDefinition[metadata] pd) (strings.concat [impureStr, partialStr, "primitive ", localName, " : ", sigStr, implStr])

## Show a term definition as a string, shortening nominal references via the given import-alias map (#803)
term termDefinition = λaliases,td.let localName := names.localNameOf (packaging.TermDefinition[name] td) in let sigStr := optionals.match (packaging.TermDefinition[signature] td) " " (λsig.strings.concat [" : ", print.model.termSignatureAliased aliases sig, " "]) in let peeled := print.model.peelTermDescriptionAnnotation (packaging.TermDefinition[body] td) in let mdesc := pairs.first peeled in let bodyStr := print.model.termAliased aliases (pairs.second peeled) in let declStr := strings.concat ["term ", localName, sigStr, "= ", bodyStr] in let withDescDoc := optionals.match mdesc declStr (λd.strings.concat [strings.join "\n" (docCommentLinesOf d), "\n", declStr]) in withDefinitionDoc (packaging.TermDefinition[metadata] td) withDescDoc

## Show a type definition as a string, shortening nominal references via the given import-alias map (#803)
term typeDefinition = λaliases,td.let localName := names.localNameOf (packaging.TypeDefinition[name] td) in let scheme := packaging.TypeDefinition[body] td in let body := model.TypeScheme[body] scheme in let peeled := print.model.peelDescriptionAnnotation body in let mdesc := pairs.first peeled in let unwrappedScheme := model.TypeScheme{variables = model.TypeScheme[variables] scheme, body = pairs.second peeled, constraints = model.TypeScheme[constraints] scheme} in let typeStr := print.model.typeSchemeAliased aliases unwrappedScheme in let declStr := strings.concat ["type ", localName, " = ", typeStr] in let withDescDoc := optionals.match mdesc declStr (λd.strings.concat [strings.join "\n" (docCommentLinesOf d), "\n", declStr]) in withDefinitionDoc (packaging.TypeDefinition[metadata] td) withDescDoc

## Prepend a definition's '##' doc-comment block to its printed declaration, if present
term withDefinitionDoc = λmmeta,declStr.optionals.match mmeta declStr (λmeta.let docBlock := entityMetadataDoc meta in logic.ifElse (strings.isEmpty docBlock) declStr (strings.concat [docBlock, "\n", declStr]))