## String representations of hydra.core.packaging types
module hydra.core.print.packaging

import hydra.core.analysis
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math
import hydra.core.lib.optionals
import hydra.core.lib.ordering
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.names
import hydra.core.packaging
import hydra.core.print.model
import hydra.core.serialization

## Build a candidate alias from the last n dotted segments of a module's full name
term aliasFromSuffix =
  λsegs,n.let dropCount := sub (lists.length segs) n in strings.join "." (lists.drop dropCount segs)

## Show a definition as a string, shortening nominal references via the given import-alias map (#803)
term definition =
  λaliases,def.cases(Definition){
      `primitive`=λpd.primitiveDefinition aliases pd,
      `term`=λtd.termDefinition aliases td,
      `type`=λtyd.typeDefinition aliases tyd}
      def

## Split a (possibly multi-line) string into '## '-prefixed doc-comment lines, one per embedded newline
term docCommentLinesOf = λs.lists.map (λln.strings.concat2 "## " ln) (strings.splitOn "\n" s)

## Show an EntityMetadata as a block of '##' doc-comment lines
term entityMetadataDoc =
  λem.
    let descLine := match (EntityMetadata[description] em) [] (λd.docCommentLinesOf d) in
    let commentBlocks := lists.concat (lists.map docCommentLinesOf (EntityMetadata[comments] em)) in
    let seeAlsoLines := lists.map
        (λref.strings.concat ["## @seeAlso ", entityReferenceDoc ref])
        (EntityMetadata[seeAlso] em) in
    let lifecycleLines := match
        (EntityMetadata[lifecycle] em)
        []
        (λlc.
          let avail := match
              (LifecycleInfo[availableSince] lc)
              []
              (λv.[strings.concat2 "## @availableSince " (Version[] v)]) in
          let depr := match
              (LifecycleInfo[deprecatedSince] lc)
              []
              (λv.[strings.concat2 "## @deprecatedSince " (Version[] v)]) in
          lists.concat2 avail depr) in
    let provisionLines := lists.map
        (λp.
          let localName := localNameOf (Provision[name] p), tag := cases(ProvisionKind){requirement=λ`_`."@requirement", recommendation=λ`_`."@recommendation"}
              (Provision[kind] p)
          in strings.concat ["## ", tag, " ", localName, ": ", Provision[statement] p])
        (EntityMetadata[provisions] em) in
    let keyLines := lists.concat [seeAlsoLines, lifecycleLines, provisionLines] in
    let sections := lists.filter (λs.not (lists.isEmpty s)) [descLine, commentBlocks, keyLines] in
    strings.join "\n##\n" (lists.map (λs.strings.join "\n" s) sections)

## Show an EntityReference using the type/term/primitive/module/package/term-expr/type-expr tags
term entityReferenceDoc =
  λref.cases(EntityReference){
      definition=λdefRef.cases(DefinitionReference){
            `type`=λn.strings.concat2 "type " (Name[] n),
            `term`=λn.strings.concat2 "term " (Name[] n),
            `primitive`=λn.strings.concat2 "primitive " (Name[] n)}
            defRef,
      `module`=λmn.strings.concat2 "module " (ModuleName[] mn),
      package=λpn.strings.concat2 "package " (PackageName[] pn),
      termExpr=λt.strings.concat2 "term-expr " t,
      typeExpr=λt.strings.concat2 "type-expr " t}
      ref

## One growth round of the alias-collision fixed point: colliding non-shortest members grow
term growAliasesStep =
  λsegsMap,state,`_ign`.
    let nss := maps.keys segsMap in
    let segsFor := λnm.withDefault [] (maps.lookup nm segsMap) in
    let takenFor := λnm.withDefault 1:int32 (maps.lookup nm state) in
    let entries := lists.map
        (λnm.
          let segs := segsFor nm, n := takenFor nm, segCount := lists.length segs, aliasStr := aliasFromSuffix segs n
          in (nm, (n, (segCount, aliasStr))))
        nss in
    let aliasKey := λe.second (second (second e)) in
    let segCountOf := λe.first (second (second e)) in
    let aliasCounts := lists.foldl
        (λm,e.maps.insert
            (aliasKey e)
            (add 1:int32 (withDefault 0:int32 (maps.lookup (aliasKey e) m)))
            m)
        maps.empty
        entries in
    let aliasMinSegs := lists.foldl
        (λm,e.
          let k := aliasKey e in
          let segCount := segCountOf e in
          maps.insert
            k
            (match
              (maps.lookup k m)
              segCount
              (λprev.ifElse (lt segCount prev) segCount prev))
            m)
        maps.empty
        entries in
    let aliasMinSegsCount := lists.foldl
        (λm,e.
          let k := aliasKey e in
          let segCount := segCountOf e in
          let minSegs := withDefault segCount (maps.lookup k aliasMinSegs) in
          ifElse
            (equal segCount minSegs)
            (maps.insert
              k
              (add 1:int32 (withDefault 0:int32 (maps.lookup k m)))
              m)
            m)
        maps.empty
        entries in
    maps.fromList
      (lists.map
        (λe.
          let nm := first e in
          let n := first (second e) in
          let segCount := segCountOf e in
          let aliasStr := aliasKey e in
          let count := withDefault 0:int32 (maps.lookup aliasStr aliasCounts) in
          let minSegs := withDefault segCount (maps.lookup aliasStr aliasMinSegs) in
          let minSegsCount := withDefault 0:int32 (maps.lookup aliasStr aliasMinSegsCount) in
          let canGrow := and
              (gt count 1:int32)
              (and (gt segCount n) (or (gt segCount minSegs) (gt minSegsCount 1:int32))) in
          (nm, ifElse canGrow (add n 1:int32) n))
        entries)

## Show a module dependency as an import declaration, using the given alias map
term importDecl =
  λaliases,d.
    let depMod := ModuleDependency[`module`] d in
    let modNameStr := moduleNameString depMod in
    let aliasSuffix := match
        (maps.lookup depMod aliases)
        ""
        (λalias.ifElse (strings.isEmpty alias) "" (strings.concat [" as ", alias])) in
    let pkgSuffix := match (ModuleDependency[package] d) "" (λpkg.strings.concat [" from ", PackageName[] pkg]) in
    strings.concat ["import ", modNameStr, aliasSuffix, pkgSuffix]

## Compute the printing alias for every module referenced by the given module's definitions, plus the module's own namespace (mapped to the empty alias, for self-reference shortening, #711); context-free, so every real dependency stays aliased
term moduleAliases = λmod.moduleAliasesWith maps.empty mod

## Compute the printing alias for every module referenced by the given module's definitions, given the full declared-name universe of modules in scope (#5/#711); the printed module's own namespace is always mapped to the empty alias for self-reference shortening (#711/#803)
term moduleAliasesWith =
  λuniverse,mod.
    let ownNs := Module[name] mod in
    let defs := Module[definitions] mod in
    let namesByModRaw := definitionDependencyNamesByModule defs in
    let namesByMod := maps.delete ownNs namesByModRaw in
    let nssAsList := lists.sortBy (λnm.ModuleName[] nm) (maps.keys namesByMod) in
    let ownLocalNames := sets.fromList
        (lists.map
          (λdef.localNameOf
              (cases(Definition){
                `type`=λtd.TypeDefinition[name] td,
                `term`=λtd.TermDefinition[name] td,
                `primitive`=λpd.PrimitiveDefinition[name] pd}
                def))
          defs) in
    let declaredImportNames := nssAsList in
    let otherLocalNamesExcluding := λd.sets.unions
          (lists.cons
            ownLocalNames
            (lists.map
              (λother.sets.map
                  localNameOf
                  (withDefault sets.empty (maps.lookup other universe)))
              (lists.filter (λnm.not (equal nm d)) declaredImportNames))) in
    let allBinderLocalNames := sets.map localNameOf (allBinderNamesInDefinitions defs) in
    let isSafeBare := λd.match
          (maps.lookup d universe)
          false
          (λdeclaredNames.
            let declaredLocalNames := sets.map localNameOf declaredNames in
            let referencedLocalNames := maps.keys
                (withDefault
                  maps.empty
                  (maps.lookup d namesByMod)) in
            let otherLocalNames := otherLocalNamesExcluding d in
            let isUnsafe := λlocal.not
                  (and
                    (sets.member local declaredLocalNames)
                    (and
                      (not (sets.member local otherLocalNames))
                      (not (sets.member local allBinderLocalNames)))) in
            lists.isEmpty (lists.filter isUnsafe referencedLocalNames)) in
    let bareList := lists.filter isSafeBare nssAsList in
    let aliasedList := lists.filter (λnm.not (isSafeBare nm)) nssAsList in
    let segmentsOf := λnm.strings.splitOn "." (ModuleName[] nm) in
    let segsMap := maps.fromList (lists.map (λnm.(nm, segmentsOf nm)) aliasedList) in
    let maxSegs := lists.foldl
        (λa,b.ifElse (gt a b) a b)
        1:int32
        (lists.map (λnm.lists.length (segmentsOf nm)) aliasedList) in
    let initialState := maps.fromList (lists.map (λnm.(nm, 1:int32)) aliasedList) in
    let finalState := lists.foldl (growAliasesStep segsMap) initialState (lists.replicate maxSegs unit) in
    let bareAliases := maps.fromList (lists.map (λnm.(nm, "")) bareList) in
    let aliasedAliases := maps.fromList
        (lists.map
          (λnm.(nm, aliasFromSuffix (withDefault [] (maps.lookup nm segsMap)) (withDefault 1:int32 (maps.lookup nm finalState))))
          aliasedList) in
    let otherAliases := maps.union bareAliases aliasedAliases in
    maps.insert ownNs "" otherAliases

## Show a module as a string; context-free, so every real dependency stays aliased with a printed import line
term moduleDefinition = λmod.moduleDefinitionWith maps.empty mod

## Show a module as a string, given the full declared-name universe of modules in scope (#5/#711)
term moduleDefinitionWith =
  λuniverse,mod.
    let headerStr := withDefinitionDoc
        (Module[metadata] mod)
        (strings.concat ["module ", moduleNameString (Module[name] mod)]) in
    let aliases := moduleAliasesWith universe mod in
    let declaredByModule := maps.fromList
        (lists.map (λd.(ModuleDependency[`module`] d, d)) (Module[dependencies] mod)) in
    let ownNs := Module[name] mod in
    let usedDeps := lists.map
        (λnm.maps.findWithDefault
            ModuleDependency{`module` = nm, package = none}
            nm
            declaredByModule)
        (lists.filter (λnm.not (equal nm ownNs)) (maps.keys aliases)) in
    let importStrs := lists.map (importDecl aliases) usedDeps in
    let defStrs := lists.map (definition aliases) (Module[definitions] mod) in
    let sections := ifElse
        (lists.isEmpty importStrs)
        defStrs
        (lists.cons (strings.join "\n" importStrs) defStrs) in
    strings.join "\n\n" (lists.cons headerStr sections)

## Show a module name as a string
term moduleNameString = λn.ModuleName[] n

## Show a primitive definition as a string, shortening nominal references via the given import-alias map (#803)
term primitiveDefinition =
  λaliases,pd.
    let localName := localNameOf (PrimitiveDefinition[name] pd) in
    let impureStr := ifElse (PrimitiveDefinition[isPure] pd) "" "impure " in
    let partialStr := ifElse (PrimitiveDefinition[isTotal] pd) "" "partial " in
    let sigStr := termSignatureAliased aliases (PrimitiveDefinition[signature] pd) in
    let implStr := match
        (PrimitiveDefinition[defaultImplementation] pd)
        ""
        (λimpl.strings.concat [" = ", termAliased aliases impl]) in
    withDefinitionDoc
      (PrimitiveDefinition[metadata] pd)
      (strings.concat [impureStr, partialStr, "primitive ", localName, " : ", sigStr, implStr])

## Show a term definition as a string, shortening nominal references via the given import-alias map (#803)
term termDefinition =
  λaliases,td.
    let localName := localNameOf (TermDefinition[name] td) in
    let sigStr := match
        (TermDefinition[signature] td)
        " "
        (λsig.strings.concat [" : ", termSignatureAliased aliases sig, " "]) in
    let peeled := peelTermDescriptionAnnotation (TermDefinition[body] td) in
    let mdesc := first peeled in
    let body := second peeled in
    let headStr := strings.concat ["term ", localName, sigStr, "="] in
    let inlineBudget := sub maxLineWidth (add (strings.length headStr) 1:int32) in
    let inlineBodyExpr := termExprAtPrecBudget inlineBudget aliases 0:int32 body in
    let declStr := ifElse
        (lte (expressionLength inlineBodyExpr) inlineBudget)
        (strings.concat [headStr, " ", printExpr inlineBodyExpr])
        (let blockBodyExpr := termExprAtPrecBudget maxLineWidth aliases 0:int32 body
        in strings.concat [headStr, "\n", customIndent doubleSpace (printExpr blockBodyExpr)]) in
    let withDescDoc := match
        mdesc
        declStr
        (λd.strings.concat [strings.join "\n" (docCommentLinesOf d), "\n", declStr]) in
    withDefinitionDoc (TermDefinition[metadata] td) withDescDoc

## Show a type definition as a string, shortening nominal references via the given import-alias map (#803)
term typeDefinition =
  λaliases,td.
    let localName := localNameOf (TypeDefinition[name] td) in
    let scheme := TypeDefinition[body] td in
    let body := TypeScheme[body] scheme in
    let peeled := peelDescriptionAnnotation body in
    let mdesc := first peeled in
    let unwrappedScheme := TypeScheme{
      variables = TypeScheme[variables] scheme,
      body = second peeled,
      constraints = TypeScheme[constraints] scheme} in
    let typeStr := typeSchemeAliased aliases unwrappedScheme in
    let declStr := strings.concat ["type ", localName, " = ", typeStr] in
    let withDescDoc := match
        mdesc
        declStr
        (λd.strings.concat [strings.join "\n" (docCommentLinesOf d), "\n", declStr]) in
    withDefinitionDoc (TypeDefinition[metadata] td) withDescDoc

## Prepend a definition's '##' doc-comment block to its printed declaration, if present
term withDefinitionDoc =
  λmmeta,declStr.match
      mmeta
      declStr
      (λmeta.
        let docBlock := entityMetadataDoc meta
        in ifElse (strings.isEmpty docBlock) declStr (strings.concat [docBlock, "\n", declStr]))