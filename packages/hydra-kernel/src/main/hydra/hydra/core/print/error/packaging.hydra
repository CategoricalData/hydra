## String representations of hydra.core.error.packaging types
module hydra.core.print.error.packaging

import hydra.core.error.packaging
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.packaging
import hydra.core.print.util

## Show a conflicting module namespace error as a string
term conflictingModuleNameError =
  λe.concat
      [
        "module namespaces conflict when mapped to target language path: ",
        ModuleName[] (ConflictingModuleNameError[first] e),
        " vs ",
        ModuleName[] (ConflictingModuleNameError[second] e)]

## Show a conflicting variant name error as a string
term conflictingVariantNameError =
  λe.concat
      [
        "in module ",
        ModuleName[] (ConflictingVariantNameError[moduleName] e),
        ": variant ",
        Name[] (ConflictingVariantNameError[variantName] e),
        " of type ",
        Name[] (ConflictingVariantNameError[typeName] e),
        " produces constructor name ",
        Name[] (ConflictingVariantNameError[conflictingName] e),
        " which conflicts with another type definition"]

## Show a definition-not-in-module-namespace error as a string
term definitionNotInModuleNameError =
  λe.concat
      [
        "definition ",
        Name[] (DefinitionNotInModuleNameError[name] e),
        " is not in module namespace ",
        ModuleName[] (DefinitionNotInModuleNameError[moduleName] e)]

## Show a definitions-out-of-order error as a string
term definitionsOutOfOrderError =
  λe.concat
      [
        "in module ",
        ModuleName[] (DefinitionsOutOfOrderError[moduleName] e),
        ": definitions out of order: ",
        Name[] (DefinitionsOutOfOrderError[precedingName] e),
        " precedes ",
        Name[] (DefinitionsOutOfOrderError[followingName] e)]

## Show a duplicate definition name error as a string
term duplicateDefinitionNameError =
  λe.concat
      [
        "in module ",
        ModuleName[] (DuplicateDefinitionNameError[moduleName] e),
        ": duplicate definition name ",
        Name[] (DuplicateDefinitionNameError[name] e)]

## Show a duplicate module namespace error as a string
term duplicateModuleNameError =
  λe.concat ["duplicate module namespace ", ModuleName[] (DuplicateModuleNameError[moduleName] e)]

## Show an invalid definition name error as a string
term invalidDefinitionNameError =
  λe.concat
      [
        "in module ",
        ModuleName[] (InvalidDefinitionNameError[moduleName] e),
        ": definition ",
        Name[] (InvalidDefinitionNameError[name] e),
        " does not match expected ",
        caseConvention (InvalidDefinitionNameError[expectedConvention] e)]

## Show an invalid module error as a string
term invalidModuleError =
  λe.concat2
      "invalid module: "
      (cases(InvalidModuleError){
        conflictingVariantName=conflictingVariantNameError,
        definitionNotInModuleName=definitionNotInModuleNameError,
        definitionsOutOfOrder=definitionsOutOfOrderError,
        duplicateDefinitionName=duplicateDefinitionNameError,
        invalidDefinitionName=invalidDefinitionNameError,
        invalidModuleNameConvention=invalidModuleNameConventionError,
        missingDocumentation=missingDocumentationError}
        e)

## Show an invalid namespace convention error as a string
term invalidModuleNameConventionError =
  λe.concat
      [
        "namespace ",
        ModuleName[] (InvalidModuleNameConventionError[moduleName] e),
        " does not match the dotted-camelCase naming convention"]

## Show an invalid package error as a string
term invalidPackageError =
  λe.concat2
      "invalid package: "
      (cases(InvalidPackageError){
        conflictingModuleName=conflictingModuleNameError,
        duplicateModuleName=duplicateModuleNameError,
        invalidModule=invalidModuleError,
        invalidPackageName=invalidPackageNameError,
        moduleInMultiplePackages=moduleInMultiplePackagesError,
        nestedModuleName=nestedModuleNameError,
        undeclaredDependency=undeclaredDependencyError}
        e)

## Show an invalid package name error as a string
term invalidPackageNameError =
  λe.concat
      [
        "package name ",
        PackageName[] (InvalidPackageNameError[packageName] e),
        " does not match the hyphen-separated lowercase naming convention"]

## Show a missing documentation error as a string
term missingDocumentationError =
  λe.concat
      [
        "in module ",
        ModuleName[] (MissingDocumentationError[moduleName] e),
        ": definition ",
        Name[] (MissingDocumentationError[name] e),
        " lacks a description annotation"]

## Show a module-in-multiple-packages error as a string
term moduleInMultiplePackagesError =
  λe.concat
      [
        "module namespace ",
        ModuleName[] (ModuleInMultiplePackagesError[moduleName] e),
        " is declared by more than one package: ",
        PackageName[] (ModuleInMultiplePackagesError[firstPackage] e),
        " vs ",
        PackageName[] (ModuleInMultiplePackagesError[secondPackage] e)]

## Show a nested module name error as a string
term nestedModuleNameError =
  λe.concat
      [
        "module namespace ",
        ModuleName[] (NestedModuleNameError[outer] e),
        " is a strict dotted-prefix of module namespace ",
        ModuleName[] (NestedModuleNameError[inner] e)]

## Show an undeclared dependency error as a string
term undeclaredDependencyError =
  λe.concat
      [
        "module ",
        ModuleName[] (UndeclaredDependencyError[moduleName] e),
        " references ",
        Name[] (UndeclaredDependencyError[referencedName] e),
        ", whose owning module ",
        ModuleName[] (UndeclaredDependencyError[owningModuleName] e),
        " is not among its declared dependencies; add it to moduleDependencies"]