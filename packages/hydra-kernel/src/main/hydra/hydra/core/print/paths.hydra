## Serialization (printing and parsing) of subterm and subtype steps and paths.
module hydra.core.print.paths

import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.optionals as optionals
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.paths

## Parse a printed subterm path (steps joined by '/') back into a SubtermPath
term parseSubtermPath =
  λs.optionals.map
      (λx.wrap(SubtermPath){x})
      (lists.foldl
        (λmacc,tok.optionals.bind macc (λacc.optionals.map (λst.lists.concat2 acc [st]) (parseSubtermStep tok)))
        given([])
        (strings.splitOn "/" s))

## Parse a printed subterm step token back into a SubtermStep
term parseSubtermStep =
  λtok.
    let segs := strings.splitOn ":" tok in
    let tag := optionals.withDefault tok (lists.at 0:int32 segs) in
    let mpayload := lists.at 1:int32 segs in
    let name := optionals.map (λx.wrap(Name){x}) mpayload in
    let idx := optionals.bind mpayload parseInt32 in
    ifElse
      (equal tag "annotatedAnnotation")
      given(SubtermStep{annotatedAnnotation})
      (ifElse
        (equal tag "annotatedBody")
        given(SubtermStep{annotatedBody})
        (ifElse
          (equal tag "applicationArgument")
          given(SubtermStep{applicationArgument})
          (ifElse
            (equal tag "applicationFunction")
            given(SubtermStep{applicationFunction})
            (ifElse
              (equal tag "casesCase")
              (optionals.map (λx.SubtermStep{casesCase = x}) name)
              (ifElse
                (equal tag "casesDefault")
                given(SubtermStep{casesDefault})
                (ifElse
                  (equal tag "eitherLeft")
                  given(SubtermStep{eitherLeft})
                  (ifElse
                    (equal tag "eitherRight")
                    given(SubtermStep{eitherRight})
                    (ifElse
                      (equal tag "injectField")
                      (optionals.map (λx.SubtermStep{injectField = x}) name)
                      (ifElse
                        (equal tag "lambdaBody")
                        given(SubtermStep{lambdaBody})
                        (ifElse
                          (equal tag "letBinding")
                          (optionals.map (λx.SubtermStep{letBinding = x}) name)
                          (ifElse
                            (equal tag "letBody")
                            given(SubtermStep{letBody})
                            (ifElse
                              (equal tag "listElement")
                              (optionals.map (λx.SubtermStep{listElement = x}) idx)
                              (ifElse
                                (equal tag "mapEntry")
                                (optionals.map (λx.SubtermStep{mapEntry = x}) idx)
                                (ifElse
                                  (equal tag "optionalGiven")
                                  given(SubtermStep{optionalGiven})
                                  (ifElse
                                    (equal tag "pairFirst")
                                    given(SubtermStep{pairFirst})
                                    (ifElse
                                      (equal tag "pairSecond")
                                      given(SubtermStep{pairSecond})
                                      (ifElse
                                        (equal tag "recordField")
                                        (optionals.map (λx.SubtermStep{recordField = x}) name)
                                        (ifElse
                                          (equal tag "setElement")
                                          (optionals.map (λx.SubtermStep{setElement = x}) idx)
                                          (ifElse
                                            (equal tag "typeApplicationBody")
                                            given(SubtermStep{typeApplicationBody})
                                            (ifElse
                                              (equal tag "typeLambdaBody")
                                              given(SubtermStep{typeLambdaBody})
                                              (ifElse (equal tag "wrapBody") given(SubtermStep{wrapBody}) none)))))))))))))))))))))

## Parse a printed subtype path (steps joined by '/') back into a SubtypePath
term parseSubtypePath =
  λs.optionals.map
      (λx.wrap(SubtypePath){x})
      (lists.foldl
        (λmacc,tok.optionals.bind macc (λacc.optionals.map (λst.lists.concat2 acc [st]) (parseSubtypeStep tok)))
        given([])
        (strings.splitOn "/" s))

## Parse a printed subtype step token back into a SubtypeStep
term parseSubtypeStep =
  λtok.
    let segs := strings.splitOn ":" tok in
    let tag := optionals.withDefault tok (lists.at 0:int32 segs) in
    let mpayload := lists.at 1:int32 segs in
    let name := optionals.map (λx.wrap(Name){x}) mpayload in
    ifElse
      (equal tag "annotatedBody")
      given(SubtypeStep{annotatedBody})
      (ifElse
        (equal tag "applicationArgument")
        given(SubtypeStep{applicationArgument})
        (ifElse
          (equal tag "applicationFunction")
          given(SubtypeStep{applicationFunction})
          (ifElse
            (equal tag "effectValue")
            given(SubtypeStep{effectValue})
            (ifElse
              (equal tag "eitherLeft")
              given(SubtypeStep{eitherLeft})
              (ifElse
                (equal tag "eitherRight")
                given(SubtypeStep{eitherRight})
                (ifElse
                  (equal tag "forallBody")
                  given(SubtypeStep{forallBody})
                  (ifElse
                    (equal tag "functionCodomain")
                    given(SubtypeStep{functionCodomain})
                    (ifElse
                      (equal tag "functionDomain")
                      given(SubtypeStep{functionDomain})
                      (ifElse
                        (equal tag "listElement")
                        given(SubtypeStep{listElement})
                        (ifElse
                          (equal tag "mapKeys")
                          given(SubtypeStep{mapKeys})
                          (ifElse
                            (equal tag "mapValues")
                            given(SubtypeStep{mapValues})
                            (ifElse
                              (equal tag "optionalElement")
                              given(SubtypeStep{optionalElement})
                              (ifElse
                                (equal tag "pairFirst")
                                given(SubtypeStep{pairFirst})
                                (ifElse
                                  (equal tag "pairSecond")
                                  given(SubtypeStep{pairSecond})
                                  (ifElse
                                    (equal tag "recordField")
                                    (optionals.map (λx.SubtypeStep{recordField = x}) name)
                                    (ifElse
                                      (equal tag "setElement")
                                      given(SubtypeStep{setElement})
                                      (ifElse
                                        (equal tag "unionField")
                                        (optionals.map (λx.SubtypeStep{unionField = x}) name)
                                        (ifElse (equal tag "wrapBody") given(SubtypeStep{wrapBody}) none))))))))))))))))))

## Print a subterm path as its steps joined by '/'
term subtermPath = λpath.strings.join "/" (lists.map subtermStep (SubtermPath[] path))

## Print a subterm step in its round-trippable notation
term subtermStep =
  λstep.cases(SubtermStep){
      annotatedAnnotation=λ`_`."annotatedAnnotation",
      annotatedBody=λ`_`."annotatedBody",
      applicationArgument=λ`_`."applicationArgument",
      applicationFunction=λ`_`."applicationFunction",
      casesCase=λname.strings.concat2 "casesCase:" (Name[] name),
      casesDefault=λ`_`."casesDefault",
      eitherLeft=λ`_`."eitherLeft",
      eitherRight=λ`_`."eitherRight",
      injectField=λname.strings.concat2 "injectField:" (Name[] name),
      lambdaBody=λ`_`."lambdaBody",
      letBinding=λname.strings.concat2 "letBinding:" (Name[] name),
      letBody=λ`_`."letBody",
      listElement=λi.strings.concat2 "listElement:" (printInt32 i),
      mapEntry=λi.strings.concat2 "mapEntry:" (printInt32 i),
      optionalGiven=λ`_`."optionalGiven",
      pairFirst=λ`_`."pairFirst",
      pairSecond=λ`_`."pairSecond",
      recordField=λname.strings.concat2 "recordField:" (Name[] name),
      setElement=λi.strings.concat2 "setElement:" (printInt32 i),
      typeApplicationBody=λ`_`."typeApplicationBody",
      typeLambdaBody=λ`_`."typeLambdaBody",
      wrapBody=λ`_`."wrapBody"}
      step

## Print a subtype path as its steps joined by '/'
term subtypePath = λpath.strings.join "/" (lists.map subtypeStep (SubtypePath[] path))

## Print a subtype step in its round-trippable notation
term subtypeStep =
  λstep.cases(SubtypeStep){
      annotatedBody=λ`_`."annotatedBody",
      applicationArgument=λ`_`."applicationArgument",
      applicationFunction=λ`_`."applicationFunction",
      effectValue=λ`_`."effectValue",
      eitherLeft=λ`_`."eitherLeft",
      eitherRight=λ`_`."eitherRight",
      forallBody=λ`_`."forallBody",
      functionCodomain=λ`_`."functionCodomain",
      functionDomain=λ`_`."functionDomain",
      listElement=λ`_`."listElement",
      mapKeys=λ`_`."mapKeys",
      mapValues=λ`_`."mapValues",
      optionalElement=λ`_`."optionalElement",
      pairFirst=λ`_`."pairFirst",
      pairSecond=λ`_`."pairSecond",
      recordField=λname.strings.concat2 "recordField:" (Name[] name),
      setElement=λ`_`."setElement",
      unionField=λname.strings.concat2 "unionField:" (Name[] name),
      wrapBody=λ`_`."wrapBody"}
      step