## Validation functions for modules and packages
module hydra.core.validate.packaging

import hydra.core.annotations
import hydra.core.constants
import hydra.core.dependencies
import hydra.core.error.packaging
import hydra.core.formatting
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering
import hydra.core.lib.pairs as pairs
import hydra.core.lib.regex
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.names
import hydra.core.packaging
import hydra.core.util
import hydra.core.validation
import hydra.core.variables

## Append a rule-tagged InvalidModuleError finding to a ValidationResult, classifying as error or warning per the profile and respecting maxErrors/maxWarnings bounds.
term appendFindingModule =
  λp,acc,finding.optionals.match
      finding
      acc
      (λrp.
        let ruleName := pairs.first rp in
        let payload := pairs.second rp in
        let errs := ValidationResult[errors] acc in
        let wrns := ValidationResult[warnings] acc in
        ifElse
          (sets.member ruleName (ValidationProfile[errorRules] p))
          (ifElse
            (lt (lists.length errs) (ValidationProfile[maxErrors] p))
            ValidationResult{errors = lists.concat2 errs (lists.singleton payload), warnings = wrns}
            acc)
          (ifElse
            (sets.member ruleName (ValidationProfile[warningRules] p))
            (ifElse
              (lt (lists.length wrns) (ValidationProfile[maxWarnings] p))
              ValidationResult{errors = errs, warnings = lists.concat2 wrns (lists.singleton payload)}
              acc)
            acc))

## Append a rule-tagged InvalidPackageError finding to a ValidationResult, classifying as error or warning per the profile and respecting maxErrors/maxWarnings bounds.
term appendFindingPackage =
  λp,acc,finding.optionals.match
      finding
      acc
      (λrp.
        let ruleName := pairs.first rp in
        let payload := pairs.second rp in
        let errs := ValidationResult[errors] acc in
        let wrns := ValidationResult[warnings] acc in
        ifElse
          (sets.member ruleName (ValidationProfile[errorRules] p))
          (ifElse
            (lt (lists.length errs) (ValidationProfile[maxErrors] p))
            ValidationResult{errors = lists.concat2 errs (lists.singleton payload), warnings = wrns}
            acc)
          (ifElse
            (sets.member ruleName (ValidationProfile[warningRules] p))
            (ifElse
              (lt (lists.length wrns) (ValidationProfile[maxWarnings] p))
              ValidationResult{errors = errs, warnings = lists.concat2 wrns (lists.singleton payload)}
              acc)
            acc))

## Check for module namespaces that conflict when mapped to target language paths
term checkConflictingModuleNames =
  λpkg.
    let result := lists.foldl
        (λacc,mod.
          let seen := pairs.first acc in
          let err := pairs.second acc in
          optionals.match
            err
            (let ns := Module[name] mod in
            let key := strings.toLower (ModuleName[] ns) in
            let existing := maps.lookup key seen in
            optionals.match
              existing
              (maps.insert key ns seen, none)
              (λfirst.(seen, given(InvalidPackageError{conflictingModuleName = ConflictingModuleNameError{first = first, second = ns}}))))
            (λ`_`.acc))
        (maps.empty, none)
        (Package[modules] pkg)
    in pairs.second result

## Check for union variant names that, when mapped to constructor names, conflict with other type definitions
term checkConflictingVariantNames =
  λmod.
    let ns := Module[name] mod in
    let defs := Module[definitions] mod in
    let defNames := lists.foldl (λacc,def.sets.insert (localNameOf (definitionName def)) acc) sets.empty defs in
    lists.foldl
      (λacc,def.optionals.match
          acc
          (cases(Definition){
            `type`=λtd.
                let typeName := TypeDefinition[name] td in
                let localTypeName := localNameOf typeName in
                let typ := TypeScheme[body] (TypeDefinition[body] td) in
                cases(Type){
                  `union`=λfields.lists.foldl
                        (λinnerAcc,field.optionals.match
                            innerAcc
                            (let fieldName := FieldType[name] field in
                            let localFieldName := localNameOf fieldName in
                            let constructorName := strings.concat2
                                (capitalize localTypeName)
                                (capitalize localFieldName) in
                            ifElse
                              (sets.member constructorName defNames)
                              given(InvalidModuleError{
                                conflictingVariantName = ConflictingVariantNameError{
                                  moduleName = ns,
                                  typeName = typeName,
                                  variantName = fieldName,
                                  conflictingName = wrap(Name){constructorName}}})
                              none)
                            (λ`_`.innerAcc))
                        none
                        fields,
                  `_`=none}
                  typ,
            `_`=none}
            def)
          (λ`_`.acc))
      none
      defs

## Check that every top-level definition is wrapped in a description annotation
term checkDefinitionDocumentation =
  λmod.
    let ns := Module[name] mod
    in lists.foldl
      (λacc,def.optionals.match
          acc
          (let name := definitionName def in
          let documented := cases(Definition){
              `term`=λtd.
                  let `term` := TermDefinition[body] td
                  in cases(Term){
                    annotated=λat.hasDescription
                          (getAnnotationMap
                            (AnnotatedTerm[annotation] at)),
                    `_`=false}
                    `term`,
              `type`=λtd.
                  let typ := TypeScheme[body] (TypeDefinition[body] td)
                  in cases(Type){
                    annotated=λat.hasDescription
                          (getAnnotationMap
                            (AnnotatedType[annotation] at)),
                    `_`=false}
                    typ,
              `primitive`=λpd.optionals.match
                    (PrimitiveDefinition[metadata] pd)
                    false
                    (λem.not
                        (equal
                          (optionals.withDefault
                            ""
                            (EntityMetadata[description] em))
                          "")),
              `_`=false}
              def in
          ifElse
            documented
            none
            given(InvalidModuleError{
              missingDocumentation = MissingDocumentationError{
                moduleName = ns,
                name = name}}))
          (λ`_`.acc))
      none
      (Module[definitions] mod)

## Check that all definition names in a module have the module's name as a prefix
term checkDefinitionModuleNames =
  λmod.
    let ns := Module[name] mod in
    let prefix := strings.concat2 (ModuleName[] ns) "." in
    let prefixLen := strings.length prefix in
    lists.foldl
      (λacc,def.optionals.match
          acc
          (let name := definitionName def in
          let nameStr := Name[] name in
          let namePrefix := lists.take prefixLen (strings.toList nameStr) in
          ifElse
            (equal (strings.fromList namePrefix) prefix)
            none
            given(InvalidModuleError{
              definitionNotInModuleName = DefinitionNotInModuleNameError{
                moduleName = ns,
                name = name}}))
          (λ`_`.acc))
      none
      (Module[definitions] mod)

## Check that term definitions have camelCase local names and type definitions have PascalCase local names
term checkDefinitionNameConvention =
  λmod.
    let ns := Module[name] mod
    in lists.foldl
      (λacc,def.optionals.match
          acc
          (let name := definitionName def in
          let local := localNameOf name in
          let expected := cases(Definition){
              `term`=λ`_`.CaseConvention{camel},
              `type`=λ`_`.CaseConvention{pascal},
              `primitive`=λ`_`.CaseConvention{camel},
              `_`=CaseConvention{camel}}
              def in
          let pattern := cases(Definition){
              `term`=λ`_`.regexCamelCase,
              `type`=λ`_`.regexPascalCase,
              `primitive`=λ`_`.regexCamelCase,
              `_`=regexCamelCase}
              def in
          ifElse
            (matches pattern local)
            none
            given(InvalidModuleError{
              invalidDefinitionName = InvalidDefinitionNameError{
                moduleName = ns,
                name = name,
                expectedConvention = expected}}))
          (λ`_`.acc))
      none
      (Module[definitions] mod)

## Check that a module's definitions list is sorted in ascending lexicographic order by local name
term checkDefinitionOrdering =
  λmod.
    let ns := Module[name] mod in
    let result := lists.foldl
        (λacc,def.
          let prev := pairs.first acc in
          let err := pairs.second acc in
          optionals.match
            err
            (let currName := definitionName def in
            let currLocal := localNameOf currName in
            optionals.match
              prev
              (given(currName), none)
              (λprevName.
                let prevLocal := localNameOf prevName
                in ifElse
                  (lt prevLocal currLocal)
                  (given(currName), none)
                  (
                    given(currName),
                    given(InvalidModuleError{
                      definitionsOutOfOrder = DefinitionsOutOfOrderError{
                        moduleName = ns,
                        precedingName = prevName,
                        followingName = currName}}))))
            (λ`_`.acc))
        (none, none)
        (Module[definitions] mod) in
    pairs.second result

## Check for duplicate definition names in a module
term checkDuplicateDefinitionNames =
  λmod.
    let ns := Module[name] mod in
    let result := lists.foldl
        (λacc,def.
          let seen := pairs.first acc in
          let err := pairs.second acc in
          optionals.match
            err
            (let name := definitionName def
            in ifElse
              (sets.member name seen)
              (
                seen,
                given(InvalidModuleError{duplicateDefinitionName = DuplicateDefinitionNameError{moduleName = ns, name = name}}))
              (sets.insert name seen, none))
            (λ`_`.acc))
        (sets.empty, none)
        (Module[definitions] mod) in
    pairs.second result

## Check for duplicate module namespaces in a package
term checkDuplicateModuleNames =
  λpkg.
    let result := lists.foldl
        (λacc,mod.
          let seen := pairs.first acc in
          let err := pairs.second acc in
          optionals.match
            err
            (let ns := Module[name] mod
            in ifElse
              (sets.member ns seen)
              (seen, given(InvalidPackageError{duplicateModuleName = DuplicateModuleNameError{moduleName = ns}}))
              (sets.insert ns seen, none))
            (λ`_`.acc))
        (sets.empty, none)
        (Package[modules] pkg)
    in pairs.second result

## Check that the module's namespace matches the dotted-lowercase naming convention
term checkModuleNameConvention =
  λmod.
    let ns := Module[name] mod
    in ifElse
      (matches regexNamespace (ModuleName[] ns))
      none
      given(InvalidModuleError{invalidModuleNameConvention = InvalidModuleNameConventionError{moduleName = ns}})

## Check that no module namespace is declared by more than one package, across the whole universe of packages.
term checkModulePartition =
  λpkgs.
    let declaredPairs := lists.concat (lists.map (λp.lists.map (λm.(m, pairs.first p)) (pairs.second p)) pkgs) in
    let result := lists.foldl
        (λacc,`pair_`.
          let seen := pairs.first acc in
          let findings := pairs.second acc in
          let ns := pairs.first `pair_` in
          let pkg := pairs.second `pair_` in
          let existing := maps.lookup ns seen in
          optionals.match
            existing
            (maps.insert ns pkg seen, findings)
            (λfirstPkg.ifElse
                (equal firstPkg pkg)
                acc
                (
                  seen,
                  lists.concat2
                    findings
                    (lists.singleton
                      InvalidPackageError{
                        moduleInMultiplePackages = ModuleInMultiplePackagesError{
                          moduleName = ns,
                          firstPackage = wrap(PackageName){firstPkg},
                          secondPackage = wrap(PackageName){pkg}}}))))
        (maps.empty, [])
        declaredPairs in
    pairs.second result

## Check for module namespaces that are a strict dotted-prefix of another module namespace in the same package
term checkNestedModuleNames =
  λpkg.
    let isDottedPrefixOf := λa,b.
        let prefix := strings.concat2 a "." in
        let prefixLen := strings.length prefix in
        and
          (lte prefixLen (strings.length b))
          (equal (strings.fromList (lists.take prefixLen (strings.toList b))) prefix) in
    let findNesting := λcandidate,seen.lists.foldl
          (λacc,other.optionals.match
              acc
              (ifElse
                (isDottedPrefixOf other candidate)
                given((other, candidate))
                (ifElse
                  (isDottedPrefixOf candidate other)
                  given((candidate, other))
                  none))
              (λ`_`.acc))
          none
          seen in
    let result := lists.foldl
        (λacc,mod.
          let seen := pairs.first acc in
          let err := pairs.second acc in
          optionals.match
            err
            (let nsStr := ModuleName[] (Module[name] mod) in
            let nesting := findNesting nsStr seen in
            optionals.match
              nesting
              (lists.concat2 seen (lists.singleton nsStr), none)
              (λop.(
                  seen,
                  given(InvalidPackageError{
                    nestedModuleName = NestedModuleNameError{
                      outer = ModuleName{pairs.first op},
                      inner = ModuleName{pairs.second op}}}))))
            (λ`_`.acc))
        ([], none)
        (Package[modules] pkg) in
    pairs.second result

## Check that the package's name matches the hyphen-separated lowercase naming convention
term checkPackageNameConvention =
  λpkg.
    let pname := Package[name] pkg
    in ifElse
      (matches regexPackageName (PackageName[] pname))
      none
      given(InvalidPackageError{invalidPackageName = InvalidPackageNameError{packageName = pname}})

## Check a module's definitions for free names whose owning module is not among its declared dependencies
term checkUndeclaredDependencies =
  λowners,primNames,mod.
    let ns := Module[name] mod in
    let visible := sets.insert
        ns
        (sets.fromList
          (lists.map (λdep.ModuleDependency[`module`] dep) (Module[dependencies] mod))) in
    let referencedNames := λdef.cases(Definition){
          `term`=λtd.sets.union
                (freeVariablesInTerm
                  (TermDefinition[body] td))
                (termDependencyNames
                  false
                  false
                  true
                  (TermDefinition[body] td)),
          `type`=λtyd.typeDependencyNames
                false
                (TypeScheme[body]
                  (TypeDefinition[body] tyd)),
          `_`=sets.empty}
          def in
    let findingForRef := λrefName.ifElse
          (sets.member refName primNames)
          none
          (optionals.bind
            (maps.lookup refName owners)
            (λowner.ifElse
                (sets.member owner visible)
                none
                given(InvalidPackageError{
                  undeclaredDependency = UndeclaredDependencyError{
                    moduleName = ns,
                    referencedName = refName,
                    owningModuleName = owner}}))) in
    let findingsForDef := λdef.optionals.mapOptional findingForRef (sets.toList (referencedNames def)) in
    lists.concat (lists.map findingsForDef (Module[definitions] mod))

## Extract the name from a definition
term definitionName =
  λdef.cases(Definition){
      `term`=λtd.TermDefinition[name] td,
      `type`=λtd.TypeDefinition[name] td,
      `primitive`=λpd.PrimitiveDefinition[name] pd}
      def

## True iff the given rule name appears in the profile's errorRules or warningRules.
term enabledPackaging =
  λp,ruleName.or
      (sets.member ruleName (ValidationProfile[errorRules] p))
      (sets.member ruleName (ValidationProfile[warningRules] p))

## The default validation profile for module/package validation. Every kernel-shipped check classified as an error; no warnings; maxErrors=1, maxWarnings=20.
term kernelDefaultPackagingProfile =
  ValidationProfile{
    errorRules = sets.fromList
        [
          Name{"hydra.core.error.packaging.InvalidModuleError.conflictingVariantName"},
          Name{"hydra.core.error.packaging.InvalidModuleError.definitionNotInModuleName"},
          Name{"hydra.core.error.packaging.InvalidModuleError.definitionsOutOfOrder"},
          Name{"hydra.core.error.packaging.InvalidModuleError.duplicateDefinitionName"},
          Name{"hydra.core.error.packaging.InvalidModuleError.invalidDefinitionName"},
          Name{"hydra.core.error.packaging.InvalidModuleError.invalidModuleNameConvention"},
          Name{"hydra.core.error.packaging.InvalidModuleError.missingDocumentation"},
          Name{"hydra.core.error.packaging.InvalidPackageError.conflictingModuleName"},
          Name{"hydra.core.error.packaging.InvalidPackageError.duplicateModuleName"},
          Name{"hydra.core.error.packaging.InvalidPackageError.invalidPackageName"},
          Name{"hydra.core.error.packaging.InvalidPackageError.nestedModuleName"}],
    warningRules = sets.empty,
    maxErrors = 1:int32,
    maxWarnings = 20:int32}

## Validate a kernel module against all kernel-default packaging rules; returns the first error found or nothing if valid. Convenience wrapper around 'module'' with 'kernelDefaultPackagingProfile'.
term kernelModule =
  λmod.lists.head
      (ValidationResult[errors] (`module` kernelDefaultPackagingProfile ValidationResult{errors = [], warnings = []} mod))

## Validate a kernel package against all kernel-default packaging rules; returns the first error found or nothing if valid. Convenience wrapper around 'package' with 'kernelDefaultPackagingProfile'.
term kernelPackage =
  λpkg.lists.head
      (ValidationResult[errors] (package kernelDefaultPackagingProfile ValidationResult{errors = [], warnings = []} pkg))

## Non-kernel packaging profile (#575): identical to kernelDefaultPackagingProfile except the rules in kernelPackagingWarningRuleNamesForNonKernel (documentation, ordering, naming convention) are warnings, not errors, so each package's pre-existing backlog does not block sync until that package is promoted to the fully-fatal profile.
term kernelPackagingProfileWithDocWarnings =
  ValidationProfile{
    errorRules = sets.fromList
        [
          Name{"hydra.core.error.packaging.InvalidModuleError.conflictingVariantName"},
          Name{"hydra.core.error.packaging.InvalidModuleError.definitionNotInModuleName"},
          Name{"hydra.core.error.packaging.InvalidModuleError.duplicateDefinitionName"},
          Name{"hydra.core.error.packaging.InvalidModuleError.invalidModuleNameConvention"},
          Name{"hydra.core.error.packaging.InvalidPackageError.conflictingModuleName"},
          Name{"hydra.core.error.packaging.InvalidPackageError.duplicateModuleName"},
          Name{"hydra.core.error.packaging.InvalidPackageError.invalidPackageName"},
          Name{"hydra.core.error.packaging.InvalidPackageError.nestedModuleName"}],
    warningRules = sets.fromList
        [
          Name{"hydra.core.error.packaging.InvalidModuleError.missingDocumentation"},
          Name{"hydra.core.error.packaging.InvalidModuleError.definitionsOutOfOrder"},
          Name{"hydra.core.error.packaging.InvalidModuleError.invalidDefinitionName"}],
    maxErrors = 1:int32,
    maxWarnings = 10000:int32}

## Check every module in the given universe for undeclared cross-module dependencies, returning every finding.
term kernelUniverseUndeclaredDependencies =
  λuniverse,primNames.
    let owners := undeclaredDependencyOwners universe
    in lists.concat (lists.map (λmod.checkUndeclaredDependencies owners primNames mod) universe)

## Validate a module against the given ValidationProfile, accumulating findings into a ValidationResult. Errors hard-stop the rule sequence once maxErrors is reached.
term module =
  λp,acc0,mod.lists.foldl
      (λacc,guarded.ifElse
          (gte (lists.length (ValidationResult[errors] acc)) (ValidationProfile[maxErrors] p))
          acc
          (appendFindingModule p acc guarded))
      acc0
      [
        ifElse
          (enabledPackaging p Name{"hydra.core.error.packaging.InvalidModuleError.conflictingVariantName"})
          (optionals.map
            (λf.(Name{"hydra.core.error.packaging.InvalidModuleError.conflictingVariantName"}, f))
            (checkConflictingVariantNames mod))
          none,
        ifElse
          (enabledPackaging p Name{"hydra.core.error.packaging.InvalidModuleError.missingDocumentation"})
          (optionals.map
            (λf.(Name{"hydra.core.error.packaging.InvalidModuleError.missingDocumentation"}, f))
            (checkDefinitionDocumentation mod))
          none,
        ifElse
          (enabledPackaging p Name{"hydra.core.error.packaging.InvalidModuleError.invalidDefinitionName"})
          (optionals.map
            (λf.(Name{"hydra.core.error.packaging.InvalidModuleError.invalidDefinitionName"}, f))
            (checkDefinitionNameConvention mod))
          none,
        ifElse
          (enabledPackaging p Name{"hydra.core.error.packaging.InvalidModuleError.definitionNotInModuleName"})
          (optionals.map
            (λf.(Name{"hydra.core.error.packaging.InvalidModuleError.definitionNotInModuleName"}, f))
            (checkDefinitionModuleNames mod))
          none,
        ifElse
          (enabledPackaging p Name{"hydra.core.error.packaging.InvalidModuleError.definitionsOutOfOrder"})
          (optionals.map
            (λf.(Name{"hydra.core.error.packaging.InvalidModuleError.definitionsOutOfOrder"}, f))
            (checkDefinitionOrdering mod))
          none,
        ifElse
          (enabledPackaging p Name{"hydra.core.error.packaging.InvalidModuleError.duplicateDefinitionName"})
          (optionals.map
            (λf.(Name{"hydra.core.error.packaging.InvalidModuleError.duplicateDefinitionName"}, f))
            (checkDuplicateDefinitionNames mod))
          none,
        ifElse
          (enabledPackaging p Name{"hydra.core.error.packaging.InvalidModuleError.invalidModuleNameConvention"})
          (optionals.map
            (λf.(Name{"hydra.core.error.packaging.InvalidModuleError.invalidModuleNameConvention"}, f))
            (checkModuleNameConvention mod))
          none]

## Validate a package against the given ValidationProfile, accumulating findings into a ValidationResult. Errors hard-stop traversal once maxErrors is reached.
term package =
  λp,acc0,pkg.
    let accPkg := lists.foldl
        (λacc,guarded.ifElse
            (gte
              (lists.length (ValidationResult[errors] acc))
              (ValidationProfile[maxErrors] p))
            acc
            (appendFindingPackage p acc guarded))
        acc0
        [
          ifElse
            (enabledPackaging p Name{"hydra.core.error.packaging.InvalidPackageError.conflictingModuleName"})
            (optionals.map
              (λf.(Name{"hydra.core.error.packaging.InvalidPackageError.conflictingModuleName"}, f))
              (checkConflictingModuleNames pkg))
            none,
          ifElse
            (enabledPackaging p Name{"hydra.core.error.packaging.InvalidPackageError.duplicateModuleName"})
            (optionals.map
              (λf.(Name{"hydra.core.error.packaging.InvalidPackageError.duplicateModuleName"}, f))
              (checkDuplicateModuleNames pkg))
            none,
          ifElse
            (enabledPackaging p Name{"hydra.core.error.packaging.InvalidPackageError.invalidPackageName"})
            (optionals.map
              (λf.(Name{"hydra.core.error.packaging.InvalidPackageError.invalidPackageName"}, f))
              (checkPackageNameConvention pkg))
            none,
          ifElse
            (enabledPackaging p Name{"hydra.core.error.packaging.InvalidPackageError.nestedModuleName"})
            (optionals.map
              (λf.(Name{"hydra.core.error.packaging.InvalidPackageError.nestedModuleName"}, f))
              (checkNestedModuleNames pkg))
            none]
    in lists.foldl
      (λacc,mod.ifElse
          (gte (lists.length (ValidationResult[errors] acc)) (ValidationProfile[maxErrors] p))
          acc
          (let mr := `module` p ValidationResult{errors = [], warnings = []} mod in
          let liftedErrs := lists.map
              (λe.InvalidPackageError{invalidModule = e})
              (ValidationResult[errors] mr) in
          let liftedWrns := lists.map
              (λw.InvalidPackageError{invalidModule = w})
              (ValidationResult[warnings] mr) in
          let newErrs := lists.take
              (ValidationProfile[maxErrors] p)
              (lists.concat2 (ValidationResult[errors] acc) liftedErrs) in
          let newWrns := lists.take
              (ValidationProfile[maxWarnings] p)
              (lists.concat2 (ValidationResult[warnings] acc) liftedWrns) in
          ValidationResult{errors = newErrs, warnings = newWrns}))
      accPkg
      (Package[modules] pkg)

## Build a map from every name defined in the universe to its owning module
term undeclaredDependencyOwners =
  λuniverse.maps.fromList
      (lists.concat
        (lists.map (λm.lists.map (λdef.(definitionName def, Module[name] m)) (Module[definitions] m)) universe))