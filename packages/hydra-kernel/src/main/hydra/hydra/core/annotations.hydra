## Utilities for reading and writing type and term annotations
module hydra.core.annotations

import hydra.core.constants
import hydra.core.decode.model as decode.model
import hydra.core.encode.model as encode.model
import hydra.core.errors
import hydra.core.extract.model as extract.model
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.model
import hydra.core.strip

## Aggregate annotations from nested structures
term aggregateAnnotations =
  λgetValue,getX,getAnns,t.
    let toPairs := λrest,t.optionals.match
          (getValue t)
          rest
          (λyy.toPairs (lists.cons (maps.toList (getAnns yy)) rest) (getX yy))
    in maps.fromList (lists.concat (toPairs [] t))

## Extract comments/description from a Binding
term commentsFromBinding = λcx,g,b.getTermDescription cx g (Binding[`term`] b)

## Extract comments/description from a FieldType
term commentsFromFieldType = λcx,g,ft.getTypeDescription cx g (FieldType[`type`] ft)

## Project a Map<Name, Term> out of an annotation Term. For a TermMap with TermVariable-shaped keys (or, transitionally, TermWrap-encoded Name keys), returns those (Name, value) entries; for any other shape, returns the empty map.
term getAnnotationMap =
  λt.
    let extractName := λk.cases(Term){
          variable=λn.given(n),
          `wrap`=λw.cases(Term){
                literal=λl.cases(Literal){
                      `string`=λs.given(wrap(Name){s}),
                      `_`=none}
                      l,
                `_`=none}
                (WrappedTerm[body] w),
          `_`=none}
          k in
    let fromEntry := λp.let k := first p in let v := second p in optionals.map (λn.(n, v)) (extractName k) in
    cases(Term){`map`=λm.maps.fromList (optionals.givens (lists.map fromEntry (maps.toList m))), `_`=maps.empty} t

## Get description from annotations map (Either version)
term getDescription =
  λcx,graph,anns.optionals.match
      (maps.lookup Name{"description"} anns)
      right(none)
      (λ`term`.eithers.map optionals.given (extract.model.string graph `term`))

## Get a term annotation
term getTermAnnotation = λkey,`term`.maps.lookup key (termAnnotationInternal `term`)

## Get term description (Either version)
term getTermDescription =
  λcx,graph,`term`.
    let peel := λt.cases(Term){
          typeLambda=λtl.peel (TypeLambda[body] tl),
          typeApplication=λta.peel (TypeApplicationTerm[body] ta),
          `_`=t}
          t
    in getDescription cx graph (termAnnotationInternal (peel `term`))

## Get type from annotations
term getType =
  λgraph,anns.optionals.match
      (maps.lookup keyType anns)
      right(none)
      (λdat.eithers.map optionals.given (decode.model.type graph dat))

## Get a type annotation
term getTypeAnnotation = λkey,typ.maps.lookup key (typeAnnotationInternal typ)

## Get type classes from term. Each Set Name contains bare class identifiers (#275).
term getTypeClasses =
  λcx,graph,`term`.
    let decodeName := λ`term`.eithers.bimap
          (λde.Error{decoding = de})
          (λx.x)
          (decode.model.name graph `term`)
    in optionals.match
      (getTermAnnotation keyClasses `term`)
      right(maps.empty)
      (λ`term`.extract.model.map decodeName (extract.model.setOf decodeName graph) graph `term`)

## Get type description (Either version)
term getTypeDescription = λcx,graph,typ.getDescription cx graph (typeAnnotationInternal typ)

## Check if annotations contain description
term hasDescription = λanns.optionals.isGiven (maps.lookup keyDescription anns)

## Check if type has description
term hasTypeDescription = λtyp.hasDescription (typeAnnotationInternal typ)

## For a typed term, decide whether a coder should encode it as a native type expression, or as a Hydra type expression.
term isNativeType =
  λel.
    let isFlaggedAsFirstClassType := optionals.withDefault
        false
        (optionals.map
          (λ`_`.true)
          (getTermAnnotation keyFirstClassType (Binding[`term`] el)))
    in optionals.match
      (Binding[typeScheme] el)
      false
      (λts.and
          (equal
            ts
            TypeScheme{variables = [], body = Type{variable = Name{"hydra.core.model.Type"}}, constraints = maps.empty})
          (not isFlaggedAsFirstClassType))

## Normalize term annotations
term normalizeTermAnnotations =
  λ`term`.
    let anns := termAnnotationInternal `term` in
    let stripped := deannotateTerm `term` in
    ifElse
      (maps.isEmpty anns)
      stripped
      Term{annotated = AnnotatedTerm{body = stripped, annotation = wrapAnnotationMap anns}}

## Normalize type annotations
term normalizeTypeAnnotations =
  λtyp.
    let anns := typeAnnotationInternal typ in
    let stripped := deannotateType typ in
    ifElse
      (maps.isEmpty anns)
      stripped
      Type{annotated = AnnotatedType{body = stripped, annotation = wrapAnnotationMap anns}}

## Set annotation in map
term setAnnotation = λkey,val,m.maps.alter (λ`_`.val) key m

## Set description in annotations
term setDescription =
  λd.setAnnotation
      keyDescription
      (optionals.map (λ`arg_`.(λx.Term{literal = x}) ((λx.Literal{`string` = x}) `arg_`)) d)

## Set term annotation
term setTermAnnotation =
  λkey,val,`term`.
    let `term'` := deannotateTerm `term` in
    let anns := setAnnotation key val (termAnnotationInternal `term`) in
    ifElse
      (maps.isEmpty anns)
      `term'`
      Term{annotated = AnnotatedTerm{body = `term'`, annotation = wrapAnnotationMap anns}}

## Set term description
term setTermDescription =
  λd.setTermAnnotation keyDescription (optionals.map (λs.Term{literal = Literal{`string` = s}}) d)

## Set type in annotations
term setType = λmt.setAnnotation keyType (optionals.map encode.model.type mt)

## Set type annotation
term setTypeAnnotation =
  λkey,val,typ.
    let `typ'` := deannotateType typ in
    let anns := setAnnotation key val (typeAnnotationInternal typ) in
    ifElse
      (maps.isEmpty anns)
      `typ'`
      Type{annotated = AnnotatedType{body = `typ'`, annotation = wrapAnnotationMap anns}}

## Set type classes on term. The Set Name carries bare class identifiers (#275).
term setTypeClasses =
  λm,`term`.
    let encodePair := λnameClasses.
        let name := first nameClasses in
        let classes := second nameClasses in
        (encode.model.name name, Term{`set` = sets.fromList (lists.map encode.model.name (sets.toList classes))}) in
    let encoded := ifElse
        (maps.isEmpty m)
        none
        given(Term{`map` = maps.fromList (lists.map encodePair (maps.toList m))}) in
    setTermAnnotation keyClasses encoded `term`

## Set type description
term setTypeDescription =
  λd.setTypeAnnotation
      keyDescription
      (optionals.map (λ`arg_`.(λx.Term{literal = x}) ((λx.Literal{`string` = x}) `arg_`)) d)

## Get internal term annotations
term termAnnotationInternal =
  λ`term`.
    let getAnn := λt.cases(Term){annotated=λa.given(a), `_`=none} t
    in aggregateAnnotations
      getAnn
      (λat.AnnotatedTerm[body] at)
      (λat.getAnnotationMap (AnnotatedTerm[annotation] at))
      `term`

## Get internal type annotations
term typeAnnotationInternal =
  λtyp.
    let getAnn := λt.cases(Type){annotated=λa.given(a), `_`=none} t
    in aggregateAnnotations
      getAnn
      (λat.AnnotatedType[body] at)
      (λat.getAnnotationMap (AnnotatedType[annotation] at))
      typ

## Wrap a Map<Name, Term> as a TermMap annotation. Each Name key becomes a TermVariable.
term wrapAnnotationMap =
  λm.Term{`map` = maps.fromList (lists.map (λp.(Term{variable = first p}, second p)) (maps.toList m))}