## Language constraints for Hydra Core
module hydra.core.languages

import hydra.core.coders
import hydra.core.file
import hydra.core.lib.sets
import hydra.core.model
import hydra.core.reflect as reflect
import hydra.core.util

## Language constraints for Hydra Core, i.e. no constraints.
term hydraLanguage =
  let literalVariants := fromList reflect.literalVariants, floatTypes := fromList reflect.floatTypes, integerTypes := fromList reflect.integerTypes, termVariants := fromList reflect.termVariants, typeVariants := fromList reflect.typeVariants, types := λt.cases(Type){`_`=true} t
  in Language{
    name = LanguageName{"hydra.core.model"},
    constraints = LanguageConstraints{
      literalVariants = literalVariants,
      floatTypes = floatTypes,
      integerTypes = integerTypes,
      termVariants = termVariants,
      typeVariants = typeVariants,
      types = types},
    supportedFeatures = fromList
        [
          LanguageFeature{partialApplication},
          LanguageFeature{nestedCaseStatements},
          LanguageFeature{nestedPolymorphicLetBindings}],
    caseConventions = CaseConventions{
      constant = CaseConvention{upperSnake},
      directory = CaseConvention{pascal},
      enumValue = CaseConvention{pascal},
      field = CaseConvention{camel},
      file = CaseConvention{pascal},
      `module` = CaseConvention{lowerSnake},
      `term` = CaseConvention{camel},
      termVariable = CaseConvention{camel},
      `type` = CaseConvention{pascal},
      typeVariable = CaseConvention{camel}},
    defaultFileExtension = FileExtension{""}}