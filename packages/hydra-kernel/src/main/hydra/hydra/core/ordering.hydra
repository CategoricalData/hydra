## Graph-aware ordering of object-level values: union variants compare in declared order, and annotations are ignored at every depth (#848).
module hydra.core.ordering

import hydra.core.errors
import hydra.core.graph
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps
import hydra.core.lib.math
import hydra.core.lib.optionals
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.rewriting

## Compute the order key of an object-level value. Comparing two keys structurally gives the order of the original values: annotations are removed at every depth, and each injection becomes a pair of its variant's declared index and the key of its payload, so union variants compare in declared order. The key is used only for comparison and is never returned to the caller. Fails if an injection's type name does not resolve to a union type in the graph.
term termOrderKey =
  λgraph, `term`.
    let toKey := λrecurse, t.eithers.bind
          (recurse t)
          (λrewritten.cases(Term){
              annotated = λat.right(AnnotatedTerm[body] at),
              `inject` = λinj.
                  let field := Injection[field] inj
                  in eithers.bind
                    (unionVariantIndex
                      graph
                      (Injection[typeName] inj)
                      (Field[name] field))
                    (λindex.right(Term{
                        pair = (Term{literal = Literal{integer = IntegerValue{`int32` = index}}}, Field[`term`] field)})),
              `_` = right(rewritten)}
              rewritten)
    in rewriteTermM toKey `term`

## Find the declared (zero-based) index of a variant of a named union type, looking the type up in the graph's schema. Fails if the name does not resolve to a union type with that variant.
term unionVariantIndex =
  λgraph, typeName, variant.
    let unionFields := λt.cases(Type){
          annotated = λat.unionFields (AnnotatedType[body] at),
          `forall` = λft.unionFields (ForallType[body] ft),
          `union` = λfields.given(fields),
          `_` = none}
          t in
    let shapeError := λmsg.left(Error{
          resolution = ResolutionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "union type with the injected variant",
              actual = strings.concat
                  [Name[] typeName, ".", Name[] variant, ": ", msg]}}}) in
    match
      (lookup typeName (Graph[schemaTypes] graph))
      left(Error{
        resolution = ResolutionError{
          noSuchBinding = NoSuchBindingError{
            name = typeName}}})
      (λts.match
          (unionFields (TypeScheme[body] ts))
          (shapeError "not a union type")
          (λfields.
            let names := lists.map (λft.FieldType[name] ft) fields in
            let rest := lists.dropWhile (λn.not (equal n variant)) names in
            ifElse
              (lists.isEmpty rest)
              (shapeError "no such variant")
              right(sub (lists.length names) (lists.length rest))))