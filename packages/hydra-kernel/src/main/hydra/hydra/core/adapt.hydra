## Simple, one-way adapters for types and terms
module hydra.core.adapt

import hydra.core.annotations as annotations
import hydra.core.coders as coders
import hydra.core.dependencies as dependencies
import hydra.core.environment as environment
import hydra.core.errors as errors
import hydra.core.graph as graph
import hydra.core.hoisting as hoisting
import hydra.core.inference as inference
import hydra.core.lexical as lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality as equality
import hydra.core.lib.functions as functions
import hydra.core.lib.lists as lists
import hydra.core.lib.literals as lib.literals
import hydra.core.lib.logic as logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.pairs as pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.literals as literals
import hydra.core.model as model
import hydra.core.names as names
import hydra.core.packaging as packaging
import hydra.core.print.model as print.model
import hydra.core.reduction as reduction
import hydra.core.reflect as reflect
import hydra.core.resolution as resolution
import hydra.core.rewriting as rewriting
import hydra.core.scoping as scoping
import hydra.core.strip as strip
import hydra.core.typing as typing
import hydra.core.variables as variables

## Adapt a graph and its schema to the given language constraints. The doExpand flag controls eta expansion of partial applications. Adaptation is type-preserving: binding-level TypeSchemes are adapted (not stripped). Note: case statement hoisting is done separately, prior to adaptation. The els0 parameter provides the original ordered bindings. Returns both the adapted graph and the ordered adapted bindings.
term adaptDataGraph = λconstraints,doExpand,els0,cx,graph0.let transformTerm := λg,`term`.let tx := g in let t1 := variables.unshadowVariables (pushTypeAppsInward `term`) in let t2 := variables.unshadowVariables (logic.ifElse doExpand (pushTypeAppsInward (reduction.etaExpandTerm tx t1)) t1) in dependencies.liftLambdaAboveLet t2 in let transformBinding := λg,el.model.Binding{name = model.Binding[name] el, `term` = transformTerm g (model.Binding[`term`] el), typeScheme = model.Binding[typeScheme] el} in let litmap := adaptLiteralTypesMap constraints in let prims0 := graph.Graph[primitives] graph0 in let schemaTypes0 := graph.Graph[schemaTypes] graph0 in let schemaBindings := environment.typesToDefinitions (maps.map (λts.scoping.typeSchemeToFType ts) schemaTypes0) in eithers.bind (logic.ifElse (maps.isEmpty schemaTypes0) right(maps.empty) (eithers.bind (eithers.bimap (λe.errors.Error{decoding = e}) (λx.x) (environment.graphAsTypes graph0 schemaBindings)) (λtmap0.eithers.bind (adaptGraphSchema constraints litmap tmap0) (λtmap1.right(maps.map (λt.resolution.typeToTypeScheme t) tmap1))))) (λschemaResult.let adaptedSchemaTypes := schemaResult in let adaptBinding := λel.let transformed := transformBinding graph0 el in let wrapped := model.Term{`let` = model.Let{bindings = lists.singleton transformed, body = model.Term{`unit`}}} in eithers.bind (adaptTerm constraints litmap cx graph0 wrapped) (λadapted.rewriting.rewriteTermM (adaptLambdaDomains constraints litmap) adapted) in eithers.bind (eithers.mapList adaptBinding els0) (λadaptedTerms.let els1Raw := lists.concat (lists.map environment.termAsBindings adaptedTerms) in let processBinding := λel.eithers.bind (rewriting.rewriteTermM (adaptNestedTypes constraints litmap) (model.Binding[`term`] el)) (λnewTerm.eithers.bind (optionals.match (model.Binding[typeScheme] el) right(none) (λts.eithers.bind (adaptTypeScheme constraints litmap ts) (λts1.right(given(ts1))))) (λadaptedType.right(model.Binding{name = model.Binding[name] el, `term` = newTerm, typeScheme = adaptedType}))) in eithers.bind (eithers.mapList processBinding els1Raw) (λels1.eithers.bind (eithers.mapList (λkv.eithers.bind (adaptPrimitive constraints litmap (pairs.second kv)) (λprim1.right((pairs.first kv, prim1)))) (maps.toList prims0)) (λprimPairs.let prims1 := maps.fromList primPairs in let adaptedGraphRaw := lexical.buildGraph els1 maps.empty prims1 in let adaptedGraph := graph.Graph{boundTerms = graph.Graph[boundTerms] adaptedGraphRaw, boundTypes = graph.Graph[boundTypes] adaptedGraphRaw, classConstraints = graph.Graph[classConstraints] adaptedGraphRaw, lambdaVariables = graph.Graph[lambdaVariables] adaptedGraphRaw, metadata = graph.Graph[metadata] adaptedGraphRaw, primitives = graph.Graph[primitives] adaptedGraphRaw, schemaTypes = adaptedSchemaTypes, typeVariables = graph.Graph[typeVariables] adaptedGraphRaw} in right((adaptedGraph, els1))))))

## Attempt to adapt a floating-point type using the given language constraints
term adaptFloatType = λconstraints,ft.let supported := sets.member ft (coders.LanguageConstraints[floatTypes] constraints) in let alt := adaptFloatType constraints in let forUnsupported := λft.cases(model.FloatType){`float32`=λ`_`.alt model.FloatType{`float64`}, `float64`=λ`_`.alt model.FloatType{`float32`}} ft in logic.ifElse supported given(ft) (forUnsupported ft)

## Adapt a schema graph to the given language constraints
term adaptGraphSchema = λconstraints,litmap,types0.let mapPair := λpair.let name := pairs.first pair in let typ := pairs.second pair in eithers.bind (adaptType constraints litmap typ) (λtyp1.right((name, typ1))) in eithers.bind (eithers.mapList mapPair (maps.toList types0)) (λpairs.right(maps.fromList pairs))

## Attempt to adapt an integer type using the given language constraints
term adaptIntegerType = λconstraints,it.let supported := sets.member it (coders.LanguageConstraints[integerTypes] constraints) in let alt := adaptIntegerType constraints in let forUnsupported := λit.cases(model.IntegerType){`bigint`=λ`_`.none, `int8`=λ`_`.alt model.IntegerType{`uint16`}, `int16`=λ`_`.alt model.IntegerType{`uint32`}, `int32`=λ`_`.alt model.IntegerType{`uint64`}, `int64`=λ`_`.alt model.IntegerType{`bigint`}, `uint8`=λ`_`.alt model.IntegerType{`int16`}, `uint16`=λ`_`.alt model.IntegerType{`int32`}, `uint32`=λ`_`.alt model.IntegerType{`int64`}, `uint64`=λ`_`.alt model.IntegerType{`bigint`}} it in logic.ifElse supported given(it) (forUnsupported it)

## Rewrite callback for adapting lambda domain types in a term
term adaptLambdaDomains = λconstraints,litmap,recurse,`term`.eithers.bind (recurse `term`) (λrewritten.cases(model.Term){lambda=λl.eithers.bind (optionals.match (model.Lambda[domain] l) right(none) (λdom.eithers.bind (adaptType constraints litmap dom) (λdom1.right(given(dom1))))) (λadaptedDomain.right(model.Term{lambda = model.Lambda{parameter = model.Lambda[parameter] l, domain = adaptedDomain, body = model.Lambda[body] l}})), `_`=right(rewritten)} rewritten)

## Convert a literal to a different type
term adaptLiteral = λlt,l.cases(model.Literal){`binary`=λb.cases(model.LiteralType){`string`=λ`_`.model.Literal{`string` = lib.literals.binaryToBase64 b}} lt, `boolean`=λb.cases(model.LiteralType){integer=λit.model.Literal{integer = literals.bigintToIntegerValue it (logic.ifElse b 1:bigint 0:bigint)}} lt, `decimal`=λd.cases(model.LiteralType){float=λ`_`.model.Literal{float = model.FloatValue{`float64` = lib.literals.decimalToFloat64 d}}, `string`=λ`_`.model.Literal{`string` = lib.literals.printDecimal d}} lt, float=λf.cases(model.LiteralType){float=λft.model.Literal{float = cases(model.FloatType){`float32`=λ`_`.model.FloatValue{`float32` = cases(model.FloatValue){`float32`=λf32.f32, `float64`=λf64.lib.literals.float64ToFloat32 f64} f}, `float64`=λ`_`.model.FloatValue{`float64` = cases(model.FloatValue){`float32`=λf32.lib.literals.float32ToFloat64 f32, `float64`=λf64.f64} f}} ft}} lt, integer=λi.cases(model.LiteralType){integer=λit.model.Literal{integer = literals.bigintToIntegerValue it (literals.integerValueToBigint i)}} lt} l

## Attempt to adapt a literal type using the given language constraints
term adaptLiteralType = λconstraints,lt.let forUnsupported := λlt.cases(model.LiteralType){`binary`=λ`_`.given(model.LiteralType{`string`}), `boolean`=λ`_`.optionals.map (λx.model.LiteralType{integer = x}) (adaptIntegerType constraints model.IntegerType{`int8`}), `decimal`=λ`_`.given(model.LiteralType{float = model.FloatType{`float64`}}), float=λft.optionals.map (λx.model.LiteralType{float = x}) (adaptFloatType constraints ft), integer=λit.optionals.map (λx.model.LiteralType{integer = x}) (adaptIntegerType constraints it), `_`=none} lt in logic.ifElse (literalTypeSupported constraints lt) none (forUnsupported lt)

## Derive a map of adapted literal types for the given language constraints
term adaptLiteralTypesMap = λconstraints.let tryType := λlt.optionals.match (adaptLiteralType constraints lt) none (λlt2.given((lt, lt2))) in maps.fromList (optionals.givens (lists.map tryType reflect.literalTypes))

## Adapt a literal value using the given language constraints
term adaptLiteralValue = λlitmap,lt,l.optionals.match (maps.lookup lt litmap) model.Literal{`string` = print.model.literal l} (λlt2.adaptLiteral lt2 l)

## Rewrite callback for adapting nested let binding TypeSchemes in a term
term adaptNestedTypes = λconstraints,litmap,recurse,`term`.eithers.bind (recurse `term`) (λrewritten.cases(model.Term){`let`=λlt.let adaptB := λb.eithers.bind (optionals.match (model.Binding[typeScheme] b) right(none) (λts.eithers.bind (adaptTypeScheme constraints litmap ts) (λts1.right(given(ts1))))) (λadaptedBType.right(model.Binding{name = model.Binding[name] b, `term` = model.Binding[`term`] b, typeScheme = adaptedBType})) in eithers.bind (eithers.mapList adaptB (model.Let[bindings] lt)) (λadaptedBindings.right(model.Term{`let` = model.Let{bindings = adaptedBindings, body = model.Let[body] lt}})), `_`=right(rewritten)} rewritten)

## Adapt a primitive to the given language constraints, prior to inference
term adaptPrimitive = λconstraints,litmap,prim0.let def0 := graph.Primitive[definition] prim0 in eithers.bind (adaptTermSignature constraints litmap (packaging.PrimitiveDefinition[signature] def0)) (λsig1.let def1 := packaging.PrimitiveDefinition{name = packaging.PrimitiveDefinition[name] def0, metadata = packaging.PrimitiveDefinition[metadata] def0, signature = sig1, isPure = packaging.PrimitiveDefinition[isPure] def0, isTotal = packaging.PrimitiveDefinition[isTotal] def0, defaultImplementation = packaging.PrimitiveDefinition[defaultImplementation] def0} in right(graph.Primitive{definition = def1, implementation = graph.Primitive[implementation] prim0}))

## Adapt a term using the given language constraints
term adaptTerm = λconstraints,litmap,cx,graph,term0.let rewrite := λrecurse,term0.let forSupported := λ`term`.cases(model.Term){literal=λl.let lt := reflect.literalType l in right(given(logic.ifElse (literalTypeSupported constraints lt) `term` model.Term{literal = adaptLiteralValue litmap lt l})), `_`=right(given(`term`))} `term`, forUnsupported := λ`term`.let tryAlts := λalts.optionals.match (lists.uncons alts) right(none) (λuc.eithers.bind (tryTerm (pairs.first uc)) (λmterm.optionals.match mterm (tryAlts (pairs.second uc)) (λt.right(given(t))))) in eithers.bind (termAlternatives cx graph `term`) (λalts0.tryAlts alts0), tryTerm := λ`term`.let supportedVariant := sets.member (reflect.termVariant `term`) (coders.LanguageConstraints[termVariants] constraints) in logic.ifElse supportedVariant (forSupported `term`) (forUnsupported `term`) in eithers.bind (recurse term0) (λterm1.cases(model.Term){annotated=λ`_`.right(term1), typeApplication=λta.eithers.bind (adaptType constraints litmap (model.TypeApplicationTerm[`type`] ta)) (λatyp.right(model.Term{typeApplication = model.TypeApplicationTerm{body = model.TypeApplicationTerm[body] ta, `type` = atyp}})), typeLambda=λ`_`.right(term1), `_`=eithers.bind (tryTerm term1) (λmterm.optionals.match mterm left(errors.Error{other = errors.OtherError{strings.concat2 "no alternatives for term: " (print.model.term term1)}}) (λterm2.right(term2)))} term1) in rewriting.rewriteTermM rewrite term0

## Adapt a term using the constraints of a given language
term adaptTermForLanguage = λlang,cx,g,`term`.let constraints := coders.Language[constraints] lang in let litmap := adaptLiteralTypesMap constraints in adaptTerm constraints litmap cx g `term`

## Adapt the types within a term signature to the given language constraints, in place. Parameter names, descriptions, and per-parameter isLazy flags, as well as type parameters, are preserved; only the parameter and result types are adapted. Unlike routing through TypeScheme (the type-only view), this retains the full TermSignature metadata, including primitive laziness flags.
term adaptTermSignature = λconstraints,litmap,sig0.let result0 := typing.TermSignature[result] sig0 in eithers.bind (adaptType constraints litmap (typing.Result[`type`] result0)) (λresultType1.eithers.bind (eithers.mapList (λp.eithers.map (λty1.typing.Parameter{name = typing.Parameter[name] p, description = typing.Parameter[description] p, `type` = ty1, isLazy = typing.Parameter[isLazy] p}) (adaptType constraints litmap (typing.Parameter[`type`] p))) (typing.TermSignature[parameters] sig0)) (λparams1.right(typing.TermSignature{typeParameters = typing.TermSignature[typeParameters] sig0, parameters = params1, result = typing.Result{description = typing.Result[description] result0, `type` = resultType1}})))

## Adapt a type using the given language constraints
term adaptType = λconstraints,litmap,type0.let forSupported := λtyp.cases(model.Type){literal=λlt.logic.ifElse (literalTypeSupported constraints lt) given(typ) (optionals.match (maps.lookup lt litmap) given(model.Type{literal = model.LiteralType{`string`}}) (λlt2.given(model.Type{literal = lt2}))), `_`=given(typ)} typ, forUnsupported := λtyp.let tryAlts := λalts.optionals.bind (lists.uncons alts) (λuc.optionals.match (tryType (pairs.first uc)) (tryAlts (pairs.second uc)) (λt.given(t))) in let alts0 := typeAlternatives typ in tryAlts alts0, tryType := λtyp.let supportedVariant := sets.member (reflect.typeVariant typ) (coders.LanguageConstraints[typeVariants] constraints) in logic.ifElse supportedVariant (forSupported typ) (forUnsupported typ) in let rewrite := λrecurse,typ.eithers.bind (recurse typ) (λtype1.optionals.match (tryType type1) left(errors.Error{other = errors.OtherError{strings.concat2 "no alternatives for type: " (print.model.type typ)}}) (λtype2.right(type2))) in rewriting.rewriteTypeM rewrite type0

## Adapt a type using the constraints of a given language
term adaptTypeForLanguage = λlang,typ.let constraints := coders.Language[constraints] lang in let litmap := adaptLiteralTypesMap constraints in adaptType constraints litmap typ

## Adapt a type scheme to the given language constraints, prior to inference
term adaptTypeScheme = λconstraints,litmap,ts0.let vars0 := model.TypeScheme[variables] ts0 in let t0 := model.TypeScheme[body] ts0 in eithers.bind (adaptType constraints litmap t0) (λt1.right(model.TypeScheme{variables = vars0, body = t1, constraints = model.TypeScheme[constraints] ts0}))

## Compose two coders into a single coder
term composeCoders = λc1,c2.coders.Coder{encode = λa.eithers.bind (coders.Coder[encode] c1 a) (λb1.coders.Coder[encode] c2 b1), decode = λc.eithers.bind (coders.Coder[decode] c2 c) (λb2.coders.Coder[decode] c1 b2)}

## Given a data graph along with language constraints, original ordered bindings, and a designated list of namespaces, adapt the graph to the language constraints, then return the processed graph along with term definitions grouped by namespace (in the order of the input namespaces). Inference is performed before adaptation if bindings lack type annotations. Hoisting must preserve type schemes; if any binding loses its type scheme after hoisting, the pipeline fails. Adaptation preserves type application/lambda wrappers and adapts embedded types. Post-adaptation inference is performed to ensure binding TypeSchemes are fully consistent. The doExpand flag controls eta expansion. The doHoistCaseStatements flag controls case statement hoisting (needed for Python). The doHoistPolymorphicLetBindings flag controls polymorphic let binding hoisting (needed for Java). The originalBindings parameter provides the original ordered bindings (from module elements).
term dataGraphToDefinitions = λconstraints,doInfer,doExpand,doHoistCaseStatements,doHoistPolymorphicLetBindings,originalBindings,graph0,namespaces,cx.let namespacesSet := sets.fromList namespaces in let isParentBinding := λb.optionals.match (names.moduleNameOf (model.Binding[name] b)) false (λns.sets.member ns namespacesSet) in let hoistCases := λbindings.let stripped := lists.map (λb.model.Binding{name = model.Binding[name] b, `term` = strip.stripTypeLambdas (model.Binding[`term`] b), typeScheme = model.Binding[typeScheme] b}) bindings in let term0 := model.Term{`let` = model.Let{bindings = stripped, body = model.Term{`unit`}}} in let unshadowed0 := environment.termAsBindings (variables.unshadowVariables term0) in let hoisted := hoisting.hoistCaseStatementsInGraph unshadowed0 in let term1 := model.Term{`let` = model.Let{bindings = hoisted, body = model.Term{`unit`}}} in environment.termAsBindings (variables.unshadowVariables term1) in let hoistPoly := λbindings.let letBefore := model.Let{bindings = bindings, body = model.Term{`unit`}} in let letAfter := hoisting.hoistPolymorphicLetBindings isParentBinding letBefore in model.Let[bindings] letAfter in let qualifyUntyped := λb.let nm := model.Name[] (model.Binding[name] b) in optionals.match (names.moduleNameOf (model.Binding[name] b)) (strings.concat2 "(no module) " nm) (λns.strings.concat [packaging.ModuleName[] ns, " :: ", nm]) in let checkBindingsTyped := λdebugLabel,bindings.let untypedBindings := lists.map qualifyUntyped (lists.filter (λb.logic.not (optionals.isGiven (model.Binding[typeScheme] b))) bindings) in logic.ifElse (lists.isEmpty untypedBindings) right(bindings) left(errors.Error{other = errors.OtherError{strings.concat ["Found ", lib.literals.printInt32 (lists.length untypedBindings), " untyped binding(s) (", debugLabel, "); each must carry a type scheme at this stage. ", "This usually means stale dist/json field shapes after a kernel record rename ", "(regenerate the affected package's JSON). Offending bindings (module :: name): ", strings.join ", " untypedBindings]}}) in let normalizeBindings := λbindings.lists.map (λb.model.Binding{name = model.Binding[name] b, `term` = pushTypeAppsInward (model.Binding[`term`] b), typeScheme = model.Binding[typeScheme] b}) bindings in let rebuildGraph := λbindings.let g := lexical.buildGraph bindings maps.empty (graph.Graph[primitives] graph0) in graph.Graph{boundTerms = graph.Graph[boundTerms] g, boundTypes = graph.Graph[boundTypes] g, classConstraints = graph.Graph[classConstraints] g, lambdaVariables = graph.Graph[lambdaVariables] g, metadata = graph.Graph[metadata] g, primitives = graph.Graph[primitives] g, schemaTypes = graph.Graph[schemaTypes] graph0, typeVariables = graph.Graph[typeVariables] g} in let bins0 := originalBindings in let bins1 := logic.ifElse doHoistCaseStatements (hoistCases bins0) bins0 in eithers.bind (logic.ifElse doInfer (eithers.map (λresult.pairs.second (pairs.first result)) (inference.inferGraphTypes cx bins1 (rebuildGraph bins1))) (checkBindingsTyped "after case hoisting" bins1)) (λbins2.eithers.bind (logic.ifElse doHoistPolymorphicLetBindings (checkBindingsTyped "after let hoisting" (hoistPoly bins2)) right(bins2)) (λbins3.eithers.bind (adaptDataGraph constraints doExpand bins3 cx (rebuildGraph bins3)) (λadaptResult.let adapted := pairs.first adaptResult in let adaptedBindings := pairs.second adaptResult in eithers.bind (checkBindingsTyped "after adaptation" adaptedBindings) (λbins4.let bins5Raw := normalizeBindings bins4 in let peelOne := λt.cases(model.Term){typeLambda=λtl.model.TypeLambda[body] tl, typeApplication=λta.model.TypeApplicationTerm[body] ta, `_`=t} t in let extractAnn := λt.cases(model.Term){annotated=λat.given(model.AnnotatedTerm[annotation] at), `_`=none} t in let findAnn := λt.let t1 := peelOne t in let t2 := peelOne t1 in let t3 := peelOne t2 in optionals.match (extractAnn t) (optionals.match (extractAnn t1) (optionals.match (extractAnn t2) (extractAnn t3) (λa.given(a))) (λa.given(a))) (λa.given(a)) in let originalAnnotations := maps.fromList (optionals.givens (lists.map (λb.optionals.match (findAnn (model.Binding[`term`] b)) none (λann.given((model.Binding[name] b, ann)))) originalBindings)) in let reattachAnnotation := λb.optionals.match (maps.lookup (model.Binding[name] b) originalAnnotations) b (λann.model.Binding{name = model.Binding[name] b, `term` = cases(model.Term){annotated=λat.model.Term{annotated = model.AnnotatedTerm{body = model.AnnotatedTerm[body] at, annotation = annotations.wrapAnnotationMap (maps.union (annotations.getAnnotationMap (model.AnnotatedTerm[annotation] at)) (annotations.getAnnotationMap ann))}}, `_`=model.Term{annotated = model.AnnotatedTerm{body = model.Binding[`term`] b, annotation = ann}}} (model.Binding[`term`] b), typeScheme = model.Binding[typeScheme] b}) in let bins5 := lists.map reattachAnnotation bins5Raw in let toDef := λel.optionals.map (λts.packaging.TermDefinition{name = model.Binding[name] el, metadata = none, signature = given(scoping.typeSchemeToTermSignature ts), body = model.Binding[`term`] el}) (model.Binding[typeScheme] el) in let selectedElements := lists.filter (λel.optionals.match (names.moduleNameOf (model.Binding[name] el)) false (λns.sets.member ns namespacesSet)) bins5 in let elementsByNamespace := lists.foldl (λacc,el.optionals.match (names.moduleNameOf (model.Binding[name] el)) acc (λns.let existing := optionals.match (maps.lookup ns acc) [] functions.identity in maps.insert ns (lists.concat2 existing [el]) acc)) maps.empty selectedElements in let defsGrouped := lists.map (λns.let elsForNs := optionals.match (maps.lookup ns elementsByNamespace) [] functions.identity in optionals.givens (lists.map toDef elsForNs)) namespaces in let g := lexical.buildGraph bins5 maps.empty (graph.Graph[primitives] adapted) in right((graph.Graph{boundTerms = graph.Graph[boundTerms] g, boundTypes = graph.Graph[boundTypes] g, classConstraints = graph.Graph[classConstraints] g, lambdaVariables = graph.Graph[lambdaVariables] g, metadata = graph.Graph[metadata] g, primitives = graph.Graph[primitives] g, schemaTypes = graph.Graph[schemaTypes] adapted, typeVariables = graph.Graph[typeVariables] g}, defsGrouped))))))

## Check if a literal type is supported by the given language constraints
term literalTypeSupported = λconstraints,lt.let forType := λlt.cases(model.LiteralType){float=λft.sets.member ft (coders.LanguageConstraints[floatTypes] constraints), integer=λit.sets.member it (coders.LanguageConstraints[integerTypes] constraints), `_`=true} lt in logic.ifElse (sets.member (reflect.literalTypeVariant lt) (coders.LanguageConstraints[literalVariants] constraints)) (forType lt) false

## Prepare a float type, substituting unsupported types
term prepareFloatType = λft.cases(model.FloatType){`float32`=λ`_`.(model.FloatType{`float32`}, (λv.cases(model.FloatValue){`float32`=λf.model.FloatValue{`float32` = f}, `_`=v} v, sets.empty)), `float64`=λ`_`.(model.FloatType{`float64`}, (λv.cases(model.FloatValue){`float64`=λf.model.FloatValue{`float64` = f}, `_`=v} v, sets.empty))} ft

## Prepare an integer type, substituting unsupported types
term prepareIntegerType = λit.cases(model.IntegerType){`bigint`=λ`_`.(model.IntegerType{`int64`}, (λv.cases(model.IntegerValue){`bigint`=λi.model.IntegerValue{`int64` = lib.literals.bigintToInt64 i}, `_`=v} v, sets.fromList ["replace arbitrary-precision integers with 64-bit integers"])), `uint8`=λ`_`.(model.IntegerType{`int8`}, (λv.cases(model.IntegerValue){`uint8`=λi.model.IntegerValue{`int8` = lib.literals.bigintToInt8 (lib.literals.uint8ToBigint i)}, `_`=v} v, sets.fromList ["replace unsigned 8-bit integers with signed 8-bit integers"])), `uint32`=λ`_`.(model.IntegerType{`int32`}, (λv.cases(model.IntegerValue){`uint32`=λi.model.IntegerValue{`int32` = lib.literals.bigintToInt32 (lib.literals.uint32ToBigint i)}, `_`=v} v, sets.fromList ["replace unsigned 32-bit integers with signed 32-bit integers"])), `uint64`=λ`_`.(model.IntegerType{`int64`}, (λv.cases(model.IntegerValue){`uint64`=λi.model.IntegerValue{`int64` = lib.literals.bigintToInt64 (lib.literals.uint64ToBigint i)}, `_`=v} v, sets.fromList ["replace unsigned 64-bit integers with signed 64-bit integers"])), `_`=prepareSame it} it

## Prepare a literal type, substituting unsupported types
term prepareLiteralType = λat.cases(model.LiteralType){`binary`=λ`_`.(model.LiteralType{`string`}, (λv.cases(model.Literal){`binary`=λb.model.Literal{`string` = lib.literals.binaryToBase64 b}, `_`=v} v, sets.fromList ["replace binary strings with character strings"])), `decimal`=λ`_`.(model.LiteralType{float = model.FloatType{`float64`}}, (λv.cases(model.Literal){`decimal`=λd.model.Literal{float = model.FloatValue{`float64` = lib.literals.decimalToFloat64 d}}, `_`=v} v, sets.fromList ["replace arbitrary-precision decimal numbers with 64-bit floating-point numbers (doubles)"])), float=λft.let result := prepareFloatType ft, rtyp := pairs.first result, rep := pairs.first (pairs.second result), msgs := pairs.second (pairs.second result) in (model.LiteralType{float = rtyp}, (λv.cases(model.Literal){float=λfv.model.Literal{float = rep fv}, `_`=v} v, msgs)), integer=λit.let result := prepareIntegerType it, rtyp := pairs.first result, rep := pairs.first (pairs.second result), msgs := pairs.second (pairs.second result) in (model.LiteralType{integer = rtyp}, (λv.cases(model.Literal){integer=λiv.model.Literal{integer = rep iv}, `_`=v} v, msgs)), `_`=prepareSame at} at

## Return a value unchanged with identity transform and no messages
term prepareSame = λx.(x, (λy.y, sets.empty))

## Prepare a type, substituting unsupported literal types
term prepareType = λcx,typ.cases(model.Type){literal=λat.let result := prepareLiteralType at, rtyp := pairs.first result, rep := pairs.first (pairs.second result), msgs := pairs.second (pairs.second result) in (model.Type{literal = rtyp}, (λv.cases(model.Term){literal=λav.model.Term{literal = rep av}, `_`=v} v, msgs)), `_`=prepareSame typ} (strip.deannotateType typ)

## Normalize a term by pushing TermTypeApplication inward past TermApplication and TermLambda. This corrects structures produced by poly-let hoisting and eta expansion, where type applications from inference end up wrapping term applications or lambda abstractions instead of being directly on the polymorphic variable.
term pushTypeAppsInward = λ`term`.let push := λbody,typ.cases(model.Term){annotated=λat.model.Term{annotated = model.AnnotatedTerm{body = push (model.AnnotatedTerm[body] at) typ, annotation = model.AnnotatedTerm[annotation] at}}, application=λa.go model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Application[function] a, `type` = typ}}, argument = model.Application[argument] a}}, lambda=λl.go model.Term{lambda = model.Lambda{parameter = model.Lambda[parameter] l, domain = model.Lambda[domain] l, body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Lambda[body] l, `type` = typ}}}}, `let`=λlt.go model.Term{`let` = model.Let{bindings = model.Let[bindings] lt, body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Let[body] lt, `type` = typ}}}}, `_`=model.Term{typeApplication = model.TypeApplicationTerm{body = body, `type` = typ}}} body, go := λt.let forField := λfld.model.Field{name = model.Field[name] fld, `term` = go (model.Field[`term`] fld)} in let forCaseAlternative := λalt.model.CaseAlternative{name = model.CaseAlternative[name] alt, handler = go (model.CaseAlternative[handler] alt)} in let forLet := λlt.let mapBinding := λb.model.Binding{name = model.Binding[name] b, `term` = go (model.Binding[`term`] b), typeScheme = model.Binding[typeScheme] b} in model.Let{bindings = lists.map mapBinding (model.Let[bindings] lt), body = go (model.Let[body] lt)} in let forMap := λm.let forPair := λp.(go (pairs.first p), go (pairs.second p)) in maps.fromList (lists.map forPair (maps.toList m)) in cases(model.Term){annotated=λat.model.Term{annotated = model.AnnotatedTerm{body = go (model.AnnotatedTerm[body] at), annotation = model.AnnotatedTerm[annotation] at}}, application=λa.model.Term{application = model.Application{function = go (model.Application[function] a), argument = go (model.Application[argument] a)}}, `cases`=λcs.model.Term{`cases` = model.CaseStatement{typeName = model.CaseStatement[typeName] cs, default = optionals.map go (model.CaseStatement[default] cs), `cases` = lists.map forCaseAlternative (model.CaseStatement[`cases`] cs)}}, `either`=λe.model.Term{`either` = eithers.either (λl.left(go l)) (λr.right(go r)) e}, lambda=λl.model.Term{lambda = model.Lambda{parameter = model.Lambda[parameter] l, domain = model.Lambda[domain] l, body = go (model.Lambda[body] l)}}, `let`=λlt.model.Term{`let` = forLet lt}, `list`=λels.model.Term{`list` = lists.map go els}, literal=λv.model.Term{literal = v}, `map`=λm.model.Term{`map` = forMap m}, `optional`=λm.model.Term{`optional` = optionals.map go m}, pair=λp.model.Term{pair = (go (pairs.first p), go (pairs.second p))}, `project`=λp.model.Term{`project` = p}, `record`=λr.model.Term{`record` = model.Record{typeName = model.Record[typeName] r, fields = lists.map forField (model.Record[fields] r)}}, `set`=λs.model.Term{`set` = sets.fromList (lists.map go (sets.toList s))}, typeApplication=λtt.let body1 := go (model.TypeApplicationTerm[body] tt) in push body1 (model.TypeApplicationTerm[`type`] tt), typeLambda=λta.model.Term{typeLambda = model.TypeLambda{parameter = model.TypeLambda[parameter] ta, body = go (model.TypeLambda[body] ta)}}, `inject`=λi.model.Term{`inject` = model.Injection{typeName = model.Injection[typeName] i, field = forField (model.Injection[field] i)}}, `unit`=λ`_`.model.Term{`unit`}, `unwrap`=λn.model.Term{`unwrap` = n}, variable=λv.model.Term{variable = v}, `wrap`=λwt.model.Term{`wrap` = model.WrappedTerm{typeName = model.WrappedTerm[typeName] wt, body = go (model.WrappedTerm[body] wt)}}} t in go `term`

## Given a schema graph along with language constraints and a designated list of element names, adapt the graph to the language constraints, then return a corresponding type definition for each element name.
term schemaGraphToDefinitions = λconstraints,graph,nameLists,cx.let litmap := adaptLiteralTypesMap constraints in eithers.bind (eithers.bimap (λe.errors.Error{decoding = e}) (λx.x) (environment.graphAsTypes graph (lexical.graphToBindings graph))) (λtmap0.eithers.bind (adaptGraphSchema constraints litmap tmap0) (λtmap1.let toDef := λpair.packaging.TypeDefinition{name = pairs.first pair, metadata = none, body = model.TypeScheme{variables = [], body = pairs.second pair, constraints = maps.empty}} in right((tmap1, lists.map (λnames.lists.map toDef (optionals.mapOptional (λn.optionals.map (λt.(n, t)) (maps.lookup n tmap1)) names)) nameLists))))

## Given a target language and a source type, produce an adapter which rewrites the type and its terms according to the language's constraints. The encode direction adapts terms; the decode direction is identity.
term simpleLanguageAdapter = λlang,cx,g,typ.let constraints := coders.Language[constraints] lang in let litmap := adaptLiteralTypesMap constraints in eithers.bind (adaptType constraints litmap typ) (λadaptedType.right(coders.Adapter{isLossy = false, source = typ, target = adaptedType, coder = coders.Coder{encode = λ`term`.adaptTerm constraints litmap cx g `term`, decode = λ`term`.right(`term`)}}))

## Find a list of alternatives for a given term, if any
term termAlternatives = λcx,graph,`term`.cases(model.Term){annotated=λat.let term2 := model.AnnotatedTerm[body] at in right([term2]), `optional`=λot.right([model.Term{`list` = optionals.match ot [] (λterm2.[term2])}]), typeLambda=λabs.let term2 := model.TypeLambda[body] abs in right([term2]), typeApplication=λta.let term2 := model.TypeApplicationTerm[body] ta in right([term2]), `inject`=λinj.let tname := model.Injection[typeName] inj in let field := model.Injection[field] inj in let fname := model.Field[name] field in let fterm := model.Field[`term`] field in let forFieldType := λft.let ftname := model.FieldType[name] ft in model.Field{name = fname, `term` = model.Term{`optional` = logic.ifElse (equality.equal ftname fname) given(fterm) none}} in eithers.bind (resolution.requireUnionType cx graph tname) (λrt.right([model.Term{`record` = model.Record{typeName = tname, fields = lists.map forFieldType rt}}])), `unit`=λ`_`.right([model.Term{literal = model.Literal{`boolean` = true}}]), `wrap`=λwt.let term2 := model.WrappedTerm[body] wt in right([term2]), `_`=right([])} `term`

## Find a list of alternatives for a given type, if any
term typeAlternatives = λ`type`.cases(model.Type){annotated=λat.let type2 := model.AnnotatedType[body] at in [type2], `effect`=λet.[et], `optional`=λot.[model.Type{`list` = ot}], `union`=λrt.let toOptField := λf.model.FieldType{name = model.FieldType[name] f, `type` = model.Type{`optional` = model.FieldType[`type`] f}} in let optFields := lists.map toOptField rt in [model.Type{`record` = optFields}], `unit`=λ`_`.[model.Type{literal = model.LiteralType{`boolean`}}], `void`=λ`_`.[model.Type{`unit`}], `_`=[]} `type`