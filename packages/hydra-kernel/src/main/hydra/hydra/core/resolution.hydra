## Type dereference, lookup, requirements, and instantiation
module hydra.core.resolution

import hydra.core.decode.model as model
import hydra.core.errors
import hydra.core.graph
import hydra.core.lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.pairs
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.names
import hydra.core.print.model
import hydra.core.scoping
import hydra.core.strip
import hydra.core.substitution
import hydra.core.typing
import hydra.core.variables

## Dereference a type name to get the actual type (Either version)
term dereferenceType =
  λcx,graph,name.
    let mel := lookupBinding graph name
    in optionals.match
      mel
      right(none)
      (λel.eithers.map
          optionals.given
          (eithers.bimap
            (λ`_e`.Error{
                resolution = ResolutionError{
                  unexpectedShape = UnexpectedShapeError{
                    expected = "type",
                    actual = DecodingError[] `_e`}}})
            (λ`_a`.`_a`)
            (model.type graph (Binding[`term`] el))))

## Test whether a given System F type is polymorphic (i.e., a forall type)
term fTypeIsPolymorphic =
  λtyp.cases(Type){annotated=λat.fTypeIsPolymorphic (AnnotatedType[body] at), `forall`=λft.true, `_`=false} typ

## Build a map from field name to field term, given a list of fields
term fieldMap =
  λfields.let toPair := λf.(Field[name] f, Field[`term`] f) in maps.fromList (lists.map toPair fields)

## Build a map from field name to field type, given a list of field types
term fieldTypeMap =
  λfields.let toPair := λf.(FieldType[name] f, FieldType[`type`] f) in maps.fromList (lists.map toPair fields)

## Get field types from a record or union type (Either version)
term fieldTypes =
  λcx,graph,t.
    let toMap := λfields.maps.fromList (lists.map (λft.(FieldType[name] ft, FieldType[`type`] ft)) fields)
    in cases(Type){
      `forall`=λft.fieldTypes cx graph (ForallType[body] ft),
      `record`=λrt.right(toMap rt),
      `union`=λrt.right(toMap rt),
      variable=λname.optionals.match
            (maps.lookup name (Graph[schemaTypes] graph))
            (eithers.bind
              (requireBinding graph name)
              (λel.eithers.bind
                  (eithers.bimap
                    (λ`_e`.Error{
                        resolution = ResolutionError{
                          unexpectedShape = UnexpectedShapeError{
                            expected = "type",
                            actual = DecodingError[] `_e`}}})
                    (λ`_a`.`_a`)
                    (model.type graph (Binding[`term`] el)))
                  (λdecodedType.fieldTypes cx graph decodedType)))
            (λts.fieldTypes cx graph (TypeScheme[body] ts)),
      `_`=left(Error{
          resolution = ResolutionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "record or union type",
              actual = `type` t}}})}
      (deannotateType t)

## Find a field type by name in a list of field types
term findFieldType =
  λcx,fname,fields.
    let matchingFields := lists.filter (λft.equal (Name[] (FieldType[name] ft)) (Name[] fname)) fields in
    let noMatch := left(Error{
        resolution = ResolutionError{
          noMatchingField = NoMatchingFieldError{
            fieldName = fname}}}) in
    ifElse
      (lists.isEmpty matchingFields)
      noMatch
      (ifElse
        (equal (lists.length matchingFields) 1:int32)
        (optionals.match (lists.head matchingFields) noMatch (λft.right(FieldType[`type`] ft)))
        left(Error{extraction = ExtractionError{multipleFields = MultipleFieldsError{fieldName = fname}}}))

## Fully strip a type of forall quantifiers, normalizing bound variable names for alpha-equivalence comparison
term fullyStripAndNormalizeType =
  λtyp.
    let go := λdepth,subst,t.cases(Type){
          `forall`=λft.
              let oldVar := ForallType[parameter] ft in
              let newVar := Name{strings.concat2 "_" (printInt32 depth)} in
              go
                (add depth 1:int32)
                (maps.insert oldVar newVar subst)
                (ForallType[body] ft),
          `_`=(subst, t)}
          (deannotateType t) in
    let result := go 0:int32 maps.empty typ in
    let subst := first result in
    let body := second result in
    substituteTypeVariables subst body

## Fully strip a type of forall quantifiers
term fullyStripType =
  λtyp.cases(Type){`forall`=λft.fullyStripType (ForallType[body] ft), `_`=typ} (deannotateType typ)

## Instantiate a type by replacing all forall-bound type variables with fresh variables, threading InferenceContext
term instantiateType =
  λcx,typ.
    let result := instantiateTypeScheme cx (typeToTypeScheme typ)
    in (typeSchemeToFType (first result), second result)

## Instantiate a type scheme with fresh variables, threading InferenceContext
term instantiateTypeScheme =
  λcx,scheme.
    let oldVars := TypeScheme[variables] scheme in
    let result := freshNames (lists.length oldVars) cx in
    let newVars := first result in
    let cx2 := second result in
    let subst := TypeSubst{maps.fromList (lists.zip oldVars (lists.map (λx.Type{variable = x}) newVars))} in
    let nameSubst := maps.fromList (lists.zip oldVars newVars) in
    let renamedConstraints := maps.fromList
        (lists.map
          (λkv.(optionals.withDefault (first kv) (maps.lookup (first kv) nameSubst), second kv))
          (maps.toList (TypeScheme[constraints] scheme))) in
    (
      TypeScheme{
        variables = newVars,
        body = substInType subst (TypeScheme[body] scheme),
        constraints = renamedConstraints},
      cx2)

## Test whether a map's key type resolves to string, following aliases and wrappers. Used to decide whether a map may use the compact JSON object encoding.
term mapKeyResolvesToString =
  λtypes,keyType.cases(Type){literal=λlt.cases(LiteralType){`string`=λ`_`.true, `_`=false} lt, `_`=false}
      (resolveBaseType types keyType)

## Apply type arguments to a nominal type
term nominalApplication =
  λtname,args.lists.foldl
      (λt,a.Type{application = ApplicationType{function = t, argument = a}})
      Type{variable = tname}
      args

## Require a name to resolve to a record type
term requireRecordType =
  λcx,graph,name.
    let toRecord := λt.cases(Type){`record`=λrt.given(rt), `_`=none} t
    in requireRowType cx "record type" toRecord graph name

## Require a name to resolve to a row type
term requireRowType =
  λcx,label,getter,graph,name.
    let rawType := λt.cases(Type){
          annotated=λat.rawType (AnnotatedType[body] at),
          `forall`=λft.rawType (ForallType[body] ft),
          `_`=t}
          t
    in eithers.bind
      (requireType cx graph name)
      (λt.optionals.match
          (getter (rawType t))
          left(Error{
            resolution = ResolutionError{
              unexpectedShape = UnexpectedShapeError{
                expected = strings.concat2 label " type",
                actual = strings.concat2
                    (Name[] name)
                    (strings.concat2 ": " (`type` t))}}})
          (λx.right(x)))

## Look up a schema type and instantiate it, threading InferenceContext
term requireSchemaType =
  λcx,types,tname.optionals.match
      (maps.lookup tname types)
      left(Error{resolution = ResolutionError{noSuchBinding = NoSuchBindingError{name = tname}}})
      (λts.right(instantiateTypeScheme cx (deannotateTypeSchemeRecursive ts)))

## Require a type by name
term requireType =
  λcx,graph,name.optionals.match
      (maps.lookup name (Graph[schemaTypes] graph))
      (optionals.match
        (maps.lookup name (Graph[boundTypes] graph))
        left(Error{resolution = ResolutionError{noSuchBinding = NoSuchBindingError{name = name}}})
        (λts.right(typeSchemeToFType ts)))
      (λts.right(typeSchemeToFType ts))

## Require a field type from a union type
term requireUnionField =
  λcx,graph,tname,fname.
    let withRowType := λrt.
        let noMatchErr := left(Error{
            resolution = ResolutionError{
              noMatchingField = NoMatchingFieldError{
                fieldName = fname}}})
        in optionals.match
          (lists.find (λft.equal (FieldType[name] ft) fname) rt)
          noMatchErr
          (λft.right(FieldType[`type`] ft))
    in eithers.bind (requireUnionType cx graph tname) withRowType

## Require a name to resolve to a union type
term requireUnionType =
  λcx,graph,name.
    let toUnion := λt.cases(Type){`union`=λrt.given(rt), `_`=none} t
    in requireRowType cx "union" toUnion graph name

## Resolve a type to its base, following annotations, type aliases (Type.variable dereferenced against the given type map), and Type.wrap bodies, transitively. An unresolvable variable name (not found in the map) is returned as-is, since the caller is in the best position to decide whether that is an error. As with hydra.sources.kernel.terms.lexical.dereferenceSchemaType, this assumes type aliases form an acyclic reference graph, as guaranteed by schema construction; a genuinely self-referential alias is not a supported input and would not terminate.
term resolveBaseType =
  λtypes,typ.
    let stripped := deannotateType typ
    in cases(Type){
      variable=λname.optionals.match
            (maps.lookup name types)
            stripped
            (λresolved.resolveBaseType types resolved),
      `wrap`=λinner.resolveBaseType types inner,
      `_`=stripped}
      stripped

## Resolve a type, dereferencing type variables
term resolveType =
  λgraph,typ.cases(Type){
      variable=λname.optionals.match
            (maps.lookup name (Graph[schemaTypes] graph))
            (optionals.map
              (λts.typeSchemeToFType ts)
              (maps.lookup name (Graph[boundTypes] graph)))
            (λts.given(typeSchemeToFType ts)),
      `_`=given(typ)}
      (deannotateType typ)

## Convert a (System F -style) type to a type scheme
term typeToTypeScheme =
  λt0.
    let helper := λvars,t.cases(Type){
          `forall`=λft.helper
                (lists.cons (ForallType[parameter] ft) vars)
                (ForallType[body] ft),
          `_`=TypeScheme{
            variables = lists.reverse vars,
            body = t,
            constraints = maps.empty}}
          (deannotateType t)
    in helper [] t0