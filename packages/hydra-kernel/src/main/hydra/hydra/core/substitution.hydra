## Variable substitution in type and term expressions.
module hydra.core.substitution

import hydra.core.classes as classes
import hydra.core.graph as graph
import hydra.core.lib.lists as lists
import hydra.core.lib.logic as logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering as ordering
import hydra.core.lib.pairs as pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model as model
import hydra.core.rewriting as rewriting
import hydra.core.typing as typing
import hydra.core.variables as variables

## Compose two type substitutions
term composeTypeSubst =
  λs1,s2.logic.ifElse
      (maps.isEmpty (typing.TypeSubst[] s1))
      s2
      (logic.ifElse (maps.isEmpty (typing.TypeSubst[] s2)) s1 (composeTypeSubstNonEmpty s1 s2))

## Compose a list of type substitutions
term composeTypeSubstList = lists.foldl composeTypeSubst idTypeSubst

## Compose two non-empty type substitutions (internal helper)
term composeTypeSubstNonEmpty =
  λs1,s2.
    let isExtra := λk,v.optionals.isNone (maps.lookup k (typing.TypeSubst[] s1)), withExtra := maps.filterWithKey isExtra (typing.TypeSubst[] s2)
    in typing.TypeSubst{maps.union withExtra (maps.map (substInType s2) (typing.TypeSubst[] s1))}

## The identity type substitution
term idTypeSubst = wrap(typing.TypeSubst){maps.empty}

## Create a type substitution with a single variable mapping
term singletonTypeSubst = λv,t.typing.TypeSubst{maps.singleton v t}

## Apply a type substitution to class constraints, propagating to free variables or discharging/retaining on concrete resolution
term substInClassConstraints =
  λsubst,constraints.
    let substMap := typing.TypeSubst[] subst
    in logic.ifElse
      (logic.or (maps.isEmpty substMap) (maps.isEmpty constraints))
      constraints
      (let isGenuineVarName := λname.ordering.lte
            (lists.length (strings.splitOn "." (model.Name[] name)))
            1:int32 in
      let insertOrMerge := λvarName,metadata,acc.optionals.match
            (maps.lookup varName acc)
            (maps.insert varName metadata acc)
            (λexisting.
              let merged := model.TypeVariableConstraints{
                classes = sets.union
                    (model.TypeVariableConstraints[classes]
                      existing)
                    (model.TypeVariableConstraints[classes]
                      metadata)}
              in maps.insert varName merged acc) in
      lists.foldl
        (λacc,pair.
          let varName := pairs.first pair in
          let metadata := pairs.second pair in
          optionals.match
            (maps.lookup varName substMap)
            (insertOrMerge varName metadata acc)
            (λtargetType.
              let genuineVars := lists.filter
                  isGenuineVarName
                  (sets.toList (variables.freeVariablesInType targetType))
              in logic.ifElse
                (logic.not (lists.isEmpty genuineVars))
                (lists.foldl
                  (λacc2,freeVar.insertOrMerge freeVar metadata acc2)
                  acc
                  genuineVars)
                (let unsatisfied := sets.filter
                    (λc.logic.not
                        (classes.classIsSatisfiedByType
                          (cases(model.TypeClassConstraint){simple=λn.n} c)
                          targetType))
                    (model.TypeVariableConstraints[classes] metadata)
                in logic.ifElse
                  (sets.isEmpty unsatisfied)
                  acc
                  (insertOrMerge
                    varName
                    model.TypeVariableConstraints{classes = unsatisfied}
                    acc))))
        maps.empty
        (maps.toList constraints))

## Apply a type substitution to a graph's bound types and class constraints
term substInContext =
  λsubst,cx.
    let newBoundTypes := maps.map (substInTypeScheme subst) (graph.Graph[boundTypes] cx) in
    let newClassConstraints := substInClassConstraints subst (graph.Graph[classConstraints] cx) in
    let cx2 := graph.Graph{
      boundTerms = graph.Graph[boundTerms] cx,
      boundTypes = newBoundTypes,
      classConstraints = graph.Graph[classConstraints] cx,
      lambdaVariables = graph.Graph[lambdaVariables] cx,
      metadata = graph.Graph[metadata] cx,
      primitives = graph.Graph[primitives] cx,
      schemaTypes = graph.Graph[schemaTypes] cx,
      typeVariables = graph.Graph[typeVariables] cx} in
    graph.Graph{
      boundTerms = graph.Graph[boundTerms] cx2,
      boundTypes = graph.Graph[boundTypes] cx2,
      classConstraints = newClassConstraints,
      lambdaVariables = graph.Graph[lambdaVariables] cx2,
      metadata = graph.Graph[metadata] cx2,
      primitives = graph.Graph[primitives] cx2,
      schemaTypes = graph.Graph[schemaTypes] cx2,
      typeVariables = graph.Graph[typeVariables] cx2}

## Apply a type substitution to a type
term substInType =
  λsubst,typ0.logic.ifElse (maps.isEmpty (typing.TypeSubst[] subst)) typ0 (substInTypeNonEmpty subst typ0)

## Apply a non-empty type substitution to a type (internal helper)
term substInTypeNonEmpty =
  λsubst,typ0.
    let rewrite := λrecurse,typ.cases(model.Type){
          `forall`=λlt.optionals.match
                (maps.lookup
                  (model.ForallType[parameter] lt)
                  (typing.TypeSubst[] subst))
                (recurse typ)
                (λstyp.model.Type{
                    `forall` = model.ForallType{
                      parameter = model.ForallType[parameter] lt,
                      body = substInType
                          (removeVar
                            (model.ForallType[parameter] lt))
                          (model.ForallType[body] lt)}}),
          variable=λv.optionals.match
                (maps.lookup v (typing.TypeSubst[] subst))
                typ
                (λstyp.styp),
          `_`=recurse typ}
          typ, removeVar := λv.typing.TypeSubst{maps.delete v (typing.TypeSubst[] subst)}
    in rewriting.rewriteType rewrite typ0

## Apply a type substitution to a type scheme. The scheme's quantifier variables shadow the substitution: any name in typeSchemeVariables is removed from subst before substituting into the body and constraints. Without this, a substitution like {t0 -> Foo} applied to `forall [t0]. t0 -> t0` would incorrectly replace the bound t0.
term substInTypeScheme =
  λsubst,ts.
    let scopedSubst := typing.TypeSubst{lists.foldl
      (λm,v.maps.delete v m)
      (typing.TypeSubst[] subst)
      (model.TypeScheme[variables] ts)}
    in model.TypeScheme{
      variables = model.TypeScheme[variables] ts,
      body = substInType scopedSubst (model.TypeScheme[body] ts),
      constraints = substInClassConstraints scopedSubst (model.TypeScheme[constraints] ts)}

## Apply a type substitution to the type annotations within a term
term substTypesInTerm =
  λsubst,term0.
    let rewrite := λrecurse,`term`.
        let dflt := recurse `term`, forLambda := λl.model.Term{
              lambda = model.Lambda{
                parameter = model.Lambda[parameter] l,
                domain = optionals.map
                    (substInType subst)
                    (model.Lambda[domain] l),
                body = substTypesInTerm
                    subst
                    (model.Lambda[body] l)}}, forLet := λl.
            let rewriteBinding := λb.model.Binding{
                  name = model.Binding[name] b,
                  `term` = substTypesInTerm
                      subst
                      (model.Binding[`term`] b),
                  typeScheme = optionals.map
                      (substInTypeScheme subst)
                      (model.Binding[typeScheme] b)}
            in model.Term{
              `let` = model.Let{
                bindings = lists.map
                    rewriteBinding
                    (model.Let[bindings] l),
                body = substTypesInTerm
                    subst
                    (model.Let[body] l)}}, forTypeApplication := λtt.model.Term{
              typeApplication = model.TypeApplicationTerm{
                body = substTypesInTerm
                    subst
                    (model.TypeApplicationTerm[body] tt),
                `type` = substInType
                    subst
                    (model.TypeApplicationTerm[`type`] tt)}}, forTypeLambda := λta.
            let param := model.TypeLambda[parameter] ta, subst2 := typing.TypeSubst{maps.delete
              param
              (typing.TypeSubst[] subst)}
            in model.Term{
              typeLambda = model.TypeLambda{
                parameter = param,
                body = substTypesInTerm
                    subst2
                    (model.TypeLambda[body] ta)}}
        in cases(model.Term){
          lambda=λl.forLambda l,
          `let`=λl.forLet l,
          typeApplication=λta.forTypeApplication ta,
          typeLambda=λtl.forTypeLambda tl,
          `_`=dflt}
          `term`
    in rewriting.rewriteTerm rewrite term0

## Apply a term substitution to a binding
term substituteInBinding =
  λsubst,b.model.Binding{
      name = model.Binding[name] b,
      `term` = substituteInTerm subst (model.Binding[`term`] b),
      typeScheme = model.Binding[typeScheme] b}

## Apply a type substitution to a type constraint
term substituteInConstraint =
  λsubst,c.typing.TypeConstraint{
      `left` = substInType subst (typing.TypeConstraint[`left`] c),
      `right` = substInType subst (typing.TypeConstraint[`right`] c),
      comment = typing.TypeConstraint[comment] c}

## Apply a type substitution to a list of type constraints
term substituteInConstraints = λsubst,cs.lists.map (substituteInConstraint subst) cs

## Apply a term substitution to a term
term substituteInTerm =
  λsubst,term0.
    let s := typing.TermSubst[] subst, rewrite := λrecurse,`term`.
        let withLambda := λl.
            let v := model.Lambda[parameter] l, subst2 := typing.TermSubst{maps.delete v s}
            in model.Term{
              lambda = model.Lambda{
                parameter = v,
                domain = model.Lambda[domain] l,
                body = substituteInTerm
                    subst2
                    (model.Lambda[body] l)}}, withLet := λlt.
            let bindings := model.Let[bindings] lt, names := sets.fromList
                (lists.map model.Binding[name] bindings), subst2 := typing.TermSubst{maps.filterWithKey
              (λk,v.logic.not (sets.member k names))
              s}, rewriteBinding := λb.model.Binding{
                  name = model.Binding[name] b,
                  `term` = substituteInTerm
                      subst2
                      (model.Binding[`term`] b),
                  typeScheme = model.Binding[typeScheme] b}
            in model.Term{
              `let` = model.Let{
                bindings = lists.map rewriteBinding bindings,
                body = substituteInTerm
                    subst2
                    (model.Let[body] lt)}}
        in cases(model.Term){
          lambda=λl.withLambda l,
          `let`=λl.withLet l,
          variable=λname.optionals.match
                (maps.lookup name s)
                (recurse `term`)
                (λsterm.sterm),
          `_`=recurse `term`}
          `term`
    in rewriting.rewriteTerm rewrite term0