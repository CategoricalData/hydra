## Dependency extraction, binding sort, and let normalization
module hydra.core.dependencies

import hydra.core.annotations
import hydra.core.coders
import hydra.core.constants
import hydra.core.errors
import hydra.core.lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math
import hydra.core.lib.optionals
import hydra.core.lib.ordering
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.names
import hydra.core.packaging
import hydra.core.rewriting
import hydra.core.sorting
import hydra.core.strip
import hydra.core.variables

## Get definitions with their dependencies
term definitionsWithDependencies =
  λcx,graph,original.
    let depNames := λel.sets.toList (termDependencyNames true false false (Binding[`term`] el)) in
    let allDepNames := lists.distinct
        (lists.concat2
          (lists.map Binding[name] original)
          (lists.concat (lists.map depNames original))) in
    eithers.mapList (λname.requireBinding graph name) allDepNames

## Flatten nested let expressions
term flattenLetTerms =
  λ`term`.
    let rewriteBinding := λbinding.
        let key0 := Binding[name] binding in
        let val0 := Binding[`term`] binding in
        let t := Binding[typeScheme] binding in
        cases(Term){
          annotated=λat.
              let val1 := AnnotatedTerm[body] at in
              let ann := AnnotatedTerm[annotation] at in
              let recursive := rewriteBinding
                  Binding{
                    name = key0,
                    `term` = val1,
                    typeScheme = t} in
              let innerBinding := first recursive in
              let deps := second recursive in
              let val2 := Binding[`term`] innerBinding in
              (
                Binding{name = key0, `term` = Term{annotated = AnnotatedTerm{body = val2, annotation = ann}}, typeScheme = t},
                deps),
          `let`=λinnerLet.
              let bindings1 := Let[bindings] innerLet in
              let body1 := Let[body] innerLet in
              let prefix := strings.concat2 (Name[] key0) "_" in
              let qualify := λn.Name{strings.concat2 prefix (Name[] n)} in
              let toSubstPair := λb.(Binding[name] b, qualify (Binding[name] b)) in
              let subst := maps.fromList
                  (lists.map toSubstPair bindings1) in
              let replaceVars := substituteVariables subst in
              let newBody := replaceVars body1 in
              let newBinding := λb.Binding{
                    name = qualify (Binding[name] b),
                    `term` = replaceVars (Binding[`term`] b),
                    typeScheme = Binding[typeScheme] b} in
              (Binding{name = key0, `term` = newBody, typeScheme = t}, lists.map newBinding bindings1),
          `_`=(Binding{name = key0, `term` = val0, typeScheme = t}, [])}
          val0 in
    let flattenBodyLet := λbindings,body.cases(Term){
          `let`=λinnerLt.
              let innerBindings := Let[bindings] innerLt in
              let innerBody := Let[body] innerLt in
              flattenBodyLet
                (lists.concat2 bindings innerBindings)
                innerBody,
          `_`=(lists.concat2 [] bindings, body)}
          body in
    let flatten := λrecurse,`term`.
        let rewritten := recurse `term`
        in cases(Term){
          `let`=λlt.
              let bindings := Let[bindings] lt in
              let body := Let[body] lt in
              let forResult := λhr.lists.concat2
                    (second hr)
                    (lists.singleton (first hr)) in
              let flattenedBindings := lists.concat
                  (lists.map
                    (λ`arg_`.forResult (rewriteBinding `arg_`))
                    bindings) in
              let merged := flattenBodyLet flattenedBindings body in
              let newBindings := first merged in
              let newBody := second merged in
              Term{
                `let` = Let{
                  bindings = newBindings,
                  body = newBody}},
          `_`=rewritten}
          rewritten in
    rewriteTerm flatten `term`

## Inline all type variables in a type using the provided schema (Either version). Note: this function is only appropriate for nonrecursive type definitions
term inlineType =
  λschema,typ.
    let f := λrecurse,typ.
        let afterRecurse := λtr.cases(Type){
              variable=λv.match
                    (maps.lookup v schema)
                    left(Error{
                      other = OtherError{strings.concat2
                        "No such type in schema: "
                        (Name[] v)}})
                    (inlineType schema),
              `_`=right(tr)}
              tr
        in eithers.bind (recurse typ) (λtr.afterRecurse tr)
    in rewriteTypeM f typ

## Check whether a term is a lambda, possibly nested within let and/or annotation terms
term isLambda =
  λ`term`.cases(Term){lambda=λ`_`.true, `let`=λlt.isLambda (Let[body] lt), `_`=false} (deannotateTerm `term`)

## Rewrite terms like `let foo = bar in λx.baz` to `λx.let foo = bar in baz`, lifting lambda-bound variables above let-bound variables, recursively. This is helpful for targets such as Python.
term liftLambdaAboveLet =
  λterm0.
    let rewrite := λrecurse,`term`.
        let rewriteBinding := λb.Binding{
              name = Binding[name] b,
              `term` = rewrite recurse (Binding[`term`] b),
              typeScheme = Binding[typeScheme] b} in
        let rewriteBindings := λbs.lists.map rewriteBinding bs in
        let digForLambdas := λoriginal,cons,`term`.cases(Term){
              annotated=λat.digForLambdas
                    original
                    (λt.Term{
                        annotated = AnnotatedTerm{
                          body = cons t,
                          annotation = AnnotatedTerm[annotation] at}})
                    (AnnotatedTerm[body] at),
              lambda=λl.Term{
                    lambda = Lambda{
                      parameter = Lambda[parameter] l,
                      domain = Lambda[domain] l,
                      body = digForLambdas
                          (cons (Lambda[body] l))
                          (λt.cons t)
                          (Lambda[body] l)}},
              `let`=λl.digForLambdas
                    original
                    (λt.cons
                        Term{
                          `let` = Let{
                            bindings = rewriteBindings (Let[bindings] l),
                            body = t}})
                    (Let[body] l),
              `_`=recurse original}
              `term` in
        cases(Term){
          `let`=λl.digForLambdas
                `term`
                (λt.Term{
                    `let` = Let{
                      bindings = rewriteBindings (Let[bindings] l),
                      body = t}})
                (Let[body] l),
          `_`=recurse `term`}
          `term`
    in rewriteTerm rewrite term0

## Given a let expression, remove any unused bindings. The resulting expression is still a let, even if has no remaining bindings
term pruneLet =
  λl.
    let bindingMap := maps.fromList (lists.map (λb.(Binding[name] b, Binding[`term`] b)) (Let[bindings] l)) in
    let rootName := Name{"[[[root]]]"} in
    let adj := λn.sets.intersection
          (sets.fromList (maps.keys bindingMap))
          (freeVariablesInTerm
            (ifElse (equal n rootName) (Let[body] l) (withDefault Term{`unit`} (maps.lookup n bindingMap)))) in
    let reachable := findReachableNodes adj rootName in
    let prunedBindings := lists.filter (λb.sets.member (Binding[name] b) reachable) (Let[bindings] l) in
    Let{bindings = prunedBindings, body = Let[body] l}

## Replace all occurrences of simple typedefs (type aliases) with the aliased types, recursively
term replaceTypedefs =
  λtypes,typ0.
    let rewrite := λrecurse,typ.cases(Type){
          annotated=λat.Type{
                annotated = AnnotatedType{
                  body = rewrite recurse (AnnotatedType[body] at),
                  annotation = AnnotatedType[annotation] at}},
          `record`=λ`_`.typ,
          `union`=λ`_`.typ,
          variable=λv.
              let forMono := λt.cases(Type){
                    `record`=λ`_`.typ,
                    `union`=λ`_`.typ,
                    `wrap`=λ`_`.typ,
                    `_`=rewrite recurse t}
                    t in
              let forTypeScheme := λts.
                  let t := TypeScheme[body] ts
                  in ifElse
                    (lists.isEmpty (TypeScheme[variables] ts))
                    (forMono t)
                    typ in
              match
                (maps.lookup v types)
                typ
                (λts.forTypeScheme ts),
          `wrap`=λ`_`.typ,
          `_`=recurse typ}
          typ
    in rewriteType rewrite typ0

## Simplify terms by applying beta reduction where possible
term simplifyTerm =
  λ`term`.
    let simplify := λrecurse,`term`.
        let forRhs := λrhs,var,body.cases(Term){
              variable=λv.simplifyTerm
                    (substituteVariable var v body),
              `_`=`term`}
              (deannotateTerm rhs) in
        let forLhs := λlhs,rhs.cases(Term){
              lambda=λl.
                  let var := Lambda[parameter] l in
                  let body := Lambda[body] l in
                  ifElse
                    (sets.member
                      var
                      (freeVariablesInTerm body))
                    (forRhs rhs var body)
                    (simplifyTerm body),
              `_`=`term`}
              (deannotateTerm lhs) in
        let forTerm := λstripped.cases(Term){
              application=λapp.
                  let lhs := Application[function] app in
                  let rhs := Application[argument] app in
                  forLhs lhs rhs,
              `_`=`term`}
              stripped in
        let stripped := deannotateTerm `term` in
        recurse (forTerm stripped)
    in rewriteTerm simplify `term`

## Note: does not distinguish between bound and free variables; use freeVariablesInTerm for that
term termDependencyNames =
  λbinds,withPrims,withNoms,term0.
    let addNames := λnames,`term`.
        let nominal := λname.ifElse
              withNoms
              (sets.insert name names)
              names in
        let prim := λname.ifElse
              withPrims
              (sets.insert name names)
              names in
        let var := λname.ifElse
              binds
              (sets.insert name names)
              names in
        cases(Term){
          `cases`=λcaseStmt.nominal
                (CaseStatement[typeName] caseStmt),
          `project`=λproj.nominal (Projection[typeName] proj),
          `unwrap`=λname.nominal name,
          `record`=λ`record`.nominal (Record[typeName] `record`),
          `inject`=λinjection.nominal (Injection[typeName] injection),
          variable=λname.var name,
          `wrap`=λwrappedTerm.nominal
                (WrappedTerm[typeName] wrappedTerm),
          `_`=names}
          `term`
    in foldOverTerm TraversalOrder{pre} addNames sets.empty term0

## Generate short names from a list of fully qualified names
term toShortNames =
  λoriginal.
    let addName := λacc,name.
        let local := localNameOf name in
        let group := withDefault sets.empty (maps.lookup local acc) in
        maps.insert local (sets.insert name group) acc in
    let groupNamesByLocal := λnames.lists.foldl addName maps.empty names in
    let groups := groupNamesByLocal original in
    let renameGroup := λlocalNames.
        let local := first localNames in
        let names := second localNames in
        let rangeFrom := λstart.lists.cons start (rangeFrom (add start 1:int32)) in
        let rename := λname,i.(name, Name{ifElse (gt i 1:int32) (strings.concat2 local (printInt32 i)) local}) in
        lists.zipWith rename (sets.toList names) (rangeFrom 1:int32) in
    maps.fromList (lists.concat (lists.map renameGroup (maps.toList groups)))

## Topological sort of connected components, in terms of dependencies between variable/term binding pairs. The SCC partitioning is what makes the result usable as an emission order in every target language: non-recursive bindings emit in dependency order, while a mutually recursive cluster is delivered together so the emitter can wrap it in whatever construct the host requires (mutual `let`s, joint class files, forward declarations).
term topologicalSortBindingMap =
  λbindingMap.
    let bindings := maps.toList bindingMap in
    let keys := sets.fromList (lists.map first bindings) in
    let hasTypeAnnotation := λ`term`.isGiven (getTermAnnotation keyType `term`) in
    let depsOf := λnameAndTerm.
        let name := first nameAndTerm in
        let `term` := second nameAndTerm in
        (name, ifElse (hasTypeAnnotation `term`) [] (sets.toList (sets.intersection keys (freeVariablesInTerm `term`)))) in
    let toPair := λname.(name, withDefault Term{literal = Literal{`string` = "Impossible!"}} (maps.lookup name bindingMap)) in
    lists.map (lists.map toPair) (topologicalSortComponents (lists.map depsOf bindings))

## Topological sort of bindings based on their dependencies. Returns `Right` with a flat order when the dependency graph is acyclic; returns `Left` with the cyclic SCCs when it is not. Use this variant when the consumer needs a strict acyclic ordering and must reject cycles (e.g. import resolution); use `topologicalSortBindingMap` when mutual recursion should be packaged into SCC groups instead.
term topologicalSortBindings =
  λels.
    let adjlist := λe.(Binding[name] e, sets.toList (termDependencyNames false true true (Binding[`term`] e)))
    in topologicalSort (lists.map adjlist els)

## Topologically sort type definitions by their structural dependencies, grouped into SCCs. The SCC grouping handles mutually recursive types (e.g. a pair of records that reference each other's names) by delivering them together as one cluster, so the emitter can produce a coherent set of declarations rather than failing with an undefined-name error mid-emission.
term topologicalSortTypeDefinitions =
  λdefs.
    let toPair := λdef.(TypeDefinition[name] def, sets.toList (typeDependencyNames false (TypeScheme[body] (TypeDefinition[body] def)))) in
    let nameToDef := maps.fromList (lists.map (λd.(TypeDefinition[name] d, d)) defs) in
    let sorted := topologicalSortComponents (lists.map toPair defs) in
    lists.map (λnames.givens (lists.map (λn.maps.lookup n nameToDef) names)) sorted

## Collect all type names referenced by a type. The boolean controls whether type-scheme references (free variables in type expressions) are included alongside structural references
term typeDependencyNames =
  λwithSchema,typ.ifElse withSchema (sets.union (freeVariablesInType typ) (typeNamesInType typ)) (freeVariablesInType typ)

## Collect every type name that appears anywhere inside a type expression
term typeNamesInType =
  λtyp0.let addNames := λnames,typ.names in foldOverType TraversalOrder{pre} addNames sets.empty typ0