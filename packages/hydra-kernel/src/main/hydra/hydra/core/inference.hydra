## Type inference for Hydra: Hindley-Milner with elaboration to System F. Extends textbook Algorithm W with nominal types, explicit type abstraction and application, and class constraints. See the Inference wiki page for the full picture.
module hydra.core.inference

import hydra.core.checking as checking
import hydra.core.classes as classes
import hydra.core.errors as errors
import hydra.core.extract.model as extract.model
import hydra.core.graph as graph
import hydra.core.lexical as lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals as literals
import hydra.core.lib.logic as logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math as math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering as ordering
import hydra.core.lib.pairs as pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model as model
import hydra.core.names as names
import hydra.core.packaging as packaging
import hydra.core.paths as paths
import hydra.core.print.model as print.model
import hydra.core.print.typing as print.typing
import hydra.core.reflect as reflect
import hydra.core.resolution as resolution
import hydra.core.rewriting as rewriting
import hydra.core.scoping as scoping
import hydra.core.sorting as sorting
import hydra.core.substitution as substitution
import hydra.core.typing as typing
import hydra.core.unification as unification
import hydra.core.variables as variables

## Return the element at the given index, or Left(Other) with the given description if out of range
term atOrFail = λi,desc,xs.optionals.match (lists.at i xs) left(errors.Error{other = errors.OtherError{strings.concat2 "atOrFail: " desc}}) (λx.right(x))

## Unify type constraints and check the substitution
term bindConstraints = λflowCx,cx,constraints.eithers.bind (eithers.bimap (λ`_e`.errors.Error{inference = errors.InferenceError{unification = errors.UnificationInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] flowCx)}, cause = `_e`}}}) (λ`_a`.`_a`) (unification.unifyTypeConstraints flowCx (graph.Graph[schemaTypes] cx) constraints)) (λs.eithers.bind (checking.checkTypeSubst flowCx cx s) (λ`_`.right(s)))

## Handle unbound type variables under a typed let binding. Variables appearing free in the binding's declared type (but not in schema types or the scheme's own quantified variables) are added to the scheme and the term is wrapped in matching TypeLambdas. Variables appearing only in the term body (at type-application or lambda-domain positions) are phantom — they have no external effect on the binding's type — and are substituted with hydra.core.model.Unit in the body rather than generalized. This keeps downstream stages from seeing vacuous foralls that target languages with non-polymorphic value bindings (e.g. Scala val) cannot express.
term bindUnboundTypeVariables = λcx,term0.let svars := sets.fromList (maps.keys (graph.Graph[schemaTypes] cx)) in let rewrite := λrecurse,`term`.cases(model.Term){`let`=λl.let forBinding := λb.let bname := model.Binding[name] b in let bterm := model.Binding[`term`] b in optionals.match (model.Binding[typeScheme] b) model.Binding{name = bname, `term` = bindUnboundTypeVariables cx bterm, typeScheme = none} (λts.let bvars := sets.fromList (model.TypeScheme[variables] ts) in let excluded := sets.union svars bvars in let inType := sets.difference (variables.freeVariablesInType (model.TypeScheme[body] ts)) excluded in let phantoms := sets.difference (variables.freeTypeVariablesInTerm bterm) (sets.union excluded inType) in let phantomSubst := typing.TypeSubst{maps.fromList (lists.map (λv.(v, model.Type{`unit`})) (sets.toList phantoms))} in let bterm1 := substitution.substTypesInTerm phantomSubst bterm in let unbound := sets.toList inType in let ts2 := model.TypeScheme{variables = lists.concat2 (model.TypeScheme[variables] ts) unbound, body = model.TypeScheme[body] ts, constraints = model.TypeScheme[constraints] ts} in let bterm2 := lists.foldl (λt,v.model.Term{typeLambda = model.TypeLambda{parameter = v, body = t}}) bterm1 unbound in model.Binding{name = bname, `term` = bterm2, typeScheme = given(ts2)}) in model.Term{`let` = model.Let{bindings = lists.map forBinding (model.Let[bindings] l), body = bindUnboundTypeVariables cx (model.Let[body] l)}}, `_`=recurse `term`} `term` in rewriting.rewriteTerm rewrite term0

## Fold a list of type variables over a term to build a type application term
term buildTypeApplicationTerm = λtvars,body.lists.foldl (λt,v.model.Term{typeApplication = model.TypeApplicationTerm{body = t, `type` = model.Type{variable = v}}}) body tvars

## Check that every constrained type variable's final resolved type is an instance of each class it was constrained to.
term dischargeClassConstraints = λfcx,subst,constraints.let substMap := typing.TypeSubst[] subst in let checkOne := λpair.let varName := pairs.first pair in let varConstraints := pairs.second pair in optionals.match (maps.lookup varName substMap) right(unit) (λresolvedType.let checkClass := λclassConstraint.let className := cases(model.TypeClassConstraint){simple=λn.n} classConstraint in logic.ifElse (classes.classIsSatisfiedByType className resolvedType) right(unit) left(errors.Error{inference = errors.InferenceError{other = errors.OtherInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] fcx)}, message = strings.concat ["Type ", print.model.type resolvedType, " does not satisfy constraint ", model.Name[] className]}}}) in eithers.bind (eithers.mapSet checkClass (model.TypeVariableConstraints[classes] varConstraints)) (λ`_`.right(unit))) in eithers.bind (eithers.mapList checkOne (maps.toList constraints)) (λ`_`.right(unit))

## Add (term variable, type scheme) pairs to the graph's bound types
term extendContext = λpairs,cx.graph.Graph{boundTerms = graph.Graph[boundTerms] cx, boundTypes = maps.union (maps.fromList pairs) (graph.Graph[boundTypes] cx), classConstraints = graph.Graph[classConstraints] cx, lambdaVariables = graph.Graph[lambdaVariables] cx, metadata = graph.Graph[metadata] cx, primitives = graph.Graph[primitives] cx, schemaTypes = graph.Graph[schemaTypes] cx, typeVariables = graph.Graph[typeVariables] cx}

## Finalize an inferred term by checking for unbound type variables, then normalizing type variables
term finalizeInferredTerm = λflowCx,cx,`term`.let term2 := bindUnboundTypeVariables cx `term` in eithers.bind (checking.checkForUnboundTypeVariables flowCx cx term2) (λ`_`.right(variables.normalizeTypeVariablesInTerm term2))

## Infer a term's type and map over the result
term forInferredTerm = λfcx,cx,`term`,desc,f.eithers.bind (inferTypeOfTerm fcx cx `term` desc) (λrp.right((f rp, typing.InferenceResult[context] rp)))

## Get all free variables in a graph's bound types
term freeVariablesInContext = λcx.lists.foldl sets.union sets.empty (lists.map variables.freeVariablesInTypeSchemeSimple (maps.elems (graph.Graph[boundTypes] cx)))

## Generate a fresh type variable
term freshVariableType = λcx.let result := names.freshName cx in let name := pairs.first result in let cx2 := pairs.second result in (model.Type{variable = name}, cx2)

## Generalize a type to a type scheme. Paper: inference.tex, gen() and rule Gen.
term generalize = λcx,typ.let isTypeVarName := λname.let parts := strings.splitOn "." (model.Name[] name) in ordering.lte (lists.length parts) 1:int32 in let boundFreeVars := freeVariablesInContext cx in let isUnboundFast := λv.logic.and (logic.not (sets.member v boundFreeVars)) (logic.not (maps.member v (graph.Graph[schemaTypes] cx))) in let vars := lists.distinct (lists.filter (λv.logic.and (isUnboundFast v) (isTypeVarName v)) (variables.freeVariablesInTypeOrdered typ)) in let allConstraints := graph.Graph[classConstraints] cx in let relevantConstraints := maps.fromList (optionals.givens (lists.map (λv.optionals.map (λmeta.(v, meta)) (maps.lookup v allConstraints)) vars)) in model.TypeScheme{variables = vars, body = typ, constraints = relevantConstraints}

## Return the first element of a list, or Left(Other) with the given description if the list is empty
term headOrFail = λdesc,xs.optionals.match (lists.head xs) left(errors.Error{other = errors.OtherError{strings.concat2 "headOrFail: " desc}}) (λx.right(x))

## Infer types for all elements in a graph, using the provided ordered bindings. Returns both the inferred graph and the ordered inferred bindings. Paper: inference.tex, the SCC treatment of cycles (section introduction); the whole graph is one mutually recursive let.
term inferGraphTypes = λfcx0,bindings0,g0.let fcx := fcx0 in let let0 := model.Let{bindings = bindings0, body = model.Term{`unit`}} in let fromLetTerm := λl.let bindings := model.Let[bindings] l in let prims := graph.Graph[primitives] g0 in let schemaTypes := graph.Graph[schemaTypes] g0 in let rawG := lexical.buildGraph bindings maps.empty prims in let g := graph.Graph{boundTerms = graph.Graph[boundTerms] rawG, boundTypes = graph.Graph[boundTypes] rawG, classConstraints = graph.Graph[classConstraints] rawG, lambdaVariables = graph.Graph[lambdaVariables] rawG, metadata = graph.Graph[metadata] rawG, primitives = graph.Graph[primitives] rawG, schemaTypes = schemaTypes, typeVariables = graph.Graph[typeVariables] rawG} in (g, bindings) in eithers.bind (inferTypeOfTerm fcx g0 model.Term{`let` = let0} "graph term") (λresult.let fcx2 := typing.InferenceResult[context] result in let `term` := typing.InferenceResult[`term`] result in eithers.bind (dischargeClassConstraints fcx2 (typing.InferenceResult[subst] result) (typing.InferenceResult[classConstraints] result)) (λ`_`.eithers.bind (finalizeInferredTerm fcx2 g0 `term`) (λfinalized.cases(model.Term){`let`=λl.right((fromLetTerm l, fcx2)), variable=λ`_`.left(errors.Error{inference = errors.InferenceError{other = errors.OtherInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] fcx2)}, message = "Expected inferred graph as let term"}}})} finalized)))

## Infer the type of a term in a given inference context, running the same soundness tail (class-constraint discharge and finalization) as the other top-level entry points
term inferInGraphContext = λfcx,cx,`term`.eithers.bind (inferTypeOfTerm fcx cx `term` "single term") (λresult.let fcx2 := typing.InferenceResult[context] result in eithers.bind (dischargeClassConstraints fcx2 (typing.InferenceResult[subst] result) (typing.InferenceResult[classConstraints] result)) (λ`_`.eithers.bind (finalizeInferredTerm fcx2 cx (typing.InferenceResult[`term`] result)) (λfinalized.right(typing.InferenceResult{`term` = finalized, `type` = typing.InferenceResult[`type`] result, subst = typing.InferenceResult[subst] result, classConstraints = typing.InferenceResult[classConstraints] result, context = fcx2}))))

## Infer types for multiple terms, propagating class constraints from sub-expressions
term inferMany = λfcx,cx,pairs.let emptyResult := right((([], ([], (substitution.idTypeSubst, maps.empty))), fcx)) in optionals.match (lists.uncons pairs) emptyResult (λpairsUc.let headPair := pairs.first pairsUc in let tl := pairs.second pairsUc in let e := pairs.first headPair in let desc := pairs.second headPair in eithers.bind (inferTypeOfTerm fcx cx e desc) (λresult1.let fcx2 := typing.InferenceResult[context] result1 in let e1 := typing.InferenceResult[`term`] result1 in let t1 := typing.InferenceResult[`type`] result1 in let s1 := typing.InferenceResult[subst] result1 in let c1 := typing.InferenceResult[classConstraints] result1 in eithers.bind (inferMany fcx2 (substitution.substInContext s1 cx) tl) (λrp2.let result2 := pairs.first rp2 in let fcx3 := pairs.second rp2 in let e2 := pairs.first result2 in let t2 := pairs.first (pairs.second result2) in let s2 := pairs.first (pairs.second (pairs.second result2)) in let c2 := pairs.second (pairs.second (pairs.second result2)) in let c1Subst := substitution.substInClassConstraints s2 c1 in let mergedConstraints := mergeClassConstraints c1Subst c2 in right(((lists.cons (substitution.substTypesInTerm s2 e1) e2, (lists.cons (substitution.substInType s2 t1) t2, (substitution.composeTypeSubst s1 s2, mergedConstraints))), fcx3)))))

## Map a possibly untyped term to a fully typed term and its type
term inferTypeOf = λfcx,cx,`term`.let letTerm := model.Term{`let` = model.Let{bindings = [model.Binding{name = model.Name{"ignoredVariableName"}, `term` = `term`, typeScheme = none}], body = model.Term{literal = model.Literal{`string` = "ignoredBody"}}}} in eithers.bind (inferTypeOfTerm fcx cx letTerm "infer type of term") (λresult.let fcx2 := typing.InferenceResult[context] result in eithers.bind (dischargeClassConstraints fcx2 (typing.InferenceResult[subst] result) (typing.InferenceResult[classConstraints] result)) (λ`_`.eithers.bind (finalizeInferredTerm fcx2 cx (typing.InferenceResult[`term`] result)) (λfinalized.eithers.bind (extract.model.let cx finalized) (λletResult.let bindings := model.Let[bindings] letResult in logic.ifElse (equality.equal 1:int32 (lists.length bindings)) (eithers.bind (headOrFail "inferTypeOf: single binding expected" bindings) (λbinding.let term1 := model.Binding[`term`] binding in let mts := model.Binding[typeScheme] binding in optionals.match mts left(errors.Error{inference = errors.InferenceError{other = errors.OtherInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] fcx2)}, message = "Expected a type scheme"}}}) (λts.right(((term1, ts), fcx2))))) left(errors.Error{inference = errors.InferenceError{other = errors.OtherInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] fcx2)}, message = strings.concat ["Expected a single binding with a type scheme, but got: ", literals.printInt32 (lists.length bindings), " bindings"]}}})))))

## Infer the type of an annotated term (Either version). Paper: inference.tex, rule Ann.
term inferTypeOfAnnotatedTerm = λfcx,cx,at.let `term` := model.AnnotatedTerm[body] at in let ann := model.AnnotatedTerm[annotation] at in let fcxBody := names.pushSubtermStep paths.SubtermStep{annotatedBody} fcx in eithers.bind (inferTypeOfTerm fcxBody cx `term` "annotated term") (λresult.let fcx2 := names.restoreTrace fcx (typing.InferenceResult[context] result) in let iterm := typing.InferenceResult[`term`] result in let itype := typing.InferenceResult[`type`] result in let isubst := typing.InferenceResult[subst] result in let iconstraints := typing.InferenceResult[classConstraints] result in right(typing.InferenceResult{`term` = model.Term{annotated = model.AnnotatedTerm{body = iterm, annotation = ann}}, `type` = itype, subst = isubst, classConstraints = iconstraints, context = fcx2}))

## Infer the type of a function application (Either version). Paper: inference.tex, rule App (elaboration form).
term inferTypeOfApplication = λfcx0,cx,app.let e0 := model.Application[function] app in let e1 := model.Application[argument] app in let fcxFun := names.pushSubtermStep paths.SubtermStep{applicationFunction} fcx0 in eithers.bind (inferTypeOfTerm fcxFun cx e0 "lhs") (λlhsResult.let fcx2 := names.restoreTrace fcx0 (typing.InferenceResult[context] lhsResult) in let a := typing.InferenceResult[`term`] lhsResult in let t0 := typing.InferenceResult[`type`] lhsResult in let s0 := typing.InferenceResult[subst] lhsResult in let c0 := typing.InferenceResult[classConstraints] lhsResult in let fcxArg := names.pushSubtermStep paths.SubtermStep{applicationArgument} fcx2 in eithers.bind (inferTypeOfTerm fcxArg (substitution.substInContext s0 cx) e1 "rhs") (λrhsResult.let fcx3 := names.restoreTrace fcx0 (typing.InferenceResult[context] rhsResult) in let b := typing.InferenceResult[`term`] rhsResult in let t1 := typing.InferenceResult[`type`] rhsResult in let s1 := typing.InferenceResult[subst] rhsResult in let c1 := typing.InferenceResult[classConstraints] rhsResult in let vResult := names.freshName fcx3 in let v := pairs.first vResult in let fcx4 := pairs.second vResult in eithers.bind (eithers.bimap (λ`_e`.errors.Error{inference = errors.InferenceError{unification = errors.UnificationInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] fcx4)}, cause = `_e`}}}) (λ`_a`.`_a`) (unification.unifyTypes fcx4 (graph.Graph[schemaTypes] cx) (substitution.substInType s1 t0) model.Type{function = model.FunctionType{domain = t1, codomain = model.Type{variable = v}}} "application lhs")) (λs2.eithers.bind (checking.checkTypeSubst fcx4 cx s2) (λ`_`.let rExpr := model.Term{application = model.Application{function = substitution.substTypesInTerm (substitution.composeTypeSubst s1 s2) a, argument = substitution.substTypesInTerm s2 b}} in let rType := substitution.substInType s2 model.Type{variable = v} in let rSubst := substitution.composeTypeSubstList [s0, s1, s2] in let c0Subst := substitution.substInClassConstraints s2 (substitution.substInClassConstraints s1 c0) in let c1Subst := substitution.substInClassConstraints s2 c1 in let rConstraints := mergeClassConstraints c0Subst c1Subst in right(typing.InferenceResult{`term` = rExpr, `type` = rType, subst = rSubst, classConstraints = rConstraints, context = fcx4})))))

## Infer the type of a case statement (Either version). Paper: inference.tex, rules Case and Case_d.
term inferTypeOfCaseStatement = λfcx,cx,caseStmt.let tname := model.CaseStatement[typeName] caseStmt in let dflt := model.CaseStatement[default] caseStmt in let match := model.CaseStatement[`cases`] caseStmt in let fnames := lists.map model.CaseAlternative[name] match in eithers.bind (resolution.requireSchemaType fcx (graph.Graph[schemaTypes] cx) tname) (λstRp.let schemaType := pairs.first stRp in let fcx2 := pairs.second stRp in let svars := model.TypeScheme[variables] schemaType in let stype := model.TypeScheme[body] schemaType in eithers.bind (extract.model.unionType tname stype) (λsfields.let fcxDflt := names.pushSubtermStep paths.SubtermStep{casesDefault} fcx2 in eithers.bind (eithers.mapOptional (λt.inferTypeOfTerm fcxDflt cx t (strings.concat ["case ", model.Name[] tname, ".<default>"])) dflt) (λdfltRp.let dfltResult := dfltRp in let fcx3 := optionals.withDefault fcx2 (optionals.map (λ`_r`.names.restoreTrace fcx2 (typing.InferenceResult[context] `_r`)) dfltRp) in eithers.bind (inferMany fcx3 cx (lists.map (λf.(model.CaseAlternative[handler] f, strings.concat ["case ", model.Name[] tname, ".", model.Name[] (model.CaseAlternative[name] f)])) match)) (λcaseRp.let caseResults := pairs.first caseRp in let fcx4 := pairs.second caseRp in let iterms := pairs.first caseResults in let itypes := pairs.first (pairs.second caseResults) in let isubst := pairs.first (pairs.second (pairs.second caseResults)) in let caseElemConstraints := pairs.second (pairs.second (pairs.second caseResults)) in let codvResult := names.freshName fcx4 in let codv := pairs.first codvResult in let fcx5 := pairs.second codvResult in let cod := model.Type{variable = codv} in let caseMap := maps.fromList (lists.map (λft.(model.FieldType[name] ft, model.FieldType[`type`] ft)) sfields) in let dfltConstraints := optionals.toList (optionals.map (λr.typing.TypeConstraint{`left` = cod, `right` = substitution.substInType isubst (typing.InferenceResult[`type`] r), comment = "match default"}) dfltResult) in let caseConstraints := optionals.givens (lists.zipWith (λfname,itype.optionals.map (λftype.typing.TypeConstraint{`left` = itype, `right` = model.Type{function = model.FunctionType{domain = ftype, codomain = cod}}, comment = "case type"}) (maps.lookup fname caseMap)) fnames itypes) in let dfltClassConstraints := optionals.withDefault maps.empty (optionals.map typing.InferenceResult[classConstraints] dfltResult) in let allElemConstraints := mergeClassConstraints caseElemConstraints dfltClassConstraints in eithers.bind (mapConstraints fcx5 cx (λsubst.yieldWithConstraints fcx5 (buildTypeApplicationTerm svars model.Term{`cases` = model.CaseStatement{typeName = tname, default = optionals.map typing.InferenceResult[`term`] dfltResult, `cases` = lists.zipWith (λn,t.model.CaseAlternative{name = n, handler = t}) fnames iterms}}) model.Type{function = model.FunctionType{domain = resolution.nominalApplication tname (lists.map (λx.model.Type{variable = x}) svars), codomain = cod}} (substitution.composeTypeSubstList (lists.concat [optionals.toList (optionals.map typing.InferenceResult[subst] dfltResult), [isubst, subst]])) (substitution.substInClassConstraints subst allElemConstraints)) (lists.concat [dfltConstraints, caseConstraints])) (λmcResult.right(mcResult))))))

## Infer the type of a collection. The classNames parameter specifies type classes (e.g. ordering) that the element type variable must satisfy. Paper: inference.tex, shared implementation of the collection introduction rules (Lst_0/Lst_+, Set_0/Set_+).
term inferTypeOfCollection = λfcx,cx,typCons,trmCons,desc,classNames,els.let varResult := names.freshName fcx in let var := pairs.first varResult in let fcx2 := pairs.second varResult in let classConstraints := logic.ifElse (sets.isEmpty classNames) maps.empty (maps.singleton var model.TypeVariableConstraints{classes = sets.map (λn.model.TypeClassConstraint{simple = n}) classNames}) in logic.ifElse (lists.isEmpty els) right(yieldWithConstraints fcx2 (buildTypeApplicationTerm [var] (trmCons [])) (typCons model.Type{variable = var}) substitution.idTypeSubst classConstraints) (eithers.bind (inferMany fcx2 cx (lists.zip els (lists.map (λi.strings.concat ["#", literals.printInt32 i]) (math.range 1:int32 (math.add (lists.length els) 1:int32))))) (λresultsRp.let results := pairs.first resultsRp in let fcx3 := pairs.second resultsRp in let terms := pairs.first results in let types := pairs.first (pairs.second results) in let subst1 := pairs.first (pairs.second (pairs.second results)) in let elemConstraints := pairs.second (pairs.second (pairs.second results)) in let constraints := lists.map (λt.typing.TypeConstraint{`left` = model.Type{variable = var}, `right` = t, comment = desc}) types in let allConstraints := mergeClassConstraints classConstraints elemConstraints in eithers.bind (mapConstraints fcx3 cx (λsubst2.let iterm := trmCons terms in let itype := typCons model.Type{variable = var} in let isubst := substitution.composeTypeSubst subst1 subst2 in yieldWithConstraints fcx3 iterm itype isubst (substitution.substInClassConstraints subst2 allConstraints)) constraints) (λmcResult.right(mcResult))))

## Infer the type of an either value (Either version). Paper: inference.tex, rules Eith_L and Eith_R.
term inferTypeOfEither = λfcx,cx,e.eithers.either (λl.eithers.bind (inferTypeOfTerm fcx cx l "either left value") (λr1.let fcx2 := typing.InferenceResult[context] r1 in let iterm := typing.InferenceResult[`term`] r1 in let leftType := typing.InferenceResult[`type`] r1 in let subst := typing.InferenceResult[subst] r1 in let fvResult := freshVariableType fcx2 in let rightType := pairs.first fvResult in let fcx3 := pairs.second fvResult in let eitherTerm := model.Term{`either` = left(iterm)} in let termWithLeftType := model.Term{typeApplication = model.TypeApplicationTerm{body = eitherTerm, `type` = leftType}} in let termWithBothTypes := model.Term{typeApplication = model.TypeApplicationTerm{body = termWithLeftType, `type` = rightType}} in let eitherType := model.Type{`either` = model.EitherType{`left` = leftType, `right` = rightType}} in right(yieldChecked fcx3 termWithBothTypes eitherType subst))) (λr.eithers.bind (inferTypeOfTerm fcx cx r "either right value") (λr1.let fcx2 := typing.InferenceResult[context] r1 in let iterm := typing.InferenceResult[`term`] r1 in let rightType := typing.InferenceResult[`type`] r1 in let subst := typing.InferenceResult[subst] r1 in let fvResult := freshVariableType fcx2 in let leftType := pairs.first fvResult in let fcx3 := pairs.second fvResult in let eitherTerm := model.Term{`either` = right(iterm)} in let termWithLeftType := model.Term{typeApplication = model.TypeApplicationTerm{body = eitherTerm, `type` = leftType}} in let termWithBothTypes := model.Term{typeApplication = model.TypeApplicationTerm{body = termWithLeftType, `type` = rightType}} in let eitherType := model.Type{`either` = model.EitherType{`left` = leftType, `right` = rightType}} in right(yieldChecked fcx3 termWithBothTypes eitherType subst))) e

## Infer the type of a union injection (Either version). Paper: inference.tex, rule Inj.
term inferTypeOfInjection = λfcx,cx,injection.let tname := model.Injection[typeName] injection in let field := model.Injection[field] injection in let fname := model.Field[name] field in let `term` := model.Field[`term`] field in let fcxInj := names.pushSubtermStep paths.SubtermStep{injectField = fname} fcx in eithers.bind (inferTypeOfTerm fcxInj cx `term` "injected term") (λresult.let fcx2 := names.restoreTrace fcx (typing.InferenceResult[context] result) in eithers.bind (resolution.requireSchemaType fcx2 (graph.Graph[schemaTypes] cx) tname) (λstRp.let schemaType := pairs.first stRp in let fcx3 := pairs.second stRp in let svars := model.TypeScheme[variables] schemaType in let stype := model.TypeScheme[body] schemaType in let iterm := typing.InferenceResult[`term`] result in let ityp := typing.InferenceResult[`type`] result in let isubst := typing.InferenceResult[subst] result in let iconstraints := typing.InferenceResult[classConstraints] result in eithers.bind (extract.model.unionType tname stype) (λsfields.eithers.bind (resolution.findFieldType fcx3 fname sfields) (λftyp.eithers.bind (mapConstraints fcx3 cx (λsubst.logic.ifElse (maps.isEmpty iconstraints) (yield fcx3 (buildTypeApplicationTerm svars model.Term{`inject` = model.Injection{typeName = tname, field = model.Field{name = fname, `term` = iterm}}}) (resolution.nominalApplication tname (lists.map (λx.model.Type{variable = x}) svars)) (substitution.composeTypeSubst isubst subst)) (yieldWithConstraints fcx3 (buildTypeApplicationTerm svars model.Term{`inject` = model.Injection{typeName = tname, field = model.Field{name = fname, `term` = iterm}}}) (resolution.nominalApplication tname (lists.map (λx.model.Type{variable = x}) svars)) (substitution.composeTypeSubst isubst subst) (substitution.substInClassConstraints subst iconstraints))) [typing.TypeConstraint{`left` = ftyp, `right` = ityp, comment = "schema type of injected field"}]) (λmcResult.right(mcResult))))))

## Infer the type of a lambda function (Either version). Paper: inference.tex, rule Abs (elaboration form).
term inferTypeOfLambda = λfcx,cx,lambda.let var := model.Lambda[parameter] lambda in let body := model.Lambda[body] lambda in let vdomResult := names.freshName fcx in let vdom := pairs.first vdomResult in let fcx2 := pairs.second vdomResult in let dom := model.Type{variable = vdom} in let cx2 := extendContext [(var, model.TypeScheme{variables = [], body = dom, constraints = maps.empty})] cx in let fcxBody := names.pushSubtermStep paths.SubtermStep{lambdaBody} fcx2 in eithers.bind (inferTypeOfTerm fcxBody cx2 body "lambda body") (λresult.let fcx3 := names.restoreTrace fcx2 (typing.InferenceResult[context] result) in let iterm := typing.InferenceResult[`term`] result in let icod := typing.InferenceResult[`type`] result in let isubst := typing.InferenceResult[subst] result in let rdom := substitution.substInType isubst dom in let rterm := model.Term{lambda = model.Lambda{parameter = var, domain = given(rdom), body = iterm}} in let rtype := model.Type{function = model.FunctionType{domain = rdom, codomain = icod}} in let vars := sets.unions [variables.freeVariablesInType rdom, variables.freeVariablesInType icod, freeVariablesInContext (substitution.substInContext isubst cx2)] in let cx3 := substitution.substInContext isubst cx in let iconstraints := substitution.substInClassConstraints isubst (typing.InferenceResult[classConstraints] result) in right(typing.InferenceResult{`term` = rterm, `type` = rtype, subst = isubst, classConstraints = iconstraints, context = fcx3}))

## Normalize a let term before inferring its type (Either version). The bindings are partitioned into strongly connected components and reorganized as nested lets, one let per SCC, in dependency order. This is the standard Hindley-Milner treatment of mutual recursion: each SCC is generalized once at its boundary (sound, because nothing inside the cluster sees a polymorphic instance of its siblings), and acyclic bindings generalize individually as usual. Paper: inference.tex, the SCC treatment of cycles (section introduction) and the remark following the elaboration-form Let rule.
term inferTypeOfLet = λfcx0,cx,let0.let fcx := fcx0 in let bindings0 := model.Let[bindings] let0 in let body0 := model.Let[body] let0 in let names := lists.map model.Binding[name] bindings0 in let nameSet := sets.fromList names in let toPair := λbinding.let name := model.Binding[name] binding in let `term` := model.Binding[`term`] binding in (name, lists.filter (λn.sets.member n nameSet) (sets.toList (variables.freeVariablesInTerm `term`))) in let adjList := lists.map toPair bindings0 in let groups := sorting.topologicalSortComponents adjList in let bindingMap := maps.fromList (lists.zip names bindings0) in let createLet := λe,group.model.Term{`let` = model.Let{bindings = optionals.givens (lists.map (λn.maps.lookup n bindingMap) group), body = e}} in let rewrittenLet := lists.foldl createLet body0 (lists.reverse groups) in let restoreLet := λiterm.let helper := λlevel,bins,`term`.let nonzero := λ`term`.cases(model.Term){`let`=λl.let bs := model.Let[bindings] l in let letBody := model.Let[body] l in helper (math.sub level 1:int32) (lists.concat [bs, bins]) letBody} `term` in logic.ifElse (equality.equal level 0:int32) (bins, `term`) (nonzero `term`) in let result := helper (lists.length groups) [] iterm in let bindingList := pairs.first result in let e := pairs.second result in let bindingMap2 := maps.fromList (lists.map (λb.(model.Binding[name] b, b)) bindingList) in model.Term{`let` = model.Let{bindings = optionals.givens (lists.map (λn.maps.lookup n bindingMap2) names), body = e}} in let rewriteResult := λiresult.let fcxR := typing.InferenceResult[context] iresult in let iterm := typing.InferenceResult[`term`] iresult in let itype := typing.InferenceResult[`type`] iresult in let isubst := typing.InferenceResult[subst] iresult in let iconstraints := typing.InferenceResult[classConstraints] iresult in typing.InferenceResult{`term` = restoreLet iterm, `type` = itype, subst = isubst, classConstraints = iconstraints, context = fcxR} in let res := cases(model.Term){`let`=λl.inferTypeOfLetNormalized fcx cx l, `_`=inferTypeOfTerm fcx cx rewrittenLet "empty let term"} rewrittenLet in eithers.map rewriteResult res

## Infer the type of a let (letrec) term which is already in a normal form (Either version). Paper: inference.tex, rule Let (elaboration form).
term inferTypeOfLetNormalized = λfcx0,cx0,letTerm.let fcx := fcx0 in let bins0 := model.Let[bindings] letTerm in let body0 := model.Let[body] letTerm in let bnames := lists.map model.Binding[name] bins0 in let bvarsResult := names.freshNames (lists.length bins0) fcx in let bvars := pairs.first bvarsResult in let fcx2 := pairs.second bvarsResult in let tbins0 := lists.map (λx.model.Type{variable = x}) bvars in let cx1 := extendContext (lists.zip bnames (lists.map (λt.model.TypeScheme{variables = [], body = t, constraints = maps.empty}) tbins0)) cx0 in eithers.bind (inferTypesOfTemporaryBindings fcx2 cx1 bins0) (λirRp.let inferredResult := pairs.first irRp in let fcx3 := pairs.second irRp in let bterms1 := pairs.first inferredResult in let tbins1 := pairs.first (pairs.second inferredResult) in let substAndConstraints := pairs.second (pairs.second inferredResult) in let s1 := pairs.first substAndConstraints in let inferredConstraints := pairs.second substAndConstraints in eithers.bind (eithers.bimap (λ`_e`.errors.Error{inference = errors.InferenceError{unification = errors.UnificationInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] fcx3)}, cause = `_e`}}}) (λ`_a`.`_a`) (unification.unifyTypeLists fcx3 (graph.Graph[schemaTypes] cx0) (lists.map (substitution.substInType s1) tbins0) tbins1 "temporary type bindings")) (λs2.eithers.bind (checking.checkTypeSubst fcx3 cx0 s2) (λ`_`.let g2base := substitution.substInContext (substitution.composeTypeSubst s1 s2) cx0 in let constraintsWithS2 := substitution.substInClassConstraints s2 inferredConstraints in let composedSubst := substitution.composeTypeSubst s1 s2 in let originalBindingConstraints := lists.foldl (λacc,b.optionals.match (model.Binding[typeScheme] b) acc (λts.mergeClassConstraints acc (model.TypeScheme[constraints] ts))) maps.empty bins0 in let originalConstraintsSubst := substitution.substInClassConstraints composedSubst originalBindingConstraints in let allInferredConstraints := mergeClassConstraints constraintsWithS2 originalConstraintsSubst in let mergedConstraints := mergeClassConstraints (graph.Graph[classConstraints] g2base) allInferredConstraints in let g2 := graph.Graph{boundTerms = graph.Graph[boundTerms] g2base, boundTypes = graph.Graph[boundTypes] g2base, classConstraints = mergedConstraints, lambdaVariables = graph.Graph[lambdaVariables] g2base, metadata = graph.Graph[metadata] g2base, primitives = graph.Graph[primitives] g2base, schemaTypes = graph.Graph[schemaTypes] g2base, typeVariables = graph.Graph[typeVariables] g2base} in let bterms1Subst := lists.map (substitution.substTypesInTerm s2) bterms1 in let tsbins1 := lists.zip bnames (lists.map (λt.generalize g2 (substitution.substInType s2 t)) tbins1) in let fcx3Body := names.pushSubtermStep paths.SubtermStep{letBody} fcx3 in eithers.bind (inferTypeOfTerm fcx3Body (extendContext tsbins1 g2) body0 "let body") (λbodyResult.let fcx4 := names.restoreTrace fcx3 (typing.InferenceResult[context] bodyResult) in let body1 := typing.InferenceResult[`term`] bodyResult in let tbody := typing.InferenceResult[`type`] bodyResult in let sbody := typing.InferenceResult[subst] bodyResult in let st1 := typing.TermSubst{maps.fromList (lists.map (λpair.let name := pairs.first pair in let ts := pairs.second pair in (name, buildTypeApplicationTerm (model.TypeScheme[variables] ts) model.Term{variable = name})) tsbins1)} in let createBinding := λbindingPair.let nameTsPair := pairs.first bindingPair in let `term` := pairs.second bindingPair in let name := pairs.first nameTsPair in let ts := pairs.second nameTsPair in let finalTs := substitution.substInTypeScheme sbody ts in let typeLambdaTerm := lists.foldl (λb,v.model.Term{typeLambda = model.TypeLambda{parameter = v, body = b}}) (substitution.substituteInTerm st1 `term`) (lists.reverse (model.TypeScheme[variables] finalTs)) in model.Binding{name = name, `term` = substitution.substTypesInTerm (substitution.composeTypeSubst sbody s2) typeLambdaTerm, typeScheme = given(finalTs)} in let bins1 := lists.map createBinding (lists.zip tsbins1 bterms1Subst) in let bodyConstraints := substitution.substInClassConstraints sbody (typing.InferenceResult[classConstraints] bodyResult) in let bindingConstraintsSubst := substitution.substInClassConstraints sbody constraintsWithS2 in let allConstraints := mergeClassConstraints bindingConstraintsSubst bodyConstraints in right(typing.InferenceResult{`term` = model.Term{`let` = model.Let{bindings = bins1, body = body1}}, `type` = tbody, subst = substitution.composeTypeSubstList [s1, s2, sbody], classConstraints = allConstraints, context = fcx4})))))

## Infer the type of a list (Either version). Paper: inference.tex, rules Lst_0 and Lst_+.
term inferTypeOfList = λfcx,cx.inferTypeOfCollection fcx cx (λx.model.Type{`list` = x}) (λx.model.Term{`list` = x}) "list element" sets.empty

## Infer the type of a literal. Paper: inference.tex, rule Lit.
term inferTypeOfLiteral = λfcx,lit.typing.InferenceResult{`term` = model.Term{literal = lit}, `type` = model.Type{literal = reflect.literalType lit}, subst = substitution.idTypeSubst, classConstraints = maps.empty, context = fcx}

## Infer the type of a map (Either version). Paper: inference.tex, rules Map_0 and Map_+.
term inferTypeOfMap = λfcx,cx,m.let kvarResult := names.freshName fcx in let kvar := pairs.first kvarResult in let fcx2 := pairs.second kvarResult in let vvarResult := names.freshName fcx2 in let vvar := pairs.first vvarResult in let fcx3 := pairs.second vvarResult in let keyConstraints := maps.singleton kvar model.TypeVariableConstraints{classes = sets.singleton model.TypeClassConstraint{simple = model.Name{"ordering"}}} in logic.ifElse (maps.isEmpty m) right(yieldWithConstraints fcx3 (buildTypeApplicationTerm [kvar, vvar] model.Term{`map` = maps.empty}) model.Type{`map` = model.MapType{keys = model.Type{variable = kvar}, values = model.Type{variable = vvar}}} substitution.idTypeSubst keyConstraints) (eithers.bind (inferMany fcx3 cx (lists.map (λk.(k, "map key")) (maps.keys m))) (λkRp.let kResults := pairs.first kRp in let fcx4 := pairs.second kRp in let kterms := pairs.first kResults in let ktypes := pairs.first (pairs.second kResults) in let ksubst := pairs.first (pairs.second (pairs.second kResults)) in let kElemConstraints := pairs.second (pairs.second (pairs.second kResults)) in eithers.bind (inferMany fcx4 (substitution.substInContext ksubst cx) (lists.map (λv.(v, "map value")) (maps.elems m))) (λvRp.let vResults := pairs.first vRp in let fcx5 := pairs.second vRp in let vterms := pairs.first vResults in let vtypes := pairs.first (pairs.second vResults) in let vsubst := pairs.first (pairs.second (pairs.second vResults)) in let vElemConstraints := pairs.second (pairs.second (pairs.second vResults)) in let kcons := lists.map (λt.typing.TypeConstraint{`left` = model.Type{variable = kvar}, `right` = t, comment = "map key"}) ktypes in let vcons := lists.map (λt.typing.TypeConstraint{`left` = model.Type{variable = vvar}, `right` = t, comment = "map value"}) vtypes in let allMapConstraints := mergeClassConstraints keyConstraints (mergeClassConstraints kElemConstraints vElemConstraints) in eithers.bind (mapConstraints fcx5 cx (λsubst.yieldWithConstraints fcx5 model.Term{`map` = maps.fromList (lists.zip kterms vterms)} model.Type{`map` = model.MapType{keys = model.Type{variable = kvar}, values = model.Type{variable = vvar}}} (substitution.composeTypeSubstList [ksubst, vsubst, subst]) (substitution.substInClassConstraints subst allMapConstraints)) (lists.concat [kcons, vcons])) (λmcResult.right(mcResult)))))

## Infer the type of a Maybe value. Paper: inference.tex, rules Opt_0 and Opt_1.
term inferTypeOfOptional = λfcx,cx,m.let trmCons := λterms.model.Term{`optional` = lists.head terms} in inferTypeOfCollection fcx cx (λx.model.Type{`optional` = x}) trmCons "optional element" sets.empty (optionals.match m [] lists.singleton)

## Infer the type of a pair (Either version). Paper: inference.tex, rule Pair.
term inferTypeOfPair = λfcx,cx,p.eithers.bind (inferMany fcx cx [(pairs.first p, "pair first element"), (pairs.second p, "pair second element")]) (λrp.let results := pairs.first rp in let fcx2 := pairs.second rp in let iterms := pairs.first results in let itypes := pairs.first (pairs.second results) in let isubst := pairs.first (pairs.second (pairs.second results)) in let pairElemConstraints := pairs.second (pairs.second (pairs.second results)) in eithers.bind (atOrFail 0:int32 "inferTypeOfPair ifst" iterms) (λifst.eithers.bind (atOrFail 1:int32 "inferTypeOfPair isnd" iterms) (λisnd.eithers.bind (atOrFail 0:int32 "inferTypeOfPair tyFst" itypes) (λtyFst.eithers.bind (atOrFail 1:int32 "inferTypeOfPair tySnd" itypes) (λtySnd.let pairTerm := model.Term{pair = (ifst, isnd)} in let termWithTypes := model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = pairTerm, `type` = tyFst}}, `type` = tySnd}} in right(yieldWithConstraints fcx2 termWithTypes model.Type{pair = model.PairType{first = tyFst, second = tySnd}} isubst pairElemConstraints))))))

## Infer the type of a record projection (Either version). Paper: inference.tex, rule Proj.
term inferTypeOfProjection = λfcx,cx,proj.let tname := model.Projection[typeName] proj in let fname := model.Projection[fieldName] proj in eithers.bind (resolution.requireSchemaType fcx (graph.Graph[schemaTypes] cx) tname) (λstRp.let schemaType := pairs.first stRp in let fcx2 := pairs.second stRp in let svars := model.TypeScheme[variables] schemaType in let stype := model.TypeScheme[body] schemaType in eithers.bind (extract.model.recordType tname stype) (λsfields.eithers.bind (resolution.findFieldType fcx2 fname sfields) (λftyp.right(yield fcx2 (buildTypeApplicationTerm svars model.Term{`project` = model.Projection{typeName = tname, fieldName = fname}}) model.Type{function = model.FunctionType{domain = resolution.nominalApplication tname (lists.map (λx.model.Type{variable = x}) svars), codomain = ftyp}} substitution.idTypeSubst))))

## Infer the type of a record (Either version). Paper: inference.tex, rule Rec.
term inferTypeOfRecord = λfcx,cx,`record`.let tname := model.Record[typeName] `record` in let fields := model.Record[fields] `record` in let fnames := lists.map model.Field[name] fields in eithers.bind (resolution.requireSchemaType fcx (graph.Graph[schemaTypes] cx) tname) (λstRp.let schemaType := pairs.first stRp in let fcx2 := pairs.second stRp in eithers.bind (inferMany fcx2 cx (lists.map (λf.(model.Field[`term`] f, strings.concat2 "field " (model.Name[] (model.Field[name] f)))) fields)) (λrp.let results := pairs.first rp in let fcx3 := pairs.second rp in let svars := model.TypeScheme[variables] schemaType in let stype := model.TypeScheme[body] schemaType in let iterms := pairs.first results in let itypes := pairs.first (pairs.second results) in let isubst := pairs.first (pairs.second (pairs.second results)) in let recElemConstraints := pairs.second (pairs.second (pairs.second results)) in let ityp := model.Type{`record` = lists.zipWith (λn,t.model.FieldType{name = n, `type` = t}) fnames itypes} in eithers.bind (mapConstraints fcx3 cx (λsubst.yieldWithConstraints fcx3 (buildTypeApplicationTerm svars model.Term{`record` = model.Record{typeName = tname, fields = lists.zipWith (λn,t.model.Field{name = n, `term` = t}) fnames iterms}}) (resolution.nominalApplication tname (lists.map (λx.model.Type{variable = x}) svars)) (substitution.composeTypeSubst isubst subst) (substitution.substInClassConstraints subst recElemConstraints)) [typing.TypeConstraint{`left` = stype, `right` = ityp, comment = "schema type of record"}]) (λmcResult.right(mcResult))))

## Infer the type of a set (Either version). Paper: inference.tex, rules Set_0 and Set_+.
term inferTypeOfSet = λfcx,cx,s.inferTypeOfCollection fcx cx (λx.model.Type{`set` = x}) (λterms.model.Term{`set` = sets.fromList terms}) "set element" (sets.singleton model.Name{"ordering"}) (sets.toList s)

## Infer the type of a given term (Either version)
term inferTypeOfTerm = λfcx,cx,`term`,desc.let fcx2 := fcx in cases(model.Term){annotated=λa.inferTypeOfAnnotatedTerm fcx2 cx a, application=λa.inferTypeOfApplication fcx2 cx a, `cases`=λc.inferTypeOfCaseStatement fcx2 cx c, `either`=λe.inferTypeOfEither fcx2 cx e, lambda=λl.inferTypeOfLambda fcx2 cx l, `let`=λl.inferTypeOfLet fcx2 cx l, `list`=λels.inferTypeOfList fcx2 cx els, literal=λl.right(inferTypeOfLiteral fcx2 l), `map`=λm.inferTypeOfMap fcx2 cx m, `optional`=λm.inferTypeOfOptional fcx2 cx m, pair=λp.inferTypeOfPair fcx2 cx p, `project`=λp.inferTypeOfProjection fcx2 cx p, `record`=λr.inferTypeOfRecord fcx2 cx r, `set`=λs.inferTypeOfSet fcx2 cx s, typeApplication=λtt.inferTypeOfTypeApplication fcx2 cx tt, typeLambda=λta.inferTypeOfTypeLambda fcx2 cx ta, `inject`=λi.inferTypeOfInjection fcx2 cx i, `unit`=λ`_`.right(inferTypeOfUnit fcx2), `unwrap`=λtname.inferTypeOfUnwrap fcx2 cx tname, variable=λname.inferTypeOfVariable fcx2 cx name, `wrap`=λw.inferTypeOfWrappedTerm fcx2 cx w} `term`

## Infer the type of a type application (Either version). Paper: inference.tex, type application terms in the elaborated Term grammar.
term inferTypeOfTypeApplication = λfcx,cx,tt.let fcxBody := names.pushSubtermStep paths.SubtermStep{typeApplicationBody} fcx in eithers.bind (inferTypeOfTerm fcxBody cx (model.TypeApplicationTerm[body] tt) "type application term") (λresult.let fcx2 := names.restoreTrace fcx (typing.InferenceResult[context] result) in right(typing.InferenceResult{`term` = typing.InferenceResult[`term`] result, `type` = typing.InferenceResult[`type`] result, subst = typing.InferenceResult[subst] result, classConstraints = typing.InferenceResult[classConstraints] result, context = fcx2}))

## Infer the type of a type abstraction (Either version). Paper: inference.tex, type abstraction terms in the elaborated Term grammar.
term inferTypeOfTypeLambda = λfcx,cx,ta.let fcxBody := names.pushSubtermStep paths.SubtermStep{typeLambdaBody} fcx in eithers.bind (inferTypeOfTerm fcxBody cx (model.TypeLambda[body] ta) "type abstraction") (λresult.let fcx2 := names.restoreTrace fcx (typing.InferenceResult[context] result) in right(typing.InferenceResult{`term` = typing.InferenceResult[`term`] result, `type` = typing.InferenceResult[`type`] result, subst = typing.InferenceResult[subst] result, classConstraints = typing.InferenceResult[classConstraints] result, context = fcx2}))

## The trivial inference rule for the unit term. Paper: inference.tex, rule Unit.
term inferTypeOfUnit = λfcx.typing.InferenceResult{`term` = model.Term{`unit`}, `type` = model.Type{`unit`}, subst = substitution.idTypeSubst, classConstraints = maps.empty, context = fcx}

## Infer the type of an unwrap operation (Either version). Paper: inference.tex, rule Unwr.
term inferTypeOfUnwrap = λfcx,cx,tname.eithers.bind (resolution.requireSchemaType fcx (graph.Graph[schemaTypes] cx) tname) (λstRp.let schemaType := pairs.first stRp in let fcx2 := pairs.second stRp in let svars := model.TypeScheme[variables] schemaType in let stype := model.TypeScheme[body] schemaType in eithers.bind (extract.model.wrappedType tname stype) (λwtyp.right(yield fcx2 (buildTypeApplicationTerm svars model.Term{`unwrap` = tname}) model.Type{function = model.FunctionType{domain = resolution.nominalApplication tname (lists.map (λx.model.Type{variable = x}) svars), codomain = wtyp}} substitution.idTypeSubst)))

## Infer the type of a variable (Either version). Paper: inference.tex, rule Var (elaboration form), with rule Prim as the primitive-namespace fallback.
term inferTypeOfVariable = λfcx,cx,name.optionals.match (maps.lookup name (graph.Graph[boundTypes] cx)) (optionals.match (optionals.map (λ`_p`.scoping.termSignatureToTypeScheme (packaging.PrimitiveDefinition[signature] (graph.Primitive[definition] `_p`))) (maps.lookup name (graph.Graph[primitives] cx))) left(errors.Error{resolution = errors.ResolutionError{noSuchBinding = errors.NoSuchBindingError{name = name}}}) (λscheme.let tsResult := resolution.instantiateTypeScheme fcx scheme in let ts := pairs.first tsResult in let fcx2 := pairs.second tsResult in let constraints := model.TypeScheme[constraints] ts in right(yieldCheckedWithConstraints fcx2 (buildTypeApplicationTerm (model.TypeScheme[variables] ts) model.Term{variable = name}) (model.TypeScheme[body] ts) substitution.idTypeSubst constraints))) (λscheme.let tsResult := resolution.instantiateTypeScheme fcx scheme in let ts := pairs.first tsResult in let fcx2 := pairs.second tsResult in let constraints := model.TypeScheme[constraints] ts in right(typing.InferenceResult{`term` = buildTypeApplicationTerm (model.TypeScheme[variables] ts) model.Term{variable = name}, `type` = model.TypeScheme[body] ts, subst = substitution.idTypeSubst, classConstraints = constraints, context = fcx2}))

## Infer the type of a wrapped term (Either version). Paper: inference.tex, rule Wrp.
term inferTypeOfWrappedTerm = λfcx,cx,wt.let tname := model.WrappedTerm[typeName] wt in let `term` := model.WrappedTerm[body] wt in eithers.bind (resolution.requireSchemaType fcx (graph.Graph[schemaTypes] cx) tname) (λstRp.let schemaType := pairs.first stRp in let fcx2 := pairs.second stRp in let fcxBody := names.pushSubtermStep paths.SubtermStep{wrapBody} fcx2 in eithers.bind (inferTypeOfTerm fcxBody cx `term` "wrapped term") (λresult.let fcx3 := names.restoreTrace fcx2 (typing.InferenceResult[context] result) in let svars := model.TypeScheme[variables] schemaType in let stype := model.TypeScheme[body] schemaType in let iterm := typing.InferenceResult[`term`] result in let itype := typing.InferenceResult[`type`] result in let isubst := typing.InferenceResult[subst] result in let ityp := model.Type{`wrap` = itype} in eithers.bind (mapConstraints fcx3 cx (λsubst.yield fcx3 (buildTypeApplicationTerm svars model.Term{`wrap` = model.WrappedTerm{typeName = tname, body = iterm}}) (resolution.nominalApplication tname (lists.map (λx.model.Type{variable = x}) svars)) (substitution.composeTypeSubst isubst subst)) [typing.TypeConstraint{`left` = stype, `right` = ityp, comment = "schema type of wrapper"}]) (λmcResult.right(mcResult))))

## Infer types for temporary let bindings (Either version)
term inferTypesOfTemporaryBindings = λfcx,cx,bins.let emptyResult := right((([], ([], (substitution.idTypeSubst, maps.empty))), fcx)) in optionals.match (lists.uncons bins) emptyResult (λbinsUc.let binding := pairs.first binsUc in let tl := pairs.second binsUc in let k := model.Binding[name] binding in let v := model.Binding[`term`] binding in let fcxBind := names.pushSubtermStep paths.SubtermStep{letBinding = k} fcx in eithers.bind (inferTypeOfTerm fcxBind cx v (strings.concat ["temporary let binding '", model.Name[] k, "'"])) (λresult1.let fcx2 := names.restoreTrace fcx (typing.InferenceResult[context] result1) in let j := typing.InferenceResult[`term`] result1 in let `u_prime` := typing.InferenceResult[`type`] result1 in let u := typing.InferenceResult[subst] result1 in let c1Inferred := typing.InferenceResult[classConstraints] result1 in eithers.bind (optionals.match (model.Binding[typeScheme] binding) right(maps.empty) (λts.let tsResult := resolution.instantiateTypeScheme fcx2 ts in let instantiatedTs := pairs.first tsResult in let freshConstraints := model.TypeScheme[constraints] instantiatedTs in eithers.bind (eithers.bimap (λ`_e`.errors.Error{inference = errors.InferenceError{unification = errors.UnificationInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] fcx2)}, cause = `_e`}}}) (λ`_a`.`_a`) (unification.unifyTypes fcx2 (graph.Graph[schemaTypes] cx) (model.TypeScheme[body] instantiatedTs) `u_prime` "original binding type")) (λunifySubst.right(substitution.substInClassConstraints unifySubst freshConstraints)))) (λoriginalBindingConstraints.let c1 := mergeClassConstraints c1Inferred originalBindingConstraints in eithers.bind (inferTypesOfTemporaryBindings fcx2 (substitution.substInContext u cx) tl) (λrp2.let result2 := pairs.first rp2 in let fcx3 := pairs.second rp2 in let h := pairs.first result2 in let `r_prime` := pairs.first (pairs.second result2) in let restPair := pairs.second (pairs.second result2) in let r := pairs.first restPair in let c2 := pairs.second restPair in let c1Subst := substitution.substInClassConstraints r c1 in let mergedConstraints := mergeClassConstraints c1Subst c2 in right(((lists.cons (substitution.substTypesInTerm r j) h, (lists.cons (substitution.substInType r `u_prime`) `r_prime`, (substitution.composeTypeSubst u r, mergedConstraints))), fcx3))))))

## Check if a variable is unbound in context
term isUnbound = λcx,v.logic.and (logic.not (sets.member v (freeVariablesInContext cx))) (logic.not (maps.member v (graph.Graph[schemaTypes] cx)))

## Map over type constraints after unification
term mapConstraints = λflowCx,cx,f,constraints.eithers.bind (eithers.bimap (λ`_e`.errors.Error{inference = errors.InferenceError{unification = errors.UnificationInferenceError{path = paths.SubtermPath{lists.reverse (typing.InferenceContext[trace] flowCx)}, cause = `_e`}}}) (λ`_a`.`_a`) (unification.unifyTypeConstraints flowCx (graph.Graph[schemaTypes] cx) constraints)) (λs.eithers.bind (checking.checkTypeSubst flowCx cx s) (λ`_`.right(f s)))

## Merge two maps of class constraints. When both maps have constraints for the same variable, union the class sets.
term mergeClassConstraints = λm1,m2.lists.foldl (λacc,pair.let k := pairs.first pair in let v := pairs.second pair in optionals.match (maps.lookup k acc) (maps.insert k v acc) (λexisting.let merged := model.TypeVariableConstraints{classes = sets.union (model.TypeVariableConstraints[classes] existing) (model.TypeVariableConstraints[classes] v)} in maps.insert k merged acc)) m1 (maps.toList m2)

## Show an inference result for debugging
term showInferenceResult = λresult.let `term` := typing.InferenceResult[`term`] result in let typ := typing.InferenceResult[`type`] result in let subst := typing.InferenceResult[subst] result in strings.concat ["{term=", print.model.term `term`, ", type=", print.model.type typ, ", subst=", print.typing.typeSubst subst, "}"]

## Create an inference result with no class constraints
term yield = λfcx,`term`,typ,subst.typing.InferenceResult{`term` = substitution.substTypesInTerm subst `term`, `type` = substitution.substInType subst typ, subst = subst, classConstraints = maps.empty, context = fcx}

## Create a checked inference result
term yieldChecked = λfcx,`term`,typ,subst.let iterm := substitution.substTypesInTerm subst `term` in let itype := substitution.substInType subst typ in typing.InferenceResult{`term` = iterm, `type` = itype, subst = subst, classConstraints = maps.empty, context = fcx}

## Create a checked inference result with class constraints
term yieldCheckedWithConstraints = λfcx,`term`,typ,subst,constraints.let iterm := substitution.substTypesInTerm subst `term` in let itype := substitution.substInType subst typ in let iconstraints := substitution.substInClassConstraints subst constraints in typing.InferenceResult{`term` = iterm, `type` = itype, subst = subst, classConstraints = iconstraints, context = fcx}

## Create an inference result with class constraints
term yieldWithConstraints = λfcx,`term`,typ,subst,constraints.typing.InferenceResult{`term` = substitution.substTypesInTerm subst `term`, `type` = substitution.substInType subst typ, subst = subst, classConstraints = constraints, context = fcx}