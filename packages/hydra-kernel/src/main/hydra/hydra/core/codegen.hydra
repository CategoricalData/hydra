## Pure code generation pipeline for bootstrapping Hydra across languages.
module hydra.core.codegen

import hydra.core.adapt as adapt
import hydra.core.annotations as annotations
import hydra.core.coders as coders
import hydra.core.constants as constants
import hydra.core.decode.model as decode.model
import hydra.core.decode.packaging as decode.packaging
import hydra.core.encode.model as encode.model
import hydra.core.encode.packaging as encode.packaging
import hydra.core.environment as environment
import hydra.core.errors as errors
import hydra.core.formatting as formatting
import hydra.core.graph as graph
import hydra.core.inference as inference
import hydra.core.json.decode as decode
import hydra.core.json.encode as encode
import hydra.core.json.writer as writer
import hydra.core.lexical as lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals as literals
import hydra.core.lib.logic as logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math as math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering as ordering
import hydra.core.lib.pairs as pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.markdown as markdown
import hydra.core.model as model
import hydra.core.names as names
import hydra.core.packaging as packaging
import hydra.core.print.model as print.model
import hydra.core.scoping as scoping
import hydra.core.strip as strip

## Build a schema map (Name -> Type) from a graph's schema types
term buildSchemaMap = λg.maps.map (λts.strip.deannotateType (model.TypeScheme[body] ts)) (graph.Graph[schemaTypes] g)

## Decode a single module from a JSON value
term decodeModuleFromJson = λbsGraph,universeModules,jsonVal.let graph := modulesToGraph bsGraph universeModules universeModules in let schemaMap := buildSchemaMap graph in let modType := model.Type{variable = model.Name{"hydra.core.packaging.Module"}} in eithers.either (λerr.left(errors.Error{other = wrap(errors.OtherError){err}})) (λ`term`.eithers.either (λdecErr.left(errors.Error{decoding = decErr})) (λmod.right(mod)) (decode.packaging.module graph `term`)) (decode.fromJson schemaMap false model.Name{"hydra.core.packaging.Module"} modType jsonVal)

## Escape unescaped control characters inside JSON string literals
term escapeControlCharsInJson = λinput.let hexDigit := λn.logic.ifElse (ordering.lt n 10:int32) (math.add 48:int32 n) (math.add 97:int32 (math.sub n 10:int32)) in let escapeToUnicode := λb.[92:int32, 117:int32, 48:int32, 48:int32, hexDigit (optionals.withDefault 0:int32 (math.div b 16:int32)), hexDigit (optionals.withDefault 0:int32 (math.mod b 16:int32))] in let go := λinStr,esc,bytes.optionals.match (lists.uncons bytes) [] (λuc.let b := pairs.first uc in let bs := pairs.second uc in logic.ifElse esc (lists.cons b (go inStr false bs)) (logic.ifElse (logic.and (equality.equal b 92:int32) inStr) (lists.cons b (go inStr true bs)) (logic.ifElse (equality.equal b 34:int32) (lists.cons b (go (logic.not inStr) false bs)) (logic.ifElse (logic.and inStr (ordering.lt b 32:int32)) (lists.concat2 (escapeToUnicode b) (go inStr false bs)) (lists.cons b (go inStr false bs)))))) in go false false input

## Format a primitive for the lexicon
term formatPrimitive = λprim.let name := model.Name[] (packaging.PrimitiveDefinition[name] (graph.Primitive[definition] prim)) in let typ := scoping.termSignatureToTypeScheme (packaging.PrimitiveDefinition[signature] (graph.Primitive[definition] prim)) in let typeStr := print.model.typeScheme typ in strings.concat2 (strings.concat2 (strings.concat2 "  " name) " : ") typeStr

## Format a term binding for the lexicon
term formatTermBinding = λbinding.let name := model.Name[] (model.Binding[name] binding) in let typeStr := optionals.match (model.Binding[typeScheme] binding) "?" (λscheme.print.model.typeScheme scheme) in strings.concat2 (strings.concat2 (strings.concat2 "  " name) " : ") typeStr

## Format a type binding for the lexicon
term formatTypeBinding = λgraph,binding.eithers.bind (eithers.bimap (λ`_e`.errors.Error{decoding = `_e`}) (λ`_a`.`_a`) (decode.model.type graph (model.Binding[`term`] binding))) (λtyp.right(strings.concat2 (strings.concat2 (strings.concat2 "  " (model.Name[] (model.Binding[name] binding))) " = ") (print.model.type typ)))

## Generate encoder or decoder modules for a list of type modules
term generateCoderModules = λcodec,bsGraph,universeModules,typeModules,cx.let universe := maps.fromList (lists.map (λm.(packaging.Module[name] m, m)) (lists.concat2 universeModules universeModules)) in let closureModules := moduleDepsTransitive universe universeModules in let schemaElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given((λname,typ.let schemaTerm := model.Term{variable = model.Name{"hydra.core.model.Type"}} in let dataTerm := annotations.normalizeTermAnnotations model.Term{annotated = model.AnnotatedTerm{body = encode.model.type typ, annotation = annotations.wrapAnnotationMap (maps.fromList [(constants.keyType, schemaTerm)])}} in model.Binding{name = name, `term` = dataTerm, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Type"}}, constraints = maps.empty})}) (packaging.TypeDefinition[name] td) (model.TypeScheme[body] (packaging.TypeDefinition[body] td))), `_`=none} d) (packaging.Module[definitions] m))) closureModules) in let dataElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m))) closureModules) in let schemaGraph := lexical.elementsToGraph bsGraph maps.empty schemaElements in let schemaTypes := eithers.either (λ`_`.maps.empty) (λ`_r`.`_r`) (environment.schemaGraphToTypingEnvironment schemaGraph) in let allElements := lists.concat2 schemaElements dataElements in let graph := lexical.elementsToGraph bsGraph schemaTypes allElements in eithers.map (λresults.optionals.givens results) (eithers.mapList (λm.codec cx graph m) typeModules)

## Generate the lexicon content from a graph
term generateLexicon = λgraph.let bindings := lexical.graphToBindings graph in let primitives := maps.elems (graph.Graph[primitives] graph) in let partitioned := lists.partition (λb.annotations.isNativeType b) bindings in let typeBindings := pairs.first partitioned in let termBindings := pairs.second partitioned in let sortedPrimitives := lists.sortBy (λp.packaging.PrimitiveDefinition[name] (graph.Primitive[definition] p)) primitives in let sortedTypes := lists.sortBy (λb.model.Binding[name] b) typeBindings in let sortedTerms := lists.sortBy (λb.model.Binding[name] b) termBindings in eithers.bind (eithers.mapList (λb.formatTypeBinding graph b) sortedTypes) (λtypeLines.let termLines := lists.map (λb.formatTermBinding b) sortedTerms in let primitiveLines := lists.map (λp.formatPrimitive p) sortedPrimitives in right(strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "Primitives:\n" (formatting.unlines primitiveLines)) "\nTypes:\n") (formatting.unlines typeLines)) "\nTerms:\n") (formatting.unlines termLines)))

## Generate a hydra.core.markdown Document describing a module's definitions
term generateModuleDoc = λmod.let sections := lists.map (λd.cases(packaging.Definition){`primitive`=λpd.let name := model.Name[] (packaging.PrimitiveDefinition[name] pd) in let mdoc := optionals.bind (packaging.PrimitiveDefinition[metadata] pd) (λem.packaging.EntityMetadata[description] em) in let sig := print.model.typeScheme (scoping.termSignatureToTypeScheme (packaging.PrimitiveDefinition[signature] pd)) in let provisions := optionals.withDefault [] (optionals.map (λem.packaging.EntityMetadata[provisions] em) (packaging.PrimitiveDefinition[metadata] pd)) in let comments := optionals.withDefault [] (optionals.map (λem.packaging.EntityMetadata[comments] em) (packaging.PrimitiveDefinition[metadata] pd)) in let mlifecycle := optionals.bind (packaging.PrimitiveDefinition[metadata] pd) (λem.packaging.EntityMetadata[lifecycle] em) in markdown.Section{heading = markdown.Heading{level = 2:int32, content = [markdown.Inline{text = name}], anchor = none}, content = lists.concat [[markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{text = optionals.withDefault "*(undocumented)*" mdoc}], anchor = none}}, markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{code = sig}], anchor = none}}], lists.map (λlc.markdown.Block{paragraph = let mavail := packaging.LifecycleInfo[availableSince] lc in let mdepr := packaging.LifecycleInfo[deprecatedSince] lc in let availText := optionals.map (λv.strings.concat2 (strings.concat2 "Since: " (packaging.Version[] v)) ".") mavail in let deprText := optionals.map (λv.strings.concat2 (strings.concat2 "Deprecated since: " (packaging.Version[] v)) ".") mdepr in let parts := lists.concat2 (optionals.toList availText) (optionals.toList deprText) in markdown.Paragraph{content = [markdown.Inline{emphasis = [markdown.Inline{text = strings.join " " parts}]}], anchor = none}}) (optionals.toList mlifecycle), lists.map (λc.markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{text = c}], anchor = none}}) comments, lists.map (λp.markdown.Block{paragraph = let pname := packaging.Provision[name] p in let pkind := packaging.Provision[kind] p in let pstatement := packaging.Provision[statement] p in let kindStr := cases(packaging.ProvisionKind){requirement=λ`_`."requirement", recommendation=λ`_`."recommendation"} pkind in let upperDashed := names.nameToUpperDashed pname in markdown.Paragraph{content = [markdown.Inline{strong = [markdown.Inline{text = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "[" upperDashed) "] (") kindStr) ") "}]}, markdown.Inline{text = pstatement}], anchor = given(upperDashed)}}) provisions], anchor = none}, `term`=λtd.let name := model.Name[] (packaging.TermDefinition[name] td) in let mdoc := optionals.bind (packaging.TermDefinition[metadata] td) (λem.packaging.EntityMetadata[description] em) in let sig := optionals.match (optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)) "?" (λts.print.model.typeScheme ts) in let provisions := optionals.withDefault [] (optionals.map (λem.packaging.EntityMetadata[provisions] em) (packaging.TermDefinition[metadata] td)) in let comments := optionals.withDefault [] (optionals.map (λem.packaging.EntityMetadata[comments] em) (packaging.TermDefinition[metadata] td)) in let mlifecycle := optionals.bind (packaging.TermDefinition[metadata] td) (λem.packaging.EntityMetadata[lifecycle] em) in markdown.Section{heading = markdown.Heading{level = 2:int32, content = [markdown.Inline{text = name}], anchor = none}, content = lists.concat [[markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{text = optionals.withDefault "*(undocumented)*" mdoc}], anchor = none}}, markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{code = sig}], anchor = none}}], lists.map (λlc.markdown.Block{paragraph = let mavail := packaging.LifecycleInfo[availableSince] lc in let mdepr := packaging.LifecycleInfo[deprecatedSince] lc in let availText := optionals.map (λv.strings.concat2 (strings.concat2 "Since: " (packaging.Version[] v)) ".") mavail in let deprText := optionals.map (λv.strings.concat2 (strings.concat2 "Deprecated since: " (packaging.Version[] v)) ".") mdepr in let parts := lists.concat2 (optionals.toList availText) (optionals.toList deprText) in markdown.Paragraph{content = [markdown.Inline{emphasis = [markdown.Inline{text = strings.join " " parts}]}], anchor = none}}) (optionals.toList mlifecycle), lists.map (λc.markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{text = c}], anchor = none}}) comments, lists.map (λp.markdown.Block{paragraph = let pname := packaging.Provision[name] p in let pkind := packaging.Provision[kind] p in let pstatement := packaging.Provision[statement] p in let kindStr := cases(packaging.ProvisionKind){requirement=λ`_`."requirement", recommendation=λ`_`."recommendation"} pkind in let upperDashed := names.nameToUpperDashed pname in markdown.Paragraph{content = [markdown.Inline{strong = [markdown.Inline{text = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "[" upperDashed) "] (") kindStr) ") "}]}, markdown.Inline{text = pstatement}], anchor = given(upperDashed)}}) provisions], anchor = none}, `type`=λtyd.let name := model.Name[] (packaging.TypeDefinition[name] tyd) in let mdoc := optionals.bind (packaging.TypeDefinition[metadata] tyd) (λem.packaging.EntityMetadata[description] em) in let sig := print.model.typeScheme (packaging.TypeDefinition[body] tyd) in let provisions := optionals.withDefault [] (optionals.map (λem.packaging.EntityMetadata[provisions] em) (packaging.TypeDefinition[metadata] tyd)) in let comments := optionals.withDefault [] (optionals.map (λem.packaging.EntityMetadata[comments] em) (packaging.TypeDefinition[metadata] tyd)) in let mlifecycle := optionals.bind (packaging.TypeDefinition[metadata] tyd) (λem.packaging.EntityMetadata[lifecycle] em) in markdown.Section{heading = markdown.Heading{level = 2:int32, content = [markdown.Inline{text = name}], anchor = none}, content = lists.concat [[markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{text = optionals.withDefault "*(undocumented)*" mdoc}], anchor = none}}, markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{code = sig}], anchor = none}}], lists.map (λlc.markdown.Block{paragraph = let mavail := packaging.LifecycleInfo[availableSince] lc in let mdepr := packaging.LifecycleInfo[deprecatedSince] lc in let availText := optionals.map (λv.strings.concat2 (strings.concat2 "Since: " (packaging.Version[] v)) ".") mavail in let deprText := optionals.map (λv.strings.concat2 (strings.concat2 "Deprecated since: " (packaging.Version[] v)) ".") mdepr in let parts := lists.concat2 (optionals.toList availText) (optionals.toList deprText) in markdown.Paragraph{content = [markdown.Inline{emphasis = [markdown.Inline{text = strings.join " " parts}]}], anchor = none}}) (optionals.toList mlifecycle), lists.map (λc.markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{text = c}], anchor = none}}) comments, lists.map (λp.markdown.Block{paragraph = let pname := packaging.Provision[name] p in let pkind := packaging.Provision[kind] p in let pstatement := packaging.Provision[statement] p in let kindStr := cases(packaging.ProvisionKind){requirement=λ`_`."requirement", recommendation=λ`_`."recommendation"} pkind in let upperDashed := names.nameToUpperDashed pname in markdown.Paragraph{content = [markdown.Inline{strong = [markdown.Inline{text = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "[" upperDashed) "] (") kindStr) ") "}]}, markdown.Inline{text = pstatement}], anchor = given(upperDashed)}}) provisions], anchor = none}} d) (packaging.Module[definitions] mod) in let introBlocks := let comments := optionals.withDefault [] (optionals.map (λem.packaging.EntityMetadata[comments] em) (packaging.Module[metadata] mod)) in lists.map (λc.markdown.Block{paragraph = markdown.Paragraph{content = [markdown.Inline{text = c}], anchor = none}}) comments in markdown.Document{title = packaging.ModuleName[] (packaging.Module[name] mod), content = lists.cons markdown.Block{raw = "<!-- Note: this is an automatically generated file. Do not edit. -->"} (lists.concat2 introBlocks (lists.map (λs.markdown.Block{section = s}) sections))}

## Pure core of code generation: given a coder, language, infer flag, bootstrap graph, universe, and modules to generate, produce a list of (filePath, content) pairs. Emission flags doExpand/doHoistCaseStatements/doHoistPolymorphicLetBindings are derived from the absence of the matching LanguageFeature in lang.supportedFeatures: a target that lacks partialApplication needs eta expansion (doExpand=true), and so on.
term generateSourceFiles = λprintDefinitions,lang,doInfer,bsGraph,universeModules,modsToGenerate,cx.let namespaceMap := maps.fromList (lists.map (λm.(packaging.Module[name] m, m)) (lists.concat2 universeModules modsToGenerate)) in let constraints := coders.Language[constraints] lang in let features := coders.Language[supportedFeatures] lang in let doExpand := logic.not (sets.member coders.LanguageFeature{partialApplication} features) in let doHoistCaseStatements := logic.not (sets.member coders.LanguageFeature{nestedCaseStatements} features) in let doHoistPolymorphicLetBindings := logic.not (sets.member coders.LanguageFeature{nestedPolymorphicLetBindings} features) in let typeModulesToGenerate := lists.filter (λmod.logic.not (lists.isEmpty (optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given((λname,typ.let schemaTerm := model.Term{variable = model.Name{"hydra.core.model.Type"}} in let dataTerm := annotations.normalizeTermAnnotations model.Term{annotated = model.AnnotatedTerm{body = encode.model.type typ, annotation = annotations.wrapAnnotationMap (maps.fromList [(constants.keyType, schemaTerm)])}} in model.Binding{name = name, `term` = dataTerm, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Type"}}, constraints = maps.empty})}) (packaging.TypeDefinition[name] td) (model.TypeScheme[body] (packaging.TypeDefinition[body] td))), `_`=none} d) (packaging.Module[definitions] mod))))) modsToGenerate in let termModulesToGenerate := lists.filter (λmod.logic.not (lists.isEmpty (optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] mod))))) modsToGenerate in let closureMods := moduleDepsTransitive namespaceMap (lists.concat2 universeModules modsToGenerate) in let schemaElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given((λname,typ.let schemaTerm := model.Term{variable = model.Name{"hydra.core.model.Type"}} in let dataTerm := annotations.normalizeTermAnnotations model.Term{annotated = model.AnnotatedTerm{body = encode.model.type typ, annotation = annotations.wrapAnnotationMap (maps.fromList [(constants.keyType, schemaTerm)])}} in model.Binding{name = name, `term` = dataTerm, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Type"}}, constraints = maps.empty})}) (packaging.TypeDefinition[name] td) (model.TypeScheme[body] (packaging.TypeDefinition[body] td))), `_`=none} d) (packaging.Module[definitions] m))) closureMods) in let dataElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m))) closureMods) in let schemaGraph := lexical.elementsToGraph bsGraph maps.empty schemaElements in let schemaTypes2 := eithers.either (λ`_`.maps.empty) (λ`_r`.`_r`) (environment.schemaGraphToTypingEnvironment schemaGraph) in let dataGraph := lexical.elementsToGraph bsGraph schemaTypes2 dataElements in eithers.bind (logic.ifElse (lists.isEmpty typeModulesToGenerate) right([]) (let nameLists := lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given(packaging.TypeDefinition[name] td), `_`=none} d) (packaging.Module[definitions] m))) typeModulesToGenerate in eithers.bind (adapt.schemaGraphToDefinitions constraints schemaGraph nameLists cx) (λschemaResult.let defLists := pairs.second schemaResult in let schemaGraphWithTypes := graph.Graph{boundTerms = graph.Graph[boundTerms] schemaGraph, boundTypes = graph.Graph[boundTypes] schemaGraph, classConstraints = graph.Graph[classConstraints] schemaGraph, lambdaVariables = graph.Graph[lambdaVariables] schemaGraph, metadata = graph.Graph[metadata] schemaGraph, primitives = graph.Graph[primitives] schemaGraph, schemaTypes = schemaTypes2, typeVariables = graph.Graph[typeVariables] schemaGraph} in eithers.map (λxs.lists.concat xs) (eithers.mapList (λp.let mod := pairs.first p in let defs := pairs.second p in eithers.map (λm.maps.toList m) (printDefinitions mod (lists.map (λd.packaging.Definition{`type` = d}) defs) cx schemaGraphWithTypes)) (lists.zip typeModulesToGenerate defLists))))) (λschemaFiles.eithers.bind (logic.ifElse (lists.isEmpty termModulesToGenerate) right([]) (let namespaces := lists.map (λm.packaging.Module[name] m) termModulesToGenerate in eithers.bind (adapt.dataGraphToDefinitions constraints doInfer doExpand doHoistCaseStatements doHoistPolymorphicLetBindings dataElements dataGraph namespaces cx) (λdataResult.let g1 := pairs.first dataResult in let defLists := pairs.second dataResult in let defName := λd.cases(packaging.Definition){`term`=λtd.packaging.TermDefinition[name] td, `type`=λtd.packaging.TypeDefinition[name] td, `primitive`=λpd.packaging.PrimitiveDefinition[name] pd} d in let refreshModule := λels,m.packaging.Module{name = packaging.Module[name] m, metadata = packaging.Module[metadata] m, dependencies = packaging.Module[dependencies] m, definitions = optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given(packaging.Definition{`type` = td}), `term`=λtd.optionals.map (λb.packaging.Definition{`term` = packaging.TermDefinition{name = model.Binding[name] b, metadata = none, signature = optionals.map scoping.typeSchemeToTermSignature (model.Binding[typeScheme] b), body = model.Binding[`term`] b}}) (lists.find (λb.equality.equal (model.Binding[name] b) (packaging.TermDefinition[name] td)) els), `primitive`=λpd.given(packaging.Definition{`primitive` = pd})} d) (packaging.Module[definitions] m))} in let allBindings := lexical.graphToBindings g1 in let refreshedMods := lists.map (λm.refreshModule allBindings m) termModulesToGenerate in let termDefNames := λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(packaging.TermDefinition[name] td), `_`=none} d) (packaging.Module[definitions] m)) in let g1Primitives := graph.Graph[primitives] g1 in eithers.bind (eithers.mapList (λp.let original := pairs.first p in let refreshed := pairs.second p in let origNames := termDefNames original in let refreshedNames := sets.fromList (termDefNames refreshed) in let missing := lists.filter (λn.logic.and (logic.not (sets.member n refreshedNames)) (logic.not (maps.member n g1Primitives))) origNames in logic.ifElse (lists.isEmpty missing) right(refreshed) left(errors.Error{other = errors.OtherError{strings.concat ["refreshModule could not resolve ", literals.printInt32 (lists.length missing), " term binding(s) in ", packaging.ModuleName[] (packaging.Module[name] original), " against the post-adaptation graph; the loaded universe is missing a dependency these ", "bindings need. Offending name(s): ", strings.join ", " (lists.map model.Name[] missing)]}})) (lists.zip termModulesToGenerate refreshedMods)) (λrefreshedModsChecked.let dedupDefs := λdefs.lists.sortBy (λd.packaging.TermDefinition[name] d) (maps.elems (maps.fromList (lists.map (λd.(packaging.TermDefinition[name] d, d)) defs))) in let dedupedDefLists := lists.map dedupDefs defLists in eithers.map (λxs.lists.concat xs) (eithers.mapList (λp.let mod := pairs.first p in let defs := pairs.second p in eithers.map (λm.maps.toList m) (printDefinitions mod (lists.map (λd.packaging.Definition{`term` = d}) defs) cx g1)) (lists.zip refreshedModsChecked dedupedDefLists)))))) (λtermFiles.let mergeFileEntry := λacc,p.maps.alter (λmv.given(optionals.match mv (pairs.second p) (λexisting.strings.concat2 existing (strings.concat2 "\n" (pairs.second p))))) (pairs.first p) acc in right(maps.toList (lists.foldl mergeFileEntry maps.empty (lists.concat2 schemaFiles termFiles)))))

## Perform type inference and generate the lexicon for a set of modules
term inferAndGenerateLexicon = λcx,bsGraph,kernelModules.let g0 := modulesToGraph bsGraph kernelModules kernelModules in let dataElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m))) kernelModules) in eithers.bind (inference.inferGraphTypes cx dataElements g0) (λinferResultWithCx.let g1 := pairs.first (pairs.first inferResultWithCx) in let schemaElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given((λname,typ.let schemaTerm := model.Term{variable = model.Name{"hydra.core.model.Type"}} in let dataTerm := annotations.normalizeTermAnnotations model.Term{annotated = model.AnnotatedTerm{body = encode.model.type typ, annotation = annotations.wrapAnnotationMap (maps.fromList [(constants.keyType, schemaTerm)])}} in model.Binding{name = name, `term` = dataTerm, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Type"}}, constraints = maps.empty})}) (packaging.TypeDefinition[name] td) (model.TypeScheme[body] (packaging.TypeDefinition[body] td))), `_`=none} d) (packaging.Module[definitions] m))) kernelModules) in let typeBoundTerms := maps.fromList (lists.map (λb.(model.Binding[name] b, model.Binding[`term`] b)) schemaElements) in let typeBoundTypes := maps.fromList (optionals.givens (lists.map (λb.optionals.map (λts.(model.Binding[name] b, ts)) (model.Binding[typeScheme] b)) schemaElements)) in let g2 := graph.Graph{boundTerms = maps.union typeBoundTerms (graph.Graph[boundTerms] g1), boundTypes = graph.Graph[boundTypes] g1, classConstraints = graph.Graph[classConstraints] g1, lambdaVariables = graph.Graph[lambdaVariables] g1, metadata = graph.Graph[metadata] g1, primitives = graph.Graph[primitives] g1, schemaTypes = graph.Graph[schemaTypes] g1, typeVariables = graph.Graph[typeVariables] g1} in let g3 := graph.Graph{boundTerms = graph.Graph[boundTerms] g2, boundTypes = maps.union typeBoundTypes (graph.Graph[boundTypes] g2), classConstraints = graph.Graph[classConstraints] g2, lambdaVariables = graph.Graph[lambdaVariables] g2, metadata = graph.Graph[metadata] g2, primitives = graph.Graph[primitives] g2, schemaTypes = graph.Graph[schemaTypes] g2, typeVariables = graph.Graph[typeVariables] g2} in generateLexicon g3)

## Perform type inference on modules and reconstruct with inferred types
term inferModules = λcx,bsGraph,universeMods,targetMods.let g0 := modulesToGraph bsGraph universeMods targetMods in let dataElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m))) (lists.concat2 universeMods targetMods)) in eithers.bind (inference.inferGraphTypes cx dataElements g0) (λinferResultWithCx.let inferResult := pairs.first inferResultWithCx in let inferredElements := pairs.second inferResult in right(lists.map (refreshModule inferredElements) targetMods))

## Infer types for target modules in the context of a typed universe
term inferModulesGiven = λcx,bsGraph,universeMods,targetMods.let g0 := modulesToGraph bsGraph universeMods targetMods in let nsMap := maps.fromList (lists.map (λm.(packaging.Module[name] m, m)) (lists.concat2 universeMods targetMods)) in let closureMods := moduleDepsTransitive nsMap targetMods in let targetNamespaces := sets.fromList (lists.map packaging.Module[name] targetMods) in let termBindings := lists.concat (lists.map (λm.let isTarget := sets.member (packaging.Module[name] m) targetNamespaces in let bs := optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m)) in logic.ifElse isTarget bs (lists.filter (λb.optionals.isNone (model.Binding[typeScheme] b)) bs)) closureMods) in let primitiveBindings := lists.concat (lists.map (λm.let isTarget := sets.member (packaging.Module[name] m) targetNamespaces in let bs := optionals.givens (lists.map (λd.cases(packaging.Definition){`primitive`=λpd.optionals.map (λimpl.model.Binding{name = packaging.PrimitiveDefinition[name] pd, `term` = impl, typeScheme = given(scoping.termSignatureToTypeScheme (packaging.PrimitiveDefinition[signature] pd))}) (packaging.PrimitiveDefinition[defaultImplementation] pd), `_`=none} d) (packaging.Module[definitions] m)) in logic.ifElse isTarget bs []) closureMods) in let bindingsToInfer := lists.concat2 termBindings primitiveBindings in let untouchedTypedBindings := lists.concat (lists.map (λm.let isTarget := sets.member (packaging.Module[name] m) targetNamespaces in let bs := optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m)) in logic.ifElse isTarget [] (lists.filter (λb.optionals.isGiven (model.Binding[typeScheme] b)) bs)) closureMods) in eithers.bind (inference.inferGraphTypes cx bindingsToInfer g0) (λinferResultWithCx.let inferResult := pairs.first inferResultWithCx in let newlyInferredBindings := pairs.second inferResult in let allInferredBindings := lists.concat2 newlyInferredBindings untouchedTypedBindings in right(lists.map (refreshModule allInferredBindings) targetMods))

## Lower Definition.primitive arms to Definition.term arms with term-encoded PrimitiveDefinition
term lowerPrimitiveDefinitions = λm.let pkgNs := packaging.ModuleName{"hydra.core.packaging"} in let coreNs := packaging.ModuleName{"hydra.core.model"} in let primDefSig := scoping.typeSchemeToTermSignature model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.packaging.PrimitiveDefinition"}}, constraints = maps.empty} in let origDefs := packaging.Module[definitions] m in let hasPrim := lists.foldl (λacc,d.logic.or acc (cases(packaging.Definition){`primitive`=λ`_`.true, `_`=false} d)) false origDefs in logic.ifElse (logic.not hasPrim) m (let newDefs := lists.map (λd.cases(packaging.Definition){`primitive`=λpd.packaging.Definition{`term` = packaging.TermDefinition{name = packaging.PrimitiveDefinition[name] pd, metadata = none, signature = given(primDefSig), body = encode.packaging.primitiveDefinition pd}}, `_`=d} d) origDefs in let currentDeps := packaging.Module[dependencies] m in let filteredDeps := lists.filter (λdep.logic.and (logic.not (equality.equal (packaging.ModuleDependency[`module`] dep) pkgNs)) (logic.not (equality.equal (packaging.ModuleDependency[`module`] dep) coreNs))) currentDeps in let newDeps := lists.concat2 filteredDeps [packaging.ModuleDependency{`module` = pkgNs, package = none}, packaging.ModuleDependency{`module` = coreNs, package = none}] in packaging.Module{name = packaging.Module[name] m, metadata = packaging.Module[metadata] m, dependencies = newDeps, definitions = newDefs})

## Compute transitive closure of dependencies for a set of modules
term moduleDepsTransitive = λnsMap,modules.let closure := sets.union (transitiveDeps (λm.lists.map (λdep.packaging.ModuleDependency[`module`] dep) (packaging.Module[dependencies] m)) nsMap modules) (sets.fromList (lists.map (λm.packaging.Module[name] m) modules)) in optionals.givens (lists.map (λn.maps.lookup n nsMap) (sets.toList closure))

## Convert a module name to a file path (e.g., hydra.core.model -> hydra/core)
term moduleNameToPath = λns.strings.join "/" (strings.splitOn "." (packaging.ModuleName[] ns))

## Convert a Module to a JSON string
term moduleToJson = λschemaMap,m.let `term` := encode.packaging.module m in let modType := model.Type{variable = model.Name{"hydra.core.packaging.Module"}} in eithers.map (λjson.writer.printJson json) (eithers.bimap (λ`_e`.errors.Error{other = wrap(errors.OtherError){`_e`}}) (λ`_a`.`_a`) (encode.toJson schemaMap false model.Name{"hydra.core.packaging.Module"} modType `term`))

## Convert a generated Module into a Source module
term moduleToSourceModule = λm.let sourceNs := packaging.ModuleName{strings.concat2 "hydra.sources." (strings.join "." (lists.drop 1:int32 (strings.splitOn "." (packaging.ModuleName[] (packaging.Module[name] m)))))} in let modTypeNs := packaging.ModuleName{"hydra.core.packaging"} in let moduleDef := packaging.Definition{`term` = packaging.TermDefinition{name = model.Name{strings.concat2 (packaging.ModuleName[] sourceNs) ".module_"}, metadata = none, signature = given(scoping.typeSchemeToTermSignature model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.packaging.Module"}}, constraints = maps.empty}), body = encode.packaging.module m}} in packaging.Module{name = sourceNs, metadata = given(packaging.EntityMetadata{description = given(strings.concat2 "Source module for " (packaging.ModuleName[] (packaging.Module[name] m))), comments = [], seeAlso = [], lifecycle = none, provisions = []}), dependencies = [packaging.ModuleDependency{`module` = modTypeNs, package = none}], definitions = [moduleDef]}

## Build a graph from universe modules and working modules, using an explicit bootstrap graph
term modulesToGraph = λbsGraph,universeModules,modules.let universe := maps.fromList (lists.map (λm.(packaging.Module[name] m, m)) (lists.concat2 universeModules modules)) in let closureModules := moduleDepsTransitive universe (lists.concat2 universeModules modules) in let schemaElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given((λname,typ.let schemaTerm := model.Term{variable = model.Name{"hydra.core.model.Type"}} in let dataTerm := annotations.normalizeTermAnnotations model.Term{annotated = model.AnnotatedTerm{body = encode.model.type typ, annotation = annotations.wrapAnnotationMap (maps.fromList [(constants.keyType, schemaTerm)])}} in model.Binding{name = name, `term` = dataTerm, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Type"}}, constraints = maps.empty})}) (packaging.TypeDefinition[name] td) (model.TypeScheme[body] (packaging.TypeDefinition[body] td))), `_`=none} d) (packaging.Module[definitions] m))) closureModules) in let dataElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m))) closureModules) in let schemaGraph := lexical.elementsToGraph bsGraph maps.empty schemaElements in let schemaTypes := eithers.either (λ`_`.maps.empty) (λ`_r`.`_r`) (environment.schemaGraphToTypingEnvironment schemaGraph) in let baseGraph := lexical.elementsToGraph bsGraph schemaTypes dataElements in let universeDataElements := lists.concat (lists.map (λm.optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m))) universeModules) in let universeBoundTypes := maps.fromList (optionals.givens (lists.map (λb.optionals.map (λts.(model.Binding[name] b, ts)) (model.Binding[typeScheme] b)) universeDataElements)) in graph.Graph{boundTerms = graph.Graph[boundTerms] baseGraph, boundTypes = universeBoundTypes, classConstraints = graph.Graph[classConstraints] baseGraph, lambdaVariables = graph.Graph[lambdaVariables] baseGraph, metadata = graph.Graph[metadata] baseGraph, primitives = graph.Graph[primitives] baseGraph, schemaTypes = graph.Graph[schemaTypes] baseGraph, typeVariables = graph.Graph[typeVariables] baseGraph}

## Rebuild a module's term definitions using freshly inferred bindings
term refreshModule = λinferredElements,m.logic.ifElse (logic.not (logic.not (lists.isEmpty (optionals.givens (lists.map (λd.cases(packaging.Definition){`term`=λtd.given(model.Binding{name = packaging.TermDefinition[name] td, `term` = packaging.TermDefinition[body] td, typeScheme = optionals.map scoping.termSignatureToTypeScheme (packaging.TermDefinition[signature] td)}), `_`=none} d) (packaging.Module[definitions] m)))))) m packaging.Module{name = packaging.Module[name] m, metadata = packaging.Module[metadata] m, dependencies = packaging.Module[dependencies] m, definitions = optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given(packaging.Definition{`type` = td}), `term`=λtd.optionals.map (λb.packaging.Definition{`term` = packaging.TermDefinition{name = model.Binding[name] b, metadata = none, signature = optionals.map scoping.typeSchemeToTermSignature (model.Binding[typeScheme] b), body = model.Binding[`term`] b}}) (lists.find (λb.equality.equal (model.Binding[name] b) (packaging.TermDefinition[name] td)) inferredElements), `primitive`=λpd.given(packaging.Definition{`primitive` = pd})} d) (packaging.Module[definitions] m))}

## Compute transitive closure of module dependencies
term transitiveDeps = λgetDeps,nsMap,startMods.let initialDeps := sets.fromList (lists.concat (lists.map (λm.lists.filter (λdep.logic.not (equality.equal dep (packaging.Module[name] m))) (getDeps m)) startMods)) in let go := λpending,visited.logic.ifElse (sets.isEmpty pending) visited (let newVisited := sets.union visited pending in let nextDeps := sets.fromList (lists.concat (lists.map (λnsv.optionals.match (maps.lookup nsv nsMap) [] (λdepMod.getDeps depMod)) (sets.toList pending))) in let newPending := sets.difference nextDeps newVisited in go newPending newVisited) in go initialDeps sets.empty