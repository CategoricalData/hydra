## Utilities for constructing generic program code ASTs, used for the serialization phase of source code generation.
module hydra.core.serialization

import hydra.core.ast
import hydra.core.formatting
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering
import hydra.core.lib.pairs
import hydra.core.lib.strings as strings
import hydra.core.util

## Angle bracket pair `<` `>` for use with `brackets`
term angleBraces = Brackets{open = Symbol{"<"}, close = Symbol{">"}}

## Comma-separate the elements inside angle brackets in the given block style; renders as `<>` when empty
term angleBracesList =
  λstyle,els.ifElse (lists.isEmpty els) (cst "<>") (brackets angleBraces style (commaSep style els))

## Produce a bracketed list which separates elements by spaces or newlines depending on the estimated width of the expression.
term bracesListAdaptive =
  λels.chooseLayout maxLineWidth (curlyBracesList none inlineStyle els) (curlyBracesList none halfBlockStyle els)

## Comma-separate the elements inside square brackets in the given block style; renders as `[]` when empty
term bracketList =
  λstyle,els.ifElse (lists.isEmpty els) (cst "[]") (brackets squareBrackets style (commaSep style els))

## Produce a bracketed list which separates elements by spaces or newlines depending on the estimated width of the expression.
term bracketListAdaptive =
  λels.chooseLayout maxLineWidth (bracketList inlineStyle els) (bracketList halfBlockStyle els)

## Wrap an expression in the given bracket pair using the given block style
term brackets = λbr,style,e.Expr{brackets = BracketExpr{brackets = br, enclosed = e, style = style}}

## Pick between an inline and a multi-line layout for the same logical expression. Returns the inline form if its estimated width does not exceed the threshold, otherwise the block form. Note: the threshold is measured against the inline expression in isolation; surrounding indentation may push content beyond the threshold at print time. Callers that know they are nested can pass a smaller threshold to compensate.
term chooseLayout =
  λthreshold,inlineExpr,blockExpr.ifElse (gt (expressionLength inlineExpr) threshold) blockExpr inlineExpr

## Separate elements with a comma, using the given block style
term commaSep = symbolSep ","

## Comma-separate elements inline if the joined width fits, otherwise break onto separate lines.
term commaSepAdaptive = λels.chooseLayout maxLineWidth (commaSep inlineStyle els) (commaSep halfBlockStyle els)

## Construct a constant expression from a literal string
term cst = λs.Expr{const = sym s}

## Wrap a single expression in curly braces using the given block style
term curlyBlock = λstyle,e.curlyBracesList none style [e]

## Curly brace pair `{` `}` for use with `brackets`
term curlyBraces = Brackets{open = Symbol{"{"}, close = Symbol{"}"}}

## Separate the elements inside curly braces using the given symbol (default `,`) in the given block style; renders as `{}` when empty
term curlyBracesList =
  λmsymb,style,els.ifElse
      (lists.isEmpty els)
      (cst "{}")
      (brackets curlyBraces style (symbolSep (optionals.withDefault "," msymb) style els))

## Indent every non-empty line of `s` by `idt`. Empty lines stay empty (no trailing whitespace) so downstream byte-identity checks don't care about indent depth.
term customIndent =
  λidt,s.strings.concat
      (lists.intersperse "\n" (lists.map (λline.ifElse (equal line "") line (strings.concat2 idt line)) (lines s)))

## Render a list of expressions as a block whose first element starts where the surrounding context placed it and subsequent elements break onto fresh lines indented by the given prefix
term customIndentBlock =
  λidt,els.
    let idtOp := Op{
      symbol = sym "",
      padding = Padding{`left` = Ws{space}, `right` = Ws{breakAndIndent = idt}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}
    in optionals.match
      (lists.head els)
      (cst "")
      (λhead.ifElse (equal (lists.length els) 1:int32) head (ifx idtOp head (newlineSep (lists.drop 1:int32 els))))

## Separate elements with a dot and no surrounding whitespace
term dotSep =
  sep
    Op{
      symbol = sym ".",
      padding = Padding{`left` = Ws{`none`}, `right` = Ws{`none`}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}

## Separate elements with a blank line between them
term doubleNewlineSep =
  sep
    Op{
      symbol = sym "",
      padding = Padding{`left` = Ws{break}, `right` = Ws{break}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}

## The two-space string used as the canonical indent unit
term doubleSpace = "  "

## Find the approximate length (number of characters, including spaces and newlines) of an expression without actually printing it.
term expressionLength =
  λe.
    let symbolLength := λs.strings.length (Symbol[] s) in
    let wsLength := λws.cases(Ws){
          `none`=λ`_`.0:int32,
          space=λ`_`.1:int32,
          break=λ`_`.10000:int32,
          breakAndIndent=λs.10000:int32,
          doubleBreak=λ`_`.10000:int32}
          ws in
    let blockStyleLength := λstyle.
        let mindentLen := optionals.match (BlockStyle[indent] style) 0:int32 strings.length in
        let nlBeforeLen := ifElse (BlockStyle[newlineBeforeContent] style) 1:int32 0:int32 in
        let nlAfterLen := ifElse (BlockStyle[newlineAfterContent] style) 1:int32 0:int32 in
        add mindentLen (add nlBeforeLen nlAfterLen) in
    let bracketsLength := λbrackets.add
          (symbolLength (Brackets[open] brackets))
          (symbolLength (Brackets[close] brackets)) in
    let bracketExprLength := λbe.add
          (bracketsLength (BracketExpr[brackets] be))
          (add
            (expressionLength (BracketExpr[enclosed] be))
            (blockStyleLength (BracketExpr[style] be))) in
    let indentedExpressionLength := λie.
        let baseLen := expressionLength (IndentedExpression[expr] ie) in
        let indentLen := cases(IndentStyle){
            allLines=λs.strings.length s,
            subsequentLines=λs.strings.length s}
            (IndentedExpression[style] ie) in
        add baseLen indentLen in
    let opLength := λop.
        let symLen := symbolLength (Op[symbol] op) in
        let padding := Op[padding] op in
        let leftLen := wsLength (Padding[`left`] padding) in
        let rightLen := wsLength (Padding[`right`] padding) in
        add symLen (add leftLen rightLen) in
    let opExprLength := λoe.
        let opLen := opLength (OpExpr[op] oe) in
        let leftLen := expressionLength (OpExpr[lhs] oe) in
        let rightLen := expressionLength (OpExpr[rhs] oe) in
        add opLen (add leftLen rightLen) in
    let seqExprLength := λse.
        let sopLen := opLength (SeqExpr[op] se) in
        let elementLens := lists.map expressionLength (SeqExpr[elements] se) in
        let totalElLen := lists.foldl add 0:int32 elementLens in
        let numSeps := sub (lists.length (SeqExpr[elements] se)) 1:int32 in
        add totalElLen (mul sopLen (ifElse (gt numSeps 0:int32) numSeps 0:int32)) in
    cases(Expr){
      const=λs.symbolLength s,
      indent=λie.indentedExpressionLength ie,
      op=λoe.opExprLength oe,
      brackets=λbe.bracketExprLength be,
      seq=λse.seqExprLength se}
      e

## Block style with double-space indent and newlines both before and after the bracketed content
term fullBlockStyle =
  BlockStyle{indent = given(doubleSpace), newlineBeforeContent = true, newlineAfterContent = true}

## Block style with double-space indent, a newline before the content but not after
term halfBlockStyle =
  BlockStyle{indent = given(doubleSpace), newlineBeforeContent = true, newlineAfterContent = false}

## Build an infix expression with the given operator and two operands
term ifx = λop,lhs,rhs.Expr{op = OpExpr{op = op, lhs = lhs, rhs = rhs}}

## Indent every non-empty line of a string by `doubleSpace`
term indent = customIndent doubleSpace

## Like `customIndentBlock`, but using `doubleSpace` as the indent prefix
term indentBlock = customIndentBlock doubleSpace

## Indent every line of an expression except the first by the given prefix
term indentSubsequentLines =
  λidt,e.Expr{indent = IndentedExpression{style = IndentStyle{subsequentLines = idt}, expr = e}}

## Space-separate three elements: left operand, operator string, right operand
term infixWs = λop,l,r.spaceSep [l, cst op, r]

## Space-separate operands interleaved with the given operator string
term infixWsList =
  λop,opers.
    let opExpr := cst op in
    let foldFun := λe,r.ifElse (lists.isEmpty e) [r] (lists.cons r (lists.cons opExpr e)) in
    spaceSep (lists.foldl foldFun [] (lists.reverse opers))

## Block style with no indent and no surrounding newlines: contents stay on a single line
term inlineStyle = BlockStyle{indent = none, newlineBeforeContent = false, newlineAfterContent = false}

## The canonical maximum line width used by Hydra writers. Adaptive helpers compare estimated expression widths against this threshold to decide whether to render inline or break across lines. Set to 120 to match the project-wide line-length convention.
term maxLineWidth = 120:int32

## Separate elements by a newline (no leading whitespace)
term newlineSep =
  sep
    Op{
      symbol = sym "",
      padding = Padding{`left` = Ws{`none`}, `right` = Ws{break}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}

## Operator padding with no whitespace on either side
term noPadding = Padding{`left` = Ws{`none`}, `right` = Ws{`none`}}

## Concatenate elements with no separator and no whitespace
term noSep =
  sep
    Op{
      symbol = sym "",
      padding = Padding{`left` = Ws{`none`}, `right` = Ws{`none`}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}

## Construct a constant expression from an int32
term num = λi.cst (printInt32 i)

## Build an op with single-space padding from a symbol, precedence, and associativity
term op =
  λs,p,assoc.Op{
      symbol = sym s,
      padding = Padding{`left` = Ws{space}, `right` = Ws{space}},
      precedence = wrap(Precedence){p},
      associativity = assoc}

## Build the `|` alternative-separator operator. The flag selects whether the right side breaks onto a new line.
term orOp =
  λnewlines.Op{
      symbol = sym "|",
      padding = Padding{`left` = Ws{space}, `right` = ifElse newlines Ws{break} Ws{space}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}

## Separate alternatives with `|`, breaking onto separate lines when the block style requests a newline before content
term orSep =
  λstyle,l.
    let newlines := BlockStyle[newlineBeforeContent] style
    in optionals.match
      (lists.head l)
      (cst "")
      (λh.lists.foldl (λacc,el.ifx (orOp newlines) acc el) h (lists.drop 1:int32 l))

## Comma-separate the elements inside parentheses; switches to a half-block style when newlines are requested and there is more than one element. Renders as `()` when empty.
term parenList =
  λnewlines,els.
    let style := ifElse (and newlines (gt (lists.length els) 1:int32)) halfBlockStyle inlineStyle
    in ifElse (lists.isEmpty els) (cst "()") (brackets parentheses style (commaSep style els))

## Produce a parenthesized list which separates elements by spaces or newlines depending on the estimated width of the expression.
term parenListAdaptive = λels.chooseLayout maxLineWidth (parenList false els) (parenList true els)

## Wrap an expression in inline parentheses
term parens = brackets parentheses inlineStyle

## Round parenthesis pair `(` `)` for use with `brackets`
term parentheses = Brackets{open = Symbol{"("}, close = Symbol{")"}}

## Recursively insert parentheses around subexpressions where required by operator precedence and associativity. The traversal descends into bracket, indent, sequence, and operator expressions and parenthesizes left or right operands whose binding is weaker than the surrounding operator.
term parenthesize =
  λexp.
    let assocLeft := λa.cases(Associativity){`right`=λ`_`.false, `_`=true} a in
    let assocRight := λa.cases(Associativity){`left`=λ`_`.false, `_`=true} a in
    cases(Expr){
      brackets=λbracketExpr.Expr{
            brackets = BracketExpr{
              brackets = BracketExpr[brackets] bracketExpr,
              enclosed = parenthesize
                  (BracketExpr[enclosed] bracketExpr),
              style = BracketExpr[style] bracketExpr}},
      const=λignored.exp,
      indent=λindentExpr.Expr{
            indent = IndentedExpression{
              style = IndentedExpression[style] indentExpr,
              expr = parenthesize
                  (IndentedExpression[expr] indentExpr)}},
      seq=λseqExpr.Expr{
            seq = SeqExpr{
              op = SeqExpr[op] seqExpr,
              elements = lists.map parenthesize (SeqExpr[elements] seqExpr)}},
      op=λopExpr.
          let op := OpExpr[op] opExpr in
          let prec := Precedence[] (Op[precedence] op) in
          let assoc := Op[associativity] op in
          let lhs := OpExpr[lhs] opExpr in
          let rhs := OpExpr[rhs] opExpr in
          let `lhs'` := parenthesize lhs in
          let `rhs'` := parenthesize rhs in
          let lhs2 := cases(Expr){
              op=λlopExpr.
                  let lop := OpExpr[op] lopExpr in
                  let lprec := Precedence[] (Op[precedence] lop) in
                  let lassoc := Op[associativity] lop in
                  let comparison := compare prec lprec in
                  cases(Comparison){
                    lessThan=λ`_`.`lhs'`,
                    greaterThan=λ`_`.parens `lhs'`,
                    equalTo=λ`_`.ifElse
                          (and (assocLeft assoc) (assocLeft lassoc))
                          `lhs'`
                          (parens `lhs'`)}
                    comparison,
              `_`=`lhs'`}
              `lhs'` in
          let rhs2 := cases(Expr){
              op=λropExpr.
                  let rop := OpExpr[op] ropExpr in
                  let rprec := Precedence[] (Op[precedence] rop) in
                  let rassoc := Op[associativity] rop in
                  let comparison := compare prec rprec in
                  cases(Comparison){
                    lessThan=λ`_`.`rhs'`,
                    greaterThan=λ`_`.parens `rhs'`,
                    equalTo=λ`_`.ifElse
                          (and
                            (assocRight assoc)
                            (assocRight rassoc))
                          `rhs'`
                          (parens `rhs'`)}
                    comparison,
              `_`=`rhs'`}
              `rhs'` in
          Expr{op = OpExpr{op = op, lhs = lhs2, rhs = rhs2}}}
      exp

## Prepend a prefix string to an expression with no surrounding whitespace
term prefix =
  λp,expr.
    let preOp := Op{
      symbol = sym p,
      padding = Padding{`left` = Ws{`none`}, `right` = Ws{`none`}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}
    in ifx preOp (cst "") expr

## Render an expression to a string, expanding bracket pairs, block styles, indents, and operator chains
term printExpr =
  λe.
    let pad := λws.cases(Ws){
          `none`=λ`_`."",
          space=λ`_`." ",
          break=λ`_`."\n",
          breakAndIndent=λignored."\n",
          doubleBreak=λ`_`."\n\n"}
          ws in
    let idt := λws,s.cases(Ws){breakAndIndent=λindentStr.customIndent indentStr s, `_`=s} ws in
    cases(Expr){
      const=λsymbol.Symbol[] symbol,
      indent=λindentExpr.
          let style := IndentedExpression[style] indentExpr in
          let expr := IndentedExpression[expr] indentExpr in
          let lns := lines (printExpr expr) in
          let indentLine := λpre,line.ifElse (equal line "") line (strings.concat2 pre line) in
          let ilns := cases(IndentStyle){
              allLines=λpre.lists.map (indentLine pre) lns,
              subsequentLines=λpre.ifElse
                    (equal (lists.length lns) 1:int32)
                    lns
                    (optionals.withDefault
                      lns
                      (optionals.map
                        (λuc.lists.cons
                            (first uc)
                            (lists.map (indentLine pre) (second uc)))
                        (lists.uncons lns)))}
              style in
          strings.join "\n" ilns,
      seq=λseqExpr.
          let sop := SeqExpr[op] seqExpr in
          let ssym := Symbol[] (Op[symbol] sop) in
          let spadding := Op[padding] sop in
          let spadl := Padding[`left`] spadding in
          let spadr := Padding[`right`] spadding in
          let selements := SeqExpr[elements] seqExpr in
          let printedElements := lists.map (λel.idt spadr (printExpr el)) selements in
          let isNewlineWs := λws.cases(Ws){
                break=λ`_`.true,
                breakAndIndent=λ`_`.true,
                doubleBreak=λ`_`.true,
                `_`=false}
                ws in
          let spadlIsNewline := isNewlineWs spadl in
          let spadrIsNewline := isNewlineWs spadr in
          let joinElements := λacc,el.
              let elStartsWithNewline := optionals.match
                  (strings.charAt 0:int32 el)
                  false
                  (λc.equal c 10:int32) in
              let elIsEmpty := equal el "" in
              let padlEff := ifElse
                  (or
                    (and elStartsWithNewline (not spadlIsNewline))
                    (and elIsEmpty (equal ssym "")))
                  ""
                  (pad spadl) in
              let padrEff := ifElse
                  (or
                    (and elStartsWithNewline (not spadrIsNewline))
                    (and elIsEmpty (equal ssym "")))
                  ""
                  (pad spadr) in
              strings.concat [acc, padlEff, ssym, padrEff, el] in
          optionals.match
            (lists.head printedElements)
            ""
            (λh.lists.foldl joinElements h (lists.drop 1:int32 printedElements)),
      op=λopExpr.
          let op := OpExpr[op] opExpr in
          let sym := Symbol[] (Op[symbol] op) in
          let padding := Op[padding] op in
          let padl := Padding[`left`] padding in
          let padr := Padding[`right`] padding in
          let l := OpExpr[lhs] opExpr in
          let r := OpExpr[rhs] opExpr in
          let lhs := idt padl (printExpr l) in
          let rhs := idt padr (printExpr r) in
          let padrIsNewline := cases(Ws){
              break=λ`_`.true,
              breakAndIndent=λ`_`.true,
              doubleBreak=λ`_`.true,
              `_`=false}
              padr in
          let padlIsNewline := cases(Ws){break=λ`_`.true, doubleBreak=λ`_`.true, `_`=false}
              padl in
          let padlEffective := ifElse
              (and
                (not padlIsNewline)
                (and (equal sym "") (or padrIsNewline (equal rhs ""))))
              ""
              (pad padl) in
          let padrPad := pad padr in
          let rhsStartsWithNewline := optionals.match
              (strings.charAt 0:int32 rhs)
              false
              (λc.equal c 10:int32) in
          let padrEffective := ifElse (and rhsStartsWithNewline (not padrIsNewline)) "" padrPad in
          strings.concat2
            (strings.concat2 (strings.concat2 (strings.concat2 lhs padlEffective) sym) padrEffective)
            rhs,
      brackets=λbracketExpr.
          let brs := BracketExpr[brackets] bracketExpr in
          let l := Symbol[] (Brackets[open] brs) in
          let r := Symbol[] (Brackets[close] brs) in
          let e := BracketExpr[enclosed] bracketExpr in
          let style := BracketExpr[style] bracketExpr in
          let body := printExpr e in
          let doIndent := BlockStyle[indent] style in
          let nlBefore := BlockStyle[newlineBeforeContent] style in
          let nlAfter := BlockStyle[newlineAfterContent] style in
          let ibody := optionals.match doIndent body (λpre.customIndent pre body) in
          let pre := ifElse nlBefore "\n" "" in
          let suf := ifElse nlAfter "\n" "" in
          strings.concat2
            (strings.concat2 (strings.concat2 (strings.concat2 l pre) ibody) suf)
            r}
      e

## Separate elements with `;` inline
term semicolonSep = symbolSep ";" inlineStyle

## Combine a list of expressions into a single OpExpr chain using the given operator. Returns the empty constant for an empty list.
term sep =
  λop,els.optionals.match
      (lists.head els)
      (cst "")
      (λh.lists.foldl (λacc,el.ifx op acc el) h (lists.drop 1:int32 els))

## Space-separate elements (no break between them)
term spaceSep =
  sep
    Op{
      symbol = sym "",
      padding = Padding{`left` = Ws{space}, `right` = Ws{`none`}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}

## Space-separate elements inline if the joined width fits, otherwise newline-separate them. Useful for long signatures, type chains, and other space-joined sequences.
term spaceSepAdaptive = λels.chooseLayout maxLineWidth (spaceSep els) (newlineSep els)

## Square bracket pair `[` `]` for use with `brackets`
term squareBrackets = Brackets{open = Symbol{"["}, close = Symbol{"]"}}

## Like sep, but produces a SeqExpr instead of an OpExpr chain. SeqExpr is treated as structural layout and is not subject to parenthesization.
term structuralSep =
  λop,els.ifElse
      (lists.isEmpty els)
      (cst "")
      (ifElse
        (equal (lists.length els) 1:int32)
        (optionals.withDefault (cst "") (lists.head els))
        Expr{seq = SeqExpr{op = op, elements = els}})

## Like spaceSep, but produces a SeqExpr. Use for structural layout that should not trigger parenthesization of children.
term structuralSpaceSep =
  structuralSep
    Op{
      symbol = sym "",
      padding = Padding{`left` = Ws{space}, `right` = Ws{`none`}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}

## Append a suffix string to an expression
term suffix =
  λs,expr.
    let sufOp := Op{
      symbol = sym s,
      padding = Padding{`left` = Ws{`none`}, `right` = Ws{`none`}},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}}
    in ifx sufOp expr (cst "")

## Construct a Symbol from a string
term sym = λs.wrap(Symbol){s}

## Separate elements with the given symbol; trailing whitespace per element is determined by the block style's newline-before/after flags (space, single break, or double break)
term symbolSep =
  λsymb,style,l.
    let breakCount := lists.length
        (lists.filter
          (λ`x_`.`x_`)
          [BlockStyle[newlineBeforeContent] style, BlockStyle[newlineAfterContent] style]) in
    let break := ifElse
        (equal breakCount 0:int32)
        Ws{space}
        (ifElse (equal breakCount 1:int32) Ws{break} Ws{doubleBreak}) in
    let commaOp := Op{
      symbol = sym symb,
      padding = Padding{`left` = Ws{`none`}, `right` = break},
      precedence = Precedence{0:int32},
      associativity = Associativity{`none`}} in
    optionals.match
      (lists.head l)
      (cst "")
      (λh.lists.foldl (λacc,el.ifx commaOp acc el) h (lists.drop 1:int32 l))

## Indent every line of an expression by four spaces
term tabIndent = λe.Expr{indent = IndentedExpression{style = IndentStyle{allLines = "    "}, expr = e}}

## Tab-indent a list of expressions, separated by blank lines
term tabIndentDoubleSpace = λexprs.tabIndent (doubleNewlineSep exprs)

## Tab-indent a list of expressions, separated by single newlines
term tabIndentSingleSpace = λexprs.tabIndent (newlineSep exprs)

## Render a placeholder for a type the writer does not yet handle, e.g. `[bigint]`
term unsupportedType = λlabel.cst (strings.concat2 (strings.concat2 "[" label) "]")

## Render a placeholder for an unsupported variant, including a string representation of the offending value
term unsupportedVariant =
  λlabel,obj.cst
      (strings.concat2
        (strings.concat2 (strings.concat2 (strings.concat2 "[unsupported " label) ": ") (printString obj))
        "]")

## Append a trailing comma to an expression
term withComma = λe.noSep [e, cst ","]

## Append a trailing semicolon to an expression
term withSemi = λe.noSep [e, cst ";"]