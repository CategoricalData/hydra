import hydra.core.model
import hydra.core.print.model
import hydra.core.testing
import hydra.core.typing
import hydra.core.unification

## Test cases for type unification operations
term allTests =
  TestGroup{
    name = "unification",
    description = none,
    subgroups = [
      TestGroup{
        name = "variableOccursInType",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "variable occurs in itself",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printBoolean
                      (variableOccursInType
                        Name{"a"}
                        Type{variable = Name{"a"}}),
                expected = λ`_`.printBoolean true}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "variable does not occur in different variable",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printBoolean
                      (variableOccursInType
