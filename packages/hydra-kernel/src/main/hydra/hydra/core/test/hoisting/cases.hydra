                                      Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                      Term{literal = Literal{integer = IntegerValue{`int32` = 3:int32}}}]},
                                  typeScheme = none}],
                              body = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"f"}},
                                  argument = Term{
                                    variable = Name{"_hoist_x_body_1"}}}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "hoistLists: multiple lists in body are hoisted together",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
