## Test cases for subterm hoisting and case statement hoisting
module hydra.core.test.hoisting.cases

import hydra.core.hoisting
import hydra.core.lexical
import hydra.core.lib.maps
import hydra.core.lib.pairs
import hydra.core.model
import hydra.core.print.model
import hydra.core.testing

## Test cases for subterm hoisting and case statement hoisting
term allTests =
  TestGroup{
    name = "hoistCases",
    description = none,
    subgroups = [
      TestGroup{
        name = "hoistSubterms",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "hoistNothing: simple let unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (hoistSubterms
                        (λ`_`.false)
                        emptyGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"x"}}}}),
                expected = λ`_`.`term`
                      Term{
                        `let` = Let{
                          bindings = [
                            Binding{
                              name = Name{"x"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                              typeScheme = none}],
                          body = Term{
                            variable = Name{"x"}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "hoistNothing: let with list in body unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (hoistSubterms
                        (λ`_`.false)
                        emptyGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `list` = [
                                Term{variable = Name{"x"}},
                                Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                Term{literal = Literal{integer = IntegerValue{`int32` = 3:int32}}}]}}}),
                expected = λ`_`.`term`
                      Term{
                        `let` = Let{
                          bindings = [
                            Binding{
                              name = Name{"x"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                              typeScheme = none}],
                          body = Term{
                            `list` = [
                              Term{variable = Name{"x"}},
                              Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                              Term{literal = Literal{integer = IntegerValue{`int32` = 3:int32}}}]}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "hoistNothing: let with application in body unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (hoistSubterms
                        (λ`_`.false)
                        emptyGraph
                        Term{
                          `let` = Let{
                            bindings = [Binding{name = Name{"f"}, `term` = Term{variable = Name{"g"}}, typeScheme = none}],
                            body = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"f"}},
                                argument = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"h"}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 42:int32}}}}}}}}}),
                expected = λ`_`.`term`
                      Term{
                        `let` = Let{
                          bindings = [Binding{name = Name{"f"}, `term` = Term{variable = Name{"g"}}, typeScheme = none}],
                          body = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"f"}},
                              argument = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"h"}},
                                  argument = Term{
                                    literal = Literal{
                                      integer = IntegerValue{
                                        `int32` = 42:int32}}}}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "hoistLists: list in body is hoisted into local let",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (hoistSubterms
                        (λpt.cases(Term){
                            `list`=λ`_`.true,
