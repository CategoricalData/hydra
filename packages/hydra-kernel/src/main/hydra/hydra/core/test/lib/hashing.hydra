## Test cases for hydra.core.lib.hashing primitives
module hydra.core.test.lib.hashing

import hydra.core.lib.hashing
import hydra.core.lib.literals
import hydra.core.lib.text
import hydra.core.model
import hydra.core.testing

## Test cases for hydra.core.lib.hashing primitives
term allTests =
  TestGroup{
    name = "hydra.core.lib.hashing primitives",
    description = none,
    subgroups = [
      TestGroup{
        name = "matchesKnownAnswerVectors",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "empty input",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λs.s)
                      (binaryToBase64 (sha256 (encodeUtf8 ""))),
                expected = λ`_`.(λs.s)
                      "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU="}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.hashing.sha256.matchesKnownAnswerVectors"}]},
          TestCaseWithMetadata{
            name = "abc",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λs.s)
                      (binaryToBase64
                        (sha256 (encodeUtf8 "abc"))),
                expected = λ`_`.(λs.s)
                      "ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0="}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.hashing.sha256.matchesKnownAnswerVectors"}]}]},
      TestGroup{
        name = "sha256Hex",
        description = none,
        subgroups = [
          TestGroup{
            name = "matchesKnownAnswerVectors",
            description = none,
            subgroups = [],
            `cases` = [
              TestCaseWithMetadata{
                name = "empty input",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s) (sha256Hex (encodeUtf8 "")),
                    expected = λ`_`.(λs.s)
                          "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.hashing.sha256Hex.matchesKnownAnswerVectors"}]},
              TestCaseWithMetadata{
                name = "abc",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s) (sha256Hex (encodeUtf8 "abc")),
                    expected = λ`_`.(λs.s)
                          "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.hashing.sha256Hex.matchesKnownAnswerVectors"}]},
              TestCaseWithMetadata{
                name = "multi-block input (spans two SHA-256 blocks)",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
                          (sha256Hex
                            (encodeUtf8
                              "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs.")),
                    expected = λ`_`.(λs.s)
                          "d51712a8d1852b5acf942c19caddf168f80120d2f3a72c2d917227fd37f22788"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.hashing.sha256Hex.matchesKnownAnswerVectors"}]}]},
          TestGroup{
            name = "handlesPaddingBoundariesCorrectly",
            description = none,
            subgroups = [],
            `cases` = [
              TestCaseWithMetadata{
                name = "padding boundary: 55 bytes (fills one block)",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
                          (sha256Hex
                            (encodeUtf8
                              "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")),
                    expected = λ`_`.(λs.s)
                          "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.hashing.sha256Hex.handlesPaddingBoundariesCorrectly"}]},
              TestCaseWithMetadata{
                name = "padding boundary: 56 bytes (forces a second block)",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
                          (sha256Hex
                            (encodeUtf8
                              "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")),
                    expected = λ`_`.(λs.s)
                          "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.hashing.sha256Hex.handlesPaddingBoundariesCorrectly"}]},
              TestCaseWithMetadata{
                name = "padding boundary: 63 bytes (one below block size)",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
                          (sha256Hex
                            (encodeUtf8
                              "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")),
                    expected = λ`_`.(λs.s)
                          "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.hashing.sha256Hex.handlesPaddingBoundariesCorrectly"}]},
              TestCaseWithMetadata{
                name = "padding boundary: 64 bytes (exactly one block)",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
                          (sha256Hex
                            (encodeUtf8
                              "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")),
                    expected = λ`_`.(λs.s)
                          "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.hashing.sha256Hex.handlesPaddingBoundariesCorrectly"}]}]}],
        `cases` = []}],
    `cases` = []}