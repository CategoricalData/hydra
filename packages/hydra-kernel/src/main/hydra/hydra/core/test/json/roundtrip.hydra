## Round-trip test cases for JSON encoding and decoding
term allTests =
  TestGroup{
    name = "JSON round-trip",
    description = none,
    subgroups = [
      TestGroup{
        name = "literal types",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "boolean true",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.e)
                      (λjson.eithers.either
                          (λe.e)
                          (λdecoded.`term` decoded)
                          (fromJson
                            maps.empty
                            true
                            Name{"test"}
                            Type{
                              literal = LiteralType{
                                `boolean`}}
                            json))
                      (toJson
                        maps.empty
                        true
                        Name{"test"}
                        Type{
                          literal = LiteralType{
                            `boolean`}}
                        Term{
                          literal = Literal{
                            `boolean` = true}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          `boolean` = true}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
