            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "polymorphic binding captures multiple lambda variables",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistPolymorphicLetBindings
                        (λb.true)
