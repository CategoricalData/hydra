## Test cases for let-binding hoisting transformations
module hydra.core.test.hoisting.let

import hydra.core.hoisting
import hydra.core.lib.maps
import hydra.core.model
import hydra.core.print.model
import hydra.core.testing

## Test cases for let-binding hoisting transformations
term allTests =
  TestGroup{
    name = "hoistLet",
    description = none,
    subgroups = [
      TestGroup{
        name = "hoistLetBindings",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "nested let inside lambda: binding hoisted with lambda capture",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistAllLetBindings
                        Let{
                          bindings = [
                            Binding{
                              name = Name{"f"},
                              `term` = Term{
                                lambda = Lambda{
                                  parameter = Name{"a"},
                                  domain = none,
                                  body = Term{
                                    `let` = Let{
                                      bindings = [
                                        Binding{
                                          name = Name{"g"},
                                          `term` = Term{
                                            application = Application{
                                              function = Term{
                                                application = Application{
                                                  function = Term{
                                                    variable = Name{"hydra.core.lib.math.add"}},
                                                  argument = Term{
                                                    variable = Name{"a"}}}},
                                              argument = Term{
                                                literal = Literal{
                                                  integer = IntegerValue{
                                                    `int32` = 1:int32}}}}},
                                          typeScheme = none}],
                                      body = Term{
                                        application = Application{
                                          function = Term{
                                            application = Application{
                                              function = Term{
                                                variable = Name{"hydra.core.lib.math.mul"}},
                                              argument = Term{
                                                variable = Name{"g"}}}},
                                          argument = Term{
                                            literal = Literal{
                                              integer = IntegerValue{
                                                `int32` = 2:int32}}}}}}}}},
                              typeScheme = none}],
                          body = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"f"}},
                              argument = Term{
                                literal = Literal{
                                  integer = IntegerValue{
                                    `int32` = 10:int32}}}}}}),
                expected = λ`_`.`let`
                      Let{
                        bindings = [
                          Binding{
                            name = Name{"f"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"a"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.mul"}},
                                        argument = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"f_g"}},
                                            argument = Term{
                                              variable = Name{"a"}}}}}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 2:int32}}}}}}},
                            typeScheme = none},
                          Binding{
                            name = Name{"f_g"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"a"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.add"}},
                                        argument = Term{
                                          variable = Name{"a"}}}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 1:int32}}}}}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"f"}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 10:int32}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "type application: nested let outside lambda CAN be hoisted",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistAllLetBindings
                        Let{
                          bindings = [
                            Binding{
                              name = Name{"f"},
                              `term` = Term{
                                typeApplication = TypeApplicationTerm{
                                  body = Term{
                                    `let` = Let{
                                      bindings = [
                                        Binding{
                                          name = Name{"y"},
                                          `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                          typeScheme = none}],
                                      body = Term{
                                        lambda = Lambda{
                                          parameter = Name{"x"},
                                          domain = none,
                                          body = Term{
                                            application = Application{
                                              function = Term{
                                                application = Application{
                                                  function = Term{
                                                    variable = Name{"hydra.core.lib.math.add"}},
                                                  argument = Term{
                                                    variable = Name{"x"}}}},
                                              argument = Term{
                                                variable = Name{"y"}}}}}}}},
                                  `type` = Type{
                                    literal = LiteralType{
                                      integer = IntegerType{
                                        `int32`}}}}},
                              typeScheme = none}],
                          body = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"f"}},
                              argument = Term{
                                literal = Literal{
                                  integer = IntegerValue{
                                    `int32` = 10:int32}}}}}}),
                expected = λ`_`.`let`
                      Let{
                        bindings = [
                          Binding{
                            name = Name{"f"},
                            `term` = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.add"}},
                                            argument = Term{
                                              variable = Name{"x"}}}},
                                        argument = Term{
                                          variable = Name{"f_y"}}}}}},
                                `type` = Type{
                                  literal = LiteralType{
                                    integer = IntegerType{
                                      `int32`}}}}},
                            typeScheme = none},
                          Binding{
                            name = Name{"f_y"},
                            `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"f"}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 10:int32}}}}}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "hoistPolymorphicLetBindings",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "no polymorphic bindings: simple let unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistPolymorphicLetBindings
                        (λb.true)
                        Let{
                          bindings = [
                            Binding{
                              name = Name{"x"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                              typeScheme = given(TypeScheme{
                                  variables = [],
                                  body = Type{literal = LiteralType{integer = IntegerType{`int32`}}},
                                  constraints = empty})}],
                          body = Term{
                            variable = Name{"x"}}}),
                expected = λ`_`.`let`
                      Let{
                        bindings = [
                          Binding{
                            name = Name{"x"},
                            `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                            typeScheme = given(TypeScheme{
                                variables = [],
                                body = Type{literal = LiteralType{integer = IntegerType{`int32`}}},
                                constraints = empty})}],
                        body = Term{
                          variable = Name{"x"}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "no polymorphic bindings: multiple monomorphic bindings",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistPolymorphicLetBindings
                        (λb.true)
                        Let{
                          bindings = [
                            Binding{
                              name = Name{"x"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                              typeScheme = given(TypeScheme{
                                  variables = [],
                                  body = Type{literal = LiteralType{integer = IntegerType{`int32`}}},
                                  constraints = empty})},
                            Binding{
                              name = Name{"y"},
                              `term` = Term{literal = Literal{`string` = "hi"}},
                              typeScheme = given(TypeScheme{
                                  variables = [],
                                  body = Type{literal = LiteralType{`string`}},
                                  constraints = empty})}],
                          body = Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"pair"}},
                                  argument = Term{
                                    variable = Name{"x"}}}},
                              argument = Term{
                                variable = Name{"y"}}}}}),
                expected = λ`_`.`let`
                      Let{
                        bindings = [
                          Binding{
                            name = Name{"x"},
                            `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                            typeScheme = given(TypeScheme{
                                variables = [],
                                body = Type{literal = LiteralType{integer = IntegerType{`int32`}}},
                                constraints = empty})},
                          Binding{
                            name = Name{"y"},
                            `term` = Term{literal = Literal{`string` = "hi"}},
                            typeScheme = given(TypeScheme{
                                variables = [],
                                body = Type{literal = LiteralType{`string`}},
                                constraints = empty})}],
                        body = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"pair"}},
                                argument = Term{
                                  variable = Name{"x"}}}},
                            argument = Term{
                              variable = Name{"y"}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "single polymorphic binding: already at top level",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistPolymorphicLetBindings
                        (λb.true)
                        Let{
                          bindings = [
                            Binding{
                              name = Name{"id"},
                              `term` = Term{lambda = Lambda{parameter = Name{"x"}, domain = none, body = Term{variable = Name{"x"}}}},
                              typeScheme = given(TypeScheme{
                                  variables = [Name{"a"}],
                                  body = Type{
                                    function = FunctionType{
                                      domain = Type{variable = Name{"a"}},
                                      codomain = Type{variable = Name{"a"}}}},
                                  constraints = empty})}],
                          body = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"id"}},
                              argument = Term{
                                literal = Literal{
                                  integer = IntegerValue{
                                    `int32` = 42:int32}}}}}}),
                expected = λ`_`.`let`
                      Let{
                        bindings = [
                          Binding{
                            name = Name{"id"},
                            `term` = Term{lambda = Lambda{parameter = Name{"x"}, domain = none, body = Term{variable = Name{"x"}}}},
                            typeScheme = given(TypeScheme{
                                variables = [Name{"a"}],
                                body = Type{
                                  function = FunctionType{
                                    domain = Type{variable = Name{"a"}},
                                    codomain = Type{variable = Name{"a"}}}},
                                constraints = empty})}],
                        body = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"id"}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 42:int32}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "polymorphic binding inside lambda: no capture",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistPolymorphicLetBindings
                        (λb.true)
                        Let{
                          bindings = [
                            Binding{
                              name = Name{"f"},
                              `term` = Term{
                                lambda = Lambda{
                                  parameter = Name{"a"},
                                  domain = none,
                                  body = Term{
                                    `let` = Let{
                                      bindings = [
                                        Binding{
                                          name = Name{"id"},
                                          `term` = Term{lambda = Lambda{parameter = Name{"x"}, domain = none, body = Term{variable = Name{"x"}}}},
                                          typeScheme = given(TypeScheme{
                                              variables = [Name{"b"}],
                                              body = Type{
                                                function = FunctionType{
                                                  domain = Type{variable = Name{"b"}},
                                                  codomain = Type{variable = Name{"b"}}}},
                                              constraints = empty})}],
                                      body = Term{
                                        application = Application{
                                          function = Term{
                                            variable = Name{"id"}},
                                          argument = Term{
                                            variable = Name{"a"}}}}}}}},
                              typeScheme = given(TypeScheme{
                                  variables = [],
                                  body = Type{
                                    function = FunctionType{
                                      domain = Type{
                                        literal = LiteralType{
                                          integer = IntegerType{
                                            `int32`}}},
                                      codomain = Type{
                                        literal = LiteralType{
                                          integer = IntegerType{
                                            `int32`}}}}},
                                  constraints = empty})}],
                          body = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"f"}},
                              argument = Term{
                                literal = Literal{
                                  integer = IntegerValue{
                                    `int32` = 42:int32}}}}}}),
                expected = λ`_`.`let`
                      Let{
                        bindings = [
                          Binding{
                            name = Name{"f"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"a"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"f_id"}},
                                    argument = Term{variable = Name{"a"}}}}}},
                            typeScheme = given(TypeScheme{
                                variables = [],
                                body = Type{
                                  function = FunctionType{
                                    domain = Type{
                                      literal = LiteralType{
                                        integer = IntegerType{
                                          `int32`}}},
                                    codomain = Type{
                                      literal = LiteralType{
                                        integer = IntegerType{
                                          `int32`}}}}},
                                constraints = empty})},
                          Binding{
                            name = Name{"f_id"},
                            `term` = Term{
                              typeLambda = TypeLambda{
                                parameter = Name{"b"},
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{variable = Name{"x"}}}}}},
                            typeScheme = given(TypeScheme{
                                variables = [Name{"b"}],
                                body = Type{
                                  function = FunctionType{
                                    domain = Type{variable = Name{"b"}},
                                    codomain = Type{variable = Name{"b"}}}},
                                constraints = empty})}],
                        body = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"f"}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 42:int32}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "polymorphic binding captures lambda variable: wrapped in lambda",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`let`
                      (hoistPolymorphicLetBindings
                        (λb.true)
                        Let{
                          bindings = [
                            Binding{
                              name = Name{"f"},
                              `term` = Term{
                                lambda = Lambda{
                                  parameter = Name{"a"},
                                  domain = given(Type{literal = LiteralType{`string`}}),
                                  body = Term{
                                    `let` = Let{
                                      bindings = [
                                        Binding{
                                          name = Name{"g"},
                                          `term` = Term{
                                            lambda = Lambda{
                                              parameter = Name{"x"},
                                              domain = none,
                                              body = Term{
                                                application = Application{
                                                  function = Term{
                                                    application = Application{
                                                      function = Term{
                                                        variable = Name{"pair"}},
                                                      argument = Term{
                                                        variable = Name{"a"}}}},
                                                  argument = Term{variable = Name{"x"}}}}}},
                                          typeScheme = given(TypeScheme{
                                              variables = [Name{"b"}],
                                              body = Type{
                                                function = FunctionType{
                                                  domain = Type{variable = Name{"b"}},
                                                  codomain = Type{
                                                    pair = PairType{
                                                      first = Type{
                                                        literal = LiteralType{
                                                          `string`}},
                                                      second = Type{
                                                        variable = Name{"b"}}}}}},
                                              constraints = empty})}],
                                      body = Term{
                                        application = Application{
                                          function = Term{
                                            variable = Name{"g"}},
                                          argument = Term{
                                            literal = Literal{
                                              integer = IntegerValue{
                                                `int32` = 42:int32}}}}}}}}},
                              typeScheme = given(TypeScheme{
                                  variables = [],
                                  body = Type{
                                    function = FunctionType{
                                      domain = Type{
                                        literal = LiteralType{
                                          `string`}},
                                      codomain = Type{
                                        pair = PairType{
                                          first = Type{
                                            literal = LiteralType{
                                              `string`}},
                                          second = Type{
                                            literal = LiteralType{
                                              integer = IntegerType{
                                                `int32`}}}}}}},
                                  constraints = empty})}],
                          body = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"f"}},
                              argument = Term{
                                literal = Literal{
                                  `string` = "hello"}}}}}),
