## Test cases for dependency analysis and let-term transformations
module hydra.core.test.dependencies

import hydra.core.constants
import hydra.core.dependencies
import hydra.core.lib.maps as maps
import hydra.core.lib.pairs
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.testing

## Test cases for dependency analysis and let-term transformations
term allTests =
  TestGroup{
    name = "dependencies",
    description = none,
    subgroups = [
      TestGroup{
        name = "simplifyTerm",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "const application with literal",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (simplifyTerm
                        Term{
                          application = Application{
                            function = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    `string` = "foo"}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 42:int32}}}}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          `string` = "foo"}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "identity application",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (simplifyTerm
                        Term{
                          application = Application{
                            function = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  `list` = [Term{variable = Name{"x"}}, Term{variable = Name{"x"}}]}}},
                            argument = Term{
                              variable = Name{"y"}}}}),
                expected = λ`_`.`term`
                      Term{
                        `list` = [Term{variable = Name{"y"}}, Term{variable = Name{"y"}}]}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "unused parameter",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (simplifyTerm
                        Term{
                          application = Application{
                            function = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    `string` = "foo"}}}},
                            argument = Term{
                              variable = Name{"y"}}}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          `string` = "foo"}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "nested lambda applications",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (simplifyTerm
                        Term{
                          application = Application{
                            function = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      lambda = Lambda{
                                        parameter = Name{"a"},
                                        domain = none,
                                        body = Term{
                                          `list` = [Term{literal = Literal{`string` = "foo"}}, Term{variable = Name{"a"}}]}}},
                                    argument = Term{
                                      variable = Name{"x"}}}}}},
                            argument = Term{
                              variable = Name{"y"}}}}),
                expected = λ`_`.`term`
                      Term{
                        `list` = [Term{literal = Literal{`string` = "foo"}}, Term{variable = Name{"y"}}]}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "flattenLetTerms",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "non-let term unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (flattenLetTerms
                        Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 42:int32}}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = 42:int32}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "list term unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (flattenLetTerms
                        Term{
                          `list` = [Term{literal = Literal{`string` = "foo"}}]}),
                expected = λ`_`.`term`
                      Term{
                        `list` = [Term{literal = Literal{`string` = "foo"}}]}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "sequential lets in body are flattened",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (flattenLetTerms
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `let` = Let{
                                bindings = [
                                  Binding{
                                    name = Name{"y"},
                                    `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                    typeScheme = none}],
                                body = Term{
                                  `list` = [Term{variable = Name{"x"}}, Term{variable = Name{"y"}}]}}}}}),
                expected = λ`_`.`term`
                      Term{
                        `let` = Let{
                          bindings = [
                            Binding{
                              name = Name{"x"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                              typeScheme = none},
                            Binding{
                              name = Name{"y"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                              typeScheme = none}],
                          body = Term{
                            `list` = [Term{variable = Name{"x"}}, Term{variable = Name{"y"}}]}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "nested binding in let value is flattened",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (flattenLetTerms
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"a"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none},
                              Binding{
                                name = Name{"b"},
                                `term` = Term{
                                  `let` = Let{
                                    bindings = [
                                      Binding{
                                        name = Name{"x"},
                                        `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                        typeScheme = none},
                                      Binding{
                                        name = Name{"y"},
                                        `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                        typeScheme = none}],
                                    body = Term{`list` = [Term{variable = Name{"x"}}, Term{variable = Name{"y"}}]}}},
                                typeScheme = none}],
                            body = Term{
                              `list` = [Term{variable = Name{"a"}}, Term{variable = Name{"b"}}]}}}),
                expected = λ`_`.`term`
                      Term{
                        `let` = Let{
                          bindings = [
                            Binding{
                              name = Name{"a"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                              typeScheme = none},
                            Binding{
                              name = Name{"b_x"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                              typeScheme = none},
                            Binding{
                              name = Name{"b_y"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                              typeScheme = none},
                            Binding{
                              name = Name{"b"},
                              `term` = Term{`list` = [Term{variable = Name{"b_x"}}, Term{variable = Name{"b_y"}}]},
                              typeScheme = none}],
                          body = Term{
                            `list` = [Term{variable = Name{"a"}}, Term{variable = Name{"b"}}]}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "multiple levels of nesting are flattened",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (flattenLetTerms
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"a"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none},
                              Binding{
                                name = Name{"b"},
                                `term` = Term{
                                  `let` = Let{
                                    bindings = [
                                      Binding{
                                        name = Name{"x"},
                                        `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                        typeScheme = none},
                                      Binding{
                                        name = Name{"y"},
                                        `term` = Term{
                                          `let` = Let{
                                            bindings = [
                                              Binding{
                                                name = Name{"p"},
                                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 137:int32}}},
                                                typeScheme = none},
                                              Binding{
                                                name = Name{"q"},
                                                `term` = Term{
                                                  `list` = [Term{variable = Name{"x"}}, Term{literal = Literal{integer = IntegerValue{`int32` = 5:int32}}}]},
                                                typeScheme = none}],
                                            body = Term{`list` = [Term{variable = Name{"a"}}, Term{variable = Name{"q"}}]}}},
                                        typeScheme = none}],
                                    body = Term{`list` = [Term{variable = Name{"x"}}, Term{variable = Name{"y"}}]}}},
                                typeScheme = none}],
                            body = Term{
                              `list` = [Term{variable = Name{"a"}}, Term{variable = Name{"b"}}]}}}),
                expected = λ`_`.`term`
                      Term{
                        `let` = Let{
                          bindings = [
                            Binding{
                              name = Name{"a"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                              typeScheme = none},
                            Binding{
                              name = Name{"b_x"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                              typeScheme = none},
                            Binding{
                              name = Name{"b_y_p"},
                              `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 137:int32}}},
                              typeScheme = none},
                            Binding{
                              name = Name{"b_y_q"},
                              `term` = Term{
                                `list` = [Term{variable = Name{"b_x"}}, Term{literal = Literal{integer = IntegerValue{`int32` = 5:int32}}}]},
                              typeScheme = none},
                            Binding{
                              name = Name{"b_y"},
                              `term` = Term{`list` = [Term{variable = Name{"a"}}, Term{variable = Name{"b_y_q"}}]},
                              typeScheme = none},
                            Binding{
                              name = Name{"b"},
                              `term` = Term{`list` = [Term{variable = Name{"b_x"}}, Term{variable = Name{"b_y"}}]},
                              typeScheme = none}],
                          body = Term{
                            `list` = [Term{variable = Name{"a"}}, Term{variable = Name{"b"}}]}}}}},
            description = none,
            tags = [],
            provisions = []}]},
