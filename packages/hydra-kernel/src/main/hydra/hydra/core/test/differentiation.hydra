import hydra.core.variables

## Test cases for automatic differentiation
term allTests =
  TestGroup{
    name = "differentiation",
    description = none,
    subgroups = [
      TestGroup{
        name = "basic rules",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "variable wrt itself",
