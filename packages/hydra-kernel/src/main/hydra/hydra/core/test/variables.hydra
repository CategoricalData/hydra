## Test cases for variable analysis and manipulation
module hydra.core.test.variables

import hydra.core.lib.lists as lists
import hydra.core.lib.maps
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.testing
import hydra.core.variables

## Test cases for variable analysis and manipulation
term allTests =
  TestGroup{
    name = "variables",
    description = none,
    subgroups = [
      TestGroup{
        name = "eagerFreeVariables",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "string literal has no eager free variables",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map (λn.Name[] n) (sets.toList (eagerFreeVariablesInTerm Term{literal = Literal{`string` = "foo"}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "unapplied lambda body is deferred, not eager",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (eagerFreeVariablesInTerm
                                Term{lambda = Lambda{parameter = Name{"y"}, domain = none, body = Term{variable = Name{"dep"}}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "ordinary application: argument lambda stays deferred, function is eager",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (eagerFreeVariablesInTerm
                                Term{
                                  application = Application{
                                    function = Term{variable = Name{"bind"}},
                                    argument = Term{
                                      lambda = Lambda{
                                        parameter = Name{"y"},
                                        domain = none,
                                        body = Term{variable = Name{"dep"}}}}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"bind"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "single-argument beta-redex: body's eager reference is visible, not deferred",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (eagerFreeVariablesInTerm
                                Term{
                                  application = Application{
                                    function = Term{
                                      lambda = Lambda{
                                        parameter = Name{"vars"},
                                        domain = none,
                                        body = Term{variable = Name{"dep"}}}},
                                    argument = Term{`list` = []}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"dep"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "curried two-argument beta-redex: body's eager reference survives both layers",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (eagerFreeVariablesInTerm
                                Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          lambda = Lambda{
                                            parameter = Name{"vars"},
                                            domain = none,
                                            body = Term{
                                              lambda = Lambda{
                                                parameter = Name{"mcs"},
                                                domain = none,
                                                body = Term{
                                                  variable = Name{"dep"}}}}}},
                                        argument = Term{`list` = []}}},
                                    argument = Term{literal = Literal{`string` = "arg1"}}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"dep"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "curried beta-redex: bound parameters are not themselves free",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (eagerFreeVariablesInTerm
                                Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          lambda = Lambda{
                                            parameter = Name{"vars"},
                                            domain = none,
                                            body = Term{
                                              lambda = Lambda{
                                                parameter = Name{"mcs"},
                                                domain = none,
                                                body = Term{
                                                  application = Application{
                                                    function = Term{
                                                      variable = Name{"vars"}},
                                                    argument = Term{
                                                      variable = Name{"mcs"}}}}}}}},
                                        argument = Term{`list` = []}}},
                                    argument = Term{literal = Literal{`string` = "arg1"}}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "partially-applied curried lambda: unapplied final layer stays deferred",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (eagerFreeVariablesInTerm
                                Term{
                                  application = Application{
                                    function = Term{
                                      lambda = Lambda{
                                        parameter = Name{"vars"},
                                        domain = none,
                                        body = Term{
                                          lambda = Lambda{
                                            parameter = Name{"mcs"},
                                            domain = none,
                                            body = Term{
                                              variable = Name{"dep"}}}}}},
                                    argument = Term{`list` = []}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "beta-redex argument is itself evaluated eagerly",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (eagerFreeVariablesInTerm
                                Term{
                                  application = Application{
                                    function = Term{
                                      lambda = Lambda{
                                        parameter = Name{"vars"},
                                        domain = none,
                                        body = Term{variable = Name{"vars"}}}},
                                    argument = Term{variable = Name{"argDep"}}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"argDep"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "freeVariables",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "string literal has no free variables",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map (λn.Name[] n) (sets.toList (freeVariablesInTerm Term{literal = Literal{`string` = "foo"}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "single variable",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList (freeVariablesInTerm Term{variable = Name{"x"}}))), "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"x"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "bound variable is not free",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (freeVariablesInTerm Term{lambda = Lambda{parameter = Name{"y"}, domain = none, body = Term{variable = Name{"y"}}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "unbound variable in lambda body",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (freeVariablesInTerm Term{lambda = Lambda{parameter = Name{"y"}, domain = none, body = Term{variable = Name{"x"}}}}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"x"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "mixed free and bound variables",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (freeVariablesInTerm
                                Term{
                                  `list` = [
                                    Term{variable = Name{"x"}},
                                    Term{
                                      application = Application{
                                        function = Term{
                                          lambda = Lambda{
                                            parameter = Name{"y"},
                                            domain = none,
                                            body = Term{variable = Name{"y"}}}},
                                        argument = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}}}]}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"x"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "multiple free variables",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.strings.concat
                      [
                        "{",
                        strings.join
                          ", "
                          (lists.map
                            (λn.Name[] n)
                            (sets.toList
                              (freeVariablesInTerm
                                Term{
                                  `list` = [
                                    Term{variable = Name{"x"}},
                                    Term{
                                      application = Application{
                                        function = Term{
                                          lambda = Lambda{
                                            parameter = Name{"y"},
                                            domain = none,
                                            body = Term{variable = Name{"y"}}}},
                                        argument = Term{variable = Name{"y"}}}}]}))),
                        "}"],
                expected = λ`_`.strings.concat
                      ["{", strings.join ", " (lists.map (λn.Name[] n) (sets.toList {Name{"x"}, Name{"y"}})), "}"]}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "normalizeTypeVariables",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "literal without type variables unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (normalizeTypeVariablesInTerm
                        Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 42:int32}}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = 42:int32}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "simple let without type annotations unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (normalizeTypeVariablesInTerm
                        Term{
                          `let` = Let{
                            bindings = [Binding{name = Name{"foo"}, `term` = Term{literal = Literal{`string` = "foo"}}, typeScheme = none}],
                            body = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 42:int32}}}}}),
                expected = λ`_`.`term`
                      Term{
                        `let` = Let{
                          bindings = [Binding{name = Name{"foo"}, `term` = Term{literal = Literal{`string` = "foo"}}, typeScheme = none}],
                          body = Term{
                            literal = Literal{
                              integer = IntegerValue{
                                `int32` = 42:int32}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "let with monomorphic type scheme unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (normalizeTypeVariablesInTerm
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"foo"},
                                `term` = Term{literal = Literal{`string` = "foo"}},
                                typeScheme = given(TypeScheme{variables = [], body = Type{literal = LiteralType{`string`}}, constraints = {}})}],
                            body = Term{
