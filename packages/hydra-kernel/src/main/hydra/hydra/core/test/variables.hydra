            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "binding rewriting does not affect body with typed lambda",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`term`
                      (normalizeTypeVariablesInTerm
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
