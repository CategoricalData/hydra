## Type definitions for the test suite
module hydra.core.test.testTypes

import hydra.core.model

term compareStringsType =
  Type{
    function = FunctionType{
      domain = Type{literal = LiteralType{`string`}},
      codomain = Type{literal = LiteralType{`string`}}}}@{firstClassType=true}

term concatType =
  Type{
    function = FunctionType{
      domain = Type{literal = LiteralType{`string`}},
      codomain = Type{
        function = FunctionType{
          domain = Type{literal = LiteralType{`string`}},
          codomain = Type{
            literal = LiteralType{
              `string`}}}}}}@{firstClassType=true}

term eitherStringOrInt8Type =
