          FieldType{
            name = Name{"tail"},
            `type` = Type{
              `optional` = Type{
                application = ApplicationType{
                  function = Type{
                    variable = testTypeBuddyListBName},
                  argument = Type{variable = Name{"a"}}}}}}]}}}@{firstClassType=true}

