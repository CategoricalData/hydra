term higherOrderApplicationsTests =
  TestGroup{
    name = "Higher-order applications",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "apply function to function",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"apply"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"f"},
                                domain = none,
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"f"}},
                                        argument = Term{
                                          variable = Name{"x"}}}}}}}},
                            typeScheme = none},
                          Binding{
                            name = Name{"double"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"n"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.mul"}},
                                        argument = Term{
                                          variable = Name{"n"}}}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 2:int32}}}}}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"apply"}},
                                argument = Term{
                                  variable = Name{"double"}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 5:int32}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      integer = IntegerType{
                        `int32`}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "function composition",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"compose"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"f"},
                                domain = none,
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"g"},
                                    domain = none,
                                    body = Term{
                                      lambda = Lambda{
                                        parameter = Name{"x"},
                                        domain = none,
                                        body = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"f"}},
                                            argument = Term{
                                              application = Application{
                                                function = Term{
                                                  variable = Name{"g"}},
                                                argument = Term{
                                                  variable = Name{"x"}}}}}}}}}}}},
                            typeScheme = none},
                          Binding{
                            name = Name{"add1"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"n"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.add"}},
                                        argument = Term{
                                          variable = Name{"n"}}}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 1:int32}}}}}}},
                            typeScheme = none},
                          Binding{
                            name = Name{"mul2"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"n"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.mul"}},
                                        argument = Term{
                                          variable = Name{"n"}}}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 2:int32}}}}}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"compose"}},
                                    argument = Term{
                                      variable = Name{"add1"}}}},
                                argument = Term{
                                  variable = Name{"mul2"}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 3:int32}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      integer = IntegerType{
                        `int32`}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term polymorphicApplicationsTests =
  TestGroup{
    name = "Polymorphic applications",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "polymorphic identity",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"id"},
                            `term` = Term{lambda = Lambda{parameter = Name{"x"}, domain = none, body = Term{variable = Name{"x"}}}},
                            typeScheme = none}],
                        body = Term{
                          pair = (
                              Term{
                                application = Application{
                                  function = Term{variable = Name{"id"}},
                                  argument = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}}},
                              Term{
                                application = Application{
                                  function = Term{variable = Name{"id"}},
                                  argument = Term{literal = Literal{`string` = "hello"}}}})}}}),
            expected = λ`_`.`type`
                  Type{
                    pair = PairType{
                      first = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `int32`}}},
                      second = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "polymorphic const",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"const"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"y"},
                                    domain = none,
                                    body = Term{variable = Name{"x"}}}}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"const"}},
                                argument = Term{
                                  literal = Literal{
                                    `string` = "keep"}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 999:int32}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      `string`}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "polymorphic flip",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"flip"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"f"},
                                domain = none,
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{
                                      lambda = Lambda{
                                        parameter = Name{"y"},
                                        domain = none,
                                        body = Term{
                                          application = Application{
                                            function = Term{
                                              application = Application{
                                                function = Term{
                                                  variable = Name{"f"}},
                                                argument = Term{
                                                  variable = Name{"y"}}}},
                                            argument = Term{
                                              variable = Name{"x"}}}}}}}}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"flip"}},
                                    argument = Term{
                                      variable = Name{"hydra.core.lib.strings.concat2"}}}},
                                argument = Term{
                                  literal = Literal{
                                    `string` = "world"}}}},
                            argument = Term{
                              literal = Literal{
                                `string` = "hello"}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      `string`}}}},
        description = none,
        tags = [],
        provisions = []}]}

term applicationsInComplexContextsTests =
  TestGroup{
    name = "Applications in complex contexts",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "application in tuple",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      pair = (
                          Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.math.add"}},
                                  argument = Term{
                                    literal = Literal{
                                      integer = IntegerValue{
                                        `int32` = 1:int32}}}}},
                              argument = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}}},
                          Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.strings.concat2"}},
                                  argument = Term{
                                    literal = Literal{
                                      `string` = "a"}}}},
                              argument = Term{literal = Literal{`string` = "b"}}}})}),
            expected = λ`_`.`type`
                  Type{
                    pair = PairType{
                      first = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `int32`}}},
                      second = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "application in record",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = testTypePersonName,
                        fields = [
                          Field{
                            name = Name{"firstName"},
                            `term` = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.strings.concat2"}},
                                    argument = Term{
                                      literal = Literal{
                                        `string` = "John"}}}},
                                argument = Term{literal = Literal{`string` = "ny"}}}}},
                          Field{name = Name{"lastName"}, `term` = Term{literal = Literal{`string` = "Doe"}}},
                          Field{
                            name = Name{"age"},
                            `term` = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.add"}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 20:int32}}}}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 5:int32}}}}}}]}}),
            expected = λ`_`.`type`
                  Type{
                    variable = testTypePersonName}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "application in let binding",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"result"},
                            `term` = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.mul"}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 6:int32}}}}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 7:int32}}}}},
                            typeScheme = none}],
                        body = Term{
                          variable = Name{"result"}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      integer = IntegerType{
                        `int32`}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "nested applications",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.add"}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.mul"}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 3:int32}}}}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 4:int32}}}}}}},
                        argument = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.math.add"}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 1:int32}}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 2:int32}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      integer = IntegerType{
                        `int32`}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term applicationsWithComplexArgumentsTests =
  TestGroup{
    name = "Applications with complex arguments",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "application with record argument",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"getName"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"person"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      `project` = Projection{
                                        typeName = testTypePersonName,
                                        fieldName = Name{"firstName"}}},
                                    argument = Term{
                                      variable = Name{"person"}}}}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"getName"}},
                            argument = Term{
                              `record` = Record{
                                typeName = testTypePersonName,
                                fields = [
                                  Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Alice"}}},
                                  Field{name = Name{"lastName"}, `term` = Term{literal = Literal{`string` = "Smith"}}},
                                  Field{name = Name{"age"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 25:int32}}}}]}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      `string`}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "application with list argument",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"maybeHead"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"xs"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.lists.head"}},
                                    argument = Term{variable = Name{"xs"}}}}}},
                            typeScheme = none}],
                        body = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"maybeHead"}},
                            argument = Term{
                              `list` = [Term{literal = Literal{`string` = "first"}}, Term{literal = Literal{`string` = "second"}}]}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `optional` = Type{
                      literal = LiteralType{
                        `string`}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term lambdasTests =
  TestGroup{
    name = "Lambdas",
