term simpleLambdasTests =
  TestGroup{
    name = "Simple lambdas",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "identity function",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          variable = Name{"x"}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            variable = Name{"t0"}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
