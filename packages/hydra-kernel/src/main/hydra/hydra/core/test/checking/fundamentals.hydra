## Fundamental type checking test cases: literals, variables, lambdas, applications, let terms, and primitives
module hydra.core.test.checking.fundamentals

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.model
import hydra.core.print.model
import hydra.core.scoping
import hydra.core.test.testGraph
import hydra.core.test.testTypes
import hydra.core.testing

term allTests =
  TestGroup{
    name = "Fundamentals",
    description = none,
    subgroups = [literalsTests, variablesTests, lambdasTests, applicationsTests, letTermsTests, primitivesTests],
    `cases` = []}

term applicationsTests =
  TestGroup{
    name = "Applications",
    description = none,
    subgroups = [
      simpleFunctionApplicationsTests,
      partialApplicationsTests,
      higherOrderApplicationsTests,
      polymorphicApplicationsTests,
      applicationsInComplexContextsTests,
      applicationsWithComplexArgumentsTests],
    `cases` = []}

term simpleFunctionApplicationsTests =
  TestGroup{
    name = "Simple function applications",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "identity application",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      application = Application{
                        function = Term{
                          lambda = Lambda{
                            parameter = Name{"x"},
                            domain = none,
                            body = Term{
                              variable = Name{"x"}}}},
                        argument = Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 42:int32}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      integer = IntegerType{
                        `int32`}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "primitive application",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.add"}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 10:int32}}}}},
                        argument = Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 20:int32}}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      integer = IntegerType{
                        `int32`}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "string concatenation",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.strings.concat2"}},
                            argument = Term{
                              literal = Literal{
                                `string` = "hello"}}}},
                        argument = Term{
                          literal = Literal{
                            `string` = "world"}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      `string`}}}},
        description = none,
        tags = [],
        provisions = []}]}

