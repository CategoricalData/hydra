## Test cases for hydra.core.lib.strings primitives
term allTests =
  TestGroup{
    name = "hydra.core.lib.strings primitives",
    description = none,
    subgroups = [
      TestGroup{
        name = "concat",
        description = none,
        subgroups = [
          TestGroup{
            name = "flattensPreservingOrderAndContent",
            description = none,
            subgroups = [],
            `cases` = [
              TestCaseWithMetadata{
                name = "basic concatenation",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
                          (strings.concat ["one", "two", "three"]),
                    expected = λ`_`.(λs.s) "onetwothree"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.strings.concat.flattensPreservingOrderAndContent"}]},
              TestCaseWithMetadata{
                name = "single string",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s) (strings.concat ["hello"]),
                    expected = λ`_`.(λs.s) "hello"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.strings.concat.flattensPreservingOrderAndContent"}]},
              TestCaseWithMetadata{
                name = "unicode strings",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
                          (strings.concat ["ñ", "世", "🌍"]),
                    expected = λ`_`.(λs.s) "ñ世🌍"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.strings.concat.flattensPreservingOrderAndContent"}]},
              TestCaseWithMetadata{
                name = "combining characters",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s) (strings.concat ["e", "́"]),
                    expected = λ`_`.(λs.s) "é"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.strings.concat.flattensPreservingOrderAndContent"}]},
              TestCaseWithMetadata{
                name = "control characters",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.(λs.s)
