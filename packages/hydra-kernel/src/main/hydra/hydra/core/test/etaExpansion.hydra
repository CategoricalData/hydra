## Test cases for eta expansion of terms
module hydra.core.test.etaExpansion

import hydra.core.lib.eithers as eithers
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.reduction
import hydra.core.test.testGraph
import hydra.core.test.testTypes
import hydra.core.testing

## Test cases for eta expansion of terms
term allTests =
  TestGroup{
    name = "eta expansion",
    description = none,
    subgroups = [
      TestGroup{
        name = "Partial application of primitives",
        description = none,
        subgroups = [
          TestGroup{
            name = "Bare primitives are not expanded",
            description = none,
            subgroups = [],
            `cases` = [
              TestCaseWithMetadata{
                name = "unary primitive",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.eithers.either
                          (λe.concat2 "ETA ERROR: " "failed")
                          (λresult.`term` result)
                          (etaExpandTypedTerm
                            testContext
                            testGraph
                            Term{
                              variable = Name{"hydra.core.lib.strings.toLower"}}),
                    expected = λ`_`.`term`
                          Term{
                            variable = Name{"hydra.core.lib.strings.toLower"}}}},
                description = none,
                tags = [],
                provisions = []},
              TestCaseWithMetadata{
                name = "binary primitive",
                case = TestCase{
                  universal = UniversalTestCase{
                    actual = λ`_`.eithers.either
                          (λe.concat2 "ETA ERROR: " "failed")
                          (λresult.`term` result)
                          (etaExpandTypedTerm
                            testContext
                            testGraph
                            Term{
                              variable = Name{"hydra.core.lib.strings.splitOn"}}),
                    expected = λ`_`.`term`
                          Term{
                            variable = Name{"hydra.core.lib.strings.splitOn"}}}},
                description = none,
                tags = [],
                provisions = []}]},
          TestGroup{
            name = "Partially applied primitives expand with lambdas",
            description = none,
            subgroups = [],
            `cases` = [
              TestCaseWithMetadata{
                name = "binary primitive with one argument",
