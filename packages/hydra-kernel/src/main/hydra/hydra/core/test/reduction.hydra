## Test cases for term reduction/evaluation mechanics
module hydra.core.test.reduction

import hydra.core.lib.eithers as eithers
import hydra.core.model
import hydra.core.print.model
import hydra.core.reduction
import hydra.core.test.testGraph
import hydra.core.testing

## Test cases for term reduction mechanics
term allTests =
  TestGroup{
    name = "reduction",
    description = none,
    subgroups = [
      TestGroup{
        name = "beta reduction",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "identity function applied to literal",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."<<eval error>>")
                      (λt.`term` t)
                      (reduceTerm
                        testContext
                        testGraph
                        true
                        Term{
                          application = Application{
                            function = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  variable = Name{"x"}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 42:int32}}}}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = 42:int32}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "constant function",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."<<eval error>>")
                      (λt.`term` t)
                      (reduceTerm
                        testContext
                        testGraph
                        true
                        Term{
                          application = Application{
                            function = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 1:int32}}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 42:int32}}}}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = 1:int32}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "nested application",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."<<eval error>>")
                      (λt.`term` t)
                      (reduceTerm
                        testContext
                        testGraph
                        true
                        Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{
                                      lambda = Lambda{
                                        parameter = Name{"y"},
                                        domain = none,
                                        body = Term{
                                          variable = Name{"x"}}}}}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 1:int32}}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 2:int32}}}}}),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = 1:int32}}}}},
            description = none,
            tags = [],
            provisions = []}]},
