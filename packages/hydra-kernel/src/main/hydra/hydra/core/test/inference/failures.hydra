                              variable = Name{"x"}}}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."FAIL")
                      (λresult.concat2
                          "unexpected: "
                          (typeScheme (second (first result))))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{name = Name{"x"}, `term` = Term{variable = Name{"y"}}, typeScheme = none},
                              Binding{
                                name = Name{"z"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"x"}}}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."FAIL")
                      (λresult.concat2
                          "unexpected: "
                          (typeScheme (second (first result))))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none},
                              Binding{name = Name{"y"}, `term` = Term{variable = Name{"z"}}, typeScheme = none}],
                            body = Term{
                              pair = (Term{variable = Name{"x"}}, Term{variable = Name{"y"}})}}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Shadowing scope errors",
