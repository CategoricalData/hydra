                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `let` = Let{
                                bindings = [Binding{name = Name{"y"}, `term` = Term{variable = Name{"x"}}, typeScheme = none}],
                                body = Term{
                                  variable = Name{"z"}}}}}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
