                        testContext
                        testGraph
                        Term{
                          `list` = [Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}, Term{literal = Literal{`string` = "foo"}}]}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."FAIL")
                      (λresult.concat2
                          "unexpected: "
                          (typeScheme (second (first result))))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `list` = [
                            Term{`list` = [Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}]},
                            Term{literal = Literal{`string` = "foo"}}]}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#4",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
