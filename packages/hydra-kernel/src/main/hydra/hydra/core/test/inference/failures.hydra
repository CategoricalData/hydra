## Inference tests for expected failures
module hydra.core.test.inference.failures

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.test.testGraph
import hydra.core.testing

## Expected failure tests
term allTests =
  TestGroup{
    name = "Expected failures",
    description = none,
    subgroups = [
      undefinedVariableTests,
      unificationFailureTests,
      invalidApplicationTests,
      selfApplicationTests,
      arityMismatchTests,
      recursiveTypeTests,
      occurCheckTests,
      typeConstructorMisuseTests,
      polymorphismViolationTests,
      letBindingMismatchTests,
      constraintSolverEdgeCaseTests,
      primitiveTypeErrorTests,
      complexConstraintFailureTests],
    `cases` = []}

term undefinedVariableTests =
  TestGroup{
    name = "Undefined variable",
    description = none,
    subgroups = [
      TestGroup{
        name = "Basic unbound variables",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."FAIL")
                      (λresult.concat2
                          "unexpected: "
                          (typeScheme (second (first result))))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{variable = Name{"x"}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."FAIL")
                      (λresult.concat2
                          "unexpected: "
                          (typeScheme (second (first result))))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"x"},
                            domain = none,
                            body = Term{
                              variable = Name{"y"}}}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."FAIL")
                      (λresult.concat2
                          "unexpected: "
                          (typeScheme (second (first result))))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"y"}}}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Unbound in let expressions",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
