    `cases` = []}

term unificationFailureTests =
  TestGroup{
    name = "Unification failure",
    description = none,
    subgroups = [
      TestGroup{
        name = "Basic type mismatches",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe."FAIL")
                      (λresult.concat2
                          "unexpected: "
                          (typeScheme (second (first result))))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.math.add"}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 42:int32}}}}},
                            argument = Term{
                              literal = Literal{
                                `string` = "foo"}}}}),
                expected = λ`_`."FAIL"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
