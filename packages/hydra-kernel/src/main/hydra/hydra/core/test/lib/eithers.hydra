## Test cases for hydra.core.lib.eithers primitives
term allTests =
  TestGroup{
    name = "hydra.core.lib.eithers primitives",
    description = none,
    subgroups = [
      TestGroup{
        name = "chainsOnRightShortCircuitsOnLeft",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "bind Right with success",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λe.model.either
                        (λn.printInt32 n)
                        (λn.printInt32 n)
                        e)
                      (eithers.bind
                        right("ab")
                        (λs.ifElse
                            (isEmpty s)
                            left(0:int32)
                            right(length s))),
                expected = λ`_`.(λe.model.either
                        (λn.printInt32 n)
                        (λn.printInt32 n)
                        e)
                      right(2:int32)}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.eithers.bind.chainsOnRightShortCircuitsOnLeft"}]},
          TestCaseWithMetadata{
            name = "bind Right with failure",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λe.model.either
                        (λn.printInt32 n)
                        (λn.printInt32 n)
                        e)
                      (eithers.bind
                        right("")
                        (λs.ifElse
                            (isEmpty s)
                            left(0:int32)
                            right(length s))),
                expected = λ`_`.(λe.model.either
                        (λn.printInt32 n)
                        (λn.printInt32 n)
                        e)
                      left(0:int32)}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.eithers.bind.chainsOnRightShortCircuitsOnLeft"}]},
          TestCaseWithMetadata{
            name = "bind Left returns Left unchanged",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λe.model.either
                        (λn.printInt32 n)
                        (λn.printInt32 n)
                        e)
                      (eithers.bind
                        left(42:int32)
                        (λs.ifElse
                            (isEmpty s)
                            left(0:int32)
                            right(length s))),
                expected = λ`_`.(λe.model.either
                        (λn.printInt32 n)
                        (λn.printInt32 n)
                        e)
                      left(42:int32)}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.eithers.bind.chainsOnRightShortCircuitsOnLeft"}]}]},
