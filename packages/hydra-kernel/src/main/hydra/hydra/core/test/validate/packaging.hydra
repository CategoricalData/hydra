                              lifecycle = none,
                              provisions = []}),
                          dependencies = [],
                          definitions = []}]})
                  "valid"
                  (λe.invalidPackageError e),
            expected = λ`_`.match
                  given(InvalidPackageError{
                    conflictingModuleName = ConflictingModuleNameError{
                      first = ModuleName{"hydra.fooBar"},
                      second = ModuleName{"hydra.foobar"}}})
                  "valid"
                  (λe.invalidPackageError e)}},
        description = none,
        tags = [],
        provisions = []}]}

