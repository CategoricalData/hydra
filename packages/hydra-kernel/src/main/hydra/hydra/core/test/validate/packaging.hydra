term checkModulePartitionTests =
  TestGroup{
    name = "checkModulePartition",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "empty universe: no error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        (checkModulePartition [])))
                    "]"),
            expected = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        []))
                    "]")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "single package, distinct namespaces: no error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        (checkModulePartition
                          [("hydra-kernel", [ModuleName{"hydra.foo"}, ModuleName{"hydra.bar"}])])))
                    "]"),
            expected = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        []))
                    "]")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "two packages, distinct namespaces: no error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        (checkModulePartition
                          [("hydra-kernel", [ModuleName{"hydra.foo"}]), ("hydra-java", [ModuleName{"hydra.java.coder"}])])))
                    "]"),
            expected = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        []))
                    "]")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "same package repeats a namespace: not this check's concern, no error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        (checkModulePartition
                          [("hydra-kernel", [ModuleName{"hydra.foo"}, ModuleName{"hydra.foo"}])])))
                    "]"),
            expected = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        []))
                    "]")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "two packages declare the same namespace: error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        (checkModulePartition
                          [("hydra-kernel", [ModuleName{"hydra.foo"}]), ("hydra-java", [ModuleName{"hydra.foo"}])])))
                    "]"),
            expected = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        [
                          InvalidPackageError{
                            moduleInMultiplePackages = ModuleInMultiplePackagesError{
                              moduleName = ModuleName{"hydra.foo"},
                              firstPackage = PackageName{"hydra-kernel"},
                              secondPackage = PackageName{"hydra-java"}}}]))
                    "]")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "three packages, one namespace collides between the first two: single finding",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        (checkModulePartition
                          [
                            ("hydra-kernel", [ModuleName{"hydra.foo"}]),
                            ("hydra-java", [ModuleName{"hydra.foo"}]),
                            ("hydra-python", [ModuleName{"hydra.bar"}])])))
                    "]"),
            expected = λ`_`.strings.concat2
                  "["
                  (strings.concat2
                    (strings.join
                      ";"
                      (lists.map
                        (λe.invalidPackageError e)
                        [
                          InvalidPackageError{
                            moduleInMultiplePackages = ModuleInMultiplePackagesError{
                              moduleName = ModuleName{"hydra.foo"},
                              firstPackage = PackageName{"hydra-kernel"},
                              secondPackage = PackageName{"hydra-java"}}}]))
                    "]")}},
        description = none,
        tags = [],
        provisions = []}]}

