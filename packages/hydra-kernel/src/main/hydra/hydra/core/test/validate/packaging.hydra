term kernelModuleTests =
  TestGroup{
    name = "kernelModule (orchestrator)",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "valid module: no error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (kernelModule
                    Module{
                      name = ModuleName{"hydra.foo"},
                      metadata = given(EntityMetadata{
                          description = given("Test module hydra.foo"),
                          comments = [],
                          seeAlso = [],
                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      definitions = [
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.bar"},
                            metadata = none,
                            signature = none,
                            body = Term{
                              annotated = AnnotatedTerm{
                                body = Term{
                                  literal = Literal{
                                    `string` = "value"}},
                                annotation = wrapAnnotationMap
                                    (maps.fromList
                                      [(Name{"description"}, Term{literal = Literal{`string` = "test description"}})])}}}}]})
                  "valid"
                  (λe.invalidModuleError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidModuleError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "missing documentation surfaces",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (kernelModule
                    Module{
                      name = ModuleName{"hydra.foo"},
                      metadata = given(EntityMetadata{
                          description = given("Test module hydra.foo"),
                          comments = [],
                          seeAlso = [],
                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      definitions = [
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.bar"},
                            metadata = none,
                            signature = none,
                            body = Term{literal = Literal{`string` = "value"}}}}]})
                  "valid"
                  (λe.invalidModuleError e),
            expected = λ`_`.match
                  given(InvalidModuleError{
                    missingDocumentation = MissingDocumentationError{
                      moduleName = ModuleName{"hydra.foo"},
                      name = Name{"hydra.foo.bar"}}})
                  "valid"
                  (λe.invalidModuleError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "out-of-order definitions surface",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (kernelModule
                    Module{
                      name = ModuleName{"hydra.foo"},
                      metadata = given(EntityMetadata{
                          description = given("Test module hydra.foo"),
                          comments = [],
                          seeAlso = [],
                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      definitions = [
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.bbb"},
                            metadata = none,
                            signature = none,
                            body = Term{
                              annotated = AnnotatedTerm{
                                body = Term{
                                  literal = Literal{
                                    `string` = "value"}},
                                annotation = wrapAnnotationMap
                                    (maps.fromList
                                      [(Name{"description"}, Term{literal = Literal{`string` = "test description"}})])}}}},
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.aaa"},
                            metadata = none,
                            signature = none,
                            body = Term{
                              annotated = AnnotatedTerm{
                                body = Term{
                                  literal = Literal{
                                    `string` = "value"}},
                                annotation = wrapAnnotationMap
                                    (maps.fromList
                                      [(Name{"description"}, Term{literal = Literal{`string` = "test description"}})])}}}}]})
                  "valid"
                  (λe.invalidModuleError e),
            expected = λ`_`.match
                  given(InvalidModuleError{
                    definitionsOutOfOrder = DefinitionsOutOfOrderError{
                      moduleName = ModuleName{"hydra.foo"},
                      precedingName = Name{"hydra.foo.bbb"},
                      followingName = Name{"hydra.foo.aaa"}}})
                  "valid"
