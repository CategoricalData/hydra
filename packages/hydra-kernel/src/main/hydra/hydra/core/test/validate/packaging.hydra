term checkDuplicateDefinitionNamesTests =
  TestGroup{
    name = "checkDuplicateDefinitionNames",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "empty module: no error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (checkDuplicateDefinitionNames
                    Module{
                      name = ModuleName{"hydra.foo"},
                      metadata = given(EntityMetadata{
                          description = given("Test module hydra.foo"),
                          comments = [],
                          seeAlso = [],
                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      definitions = []})
                  "valid"
                  (λe.invalidModuleError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidModuleError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "distinct names: no error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (checkDuplicateDefinitionNames
                    Module{
                      name = ModuleName{"hydra.foo"},
                      metadata = given(EntityMetadata{
                          description = given("Test module hydra.foo"),
                          comments = [],
                          seeAlso = [],
                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      definitions = [
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.aaa"},
                            metadata = none,
                            signature = none,
                            body = Term{
                              annotated = AnnotatedTerm{
                                body = Term{
                                  literal = Literal{
                                    `string` = "value"}},
                                annotation = wrapAnnotationMap
                                    (maps.fromList
                                      [(Name{"description"}, Term{literal = Literal{`string` = "test description"}})])}}}},
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.bbb"},
                            metadata = none,
                            signature = none,
                            body = Term{
                              annotated = AnnotatedTerm{
                                body = Term{
                                  literal = Literal{
                                    `string` = "value"}},
                                annotation = wrapAnnotationMap
                                    (maps.fromList
                                      [(Name{"description"}, Term{literal = Literal{`string` = "test description"}})])}}}}]})
                  "valid"
                  (λe.invalidModuleError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidModuleError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "duplicate names: error",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (checkDuplicateDefinitionNames
                    Module{
                      name = ModuleName{"hydra.foo"},
                      metadata = given(EntityMetadata{
                          description = given("Test module hydra.foo"),
                          comments = [],
                          seeAlso = [],
                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      definitions = [
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.aaa"},
                            metadata = none,
                            signature = none,
                            body = Term{
                              annotated = AnnotatedTerm{
                                body = Term{
                                  literal = Literal{
                                    `string` = "value"}},
                                annotation = wrapAnnotationMap
                                    (maps.fromList
                                      [(Name{"description"}, Term{literal = Literal{`string` = "test description"}})])}}}},
                        Definition{
                          `term` = TermDefinition{
                            name = Name{"hydra.foo.aaa"},
                            metadata = none,
                            signature = none,
                            body = Term{
                              annotated = AnnotatedTerm{
                                body = Term{
                                  literal = Literal{
                                    `string` = "value"}},
                                annotation = wrapAnnotationMap
                                    (maps.fromList
                                      [(Name{"description"}, Term{literal = Literal{`string` = "test description"}})])}}}}]})
                  "valid"
                  (λe.invalidModuleError e),
            expected = λ`_`.match
                  given(InvalidModuleError{
                    duplicateDefinitionName = DuplicateDefinitionNameError{
                      moduleName = ModuleName{"hydra.foo"},
                      name = Name{"hydra.foo.aaa"}}})
                  "valid"
                  (λe.invalidModuleError e)}},
        description = none,
        tags = [],
        provisions = []}]}

