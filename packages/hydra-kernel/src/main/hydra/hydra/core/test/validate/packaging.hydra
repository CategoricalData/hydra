                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      modules = [
                        Module{
                          name = ModuleName{"hydra.foo"},
                          metadata = given(EntityMetadata{
                              description = given("Test module hydra.foo"),
                              comments = [],
                              seeAlso = [],
                              lifecycle = none,
                              provisions = []}),
                          dependencies = [],
                          definitions = []},
                        Module{
                          name = ModuleName{"hydra.bar"},
                          metadata = given(EntityMetadata{
                              description = given("Test module hydra.bar"),
                              comments = [],
                              seeAlso = [],
                              lifecycle = none,
                              provisions = []}),
                          dependencies = [],
                          definitions = []}]})
                  "valid"
                  (λe.invalidPackageError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidPackageError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "case-insensitive collision: hydra.fooBar vs hydra.foobar",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (checkConflictingModuleNames
                    Package{
                      name = PackageName{"test-pkg"},
                      metadata = given(EntityMetadata{
                          description = given("Test package test-pkg"),
                          comments = [],
                          seeAlso = [],
                          lifecycle = none,
                          provisions = []}),
                      dependencies = [],
                      modules = [
                        Module{
                          name = ModuleName{"hydra.fooBar"},
