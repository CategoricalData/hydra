## Test cases for hydra.core.lib.optionals primitives
module hydra.core.test.lib.optionals

import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering
import hydra.core.model
import hydra.core.print.model
import hydra.core.testing

## Test cases for hydra.core.lib.optionals primitives
term allTests =
  TestGroup{
    name = "hydra.core.lib.optionals primitives",
    description = none,
    subgroups = [
      TestGroup{
        name = "appliesFunctionWhenBothGiven",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "both given",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.apply
                        given(λx.add 3:int32 x)
                        given(5:int32)),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      given(8:int32)}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.apply.appliesFunctionWhenBothGiven"}]},
          TestCaseWithMetadata{
            name = "none function",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.apply none given(5:int32)),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      none}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.apply.appliesFunctionWhenBothGiven"}]},
          TestCaseWithMetadata{
            name = "none value",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.apply
                        given(λx.add 3:int32 x)
                        none),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      none}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.apply.appliesFunctionWhenBothGiven"}]}]},
      TestGroup{
        name = "chainsOnGivenPropagatesNone",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "given to given",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.bind
                        given(5:int32)
                        (λx.given(mul x 2:int32))),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      given(10:int32)}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.bind.chainsOnGivenPropagatesNone"}]},
          TestCaseWithMetadata{
            name = "none to none",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.bind
                        none
                        (λx.given(mul x 2:int32))),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      none}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.bind.chainsOnGivenPropagatesNone"}]}]},
      TestGroup{
        name = "kleisliComposesShortCircuitingOnNone",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "both succeed",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.compose
                        (λx.ifElse
                            (lte x 5:int32)
                            given(add x 1:int32)
                            none)
                        (λy.ifElse
                            (gte y 5:int32)
                            given(mul y 2:int32)
                            none)
                        5:int32),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      given(12:int32)}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.compose.kleisliComposesShortCircuitingOnNone"}]},
          TestCaseWithMetadata{
            name = "first fails",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.compose
                        (λx.ifElse
                            (lte x 5:int32)
                            given(add x 1:int32)
                            none)
                        (λy.ifElse
                            (gte y 5:int32)
                            given(mul y 2:int32)
                            none)
                        10:int32),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      none}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.compose.kleisliComposesShortCircuitingOnNone"}]},
          TestCaseWithMetadata{
            name = "second fails",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      (optionals.compose
                        (λx.ifElse
                            (lte x 5:int32)
                            given(add x 1:int32)
                            none)
                        (λy.ifElse
                            (gte y 5:int32)
                            given(mul y 2:int32)
                            none)
                        3:int32),
                expected = λ`_`.(λmx.`optional` (λn.printInt32 n) mx)
                      none}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.compose.kleisliComposesShortCircuitingOnNone"}]}]},
      TestGroup{
        name = "wrapsValueAsPresent",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
