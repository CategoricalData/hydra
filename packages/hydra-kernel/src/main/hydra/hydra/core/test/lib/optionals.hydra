            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.givens.keepsPresentValuesPreservingOrder"}]},
          TestCaseWithMetadata{
            name = "all none",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λxs.`list` (λn.printInt32 n) xs)
                      (optionals.givens [none, none]),
                expected = λ`_`.(λxs.`list` (λn.printInt32 n) xs) []}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.optionals.givens.keepsPresentValuesPreservingOrder"}]},
          TestCaseWithMetadata{
            name = "empty list",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λxs.`list` (λn.printInt32 n) xs)
