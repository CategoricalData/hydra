    `cases` = []}

term testGroupForPrimitiveReferences =
  TestGroup{
    name = "Primitive references with constraints",
    description = none,
    subgroups = [
      TestGroup{
        name = "Map primitives (ordering on key type)",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          variable = Name{"hydra.core.lib.maps.fromList"}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              `list` = Type{
                                pair = PairType{
                                  first = Type{
                                    variable = Name{"t0"}},
                                  second = Type{
                                    variable = Name{"t1"}}}}},
                            codomain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  variable = Name{"t1"}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
