## Inference tests for type class constraints (ordering and equality)
module hydra.core.test.inference.classes

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.test.testGraph
import hydra.core.testing

## Type class constraint inference tests
term allTests =
  TestGroup{
    name = "Type classes",
    description = none,
    subgroups = [
      testGroupForMonomorphicConstraints,
      testGroupForPrimitiveReferences,
      testGroupForPartialApplication,
      testGroupForLetBindings,
      testGroupForComposition,
      testGroupForNestedContainers,
      testGroupForCollectionTerms],
    `cases` = []}

term testGroupForMonomorphicConstraints =
  TestGroup{
    name = "Monomorphic (constraints vanish)",
    description = none,
    subgroups = [
      TestGroup{
        name = "Map operations with concrete types",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.maps.fromList"}},
                            argument = Term{
                              `list` = [
                                Term{
                                  pair = (Term{literal = Literal{`string` = "a"}}, Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}})}]}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `map` = MapType{
                            keys = Type{
                              literal = LiteralType{
                                `string`}},
                            values = Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int32`}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.maps.lookup"}},
                                argument = Term{
                                  literal = Literal{
                                    `string` = "k"}}}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.maps.singleton"}},
                                    argument = Term{
                                      literal = Literal{
                                        `string` = "k"}}}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 42:int32}}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `optional` = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.maps.insert"}},
                                    argument = Term{
                                      literal = Literal{
                                        `string` = "k"}}}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 42:int32}}}}},
                            argument = Term{
                              variable = Name{"hydra.core.lib.maps.empty"}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `map` = MapType{
                            keys = Type{
                              literal = LiteralType{
                                `string`}},
                            values = Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int32`}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Set operations with concrete types",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.sets.fromList"}},
                            argument = Term{
                              `list` = [
                                Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                Term{literal = Literal{integer = IntegerValue{`int32` = 3:int32}}}]}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `set` = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.sets.member"}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 42:int32}}}}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.sets.singleton"}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 42:int32}}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          literal = LiteralType{
                            `boolean`}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Equality operations with concrete types",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.equality.equal"}},
                                argument = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 1:int32}}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 2:int32}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          literal = LiteralType{
                            `boolean`}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.ordering.compare"}},
                                argument = Term{
                                  literal = Literal{
                                    `string` = "a"}}}},
                            argument = Term{
                              literal = Literal{
                                `string` = "b"}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          variable = Name{"hydra.core.util.Comparison"}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "List operations with concrete types",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
