                        testContext
                        testGraph
                        Term{
                          variable = Name{"hydra.core.lib.maps.lookup"}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              function = FunctionType{
                                domain = Type{
                                  `map` = MapType{
                                    keys = Type{
                                      variable = Name{"t0"}},
                                    values = Type{
                                      variable = Name{"t1"}}}},
                                codomain = Type{
                                  `optional` = Type{
                                    variable = Name{"t1"}}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          variable = Name{"hydra.core.lib.maps.insert"}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              function = FunctionType{
                                domain = Type{
                                  variable = Name{"t1"}},
                                codomain = Type{
                                  function = FunctionType{
                                    domain = Type{
                                      `map` = MapType{
                                        keys = Type{
                                          variable = Name{"t0"}},
                                        values = Type{
                                          variable = Name{"t1"}}}},
                                    codomain = Type{
                                      `map` = MapType{
                                        keys = Type{
                                          variable = Name{"t0"}},
                                        values = Type{
                                          variable = Name{"t1"}}}}}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#4",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          variable = Name{"hydra.core.lib.maps.map"}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}, Name{"t2"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              function = FunctionType{
                                domain = Type{
                                  variable = Name{"t0"}},
                                codomain = Type{
                                  variable = Name{"t1"}}}},
                            codomain = Type{
                              function = FunctionType{
                                domain = Type{
                                  `map` = MapType{
                                    keys = Type{
                                      variable = Name{"t2"}},
                                    values = Type{
                                      variable = Name{"t0"}}}},
                                codomain = Type{
                                  `map` = MapType{
                                    keys = Type{
                                      variable = Name{"t2"}},
                                    values = Type{
                                      variable = Name{"t1"}}}}}}}},
                        constraints = {
                          Name{"t2"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#5",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          variable = Name{"hydra.core.lib.maps.empty"}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
