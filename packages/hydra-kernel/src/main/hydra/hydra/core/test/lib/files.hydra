                              (writeFile
                                FilePath{"/tmp/hydra-testing/cp-dir/inner.txt"}
                                "bmVzdGVk":binary)
                              (λ`_w`.effects.bind
                                  (copy
                                    true
                                    FilePath{"/tmp/hydra-testing/cp-dir"}
                                    FilePath{"/tmp/hydra-testing/cp-dir-2"})
                                  (λ`_c`.effects.map
                                      (λr.`either`
                                          (λ`_e`."ERR")
                                          (λb.`either`
                                              (λ`_e`."<decode error>")
                                              (λs.s)
                                              (decodeUtf8 b))
                                          r)
                                      (readFile
                                        FilePath{"/tmp/hydra-testing/cp-dir-2/inner.txt"})))),
                    expected = λ`_`."nested"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.files.copy.copiesDirectoryTreeWhenRecursive"}]},
              TestCaseWithMetadata{
                name = "copy with recursive=true into an already-existing destination directory succeeds",
                case = TestCase{
                  effectful = EffectfulTestCase{
                    actual = λ`_`.effects.bind
                          (createDirectory
                            false
                            FilePath{"/tmp/hydra-testing/cp-dir3"})
                          (λ`_d1`.effects.bind
                              (writeFile
                                FilePath{"/tmp/hydra-testing/cp-dir3/inner.txt"}
                                "YWdhaW4=":binary)
                              (λ`_w`.effects.bind
                                  (createDirectory
                                    false
                                    FilePath{"/tmp/hydra-testing/cp-dir3-dst"})
                                  (λ`_d2`.effects.bind
                                      (copy
                                        true
                                        FilePath{"/tmp/hydra-testing/cp-dir3"}
                                        FilePath{"/tmp/hydra-testing/cp-dir3-dst"})
                                      (λ`_c`.effects.map
                                          (λr.`either`
                                              (λ`_e`."ERR")
                                              (λb.`either`
                                                  (λ`_e`."<decode error>")
                                                  (λs.s)
                                                  (decodeUtf8 b))
                                              r)
                                          (readFile
                                            FilePath{"/tmp/hydra-testing/cp-dir3-dst/inner.txt"}))))),
                    expected = λ`_`."again"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.files.copy.copiesDirectoryTreeWhenRecursive"}]}]},
          TestGroup{
            name = "errorsOnNonRecursiveDirectory",
            description = none,
