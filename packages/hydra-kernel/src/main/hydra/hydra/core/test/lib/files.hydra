## Effectful test cases for hydra.core.lib.files primitives
term allTests =
  TestGroup{
    name = "hydra.core.lib.files primitives",
    description = none,
    subgroups = [
      TestGroup{
        name = "preservesExistingContentsAndAppends",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "appendFile after writeFile preserves existing contents",
            case = TestCase{
              effectful = EffectfulTestCase{
                actual = λ`_`.effects.bind
                      (writeFile
                        FilePath{"/tmp/hydra-testing/ap.txt"}
                        "QUI=":binary)
                      (λ`_w`.effects.bind
                          (appendFile
                            FilePath{"/tmp/hydra-testing/ap.txt"}
                            "Q0Q=":binary)
                          (λ`_a`.effects.map
                              (λr.`either`
                                  (λ`_e`."ERR")
                                  (λb.`either`
                                      (λ`_e`."<decode error>")
                                      (λs.s)
                                      (decodeUtf8 b))
                                  r)
                              (readFile
                                FilePath{"/tmp/hydra-testing/ap.txt"}))),
                expected = λ`_`."ABCD"}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.files.appendFile.preservesExistingContentsAndAppends"}]}]},
      TestGroup{
        name = "copy",
        description = none,
        subgroups = [
          TestGroup{
            name = "copiesSingleFile",
            description = none,
            subgroups = [],
            `cases` = [
              TestCaseWithMetadata{
                name = "copy duplicates a single file",
                case = TestCase{
                  effectful = EffectfulTestCase{
                    actual = λ`_`.effects.bind
                          (writeFile
