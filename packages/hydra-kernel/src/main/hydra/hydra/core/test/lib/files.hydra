                            "Y29waWVk":binary)
                          (λ`_w`.effects.bind
                              (copy
                                false
                                FilePath{"/tmp/hydra-testing/cp-src.txt"}
                                FilePath{"/tmp/hydra-testing/cp-dst.txt"})
                              (λ`_c`.effects.map
                                  (λr.`either`
                                      (λ`_e`."ERR")
                                      (λb.`either`
                                          (λ`_e`."<decode error>")
                                          (λs.s)
                                          (decodeUtf8 b))
                                      r)
                                  (readFile
                                    FilePath{"/tmp/hydra-testing/cp-dst.txt"}))),
                    expected = λ`_`."copied"}},
                description = none,
                tags = [],
                provisions = [Name{"hydra.core.lib.files.copy.copiesSingleFile"}]}]},
          TestGroup{
            name = "copiesDirectoryTreeWhenRecursive",
            description = none,
            subgroups = [],
            `cases` = [
              TestCaseWithMetadata{
                name = "copy with recursive=true duplicates a directory tree",
                case = TestCase{
                  effectful = EffectfulTestCase{
                    actual = λ`_`.effects.bind
