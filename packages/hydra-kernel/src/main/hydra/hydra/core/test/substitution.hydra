                                  `union` = [
                                    FieldType{name = Name{"nil"}, `type` = Type{`unit`}},
                                    FieldType{
                                      name = Name{"cons"},
                                      `type` = Type{
                                        pair = PairType{
                                          first = Type{
                                            function = FunctionType{
                                              domain = Type{
                                                literal = LiteralType{
                                                  integer = IntegerType{
                                                    `int32`}}},
                                              codomain = Type{
                                                literal = LiteralType{
                                                  integer = IntegerType{
                                                    `int32`}}}}},
                                          second = Type{variable = Name{"test.FunctionList"}}}}}]},
                                constraints = maps.empty})])
                        Type{`unit`}),
                expected = λ`_`."true"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "void",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printBoolean
                      (isComparableType
                        (maps.fromList
                          [
                            (
                              Name{"test.Point"},
                              TypeScheme{
                                variables = [],
                                body = Type{
                                  `record` = [
                                    FieldType{name = Name{"x"}, `type` = Type{literal = LiteralType{integer = IntegerType{`int32`}}}},
                                    FieldType{name = Name{"y"}, `type` = Type{literal = LiteralType{integer = IntegerType{`int32`}}}}]},
                                constraints = maps.empty}),
                            (
                              Name{"test.WithFunction"},
                              TypeScheme{
                                variables = [],
                                body = Type{
                                  `record` = [
                                    FieldType{
                                      name = Name{"f"},
                                      `type` = Type{
                                        function = FunctionType{
                                          domain = Type{literal = LiteralType{integer = IntegerType{`int32`}}},
                                          codomain = Type{
                                            literal = LiteralType{
                                              integer = IntegerType{
                                                `int32`}}}}}}]},
                                constraints = maps.empty}),
                            (
                              Name{"test.Box"},
                              TypeScheme{variables = [Name{"a"}], body = Type{`wrap` = Type{variable = Name{"a"}}}, constraints = maps.empty}),
                            (
                              Name{"test.Tagged"},
                              TypeScheme{
                                variables = [Name{"a"}],
                                body = Type{`wrap` = Type{literal = LiteralType{`string`}}},
                                constraints = maps.empty}),
                            (
                              Name{"test.IntList"},
                              TypeScheme{
                                variables = [],
                                body = Type{
                                  `union` = [
                                    FieldType{name = Name{"nil"}, `type` = Type{`unit`}},
                                    FieldType{
                                      name = Name{"cons"},
                                      `type` = Type{
                                        pair = PairType{
                                          first = Type{literal = LiteralType{integer = IntegerType{`int32`}}},
                                          second = Type{variable = Name{"test.IntList"}}}}}]},
                                constraints = maps.empty}),
                            (
                              Name{"test.FunctionList"},
                              TypeScheme{
                                variables = [],
                                body = Type{
                                  `union` = [
                                    FieldType{name = Name{"nil"}, `type` = Type{`unit`}},
                                    FieldType{
                                      name = Name{"cons"},
                                      `type` = Type{
                                        pair = PairType{
                                          first = Type{
                                            function = FunctionType{
                                              domain = Type{
                                                literal = LiteralType{
                                                  integer = IntegerType{
                                                    `int32`}}},
                                              codomain = Type{
                                                literal = LiteralType{
                                                  integer = IntegerType{
                                                    `int32`}}}}},
                                          second = Type{variable = Name{"test.FunctionList"}}}}}]},
                                constraints = maps.empty})])
                        Type{`void`}),
                expected = λ`_`."true"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "function",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printBoolean
                      (isComparableType
                        (maps.fromList
                          [
                            (
                              Name{"test.Point"},
                              TypeScheme{
                                variables = [],
