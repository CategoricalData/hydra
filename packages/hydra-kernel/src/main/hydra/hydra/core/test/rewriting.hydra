                              TraversalOrder{post}
                              (λacc,`term`.lists.concat
                                  [acc, cases(Term){`list`=λelems.[lists.length elems], `_`=[]} `term`])
                              []
                              Term{
                                `list` = [
                                  Term{`list` = [Term{literal = Literal{`string` = "foo"}}, Term{literal = Literal{`string` = "bar"}}]},
                                  Term{
                                    application = Application{
                                      function = Term{
                                        lambda = Lambda{
                                          parameter = Name{"x"},
                                          domain = none,
                                          body = Term{variable = Name{"x"}}}},
                                      argument = Term{`list` = [Term{literal = Literal{`string` = "quux"}}]}}}]})},
                expected = λ`_`.model.term
                      Term{
                        `list` = [
                          Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                          Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                          Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}]}}},
            description = none,
            tags = [],
            provisions = []}]},
