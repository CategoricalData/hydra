## Test cases for core rewrite/fold combinators
module hydra.core.test.rewriting

import hydra.core.coders
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps
import hydra.core.lib.math
import hydra.core.lib.pairs
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.print.model as model
import hydra.core.rewriting
import hydra.core.testing

## Test cases for core rewrite/fold combinators
term allTests =
  TestGroup{
    name = "rewriting",
    description = none,
    subgroups = [
      TestGroup{
        name = "foldOverTerm",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "collect labels from single node - pre-order",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.model.term
                      Term{
                        `list` = lists.map
                            (λlit.Term{
                                literal = lit})
                            (foldOverTerm
                              TraversalOrder{pre}
                              (λacc,`term`.lists.concat
                                  [acc, cases(Term){pair=λp.cases(Term){literal=λlit.[lit], `_`=[]} (first p), `_`=[]} `term`])
                              []
                              Term{
                                pair = (Term{literal = Literal{`string` = "a"}}, Term{`list` = []})})},
                expected = λ`_`.model.term
                      Term{
                        `list` = [Term{literal = Literal{`string` = "a"}}]}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "collect labels from tree - pre-order",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.model.term
                      Term{
                        `list` = lists.map
                            (λlit.Term{
                                literal = lit})
                            (foldOverTerm
                              TraversalOrder{pre}
                              (λacc,`term`.lists.concat
                                  [acc, cases(Term){pair=λp.cases(Term){literal=λlit.[lit], `_`=[]} (first p), `_`=[]} `term`])
                              []
                              Term{
                                pair = (
                                    Term{literal = Literal{`string` = "a"}},
                                    Term{
                                      `list` = [
                                        Term{pair = (Term{literal = Literal{`string` = "b"}}, Term{`list` = []})},
                                        Term{
                                          pair = (
                                              Term{literal = Literal{`string` = "c"}},
                                              Term{`list` = [Term{pair = (Term{literal = Literal{`string` = "d"}}, Term{`list` = []})}]})}]})})},
                expected = λ`_`.model.term
                      Term{
                        `list` = [
                          Term{literal = Literal{`string` = "a"}},
                          Term{literal = Literal{`string` = "b"}},
                          Term{literal = Literal{`string` = "c"}},
                          Term{literal = Literal{`string` = "d"}}]}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "collect labels from single node - post-order",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.model.term
                      Term{
                        `list` = lists.map
                            (λlit.Term{
                                literal = lit})
                            (foldOverTerm
                              TraversalOrder{post}
                              (λacc,`term`.lists.concat
                                  [acc, cases(Term){pair=λp.cases(Term){literal=λlit.[lit], `_`=[]} (first p), `_`=[]} `term`])
                              []
                              Term{
                                pair = (Term{literal = Literal{`string` = "a"}}, Term{`list` = []})})},
                expected = λ`_`.model.term
                      Term{
                        `list` = [Term{literal = Literal{`string` = "a"}}]}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "collect labels from tree - post-order",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.model.term
                      Term{
                        `list` = lists.map
                            (λlit.Term{
                                literal = lit})
                            (foldOverTerm
                              TraversalOrder{post}
                              (λacc,`term`.lists.concat
                                  [acc, cases(Term){pair=λp.cases(Term){literal=λlit.[lit], `_`=[]} (first p), `_`=[]} `term`])
                              []
                              Term{
                                pair = (
                                    Term{literal = Literal{`string` = "a"}},
                                    Term{
                                      `list` = [
                                        Term{pair = (Term{literal = Literal{`string` = "b"}}, Term{`list` = []})},
                                        Term{
                                          pair = (
                                              Term{literal = Literal{`string` = "c"}},
                                              Term{`list` = [Term{pair = (Term{literal = Literal{`string` = "d"}}, Term{`list` = []})}]})}]})})},
                expected = λ`_`.model.term
                      Term{
                        `list` = [
                          Term{literal = Literal{`string` = "b"}},
                          Term{literal = Literal{`string` = "d"}},
                          Term{literal = Literal{`string` = "c"}},
                          Term{literal = Literal{`string` = "a"}}]}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "sum int32 literals",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.model.term
                      Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = foldOverTerm
                                TraversalOrder{
                                  pre}
                                (λacc,`term`.add
                                    acc
                                    (cases(Term){
                                      literal=λlit.cases(Literal){
                                            integer=λintVal.cases(IntegerValue){
                                                  `int32`=λn.n,
                                                  `_`=0:int32}
                                                  intVal,
                                            `_`=0:int32}
                                            lit,
                                      `_`=0:int32}
                                      `term`))
                                0:int32
                                Term{
                                  `list` = [
                                    Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                    Term{
                                      application = Application{
                                        function = Term{
                                          lambda = Lambda{
                                            parameter = Name{"x"},
                                            domain = none,
                                            body = Term{variable = Name{"x"}}}},
                                        argument = Term{literal = Literal{integer = IntegerValue{`int32` = 10:int32}}}}}]}}}},
                expected = λ`_`.model.term
                      Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = 52:int32}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "collect list lengths - pre-order",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.model.term
                      Term{
                        `list` = lists.map
                            (λn.Term{
                                literal = Literal{
                                  integer = IntegerValue{
                                    `int32` = n}}})
                            (foldOverTerm
                              TraversalOrder{pre}
                              (λacc,`term`.lists.concat
                                  [acc, cases(Term){`list`=λelems.[lists.length elems], `_`=[]} `term`])
                              []
                              Term{
                                `list` = [
                                  Term{`list` = [Term{literal = Literal{`string` = "foo"}}, Term{literal = Literal{`string` = "bar"}}]},
                                  Term{
                                    application = Application{
                                      function = Term{
                                        lambda = Lambda{
