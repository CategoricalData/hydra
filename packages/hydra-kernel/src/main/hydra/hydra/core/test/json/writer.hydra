            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "decimal",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{number = 3.14},
                expected = λ`_`."3.14"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "negative decimal",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{number = -2.5},
                expected = λ`_`."-2.5"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "hundredth",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{number = 0.01},
                expected = λ`_`."0.01"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "small decimal",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{number = 0.001},
                expected = λ`_`."0.001"}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "decimal precision",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "tiny exponent",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{number = 1.0e-20},
                expected = λ`_`."1.0e-20"}},
            description = none,
            tags = [Tag{"scaleDistinct"}],
            provisions = []},
          TestCaseWithMetadata{
            name = "huge exponent",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson
