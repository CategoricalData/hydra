## Test cases for JSON serialization
module hydra.core.test.json.writer

import hydra.core.json.model
import hydra.core.json.writer
import hydra.core.testing

## Test cases for JSON serialization (writer)
term allTests =
  TestGroup{
    name = "JSON serialization",
    description = none,
    subgroups = [
      TestGroup{
        name = "primitives",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "null",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{null},
                expected = λ`_`."null"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "true",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{`boolean` = true},
