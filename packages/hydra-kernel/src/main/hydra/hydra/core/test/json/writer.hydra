                        number = 100000000000000000000},
                expected = λ`_`."100000000000000000000"}},
            description = none,
            tags = [Tag{"scaleDistinct"}],
            provisions = []}]},
      TestGroup{
        name = "strings",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "empty string",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{`string` = ""},
                expected = λ`_`."\"\""}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "simple string",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson Value{`string` = "hello"},
                expected = λ`_`."\"hello\""}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "string with spaces",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson
                      Value{`string` = "hello world"},
                expected = λ`_`."\"hello world\""}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "string with double quote",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.printJson
