## Collection type checking test cases: lists, sets, maps
module hydra.core.test.checking.collections

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.model
import hydra.core.print.model
import hydra.core.scoping
import hydra.core.test.testGraph
import hydra.core.test.testTypes
import hydra.core.testing

term allTests =
  TestGroup{name = "Collections", description = none, subgroups = [listsTests, setsTests, mapsTests], `cases` = []}

term listsTests =
  TestGroup{
    name = "Lists",
    description = none,
    subgroups = [listsOfLiteralsTests, emptyListsTests, polymorphicListsTests, nestedListsTests, listsInComplexContextsTests],
    `cases` = []}

term listsOfLiteralsTests =
  TestGroup{
    name = "Lists of literals",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "int list",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `list` = [
                        Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                        Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}]}),
            expected = λ`_`.`type`
                  Type{
                    `list` = Type{
                      literal = LiteralType{
                        integer = IntegerType{
                          `int32`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "string list",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `list` = [Term{literal = Literal{`string` = "hello"}}, Term{literal = Literal{`string` = "world"}}]}),
            expected = λ`_`.`type`
                  Type{
                    `list` = Type{
                      literal = LiteralType{
                        `string`}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "single element list",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `list` = [Term{literal = Literal{integer = IntegerValue{`bigint` = 42:bigint}}}]}),
            expected = λ`_`.`type`
                  Type{
                    `list` = Type{
                      literal = LiteralType{
                        integer = IntegerType{
                          `bigint`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "mixed numeric types",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `list` = [
                        Term{literal = Literal{float = FloatValue{`float32` = 1.0:float32}}},
                        Term{literal = Literal{float = FloatValue{`float32` = 2.5:float32}}},
                        Term{literal = Literal{float = FloatValue{`float32` = 3.14:float32}}}]}),
            expected = λ`_`.`type`
                  Type{
                    `list` = Type{
                      literal = LiteralType{
                        float = FloatType{
                          `float32`}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term emptyListsTests =
  TestGroup{
    name = "Empty lists",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "empty list",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{`list` = []}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `list` = Type{
                          variable = Name{"t0"}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "pair of empty lists",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      pair = (Term{`list` = []}, Term{`list` = []})}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"t1"},
                          body = Type{
                            pair = PairType{
                              first = Type{
                                `list` = Type{
                                  variable = Name{"t0"}}},
                              second = Type{
                                `list` = Type{
                                  variable = Name{"t1"}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "empty list in tuple",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      pair = (Term{`list` = []}, Term{literal = Literal{`string` = "context"}})}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        pair = PairType{
                          first = Type{
                            `list` = Type{
                              variable = Name{"t0"}}},
                          second = Type{
                            literal = LiteralType{
                              `string`}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term polymorphicListsTests =
  TestGroup{
    name = "Polymorphic lists",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "list from lambda",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          `list` = [Term{variable = Name{"x"}}]}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            `list` = Type{
                              variable = Name{"t0"}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "list with repeated var",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          `list` = [Term{variable = Name{"x"}}, Term{variable = Name{"x"}}]}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            `list` = Type{
                              variable = Name{"t0"}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "list from two lambdas",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          lambda = Lambda{
                            parameter = Name{"y"},
                            domain = none,
                            body = Term{
                              `list` = [Term{variable = Name{"x"}}, Term{variable = Name{"y"}}]}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            function = FunctionType{
                              domain = Type{
                                variable = Name{"t0"}},
                              codomain = Type{
                                `list` = Type{
                                  variable = Name{"t0"}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

