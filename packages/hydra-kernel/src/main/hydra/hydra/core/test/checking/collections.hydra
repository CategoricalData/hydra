                              keys = Type{
                                variable = Name{"t0"}},
                              values = Type{
                                variable = Name{"t0"}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term mapsInComplexContextsTests =
  TestGroup{
    name = "Maps in complex contexts",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "map in tuple",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      pair = (
                          Term{
                            `map` = {
                              Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}}=Term{literal = Literal{`string` = "one"}}}},
                          Term{literal = Literal{`string` = "context"}})}),
            expected = λ`_`.`type`
                  Type{
                    pair = PairType{
                      first = Type{
                        `map` = MapType{
                          keys = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}},
                          values = Type{
                            literal = LiteralType{
                              `string`}}}},
                      second = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "nested maps",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `map` = {
                        Term{literal = Literal{`string` = "outer"}}=Term{
                          `map` = {
                            Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}}=Term{literal = Literal{`boolean` = true}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `map` = MapType{
                      keys = Type{
                        literal = LiteralType{
                          `string`}},
                      values = Type{
                        `map` = MapType{
                          keys = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}},
                          values = Type{
                            literal = LiteralType{
                              `boolean`}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "map in let binding",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"lookup"},
                            `term` = Term{
                              `map` = {
                                Term{literal = Literal{`string` = "key1"}}=Term{literal = Literal{integer = IntegerValue{`int32` = 100:int32}}},
                                Term{literal = Literal{`string` = "key2"}}=Term{literal = Literal{integer = IntegerValue{`int32` = 200:int32}}}}},
                            typeScheme = none}],
                        body = Term{
                          variable = Name{"lookup"}}}}),
            expected = λ`_`.`type`
                  Type{
                    `map` = MapType{
                      keys = Type{
                        literal = LiteralType{
                          `string`}},
                      values = Type{
                        literal = LiteralType{
                          integer = IntegerType{
