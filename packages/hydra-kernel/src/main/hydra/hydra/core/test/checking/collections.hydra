term mapsTests =
  TestGroup{
    name = "Maps",
    description = none,
    subgroups = [monomorphicMapsTests, polymorphicMapsTests, mapsInComplexContextsTests, mapsWithComplexTypesTests],
    `cases` = []}

term monomorphicMapsTests =
  TestGroup{
    name = "Monomorphic maps",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "empty map",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{`map` = {}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"t1"},
                          body = Type{
                            `map` = MapType{
                              keys = Type{
                                variable = Name{"t0"}},
                              values = Type{
                                variable = Name{"t1"}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "int to string map",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `map` = {
                        Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}}=Term{literal = Literal{`string` = "one"}},
                        Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}=Term{literal = Literal{`string` = "two"}}}}),
            expected = λ`_`.`type`
                  Type{
                    `map` = MapType{
                      keys = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `int32`}}},
                      values = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "string to int map",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `map` = {
                        Term{literal = Literal{`string` = "a"}}=Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                        Term{literal = Literal{`string` = "b"}}=Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `map` = MapType{
                      keys = Type{
                        literal = LiteralType{
                          `string`}},
                      values = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `int32`}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "single entry map",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `map` = {
                        Term{literal = Literal{integer = IntegerValue{`bigint` = 42:bigint}}}=Term{literal = Literal{`boolean` = true}}}}),
            expected = λ`_`.`type`
                  Type{
                    `map` = MapType{
                      keys = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `bigint`}}},
                      values = Type{
                        literal = LiteralType{
                          `boolean`}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term polymorphicMapsTests =
  TestGroup{
    name = "Polymorphic maps",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "map from lambda keys",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"k"},
                        domain = none,
                        body = Term{
                          `map` = {
                            Term{variable = Name{"k"}}=Term{literal = Literal{`string` = "value"}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            `map` = MapType{
                              keys = Type{
                                variable = Name{"t0"}},
                              values = Type{
                                literal = LiteralType{
                                  `string`}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "map from lambda values",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"v"},
                        domain = none,
                        body = Term{
                          `map` = {
                            Term{literal = Literal{`string` = "key"}}=Term{variable = Name{"v"}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            `map` = MapType{
                              keys = Type{
                                literal = LiteralType{
                                  `string`}},
                              values = Type{
                                variable = Name{"t0"}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "map from lambda both",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"k"},
                        domain = none,
                        body = Term{
                          lambda = Lambda{
                            parameter = Name{"v"},
                            domain = none,
                            body = Term{
                              `map` = {
                                Term{variable = Name{"k"}}=Term{variable = Name{"v"}}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"t1"},
                          body = Type{
                            function = FunctionType{
                              domain = Type{
                                variable = Name{"t0"}},
                              codomain = Type{
                                function = FunctionType{
                                  domain = Type{
                                    variable = Name{"t1"}},
                                  codomain = Type{
                                    `map` = MapType{
                                      keys = Type{
                                        variable = Name{"t0"}},
                                      values = Type{
                                        variable = Name{"t1"}}}}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "map with repeated variables",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
