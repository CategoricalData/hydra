                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          `map` = {
                            Term{variable = Name{"x"}}=Term{variable = Name{"x"}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
