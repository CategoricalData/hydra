                    Term{
                      `project` = Projection{
                        typeName = testTypeLatLonName,
                        fieldName = Name{"lat"}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        variable = Name{"LatLon"}},
                      codomain = Type{
                        literal = LiteralType{
                          float = FloatType{
                            `float32`}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "project lon from LatLon",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `project` = Projection{
                        typeName = testTypeLatLonName,
                        fieldName = Name{"lon"}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        variable = Name{"LatLon"}},
                      codomain = Type{
                        literal = LiteralType{
                          float = FloatType{
                            `float32`}}}}}}},
        description = none,
        tags = [],
