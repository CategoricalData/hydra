          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `cases` = CaseStatement{
                        typeName = testTypeComparisonName,
                        default = none,
                        `cases` = [
                          CaseAlternative{
                            name = Name{"lessThan"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = -1:int32}}}}}},
                          CaseAlternative{
                            name = Name{"equalTo"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 0:int32}}}}}},
                          CaseAlternative{
                            name = Name{"greaterThan"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 1:int32}}}}}}]}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        variable = testTypeComparisonName},
                      codomain = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `int32`}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "match applied to Comparison variant",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      application = Application{
                        function = Term{
                          `cases` = CaseStatement{
                            typeName = testTypeComparisonName,
                            default = none,
                            `cases` = [
                              CaseAlternative{
                                name = Name{"lessThan"},
                                handler = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{literal = Literal{`string` = "less"}}}}},
                              CaseAlternative{
                                name = Name{"equalTo"},
                                handler = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{literal = Literal{`string` = "equal"}}}}},
                              CaseAlternative{
                                name = Name{"greaterThan"},
                                handler = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{literal = Literal{`string` = "greater"}}}}}]}},
                        argument = Term{
