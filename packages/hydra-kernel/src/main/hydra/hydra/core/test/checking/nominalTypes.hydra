## Nominal type checking test cases: records, unions, field access, injection, projection
module hydra.core.test.checking.nominalTypes

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.model
import hydra.core.print.model
import hydra.core.scoping
import hydra.core.test.testGraph
import hydra.core.test.testTypes
import hydra.core.testing

term allTests =
  TestGroup{
    name = "Nominal types",
    description = none,
    subgroups = [recordsTests, unionsTests, wrappedTermsTests, eliminationsTests],
    `cases` = []}

term recordsTests =
  TestGroup{
    name = "Records",
    description = none,
    subgroups = [monomorphicRecordsTests, polymorphicRecordsTests, recordsInComplexContextsTests, multiParameterPolymorphicRecordsTests],
    `cases` = []}

term monomorphicRecordsTests =
  TestGroup{
    name = "Monomorphic records",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "latlon record",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"LatLon"},
                        fields = [
                          Field{name = Name{"lat"}, `term` = Term{literal = Literal{float = FloatValue{`float32` = 19.5429:float32}}}},
                          Field{name = Name{"lon"}, `term` = Term{literal = Literal{float = FloatValue{`float32` = -155.6659:float32}}}}]}}),
            expected = λ`_`.`type` Type{variable = Name{"LatLon"}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "latlon with variable",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          `record` = Record{
                            typeName = Name{"LatLon"},
                            fields = [
                              Field{name = Name{"lat"}, `term` = Term{literal = Literal{float = FloatValue{`float32` = 19.5429:float32}}}},
                              Field{name = Name{"lon"}, `term` = Term{variable = Name{"x"}}}]}}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        literal = LiteralType{
                          float = FloatType{
                            `float32`}}},
                      codomain = Type{
                        variable = Name{"LatLon"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "person record",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"Person"},
                        fields = [
                          Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Alice"}}},
                          Field{name = Name{"lastName"}, `term` = Term{literal = Literal{`string` = "Smith"}}},
                          Field{name = Name{"age"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 30:int32}}}}]}}),
            expected = λ`_`.`type` Type{variable = Name{"Person"}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "empty record",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"Unit"},
                        fields = []}}),
            expected = λ`_`.`type` Type{variable = Name{"Unit"}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "person with variables",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"name"},
                        domain = none,
                        body = Term{
                          lambda = Lambda{
                            parameter = Name{"age"},
                            domain = none,
                            body = Term{
                              `record` = Record{
                                typeName = Name{"Person"},
                                fields = [
                                  Field{name = Name{"firstName"}, `term` = Term{variable = Name{"name"}}},
                                  Field{name = Name{"lastName"}, `term` = Term{literal = Literal{`string` = "Doe"}}},
                                  Field{name = Name{"age"}, `term` = Term{variable = Name{"age"}}}]}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        literal = LiteralType{
                          `string`}},
                      codomain = Type{
                        function = FunctionType{
                          domain = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}},
                          codomain = Type{
                            variable = Name{"Person"}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term polymorphicRecordsTests =
  TestGroup{
    name = "Polymorphic records",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "latlon poly float",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"LatLonPoly"},
                        fields = [
                          Field{name = Name{"lat"}, `term` = Term{literal = Literal{float = FloatValue{`float32` = 19.5429:float32}}}},
                          Field{name = Name{"lon"}, `term` = Term{literal = Literal{float = FloatValue{`float32` = -155.6659:float32}}}}]}}),
            expected = λ`_`.`type`
                  Type{
                    application = ApplicationType{
                      function = Type{
                        variable = Name{"LatLonPoly"}},
                      argument = Type{
                        literal = LiteralType{
                          float = FloatType{
                            `float32`}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "latlon poly int64",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"LatLonPoly"},
                        fields = [
                          Field{name = Name{"lat"}, `term` = Term{literal = Literal{integer = IntegerValue{`int64` = 195429:int64}}}},
                          Field{name = Name{"lon"}, `term` = Term{literal = Literal{integer = IntegerValue{`int64` = -1556659:int64}}}}]}}),
            expected = λ`_`.`type`
                  Type{
                    application = ApplicationType{
                      function = Type{
                        variable = Name{"LatLonPoly"}},
                      argument = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `int64`}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "latlon poly variable",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          `record` = Record{
                            typeName = Name{"LatLonPoly"},
                            fields = [
                              Field{name = Name{"lat"}, `term` = Term{variable = Name{"x"}}},
                              Field{name = Name{"lon"}, `term` = Term{variable = Name{"x"}}}]}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            application = ApplicationType{
                              function = Type{
                                variable = Name{"LatLonPoly"}},
                              argument = Type{
                                variable = Name{"t0"}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "buddylist string",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"BuddyListA"},
                        fields = [
                          Field{name = Name{"head"}, `term` = Term{literal = Literal{`string` = "first"}}},
                          Field{name = Name{"tail"}, `term` = Term{`optional` = none}}]}}),
            expected = λ`_`.`type`
                  Type{
                    application = ApplicationType{
                      function = Type{
                        variable = Name{"BuddyListA"}},
                      argument = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "buddylist variable",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"x"},
                        domain = none,
                        body = Term{
                          `record` = Record{
                            typeName = Name{"BuddyListA"},
                            fields = [
                              Field{name = Name{"head"}, `term` = Term{variable = Name{"x"}}},
                              Field{name = Name{"tail"}, `term` = Term{`optional` = none}}]}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        function = FunctionType{
                          domain = Type{
                            variable = Name{"t0"}},
                          codomain = Type{
                            application = ApplicationType{
                              function = Type{
                                variable = Name{"BuddyListA"}},
                              argument = Type{
                                variable = Name{"t0"}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term recordsInComplexContextsTests =
  TestGroup{
    name = "Records in complex contexts",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "records in tuple",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      pair = (
                          Term{
                            `record` = Record{
                              typeName = Name{"Person"},
                              fields = [
                                Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Bob"}}},
                                Field{name = Name{"lastName"}, `term` = Term{literal = Literal{`string` = "Jones"}}},
                                Field{name = Name{"age"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 25:int32}}}}]}},
                          Term{
                            `record` = Record{
                              typeName = Name{"LatLon"},
                              fields = [
                                Field{name = Name{"lat"}, `term` = Term{literal = Literal{float = FloatValue{`float32` = 1.0:float32}}}},
                                Field{name = Name{"lon"}, `term` = Term{literal = Literal{float = FloatValue{`float32` = 2.0:float32}}}}]}})}),
            expected = λ`_`.`type`
                  Type{
                    pair = PairType{
                      first = Type{
                        variable = Name{"Person"}},
                      second = Type{
                        variable = Name{"LatLon"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "poly records in tuple",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      pair = (
                          Term{
                            `record` = Record{
                              typeName = Name{"LatLonPoly"},
                              fields = [
                                Field{name = Name{"lat"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}}},
                                Field{name = Name{"lon"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}}]}},
                          Term{
                            `record` = Record{
                              typeName = Name{"BuddyListA"},
                              fields = [
                                Field{name = Name{"head"}, `term` = Term{literal = Literal{`string` = "test"}}},
                                Field{name = Name{"tail"}, `term` = Term{`optional` = none}}]}})}),
            expected = λ`_`.`type`
                  Type{
                    pair = PairType{
                      first = Type{
                        application = ApplicationType{
                          function = Type{
                            variable = Name{"LatLonPoly"}},
                          argument = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}}}},
                      second = Type{
                        application = ApplicationType{
                          function = Type{
                            variable = Name{"BuddyListA"}},
                          argument = Type{
                            literal = LiteralType{
                              `string`}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "recursive record",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"IntList"},
                        fields = [
                          Field{name = Name{"head"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}},
                          Field{
                            name = Name{"tail"},
                            `term` = Term{
                              `optional` = given(Term{
                                  `record` = Record{
                                    typeName = Name{"IntList"},
                                    fields = [
                                      Field{name = Name{"head"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 43:int32}}}},
                                      Field{name = Name{"tail"}, `term` = Term{`optional` = none}}]}})}}]}}),
            expected = λ`_`.`type` Type{variable = Name{"IntList"}}}},
        description = none,
        tags = [],
        provisions = []}]}

term multiParameterPolymorphicRecordsTests =
  TestGroup{
    name = "Multi-parameter polymorphic records",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "triple with three monomorphic types",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `record` = Record{
                        typeName = Name{"Triple"},
                        fields = [
                          Field{name = Name{"first"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}}},
                          Field{name = Name{"second"}, `term` = Term{literal = Literal{`string` = "middle"}}},
                          Field{name = Name{"third"}, `term` = Term{literal = Literal{`boolean` = true}}}]}}),
            expected = λ`_`.`type`
                  Type{
                    application = ApplicationType{
                      function = Type{
                        application = ApplicationType{
                          function = Type{
                            application = ApplicationType{
                              function = Type{
                                variable = Name{"Triple"}},
                              argument = Type{
                                literal = LiteralType{
                                  integer = IntegerType{
                                    `int32`}}}}},
                          argument = Type{
                            literal = LiteralType{
                              `string`}}}},
                      argument = Type{
                        literal = LiteralType{
                          `boolean`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "triple with PersonOrSomething containing map",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"k"},
                        domain = none,
                        body = Term{
                          lambda = Lambda{
                            parameter = Name{"v"},
                            domain = none,
                            body = Term{
                              `record` = Record{
                                typeName = Name{"Triple"},
                                fields = [
                                  Field{name = Name{"first"}, `term` = Term{literal = Literal{`string` = "prefix"}}},
                                  Field{
                                    name = Name{"second"},
                                    `term` = Term{
                                      `inject` = Injection{
                                        typeName = testTypePersonOrSomethingName,
                                        field = Field{
                                          name = Name{"other"},
                                          `term` = Term{
                                            `map` = {
                                              Term{variable = Name{"k"}}=Term{variable = Name{"v"}}}}}}}},
                                  Field{name = Name{"third"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 999:int32}}}}]}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"t1"},
                          body = Type{
                            function = FunctionType{
                              domain = Type{
                                variable = Name{"t0"}},
                              codomain = Type{
                                function = FunctionType{
                                  domain = Type{
                                    variable = Name{"t1"}},
                                  codomain = Type{
                                    application = ApplicationType{
                                      function = Type{
                                        application = ApplicationType{
                                          function = Type{
                                            application = ApplicationType{
                                              function = Type{
                                                variable = Name{"Triple"}},
                                              argument = Type{
                                                literal = LiteralType{
                                                  `string`}}}},
                                          argument = Type{
                                            application = ApplicationType{
                                              function = Type{
                                                variable = Name{"PersonOrSomething"}},
                                              argument = Type{
                                                `map` = MapType{
                                                  keys = Type{
                                                    variable = Name{"t0"}},
                                                  values = Type{
                                                    variable = Name{"t1"}}}}}}}},
                                      argument = Type{
                                        literal = LiteralType{
                                          integer = IntegerType{
                                            `int32`}}}}}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

term recordEliminationsTests =
  TestGroup{
    name = "Record eliminations",
    description = none,
    subgroups = [
      simpleRecordProjectionsTests,
      recordProjectionsAppliedToRecordsTests,
      polymorphicRecordProjectionsTests,
      polymorphicRecordProjectionsAppliedTests,
      recordProjectionsWithVariablesTests,
      recordProjectionsInComplexContextsTests,
      multiParameterPolymorphicProjectionsTests,
      higherOrderRecordProjectionsTests,
      recursiveRecordProjectionsTests,
      recordProjectionsWithMutualRecursionTests,
      projectionsWithVariablesTests],
    `cases` = []}

term simpleRecordProjectionsTests =
  TestGroup{
    name = "Simple record projections",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "project firstName from Person",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `project` = Projection{
                        typeName = testTypePersonName,
                        fieldName = Name{"firstName"}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        variable = Name{"Person"}},
                      codomain = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "project lastName from Person",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `project` = Projection{
                        typeName = testTypePersonName,
                        fieldName = Name{"lastName"}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        variable = Name{"Person"}},
                      codomain = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "project age from Person",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `project` = Projection{
                        typeName = testTypePersonName,
                        fieldName = Name{"age"}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        variable = Name{"Person"}},
                      codomain = Type{
                        literal = LiteralType{
                          integer = IntegerType{
                            `int32`}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "project lat from LatLon",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
