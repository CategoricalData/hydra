                                    Term{literal = Literal{`string` = "key"}}=Term{
                                      `record` = Record{
                                        typeName = testTypeTripleName,
                                        fields = [
                                          Field{
                                            name = Name{"first"},
                                            `term` = Term{
                                              `inject` = Injection{
                                                typeName = testTypeEitherName,
                                                field = Field{name = Name{"left"}, `term` = Term{variable = Name{"x0"}}}}}},
                                          Field{
                                            name = Name{"second"},
                                            `term` = Term{
                                              `inject` = Injection{
                                                typeName = testTypeEitherName,
                                                field = Field{name = Name{"left"}, `term` = Term{variable = Name{"x0"}}}}}},
                                          Field{
                                            name = Name{"third"},
                                            `term` = Term{
                                              `inject` = Injection{
                                                typeName = testTypeEitherName,
                                                field = Field{name = Name{"right"}, `term` = Term{variable = Name{"x1"}}}}}}]}}}}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"t1"},
                          body = Type{
                            `forall` = ForallType{
                              parameter = Name{"t2"},
                              body = Type{
                                `forall` = ForallType{
                                  parameter = Name{"t3"},
                                  body = Type{
                                    `forall` = ForallType{
                                      parameter = Name{"t4"},
                                      body = Type{
                                        `forall` = ForallType{
                                          parameter = Name{"t5"},
                                          body = Type{
                                            function = FunctionType{
                                              domain = Type{
                                                variable = Name{"t0"}},
                                              codomain = Type{
                                                function = FunctionType{
                                                  domain = Type{
                                                    variable = Name{"t1"}},
                                                  codomain = Type{
                                                    function = FunctionType{
                                                      domain = Type{
                                                        variable = Name{"t2"}},
                                                      codomain = Type{
                                                        `map` = MapType{
                                                          keys = Type{
                                                            literal = LiteralType{
                                                              `string`}},
                                                          values = Type{
                                                            application = ApplicationType{
                                                              function = Type{
                                                                application = ApplicationType{
                                                                  function = Type{
                                                                    application = ApplicationType{
                                                                      function = Type{
                                                                        variable = testTypeTripleName},
                                                                      argument = Type{
                                                                        application = ApplicationType{
                                                                          function = Type{
                                                                            application = ApplicationType{
                                                                              function = Type{
                                                                                variable = testTypeEitherName},
                                                                              argument = Type{
                                                                                variable = Name{"t0"}}}},
                                                                          argument = Type{
                                                                            variable = Name{"t3"}}}}}},
                                                                  argument = Type{
                                                                    application = ApplicationType{
                                                                      function = Type{
                                                                        application = ApplicationType{
                                                                          function = Type{
                                                                            variable = testTypeEitherName},
                                                                          argument = Type{
                                                                            variable = Name{"t0"}}}},
                                                                      argument = Type{
                                                                        variable = Name{"t4"}}}}}},
                                                              argument = Type{
                                                                application = ApplicationType{
                                                                  function = Type{
                                                                    application = ApplicationType{
                                                                      function = Type{
                                                                        variable = testTypeEitherName},
                                                                      argument = Type{
                                                                        variable = Name{"t5"}}}},
                                                                  argument = Type{
                                                                    variable = Name{"t1"}}}}}}}}}}}}}}}}}}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

