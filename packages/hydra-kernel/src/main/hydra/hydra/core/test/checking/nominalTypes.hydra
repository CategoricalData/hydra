                                parameter = Name{"x"},
                                domain = none,
                                body = Term{literal = Literal{`string` = "greater"}}}}}]}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        variable = testTypeComparisonName},
                      codomain = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "match Comparison returning int32",
