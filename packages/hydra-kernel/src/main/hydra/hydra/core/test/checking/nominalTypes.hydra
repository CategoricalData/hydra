term recordProjectionsAppliedToRecordsTests =
  TestGroup{
    name = "Record projections applied to records",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "project firstName applied to person record",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      application = Application{
                        function = Term{
                          `project` = Projection{
                            typeName = testTypePersonName,
                            fieldName = Name{"firstName"}}},
                        argument = Term{
                          `record` = Record{
                            typeName = Name{"Person"},
                            fields = [
                              Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Alice"}}},
                              Field{name = Name{"lastName"}, `term` = Term{literal = Literal{`string` = "Smith"}}},
                              Field{name = Name{"age"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 30:int32}}}}]}}}}),
            expected = λ`_`.`type`
                  Type{
                    literal = LiteralType{
                      `string`}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "project age applied to person record",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      application = Application{
                        function = Term{
                          `project` = Projection{
