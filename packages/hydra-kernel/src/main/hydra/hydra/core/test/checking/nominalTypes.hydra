                      `cases` = CaseStatement{
                        typeName = testTypeComparisonName,
                        default = none,
                        `cases` = [
                          CaseAlternative{
                            name = Name{"lessThan"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{literal = Literal{`string` = "less"}}}}},
                          CaseAlternative{
                            name = Name{"equalTo"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{literal = Literal{`string` = "equal"}}}}},
                          CaseAlternative{
                            name = Name{"greaterThan"},
                            handler = Term{
