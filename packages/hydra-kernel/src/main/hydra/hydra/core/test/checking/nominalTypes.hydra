term multiParameterPolymorphicWrappersTests =
  TestGroup{
    name = "Multi-parameter polymorphic wrappers",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "symmetric triple wrapping simple types",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `wrap` = WrappedTerm{
                        typeName = testTypeSymmetricTripleName,
                        body = Term{
                          `record` = Record{
                            typeName = testTypeTripleName,
                            fields = [
                              Field{name = Name{"first"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}}},
                              Field{name = Name{"second"}, `term` = Term{literal = Literal{`string` = "edge"}}},
                              Field{name = Name{"third"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}}]}}}}),
            expected = λ`_`.`type`
                  Type{
                    application = ApplicationType{
                      function = Type{
                        application = ApplicationType{
                          function = Type{
                            variable = testTypeSymmetricTripleName},
                          argument = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}}}},
                      argument = Type{
                        literal = LiteralType{
                          `string`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "symmetric triple from lambda",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"v1"},
                        domain = none,
                        body = Term{
                          lambda = Lambda{
                            parameter = Name{"e"},
                            domain = none,
                            body = Term{
                              lambda = Lambda{
                                parameter = Name{"v2"},
                                domain = none,
                                body = Term{
                                  `wrap` = WrappedTerm{
                                    typeName = testTypeSymmetricTripleName,
                                    body = Term{
                                      `record` = Record{
                                        typeName = testTypeTripleName,
                                        fields = [
                                          Field{name = Name{"first"}, `term` = Term{variable = Name{"v1"}}},
                                          Field{name = Name{"second"}, `term` = Term{variable = Name{"e"}}},
                                          Field{name = Name{"third"}, `term` = Term{variable = Name{"v2"}}}]}}}}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"t1"},
                          body = Type{
                            function = FunctionType{
                              domain = Type{
                                variable = Name{"t0"}},
                              codomain = Type{
                                function = FunctionType{
                                  domain = Type{
                                    variable = Name{"t1"}},
                                  codomain = Type{
                                    function = FunctionType{
                                      domain = Type{
                                        variable = Name{"t0"}},
                                      codomain = Type{
                                        application = ApplicationType{
                                          function = Type{
                                            application = ApplicationType{
                                              function = Type{
                                                variable = testTypeSymmetricTripleName},
                                              argument = Type{
                                                variable = Name{"t0"}}}},
                                          argument = Type{
                                            variable = Name{"t1"}}}}}}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "symmetric triple with nested polymorphic types and foldl",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `let` = Let{
                        bindings = [
                          Binding{
                            name = Name{"sumList"},
                            `term` = Term{
                              lambda = Lambda{
                                parameter = Name{"lst"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.lists.foldl"}},
                                            argument = Term{
                                              lambda = Lambda{
                                                parameter = Name{"acc"},
                                                domain = none,
                                                body = Term{
                                                  lambda = Lambda{
                                                    parameter = Name{"x"},
                                                    domain = none,
                                                    body = Term{
                                                      application = Application{
                                                        function = Term{
                                                          application = Application{
                                                            function = Term{
                                                              variable = Name{"hydra.core.lib.math.add"}},
                                                            argument = Term{
                                                              variable = Name{"acc"}}}},
                                                        argument = Term{
                                                          variable = Name{"x"}}}}}}}}}},
                                        argument = Term{
                                          literal = Literal{
                                            integer = IntegerValue{
                                              `int32` = 0:int32}}}}},
                                    argument = Term{variable = Name{"lst"}}}}}},
                            typeScheme = none}],
                        body = Term{
                          lambda = Lambda{
                            parameter = Name{"nums1"},
                            domain = none,
                            body = Term{
                              lambda = Lambda{
                                parameter = Name{"nums2"},
                                domain = none,
                                body = Term{
                                  `wrap` = WrappedTerm{
                                    typeName = testTypeSymmetricTripleName,
                                    body = Term{
                                      `record` = Record{
                                        typeName = testTypeTripleName,
                                        fields = [
                                          Field{
                                            name = Name{"first"},
                                            `term` = Term{
                                              application = Application{
                                                function = Term{variable = Name{"sumList"}},
                                                argument = Term{variable = Name{"nums1"}}}}},
                                          Field{name = Name{"second"}, `term` = Term{`list` = [Term{variable = Name{"nums1"}}, Term{variable = Name{"nums2"}}]}},
                                          Field{
                                            name = Name{"third"},
                                            `term` = Term{
                                              application = Application{
                                                function = Term{variable = Name{"sumList"}},
                                                argument = Term{variable = Name{"nums2"}}}}}]}}}}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    function = FunctionType{
                      domain = Type{
                        `list` = Type{
                          literal = LiteralType{
                            integer = IntegerType{
                              `int32`}}}},
                      codomain = Type{
                        function = FunctionType{
                          domain = Type{
                            `list` = Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int32`}}}},
                          codomain = Type{
                            application = ApplicationType{
                              function = Type{
                                application = ApplicationType{
                                  function = Type{
                                    variable = testTypeSymmetricTripleName},
                                  argument = Type{
                                    literal = LiteralType{
                                      integer = IntegerType{
                                        `int32`}}}}},
                              argument = Type{
                                `list` = Type{
                                  `list` = Type{
                                    literal = LiteralType{
                                      integer = IntegerType{
                                        `int32`}}}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

