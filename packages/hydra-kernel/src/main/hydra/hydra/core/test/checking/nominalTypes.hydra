        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe."<<inference error>>")
                  (λresult.`type`
                      (typeSchemeToFType
                        (second (first result))))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      lambda = Lambda{
                        parameter = Name{"mst"},
                        domain = none,
                        body = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.optionals.match"}},
                                    argument = Term{
                                      variable = Name{"mst"}}}},
                                argument = Term{
                                  `optional` = none}}},
                            argument = Term{
                              lambda = Lambda{
                                parameter = Name{"st"},
                                domain = none,
                                body = Term{
                                  `optional` = given(Term{
                                      application = Application{
                                        function = Term{
                                          `project` = Projection{
                                            typeName = testTypeTripleName,
                                            fieldName = Name{"second"}}},
                                        argument = Term{
                                          application = Application{
                                            function = Term{
                                              `unwrap` = testTypeSymmetricTripleName},
                                            argument = Term{
                                              variable = Name{"st"}}}}}})}}}}}}}),
            expected = λ`_`.`type`
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"t0"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"t1"},
                          body = Type{
                            function = FunctionType{
                              domain = Type{
                                `optional` = Type{
                                  application = ApplicationType{
                                    function = Type{
                                      application = ApplicationType{
                                        function = Type{
                                          variable = testTypeSymmetricTripleName},
                                        argument = Type{
                                          variable = Name{"t0"}}}},
                                    argument = Type{
                                      variable = Name{"t1"}}}}},
                              codomain = Type{
                                `optional` = Type{
                                  variable = Name{"t1"}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

