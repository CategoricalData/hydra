term identityApplicationTests =
  TestGroup{
    name = "identity application",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "non-identity lambda application is valid",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 1:int32}}}}},
                            argument = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 2:int32}}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "identity lambda application",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          application = Application{
