        tags = [],
        provisions = []}]}

term profileBehaviourTests =
  TestGroup{
    name = "profile-aware behaviour",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "multi-error accumulation: two empty-let errors collected",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  (strings.concat2
                    "errors=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λe.invalidTermError e)
                          (ValidationResult[errors]
                            (`term`
                              ValidationProfile{
                                errorRules = sets.fromList
                                    [Name{"hydra.core.error.model.InvalidTermError.emptyLetBindings"}],
                                warningRules = sets.fromList [],
                                maxErrors = 5:int32,
                                maxWarnings = 5:int32}
                              false
                              testGraph
                              Term{
                                `let` = Let{
                                  bindings = [],
                                  body = Term{
                                    `let` = Let{
                                      bindings = [],
                                      body = Term{
                                        literal = Literal{
                                          integer = IntegerValue{
                                            `int32` = 0:int32}}}}}}}))))
                      "]"))
                  (strings.concat2
                    " warnings=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λw.invalidTermError w)
                          (ValidationResult[warnings]
                            (`term`
                              ValidationProfile{
                                errorRules = sets.fromList
                                    [Name{"hydra.core.error.model.InvalidTermError.emptyLetBindings"}],
                                warningRules = sets.fromList [],
                                maxErrors = 5:int32,
                                maxWarnings = 5:int32}
                              false
                              testGraph
                              Term{
                                `let` = Let{
                                  bindings = [],
                                  body = Term{
                                    `let` = Let{
                                      bindings = [],
                                      body = Term{
                                        literal = Literal{
                                          integer = IntegerValue{
                                            `int32` = 0:int32}}}}}}}))))
                      "]")),
            expected = λ`_`.strings.concat2
                  (strings.concat2
                    "errors=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λe.invalidTermError e)
                          (ValidationResult[errors]
                            ValidationResult{
                              errors = [
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[]}}},
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[SubtermStep{letBody}]}}}],
                              warnings = []})))
                      "]"))
                  (strings.concat2
                    " warnings=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λw.invalidTermError w)
                          (ValidationResult[warnings]
                            ValidationResult{
                              errors = [
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[]}}},
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[SubtermStep{letBody}]}}}],
                              warnings = []})))
                      "]"))}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "warning classification: empty-let demoted to warnings",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  (strings.concat2
                    "errors=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λe.invalidTermError e)
                          (ValidationResult[errors]
                            (`term`
                              ValidationProfile{
                                errorRules = sets.fromList [],
                                warningRules = sets.fromList
                                    [Name{"hydra.core.error.model.InvalidTermError.emptyLetBindings"}],
                                maxErrors = 5:int32,
                                maxWarnings = 5:int32}
                              false
                              testGraph
                              Term{
                                `let` = Let{
                                  bindings = [],
                                  body = Term{
                                    `let` = Let{
                                      bindings = [],
                                      body = Term{
                                        literal = Literal{
                                          integer = IntegerValue{
                                            `int32` = 0:int32}}}}}}}))))
                      "]"))
                  (strings.concat2
                    " warnings=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λw.invalidTermError w)
                          (ValidationResult[warnings]
                            (`term`
                              ValidationProfile{
                                errorRules = sets.fromList [],
                                warningRules = sets.fromList
                                    [Name{"hydra.core.error.model.InvalidTermError.emptyLetBindings"}],
                                maxErrors = 5:int32,
                                maxWarnings = 5:int32}
                              false
                              testGraph
                              Term{
                                `let` = Let{
                                  bindings = [],
                                  body = Term{
                                    `let` = Let{
                                      bindings = [],
                                      body = Term{
                                        literal = Literal{
                                          integer = IntegerValue{
                                            `int32` = 0:int32}}}}}}}))))
                      "]")),
            expected = λ`_`.strings.concat2
                  (strings.concat2
                    "errors=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λe.invalidTermError e)
                          (ValidationResult[errors]
                            ValidationResult{
                              errors = [],
                              warnings = [
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[]}}},
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[SubtermStep{letBody}]}}}]})))
                      "]"))
                  (strings.concat2
                    " warnings=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λw.invalidTermError w)
                          (ValidationResult[warnings]
                            ValidationResult{
                              errors = [],
                              warnings = [
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[]}}},
                                InvalidTermError{emptyLetBindings = EmptyLetBindingsError{location = SubtermPath{[SubtermStep{letBody}]}}}]})))
                      "]"))}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "rule disabling: empty-let omitted from profile",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat2
                  (strings.concat2
                    "errors=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
                          (λe.invalidTermError e)
                          (ValidationResult[errors]
                            (`term`
                              ValidationProfile{
                                errorRules = sets.fromList [],
                                warningRules = sets.fromList [],
                                maxErrors = 5:int32,
                                maxWarnings = 5:int32}
                              false
                              testGraph
                              Term{
                                `let` = Let{
                                  bindings = [],
                                  body = Term{
                                    literal = Literal{
                                      integer = IntegerValue{
                                        `int32` = 0:int32}}}}}))))
                      "]"))
                  (strings.concat2
                    " warnings=["
                    (strings.concat2
                      (strings.join
                        ";"
                        (lists.map
