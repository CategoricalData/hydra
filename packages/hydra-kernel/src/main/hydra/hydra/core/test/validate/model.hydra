## Test cases for core term and type validation
module hydra.core.test.validate.model

import hydra.core.error.model
import hydra.core.lib.lists as lists
import hydra.core.lib.optionals
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.paths
import hydra.core.print.error.model
import hydra.core.test.testGraph
import hydra.core.testing
import hydra.core.validate.model
import hydra.core.validation

## Test cases for core term and type validation
term allTests =
  TestGroup{
    name = "validate.core",
    description = none,
    subgroups = [
      annotationTests,
      duplicateBindingsTests,
      duplicateFieldsTests,
      emptyLetBindingsTests,
      identityApplicationTests,
      profileBehaviourTests,
      unknownPrimitiveTests,
      untypedTermVariableTests,
      variableShadowingTests],
    `cases` = []}

term annotationTests =
  TestGroup{
    name = "annotations",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "annotated term is valid",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 42:int32}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []}]}

term duplicateBindingsTests =
  TestGroup{
    name = "duplicate bindings",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "no bindings (literal)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 42:int32}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "single binding",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"x"}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "distinct bindings",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none},
                              Binding{
                                name = Name{"y"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"x"}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "duplicate bindings at top level",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none},
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"x"}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  given(InvalidTermError{
                    duplicateBinding = DuplicateBindingError{
                      location = SubtermPath{[]},
                      name = Name{"x"}}})
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "duplicate bindings in lambda body",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"f"},
                            domain = none,
                            body = Term{
                              `let` = Let{
                                bindings = [
                                  Binding{
                                    name = Name{"a"},
                                    `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                    typeScheme = none},
                                  Binding{
                                    name = Name{"a"},
                                    `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                    typeScheme = none}],
                                body = Term{
                                  variable = Name{"a"}}}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  given(InvalidTermError{
                    duplicateBinding = DuplicateBindingError{
                      location = SubtermPath{[SubtermStep{lambdaBody}]},
                      name = Name{"a"}}})
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "duplicate bindings in let body",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `let` = Let{
                                bindings = [
                                  Binding{
                                    name = Name{"y"},
                                    `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                    typeScheme = none},
                                  Binding{
                                    name = Name{"y"},
                                    `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 3:int32}}},
                                    typeScheme = none}],
                                body = Term{
                                  variable = Name{"y"}}}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  given(InvalidTermError{
                    duplicateBinding = DuplicateBindingError{
                      location = SubtermPath{[SubtermStep{letBody}]},
                      name = Name{"y"}}})
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "duplicate bindings in let binding value",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{
                                  `let` = Let{
                                    bindings = [
                                      Binding{
                                        name = Name{"a"},
                                        `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                        typeScheme = none},
                                      Binding{
                                        name = Name{"a"},
                                        `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                        typeScheme = none}],
                                    body = Term{variable = Name{"a"}}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"x"}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  given(InvalidTermError{
                    duplicateBinding = DuplicateBindingError{
                      location = SubtermPath{[SubtermStep{letBinding = Name{"x"}}]},
                      name = Name{"a"}}})
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "same name in different scopes is valid",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `let` = Let{
                                bindings = [
                                  Binding{
                                    name = Name{"x"},
                                    `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}},
                                    typeScheme = none}],
                                body = Term{
                                  variable = Name{"x"}}}}}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []}]}

