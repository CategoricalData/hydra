term unknownPrimitiveTests =
  TestGroup{
    name = "unknown primitive",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "qualified reference to a bound (non-primitive) kernel term is valid",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
                      (`term`
                        kernelDefaultCoreProfile
                        false
                        testGraph
                        Term{
                          variable = Name{"hydra.core.constants.keyDescription"}})))
                  "valid"
                  (λe.invalidTermError e),
            expected = λ`_`.match
                  none
                  "valid"
                  (λe.invalidTermError e)}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "unresolvable qualified name is an unknown primitive",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.match
                  (lists.head
                    (ValidationResult[errors]
