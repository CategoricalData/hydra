                expected = λ`_`.`list`
                      (`list` printInt32)
                      [[1:int32, 2:int32, 3:int32]]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "chain of three SCCs",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`list`
                      (`list` printInt32)
                      (topologicalSortComponents
