                          (1:int32, [2:int32, 10:int32]),
                          (2:int32, [3:int32]),
                          (3:int32, [1:int32]),
                          (10:int32, [20:int32]),
                          (20:int32, [100:int32, 10:int32]),
                          (100:int32, [])]),
                expected = λ`_`.`list`
                      (`list` printInt32)
                      [[100:int32], [10:int32, 20:int32], [1:int32, 2:int32, 3:int32]]}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "SCCs with dependencies to/from non-SCC nodes",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.`list`
                      (`list` printInt32)
                      (topologicalSortComponents
                        [
                          (1:int32, [2:int32, 3:int32, 10:int32]),
                          (2:int32, [3:int32]),
                          (3:int32, [1:int32]),
                          (10:int32, [20:int32, 30:int32]),
                          (20:int32, [30:int32]),
                          (30:int32, []),
                          (100:int32, [200:int32, 2:int32]),
                          (200:int32, []),
                          (300:int32, [100:int32]),
                          (1000:int32, []),
                          (2000:int32, [])]),
                expected = λ`_`.`list`
                      (`list` printInt32)
                      [
                        [30:int32],
                        [20:int32],
                        [10:int32],
                        [1:int32, 2:int32, 3:int32],
                        [200:int32],
                        [100:int32],
                        [300:int32],
                        [1000:int32],
                        [2000:int32]]}},
            description = none,
