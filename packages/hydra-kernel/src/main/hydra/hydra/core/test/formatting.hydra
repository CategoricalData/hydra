## Test cases for rendering a Name in UPPER-DASHED display form
term nameToUpperDashedTests =
  TestGroup{
    name = "name to upper-dashed",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "#1 (hydra.core.lib.lists.concat.emptyLists)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.nameToUpperDashed
                  Name{"hydra.core.lib.lists.concat.emptyLists"},
            expected = λ`_`."HYDRA-CORE-LIB-LISTS-CONCAT-EMPTY-LISTS"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "#2 (hydra.core.model.Name)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.nameToUpperDashed
                  Name{"hydra.core.model.Name"},
            expected = λ`_`."HYDRA-CORE-MODEL-NAME"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "#3 (singlePart)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.nameToUpperDashed Name{"singlePart"},
            expected = λ`_`."SINGLE-PART"}},
        description = none,
        tags = [],
        provisions = []}]}