## Test cases for string formatting and case conversion
module hydra.core.test.formatting

import hydra.core.formatting
import hydra.core.model
import hydra.core.names
import hydra.core.testing
import hydra.core.util

## Test cases for hydra.core.formatting
term allTests =
  TestGroup{
    name = "formatting",
    description = none,
    subgroups = [caseConversionTests, nameToUpperDashedTests],
    `cases` = []}

## Test cases for case conversion
term caseConversionTests =
  TestGroup{
    name = "case conversion",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "#1 (lower_snake_case -> UPPER_SNAKE_CASE)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.convertCase
                  CaseConvention{lowerSnake}
                  CaseConvention{upperSnake}
                  "a_hello_world_42_a42_42a_b",
            expected = λ`_`."A_HELLO_WORLD_42_A42_42A_B"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "#2 (lower_snake_case -> camelCase)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.convertCase
                  CaseConvention{lowerSnake}
                  CaseConvention{camel}
