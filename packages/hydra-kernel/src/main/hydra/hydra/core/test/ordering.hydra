## Test cases for Ord instance comparisons on complex Hydra types
module hydra.core.test.ordering

import hydra.core.lib.equality
import hydra.core.lib.literals
import hydra.core.lib.ordering
import hydra.core.model
import hydra.core.print.util
import hydra.core.test.testTypes
import hydra.core.testing
import hydra.core.util

## Test cases for Ord instance comparisons on complex Hydra types
term allTests =
  TestGroup{
    name = "ordering",
    description = none,
    subgroups = [
      TestGroup{
        name = "Name comparison",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "name less than (alphabetic)",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.comparison
                      (compare
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "apple"}}}}
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "banana"}}}}),
                expected = λ`_`.comparison Comparison{lessThan}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "name equal",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.comparison
                      (compare
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "hello"}}}}
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "hello"}}}}),
                expected = λ`_`.comparison Comparison{equalTo}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "name greater than",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.comparison
                      (compare
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "zebra"}}}}
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "apple"}}}}),
                expected = λ`_`.comparison Comparison{greaterThan}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "qualified name less than",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.comparison
                      (compare
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "hydra.core.model.Term"}}}}
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "hydra.core.model.Type"}}}}),
                expected = λ`_`.comparison Comparison{lessThan}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "qualified name equal",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.comparison
                      (compare
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "hydra.core.model.Term"}}}}
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "hydra.core.model.Term"}}}}),
                expected = λ`_`.comparison Comparison{equalTo}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "name equality true",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λb.printBoolean b)
                      (equal
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "foo"}}}}
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "foo"}}}}),
                expected = λ`_`.(λb.printBoolean b) true}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "name equality false",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λb.printBoolean b)
                      (equal
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "foo"}}}}
                        Term{
                          `wrap` = WrappedTerm{
                            typeName = Name{"hydra.core.model.Name"},
                            body = Term{
                              literal = Literal{
                                `string` = "bar"}}}}),
                expected = λ`_`.(λb.printBoolean b) false}},
            description = none,
            tags = [],
            provisions = []}]},
