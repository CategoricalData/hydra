            expected = λ`_`.model.term
                  Term{
                    `wrap` = WrappedTerm{
                      typeName = Name{"example.Meters"},
                      body = Term{
                        literal = Literal{
                          integer = IntegerValue{
                            `int32` = 100:int32}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
