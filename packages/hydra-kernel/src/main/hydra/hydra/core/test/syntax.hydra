## Print/parse/round-trip cases for multi-line '##' doc-comment descriptions (#711)
term multiLineDocCommentGroup =
  TestGroup{
    name = "multi-line doc comments",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "multi-line term description hoists to one '##' line per source line",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.termDefinition
                  maps.empty
                  TermDefinition{
                    name = Name{"unifyTypeConstraints"},
                    metadata = none,
                    signature = none,
                    body = Term{
                      annotated = AnnotatedTerm{
                        body = Term{
                          variable = Name{"impl"}},
                        annotation = Term{
                          `map` = maps.fromList
                              [
                                (
                                  Term{variable = Name{"description"}},
                                  Term{literal = Literal{`string` = "Robinson's algorithm.\nSee the reference."}})]}}}},
            expected = λ`_`."## Robinson's algorithm.\n## See the reference.\nterm unifyTypeConstraints = impl"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "multi-line term description round-trips (whole module)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λm2.moduleDefinition m2)
                  (parseModule
                    (moduleDefinition
                      Module{
                        name = ModuleName{"test.multiline.term"},
                        metadata = none,
                        dependencies = [],
                        definitions = [
                          Definition{
                            `term` = TermDefinition{
                              name = Name{"impl"},
                              metadata = none,
                              signature = none,
                              body = Term{
                                annotated = AnnotatedTerm{
                                  body = Term{variable = Name{"y"}},
                                  annotation = Term{
                                    `map` = maps.fromList
                                        [
                                          (
                                            Term{variable = Name{"description"}},
                                            Term{literal = Literal{`string` = "Robinson's algorithm.\nSee the reference."}})]}}}}}]})),
            expected = λ`_`.moduleDefinition
                  Module{
                    name = ModuleName{"test.multiline.term"},
                    metadata = none,
                    dependencies = [],
                    definitions = [
                      Definition{
                        `term` = TermDefinition{
                          name = Name{"impl"},
                          metadata = none,
                          signature = none,
                          body = Term{
                            annotated = AnnotatedTerm{
                              body = Term{variable = Name{"y"}},
                              annotation = Term{
                                `map` = maps.fromList
                                    [
                                      (
                                        Term{variable = Name{"description"}},
                                        Term{literal = Literal{`string` = "Robinson's algorithm.\nSee the reference."}})]}}}}}]}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "multi-line type description hoists to one '##' line per source line",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.typeDefinition
                  maps.empty
                  TypeDefinition{
                    name = Name{"Config"},
                    metadata = none,
                    body = TypeScheme{
                      variables = [],
                      body = Type{
                        annotated = AnnotatedType{
                          body = Type{
                            literal = LiteralType{
                              `string`}},
                          annotation = Term{
                            `map` = maps.fromList
                                [
                                  (Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "Configuration options.\nSee the manual."}})]}}},
                      constraints = maps.empty}},
            expected = λ`_`."## Configuration options.\n## See the manual.\ntype Config = string"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "multi-line type description round-trips (whole module)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λm2.moduleDefinition m2)
                  (parseModule
                    (moduleDefinition
                      Module{
                        name = ModuleName{"test.multiline.type"},
                        metadata = none,
                        dependencies = [],
                        definitions = [
                          Definition{
                            `type` = TypeDefinition{
                              name = Name{"Config"},
                              metadata = none,
                              body = TypeScheme{
                                variables = [],
                                body = Type{
                                  annotated = AnnotatedType{
                                    body = Type{
                                      literal = LiteralType{
                                        `string`}},
                                    annotation = Term{
                                      `map` = maps.fromList
                                          [
                                            (Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "Configuration options.\nSee the manual."}})]}}},
                                constraints = maps.empty}}}]})),
            expected = λ`_`.moduleDefinition
                  Module{
                    name = ModuleName{"test.multiline.type"},
                    metadata = none,
                    dependencies = [],
                    definitions = [
                      Definition{
                        `type` = TypeDefinition{
                          name = Name{"Config"},
                          metadata = none,
                          body = TypeScheme{
                            variables = [],
                            body = Type{
                              annotated = AnnotatedType{
                                body = Type{
                                  literal = LiteralType{
                                    `string`}},
                                annotation = Term{
                                  `map` = maps.fromList
                                      [
                                        (Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "Configuration options.\nSee the manual."}})]}}},
                            constraints = maps.empty}}}]}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "multi-line module description hoists to one '##' line per source line",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.moduleDefinition
                  Module{
                    name = ModuleName{"test.multiline"},
                    metadata = given(EntityMetadata{
                        description = given("Utilities for X.\nSee the reference."),
                        comments = [],
                        seeAlso = [],
                        lifecycle = none,
                        provisions = []}),
                    dependencies = [],
                    definitions = [
                      Definition{
                        `term` = TermDefinition{
                          name = Name{"x"},
                          metadata = none,
                          signature = none,
                          body = Term{variable = Name{"y"}}}}]},
            expected = λ`_`."## Utilities for X.\n## See the reference.\nmodule test.multiline\n\nterm x = y"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "multi-line module description round-trips (whole module)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λm2.moduleDefinition m2)
                  (parseModule
                    (moduleDefinition
                      Module{
                        name = ModuleName{"test.multiline.module"},
                        metadata = given(EntityMetadata{
                            description = given("Utilities for X.\nSee the reference."),
                            comments = [],
                            seeAlso = [],
                            lifecycle = none,
                            provisions = []}),
                        dependencies = [],
                        definitions = [
                          Definition{
                            `term` = TermDefinition{
                              name = Name{"x"},
                              metadata = none,
                              signature = none,
                              body = Term{variable = Name{"y"}}}}]})),
            expected = λ`_`.moduleDefinition
                  Module{
                    name = ModuleName{"test.multiline.module"},
                    metadata = given(EntityMetadata{
                        description = given("Utilities for X.\nSee the reference."),
                        comments = [],
                        seeAlso = [],
                        lifecycle = none,
                        provisions = []}),
                    dependencies = [],
                    definitions = [
                      Definition{
                        `term` = TermDefinition{
                          name = Name{"x"},
                          metadata = none,
                          signature = none,
                          body = Term{variable = Name{"y"}}}}]}}},
        description = none,
        tags = [],
        provisions = []}]}

## Nominal construction/elimination sugar: print + round-trip (#809)
term nominalSugarGroup =
  TestGroup{
    name = "nominal sugar",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "record sugar: multi-field",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    `record` = Record{
                      typeName = Name{"example.Person"},
                      fields = [
                        Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Alice"}}},
                        Field{name = Name{"age"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 30:int32}}}}]}},
            expected = λ`_`."example.Person{firstName = \"Alice\", age = 30:int32}"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "record sugar: multi-field round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `record` = Record{
                          typeName = Name{"example.Person"},
                          fields = [
                            Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Alice"}}},
                            Field{name = Name{"age"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 30:int32}}}}]}})),
            expected = λ`_`.model.term
                  Term{
                    `record` = Record{
                      typeName = Name{"example.Person"},
                      fields = [
                        Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Alice"}}},
                        Field{name = Name{"age"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 30:int32}}}}]}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "record sugar: bareword unit field",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    `record` = Record{
                      typeName = Name{"example.Person"},
                      fields = [
                        Field{name = Name{"contactInfo"}, `term` = Term{`unit`}},
                        Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Arthur"}}}]}},
            expected = λ`_`."example.Person{contactInfo, firstName = \"Arthur\"}"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "record sugar: bareword unit field round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `record` = Record{
                          typeName = Name{"example.Person"},
                          fields = [
                            Field{name = Name{"contactInfo"}, `term` = Term{`unit`}},
                            Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Arthur"}}}]}})),
            expected = λ`_`.model.term
                  Term{
                    `record` = Record{
                      typeName = Name{"example.Person"},
                      fields = [
                        Field{name = Name{"contactInfo"}, `term` = Term{`unit`}},
                        Field{name = Name{"firstName"}, `term` = Term{literal = Literal{`string` = "Arthur"}}}]}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "injection sugar: unit variant prints as bareword record-style construct",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"example.Color"},
                      field = Field{
                        name = Name{"red"},
                        `term` = Term{
                          `unit`}}}},
            expected = λ`_`."example.Color{red}"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "injection sugar: unit variant string round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `inject` = Injection{
                          typeName = Name{"example.Color"},
                          field = Field{
                            name = Name{"red"},
                            `term` = Term{
                              `unit`}}}})),
            expected = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"example.Color"},
                      field = Field{
                        name = Name{"red"},
                        `term` = Term{
                          `unit`}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "injection sugar: data variant",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"example.Length"},
                      field = Field{
                        name = Name{"meters"},
                        `term` = Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 1:int32}}}}}},
            expected = λ`_`."example.Length{meters = 1:int32}"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "injection sugar: data variant string round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `inject` = Injection{
                          typeName = Name{"example.Length"},
                          field = Field{
                            name = Name{"meters"},
                            `term` = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 1:int32}}}}}})),
            expected = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"example.Length"},
                      field = Field{
                        name = Name{"meters"},
                        `term` = Term{
                          literal = Literal{
                            integer = IntegerValue{
                              `int32` = 1:int32}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "wrap sugar: literal body",
