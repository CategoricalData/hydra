## Round-trip and exact-print test cases for lazy parameter syntax (#800)
term lazyParameterRoundtripGroup =
  TestGroup{
    name = "lazy parameter syntax",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "ifElse: lazy then/else branches print with 'lazy' keyword",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.termSignature
                  TermSignature{
                    typeParameters = [TypeParameter{name = Name{"x"}, constraints = []}],
                    parameters = [
                      Parameter{name = Name{"p"}, description = none, `type` = Type{literal = LiteralType{`boolean`}}, isLazy = false},
                      Parameter{name = Name{"t"}, description = none, `type` = Type{variable = Name{"x"}}, isLazy = true},
                      Parameter{name = Name{"f"}, description = none, `type` = Type{variable = Name{"x"}}, isLazy = true}],
                    result = Result{
                      description = none,
                      `type` = Type{
                        variable = Name{"x"}}}},
            expected = λ`_`."∀x.boolean → lazy x → lazy x → x"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "ifElse: lazy then/else branches round-trip",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λsig2.model.termSignature sig2)
                  (parseTermSignature
                    (model.termSignature
                      TermSignature{
                        typeParameters = [TypeParameter{name = Name{"x"}, constraints = []}],
                        parameters = [
                          Parameter{name = Name{"p"}, description = none, `type` = Type{literal = LiteralType{`boolean`}}, isLazy = false},
                          Parameter{name = Name{"t"}, description = none, `type` = Type{variable = Name{"x"}}, isLazy = true},
                          Parameter{name = Name{"f"}, description = none, `type` = Type{variable = Name{"x"}}, isLazy = true}],
                        result = Result{
                          description = none,
                          `type` = Type{
                            variable = Name{"x"}}}})),
            expected = λ`_`.model.termSignature
                  TermSignature{
                    typeParameters = [TypeParameter{name = Name{"x"}, constraints = []}],
                    parameters = [
                      Parameter{name = Name{"p"}, description = none, `type` = Type{literal = LiteralType{`boolean`}}, isLazy = false},
                      Parameter{name = Name{"t"}, description = none, `type` = Type{variable = Name{"x"}}, isLazy = true},
                      Parameter{name = Name{"f"}, description = none, `type` = Type{variable = Name{"x"}}, isLazy = true}],
                    result = Result{
                      description = none,
                      `type` = Type{
                        variable = Name{"x"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "findWithDefault: lazy default value prints with 'lazy' keyword",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.termSignature
                  TermSignature{
                    typeParameters = [TypeParameter{name = Name{"k"}, constraints = []}, TypeParameter{name = Name{"v"}, constraints = []}],
                    parameters = [
                      Parameter{name = Name{"def"}, description = none, `type` = Type{variable = Name{"v"}}, isLazy = true},
                      Parameter{name = Name{"key"}, description = none, `type` = Type{variable = Name{"k"}}, isLazy = false},
                      Parameter{
                        name = Name{"m"},
                        description = none,
                        `type` = Type{
                          application = ApplicationType{
                            function = Type{
                              application = ApplicationType{
                                function = Type{
                                  variable = Name{"Map"}},
                                argument = Type{
                                  variable = Name{"k"}}}},
                            argument = Type{variable = Name{"v"}}}},
                        isLazy = false}],
                    result = Result{
                      description = none,
                      `type` = Type{
                        variable = Name{"v"}}}},
            expected = λ`_`."∀k,v.lazy v → k → Map k v → v"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "findWithDefault: lazy default value round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λsig2.model.termSignature sig2)
                  (parseTermSignature
                    (model.termSignature
                      TermSignature{
                        typeParameters = [TypeParameter{name = Name{"k"}, constraints = []}, TypeParameter{name = Name{"v"}, constraints = []}],
                        parameters = [
                          Parameter{name = Name{"def"}, description = none, `type` = Type{variable = Name{"v"}}, isLazy = true},
                          Parameter{name = Name{"key"}, description = none, `type` = Type{variable = Name{"k"}}, isLazy = false},
                          Parameter{
                            name = Name{"m"},
                            description = none,
                            `type` = Type{
                              application = ApplicationType{
                                function = Type{
                                  application = ApplicationType{
                                    function = Type{
                                      variable = Name{"Map"}},
                                    argument = Type{
                                      variable = Name{"k"}}}},
                                argument = Type{variable = Name{"v"}}}},
                            isLazy = false}],
                        result = Result{
                          description = none,
                          `type` = Type{
                            variable = Name{"v"}}}})),
            expected = λ`_`.model.termSignature
                  TermSignature{
                    typeParameters = [TypeParameter{name = Name{"k"}, constraints = []}, TypeParameter{name = Name{"v"}, constraints = []}],
                    parameters = [
                      Parameter{name = Name{"def"}, description = none, `type` = Type{variable = Name{"v"}}, isLazy = true},
                      Parameter{name = Name{"key"}, description = none, `type` = Type{variable = Name{"k"}}, isLazy = false},
                      Parameter{
                        name = Name{"m"},
                        description = none,
                        `type` = Type{
                          application = ApplicationType{
                            function = Type{
                              application = ApplicationType{
                                function = Type{
                                  variable = Name{"Map"}},
                                argument = Type{
                                  variable = Name{"k"}}}},
                            argument = Type{variable = Name{"v"}}}},
                        isLazy = false}],
                    result = Result{
                      description = none,
                      `type` = Type{
                        variable = Name{"v"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "optionals.match: lazy default value prints with 'lazy' keyword",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.termSignature
                  TermSignature{
                    typeParameters = [TypeParameter{name = Name{"x"}, constraints = []}, TypeParameter{name = Name{"y"}, constraints = []}],
                    parameters = [
                      Parameter{
                        name = Name{"m"},
                        description = none,
                        `type` = Type{`optional` = Type{variable = Name{"x"}}},
