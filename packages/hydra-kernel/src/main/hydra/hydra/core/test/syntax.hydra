                            domain = Type{variable = Name{"x"}},
                            codomain = Type{variable = Name{"y"}}}},
                        isLazy = false}],
                    result = Result{
                      description = none,
                      `type` = Type{
                        variable = Name{"y"}}}},
            expected = λ`_`."∀x,y.optional<x> → lazy y → (x → y) → y"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "optionals.match: lazy default value round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λsig2.model.termSignature sig2)
                  (parseTermSignature
                    (model.termSignature
                      TermSignature{
                        typeParameters = [TypeParameter{name = Name{"x"}, constraints = []}, TypeParameter{name = Name{"y"}, constraints = []}],
                        parameters = [
                          Parameter{
                            name = Name{"m"},
                            description = none,
                            `type` = Type{`optional` = Type{variable = Name{"x"}}},
                            isLazy = false},
                          Parameter{name = Name{"def"}, description = none, `type` = Type{variable = Name{"y"}}, isLazy = true},
                          Parameter{
                            name = Name{"f"},
                            description = none,
                            `type` = Type{
                              function = FunctionType{
                                domain = Type{variable = Name{"x"}},
                                codomain = Type{variable = Name{"y"}}}},
                            isLazy = false}],
                        result = Result{
                          description = none,
                          `type` = Type{
                            variable = Name{"y"}}}})),
            expected = λ`_`.model.termSignature
                  TermSignature{
                    typeParameters = [TypeParameter{name = Name{"x"}, constraints = []}, TypeParameter{name = Name{"y"}, constraints = []}],
                    parameters = [
                      Parameter{
                        name = Name{"m"},
                        description = none,
                        `type` = Type{`optional` = Type{variable = Name{"x"}}},
                        isLazy = false},
                      Parameter{name = Name{"def"}, description = none, `type` = Type{variable = Name{"y"}}, isLazy = true},
                      Parameter{
