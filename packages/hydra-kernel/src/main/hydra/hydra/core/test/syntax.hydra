                          typeName = Name{"example.Person"},
                          fieldName = Name{"firstName"}}})),
            expected = λ`_`.model.term
                  Term{
                    `project` = Projection{
                      typeName = Name{"example.Person"},
                      fieldName = Name{"firstName"}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "unwrap sugar: Name[]",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    `unwrap` = Name{"example.Meters"}},
            expected = λ`_`."example.Meters[]"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "unwrap sugar round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `unwrap` = Name{"example.Meters"}})),
            expected = λ`_`.model.term
                  Term{
                    `unwrap` = Name{"example.Meters"}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "cases: '_' default handler round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `cases` = CaseStatement{
                          typeName = Name{"example.Color"},
                          default = given(Term{
                              literal = Literal{
                                `string` = "caution"}}),
                          `cases` = [
                            CaseAlternative{
                              name = Field[name] Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "stop"}}},
                              handler = Field[`term`]
                                  Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "stop"}}}},
                            CaseAlternative{
                              name = Field[name] Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "go"}}},
                              handler = Field[`term`]
                                  Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "go"}}}}]}})),
            expected = λ`_`.model.term
                  Term{
                    `cases` = CaseStatement{
                      typeName = Name{"example.Color"},
                      default = given(Term{
                          literal = Literal{
                            `string` = "caution"}}),
                      `cases` = [
                        CaseAlternative{
                          name = Field[name] Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "stop"}}},
                          handler = Field[`term`]
                              Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "stop"}}}},
                        CaseAlternative{
                          name = Field[name] Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "go"}}},
                          handler = Field[`term`]
                              Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "go"}}}}]}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "cases: '_' default only round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `cases` = CaseStatement{
                          typeName = Name{"example.Color"},
                          default = given(Term{
                              literal = Literal{
                                `string` = "caution"}}),
                          `cases` = []}})),
            expected = λ`_`.model.term
                  Term{
                    `cases` = CaseStatement{
                      typeName = Name{"example.Color"},
                      default = given(Term{
                          literal = Literal{
                            `string` = "caution"}}),
                      `cases` = []}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "case sugar: binder branch → λ-handler, nullary branch as-is, default",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    "case example.Color x { red y = \"r\", green = \"g\", _ = \"c\" }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        `cases` = CaseStatement{
                          typeName = Name{"example.Color"},
                          default = given(Term{
                              literal = Literal{
                                `string` = "c"}}),
                          `cases` = [
                            CaseAlternative{
                              name = Field[name]
                                  Field{
                                    name = Name{"red"},
                                    `term` = Term{
                                      lambda = Lambda{
                                        parameter = Name{"y"},
                                        domain = none,
                                        body = Term{literal = Literal{`string` = "r"}}}}},
                              handler = Field[`term`]
                                  Field{
                                    name = Name{"red"},
                                    `term` = Term{
                                      lambda = Lambda{
                                        parameter = Name{"y"},
                                        domain = none,
                                        body = Term{literal = Literal{`string` = "r"}}}}}},
                            CaseAlternative{
                              name = Field[name] Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "g"}}},
                              handler = Field[`term`] Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "g"}}}}]}},
                      argument = Term{
                        variable = Name{"x"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "case sugar: single nullary branch desugars to applied cases",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    "case example.Color x { red = \"stop\" }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        `cases` = CaseStatement{
                          typeName = Name{"example.Color"},
                          default = none,
                          `cases` = [
                            CaseAlternative{
                              name = Field[name] Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "stop"}}},
                              handler = Field[`term`]
                                  Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "stop"}}}}]}},
                      argument = Term{
                        variable = Name{"x"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "case sugar: binder branch desugars handler to a lambda over the payload",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    "case example.Length len { meters m = m }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        `cases` = CaseStatement{
                          typeName = Name{"example.Length"},
                          default = none,
                          `cases` = [
                            CaseAlternative{
                              name = Field[name]
                                  Field{
                                    name = Name{"meters"},
                                    `term` = Term{
                                      lambda = Lambda{
                                        parameter = Name{"m"},
                                        domain = none,
                                        body = Term{variable = Name{"m"}}}}},
                              handler = Field[`term`]
                                  Field{
                                    name = Name{"meters"},
                                    `term` = Term{
                                      lambda = Lambda{
                                        parameter = Name{"m"},
                                        domain = none,
                                        body = Term{variable = Name{"m"}}}}}}]}},
                      argument = Term{
                        variable = Name{"len"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "case sugar: no-binder branch keeps handler as-is",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    "case example.Color c { red = \"r\", green = \"g\" }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        `cases` = CaseStatement{
                          typeName = Name{"example.Color"},
                          default = none,
                          `cases` = [
                            CaseAlternative{
                              name = Field[name] Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "r"}}},
                              handler = Field[`term`] Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "r"}}}},
                            CaseAlternative{
                              name = Field[name] Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "g"}}},
                              handler = Field[`term`] Field{name = Name{"green"}, `term` = Term{literal = Literal{`string` = "g"}}}}]}},
                      argument = Term{
                        variable = Name{"c"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "case sugar: parenthesized compound scrutinee",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    "case example.Color (f y) { red = \"r\" }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        `cases` = CaseStatement{
                          typeName = Name{"example.Color"},
                          default = none,
                          `cases` = [
                            CaseAlternative{
                              name = Field[name] Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "r"}}},
                              handler = Field[`term`] Field{name = Name{"red"}, `term` = Term{literal = Literal{`string` = "r"}}}}]}},
                      argument = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"f"}},
                          argument = Term{
                            variable = Name{"y"}}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

## Conversion of codepoint offsets to (line, column) positions, with UTF-16 column accounting (#815)
term sourcePositionGroup =
  TestGroup{
    name = "source positions",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "start of text",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "abc" 0:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "abc" 0:int32))],
            expected = λ`_`."0:0"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "within first line",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "abc" 2:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "abc" 2:int32))],
            expected = λ`_`."0:2"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "end of text",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "abc" 3:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "abc" 3:int32))],
            expected = λ`_`."0:3"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "after LF",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "ab\ncd" 3:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "ab\ncd" 3:int32))],
            expected = λ`_`."1:0"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "within second line",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "ab\ncd" 4:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "ab\ncd" 4:int32))],
            expected = λ`_`."1:1"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "at the LF itself",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "ab\ncd" 2:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "ab\ncd" 2:int32))],
            expected = λ`_`."0:2"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "after CR LF counts one line break",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "ab\r\ncd" 4:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "ab\r\ncd" 4:int32))],
            expected = λ`_`."1:0"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "between CR and LF",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "ab\r\ncd" 3:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "ab\r\ncd" 3:int32))],
            expected = λ`_`."0:3"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "lone CR is a line break",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "ab\rcd" 3:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "ab\rcd" 3:int32))],
            expected = λ`_`."1:0"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "blank lines",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "a\n\n\nb" 4:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "a\n\n\nb" 4:int32))],
            expected = λ`_`."3:0"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "BMP non-ASCII is one UTF-16 unit",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "éa" 2:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "éa" 2:int32))],
            expected = λ`_`."0:2"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "astral codepoint is two UTF-16 units",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "😀a" 2:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "😀a" 2:int32))],
            expected = λ`_`."0:3"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "astral codepoint then next line",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "😀\na" 2:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "😀\na" 2:int32))],
            expected = λ`_`."1:0"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "offset beyond end is clamped",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "ab" 10:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "ab" 10:int32))],
            expected = λ`_`."0:2"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "empty text",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.strings.concat
                  [
                    printInt32 (SourcePosition[line] (offsetToPosition "" 0:int32)),
                    ":",
                    printInt32 (SourcePosition[column] (offsetToPosition "" 0:int32))],
            expected = λ`_`."0:0"}},
        description = none,
        tags = [],
        provisions = []}]}

## Source spans recorded by the term parser, and SubtermPath-to-span resolution (#815)
term sourceSpanGroup =
  TestGroup{
    name = "source spans",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "literal",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "42:int32"),
            expected = λ`_`."[0,8)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "span excludes leading whitespace",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "  x"),
            expected = λ`_`."[2,3)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "span excludes trailing whitespace",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "x   "),
            expected = λ`_`."[0,1)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "span excludes trailing comment",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "x # note\n"),
            expected = λ`_`."[0,1)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "application spans function through argument",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "f x"),
            expected = λ`_`."[0,3)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "chained application",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "f x y"),
            expected = λ`_`."[0,5)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "application function",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{applicationFunction}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "f x"),
            expected = λ`_`."[0,1)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "application argument",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{applicationArgument}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "f x"),
            expected = λ`_`."[2,3)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "nested application argument",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{applicationFunction}, SubtermStep{applicationArgument}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "f g x"),
            expected = λ`_`."[2,3)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "list element",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{listElement = 1:int32}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "[1:int32, 22:int32]"),
            expected = λ`_`."[10,18)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "lambda body",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{lambdaBody}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "λx . x"),
            expected = λ`_`."[5,6)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "path that cannot be followed yields the last node reached",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{lambdaBody}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "f x"),
            expected = λ`_`."[0,3)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "parenthesized term",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans "(x)"),
            expected = λ`_`."[0,3)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do block spans the whole construct",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath SubtermPath{[]} t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans
                    "do either { x := f a, g x }"),
            expected = λ`_`."[0,27)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do clause expression keeps its own span",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{applicationFunction}, SubtermStep{applicationArgument}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans
                    "do either { x := f a, g x }"),
            expected = λ`_`."[17,20)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do result expression keeps its own span",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{applicationArgument}, SubtermStep{lambdaBody}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans
                    "do either { x := f a, g x }"),
            expected = λ`_`."[22,25)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do bind primitive falls back to the do block's span",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (spanAtPath
                        SubtermPath{[SubtermStep{applicationFunction}, SubtermStep{applicationFunction}]}
                        t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTermWithSpans
                    "do either { x := f a, g x }"),
            expected = λ`_`."[0,27)"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "strip spans: do block",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term (stripSpans t))
                  (parseTermWithSpans
                    "do either { x := f a, g x }"),
            expected = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term t)
                  (parseTerm "do either { x := f a, g x }")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "strip spans: application",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term (stripSpans t))
                  (parseTermWithSpans "f x y"),
            expected = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term t)
                  (parseTerm "f x y")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "strip spans: lambda",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term (stripSpans t))
                  (parseTermWithSpans "λx . f x"),
            expected = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term t)
                  (parseTerm "λx . f x")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "strip spans: list",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term (stripSpans t))
                  (parseTermWithSpans "[1:int32, 2:int32]"),
            expected = λ`_`.eithers.either
                  (λe.e)
                  (λt.model.term t)
                  (parseTerm "[1:int32, 2:int32]")}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "plain parse records no spans",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt.match
                      (termSpan t)
                      "none"
                      (λsp.strings.concat
                          ["[", printInt32 (SourceSpan[start] sp), ",", printInt32 (SourceSpan[end] sp), ")"]))
                  (parseTerm "f x"),
            expected = λ`_`."none"}},
        description = none,
        tags = [],
        provisions = []}]}

## Print/parse/round-trip cases for term-definition '##' doc comments (#711)
term termDocCommentGroup =
  TestGroup{
    name = "term doc comments",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "single-line description hoists to a leading '##'",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.termDefinition
                  maps.empty
                  TermDefinition{
                    name = Name{"capitalize"},
                    metadata = none,
                    signature = none,
                    body = Term{
                      annotated = AnnotatedTerm{
                        body = Term{
                          variable = Name{"mapFirstLetter"}},
                        annotation = Term{
                          `map` = maps.fromList
                              [
                                (Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "Capitalize the first letter of a string"}})]}}}},
            expected = λ`_`."## Capitalize the first letter of a string\nterm capitalize = mapFirstLetter"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "no description: no leading '##', body prints unchanged",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.termDefinition
                  maps.empty
                  TermDefinition{
                    name = Name{"identity"},
                    metadata = none,
                    signature = none,
                    body = Term{
                      variable = Name{"x"}}},
            expected = λ`_`."term identity = x"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "description plus another key: description hoists, other key stays trailing",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.termDefinition
                  maps.empty
                  TermDefinition{
                    name = Name{"charAt"},
                    metadata = none,
                    signature = none,
                    body = Term{
                      annotated = AnnotatedTerm{
                        body = Term{
                          variable = Name{"impl"}},
                        annotation = Term{
                          `map` = maps.fromList
                              [
                                (Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "Get a character by index"}}),
                                (Term{variable = Name{"availableSince"}}, Term{literal = Literal{`string` = "0.17.6"}})]}}}},
            expected = λ`_`."## Get a character by index\nterm charAt = impl@{availableSince=\"0.17.6\"}"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "inner (non-outermost) description is NOT hoisted",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.termDefinition
                  maps.empty
                  TermDefinition{
                    name = Name{"wrapped"},
                    metadata = none,
                    signature = none,
                    body = Term{
                      application = Application{
                        function = Term{
                          variable = Name{"f"}},
                        argument = Term{
                          annotated = AnnotatedTerm{
                            body = Term{
                              variable = Name{"x"}},
                            annotation = Term{
                              `map` = maps.fromList
                                  [(Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "inner desc"}})]}}}}}},
            expected = λ`_`."term wrapped = f x@{description=\"inner desc\"}"}},
        description = none,
        tags = [],
        provisions = []}]}

## Unqualified (bare) cross-module name printing when provably safe, and the universe-aware parser resolution that makes it round-trip (#5/#711)
term unqualifiedNamesGroup =
  TestGroup{
    name = "unqualified names",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "an UNREFERENCED import's declared name never forces qualification (collision scope = referenced modules only, 2026-11-12)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.moduleDefinitionWith
                  (maps.fromList
                    [
                      (ModuleName{"hydra.logic"}, sets.fromList [Name{"hydra.logic.ifElse"}, Name{"hydra.logic.and"}, Name{"hydra.logic.or"}]),
                      (ModuleName{"hydra.foo"}, sets.fromList [Name{"hydra.foo.ifElse"}, Name{"hydra.foo.bar"}])])
                  Module{
                    name = ModuleName{"hydra.example.ambiguous"},
                    metadata = none,
                    dependencies = [
                      ModuleDependency{`module` = ModuleName{"hydra.logic"}, package = none},
                      ModuleDependency{`module` = ModuleName{"hydra.foo"}, package = none}],
                    definitions = [
                      Definition{
                        `type` = TypeDefinition{
                          name = Name{"hydra.example.ambiguous.UsesIfElse"},
                          metadata = none,
                          body = TypeScheme{
                            variables = [],
                            body = Type{variable = Name{"hydra.logic.ifElse"}},
                            constraints = maps.empty}}}]},
            expected = λ`_`."module hydra.example.ambiguous\n\nimport hydra.logic\n\ntype UsesIfElse = ifElse"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "the unreferenced-import case round-trips (module->print->parse with the same universe)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λmod2.strings.concat
                      [
                        ModuleName[] (Module[name] mod2),
                        "\n",
                        strings.join
                          "\n"
                          (lists.map
                            (λd.cases(Definition){
                                `type`=λtd.strings.concat
                                      [Name[] (TypeDefinition[name] td), " = ", model.typeScheme (TypeDefinition[body] td)],
                                `term`=λtd.strings.concat
                                      [Name[] (TermDefinition[name] td), " = ", model.term (TermDefinition[body] td)],
                                `primitive`=λpd.Name[] (PrimitiveDefinition[name] pd)}
                                d)
                            (Module[definitions] mod2))])
                  (parseModuleWith
                    (maps.fromList
                      [
                        (ModuleName{"hydra.logic"}, sets.fromList [Name{"hydra.logic.ifElse"}, Name{"hydra.logic.and"}, Name{"hydra.logic.or"}]),
                        (ModuleName{"hydra.foo"}, sets.fromList [Name{"hydra.foo.ifElse"}, Name{"hydra.foo.bar"}])])
                    sets.empty
                    (moduleDefinitionWith
                      (maps.fromList
                        [
                          (ModuleName{"hydra.logic"}, sets.fromList [Name{"hydra.logic.ifElse"}, Name{"hydra.logic.and"}, Name{"hydra.logic.or"}]),
                          (ModuleName{"hydra.foo"}, sets.fromList [Name{"hydra.foo.ifElse"}, Name{"hydra.foo.bar"}])])
                      Module{
                        name = ModuleName{"hydra.example.ambiguous"},
                        metadata = none,
                        dependencies = [
                          ModuleDependency{`module` = ModuleName{"hydra.logic"}, package = none},
                          ModuleDependency{`module` = ModuleName{"hydra.foo"}, package = none}],
                        definitions = [
                          Definition{
                            `type` = TypeDefinition{
                              name = Name{"hydra.example.ambiguous.UsesIfElse"},
                              metadata = none,
                              body = TypeScheme{
                                variables = [],
                                body = Type{variable = Name{"hydra.logic.ifElse"}},
                                constraints = maps.empty}}}]})),
            expected = λ`_`.strings.concat
                  [
                    ModuleName[]
                      (Module[name]
                        Module{
                          name = ModuleName{"hydra.example.ambiguous"},
                          metadata = none,
                          dependencies = [
                            ModuleDependency{`module` = ModuleName{"hydra.logic"}, package = none},
                            ModuleDependency{`module` = ModuleName{"hydra.foo"}, package = none}],
                          definitions = [
                            Definition{
                              `type` = TypeDefinition{
                                name = Name{"hydra.example.ambiguous.UsesIfElse"},
                                metadata = none,
                                body = TypeScheme{
                                  variables = [],
                                  body = Type{variable = Name{"hydra.logic.ifElse"}},
                                  constraints = maps.empty}}}]}),
                    "\n",
                    strings.join
                      "\n"
                      (lists.map
                        (λd.cases(Definition){
                            `type`=λtd.strings.concat
                                  [Name[] (TypeDefinition[name] td), " = ", model.typeScheme (TypeDefinition[body] td)],
                            `term`=λtd.strings.concat
                                  [Name[] (TermDefinition[name] td), " = ", model.term (TermDefinition[body] td)],
                            `primitive`=λpd.Name[] (PrimitiveDefinition[name] pd)}
                            d)
                        (Module[definitions]
                          Module{
                            name = ModuleName{"hydra.example.ambiguous"},
                            metadata = none,
                            dependencies = [
                              ModuleDependency{`module` = ModuleName{"hydra.logic"}, package = none},
                              ModuleDependency{`module` = ModuleName{"hydra.foo"}, package = none}],
                            definitions = [
                              Definition{
                                `type` = TypeDefinition{
                                  name = Name{"hydra.example.ambiguous.UsesIfElse"},
                                  metadata = none,
                                  body = TypeScheme{
                                    variables = [],
                                    body = Type{variable = Name{"hydra.logic.ifElse"}},
                                    constraints = maps.empty}}}]}))]}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "a cross-module one-field construct over a KNOWN union type name parses as an injection, not a record (#5/#837)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λmod2.match
                      (lists.head (Module[definitions] mod2))
                      "no-definitions"
                      (λd.cases(Definition){
                          `term`=λtd.cases(Term){
                                `record`=λ`_`."record",
                                `inject`=λ`_`."inject",
                                `_`="not-record-or-inject"}
                                (TermDefinition[body] td),
                          `_`="not-a-term"}
                          d))
                  (parseModuleWith
                    (maps.fromList
                      [(ModuleName{"hydra.shapes"}, sets.fromList [Name{"hydra.shapes.Shape"}])])
                    (sets.fromList
                      [Name{"hydra.shapes.Shape"}])
                    (moduleDefinitionWith
                      (maps.fromList
                        [(ModuleName{"hydra.shapes"}, sets.fromList [Name{"hydra.shapes.Shape"}])])
                      Module{
                        name = ModuleName{"hydra.example.crossmoduleinject"},
                        metadata = none,
                        dependencies = [ModuleDependency{`module` = ModuleName{"hydra.shapes"}, package = none}],
                        definitions = [
                          Definition{
                            `term` = TermDefinition{
                              name = Name{"hydra.example.crossmoduleinject.makeCircle"},
                              metadata = none,
                              signature = none,
                              body = Term{
                                `record` = Record{
                                  typeName = Name{"hydra.shapes.Shape"},
                                  fields = [Field{name = Name{"circle"}, `term` = Term{`unit`}}]}}}}]})),
            expected = λ`_`."inject"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "a declared-but-unreferenced dependency colliding with a referenced one does not break print->parse->print idempotence (2026-11-12)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λmod2.moduleDefinitionWith
                      (maps.fromList
                        [
                          (ModuleName{"hydra.used"}, sets.fromList [Name{"hydra.used.shared"}, Name{"hydra.used.other"}]),
                          (
                            ModuleName{"hydra.unreferencedclash"},
                            sets.fromList [Name{"hydra.unreferencedclash.shared"}, Name{"hydra.unreferencedclash.unrelated"}])])
                      mod2)
                  (parseModuleWith
                    (maps.fromList
                      [
                        (ModuleName{"hydra.used"}, sets.fromList [Name{"hydra.used.shared"}, Name{"hydra.used.other"}]),
                        (
                          ModuleName{"hydra.unreferencedclash"},
                          sets.fromList [Name{"hydra.unreferencedclash.shared"}, Name{"hydra.unreferencedclash.unrelated"}])])
                    sets.empty
                    (moduleDefinitionWith
                      (maps.fromList
                        [
                          (ModuleName{"hydra.used"}, sets.fromList [Name{"hydra.used.shared"}, Name{"hydra.used.other"}]),
                          (
                            ModuleName{"hydra.unreferencedclash"},
                            sets.fromList [Name{"hydra.unreferencedclash.shared"}, Name{"hydra.unreferencedclash.unrelated"}])])
                      Module{
                        name = ModuleName{"hydra.example.idempotenceclash"},
                        metadata = none,
                        dependencies = [
                          ModuleDependency{`module` = ModuleName{"hydra.used"}, package = none},
                          ModuleDependency{`module` = ModuleName{"hydra.unreferencedclash"}, package = none}],
                        definitions = [
                          Definition{
                            `type` = TypeDefinition{
                              name = Name{"hydra.example.idempotenceclash.UsesShared"},
                              metadata = none,
                              body = TypeScheme{
                                variables = [],
                                body = Type{variable = Name{"hydra.used.shared"}},
                                constraints = maps.empty}}}]})),
            expected = λ`_`.moduleDefinitionWith
                  (maps.fromList
                    [
                      (ModuleName{"hydra.used"}, sets.fromList [Name{"hydra.used.shared"}, Name{"hydra.used.other"}]),
                      (
                        ModuleName{"hydra.unreferencedclash"},
                        sets.fromList [Name{"hydra.unreferencedclash.shared"}, Name{"hydra.unreferencedclash.unrelated"}])])
                  Module{
                    name = ModuleName{"hydra.example.idempotenceclash"},
                    metadata = none,
                    dependencies = [
                      ModuleDependency{`module` = ModuleName{"hydra.used"}, package = none},
                      ModuleDependency{`module` = ModuleName{"hydra.unreferencedclash"}, package = none}],
                    definitions = [
                      Definition{
                        `type` = TypeDefinition{
                          name = Name{"hydra.example.idempotenceclash.UsesShared"},
                          metadata = none,
                          body = TypeScheme{
                            variables = [],
                            body = Type{variable = Name{"hydra.used.shared"}},
                            constraints = maps.empty}}}]}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "an import's local name colliding with the module's OWN definition forces qualification",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.moduleDefinitionWith
                  (maps.fromList
                    [(ModuleName{"hydra.lib"}, sets.fromList [Name{"hydra.lib.Widget"}, Name{"hydra.lib.Thing"}])])
                  Module{
                    name = ModuleName{"hydra.example.ownclash"},
                    metadata = none,
                    dependencies = [ModuleDependency{`module` = ModuleName{"hydra.lib"}, package = none}],
                    definitions = [
                      Definition{
                        `type` = TypeDefinition{
                          name = Name{"hydra.example.ownclash.Widget"},
                          metadata = none,
                          body = TypeScheme{
                            variables = [],
                            body = Type{literal = LiteralType{`string`}},
                            constraints = maps.empty}}},
                      Definition{
                        `type` = TypeDefinition{
                          name = Name{"hydra.example.ownclash.UsesLibWidget"},
                          metadata = none,
                          body = TypeScheme{
                            variables = [],
                            body = Type{variable = Name{"hydra.lib.Widget"}},
                            constraints = maps.empty}}}]},
            expected = λ`_`."module hydra.example.ownclash\n\nimport hydra.lib as lib\n\ntype Widget = string\n\ntype UsesLibWidget = lib.Widget"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "own-definition/import local-name collision round-trips, resolving the bare name to the module's own definition",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λmod2.strings.concat
                      [
                        ModuleName[] (Module[name] mod2),
                        "\n",
                        strings.join
                          "\n"
                          (lists.map
                            (λd.cases(Definition){
                                `type`=λtd.strings.concat
                                      [Name[] (TypeDefinition[name] td), " = ", model.typeScheme (TypeDefinition[body] td)],
                                `term`=λtd.strings.concat
                                      [Name[] (TermDefinition[name] td), " = ", model.term (TermDefinition[body] td)],
                                `primitive`=λpd.Name[] (PrimitiveDefinition[name] pd)}
                                d)
                            (Module[definitions] mod2))])
                  (parseModuleWith
                    (maps.fromList
                      [(ModuleName{"hydra.lib"}, sets.fromList [Name{"hydra.lib.Widget"}, Name{"hydra.lib.Thing"}])])
                    sets.empty
                    (moduleDefinitionWith
                      (maps.fromList
                        [(ModuleName{"hydra.lib"}, sets.fromList [Name{"hydra.lib.Widget"}, Name{"hydra.lib.Thing"}])])
                      Module{
                        name = ModuleName{"hydra.example.ownclash"},
                        metadata = none,
                        dependencies = [ModuleDependency{`module` = ModuleName{"hydra.lib"}, package = none}],
                        definitions = [
                          Definition{
                            `type` = TypeDefinition{
                              name = Name{"hydra.example.ownclash.Widget"},
                              metadata = none,
                              body = TypeScheme{
                                variables = [],
                                body = Type{literal = LiteralType{`string`}},
                                constraints = maps.empty}}},
                          Definition{
                            `type` = TypeDefinition{
                              name = Name{"hydra.example.ownclash.UsesLibWidget"},
                              metadata = none,
                              body = TypeScheme{
                                variables = [],
                                body = Type{variable = Name{"hydra.lib.Widget"}},
                                constraints = maps.empty}}}]})),
            expected = λ`_`.strings.concat
                  [
                    ModuleName[]
                      (Module[name]
                        Module{
                          name = ModuleName{"hydra.example.ownclash"},
                          metadata = none,
                          dependencies = [ModuleDependency{`module` = ModuleName{"hydra.lib"}, package = none}],
                          definitions = [
                            Definition{
                              `type` = TypeDefinition{
                                name = Name{"hydra.example.ownclash.Widget"},
                                metadata = none,
                                body = TypeScheme{
                                  variables = [],
                                  body = Type{literal = LiteralType{`string`}},
                                  constraints = maps.empty}}},
                            Definition{
                              `type` = TypeDefinition{
                                name = Name{"hydra.example.ownclash.UsesLibWidget"},
                                metadata = none,
