        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "typed binders round-trip",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        lambda = Lambda{
                          parameter = Name{"a"},
                          domain = given(Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int32`}}}),
                          body = Term{
                            lambda = Lambda{
                              parameter = Name{"b"},
                              domain = given(Type{
                                  literal = LiteralType{
                                    `string`}}),
                              body = Term{
                                variable = Name{"a"}}}}}})),
            expected = λ`_`.model.term
                  Term{
                    lambda = Lambda{
                      parameter = Name{"a"},
                      domain = given(Type{
                          literal = LiteralType{
                            integer = IntegerType{
                              `int32`}}}),
                      body = Term{
                        lambda = Lambda{
                          parameter = Name{"b"},
                          domain = given(Type{
                              literal = LiteralType{
                                `string`}}),
                          body = Term{
                            variable = Name{"a"}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "λ nested under an annotation does NOT collapse across the annotation",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    lambda = Lambda{
                      parameter = Name{"a"},
                      domain = none,
                      body = Term{
                        annotated = AnnotatedTerm{
                          body = Term{
                            lambda = Lambda{
                              parameter = Name{"b"},
                              domain = none,
                              body = Term{
                                variable = Name{"b"}}}},
                          annotation = Term{
                            `map` = maps.fromList
                                [(Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "inner"}})]}}}}},
            expected = λ`_`."λa.(λb.b)@{description=\"inner\"}"}},
