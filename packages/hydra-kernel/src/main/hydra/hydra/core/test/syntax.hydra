## Import aliasing: every cross-module dependency is aliased, and module->print->parse round-trips to an identical module (#711, #804, #805)
term moduleAliasGroup =
  TestGroup{
    name = "import aliases",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "no local-name collision: imports are still aliased (round-trip identity)",
