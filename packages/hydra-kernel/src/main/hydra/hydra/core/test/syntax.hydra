        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "wrap sugar: literal body round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
