## Monadic 'do' sugar (#811): parse-only; 'do <tag> { clauses }' desugars to <tag>s.bind chains
term doSugarGroup =
  TestGroup{
    name = "monadic do sugar",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "do either: two binds + result",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    "do either { x := readFile path, y := decode x, y }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.eithers.bind"}},
                          argument = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"readFile"}},
                              argument = Term{
                                variable = Name{"path"}}}}}},
                      argument = Term{
                        lambda = Lambda{
                          parameter = Name{"x"},
                          domain = none,
                          body = Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.eithers.bind"}},
                                  argument = Term{
                                    application = Application{
                                      function = Term{
                                        variable = Name{"decode"}},
                                      argument = Term{
                                        variable = Name{"x"}}}}}},
                              argument = Term{
                                lambda = Lambda{
                                  parameter = Name{"y"},
                                  domain = none,
                                  body = Term{
                                    variable = Name{"y"}}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do either: multi-line (newlines insignificant)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    "do either {\n  x := readFile path,\n  y := decode x,\n  y\n}"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.eithers.bind"}},
                          argument = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"readFile"}},
                              argument = Term{
                                variable = Name{"path"}}}}}},
                      argument = Term{
                        lambda = Lambda{
                          parameter = Name{"x"},
                          domain = none,
                          body = Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.eithers.bind"}},
                                  argument = Term{
                                    application = Application{
                                      function = Term{
                                        variable = Name{"decode"}},
                                      argument = Term{
                                        variable = Name{"x"}}}}}},
                              argument = Term{
                                lambda = Lambda{
                                  parameter = Name{"y"},
                                  domain = none,
                                  body = Term{
                                    variable = Name{"y"}}}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do optional: single bind",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm "do optional { x := e, x }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.optionals.bind"}},
                          argument = Term{
                            variable = Name{"e"}}}},
                      argument = Term{
                        lambda = Lambda{
                          parameter = Name{"x"},
                          domain = none,
                          body = Term{
                            variable = Name{"x"}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do effect: bare non-final clause uses wildcard binder",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm "do effect { eff, r }"),
            expected = λ`_`.model.term
                  Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.effects.bind"}},
                          argument = Term{
                            variable = Name{"eff"}}}},
                      argument = Term{
                        lambda = Lambda{
                          parameter = Name{"_"},
                          domain = none,
                          body = Term{
                            variable = Name{"r"}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "do list: single result clause (no bind)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm "do list { r }"),
            expected = λ`_`.model.term Term{variable = Name{"r"}}}},
        description = none,
        tags = [],
        provisions = []}]}

## Print/parse/round-trip cases for the multi-binder 'forall a, b.' syntax (#711)
term forallMultiBinderGroup =
  TestGroup{
    name = "forall multi-binder syntax",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "single binder: prints as 'forall a.' (unaffected by collapsing)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.type
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"a"},
                      body = Type{
                        variable = Name{"a"}}}},
            expected = λ`_`."forall a. a"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "single binder: round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.type t2)
                  (parseType
                    (model.type
                      Type{
                        `forall` = ForallType{
                          parameter = Name{"a"},
                          body = Type{
                            variable = Name{"a"}}}})),
            expected = λ`_`.model.type
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"a"},
                      body = Type{
                        variable = Name{"a"}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "three directly-nested foralls collapse into one 'forall a, b, c.'",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.type
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"a"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"b"},
                          body = Type{
                            `forall` = ForallType{
                              parameter = Name{"c"},
                              body = Type{
                                variable = Name{"a"}}}}}}}},
            expected = λ`_`."forall a, b, c. a"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "three directly-nested foralls round-trip",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.type t2)
                  (parseType
                    (model.type
                      Type{
                        `forall` = ForallType{
                          parameter = Name{"a"},
                          body = Type{
                            `forall` = ForallType{
                              parameter = Name{"b"},
                              body = Type{
                                `forall` = ForallType{
                                  parameter = Name{"c"},
                                  body = Type{
                                    variable = Name{"a"}}}}}}}})),
            expected = λ`_`.model.type
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"a"},
                      body = Type{
                        `forall` = ForallType{
                          parameter = Name{"b"},
                          body = Type{
                            `forall` = ForallType{
                              parameter = Name{"c"},
                              body = Type{
                                variable = Name{"a"}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "forall nested under an annotation does NOT collapse across the annotation",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.type
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"a"},
                      body = Type{
                        annotated = AnnotatedType{
                          body = Type{
                            `forall` = ForallType{
                              parameter = Name{"b"},
                              body = Type{
                                variable = Name{"b"}}}},
                          annotation = Term{
                            `map` = maps.fromList
                                [(Term{variable = Name{"tag"}}, Term{literal = Literal{`string` = "x"}})]}}}}},
            expected = λ`_`."forall a. (forall b. b)@{tag=\"x\"}"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "forall nested under an annotation round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.type t2)
                  (parseType
                    (model.type
                      Type{
                        `forall` = ForallType{
                          parameter = Name{"a"},
                          body = Type{
                            annotated = AnnotatedType{
                              body = Type{
                                `forall` = ForallType{
                                  parameter = Name{"b"},
                                  body = Type{
                                    variable = Name{"b"}}}},
                              annotation = Term{
                                `map` = maps.fromList
                                    [(Term{variable = Name{"tag"}}, Term{literal = Literal{`string` = "x"}})]}}}}})),
            expected = λ`_`.model.type
                  Type{
                    `forall` = ForallType{
                      parameter = Name{"a"},
                      body = Type{
                        annotated = AnnotatedType{
                          body = Type{
                            `forall` = ForallType{
                              parameter = Name{"b"},
                              body = Type{
                                variable = Name{"b"}}}},
                          annotation = Term{
                            `map` = maps.fromList
                                [(Term{variable = Name{"tag"}}, Term{literal = Literal{`string` = "x"}})]}}}}}}},
        description = none,
        tags = [],
        provisions = []}]}

## Print/parse/round-trip cases for multi-binder 'λa,b.'/'Λa,b.' syntax (#711)
term lambdaMultiBinderGroup =
  TestGroup{
    name = "lambda/type-lambda multi-binder syntax",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "three directly-nested λ's collapse into one 'λa,b,c.'",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    lambda = Lambda{
                      parameter = Name{"a"},
                      domain = none,
                      body = Term{
                        lambda = Lambda{
                          parameter = Name{"b"},
                          domain = none,
                          body = Term{
                            lambda = Lambda{
                              parameter = Name{"c"},
                              domain = none,
                              body = Term{
                                variable = Name{"a"}}}}}}}},
            expected = λ`_`."λa,b,c.a"}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "three directly-nested λ's round-trip",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        lambda = Lambda{
                          parameter = Name{"a"},
                          domain = none,
                          body = Term{
                            lambda = Lambda{
                              parameter = Name{"b"},
                              domain = none,
                              body = Term{
                                lambda = Lambda{
                                  parameter = Name{"c"},
                                  domain = none,
                                  body = Term{
                                    variable = Name{"a"}}}}}}}})),
            expected = λ`_`.model.term
                  Term{
                    lambda = Lambda{
                      parameter = Name{"a"},
                      domain = none,
                      body = Term{
                        lambda = Lambda{
                          parameter = Name{"b"},
                          domain = none,
                          body = Term{
                            lambda = Lambda{
                              parameter = Name{"c"},
                              domain = none,
                              body = Term{
                                variable = Name{"a"}}}}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "typed binders collapse with each binder keeping its own domain type",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.model.term
                  Term{
                    lambda = Lambda{
                      parameter = Name{"a"},
