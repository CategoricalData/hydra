                              body = Term{
                                lambda = Lambda{
                                  parameter = Name{"b"},
                                  domain = none,
                                  body = Term{
                                    variable = Name{"b"}}}},
                              annotation = Term{
                                `map` = maps.fromList
                                    [(Term{variable = Name{"description"}}, Term{literal = Literal{`string` = "inner"}})]}}}}})),
            expected = λ`_`.model.term
                  Term{
                    lambda = Lambda{
                      parameter = Name{"a"},
