## Round-trip test cases for the textual syntax
module hydra.core.test.syntax

import hydra.core.lib.eithers as eithers
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.packaging
import hydra.core.parse.core
import hydra.core.parse.packaging
import hydra.core.parsing
import hydra.core.paths
import hydra.core.positions
import hydra.core.print.model as model
import hydra.core.print.packaging
import hydra.core.test.testTerms
import hydra.core.test.testTypes
import hydra.core.testing
import hydra.core.typing

## Test cases for the textual syntax (#497/#710)
term allTests =
  TestGroup{
    name = "textual syntax",
    description = none,
    subgroups = [
      annotationRoundtripGroup,
      corpusRoundtripGroup,
      doSugarGroup,
      forallMultiBinderGroup,
      lambdaMultiBinderGroup,
      lazyParameterRoundtripGroup,
      moduleAliasGroup,
      multiLineDocCommentGroup,
      nominalSugarGroup,
      sourceSpanGroup,
      sourcePositionGroup,
      termDocCommentGroup,
      unqualifiedNamesGroup],
    `cases` = []}

## Annotation round-trip cases tied to syntax.md #1's HYDRA-SYN-ROUND-TRIP / HYDRA-SYN-PRINTER-FAITHFUL provisions (#497)
term annotationRoundtripGroup =
  TestGroup{
    name = "annotation round-trips",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "annotated literal round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `inject` = Injection{
                          typeName = Name{"hydra.core.model.Term"},
                          field = Field{
                            name = Name{"annotated"},
                            `term` = Term{
                              `record` = Record{
                                typeName = Name{"hydra.core.model.AnnotatedTerm"},
                                fields = [
                                  Field{name = Name{"body"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}},
                                  Field{
                                    name = Name{"annotation"},
                                    `term` = Term{
                                      `map` = maps.mapKeys
                                          (λn.Term{variable = n})
                                          (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "the answer"}})])}}]}}}}})),
            expected = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"hydra.core.model.Term"},
                      field = Field{
                        name = Name{"annotated"},
                        `term` = Term{
                          `record` = Record{
                            typeName = Name{"hydra.core.model.AnnotatedTerm"},
                            fields = [
                              Field{name = Name{"body"}, `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}},
                              Field{
                                name = Name{"annotation"},
                                `term` = Term{
                                  `map` = maps.mapKeys
                                      (λn.Term{variable = n})
                                      (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "the answer"}})])}}]}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "annotated variable round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `inject` = Injection{
                          typeName = Name{"hydra.core.model.Term"},
                          field = Field{
                            name = Name{"annotated"},
                            `term` = Term{
                              `record` = Record{
                                typeName = Name{"hydra.core.model.AnnotatedTerm"},
                                fields = [
                                  Field{name = Name{"body"}, `term` = Term{variable = Name{"x"}}},
                                  Field{
                                    name = Name{"annotation"},
                                    `term` = Term{
                                      `map` = maps.mapKeys
                                          (λn.Term{variable = n})
                                          (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "a variable"}})])}}]}}}}})),
            expected = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"hydra.core.model.Term"},
                      field = Field{
                        name = Name{"annotated"},
                        `term` = Term{
                          `record` = Record{
                            typeName = Name{"hydra.core.model.AnnotatedTerm"},
                            fields = [
                              Field{name = Name{"body"}, `term` = Term{variable = Name{"x"}}},
                              Field{
                                name = Name{"annotation"},
                                `term` = Term{
                                  `map` = maps.mapKeys
                                      (λn.Term{variable = n})
                                      (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "a variable"}})])}}]}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "annotated application round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `inject` = Injection{
                          typeName = Name{"hydra.core.model.Term"},
                          field = Field{
                            name = Name{"annotated"},
                            `term` = Term{
                              `record` = Record{
                                typeName = Name{"hydra.core.model.AnnotatedTerm"},
                                fields = [
                                  Field{
                                    name = Name{"body"},
                                    `term` = Term{
                                      application = Application{
                                        function = Term{variable = Name{"f"}},
                                        argument = Term{variable = Name{"x"}}}}},
                                  Field{
                                    name = Name{"annotation"},
                                    `term` = Term{
                                      `map` = maps.mapKeys
                                          (λn.Term{variable = n})
                                          (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "a call"}})])}}]}}}}})),
            expected = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"hydra.core.model.Term"},
                      field = Field{
                        name = Name{"annotated"},
                        `term` = Term{
                          `record` = Record{
                            typeName = Name{"hydra.core.model.AnnotatedTerm"},
                            fields = [
                              Field{
                                name = Name{"body"},
                                `term` = Term{
                                  application = Application{
                                    function = Term{variable = Name{"f"}},
                                    argument = Term{variable = Name{"x"}}}}},
                              Field{
                                name = Name{"annotation"},
                                `term` = Term{
                                  `map` = maps.mapKeys
                                      (λn.Term{variable = n})
                                      (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "a call"}})])}}]}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "stacked annotations round-trip (chains left)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `inject` = Injection{
                          typeName = Name{"hydra.core.model.Term"},
                          field = Field{
                            name = Name{"annotated"},
                            `term` = Term{
                              `record` = Record{
                                typeName = Name{"hydra.core.model.AnnotatedTerm"},
                                fields = [
                                  Field{
                                    name = Name{"body"},
                                    `term` = Term{
                                      `inject` = Injection{
                                        typeName = Name{"hydra.core.model.Term"},
                                        field = Field{
                                          name = Name{"annotated"},
                                          `term` = Term{
                                            `record` = Record{
                                              typeName = Name{"hydra.core.model.AnnotatedTerm"},
                                              fields = [
                                                Field{name = Name{"body"}, `term` = Term{variable = Name{"x"}}},
                                                Field{
                                                  name = Name{"annotation"},
                                                  `term` = Term{
                                                    `map` = maps.mapKeys
                                                        (λn.Term{variable = n})
                                                        (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "inner"}})])}}]}}}}}},
                                  Field{
                                    name = Name{"annotation"},
                                    `term` = Term{
                                      `map` = maps.mapKeys
                                          (λn.Term{variable = n})
                                          (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "outer"}})])}}]}}}}})),
            expected = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"hydra.core.model.Term"},
                      field = Field{
                        name = Name{"annotated"},
                        `term` = Term{
                          `record` = Record{
                            typeName = Name{"hydra.core.model.AnnotatedTerm"},
                            fields = [
                              Field{
                                name = Name{"body"},
                                `term` = Term{
                                  `inject` = Injection{
                                    typeName = Name{"hydra.core.model.Term"},
                                    field = Field{
                                      name = Name{"annotated"},
                                      `term` = Term{
                                        `record` = Record{
                                          typeName = Name{"hydra.core.model.AnnotatedTerm"},
                                          fields = [
                                            Field{name = Name{"body"}, `term` = Term{variable = Name{"x"}}},
                                            Field{
                                              name = Name{"annotation"},
                                              `term` = Term{
                                                `map` = maps.mapKeys
                                                    (λn.Term{variable = n})
                                                    (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "inner"}})])}}]}}}}}},
                              Field{
                                name = Name{"annotation"},
                                `term` = Term{
                                  `map` = maps.mapKeys
                                      (λn.Term{variable = n})
                                      (maps.fromList [(Name{"description"}, Term{literal = Literal{`string` = "outer"}})])}}]}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "annotation with a compound (non-atomic) payload round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.term t2)
                  (parseTerm
                    (model.term
                      Term{
                        `inject` = Injection{
                          typeName = Name{"hydra.core.model.Term"},
                          field = Field{
                            name = Name{"annotated"},
                            `term` = Term{
                              `record` = Record{
                                typeName = Name{"hydra.core.model.AnnotatedTerm"},
                                fields = [
                                  Field{name = Name{"body"}, `term` = Term{variable = Name{"x"}}},
                                  Field{
                                    name = Name{"annotation"},
                                    `term` = Term{
                                      application = Application{
                                        function = Term{variable = Name{"f"}},
                                        argument = Term{variable = Name{"y"}}}}}]}}}}})),
            expected = λ`_`.model.term
                  Term{
                    `inject` = Injection{
                      typeName = Name{"hydra.core.model.Term"},
                      field = Field{
                        name = Name{"annotated"},
                        `term` = Term{
                          `record` = Record{
                            typeName = Name{"hydra.core.model.AnnotatedTerm"},
                            fields = [
                              Field{name = Name{"body"}, `term` = Term{variable = Name{"x"}}},
                              Field{
                                name = Name{"annotation"},
                                `term` = Term{
                                  application = Application{
                                    function = Term{variable = Name{"f"}},
                                    argument = Term{variable = Name{"y"}}}}}]}}}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "annotated type round-trips",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.type t2)
                  (parseType
                    (model.type
                      Type{
                        annotated = AnnotatedType{
                          body = Type{
                            literal = LiteralType{
                              `string`}},
                          annotation = Term{
                            `map` = maps.mapKeys
                                (λn.Term{
                                    variable = n})
                                (maps.fromList
                                  [(Name{"description"}, Term{literal = Literal{`string` = "a type"}})])}}})),
            expected = λ`_`.model.type
                  Type{
                    annotated = AnnotatedType{
                      body = Type{
                        literal = LiteralType{
                          `string`}},
                      annotation = Term{
                        `map` = maps.mapKeys
                            (λn.Term{
                                variable = n})
                            (maps.fromList
                              [(Name{"description"}, Term{literal = Literal{`string` = "a type"}})])}}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "stacked type annotations round-trip (chains left)",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.e)
                  (λt2.model.type t2)
                  (parseType
                    (model.type
                      Type{
                        annotated = AnnotatedType{
                          body = Type{
                            annotated = AnnotatedType{
                              body = Type{
                                literal = LiteralType{
                                  `string`}},
                              annotation = Term{
                                `map` = maps.mapKeys
                                    (λn.Term{
                                        variable = n})
                                    (maps.fromList
                                      [(Name{"inner"}, Term{literal = Literal{`string` = "i"}})])}}},
                          annotation = Term{
                            `map` = maps.mapKeys
                                (λn.Term{
                                    variable = n})
                                (maps.fromList
                                  [(Name{"outer"}, Term{literal = Literal{`string` = "o"}})])}}})),
            expected = λ`_`.model.type
                  Type{
                    annotated = AnnotatedType{
                      body = Type{
                        annotated = AnnotatedType{
                          body = Type{
                            literal = LiteralType{
                              `string`}},
                          annotation = Term{
                            `map` = maps.mapKeys
                                (λn.Term{
                                    variable = n})
                                (maps.fromList
                                  [(Name{"inner"}, Term{literal = Literal{`string` = "i"}})])}}},
                      annotation = Term{
                        `map` = maps.mapKeys
                            (λn.Term{
                                variable = n})
                            (maps.fromList
                              [(Name{"outer"}, Term{literal = Literal{`string` = "o"}})])}}}}},
        description = none,
        tags = [],
        provisions = []}]}

## General print->parse->print round-trip sweep over the kernel test-fixture corpus (#497)
