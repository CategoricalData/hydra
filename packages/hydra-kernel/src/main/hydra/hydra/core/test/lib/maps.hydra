## Test cases for hydra.core.lib.maps primitives
term allTests =
  TestGroup{
    name = "hydra.core.lib.maps primitives",
    description = none,
    subgroups = [
      TestGroup{
        name = "insertsUpdatesOrDeletes",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "insert new key",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λm.model.map
                        (λn.printInt32 n)
                        (λs.printString s)
                        m)
                      (maps.alter
                        (λ`_`.given("new"))
                        3:int32
                        {1:int32="a", 2:int32="b"}),
                expected = λ`_`.(λm.model.map
                        (λn.printInt32 n)
                        (λs.printString s)
                        m)
                      {
                        1:int32="a",
                        2:int32="b",
                        3:int32="new"}}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.maps.alter.insertsUpdatesOrDeletes"}]},
          TestCaseWithMetadata{
            name = "update existing key",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λm.model.map
                        (λn.printInt32 n)
                        (λs.printString s)
                        m)
                      (maps.alter
                        (λ`_`.given("updated"))
                        2:int32
                        {1:int32="a", 2:int32="b"}),
                expected = λ`_`.(λm.model.map
                        (λn.printInt32 n)
                        (λs.printString s)
                        m)
                      {1:int32="a", 2:int32="updated"}}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.maps.alter.insertsUpdatesOrDeletes"}]},
          TestCaseWithMetadata{
            name = "delete key",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.(λm.model.map
                        (λn.printInt32 n)
                        (λs.printString s)
                        m)
                      (maps.alter
                        (λ`_`.none)
                        2:int32
                        {1:int32="a", 2:int32="b"}),
                expected = λ`_`.(λm.model.map
                        (λn.printInt32 n)
                        (λs.printString s)
                        m)
                      {1:int32="a"}}},
            description = none,
            tags = [],
            provisions = [Name{"hydra.core.lib.maps.alter.insertsUpdatesOrDeletes"}]}]},
