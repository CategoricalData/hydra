## Inference tests for nominal types
module hydra.core.test.inference.nominalTypes

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.test.testGraph
import hydra.core.test.testTerms
import hydra.core.test.testTypes
import hydra.core.testing

## Nominal type tests
term allTests =
  TestGroup{
    name = "Nominal terms",
    description = none,
    subgroups = [testGroupForCaseStatements, testGroupForProjections, testGroupForRecords, testGroupForVariants, testGroupForWrappers],
    `cases` = []}

term testGroupForCaseStatements =
  TestGroup{
    name = "Case statements",
    description = none,
    subgroups = [],
    `cases` = [
      TestCaseWithMetadata{
        name = "#1",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.concat2 "INFERENCE ERROR: " "failed")
                  (λresult.typeScheme (second (first result)))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `cases` = CaseStatement{
                        typeName = testTypeSimpleNumberName,
                        default = none,
                        `cases` = [
                          CaseAlternative{
                            name = Name{"int"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{variable = Name{"x"}}}}},
                          CaseAlternative{
                            name = Name{"float"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  literal = Literal{
                                    integer = IntegerValue{
                                      `int32` = 42:int32}}}}}}]}}),
            expected = λ`_`.typeScheme
                  TypeScheme{
                    variables = [],
                    body = Type{
                      function = FunctionType{
                        domain = Type{
                          variable = testTypeSimpleNumberName},
                        codomain = Type{
                          literal = LiteralType{
                            integer = IntegerType{
                              `int32`}}}}},
                    constraints = {}}}},
        description = none,
        tags = [],
        provisions = []},
      TestCaseWithMetadata{
        name = "#2",
        case = TestCase{
          universal = UniversalTestCase{
            actual = λ`_`.eithers.either
                  (λe.concat2 "INFERENCE ERROR: " "failed")
                  (λresult.typeScheme (second (first result)))
                  (inferTypeOf
                    testContext
                    testGraph
                    Term{
                      `cases` = CaseStatement{
                        typeName = testTypeUnionMonomorphicName,
                        default = none,
                        `cases` = [
                          CaseAlternative{
                            name = Name{"bool"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"_"},
                                domain = none,
                                body = Term{literal = Literal{`boolean` = true}}}}},
                          CaseAlternative{
                            name = Name{"string"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"_"},
                                domain = none,
                                body = Term{literal = Literal{`boolean` = false}}}}},
                          CaseAlternative{
                            name = Name{"unit"},
                            handler = Term{
                              lambda = Lambda{
                                parameter = Name{"_"},
                                domain = none,
                                body = Term{literal = Literal{`boolean` = false}}}}}]}}),
            expected = λ`_`.typeScheme
                  TypeScheme{
                    variables = [],
                    body = Type{
                      function = FunctionType{
                        domain = Type{
                          variable = testTypeUnionMonomorphicName},
                        codomain = Type{
                          literal = LiteralType{
                            `boolean`}}}},
                    constraints = {}}}},
        description = none,
        tags = [],
        provisions = []}]}

term testGroupForProjections =
  TestGroup{
    name = "Projections",
    description = none,
    subgroups = [
      TestGroup{
        name = "Record eliminations",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `project` = Projection{
                            typeName = testTypePersonName,
                            fieldName = Name{"firstName"}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = testTypePersonName},
                            codomain = Type{
                              literal = LiteralType{
                                `string`}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Pair projections",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          variable = Name{"hydra.core.lib.pairs.first"}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              pair = PairType{
                                first = Type{
                                  variable = Name{"t0"}},
                                second = Type{
                                  variable = Name{"t1"}}}},
                            codomain = Type{
                              variable = Name{"t0"}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.pairs.second"}},
                            argument = Term{
                              pair = (Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}}, Term{literal = Literal{`string` = "foo"}})}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          literal = LiteralType{
                            `string`}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]}],
    `cases` = []}

