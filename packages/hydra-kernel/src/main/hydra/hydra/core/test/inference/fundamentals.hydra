      TestGroup{
        name = "Multiple references to a let-bound term",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"foo"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none},
                              Binding{
                                name = Name{"bar"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 137:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `list` = [Term{variable = Name{"foo"}}, Term{variable = Name{"bar"}}, Term{variable = Name{"foo"}}]}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
