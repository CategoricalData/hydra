## Inference tests for fundamental language features
module hydra.core.test.inference.fundamentals

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.test.testGraph
import hydra.core.testing

## Fundamental language feature tests
term allTests =
  TestGroup{
    name = "Fundamentals",
    description = none,
    subgroups = [
      testGroupForLambdas,
      testGroupForLet,
      testGroupForLiterals,
      testGroupForPathologicalTerms,
      testGroupForPolymorphism,
      testGroupForPrimitives],
    `cases` = []}

term testGroupForLambdas =
  TestGroup{
    name = "Lambdas",
    description = none,
    subgroups = [
      TestGroup{
        name = "Simple lambdas",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"x"},
                            domain = none,
                            body = Term{
                              variable = Name{"x"}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              variable = Name{"t0"}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"x"},
                            domain = none,
                            body = Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int16` = 137:int16}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int16`}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Nested lambdas",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"x"},
                            domain = none,
                            body = Term{
                              lambda = Lambda{
                                parameter = Name{"y"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.add"}},
                                        argument = Term{
                                          variable = Name{"x"}}}},
                                    argument = Term{
                                      variable = Name{"y"}}}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              function = FunctionType{
                                domain = Type{
                                  variable = Name{"t0"}},
                                codomain = Type{
                                  variable = Name{"t0"}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"numeric"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"x"},
                            domain = none,
                            body = Term{
                              `list` = [
                                Term{
                                  lambda = Lambda{
                                    parameter = Name{"y"},
                                    domain = none,
                                    body = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.add"}},
                                            argument = Term{
                                              variable = Name{"x"}}}},
                                        argument = Term{variable = Name{"y"}}}}}}]}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              `list` = Type{
                                function = FunctionType{
                                  domain = Type{
                                    variable = Name{"t0"}},
                                  codomain = Type{
                                    variable = Name{"t0"}}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"numeric"}}}}}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Nested lambdas with shadowing",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"x"},
                            domain = none,
                            body = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.add"}},
                                        argument = Term{
                                          variable = Name{"x"}}}},
                                    argument = Term{
                                      literal = Literal{
                                        integer = IntegerValue{
                                          `int32` = 42:int32}}}}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              function = FunctionType{
                                domain = Type{
                                  literal = LiteralType{
                                    integer = IntegerType{
                                      `int32`}}},
                                codomain = Type{
                                  literal = LiteralType{
                                    integer = IntegerType{
                                      `int32`}}}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]}],
    `cases` = []}

term testGroupForLet =
  TestGroup{
    name = "Let terms",
    description = none,
    subgroups = [
      TestGroup{
        name = "Simple",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"x"},
                                `term` = Term{literal = Literal{float = FloatValue{`float32` = 42.0:float32}}},
                                typeScheme = none}],
                            body = Term{
                              lambda = Lambda{
                                parameter = Name{"y"},
                                domain = none,
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"z"},
                                    domain = none,
                                    body = Term{
                                      variable = Name{"x"}}}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"t0"}},
                            codomain = Type{
                              function = FunctionType{
                                domain = Type{
                                  variable = Name{"t1"}},
                                codomain = Type{
                                  literal = LiteralType{
                                    float = FloatType{
                                      `float32`}}}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
