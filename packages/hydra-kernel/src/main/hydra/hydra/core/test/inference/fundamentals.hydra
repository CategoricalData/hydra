                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"foo"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `let` = Let{
                                bindings = [
                                  Binding{
                                    name = Name{"bar"},
                                    `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 137:int32}}},
                                    typeScheme = none}],
                                body = Term{
                                  `list` = [Term{variable = Name{"foo"}}, Term{variable = Name{"bar"}}]}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `list` = Type{
                            literal = LiteralType{
                              integer = IntegerType{
                                `int32`}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"foo"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none}],
                            body = Term{
                              `let` = Let{
                                bindings = [
                                  Binding{
                                    name = Name{"bar"},
                                    `term` = Term{
                                      pair = (Term{variable = Name{"foo"}}, Term{literal = Literal{integer = IntegerValue{`int32` = 137:int32}}})},
                                    typeScheme = none}],
                                body = Term{
                                  variable = Name{"bar"}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          pair = PairType{
                            first = Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int32`}}},
                            second = Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int32`}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"sng"},
                                `term` = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{`list` = [Term{variable = Name{"x"}}]}}},
                                typeScheme = none}],
                            body = Term{
                              `let` = Let{
                                bindings = [
                                  Binding{
                                    name = Name{"foo"},
                                    `term` = Term{
                                      application = Application{
                                        function = Term{variable = Name{"sng"}},
                                        argument = Term{
                                          literal = Literal{
                                            integer = IntegerValue{
                                              `int32` = 42:int32}}}}},
                                    typeScheme = none},
                                  Binding{
                                    name = Name{"bar"},
                                    `term` = Term{
                                      application = Application{
                                        function = Term{variable = Name{"sng"}},
                                        argument = Term{literal = Literal{`string` = "bar"}}}},
                                    typeScheme = none},
                                  Binding{
                                    name = Name{"quux"},
                                    `term` = Term{
                                      lambda = Lambda{
                                        parameter = Name{"x"},
                                        domain = none,
                                        body = Term{
                                          application = Application{
                                            function = Term{variable = Name{"sng"}},
