                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"square"},
                                `term` = Term{
                                  lambda = Lambda{
                                    parameter = Name{"z"},
                                    domain = none,
                                    body = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.mul"}},
                                            argument = Term{
                                              variable = Name{"z"}}}},
                                        argument = Term{variable = Name{"z"}}}}}},
                                typeScheme = none}],
                            body = Term{
                              lambda = Lambda{
                                parameter = Name{"f"},
                                domain = none,
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{
                                      lambda = Lambda{
                                        parameter = Name{"y"},
                                        domain = none,
                                        body = Term{
                                          application = Application{
                                            function = Term{
                                              application = Application{
                                                function = Term{
                                                  application = Application{
                                                    function = Term{
                                                      variable = Name{"hydra.core.lib.logic.ifElse"}},
                                                    argument = Term{
                                                      application = Application{
                                                        function = Term{
                                                          application = Application{
                                                            function = Term{
                                                              variable = Name{"f"}},
                                                            argument = Term{
                                                              application = Application{
                                                                function = Term{
                                                                  variable = Name{"square"}},
                                                                argument = Term{
                                                                  variable = Name{"x"}}}}}},
                                                        argument = Term{
                                                          variable = Name{"y"}}}}}},
                                                argument = Term{
                                                  application = Application{
                                                    function = Term{
                                                      application = Application{
                                                        function = Term{
                                                          variable = Name{"f"}},
                                                        argument = Term{
                                                          variable = Name{"x"}}}},
                                                    argument = Term{
