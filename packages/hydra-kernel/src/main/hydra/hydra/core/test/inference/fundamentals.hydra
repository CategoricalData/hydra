            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"foo"},
                                `term` = Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}},
                                typeScheme = none}],
                            body = Term{
