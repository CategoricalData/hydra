term testGroupForEithers =
  TestGroup{
    name = "Either terms",
    description = none,
    subgroups = [
      TestGroup{
        name = "Left values",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `list` = [
                            Term{`either` = left(Term{literal = Literal{`string` = "error"}})},
                            Term{`either` = right(Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}})}]}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `list` = Type{
                            `either` = EitherType{
                              `left` = Type{
                                literal = LiteralType{
                                  `string`}},
                              `right` = Type{
                                literal = LiteralType{
                                  integer = IntegerType{
                                    `int32`}}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `either` = left(Term{
                              literal = Literal{
                                `string` = "error"}})}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          `either` = EitherType{
                            `left` = Type{
                              literal = LiteralType{
                                `string`}},
                            `right` = Type{
                              variable = Name{"t0"}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Right values",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `list` = [
                            Term{`either` = right(Term{literal = Literal{integer = IntegerValue{`int32` = 42:int32}}})},
                            Term{`either` = left(Term{literal = Literal{`string` = "error"}})}]}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `list` = Type{
                            `either` = EitherType{
                              `left` = Type{
                                literal = LiteralType{
                                  `string`}},
                              `right` = Type{
                                literal = LiteralType{
                                  integer = IntegerType{
                                    `int32`}}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `either` = right(Term{
                              literal = Literal{
                                integer = IntegerValue{
                                  `int32` = 42:int32}}})}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          `either` = EitherType{
                            `left` = Type{
                              variable = Name{"t0"}},
                            `right` = Type{
                              literal = LiteralType{
                                integer = IntegerType{
                                  `int32`}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Polymorphic either values",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `either` = left(Term{
                              `list` = []})}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          `either` = EitherType{
                            `left` = Type{
                              `list` = Type{
                                variable = Name{"t0"}}},
                            `right` = Type{
                              variable = Name{"t1"}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `either` = right(Term{
                              `list` = []})}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          `either` = EitherType{
                            `left` = Type{
                              variable = Name{"t0"}},
                            `right` = Type{
                              `list` = Type{
                                variable = Name{"t1"}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Nested either values",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          `list` = [
                            Term{`either` = left(Term{`either` = left(Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}})})},
                            Term{`either` = left(Term{`either` = right(Term{literal = Literal{`string` = "nested"}})})},
                            Term{`either` = right(Term{literal = Literal{`boolean` = true}})}]}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `list` = Type{
                            `either` = EitherType{
                              `left` = Type{
                                `either` = EitherType{
                                  `left` = Type{
                                    literal = LiteralType{
                                      integer = IntegerType{
                                        `int32`}}},
                                  `right` = Type{
                                    literal = LiteralType{
