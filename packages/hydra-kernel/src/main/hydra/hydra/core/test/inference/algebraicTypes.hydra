                              TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.sets.map"}},
                            argument = Term{
                              variable = Name{"hydra.core.lib.lists.length"}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              `set` = Type{
                                `list` = Type{
                                  variable = Name{"t0"}}}},
                            codomain = Type{
                              `set` = Type{
                                literal = LiteralType{
                                  integer = IntegerType{
                                    `int32`}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Composing collection primitives in let",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
