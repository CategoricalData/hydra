                        Term{
                          `let` = Let{
                            bindings = [
                              Binding{
                                name = Name{"f"},
                                `term` = Term{
                                  application = Application{
                                    function = Term{variable = Name{"hydra.core.lib.maps.map"}},
                                    argument = Term{variable = Name{"hydra.core.lib.sets.fromList"}}}},
                                typeScheme = none},
                              Binding{
                                name = Name{"g"},
                                `term` = Term{
                                  application = Application{
                                    function = Term{variable = Name{"f"}},
                                    argument = Term{
                                      `map` = {
                                        Term{literal = Literal{`string` = "a"}}=Term{
                                          `list` = [
                                            Term{literal = Literal{integer = IntegerValue{`int32` = 1:int32}}},
                                            Term{literal = Literal{integer = IntegerValue{`int32` = 2:int32}}}]}}}}},
                                typeScheme = none}],
                            body = Term{
                              variable = Name{"g"}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [],
                        body = Type{
                          `map` = MapType{
                            keys = Type{
                              literal = LiteralType{
                                `string`}},
                            values = Type{
                              `set` = Type{
                                literal = LiteralType{
                                  integer = IntegerType{
                                    `int32`}}}}}},
                        constraints = {}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "Map operations in lambdas",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
