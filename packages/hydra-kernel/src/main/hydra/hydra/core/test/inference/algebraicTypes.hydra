                        Term{
                          lambda = Lambda{
                            parameter = Name{"m"},
                            domain = none,
                            body = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.maps.map"}},
                                    argument = Term{
                                      variable = Name{"hydra.core.lib.lists.length"}}}},
                                argument = Term{
                                  variable = Name{"m"}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  `list` = Type{
                                    variable = Name{"t1"}}}}},
                            codomain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  literal = LiteralType{
                                    integer = IntegerType{
                                      `int32`}}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          lambda = Lambda{
                            parameter = Name{"f"},
                            domain = none,
                            body = Term{
                              lambda = Lambda{
                                parameter = Name{"m"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.maps.map"}},
                                        argument = Term{
                                          variable = Name{"f"}}}},
                                    argument = Term{
                                      variable = Name{"m"}}}}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}, Name{"t2"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              function = FunctionType{
                                domain = Type{
                                  variable = Name{"t0"}},
                                codomain = Type{
                                  variable = Name{"t1"}}}},
                            codomain = Type{
                              function = FunctionType{
                                domain = Type{
                                  `map` = MapType{
                                    keys = Type{
                                      variable = Name{"t2"}},
                                    values = Type{
                                      variable = Name{"t0"}}}},
                                codomain = Type{
                                  `map` = MapType{
                                    keys = Type{
                                      variable = Name{"t2"}},
                                    values = Type{
                                      variable = Name{"t1"}}}}}}}},
                        constraints = {
                          Name{"t2"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
