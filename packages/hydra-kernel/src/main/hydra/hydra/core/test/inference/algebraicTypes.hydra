## Inference tests for algebraic data types
module hydra.core.test.inference.algebraicTypes

import hydra.core.inference
import hydra.core.lib.eithers as eithers
import hydra.core.lib.pairs
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.test.testGraph
import hydra.core.testing

## Algebraic data type tests
term allTests =
  TestGroup{
    name = "Algebraic terms",
    description = none,
    subgroups = [
      testGroupForCollectionPrimitives,
      testGroupForEithers,
      testGroupForFolds,
      testGroupForLists,
      testGroupForMaps,
      testGroupForOptionals,
      testGroupForPairs,
      testGroupForSets],
    `cases` = []}

term testGroupForCollectionPrimitives =
  TestGroup{
    name = "Collection primitives",
    description = none,
    subgroups = [
      TestGroup{
        name = "maps.map applied to a function",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.maps.map"}},
                            argument = Term{
                              variable = Name{"hydra.core.lib.math.negate"}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  variable = Name{"t1"}}}},
                            codomain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  variable = Name{"t1"}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}},
                          Name{"t1"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"numeric"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#2",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.maps.map"}},
                            argument = Term{
                              lambda = Lambda{
                                parameter = Name{"x"},
                                domain = none,
                                body = Term{
                                  `list` = [Term{variable = Name{"x"}}]}}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  variable = Name{"t1"}}}},
                            codomain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  `list` = Type{
                                    variable = Name{"t1"}}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "#3",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.concat2 "INFERENCE ERROR: " "failed")
                      (λresult.typeScheme (second (first result)))
                      (inferTypeOf
                        testContext
                        testGraph
                        Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.maps.map"}},
                            argument = Term{
                              variable = Name{"hydra.core.lib.sets.fromList"}}}}),
                expected = λ`_`.typeScheme
                      TypeScheme{
                        variables = [Name{"t0"}, Name{"t1"}],
                        body = Type{
                          function = FunctionType{
                            domain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  `list` = Type{
                                    variable = Name{"t1"}}}}},
                            codomain = Type{
                              `map` = MapType{
                                keys = Type{
                                  variable = Name{"t0"}},
                                values = Type{
                                  `set` = Type{
                                    variable = Name{"t1"}}}}}}},
                        constraints = {
                          Name{"t0"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}},
                          Name{"t1"}=TypeVariableConstraints{classes = {TypeClassConstraint{simple = Name{"ordering"}}}}}}}},
            description = none,
            tags = [],
            provisions = []}]},
      TestGroup{
        name = "sets.map applied to a function",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "#1",
            case = TestCase{
              universal = UniversalTestCase{
