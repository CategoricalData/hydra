import hydra.core.testing

## Test cases for code generation operations
term allTests =
  TestGroup{
    name = "generation",
    description = none,
    subgroups = [
      TestGroup{
        name = "generateModuleDoc",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "generateModuleDoc renders a documented term definition's doc string and signature",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.document
                      (generateModuleDoc
                        Module{
                          name = ModuleName{"hydra.testInput.doc"},
                          metadata = none,
                          dependencies = [],
                          definitions = [
                            Definition{
                              `term` = TermDefinition{
                                name = Name{"hydra.testInput.doc.identity"},
                                metadata = given(EntityMetadata{
                                    description = given("The identity function"),
                                    comments = [],
                                    seeAlso = [],
                                    lifecycle = none,
                                    provisions = []}),
                                signature = given(typeSchemeToTermSignature
                                    TypeScheme{
                                      variables = [Name{"a"}],
                                      body = Type{
                                        function = FunctionType{
                                          domain = Type{
                                            variable = Name{"a"}},
                                          codomain = Type{
                                            variable = Name{"a"}}}},
                                      constraints = {}}),
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{variable = Name{"x"}}}}}}]}),
                expected = λ`_`."# hydra.testInput.doc\n\n<!-- Note: this is an automatically generated file. Do not edit. -->\n\n## hydra.testInput.doc.identity\n\nThe identity function\n\n`∀a.a → a`"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "generateModuleDoc renders multiple definitions as separate sections in declaration order",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.document
                      (generateModuleDoc
                        Module{
                          name = ModuleName{"hydra.testInput.doc"},
                          metadata = none,
