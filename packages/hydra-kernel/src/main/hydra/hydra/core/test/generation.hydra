                                        name = Name{"hydra.testInput.prim.example.constantValue"},
                                        kind = ProvisionKind{requirement},
                                        statement = "This primitive always returns the same string value."}]}),
                                signature = typeSchemeToTermSignature
                                    TypeScheme{
                                      variables = [],
