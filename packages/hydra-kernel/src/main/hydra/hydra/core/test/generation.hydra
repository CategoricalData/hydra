                                      constraints = {}}),
                                body = Term{
                                  lambda = Lambda{
                                    parameter = Name{"x"},
                                    domain = none,
                                    body = Term{variable = Name{"x"}}}}}}]}),
                expected = λ`_`."# hydra.testInput.doc\n\n<!-- Note: this is an automatically generated file. Do not edit. -->\n\n## hydra.testInput.doc.identity\n\nThe identity function\n\n`∀a.a → a`\n\n## hydra.testInput.doc.identity2\n\n*(undocumented)*\n\n`∀a.a → a`"}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "generateModuleDoc renders a primitive's monomorphic signature (no forall clause) and its provision",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.document
                      (generateModuleDoc
                        Module{
                          name = ModuleName{"hydra.testInput.prim"},
                          metadata = none,
                          dependencies = [],
                          definitions = [
                            Definition{
                              `primitive` = PrimitiveDefinition{
                                name = Name{"hydra.testInput.prim.example"},
                                metadata = given(EntityMetadata{
