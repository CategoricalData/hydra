 "Documentation, lifecycle, and normative metadata attachable to a packaging entity (package, module, or definition). Bundling these fields in one type lets future metadata be added without changing the field shape of the entities that carry it."}}}}}}@{`type`=model.Type}, model.Name{"hydra.core.packaging.EntityReference"}=model.Type{annotated = model.AnnotatedType{body = model.Type{`union` = [model.FieldType{name = model.Name{"definition"}, `type` = model.Type{annotated = model.AnnotatedType{body = model.Type{variable = model.Name{"hydra.core.packaging.DefinitionReference"}}, annotation = model.Term{`map` = {model.Term{variable = model.Name{"description"}}=model.Term{literal = model.Literal{`string` = "A reference to a definition (type, term, or primitive), by name"}}}}}}}, model.FieldType{name = model.Name{"module"}, `type` = model.Type{annotated = model.AnnotatedType{body = model.Type{variable = model.Name{"hydra.core.packaging.ModuleName"}}, annotation = model.Term{`map` = {model.Term{variable = model.Name{"description"}}=model.Term{literal = model.Literal{`string` = "A reference to a module, by name"}}}}}}}, model.FieldType{name = model.Name{"package"}, `type` = model.Type{annotated = model.AnnotatedType{body = model.Type{variable = model.Name{"hydra.core.packaging.PackageName"}}, annotation = model.Term{`map` = {model.Term{variable = model.Name{"description"}}=model.Term{literal = model.Literal{`string` = "A reference to a package, by name"}}}}}}}, model.FieldType{name = model.Name{"termExpr"}, `type` = model.Type{annotated = model.AnnotatedType{body = model.Type{literal = model.LiteralType{`string`}}, annotation = model.Term{`map` = {model.Term{variable = model.Name{"description"}}=model.Term{literal = model.Literal{`string` = "An inline term expression in Hydra textual syntax"}}}}}}}, model.FieldType{name = model.Name{"typeExpr"}, `type` = model.Type{annotated = model.AnnotatedType{body = model.Type{literal = model.LiteralType{`string`}}, annotation = model.