## General-purpose parser combinators, operating on a Parser type. A helper library, not a set of parse<T> convention functions (see docs/specification/index.md, Conventions).
module hydra.core.parsers

import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic as logic
import hydra.core.lib.math as math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering as ordering
import hydra.core.lib.pairs as pairs
import hydra.core.lib.strings as strings
import hydra.core.parsing as parsing

## Try the first parser; if it fails without consuming input, try the second
term alt = λp1,p2.let parse := λinput.cases(parsing.ParseResult){success=λs.parsing.ParseResult{success = s}, failure=λe.logic.ifElse (equality.equal (parsing.ParseInput[offset] (parsing.ParseError[remainder] e)) (parsing.ParseInput[offset] input)) (parsing.Parser[] p2 input) parsing.ParseResult{failure = e}} (parsing.Parser[] p1 input) in wrap(parsing.Parser){parse}

## Parse any single character (codepoint)
term anyChar = satisfy (λ`_`.true)

## Apply a parser containing a function to a parser containing a value
term apply = λpf,pa.let parse := λinput.cases(parsing.ParseResult){success=λsf.cases(parsing.ParseResult){success=λsa.parsing.ParseResult{success = parsing.ParseSuccess{value = parsing.ParseSuccess[value] sf (parsing.ParseSuccess[value] sa), remainder = parsing.ParseSuccess[remainder] sa}}, failure=λe.parsing.ParseResult{failure = e}} (parsing.Parser[] pa (parsing.ParseSuccess[remainder] sf)), failure=λe.parsing.ParseResult{failure = e}} (parsing.Parser[] pf input) in wrap(parsing.Parser){parse}

## Parse something between an opening and closing parser
term between = λopen,close,p.bind open (λ`_`.bind p (λx.bind close (λ`_`.pure x)))

## Sequence two parsers, passing the result of the first to a function that produces the second
term bind = λpa,f.let parse := λinput.cases(parsing.ParseResult){success=λs.parsing.Parser[] (f (parsing.ParseSuccess[value] s)) (parsing.ParseSuccess[remainder] s), failure=λe.parsing.ParseResult{failure = e}} (parsing.Parser[] pa input) in wrap(parsing.Parser){parse}

## Parse a specific character (codepoint)
term char = λc.satisfy (λx.equality.equal x c)

## Try each parser in the list until one succeeds
term choice = λps.lists.foldl alt (fail "no choice matched") ps

## A parser that succeeds only at the end of input
term eof = parsing.Parser{λinput.logic.ifElse (lists.isEmpty (parsing.ParseInput[codepoints] input)) parsing.ParseResult{success = parsing.ParseSuccess{value, remainder = input}} parsing.ParseResult{failure = parsing.ParseError{message = "expected end of input", remainder = input}}}

## A parser that always fails with the given error message
term fail = λmsg.parsing.Parser{λinput.parsing.ParseResult{failure = parsing.ParseError{message = msg, remainder = input}}}

## Create a parser that defers construction of another parser until parsing time. This is essential for breaking recursive parser definitions.
term lazy = λf.parsing.Parser{λinput.parsing.Parser[] (f unit) input}

## Parse zero or more occurrences of the given parser
term many = λp.let parse := λinput.manyLoop p input [] in wrap(parsing.Parser){parse}

## Repeatedly apply a parser, accumulating results, until it fails
term manyLoop = λp,input,acc.cases(parsing.ParseResult){success=λs.manyLoop p (parsing.ParseSuccess[remainder] s) (lists.cons (parsing.ParseSuccess[value] s) acc), failure=λ`_`.parsing.ParseResult{success = parsing.ParseSuccess{value = lists.reverse acc, remainder = input}}} (parsing.Parser[] p input)

## Apply a function to the result of a parser
term map = λf,pa.let parse := λinput.cases(parsing.ParseResult){success=λs.parsing.ParseResult{success = parsing.ParseSuccess{value = f (parsing.ParseSuccess[value] s), remainder = parsing.ParseSuccess[remainder] s}}, failure=λe.parsing.ParseResult{failure = e}} (parsing.Parser[] pa input) in wrap(parsing.Parser){parse}

## Record that a token has just been completed, so that a surrounding 'spanned' parser can end its span here rather than after any trailing whitespace or comments. Consumes no input.
term markTokenEnd = parsing.Parser{λinput.parsing.ParseResult{success = parsing.ParseSuccess{value, remainder = parsing.ParseInput{offset = parsing.ParseInput[offset] input, tokenEnd = parsing.ParseInput[offset] input, codepoints = parsing.ParseInput[codepoints] input}}}}

## Optionally parse something, returning Nothing if it fails
term optional = λp.alt (`map` optionals.given p) (pure none)

## A parser that always succeeds with the given value without consuming input
term pure = λa.parsing.Parser{λinput.parsing.ParseResult{success = parsing.ParseSuccess{value = a, remainder = input}}}

## Run a parser on the given input string. The string is converted to a codepoint list once, up front, so that the parser itself can consume characters in constant time.
term runParser = λp,input.parsing.Parser[] p parsing.ParseInput{offset = 0:int32, tokenEnd = 0:int32, codepoints = strings.toList input}

## Parse a character (codepoint) that satisfies the given predicate
term satisfy = λpred.let parse := λinput.optionals.match (lists.uncons (parsing.ParseInput[codepoints] input)) parsing.ParseResult{failure = parsing.ParseError{message = "unexpected end of input", remainder = input}} (λuc.let c := pairs.first uc in let rest := pairs.second uc in logic.ifElse (pred c) parsing.ParseResult{success = parsing.ParseSuccess{value = c, remainder = parsing.ParseInput{offset = math.add (parsing.ParseInput[offset] input) 1:int32, tokenEnd = parsing.ParseInput[tokenEnd] input, codepoints = rest}}} parsing.ParseResult{failure = parsing.ParseError{message = "character did not satisfy predicate", remainder = input}}) in wrap(parsing.Parser){parse}

## Parse zero or more occurrences separated by a separator
term sepBy = λp,sep.alt (sepBy1 p sep) (pure [])

## Parse one or more occurrences separated by a separator
term sepBy1 = λp,sep.bind p (λx.bind (many (bind sep (λ`_`.p))) (λxs.pure (lists.cons x xs)))

## Parse one or more occurrences of the given parser
term some = λp.bind p (λx.bind (many p) (λxs.pure (lists.cons x xs)))

## Run a parser and pair its result with the source span it consumed. The span starts at the first codepoint the parser consumed and ends at the end of the last token it completed (see markTokenEnd), so trailing whitespace and comments are excluded.
term spanned = λp.let parse := λinput.cases(parsing.ParseResult){success=λs.let start := parsing.ParseInput[offset] input in let end := ordering.max start (parsing.ParseInput[tokenEnd] (parsing.ParseSuccess[remainder] s)) in parsing.ParseResult{success = parsing.ParseSuccess{value = (parsing.ParseSuccess[value] s, parsing.SourceSpan{start = start, end = end}), remainder = parsing.ParseSuccess[remainder] s}}, failure=λe.parsing.ParseResult{failure = e}} (parsing.Parser[] p input) in wrap(parsing.Parser){parse}

## Parse a specific string
term string = λstr.let strCodes := strings.toList str in let strLen := lists.length strCodes in parsing.Parser{λinput.let inputPrefix := lists.take strLen (parsing.ParseInput[codepoints] input) in logic.ifElse (equality.equal strCodes inputPrefix) parsing.ParseResult{success = parsing.ParseSuccess{value = str, remainder = parsing.ParseInput{offset = math.add (parsing.ParseInput[offset] input) strLen, tokenEnd = parsing.ParseInput[tokenEnd] input, codepoints = lists.drop strLen (parsing.ParseInput[codepoints] input)}}} parsing.ParseResult{failure = parsing.ParseError{message = strings.concat2 "expected: " str, remainder = input}}}

## Make a parser's failure backtrackable, rewinding to the original input on failure
term try = λp.let parse := λinput.cases(parsing.ParseResult){success=λs.parsing.ParseResult{success = s}, failure=λe.parsing.ParseResult{failure = parsing.ParseError{message = parsing.ParseError[message] e, remainder = input}}} (parsing.Parser[] p input) in wrap(parsing.Parser){parse}