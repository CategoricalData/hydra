## Functions for generating term decoders from type modules
module hydra.core.decoding

import hydra.core.annotations as annotations
import hydra.core.constants as constants
import hydra.core.decode.model as decode.model
import hydra.core.encode.model as encode.model
import hydra.core.errors as errors
import hydra.core.lib.eithers as eithers
import hydra.core.lib.lists as lists
import hydra.core.lib.logic as logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model as model
import hydra.core.names as names
import hydra.core.packaging as packaging
import hydra.core.predicates as predicates
import hydra.core.scoping as scoping

## Left-apply type-variable params to a base type in binder order (fixes param reversal)
term applyForallParamsInOrder = λbase,params.lists.foldl (λacc,p.model.Type{application = model.ApplicationType{function = acc, argument = model.Type{variable = p}}}) base params

## Collect forall type variable names from a type
term collectForallVariables = λtyp.cases(model.Type){annotated=λat.collectForallVariables (model.AnnotatedType[body] at), `forall`=λft.lists.cons (model.ForallType[parameter] ft) (collectForallVariables (model.ForallType[body] ft)), `_`=[]} typ

## Collect type variables needing Ord constraints (from Map key and Set element types)
term collectOrdConstrainedVariables = λtyp.cases(model.Type){annotated=λat.collectOrdConstrainedVariables (model.AnnotatedType[body] at), application=λappType.lists.concat2 (collectOrdConstrainedVariables (model.ApplicationType[function] appType)) (collectOrdConstrainedVariables (model.ApplicationType[argument] appType)), `effect`=λelemType.collectOrdConstrainedVariables elemType, `either`=λet.lists.concat2 (collectOrdConstrainedVariables (model.EitherType[`left`] et)) (collectOrdConstrainedVariables (model.EitherType[`right`] et)), `forall`=λft.collectOrdConstrainedVariables (model.ForallType[body] ft), `list`=λelemType.collectOrdConstrainedVariables elemType, `map`=λmt.lists.concat [collectTypeVariablesFromType (model.MapType[keys] mt), collectOrdConstrainedVariables (model.MapType[keys] mt), collectOrdConstrainedVariables (model.MapType[values] mt)], `optional`=λelemType.collectOrdConstrainedVariables elemType, pair=λpt.lists.concat2 (collectOrdConstrainedVariables (model.PairType[first] pt)) (collectOrdConstrainedVariables (model.PairType[second] pt)), `record`=λrt.lists.concat (lists.map (λft.collectOrdConstrainedVariables (model.FieldType[`type`] ft)) rt), `set`=λelemType.lists.concat2 (collectTypeVariablesFromType elemType) (collectOrdConstrainedVariables elemType), `union`=λrt.lists.concat (lists.map (λft.collectOrdConstrainedVariables (model.FieldType[`type`] ft)) rt), `wrap`=λwt.collectOrdConstrainedVariables wt, `_`=[]} typ

## Collect type variable names from a type (forall parameters only)
term collectTypeVariables = λtyp.collectForallVariables typ

## Collect all type variable names from a type expression
term collectTypeVariablesFromType = λtyp.cases(model.Type){annotated=λat.collectTypeVariablesFromType (model.AnnotatedType[body] at), application=λappType.lists.concat2 (collectTypeVariablesFromType (model.ApplicationType[function] appType)) (collectTypeVariablesFromType (model.ApplicationType[argument] appType)), `effect`=λelemType.collectTypeVariablesFromType elemType, `either`=λet.lists.concat2 (collectTypeVariablesFromType (model.EitherType[`left`] et)) (collectTypeVariablesFromType (model.EitherType[`right`] et)), `forall`=λft.collectTypeVariablesFromType (model.ForallType[body] ft), `list`=λelemType.collectTypeVariablesFromType elemType, `map`=λmt.lists.concat2 (collectTypeVariablesFromType (model.MapType[keys] mt)) (collectTypeVariablesFromType (model.MapType[values] mt)), `optional`=λelemType.collectTypeVariablesFromType elemType, pair=λpt.lists.concat2 (collectTypeVariablesFromType (model.PairType[first] pt)) (collectTypeVariablesFromType (model.PairType[second] pt)), `record`=λrt.lists.concat (lists.map (λft.collectTypeVariablesFromType (model.FieldType[`type`] ft)) rt), `set`=λelemType.collectTypeVariablesFromType elemType, `union`=λrt.lists.concat (lists.map (λft.collectTypeVariablesFromType (model.FieldType[`type`] ft)) rt), variable=λname.[name], `wrap`=λwt.collectTypeVariablesFromType wt, `_`=[]} typ

## Transform a type binding into a decoder binding
term decodeBinding = λcx,graph,b.eithers.bind (decode.model.type graph (model.Binding[`term`] b)) (λtyp.let rtype := decoderFullResultTypeNamed (model.Binding[name] b) typ in let rawBody := decodeTypeNamed (model.Binding[name] b) typ rtype in let description := strings.concat ["Decoder for ", model.Name[] (model.Binding[name] b)] in right(model.Binding{name = decodeBindingName (model.Binding[name] b), `term` = annotations.setTermDescription given(description) rawBody, typeScheme = given(decoderTypeSchemeNamed (model.Binding[name] b) typ)}))

## Generate a binding name for a decoder function from a type name
term decodeBindingName = names.derivedBindingName ["decode"] true

## Generate a decoder for an Either type
term decodeEitherType = λet.let leftDecoder := decodeType (model.EitherType[`left`] et) in let rightDecoder := decodeType (model.EitherType[`right`] et) in model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.extract.model.decodeEither"}}, `type` = decoderFullResultType (model.EitherType[`left`] et)}}, `type` = decoderFullResultType (model.EitherType[`right`] et)}}, argument = leftDecoder}}, argument = rightDecoder}}

## Generate a decoder for a polymorphic (forall) type
term decodeForallType = λft.model.Term{lambda = model.Lambda{parameter = decodeBindingName (model.ForallType[parameter] ft), domain = given(model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.graph.Graph"}}, codomain = model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.model.Term"}}, codomain = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = model.Type{variable = model.ForallType[parameter] ft}}}}}}}), body = decodeType (model.ForallType[body] ft)}}

## Generate a decoder for a list type
term decodeListType = λelemType.let elemDecoder := decodeType elemType in model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.extract.model.decodeList"}}, `type` = decoderFullResultType elemType}}, argument = elemDecoder}}

## Generate a decoder for a literal type
term decodeLiteralType = λlt.cases(model.LiteralType){`binary`=λ`_`.model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"raw"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.either"}}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}, `type` = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = model.Type{literal = model.LiteralType{`binary`}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"err"}, domain = given(model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{variable = model.Name{"err"}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`binary`}}}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"stripped"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{`cases` = model.CaseStatement{typeName = model.Name{"hydra.core.model.Term"}, default = given(model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "expected literal"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`binary`}}}}), `cases` = [model.CaseAlternative{name = model.Name{"literal"}, handler = model.Term{lambda = model.Lambda{parameter = model.Name{"v"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Literal"}}), body = model.Term{application = model.Application{function = model.Term{`cases` = model.CaseStatement{typeName = model.Name{"hydra.core.model.Literal"}, default = given(model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "expected binary literal"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`binary`}}}}), `cases` = [model.CaseAlternative{name = model.Name{"binary"}, handler = model.Term{lambda = model.Lambda{parameter = model.Name{"b"}, domain = given(model.Type{literal = model.LiteralType{`binary`}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = right(model.Term{variable = model.Name{"b"}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`binary`}}}}}}}]}}, argument = model.Term{variable = model.Name{"v"}}}}}}}]}}, argument = model.Term{variable = model.Name{"stripped"}}}}}}}}, argument = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{variable = model.Name{"hydra.core.extract.model.stripWithDecodingError"}}, argument = model.Term{variable = model.Name{"cx"}}}}, argument = model.Term{variable = model.Name{"raw"}}}}}}}}}}, `boolean`=λ`_`.model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"raw"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.either"}}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}, `type` = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = model.Type{literal = model.LiteralType{`boolean`}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"err"}, domain = given(model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{variable = model.Name{"err"}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`boolean`}}}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"stripped"}, domain = given(model.Type{variable = model.Name{"hydra.core.m