## Generate a decoder for a map type
term decodeMapType =
  λmt.
    let keyDecoder := decodeType (MapType[keys] mt) in
    let valDecoder := decodeType (MapType[values] mt) in
    Term{
      application = Application{
        function = Term{
          application = Application{
            function = Term{
              typeApplication = TypeApplicationTerm{
                body = Term{
                  typeApplication = TypeApplicationTerm{
                    body = Term{
                      variable = Name{"hydra.core.extract.model.decodeMap"}},
                    `type` = decoderFullResultType (MapType[keys] mt)}},
                `type` = decoderFullResultType
                    (MapType[values] mt)}},
            argument = keyDecoder}},
        argument = valDecoder}}

## Generate a decoder for an optional type
term decodeMaybeType =
  λelemType.
    let elemDecoder := decodeType elemType
    in Term{
      application = Application{
        function = Term{
          typeApplication = TypeApplicationTerm{
            body = Term{
              variable = Name{"hydra.core.extract.model.decodeMaybe"}},
            `type` = decoderFullResultType elemType}},
        argument = elemDecoder}}

## Transform a type module into a decoder module
term decodeModule =
  λcx,graph,mod.eithers.bind
      (filterTypeBindings
        cx
        graph
        (optionals.givens
          (lists.map
            (λd.cases(Definition){
                `type`=λtd.given((λname,typ.
                      let schemaTerm := Term{
                        variable = Name{"hydra.core.model.Type"}} in
                      let dataTerm := normalizeTermAnnotations
                          Term{
                            annotated = AnnotatedTerm{
                              body = encode.model.type typ,
                              annotation = wrapAnnotationMap
                                  (maps.fromList [(keyType, schemaTerm)])}} in
                      Binding{
                        name = name,
                        `term` = dataTerm,
                        typeScheme = given(TypeScheme{
                            variables = [],
                            body = Type{
                              variable = Name{"hydra.core.model.Type"}},
                            constraints = maps.empty})})
                      (TypeDefinition[name] td)
                      (TypeScheme[body] (TypeDefinition[body] td))),
                `_`=none}
                d)
            (Module[definitions] mod))))
      (λtypeBindings.ifElse
          (lists.isEmpty typeBindings)
          right(none)
          (eithers.bind
            (eithers.mapList
              (λb.eithers.bimap (λ`_e`.Error{decoding = `_e`}) (λx.x) (decodeBinding cx graph b))
              typeBindings)
            (λdecodedBindings.
              let allDecodedDeps := lists.distinct
                  (lists.map
                    decodeModuleName
                    (lists.map
                      (λdep.ModuleDependency[`module`] dep)
                      (Module[dependencies] mod)))
              in right(given(Module{
                name = decodeModuleName (Module[name] mod),
                metadata = given(EntityMetadata{
                    description = given(strings.concat
                        ["Term decoders for ", ModuleName[] (Module[name] mod)]),
                    comments = [],
                    seeAlso = [],
                    lifecycle = none,
                    provisions = []}),
                dependencies = lists.map
                    (λns.ModuleDependency{
                        `module` = ns,
                        package = none})
                    (lists.concat2
                      [
                        ModuleName{"hydra.core.extract.model"},
                        ModuleName{"hydra.core.lexical"},
                        ModuleName{"hydra.core.rewriting"},
                        Module[name] mod,
                        ModuleName{"hydra.core.util"}]
                      allDecodedDeps),
                definitions = lists.map
                    (λb.Definition{
                        `term` = TermDefinition{
                          name = Binding[name] b,
                          metadata = none,
                          signature = optionals.map
                              typeSchemeToTermSignature
                              (Binding[typeScheme] b),
                          body = Binding[`term`] b}})
                    decodedBindings})))))

## Generate a decoder module name from a source module name
term decodeModuleName = derivedModuleName ["decode"] true

## Generate a decoder for a pair type
term decodePairType =
  λpt.
    let firstDecoder := decodeType (PairType[first] pt) in
    let secondDecoder := decodeType (PairType[second] pt) in
    Term{
      application = Application{
        function = Term{
          application = Application{
            function = Term{
              typeApplication = TypeApplicationTerm{
                body = Term{
                  typeApplication = TypeApplicationTerm{
                    body = Term{
                      variable = Name{"hydra.core.extract.model.decodePair"}},
                    `type` = decoderFullResultType
                        (PairType[first] pt)}},
                `type` = decoderFullResultType
                    (PairType[second] pt)}},
            argument = firstDecoder}},
        argument = secondDecoder}}

## Generate a decoder for a record type
term decodeRecordType = λrt.decodeRecordTypeImpl Name{"unknown"} rt Type{variable = Name{"unknown"}}

## Generate a decoder for a record type with a type name. rtype is the fully-applied result type (e.g. Table<v>) used for the record's body annotations. (#476)
term decodeRecordTypeImpl =
  λtname,rt,rtype.
    let recType := rtype in
    let graphType := Type{variable = Name{"hydra.core.graph.Graph"}} in
    let termType := Type{variable = Name{"hydra.core.model.Term"}} in
    let decodeFieldTerm := λft.Term{
          application = Application{
            function = Term{
              application = Application{
                function = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          typeApplication = TypeApplicationTerm{
                            body = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  typeApplication = TypeApplicationTerm{
                                    body = Term{
                                      variable = Name{"hydra.core.extract.model.requireField"}},
                                    `type` = graphType}},
                                `type` = termType}},
                            `type` = decoderFullResultType
                                (FieldType[`type`] ft)}},
                        argument = Term{
                          literal = Literal{
                            `string` = Name[] (FieldType[name] ft)}}}},
                    argument = decodeType (FieldType[`type`] ft)}},
                argument = Term{
                  variable = Name{"fieldMap"}}}},
            argument = Term{variable = Name{"cx"}}}} in
    let localVarName := λft.Name{strings.concat ["field_", Name[] (FieldType[name] ft)]} in
    let toFieldLambda := λft,body.Term{
          lambda = Lambda{
            parameter = localVarName ft,
            domain = given(decoderFullResultType
                (FieldType[`type`] ft)),
            body = body}} in
    let decodeBody := lists.foldl
        (λacc,ft.Term{
            application = Application{
              function = Term{
                application = Application{
                  function = Term{
                    typeApplication = TypeApplicationTerm{
                      body = Term{
                        typeApplication = TypeApplicationTerm{
                          body = Term{
                            typeApplication = TypeApplicationTerm{
                              body = Term{
                                variable = Name{"hydra.core.lib.eithers.bind"}},
                              `type` = Type{
                                variable = Name{"hydra.core.errors.DecodingError"}}}},
                          `type` = decoderFullResultType
                              (FieldType[`type`] ft)}},
                      `type` = recType}},
                  argument = decodeFieldTerm ft}},
              argument = toFieldLambda ft acc}})
        Term{
          typeApplication = TypeApplicationTerm{
            body = Term{
              typeApplication = TypeApplicationTerm{
                body = Term{
                  `either` = right(Term{
                      `record` = Record{
                        typeName = tname,
                        fields = lists.map
                            (λft.Field{
                                name = FieldType[name] ft,
                                `term` = Term{
                                  variable = localVarName ft}})
                            rt}})},
                `type` = Type{
                  variable = Name{"hydra.core.errors.DecodingError"}}}},
            `type` = recType}}
        (lists.reverse rt) in
    Term{
      lambda = Lambda{
        parameter = Name{"cx"},
        domain = given(Type{variable = Name{"hydra.core.graph.Graph"}}),
        body = Term{
          lambda = Lambda{
            parameter = Name{"raw"},
            domain = given(Type{
                variable = Name{"hydra.core.model.Term"}}),
            body = Term{
              application = Application{
                function = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          typeApplication = TypeApplicationTerm{
                            body = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  typeApplication = TypeApplicationTerm{
                                    body = Term{
                                      variable = Name{"hydra.core.lib.eithers.either"}},
                                    `type` = Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}}},
                                `type` = Type{
                                  variable = Name{"hydra.core.model.Term"}}}},
                            `type` = Type{
                              `either` = EitherType{
                                `left` = Type{
                                  variable = Name{"hydra.core.errors.DecodingError"}},
                                `right` = recType}}}},
                        argument = Term{
                          lambda = Lambda{
                            parameter = Name{"err"},
                            domain = given(Type{
                                variable = Name{"hydra.core.errors.DecodingError"}}),
                            body = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  typeApplication = TypeApplicationTerm{
                                    body = Term{
                                      `either` = left(Term{
                                          variable = Name{"err"}})},
                                    `type` = Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}}},
                                `type` = recType}}}}}},
                    argument = Term{
                      lambda = Lambda{
                        parameter = Name{"stripped"},
                        domain = given(Type{
                            variable = Name{"hydra.core.model.Term"}}),
                        body = Term{
                          application = Application{
                            function = Term{
                              `cases` = CaseStatement{
                                typeName = Name{"hydra.core.model.Term"},
                                default = given(Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            `either` = left(Term{
                                                `wrap` = WrappedTerm{
                                                  typeName = Name{"hydra.core.errors.DecodingError"},
                                                  body = Term{
                                                    literal = Literal{
                                                      `string` = strings.concat
                                                          ["expected a record of type ", Name[] tname]}}}})},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = recType}}),
                                `cases` = [
                                  CaseAlternative{
                                    name = Name{"record"},
                                    handler = Term{
                                      lambda = Lambda{
                                        parameter = Name{"record"},
                                        domain = given(Type{variable = Name{"hydra.core.model.Record"}}),
                                        body = Term{
                                          `let` = Let{
                                            bindings = [
                                              Binding{
                                                name = Name{"fieldMap"},
                                                `term` = Term{
                                                  application = Application{
                                                    function = Term{
                                                      variable = Name{"hydra.core.extract.model.toFieldMap"}},
                                                    argument = Term{variable = Name{"record"}}}},
                                                typeScheme = given(TypeScheme{
                                                    variables = [],
                                                    body = Type{
                                                      `map` = MapType{
                                                        keys = Type{
                                                          variable = Name{"hydra.core.model.Name"}},
                                                        values = Type{
                                                          variable = Name{"hydra.core.model.Term"}}}},
                                                    constraints = maps.empty})}],
                                            body = decodeBody}}}}}]}},
                            argument = Term{
                              variable = Name{"stripped"}}}}}}}},
                argument = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          variable = Name{"hydra.core.extract.model.stripWithDecodingError"}},
                        argument = Term{
                          variable = Name{"cx"}}}},
                    argument = Term{
                      variable = Name{"raw"}}}}}}}}}}

## Generate a decoder for a record type with element name
term decodeRecordTypeNamed = λename,rt,rtype.decodeRecordTypeImpl ename rt rtype

## Generate a decoder for a set type
term decodeSetType =
  λelemType.
    let elemDecoder := decodeType elemType
    in Term{
      application = Application{
        function = Term{
          typeApplication = TypeApplicationTerm{
            body = Term{
              variable = Name{"hydra.core.extract.model.decodeSet"}},
            `type` = decoderFullResultType elemType}},
        argument = elemDecoder}}

## Generate a decoder term for a Type
term decodeType =
  λtyp.cases(Type){
      annotated=λat.decodeType (AnnotatedType[body] at),
      application=λappType.Term{
            application = Application{
              function = Term{
                typeApplication = TypeApplicationTerm{
                  body = decodeType
                      (ApplicationType[function] appType),
                  `type` = decoderFullResultType
                      (ApplicationType[argument] appType)}},
              argument = decodeType
                  (ApplicationType[argument] appType)}},
      `either`=λet.decodeEitherType et,
      `forall`=λft.decodeForallType ft,
      `list`=λelemType.decodeListType elemType,
      literal=λlt.decodeLiteralType lt,
      `map`=λmt.decodeMapType mt,
      `optional`=λelemType.decodeMaybeType elemType,
      pair=λpt.decodePairType pt,
      `record`=λrt.decodeRecordType rt,
      `set`=λelemType.decodeSetType elemType,
      `union`=λrt.decodeUnionType rt,
      `unit`=λ`_`.decodeUnitType,
      `void`=λ`_`.decodeUnitType,
      `wrap`=λwt.decodeWrappedType wt,
      variable=λtypeName.Term{variable = decodeBindingName typeName},
      `_`=Term{
        lambda = Lambda{
          parameter = Name{"cx"},
          domain = given(Type{variable = Name{"hydra.core.graph.Graph"}}),
          body = Term{
            lambda = Lambda{
              parameter = Name{"t"},
              domain = given(Type{
                  variable = Name{"hydra.core.model.Term"}}),
              body = Term{
                typeApplication = TypeApplicationTerm{
                  body = Term{
                    typeApplication = TypeApplicationTerm{
                      body = Term{
                        `either` = left(Term{
                            `wrap` = WrappedTerm{
                              typeName = Name{"hydra.core.errors.DecodingError"},
                              body = Term{
                                literal = Literal{
                                  `string` = "unsupported type variant"}}}})},
                      `type` = Type{
                        variable = Name{"hydra.core.errors.DecodingError"}}}},
                  `type` = Type{
                    variable = Name{"hydra.core.model.Term"}}}}}}}}}
      typ

## Generate a decoder term for a Type, with element name for nominal types. rtype is the FULLY-APPLIED result type for nominal bodies (e.g. DataRow<v> for forall v. wrap...), so the body's intermediate type annotations carry the type parameters rather than a bare nominal name — otherwise Java/Scala coders emit raw types that fail to compile against the parameterized signature. (#476)
term decodeTypeNamed =
  λename,typ,rtype.cases(Type){
      annotated=λat.decodeTypeNamed ename (AnnotatedType[body] at) rtype,
      application=λappType.Term{
            application = Application{
              function = Term{
                typeApplication = TypeApplicationTerm{
                  body = decodeType
                      (ApplicationType[function] appType),
                  `type` = decoderFullResultType
                      (ApplicationType[argument] appType)}},
              argument = decodeType
                  (ApplicationType[argument] appType)}},
      `either`=λet.decodeEitherType et,
      `forall`=λft.Term{
            lambda = Lambda{
              parameter = decodeBindingName
                  (ForallType[parameter] ft),
              domain = given(Type{
                  function = FunctionType{
                    domain = Type{
                      variable = Name{"hydra.core.graph.Graph"}},
                    codomain = Type{
                      function = FunctionType{
                        domain = Type{
                          variable = Name{"hydra.core.model.Term"}},
                        codomain = Type{
                          `either` = EitherType{
                            `left` = Type{
                              variable = Name{"hydra.core.errors.DecodingError"}},
                            `right` = Type{
                              variable = ForallType[parameter] ft}}}}}}}),
              body = decodeTypeNamed
                  ename
                  (ForallType[body] ft)
                  rtype}},
      `list`=λelemType.decodeListType elemType,
      literal=λlt.decodeLiteralType lt,
      `map`=λmt.decodeMapType mt,
      `optional`=λelemType.decodeMaybeType elemType,
      pair=λpt.decodePairType pt,
      `record`=λrt.decodeRecordTypeNamed ename rt rtype,
      `set`=λelemType.decodeSetType elemType,
      `union`=λrt.decodeUnionTypeNamed ename rt rtype,
      `unit`=λ`_`.decodeUnitType,
      `void`=λ`_`.decodeUnitType,
      `wrap`=λwt.decodeWrappedTypeNamed ename wt rtype,
      variable=λtypeName.Term{variable = decodeBindingName typeName},
      `_`=Term{
        lambda = Lambda{
          parameter = Name{"cx"},
          domain = given(Type{variable = Name{"hydra.core.graph.Graph"}}),
          body = Term{
            lambda = Lambda{
              parameter = Name{"t"},
              domain = given(Type{
                  variable = Name{"hydra.core.model.Term"}}),
              body = Term{
                typeApplication = TypeApplicationTerm{
                  body = Term{
                    typeApplication = TypeApplicationTerm{
                      body = Term{
                        `either` = left(Term{
                            `wrap` = WrappedTerm{
                              typeName = Name{"hydra.core.errors.DecodingError"},
                              body = Term{
                                literal = Literal{
                                  `string` = "unsupported type variant"}}}})},
                      `type` = Type{
                        variable = Name{"hydra.core.errors.DecodingError"}}}},
                  `type` = Type{
                    variable = Name{"hydra.core.model.Term"}}}}}}}}}
      typ

## Generate a decoder for a union type
term decodeUnionType = λrt.decodeUnionTypeNamed Name{"unknown"} rt Type{variable = Name{"unknown"}}

## Generate a decoder for a union type with the given element name. rtype is the fully-applied result type (e.g. Foo<v>) used for body annotations. (#476)
term decodeUnionTypeNamed =
  λename,rt,rtype.
    let unionType := rtype in
    let decErrType := Type{variable = Name{"hydra.core.errors.DecodingError"}} in
    let nameType := Type{variable = Name{"hydra.core.model.Name"}} in
    let variantFnType := Type{
      function = FunctionType{
        domain = Type{
          variable = Name{"hydra.core.model.Term"}},
        codomain = Type{
          `either` = EitherType{
            `left` = decErrType,
            `right` = unionType}}}} in
    let toVariantPair := λft.
        let fldType := decoderFullResultType (FieldType[`type`] ft)
        in Term{
          typeApplication = TypeApplicationTerm{
            body = Term{
              typeApplication = TypeApplicationTerm{
                body = Term{
                  pair = (
                      Term{
                        `wrap` = WrappedTerm{
                          typeName = Name{"hydra.core.model.Name"},
                          body = Term{literal = Literal{`string` = Name[] (FieldType[name] ft)}}}},
                      Term{
                        lambda = Lambda{
                          parameter = Name{"input"},
                          domain = given(Type{variable = Name{"hydra.core.model.Term"}}),
                          body = Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            typeApplication = TypeApplicationTerm{
                                              body = Term{
                                                variable = Name{"hydra.core.lib.eithers.map"}},
                                              `type` = fldType}},
                                          `type` = unionType}},
                                      `type` = decErrType}},
                                  argument = Term{
                                    lambda = Lambda{
                                      parameter = Name{"t"},
                                      domain = given(fldType),
                                      body = Term{
                                        `inject` = Injection{
                                          typeName = ename,
                                          field = Field{
                                            name = FieldType[name] ft,
                                            `term` = Term{
                                              variable = Name{"t"}}}}}}}}},
                              argument = Term{
                                application = Application{
                                  function = Term{
                                    application = Application{
                                      function = decodeType (FieldType[`type`] ft),
                                      argument = Term{
                                        variable = Name{"cx"}}}},
                                  argument = Term{
                                    variable = Name{"input"}}}}}}}})},
                `type` = Type{
                  variable = Name{"hydra.core.model.Name"}}}},
            `type` = variantFnType}} in
    Term{
      lambda = Lambda{
        parameter = Name{"cx"},
        domain = given(Type{variable = Name{"hydra.core.graph.Graph"}}),
        body = Term{
          lambda = Lambda{
            parameter = Name{"raw"},
            domain = given(Type{
                variable = Name{"hydra.core.model.Term"}}),
            body = Term{
              application = Application{
                function = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          typeApplication = TypeApplicationTerm{
                            body = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  typeApplication = TypeApplicationTerm{
                                    body = Term{
                                      variable = Name{"hydra.core.lib.eithers.either"}},
                                    `type` = Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}}},
                                `type` = Type{
                                  variable = Name{"hydra.core.model.Term"}}}},
                            `type` = Type{
                              `either` = EitherType{
                                `left` = Type{
                                  variable = Name{"hydra.core.errors.DecodingError"}},
                                `right` = unionType}}}},
                        argument = Term{
                          lambda = Lambda{
                            parameter = Name{"err"},
                            domain = given(Type{
                                variable = Name{"hydra.core.errors.DecodingError"}}),
                            body = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  typeApplication = TypeApplicationTerm{
                                    body = Term{
                                      `either` = left(Term{
                                          variable = Name{"err"}})},
                                    `type` = Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}}},
                                `type` = unionType}}}}}},
                    argument = Term{
                      lambda = Lambda{
                        parameter = Name{"stripped"},
                        domain = given(Type{
                            variable = Name{"hydra.core.model.Term"}}),
                        body = Term{
                          application = Application{
                            function = Term{
                              `cases` = CaseStatement{
                                typeName = Name{"hydra.core.model.Term"},
                                default = given(Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            `either` = left(Term{
                                                `wrap` = WrappedTerm{
                                                  typeName = Name{"hydra.core.errors.DecodingError"},
                                                  body = Term{
                                                    literal = Literal{
                                                      `string` = "expected union"}}}})},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = unionType}}),
                                `cases` = [
                                  CaseAlternative{
                                    name = Name{"inject"},
                                    handler = Term{
                                      lambda = Lambda{
                                        parameter = Name{"inj"},
                                        domain = given(Type{variable = Name{"hydra.core.model.Injection"}}),
                                        body = Term{
                                          `let` = Let{
                                            bindings = [
                                              Binding{
                                                name = Name{"field"},
                                                `term` = Term{
                                                  application = Application{
                                                    function = Term{
                                                      `project` = Projection{
                                                        typeName = Name{"hydra.core.model.Injection"},
                                                        fieldName = Name{"field"}}},
                                                    argument = Term{variable = Name{"inj"}}}},
                                                typeScheme = given(TypeScheme{
                                                    variables = [],
                                                    body = Type{variable = Name{"hydra.core.model.Field"}},
                                                    constraints = maps.empty})},
                                              Binding{
                                                name = Name{"fname"},
                                                `term` = Term{
                                                  application = Application{
                                                    function = Term{
                                                      `project` = Projection{
                                                        typeName = Name{"hydra.core.model.Field"},
                                                        fieldName = Name{"name"}}},
                                                    argument = Term{variable = Name{"field"}}}},
                                                typeScheme = given(TypeScheme{
                                                    variables = [],
                                                    body = Type{variable = Name{"hydra.core.model.Name"}},
                                                    constraints = maps.empty})},
                                              Binding{
                                                name = Name{"fterm"},
                                                `term` = Term{
                                                  application = Application{
                                                    function = Term{
                                                      `project` = Projection{
                                                        typeName = Name{"hydra.core.model.Field"},
                                                        fieldName = Name{"term"}}},
                                                    argument = Term{variable = Name{"field"}}}},
                                                typeScheme = given(TypeScheme{
                                                    variables = [],
                                                    body = Type{variable = Name{"hydra.core.model.Term"}},
                                                    constraints = maps.empty})},
                                              Binding{
                                                name = Name{"variantMap"},
                                                `term` = Term{
                                                  application = Application{
                                                    function = Term{
                                                      typeApplication = TypeApplicationTerm{
                                                        body = Term{
                                                          typeApplication = TypeApplicationTerm{
                                                            body = Term{
                                                              variable = Name{"hydra.core.lib.maps.fromList"}},
                                                            `type` = nameType}},
                                                        `type` = variantFnType}},
                                                    argument = Term{`list` = lists.map toVariantPair rt}}},
                                                typeScheme = given(TypeScheme{
                                                    variables = [],
                                                    body = Type{`map` = MapType{keys = nameType, values = variantFnType}},
                                                    constraints = maps.empty})}],
                                            body = Term{
                                              application = Application{
                                                function = Term{
                                                  application = Application{
                                                    function = Term{
                                                      application = Application{
                                                        function = Term{
                                                          typeApplication = TypeApplicationTerm{
                                                            body = Term{
                                                              typeApplication = TypeApplicationTerm{
                                                                body = Term{
                                                                  variable = Name{"hydra.core.lib.optionals.match"}},
                                                                `type` = variantFnType}},
                                                            `type` = Type{
                                                              `either` = EitherType{
                                                                `left` = decErrType,
                                                                `right` = unionType}}}},
                                                        argument = Term{
                                                          application = Application{
                                                            function = Term{
                                                              application = Application{
                                                                function = Term{
                                                                  typeApplication = TypeApplicationTerm{
                                                                    body = Term{
                                                                      typeApplication = TypeApplicationTerm{
                                                                        body = Term{
                                                                          variable = Name{"hydra.core.lib.maps.lookup"}},
                                                                        `type` = nameType}},
                                                                    `type` = variantFnType}},
                                                                argument = Term{
                                                                  variable = Name{"fname"}}}},
                                                            argument = Term{
                                                              variable = Name{"variantMap"}}}}}},
                                                    argument = Term{
                                                      typeApplication = TypeApplicationTerm{
                                                        body = Term{
                                                          typeApplication = TypeApplicationTerm{
                                                            body = Term{
                                                              `either` = left(Term{
                                                                  `wrap` = WrappedTerm{
                                                                    typeName = Name{"hydra.core.errors.DecodingError"},
                                                                    body = Term{
                                                                      application = Application{
                                                                        function = Term{
                                                                          variable = Name{"hydra.core.lib.strings.concat"}},
                                                                        argument = Term{
                                                                          `list` = [
                                                                            Term{literal = Literal{`string` = "no such field "}},
                                                                            Term{
                                                                              application = Application{
                                                                                function = Term{`unwrap` = Name{"hydra.core.model.Name"}},
                                                                                argument = Term{variable = Name{"fname"}}}},
                                                                            Term{literal = Literal{`string` = " in union"}}]}}}}})},
                                                            `type` = Type{
                                                              variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                        `type` = unionType}}}},
                                                argument = Term{
                                                  lambda = Lambda{
                                                    parameter = Name{"f"},
                                                    domain = given(variantFnType),
                                                    body = Term{
                                                      application = Application{
                                                        function = Term{
                                                          variable = Name{"f"}},
                                                        argument = Term{
                                                          variable = Name{"fterm"}}}}}}}}}}}}}]}},
                            argument = Term{
                              variable = Name{"stripped"}}}}}}}},
                argument = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          variable = Name{"hydra.core.extract.model.stripWithDecodingError"}},
                        argument = Term{
                          variable = Name{"cx"}}}},
                    argument = Term{
                      variable = Name{"raw"}}}}}}}}}}

## Generate a decoder for the unit type
term decodeUnitType =
  Term{
    lambda = Lambda{
      parameter = Name{"cx"},
      domain = given(Type{variable = Name{"hydra.core.graph.Graph"}}),
      body = Term{
        lambda = Lambda{
          parameter = Name{"t"},
          domain = given(Type{variable = Name{"hydra.core.model.Term"}}),
          body = Term{
            application = Application{
              function = Term{
                application = Application{
                  function = Term{
                    variable = Name{"hydra.core.extract.model.decodeUnit"}},
                  argument = Term{
                    variable = Name{"cx"}}}},
              argument = Term{
                variable = Name{"t"}}}}}}}}

## Generate a decoder for a wrapped type
term decodeWrappedType = λwt.decodeWrappedTypeNamed Name{"unknown"} wt Type{variable = Name{"unknown"}}

## Generate a decoder for a wrapped type with the given element name. rtype is the fully-applied result type (e.g. DataRow<v>) used for body annotations. (#476)
term decodeWrappedTypeNamed =
  λename,wt,rtype.
    let bodyDecoder := decodeType wt in
    let bodyType := decoderFullResultType wt in
    Term{
      lambda = Lambda{
        parameter = Name{"cx"},
        domain = given(Type{variable = Name{"hydra.core.graph.Graph"}}),
        body = Term{
          lambda = Lambda{
            parameter = Name{"raw"},
            domain = given(Type{
                variable = Name{"hydra.core.model.Term"}}),
            body = Term{
              application = Application{
                function = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          typeApplication = TypeApplicationTerm{
                            body = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  typeApplication = TypeApplicationTerm{
                                    body = Term{
                                      variable = Name{"hydra.core.lib.eithers.either"}},
                                    `type` = Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}}},
                                `type` = Type{
                                  variable = Name{"hydra.core.model.Term"}}}},
                            `type` = Type{
                              `either` = EitherType{
                                `left` = Type{
                                  variable = Name{"hydra.core.errors.DecodingError"}},
                                `right` = rtype}}}},
                        argument = Term{
                          lambda = Lambda{
                            parameter = Name{"err"},
                            domain = given(Type{
                                variable = Name{"hydra.core.errors.DecodingError"}}),
                            body = Term{
                              typeApplication = TypeApplicationTerm{
                                body = Term{
                                  typeApplication = TypeApplicationTerm{
                                    body = Term{
                                      `either` = left(Term{
                                          variable = Name{"err"}})},
                                    `type` = Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}}},
                                `type` = rtype}}}}}},
                    argument = Term{
                      lambda = Lambda{
                        parameter = Name{"stripped"},
                        domain = given(Type{
                            variable = Name{"hydra.core.model.Term"}}),
                        body = Term{
                          application = Application{
                            function = Term{
                              `cases` = CaseStatement{
                                typeName = Name{"hydra.core.model.Term"},
                                default = given(Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            `either` = left(Term{
                                                `wrap` = WrappedTerm{
                                                  typeName = Name{"hydra.core.errors.DecodingError"},
                                                  body = Term{
                                                    literal = Literal{
                                                      `string` = "expected wrapped type"}}}})},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = rtype}}),
                                `cases` = [
                                  CaseAlternative{
                                    name = Name{"wrap"},
                                    handler = Term{
                                      lambda = Lambda{
                                        parameter = Name{"wrappedTerm"},
                                        domain = given(Type{variable = Name{"hydra.core.model.WrappedTerm"}}),
                                        body = Term{
                                          application = Application{
                                            function = Term{
                                              application = Application{
                                                function = Term{
                                                  typeApplication = TypeApplicationTerm{
                                                    body = Term{
                                                      typeApplication = TypeApplicationTerm{
                                                        body = Term{
                                                          typeApplication = TypeApplicationTerm{
                                                            body = Term{
                                                              variable = Name{"hydra.core.lib.eithers.map"}},
                                                            `type` = bodyType}},
                                                        `type` = rtype}},
                                                    `type` = Type{
                                                      variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                argument = Term{
                                                  lambda = Lambda{
                                                    parameter = Name{"b"},
                                                    domain = given(bodyType),
                                                    body = Term{
                                                      `wrap` = WrappedTerm{
                                                        typeName = ename,
                                                        body = Term{
                                                          variable = Name{"b"}}}}}}}},
                                            argument = Term{
                                              application = Application{
                                                function = Term{
                                                  application = Application{
                                                    function = bodyDecoder,
                                                    argument = Term{
                                                      variable = Name{"cx"}}}},
                                                argument = Term{
                                                  application = Application{
                                                    function = Term{
                                                      `project` = Projection{
                                                        typeName = Name{"hydra.core.model.WrappedTerm"},
                                                        fieldName = Name{"body"}}},
                                                    argument = Term{
                                                      variable = Name{"wrappedTerm"}}}}}}}}}}}]}},
                            argument = Term{
                              variable = Name{"stripped"}}}}}}}},
                argument = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          variable = Name{"hydra.core.extract.model.stripWithDecodingError"}},
                        argument = Term{
                          variable = Name{"cx"}}}},
                    argument = Term{
                      variable = Name{"raw"}}}}}}}}}}

## Get full result type for decoder
term decoderFullResultType =
  λtyp.cases(Type){
      annotated=λat.decoderFullResultType (AnnotatedType[body] at),
      application=λappType.Type{
            application = ApplicationType{
              function = decoderFullResultType
                  (ApplicationType[function] appType),
              argument = ApplicationType[argument] appType}},
      `effect`=λelemType.Type{`effect` = decoderFullResultType elemType},
      `either`=λet.Type{
            `either` = EitherType{
              `left` = decoderFullResultType (EitherType[`left`] et),
              `right` = decoderFullResultType (EitherType[`right`] et)}},
      `forall`=λft.applyForallParamsInOrder
            (decoderFullResultType (stripForalls (ForallType[body] ft)))
            (collectForallVariables typ),
      `list`=λelemType.Type{`list` = decoderFullResultType elemType},
      literal=λlt.Type{literal = lt},
      `map`=λmt.Type{
            `map` = MapType{
              keys = decoderFullResultType (MapType[keys] mt),
              values = decoderFullResultType (MapType[values] mt)}},
      `optional`=λelemType.Type{`optional` = decoderFullResultType elemType},
      pair=λpt.Type{
            pair = PairType{
              first = decoderFullResultType (PairType[first] pt),
              second = decoderFullResultType (PairType[second] pt)}},
      `record`=λ`_`.Type{variable = Name{"hydra.core.model.Term"}},
      `set`=λelemType.Type{`set` = decoderFullResultType elemType},
      `union`=λ`_`.Type{variable = Name{"hydra.core.model.Term"}},
      `unit`=λ`_`.Type{`unit`},
      variable=λname.Type{variable = name},
      `void`=λ`_`.Type{`void`},
      `wrap`=λwt.decoderFullResultType wt,
      `_`=Type{variable = Name{"hydra.core.model.Term"}}}
      typ

## Get full result type for decoder with element name
term decoderFullResultTypeNamed =
  λename,typ.cases(Type){
      annotated=λat.decoderFullResultTypeNamed ename (AnnotatedType[body] at),
      `forall`=λft.applyForallParamsInOrder
            (decoderFullResultTypeNamed ename (stripForalls (ForallType[body] ft)))
            (collectForallVariables typ),
      `record`=λ`_`.Type{variable = ename},
      `union`=λ`_`.Type{variable = ename},
      `wrap`=λ`_`.Type{variable = ename},
      application=λappType.Type{
            application = ApplicationType{
              function = decoderFullResultType
                  (ApplicationType[function] appType),
              argument = ApplicationType[argument] appType}},
      `effect`=λelemType.Type{`effect` = decoderFullResultType elemType},
      `either`=λet.Type{
            `either` = EitherType{
              `left` = decoderFullResultType (EitherType[`left`] et),
              `right` = decoderFullResultType
                  (EitherType[`right`] et)}},
      `list`=λelemType.Type{`list` = decoderFullResultType elemType},
      literal=λlt.Type{literal = lt},
      `map`=λmt.Type{
            `map` = MapType{
              keys = decoderFullResultType (MapType[keys] mt),
              values = decoderFullResultType (MapType[values] mt)}},
      `optional`=λelemType.Type{`optional` = decoderFullResultType elemType},
      pair=λpt.Type{
            pair = PairType{
              first = decoderFullResultType (PairType[first] pt),
              second = decoderFullResultType (PairType[second] pt)}},
      `set`=λelemType.Type{`set` = decoderFullResultType elemType},
      `unit`=λ`_`.Type{`unit`},
      variable=λname.Type{variable = name},
      `void`=λ`_`.Type{`void`},
      `_`=Type{variable = Name{"hydra.core.model.Term"}}}
      typ

## Compute the result type name for a decoder
term decoderResultType =
  λtyp.cases(Type){
      annotated=λat.decoderResultType (AnnotatedType[body] at),
      application=λappType.decoderResultType (ApplicationType[function] appType),
      `forall`=λft.decoderResultType (ForallType[body] ft),
      literal=λ`_`.Name{"hydra.core.model.Literal"},
      `record`=λ`_`.Name{"hydra.core.model.Term"},
      `union`=λ`_`.Name{"hydra.core.model.Term"},
      `wrap`=λ`_`.Name{"hydra.core.model.Term"},
      `_`=Name{"hydra.core.model.Term"}}
      typ

## Build decoder function type
term decoderType =
  λtyp.
    let resultType := decoderFullResultType typ in
    let baseType := Type{
      function = FunctionType{
        domain = Type{variable = Name{"hydra.core.graph.Graph"}},
        codomain = Type{
          function = FunctionType{
            domain = Type{
              variable = Name{"hydra.core.model.Term"}},
            codomain = Type{
              `either` = EitherType{
                `left` = Type{
                  variable = Name{"hydra.core.errors.DecodingError"}},
                `right` = resultType}}}}}} in
    prependForallDecoders baseType typ

## Build decoder function type with element name
term decoderTypeNamed =
  λename,typ.
    let resultType := decoderFullResultTypeNamed ename typ in
    let baseType := Type{
      function = FunctionType{
        domain = Type{variable = Name{"hydra.core.graph.Graph"}},
        codomain = Type{
          function = FunctionType{
            domain = Type{
              variable = Name{"hydra.core.model.Term"}},
            codomain = Type{
              `either` = EitherType{
                `left` = Type{
                  variable = Name{"hydra.core.errors.DecodingError"}},
                `right` = resultType}}}}}} in
    prependForallDecoders baseType typ

## Build type scheme for a decoder function
term decoderTypeScheme =
  λtyp.
    let typeVars := collectTypeVariables typ in
    let allOrdVars := collectOrdConstrainedVariables typ in
    let ordVars := lists.filter (λv.lists.member v typeVars) allOrdVars in
    let constraints := maps.fromList
        (lists.map
          (λv.(v, TypeVariableConstraints{classes = sets.singleton TypeClassConstraint{simple = Name{"ordering"}}}))
          ordVars) in
    TypeScheme{variables = typeVars, body = decoderType typ, constraints = constraints}

## Build type scheme for a decoder function with element name
term decoderTypeSchemeNamed =
  λename,typ.
    let typeVars := collectTypeVariables typ in
    let allOrdVars := collectOrdConstrainedVariables typ in
    let ordVars := lists.filter (λv.lists.member v typeVars) allOrdVars in
    let constraints := maps.fromList
        (lists.map
          (λv.(v, TypeVariableConstraints{classes = sets.singleton TypeClassConstraint{simple = Name{"ordering"}}}))
          ordVars) in
    TypeScheme{variables = typeVars, body = decoderTypeNamed ename typ, constraints = constraints}

## Filter bindings to only decodable type definitions
term filterTypeBindings =
  λcx,graph,bindings.eithers.map
      optionals.givens
      (eithers.mapList (isDecodableBinding cx graph) (lists.filter isNativeType bindings))

## Check if a binding is decodable (serializable type)
term isDecodableBinding =
  λcx,graph,b.eithers.bind
      (isSerializableByName cx graph (Binding[name] b))
      (λserializable.right(ifElse serializable given(b) none))

## Prepend decoder types for forall parameters to base type
term prependForallDecoders =
  λbaseType,typ.cases(Type){
      annotated=λat.prependForallDecoders baseType (AnnotatedType[body] at),
      `forall`=λft.Type{
            function = FunctionType{
              domain = Type{
                function = FunctionType{
                  domain = Type{
                    variable = Name{"hydra.core.graph.Graph"}},
                  codomain = Type{
                    function = FunctionType{
                      domain = Type{
                        variable = Name{"hydra.core.model.Term"}},
                      codomain = Type{
                        `either` = EitherType{
                          `left` = Type{
                            variable = Name{"hydra.core.errors.DecodingError"}},
                          `right` = Type{
                            variable = ForallType[parameter] ft}}}}}}},
              codomain = prependForallDecoders
                  baseType
                  (ForallType[body] ft)}},
      `_`=baseType}
      typ

## Remove all leading forall quantifiers, returning the quantified body
term stripForalls =
  λtyp.cases(Type){
      annotated=λat.stripForalls (AnnotatedType[body] at),
      `forall`=λft.stripForalls (ForallType[body] ft),
      `_`=typ}
      typ