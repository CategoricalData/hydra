## Generate a decoder for a map type
term decodeMapType = λmt.let keyDecoder := decodeType (model.MapType[keys] mt) in let valDecoder := decodeType (model.MapType[values] mt) in model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.extract.model.decodeMap"}}, `type` = decoderFullResultType (model.MapType[keys] mt)}}, `type` = decoderFullResultType (model.MapType[values] mt)}}, argument = keyDecoder}}, argument = valDecoder}}

## Generate a decoder for an optional type
term decodeMaybeType = λelemType.let elemDecoder := decodeType elemType in model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.extract.model.decodeMaybe"}}, `type` = decoderFullResultType elemType}}, argument = elemDecoder}}

## Transform a type module into a decoder module
term decodeModule = λcx,graph,mod.eithers.bind (filterTypeBindings cx graph (optionals.givens (lists.map (λd.cases(packaging.Definition){`type`=λtd.given((λname,typ.let schemaTerm := model.Term{variable = model.Name{"hydra.core.model.Type"}} in let dataTerm := annotations.normalizeTermAnnotations model.Term{annotated = model.AnnotatedTerm{body = encode.model.type typ, annotation = annotations.wrapAnnotationMap (maps.fromList [(constants.keyType, schemaTerm)])}} in model.Binding{name = name, `term` = dataTerm, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Type"}}, constraints = maps.empty})}) (packaging.TypeDefinition[name] td) (model.TypeScheme[body] (packaging.TypeDefinition[body] td))), `_`=none} d) (packaging.Module[definitions] mod)))) (λtypeBindings.logic.ifElse (lists.isEmpty typeBindings) right(none) (eithers.bind (eithers.mapList (λb.eithers.bimap (λ`_e`.errors.Error{decoding = `_e`}) (λx.x) (decodeBinding cx graph b)) typeBindings) (λdecodedBindings.let allDecodedDeps := lists.distinct (lists.map decodeModuleName (lists.map (λdep.packaging.ModuleDependency[`module`] dep) (packaging.Module[dependencies] mod))) in right(given(packaging.Module{name = decodeModuleName (packaging.Module[name] mod), metadata = given(packaging.EntityMetadata{description = given(strings.concat ["Term decoders for ", packaging.ModuleName[] (packaging.Module[name] mod)]), comments = [], seeAlso = [], lifecycle = none, provisions = []}), dependencies = lists.map (λns.packaging.ModuleDependency{`module` = ns, package = none}) (lists.concat2 [packaging.ModuleName{"hydra.core.extract.model"}, packaging.ModuleName{"hydra.core.lexical"}, packaging.ModuleName{"hydra.core.rewriting"}, packaging.Module[name] mod, packaging.ModuleName{"hydra.core.util"}] allDecodedDeps), definitions = lists.map (λb.packaging.Definition{`term` = packaging.TermDefinition{name = model.Binding[name] b, metadata = none, signature = optionals.map scoping.typeSchemeToTermSignature (model.Binding[typeScheme] b), body = model.Binding[`term`] b}}) decodedBindings})))))

## Generate a decoder module name from a source module name
term decodeModuleName = names.derivedModuleName ["decode"] true

## Generate a decoder for a pair type
term decodePairType = λpt.let firstDecoder := decodeType (model.PairType[first] pt) in let secondDecoder := decodeType (model.PairType[second] pt) in model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.extract.model.decodePair"}}, `type` = decoderFullResultType (model.PairType[first] pt)}}, `type` = decoderFullResultType (model.PairType[second] pt)}}, argument = firstDecoder}}, argument = secondDecoder}}

## Generate a decoder for a record type
term decodeRecordType = λrt.decodeRecordTypeImpl model.Name{"unknown"} rt model.Type{variable = model.Name{"unknown"}}

## Generate a decoder for a record type with a type name. rtype is the fully-applied result type (e.g. Table<v>) used for the record's body annotations. (#476)
term decodeRecordTypeImpl = λtname,rt,rtype.let recType := rtype in let graphType := model.Type{variable = model.Name{"hydra.core.graph.Graph"}} in let termType := model.Type{variable = model.Name{"hydra.core.model.Term"}} in let decodeFieldTerm := λft.model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.extract.model.requireField"}}, `type` = graphType}}, `type` = termType}}, `type` = decoderFullResultType (model.FieldType[`type`] ft)}}, argument = model.Term{literal = model.Literal{`string` = model.Name[] (model.FieldType[name] ft)}}}}, argument = decodeType (model.FieldType[`type`] ft)}}, argument = model.Term{variable = model.Name{"fieldMap"}}}}, argument = model.Term{variable = model.Name{"cx"}}}} in let localVarName := λft.model.Name{strings.concat ["field_", model.Name[] (model.FieldType[name] ft)]} in let toFieldLambda := λft,body.model.Term{lambda = model.Lambda{parameter = localVarName ft, domain = given(decoderFullResultType (model.FieldType[`type`] ft)), body = body}} in let decodeBody := lists.foldl (λacc,ft.model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.bind"}}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = decoderFullResultType (model.FieldType[`type`] ft)}}, `type` = recType}}, argument = decodeFieldTerm ft}}, argument = toFieldLambda ft acc}}) model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = right(model.Term{`record` = model.Record{typeName = tname, fields = lists.map (λft.model.Field{name = model.FieldType[name] ft, `term` = model.Term{variable = localVarName ft}}) rt}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = recType}} (lists.reverse rt) in model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"raw"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.either"}}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}, `type` = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = recType}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"err"}, domain = given(model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{variable = model.Name{"err"}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = recType}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"stripped"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{`cases` = model.CaseStatement{typeName = model.Name{"hydra.core.model.Term"}, default = given(model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = strings.concat ["expected a record of type ", model.Name[] tname]}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = recType}}), `cases` = [model.CaseAlternative{name = model.Name{"record"}, handler = model.Term{lambda = model.Lambda{parameter = model.Name{"record"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Record"}}), body = model.Term{`let` = model.Let{bindings = [model.Binding{name = model.Name{"fieldMap"}, `term` = model.Term{application = model.Application{function = model.Term{variable = model.Name{"hydra.core.extract.model.toFieldMap"}}, argument = model.Term{variable = model.Name{"record"}}}}, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{`map` = model.MapType{keys = model.Type{variable = model.Name{"hydra.core.model.Name"}}, values = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}, constraints = maps.empty})}], body = decodeBody}}}}}]}}, argument = model.Term{variable = model.Name{"stripped"}}}}}}}}, argument = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{variable = model.Name{"hydra.core.extract.model.stripWithDecodingError"}}, argument = model.Term{variable = model.Name{"cx"}}}}, argument = model.Term{variable = model.Name{"raw"}}}}}}}}}}

## Generate a decoder for a record type with element name
term decodeRecordTypeNamed = λename,rt,rtype.decodeRecordTypeImpl ename rt rtype

## Generate a decoder for a set type
term decodeSetType = λelemType.let elemDecoder := decodeType elemType in model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.extract.model.decodeSet"}}, `type` = decoderFullResultType elemType}}, argument = elemDecoder}}

## Generate a decoder term for a Type
term decodeType = λtyp.cases(model.Type){annotated=λat.decodeType (model.AnnotatedType[body] at), application=λappType.model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = decodeType (model.ApplicationType[function] appType), `type` = decoderFullResultType (model.ApplicationType[argument] appType)}}, argument = decodeType (model.ApplicationType[argument] appType)}}, `either`=λet.decodeEitherType et, `forall`=λft.decodeForallType ft, `list`=λelemType.decodeListType elemType, literal=λlt.decodeLiteralType lt, `map`=λmt.decodeMapType mt, `optional`=λelemType.decodeMaybeType elemType, pair=λpt.decodePairType pt, `record`=λrt.decodeRecordType rt, `set`=λelemType.decodeSetType elemType, `union`=λrt.decodeUnionType rt, `unit`=λ`_`.decodeUnitType, `void`=λ`_`.decodeUnitType, `wrap`=λwt.decodeWrappedType wt, variable=λtypeName.model.Term{variable = decodeBindingName typeName}, `_`=model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"t"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "unsupported type variant"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}}}}}} typ

## Generate a decoder term for a Type, with element name for nominal types. rtype is the FULLY-APPLIED result type for nominal bodies (e.g. DataRow<v> for forall v. wrap...), so the body's intermediate type annotations carry the type parameters rather than a bare nominal name — otherwise Java/Scala coders emit raw types that fail to compile against the parameterized signature. (#476)
term decodeTypeNamed = λename,typ,rtype.cases(model.Type){annotated=λat.decodeTypeNamed ename (model.AnnotatedType[body] at) rtype, application=λappType.model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = decodeType (model.ApplicationType[function] appType), `type` = decoderFullResultType (model.ApplicationType[argument] appType)}}, argument = decodeType (model.ApplicationType[argument] appType)}}, `either`=λet.decodeEitherType et, `forall`=λft.model.Term{lambda = model.Lambda{parameter = decodeBindingName (model.ForallType[parameter] ft), domain = given(model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.graph.Graph"}}, codomain = model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.model.Term"}}, codomain = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = model.Type{variable = model.ForallType[parameter] ft}}}}}}}), body = decodeTypeNamed ename (model.ForallType[body] ft) rtype}}, `list`=λelemType.decodeListType elemType, literal=λlt.decodeLiteralType lt, `map`=λmt.decodeMapType mt, `optional`=λelemType.decodeMaybeType elemType, pair=λpt.decodePairType pt, `record`=λrt.decodeRecordTypeNamed ename rt rtype, `set`=λelemType.decodeSetType elemType, `union`=λrt.decodeUnionTypeNamed ename rt rtype, `unit`=λ`_`.decodeUnitType, `void`=λ`_`.decodeUnitType, `wrap`=λwt.decodeWrappedTypeNamed ename wt rtype, variable=λtypeName.model.Term{variable = decodeBindingName typeName}, `_`=model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"t"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "unsupported type variant"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}}}}}} typ

## Generate a decoder for a union type
term decodeUnionType = λrt.decodeUnionTypeNamed model.Name{"unknown"} rt model.Type{variable = model.Name{"unknown"}}

## Generate a decoder for a union type with the given element name. rtype is the fully-applied result type (e.g. Foo<v>) used for body annotations. (#476)
term decodeUnionTypeNamed = λename,rt,rtype.let unionType := rtype in let decErrType := model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}} in let nameType := model.Type{variable = model.Name{"hydra.core.model.Name"}} in let variantFnType := model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.model.Term"}}, codomain = model.Type{`either` = model.EitherType{`left` = decErrType, `right` = unionType}}}} in let toVariantPair := λft.let fldType := decoderFullResultType (model.FieldType[`type`] ft) in model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{pair = (model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.model.Name"}, body = model.Term{literal = model.Literal{`string` = model.Name[] (model.FieldType[name] ft)}}}}, model.Term{lambda = model.Lambda{parameter = model.Name{"input"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.map"}}, `type` = fldType}}, `type` = unionType}}, `type` = decErrType}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"t"}, domain = given(fldType), body = model.Term{`inject` = model.Injection{typeName = ename, field = model.Field{name = model.FieldType[name] ft, `term` = model.Term{variable = model.Name{"t"}}}}}}}}}, argument = model.Term{application = model.Application{function = model.Term{application = model.Application{function = decodeType (model.FieldType[`type`] ft), argument = model.Term{variable = model.Name{"cx"}}}}, argument = model.Term{variable = model.Name{"input"}}}}}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.model.Name"}}}}, `type` = variantFnType}} in model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"raw"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.either"}}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}, `type` = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = unionType}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"err"}, domain = given(model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{variable = model.Name{"err"}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = unionType}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"stripped"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{`cases` = model.CaseStatement{typeName = model.Name{"hydra.core.model.Term"}, default = given(model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "expected union"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = unionType}}), `cases` = [model.CaseAlternative{name = model.Name{"inject"}, handler = model.Term{lambda = model.Lambda{parameter = model.Name{"inj"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Injection"}}), body = model.Term{`let` = model.Let{bindings = [model.Binding{name = model.Name{"field"}, `term` = model.Term{application = model.Application{function = model.Term{`project` = model.Projection{typeName = model.Name{"hydra.core.model.Injection"}, fieldName = model.Name{"field"}}}, argument = model.Term{variable = model.Name{"inj"}}}}, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Field"}}, constraints = maps.empty})}, model.Binding{name = model.Name{"fname"}, `term` = model.Term{application = model.Application{function = model.Term{`project` = model.Projection{typeName = model.Name{"hydra.core.model.Field"}, fieldName = model.Name{"name"}}}, argument = model.Term{variable = model.Name{"field"}}}}, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Name"}}, constraints = maps.empty})}, model.Binding{name = model.Name{"fterm"}, `term` = model.Term{application = model.Application{function = model.Term{`project` = model.Projection{typeName = model.Name{"hydra.core.model.Field"}, fieldName = model.Name{"term"}}}, argument = model.Term{variable = model.Name{"field"}}}}, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{variable = model.Name{"hydra.core.model.Term"}}, constraints = maps.empty})}, model.Binding{name = model.Name{"variantMap"}, `term` = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.maps.fromList"}}, `type` = nameType}}, `type` = variantFnType}}, argument = model.Term{`list` = lists.map toVariantPair rt}}}, typeScheme = given(model.TypeScheme{variables = [], body = model.Type{`map` = model.MapType{keys = nameType, values = variantFnType}}, constraints = maps.empty})}], body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.optionals.match"}}, `type` = variantFnType}}, `type` = model.Type{`either` = model.EitherType{`left` = decErrType, `right` = unionType}}}}, argument = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.maps.lookup"}}, `type` = nameType}}, `type` = variantFnType}}, argument = model.Term{variable = model.Name{"fname"}}}}, argument = model.Term{variable = model.Name{"variantMap"}}}}}}, argument = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{application = model.Application{function = model.Term{variable = model.Name{"hydra.core.lib.strings.concat"}}, argument = model.Term{`list` = [model.Term{literal = model.Literal{`string` = "no such field "}}, model.Term{application = model.Application{function = model.Term{`unwrap` = model.Name{"hydra.core.model.Name"}}, argument = model.Term{variable = model.Name{"fname"}}}}, model.Term{literal = model.Literal{`string` = " in union"}}]}}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = unionType}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"f"}, domain = given(variantFnType), body = model.Term{application = model.Application{function = model.Term{variable = model.Name{"f"}}, argument = model.Term{variable = model.Name{"fterm"}}}}}}}}}}}}}]}}, argument = model.Term{variable = model.Name{"stripped"}}}}}}}}, argument = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{variable = model.Name{"hydra.core.extract.model.stripWithDecodingError"}}, argument = model.Term{variable = model.Name{"cx"}}}}, argument = model.Term{variable = model.Name{"raw"}}}}}}}}}}

## Generate a decoder for the unit type
term decodeUnitType = model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"t"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{variable = model.Name{"hydra.core.extract.model.decodeUnit"}}, argument = model.Term{variable = model.Name{"cx"}}}}, argument = model.Term{variable = model.Name{"t"}}}}}}}}

## Generate a decoder for a wrapped type
term decodeWrappedType = λwt.decodeWrappedTypeNamed model.Name{"unknown"} wt model.Type{variable = model.Name{"unknown"}}

## Generate a decoder for a wrapped type with the given element name. rtype is the fully-applied result type (e.g. DataRow<v>) used for body annotations. (#476)
term decodeWrappedTypeNamed = λename,wt,rtype.let bodyDecoder := decodeType wt in let bodyType := decoderFullResultType wt in model.Term{lambda = model.Lambda{parameter = model.Name{"cx"}, domain = given(model.Type{variable = model.Name{"hydra.core.graph.Graph"}}), body = model.Term{lambda = model.Lambda{parameter = model.Name{"raw"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.either"}}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{variable = model.Name{"hydra.core.model.Term"}}}}, `type` = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = rtype}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"err"}, domain = given(model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}), body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{variable = model.Name{"err"}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = rtype}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"stripped"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{`cases` = model.CaseStatement{typeName = model.Name{"hydra.core.model.Term"}, default = given(model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "expected wrapped type"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = rtype}}), `cases` = [model.CaseAlternative{name = model.Name{"wrap"}, handler = model.Term{lambda = model.Lambda{parameter = model.Name{"wrappedTerm"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.WrappedTerm"}}), body = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{variable = model.Name{"hydra.core.lib.eithers.map"}}, `type` = bodyType}}, `type` = rtype}}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"b"}, domain = given(bodyType), body = model.Term{`wrap` = model.WrappedTerm{typeName = ename, body = model.Term{variable = model.Name{"b"}}}}}}}}, argument = model.Term{application = model.Application{function = model.Term{application = model.Application{function = bodyDecoder, argument = model.Term{variable = model.Name{"cx"}}}}, argument = model.Term{application = model.Application{function = model.Term{`project` = model.Projection{typeName = model.Name{"hydra.core.model.WrappedTerm"}, fieldName = model.Name{"body"}}}, argument = model.Term{variable = model.Name{"wrappedTerm"}}}}}}}}}}}]}}, argument = model.Term{variable = model.Name{"stripped"}}}}}}}}, argument = model.Term{application = model.Application{function = model.Term{application = model.Application{function = model.Term{variable = model.Name{"hydra.core.extract.model.stripWithDecodingError"}}, argument = model.Term{variable = model.Name{"cx"}}}}, argument = model.Term{variable = model.Name{"raw"}}}}}}}}}}

## Get full result type for decoder
term decoderFullResultType = λtyp.cases(model.Type){annotated=λat.decoderFullResultType (model.AnnotatedType[body] at), application=λappType.model.Type{application = model.ApplicationType{function = decoderFullResultType (model.ApplicationType[function] appType), argument = model.ApplicationType[argument] appType}}, `effect`=λelemType.model.Type{`effect` = decoderFullResultType elemType}, `either`=λet.model.Type{`either` = model.EitherType{`left` = decoderFullResultType (model.EitherType[`left`] et), `right` = decoderFullResultType (model.EitherType[`right`] et)}}, `forall`=λft.applyForallParamsInOrder (decoderFullResultType (stripForalls (model.ForallType[body] ft))) (collectForallVariables typ), `list`=λelemType.model.Type{`list` = decoderFullResultType elemType}, literal=λlt.model.Type{literal = lt}, `map`=λmt.model.Type{`map` = model.MapType{keys = decoderFullResultType (model.MapType[keys] mt), values = decoderFullResultType (model.MapType[values] mt)}}, `optional`=λelemType.model.Type{`optional` = decoderFullResultType elemType}, pair=λpt.model.Type{pair = model.PairType{first = decoderFullResultType (model.PairType[first] pt), second = decoderFullResultType (model.PairType[second] pt)}}, `record`=λ`_`.model.Type{variable = model.Name{"hydra.core.model.Term"}}, `set`=λelemType.model.Type{`set` = decoderFullResultType elemType}, `union`=λ`_`.model.Type{variable = model.Name{"hydra.core.model.Term"}}, `unit`=λ`_`.model.Type{`unit`}, variable=λname.model.Type{variable = name}, `void`=λ`_`.model.Type{`void`}, `wrap`=λwt.decoderFullResultType wt, `_`=model.Type{variable = model.Name{"hydra.core.model.Term"}}} typ

## Get full result type for decoder with element name
term decoderFullResultTypeNamed = λename,typ.cases(model.Type){annotated=λat.decoderFullResultTypeNamed ename (model.AnnotatedType[body] at), `forall`=λft.applyForallParamsInOrder (decoderFullResultTypeNamed ename (stripForalls (model.ForallType[body] ft))) (collectForallVariables typ), `record`=λ`_`.model.Type{variable = ename}, `union`=λ`_`.model.Type{variable = ename}, `wrap`=λ`_`.model.Type{variable = ename}, application=λappType.model.Type{application = model.ApplicationType{function = decoderFullResultType (model.ApplicationType[function] appType), argument = model.ApplicationType[argument] appType}}, `effect`=λelemType.model.Type{`effect` = decoderFullResultType elemType}, `either`=λet.model.Type{`either` = model.EitherType{`left` = decoderFullResultType (model.EitherType[`left`] et), `right` = decoderFullResultType (model.EitherType[`right`] et)}}, `list`=λelemType.model.Type{`list` = decoderFullResultType elemType}, literal=λlt.model.Type{literal = lt}, `map`=λmt.model.Type{`map` = model.MapType{keys = decoderFullResultType (model.MapType[keys] mt), values = decoderFullResultType (model.MapType[values] mt)}}, `optional`=λelemType.model.Type{`optional` = decoderFullResultType elemType}, pair=λpt.model.Type{pair = model.PairType{first = decoderFullResultType (model.PairType[first] pt), second = decoderFullResultType (model.PairType[second] pt)}}, `set`=λelemType.model.Type{`set` = decoderFullResultType elemType}, `unit`=λ`_`.model.Type{`unit`}, variable=λname.model.Type{variable = name}, `void`=λ`_`.model.Type{`void`}, `_`=model.Type{variable = model.Name{"hydra.core.model.Term"}}} typ

## Compute the result type name for a decoder
term decoderResultType = λtyp.cases(model.Type){annotated=λat.decoderResultType (model.AnnotatedType[body] at), application=λappType.decoderResultType (model.ApplicationType[function] appType), `forall`=λft.decoderResultType (model.ForallType[body] ft), literal=λ`_`.model.Name{"hydra.core.model.Literal"}, `record`=λ`_`.model.Name{"hydra.core.model.Term"}, `union`=λ`_`.model.Name{"hydra.core.model.Term"}, `wrap`=λ`_`.model.Name{"hydra.core.model.Term"}, `_`=model.Name{"hydra.core.model.Term"}} typ

## Build decoder function type
term decoderType = λtyp.let resultType := decoderFullResultType typ in let baseType := model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.graph.Graph"}}, codomain = model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.model.Term"}}, codomain = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = resultType}}}}}} in prependForallDecoders baseType typ

## Build decoder function type with element name
term decoderTypeNamed = λename,typ.let resultType := decoderFullResultTypeNamed ename typ in let baseType := model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.graph.Graph"}}, codomain = model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.model.Term"}}, codomain = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = resultType}}}}}} in prependForallDecoders baseType typ

## Build type scheme for a decoder function
term decoderTypeScheme = λtyp.let typeVars := collectTypeVariables typ in let allOrdVars := collectOrdConstrainedVariables typ in let ordVars := lists.filter (λv.lists.member v typeVars) allOrdVars in let constraints := maps.fromList (lists.map (λv.(v, model.TypeVariableConstraints{classes = sets.singleton model.TypeClassConstraint{simple = model.Name{"ordering"}}})) ordVars) in model.TypeScheme{variables = typeVars, body = decoderType typ, constraints = constraints}

## Build type scheme for a decoder function with element name
term decoderTypeSchemeNamed = λename,typ.let typeVars := collectTypeVariables typ in let allOrdVars := collectOrdConstrainedVariables typ in let ordVars := lists.filter (λv.lists.member v typeVars) allOrdVars in let constraints := maps.fromList (lists.map (λv.(v, model.TypeVariableConstraints{classes = sets.singleton model.TypeClassConstraint{simple = model.Name{"ordering"}}})) ordVars) in model.TypeScheme{variables = typeVars, body = decoderTypeNamed ename typ, constraints = constraints}

## Filter bindings to only decodable type definitions
term filterTypeBindings = λcx,graph,bindings.eithers.map optionals.givens (eithers.mapList (isDecodableBinding cx graph) (lists.filter annotations.isNativeType bindings))

## Check if a binding is decodable (serializable type)
term isDecodableBinding = λcx,graph,b.eithers.bind (predicates.isSerializableByName cx graph (model.Binding[name] b)) (λserializable.right(logic.ifElse serializable given(b) none))

## Prepend decoder types for forall parameters to base type
term prependForallDecoders = λbaseType,typ.cases(model.Type){annotated=λat.prependForallDecoders baseType (model.AnnotatedType[body] at), `forall`=λft.model.Type{function = model.FunctionType{domain = model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.graph.Graph"}}, codomain = model.Type{function = model.FunctionType{domain = model.Type{variable = model.Name{"hydra.core.model.Term"}}, codomain = model.Type{`either` = model.EitherType{`left` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}, `right` = model.Type{variable = model.ForallType[parameter] ft}}}}}}}, codomain = prependForallDecoders baseType (model.ForallType[body] ft)}}, `_`=baseType} typ

## Remove all leading forall quantifiers, returning the quantified body
term stripForalls = λtyp.cases(model.Type){annotated=λat.stripForalls (model.AnnotatedType[body] at), `forall`=λft.stripForalls (model.ForallType[body] ft), `_`=typ} typ