rors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`decimal`}}}}}}}}, argument = model.Term{lambda = model.Lambda{parameter = model.Name{"stripped"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Term"}}), body = model.Term{application = model.Application{function = model.Term{`cases` = model.CaseStatement{typeName = model.Name{"hydra.core.model.Term"}, default = given(model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "expected literal"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`decimal`}}}}), `cases` = [model.CaseAlternative{name = model.Name{"literal"}, handler = model.Term{lambda = model.Lambda{parameter = model.Name{"v"}, domain = given(model.Type{variable = model.Name{"hydra.core.model.Literal"}}), body = model.Term{application = model.Application{function = model.Term{`cases` = model.CaseStatement{typeName = model.Name{"hydra.core.model.Literal"}, default = given(model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{typeApplication = model.TypeApplicationTerm{body = model.Term{`either` = left(model.Term{`wrap` = model.WrappedTerm{typeName = model.Name{"hydra.core.errors.DecodingError"}, body = model.Term{literal = model.Literal{`string` = "expected decimal literal"}}}})}, `type` = model.Type{variable = model.Name{"hydra.core.errors.DecodingError"}}}}, `type` = model.Type{literal = model.LiteralType{`decimal`}}}}), `cases` = [model.CaseAlternative{name = model.Name{"decimal"}, handler = model.Term{lambda = model.Lambda{parameter = model.Name{"d"}, domain = given(model.Type{literal = model.LiteralType{`decimal`}}), body = model.Term{typeApplication = model.TypeAppl