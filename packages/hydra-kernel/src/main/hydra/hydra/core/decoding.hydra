## Functions for generating term decoders from type modules
module hydra.core.decoding

import hydra.core.annotations
import hydra.core.constants
import hydra.core.decode.model as decode.model
import hydra.core.encode.model as encode.model
import hydra.core.errors
import hydra.core.lib.eithers as eithers
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.names
import hydra.core.packaging
import hydra.core.predicates
import hydra.core.scoping

## Left-apply type-variable params to a base type in binder order (fixes param reversal)
term applyForallParamsInOrder =
  λbase,params.lists.foldl
      (λacc,p.Type{application = ApplicationType{function = acc, argument = Type{variable = p}}})
      base
      params

## Collect forall type variable names from a type
term collectForallVariables =
  λtyp.cases(Type){
      annotated=λat.collectForallVariables (AnnotatedType[body] at),
      `forall`=λft.lists.cons (ForallType[parameter] ft) (collectForallVariables (ForallType[body] ft)),
      `_`=[]}
      typ

## Collect type variables needing Ord constraints (from Map key and Set element types)
term collectOrdConstrainedVariables =
  λtyp.cases(Type){
      annotated=λat.collectOrdConstrainedVariables (AnnotatedType[body] at),
      application=λappType.lists.concat2
            (collectOrdConstrainedVariables (ApplicationType[function] appType))
            (collectOrdConstrainedVariables (ApplicationType[argument] appType)),
      `effect`=λelemType.collectOrdConstrainedVariables elemType,
      `either`=λet.lists.concat2
            (collectOrdConstrainedVariables (EitherType[`left`] et))
            (collectOrdConstrainedVariables (EitherType[`right`] et)),
      `forall`=λft.collectOrdConstrainedVariables (ForallType[body] ft),
      `list`=λelemType.collectOrdConstrainedVariables elemType,
      `map`=λmt.lists.concat
            [
              collectTypeVariablesFromType (MapType[keys] mt),
              collectOrdConstrainedVariables (MapType[keys] mt),
              collectOrdConstrainedVariables (MapType[values] mt)],
      `optional`=λelemType.collectOrdConstrainedVariables elemType,
      pair=λpt.lists.concat2
            (collectOrdConstrainedVariables (PairType[first] pt))
            (collectOrdConstrainedVariables (PairType[second] pt)),
      `record`=λrt.lists.concat (lists.map (λft.collectOrdConstrainedVariables (FieldType[`type`] ft)) rt),
      `set`=λelemType.lists.concat2
            (collectTypeVariablesFromType elemType)
            (collectOrdConstrainedVariables elemType),
      `union`=λrt.lists.concat (lists.map (λft.collectOrdConstrainedVariables (FieldType[`type`] ft)) rt),
      `wrap`=λwt.collectOrdConstrainedVariables wt,
      `_`=[]}
      typ

## Collect type variable names from a type (forall parameters only)
term collectTypeVariables = λtyp.collectForallVariables typ

## Collect all type variable names from a type expression
term collectTypeVariablesFromType =
  λtyp.cases(Type){
      annotated=λat.collectTypeVariablesFromType (AnnotatedType[body] at),
      application=λappType.lists.concat2
            (collectTypeVariablesFromType (ApplicationType[function] appType))
            (collectTypeVariablesFromType (ApplicationType[argument] appType)),
      `effect`=λelemType.collectTypeVariablesFromType elemType,
      `either`=λet.lists.concat2
            (collectTypeVariablesFromType (EitherType[`left`] et))
            (collectTypeVariablesFromType (EitherType[`right`] et)),
      `forall`=λft.collectTypeVariablesFromType (ForallType[body] ft),
      `list`=λelemType.collectTypeVariablesFromType elemType,
      `map`=λmt.lists.concat2
            (collectTypeVariablesFromType (MapType[keys] mt))
            (collectTypeVariablesFromType (MapType[values] mt)),
      `optional`=λelemType.collectTypeVariablesFromType elemType,
      pair=λpt.lists.concat2
            (collectTypeVariablesFromType (PairType[first] pt))
            (collectTypeVariablesFromType (PairType[second] pt)),
      `record`=λrt.lists.concat (lists.map (λft.collectTypeVariablesFromType (FieldType[`type`] ft)) rt),
      `set`=λelemType.collectTypeVariablesFromType elemType,
      `union`=λrt.lists.concat (lists.map (λft.collectTypeVariablesFromType (FieldType[`type`] ft)) rt),
      variable=λname.[name],
      `wrap`=λwt.collectTypeVariablesFromType wt,
      `_`=[]}
      typ

## Transform a type binding into a decoder binding
term decodeBinding =
  λcx,graph,b.eithers.bind
      (decode.model.type graph (Binding[`term`] b))
      (λtyp.
        let rtype := decoderFullResultTypeNamed (Binding[name] b) typ in
        let rawBody := decodeTypeNamed (Binding[name] b) typ rtype in
        let description := strings.concat ["Decoder for ", Name[] (Binding[name] b)] in
        right(Binding{
          name = decodeBindingName (Binding[name] b),
          `term` = setTermDescription given(description) rawBody,
          typeScheme = given(decoderTypeSchemeNamed (Binding[name] b) typ)}))

## Generate a binding name for a decoder function from a type name
term decodeBindingName = derivedBindingName ["decode"] true

## Generate a decoder for an Either type
term decodeEitherType =
  λet.
    let leftDecoder := decodeType (EitherType[`left`] et) in
    let rightDecoder := decodeType (EitherType[`right`] et) in
    Term{
      application = Application{
        function = Term{
          application = Application{
            function = Term{
              typeApplication = TypeApplicationTerm{
                body = Term{
                  typeApplication = TypeApplicationTerm{
                    body = Term{
                      variable = Name{"hydra.core.extract.model.decodeEither"}},
                    `type` = decoderFullResultType
                        (EitherType[`left`] et)}},
                `type` = decoderFullResultType
                    (EitherType[`right`] et)}},
            argument = leftDecoder}},
        argument = rightDecoder}}

## Generate a decoder for a polymorphic (forall) type
term decodeForallType =
  λft.Term{
      lambda = Lambda{
        parameter = decodeBindingName (ForallType[parameter] ft),
        domain = given(Type{
            function = FunctionType{
              domain = Type{
                variable = Name{"hydra.core.graph.Graph"}},
              codomain = Type{
                function = FunctionType{
                  domain = Type{
                    variable = Name{"hydra.core.model.Term"}},
                  codomain = Type{
                    `either` = EitherType{
                      `left` = Type{
                        variable = Name{"hydra.core.errors.DecodingError"}},
                      `right` = Type{
                        variable = ForallType[parameter] ft}}}}}}}),
        body = decodeType (ForallType[body] ft)}}

## Generate a decoder for a list type
term decodeListType =
  λelemType.
    let elemDecoder := decodeType elemType
    in Term{
      application = Application{
        function = Term{
          typeApplication = TypeApplicationTerm{
            body = Term{
              variable = Name{"hydra.core.extract.model.decodeList"}},
            `type` = decoderFullResultType elemType}},
        argument = elemDecoder}}

## Generate a decoder for a literal type
term decodeLiteralType =
  λlt.cases(LiteralType){
      `binary`=λ`_`.Term{
            lambda = Lambda{
              parameter = Name{"cx"},
              domain = given(Type{
                  variable = Name{"hydra.core.graph.Graph"}}),
              body = Term{
                lambda = Lambda{
                  parameter = Name{"raw"},
                  domain = given(Type{
                      variable = Name{"hydra.core.model.Term"}}),
                  body = Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                typeApplication = TypeApplicationTerm{
                                  body = Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            variable = Name{"hydra.core.lib.eithers.either"}},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = Type{
                                        variable = Name{"hydra.core.model.Term"}}}},
                                  `type` = Type{
                                    `either` = EitherType{
                                      `left` = Type{
                                        variable = Name{"hydra.core.errors.DecodingError"}},
                                      `right` = Type{
                                        literal = LiteralType{
                                          `binary`}}}}}},
                              argument = Term{
                                lambda = Lambda{
                                  parameter = Name{"err"},
                                  domain = given(Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}),
                                  body = Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            `either` = left(Term{
                                                variable = Name{"err"}})},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = Type{
                                        literal = LiteralType{
                                          `binary`}}}}}}}},
                          argument = Term{
                            lambda = Lambda{
                              parameter = Name{"stripped"},
                              domain = given(Type{
                                  variable = Name{"hydra.core.model.Term"}}),
                              body = Term{
                                application = Application{
                                  function = Term{
                                    `cases` = CaseStatement{
                                      typeName = Name{"hydra.core.model.Term"},
                                      default = given(Term{
                                          typeApplication = TypeApplicationTerm{
                                            body = Term{
                                              typeApplication = TypeApplicationTerm{
                                                body = Term{
                                                  `either` = left(Term{
                                                      `wrap` = WrappedTerm{
                                                        typeName = Name{"hydra.core.errors.DecodingError"},
                                                        body = Term{
                                                          literal = Literal{
                                                            `string` = "expected literal"}}}})},
                                                `type` = Type{
                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                            `type` = Type{
                                              literal = LiteralType{
                                                `binary`}}}}),
                                      `cases` = [
                                        CaseAlternative{
                                          name = Name{"literal"},
                                          handler = Term{
                                            lambda = Lambda{
                                              parameter = Name{"v"},
                                              domain = given(Type{variable = Name{"hydra.core.model.Literal"}}),
                                              body = Term{
                                                application = Application{
                                                  function = Term{
                                                    `cases` = CaseStatement{
                                                      typeName = Name{"hydra.core.model.Literal"},
                                                      default = given(Term{
                                                          typeApplication = TypeApplicationTerm{
                                                            body = Term{
                                                              typeApplication = TypeApplicationTerm{
                                                                body = Term{
                                                                  `either` = left(Term{
                                                                      `wrap` = WrappedTerm{
                                                                        typeName = Name{"hydra.core.errors.DecodingError"},
                                                                        body = Term{
                                                                          literal = Literal{
                                                                            `string` = "expected binary literal"}}}})},
                                                                `type` = Type{
                                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                            `type` = Type{
                                                              literal = LiteralType{
                                                                `binary`}}}}),
                                                      `cases` = [
                                                        CaseAlternative{
                                                          name = Name{"binary"},
                                                          handler = Term{
                                                            lambda = Lambda{
                                                              parameter = Name{"b"},
                                                              domain = given(Type{literal = LiteralType{`binary`}}),
                                                              body = Term{
                                                                typeApplication = TypeApplicationTerm{
                                                                  body = Term{
                                                                    typeApplication = TypeApplicationTerm{
                                                                      body = Term{
                                                                        `either` = right(Term{
                                                                            variable = Name{"b"}})},
                                                                      `type` = Type{
                                                                        variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                                  `type` = Type{
                                                                    literal = LiteralType{
                                                                      `binary`}}}}}}}]}},
                                                  argument = Term{
                                                    variable = Name{"v"}}}}}}}]}},
                                  argument = Term{
                                    variable = Name{"stripped"}}}}}}}},
                      argument = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"hydra.core.extract.model.stripWithDecodingError"}},
                              argument = Term{
                                variable = Name{"cx"}}}},
                          argument = Term{
                            variable = Name{"raw"}}}}}}}}}},
      `boolean`=λ`_`.Term{
            lambda = Lambda{
              parameter = Name{"cx"},
              domain = given(Type{
                  variable = Name{"hydra.core.graph.Graph"}}),
              body = Term{
                lambda = Lambda{
                  parameter = Name{"raw"},
                  domain = given(Type{
                      variable = Name{"hydra.core.model.Term"}}),
                  body = Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                typeApplication = TypeApplicationTerm{
                                  body = Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            variable = Name{"hydra.core.lib.eithers.either"}},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = Type{
                                        variable = Name{"hydra.core.model.Term"}}}},
                                  `type` = Type{
                                    `either` = EitherType{
                                      `left` = Type{
                                        variable = Name{"hydra.core.errors.DecodingError"}},
                                      `right` = Type{
                                        literal = LiteralType{
                                          `boolean`}}}}}},
                              argument = Term{
                                lambda = Lambda{
                                  parameter = Name{"err"},
                                  domain = given(Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}),
                                  body = Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            `either` = left(Term{
                                                variable = Name{"err"}})},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = Type{
                                        literal = LiteralType{
                                          `boolean`}}}}}}}},
                          argument = Term{
                            lambda = Lambda{
                              parameter = Name{"stripped"},
                              domain = given(Type{
                                  variable = Name{"hydra.core.model.Term"}}),
                              body = Term{
                                application = Application{
                                  function = Term{
                                    `cases` = CaseStatement{
                                      typeName = Name{"hydra.core.model.Term"},
                                      default = given(Term{
                                          typeApplication = TypeApplicationTerm{
                                            body = Term{
                                              typeApplication = TypeApplicationTerm{
                                                body = Term{
                                                  `either` = left(Term{
                                                      `wrap` = WrappedTerm{
                                                        typeName = Name{"hydra.core.errors.DecodingError"},
                                                        body = Term{
                                                          literal = Literal{
                                                            `string` = "expected literal"}}}})},
                                                `type` = Type{
                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                            `type` = Type{
                                              literal = LiteralType{
                                                `boolean`}}}}),
                                      `cases` = [
                                        CaseAlternative{
                                          name = Name{"literal"},
                                          handler = Term{
                                            lambda = Lambda{
                                              parameter = Name{"v"},
                                              domain = given(Type{variable = Name{"hydra.core.model.Literal"}}),
                                              body = Term{
                                                application = Application{
                                                  function = Term{
                                                    `cases` = CaseStatement{
                                                      typeName = Name{"hydra.core.model.Literal"},
                                                      default = given(Term{
                                                          typeApplication = TypeApplicationTerm{
                                                            body = Term{
                                                              typeApplication = TypeApplicationTerm{
                                                                body = Term{
                                                                  `either` = left(Term{
                                                                      `wrap` = WrappedTerm{
                                                                        typeName = Name{"hydra.core.errors.DecodingError"},
                                                                        body = Term{
                                                                          literal = Literal{
                                                                            `string` = "expected boolean literal"}}}})},
                                                                `type` = Type{
                                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                            `type` = Type{
                                                              literal = LiteralType{
                                                                `boolean`}}}}),
                                                      `cases` = [
                                                        CaseAlternative{
                                                          name = Name{"boolean"},
                                                          handler = Term{
                                                            lambda = Lambda{
                                                              parameter = Name{"b"},
                                                              domain = given(Type{literal = LiteralType{`boolean`}}),
                                                              body = Term{
                                                                typeApplication = TypeApplicationTerm{
                                                                  body = Term{
                                                                    typeApplication = TypeApplicationTerm{
                                                                      body = Term{
                                                                        `either` = right(Term{
                                                                            variable = Name{"b"}})},
                                                                      `type` = Type{
                                                                        variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                                  `type` = Type{
                                                                    literal = LiteralType{
                                                                      `boolean`}}}}}}}]}},
                                                  argument = Term{
                                                    variable = Name{"v"}}}}}}}]}},
                                  argument = Term{
                                    variable = Name{"stripped"}}}}}}}},
                      argument = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"hydra.core.extract.model.stripWithDecodingError"}},
                              argument = Term{
                                variable = Name{"cx"}}}},
                          argument = Term{
                            variable = Name{"raw"}}}}}}}}}},
      `decimal`=λ`_`.Term{
            lambda = Lambda{
              parameter = Name{"cx"},
              domain = given(Type{
                  variable = Name{"hydra.core.graph.Graph"}}),
              body = Term{
                lambda = Lambda{
                  parameter = Name{"raw"},
                  domain = given(Type{
                      variable = Name{"hydra.core.model.Term"}}),
                  body = Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                typeApplication = TypeApplicationTerm{
                                  body = Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            variable = Name{"hydra.core.lib.eithers.either"}},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = Type{
                                        variable = Name{"hydra.core.model.Term"}}}},
                                  `type` = Type{
                                    `either` = EitherType{
                                      `left` = Type{
                                        variable = Name{"hydra.core.errors.DecodingError"}},
                                      `right` = Type{
                                        literal = LiteralType{
                                          `decimal`}}}}}},
                              argument = Term{
                                lambda = Lambda{
                                  parameter = Name{"err"},
                                  domain = given(Type{
                                      variable = Name{"hydra.core.errors.DecodingError"}}),
                                  body = Term{
                                    typeApplication = TypeApplicationTerm{
                                      body = Term{
                                        typeApplication = TypeApplicationTerm{
                                          body = Term{
                                            `either` = left(Term{
                                                variable = Name{"err"}})},
                                          `type` = Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}}},
                                      `type` = Type{
                                        literal = LiteralType{
                                          `decimal`}}}}}}}},
                          argument = Term{
                            lambda = Lambda{
                              parameter = Name{"stripped"},
                              domain = given(Type{
                                  variable = Name{"hydra.core.model.Term"}}),
                              body = Term{
                                application = Application{
                                  function = Term{
                                    `cases` = CaseStatement{
                                      typeName = Name{"hydra.core.model.Term"},
                                      default = given(Term{
                                          typeApplication = TypeApplicationTerm{
                                            body = Term{
                                              typeApplication = TypeApplicationTerm{
                                                body = Term{
                                                  `either` = left(Term{
                                                      `wrap` = WrappedTerm{
                                                        typeName = Name{"hydra.core.errors.DecodingError"},
                                                        body = Term{
                                                          literal = Literal{
                                                            `string` = "expected literal"}}}})},
                                                `type` = Type{
                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                            `type` = Type{
                                              literal = LiteralType{
                                                `decimal`}}}}),
                                      `cases` = [
                                        CaseAlternative{
                                          name = Name{"literal"},
                                          handler = Term{
                                            lambda = Lambda{
                                              parameter = Name{"v"},
                                              domain = given(Type{variable = Name{"hydra.core.model.Literal"}}),
                                              body = Term{
                                                application = Application{
                                                  function = Term{
                                                    `cases` = CaseStatement{
                                                      typeName = Name{"hydra.core.model.Literal"},
                                                      default = given(Term{
                                                          typeApplication = TypeApplicationTerm{
                                                            body = Term{
                                                              typeApplication = TypeApplicationTerm{
                                                                body = Term{
                                                                  `either` = left(Term{
                                                                      `wrap` = WrappedTerm{
                                                                        typeName = Name{"hydra.core.errors.DecodingError"},
                                                                        body = Term{
                                                                          literal = Literal{
                                                                            `string` = "expected decimal literal"}}}})},
                                                                `type` = Type{
                                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                            `type` = Type{
                                                              literal = LiteralType{
                                                                `decimal`}}}}),
                                                      `cases` = [
                                                        CaseAlternative{
                                                          name = Name{"decimal"},
                                                          handler = Term{
                                                            lambda = Lambda{
                                                              parameter = Name{"d"},
                                                              domain = given(Type{literal = LiteralType{`decimal`}}),
                                                              body = Term{
                                                                typeApplication = TypeApplicationTerm{
                                                                  body = Term{
                                                                    typeApplication = TypeApplicationTerm{
                                                                      body = Term{
                                                                        `either` = right(Term{
                                                                            variable = Name{"d"}})},
                                                                      `type` = Type{
                                                                        variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                                  `type` = Type{
                                                                    literal = LiteralType{
                                                                      `decimal`}}}}}}}]}},
                                                  argument = Term{
                                                    variable = Name{"v"}}}}}}}]}},
                                  argument = Term{
                                    variable = Name{"stripped"}}}}}}}},
                      argument = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"hydra.core.extract.model.stripWithDecodingError"}},
                              argument = Term{
                                variable = Name{"cx"}}}},
                          argument = Term{
                            variable = Name{"raw"}}}}}}}}}},
      float=λft.cases(FloatType){
            `float32`=λ`_`.Term{
                  lambda = Lambda{
                    parameter = Name{"cx"},
                    domain = given(Type{
                        variable = Name{"hydra.core.graph.Graph"}}),
                    body = Term{
                      lambda = Lambda{
                        parameter = Name{"raw"},
                        domain = given(Type{
                            variable = Name{"hydra.core.model.Term"}}),
                        body = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      typeApplication = TypeApplicationTerm{
                                        body = Term{
                                          typeApplication = TypeApplicationTerm{
                                            body = Term{
                                              typeApplication = TypeApplicationTerm{
                                                body = Term{
                                                  variable = Name{"hydra.core.lib.eithers.either"}},
                                                `type` = Type{
                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                            `type` = Type{
                                              variable = Name{"hydra.core.model.Term"}}}},
                                        `type` = Type{
                                          `either` = EitherType{
                                            `left` = Type{
                                              variable = Name{"hydra.core.errors.DecodingError"}},
                                            `right` = Type{
                                              literal = LiteralType{
                                                float = ft}}}}}},
                                    argument = Term{
                                      lambda = Lambda{
                                        parameter = Name{"err"},
                                        domain = given(Type{
                                            variable = Name{"hydra.core.errors.DecodingError"}}),
                                        body = Term{
                                          typeApplication = TypeApplicationTerm{
                                            body = Term{
                                              typeApplication = TypeApplicationTerm{
                                                body = Term{
                                                  `either` = left(Term{
                                                      variable = Name{"err"}})},
                                                `type` = Type{
                                                  variable = Name{"hydra.core.errors.DecodingError"}}}},
                                            `type` = Type{
                                              literal = LiteralType{
                                                float = ft}}}}}}}},
                                argument = Term{
                                  lambda = Lambda{
                                    parameter = Name{"stripped"},
                                    domain = given(Type{
                                        variable = Name{"hydra.core.model.Term"}}),
                                    body = Term{
                                      application = Application{
                                        function = Term{
                                          `cases` = CaseStatement{
                                            typeName = Name{"hydra.core.model.Term"},
                                            default = given(Term{
                                                typeApplication = TypeApplicationTerm{
                                                  body = Term{
                                                    typeApplication = TypeApplicationTerm{
                                                      body = Term{
                                                        `either` = left(Term{
                                                            `wrap` = WrappedTerm{
                                                              typeName = Name{"hydra.core.errors.DecodingError"},
                                                              body = Term{
                                                                literal = Literal{
                                                                  `string` = "expected literal"}}}})},
                                                      `type` = Type{
                                                        variable = Name{"hydra.core.errors.DecodingError"}}}},
                                                  `type` = Type{
                                                    literal = LiteralType{
                                                      float = ft}}}}),
                                            `cases` = [
                                              CaseAlternative{
                                                name = Name{"literal"},
                                                handler = Term{
                                                  lambda = Lambda{
                                                    parameter = Name{"v"},
                                                    domain = given(Type{variable = Name{"hydra.core.model.Literal"}}),
                                                    body = Term{
                                                      application = Application{
                                                        function = Term{
                                                          `cases` = CaseStatement{
                                                            typeName = Name{"hydra.core.model.Literal"},
                                                            default = given(Term{
                                                                typeApplication = TypeApplicationTerm{
                                                                  body = Term{
                                                                    typeApplication = TypeApplicationTerm{
                                                                      body = Term{
                                                                        `either` = left(Term{
                                                                            `wrap` = WrappedTerm{
                                                                              typeName = Name{"hydra.core.errors.DecodingError"},
                                                                              body = Term{
                                                                                literal = Literal{
                                                                                  `string` = strings.concat
                                                                                      ["expected ", "float32", " literal"]}}}})},
                                                                      `type` = Type{
                                                                        variable = Name{"hydra.core.errors.DecodingError"}}}},
