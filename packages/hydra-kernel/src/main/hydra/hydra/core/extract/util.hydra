## Extraction and validation for hydra.core.util types
module hydra.core.extract.util

import hydra.core.errors
import hydra.core.extract.model
import hydra.core.lib.eithers
import hydra.core.lib.equality
import hydra.core.lib.logic
import hydra.core.model
import hydra.core.util

## Extract a comparison from a term
term comparison =
  λcx,graph,`term`.bind
      (unitVariant Name{"hydra.core.util.Comparison"} graph `term`)
      (λfname.ifElse
          (equal (Name[] fname) "equalTo")
          right(Comparison{equalTo})
          (ifElse
            (equal (Name[] fname) "lessThan")
            right(Comparison{lessThan})
            (ifElse
              (equal (Name[] fname) "greaterThan")
              right(Comparison{greaterThan})
              left(Error{
                extraction = ExtractionError{
                  unexpectedShape = UnexpectedShapeError{
                    expected = "comparison",
                    actual = Name[] fname}}}))))