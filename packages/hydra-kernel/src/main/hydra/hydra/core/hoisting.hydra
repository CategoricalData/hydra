## Functions for deep term rewriting operations involving hoisting subterms or bindings into enclosing let terms.
module hydra.core.hoisting

import hydra.core.environment as environment
import hydra.core.graph as graph
import hydra.core.lexical as lexical
import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals as literals
import hydra.core.lib.logic as logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math as math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering as ordering
import hydra.core.lib.pairs as pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model as model
import hydra.core.paths as paths
import hydra.core.resolution as resolution
import hydra.core.rewriting as rewriting
import hydra.core.scoping as scoping
import hydra.core.sorting as sorting
import hydra.core.strip as strip
import hydra.core.substitution as substitution
import hydra.core.typing as typing
import hydra.core.variables as variables

## Augment bindings with new free variables introduced by substitution, wrapping with lambdas after any type lambdas.
term augmentBindingsWithNewFreeVars =
  λcx,boundVars,bindings.
    let types := maps.map scoping.typeSchemeToFType (graph.Graph[boundTypes] cx) in
    let wrapAfterTypeLambdas := λvars,`term`.cases(model.Term){
          typeLambda=λtl.model.Term{
                typeLambda = model.TypeLambda{
                  parameter = model.TypeLambda[parameter] tl,
                  body = wrapAfterTypeLambdas
                      vars
                      (model.TypeLambda[body] tl)}},
          `_`=lists.foldl
              (λt,p.model.Term{
                  lambda = model.Lambda{
                    parameter = pairs.first p,
                    domain = pairs.second p,
                    body = t}})
              `term`
              (lists.reverse vars)}
          `term` in
    let augment := λb.
        let freeVars := sets.toList
            (sets.intersection
              boundVars
              (variables.freeVariablesInTerm (model.Binding[`term`] b))) in
        let varTypePairs := lists.map (λv.(v, maps.lookup v types)) freeVars in
        let varTypes := optionals.givens (lists.map pairs.second varTypePairs) in
        let newTypeScheme := logic.ifElse
            (equality.equal
              (lists.length varTypes)
              (lists.length varTypePairs))
            (optionals.map
              (λts.model.TypeScheme{
                  variables = model.TypeScheme[variables] ts,
                  body = lists.foldl
                      (λacc,t.model.Type{
                          function = model.FunctionType{
                            domain = t,
                            codomain = acc}})
                      (model.TypeScheme[body] ts)
                      (lists.reverse varTypes),
                  constraints = model.TypeScheme[constraints] ts})
              (model.Binding[typeScheme] b))
            (model.Binding[typeScheme] b) in
        logic.ifElse
          (lists.isEmpty freeVars)
          (b, none)
          (
            model.Binding{
              name = model.Binding[name] b,
              `term` = wrapAfterTypeLambdas varTypePairs (model.Binding[`term`] b),
              typeScheme = newTypeScheme},
            given((
              model.Binding[name] b,
              lists.foldl
                (λt,v.model.Term{application = model.Application{function = t, argument = model.Term{variable = v}}})
                model.Term{variable = model.Binding[name] b}
                freeVars))) in
    let results := lists.map augment bindings in
    (lists.map pairs.first results, typing.TermSubst{maps.fromList (optionals.givens (lists.map pairs.second results))})

## Check if a binding has a polymorphic type (non-empty list of type scheme variables)
term bindingIsPolymorphic =
  λbinding.optionals.match
      (model.Binding[typeScheme] binding)
      false
      (λts.logic.not (lists.isEmpty (model.TypeScheme[variables] ts)))

## Check if a binding's type uses any type variables from the given Graph. Returns True if the free type variables in the binding's type intersect with the type variables in scope (graphTypeVariables).
term bindingUsesContextTypeVars =
  λcx,binding.optionals.match
      (model.Binding[typeScheme] binding)
      false
      (λts.
        let freeInType := variables.freeVariablesInType (model.TypeScheme[body] ts) in
        let contextTypeVars := graph.Graph[typeVariables] cx in
        logic.not (sets.isEmpty (sets.intersection freeInType contextTypeVars)))

## Count the number of occurrences of a variable name in a term. Assumes no variable shadowing.
term countVarOccurrences =
  λname,`term`.
    let childCount := lists.foldl
        (λacc,t.math.add acc (countVarOccurrences name t))
        0:int32
        (rewriting.subterms `term`)
    in cases(model.Term){
      variable=λv.logic.ifElse
            (equality.equal v name)
            (math.add 1:int32 childCount)
            childCount,
      `_`=childCount}
      `term`

## Transform a let-term by pulling ALL let bindings to the top level. This is useful for targets like Java that don't support nested let expressions at all. If a hoisted binding captures lambda-bound variables from an enclosing scope, the binding is wrapped in lambdas for those variables, and references are replaced with applications. Note: Assumes no variable shadowing; use hydra.core.rewriting.unshadowVariables first.
term hoistAllLetBindings =
  λlet0.
    let emptyCx := graph.Graph{
      boundTerms = maps.empty,
      boundTypes = maps.empty,
      classConstraints = maps.empty,
      lambdaVariables = sets.empty,
      metadata = maps.empty,
      primitives = maps.empty,
      schemaTypes = maps.empty,
      typeVariables = sets.empty}
    in hoistLetBindingsWithPredicate (λ`_`.true) shouldHoistAll emptyCx let0

## Hoist case statements into local let bindings. This is useful for targets such as Python which only support case statements (match) at the top level. Case statements are hoisted only when they appear at non-top-level positions. Top level = root, or reachable through annotations, let body/binding, lambda bodies, or ONE application LHS. Once through an application LHS, lambda bodies no longer count as pass-through.
term hoistCaseStatements = hoistSubterms shouldHoistCaseStatement

## Hoist case statements into local let bindings for a list of bindings. This version operates prior to inference and uses an empty type context. It hoists case statements and their applied arguments into let bindings.
term hoistCaseStatementsInGraph =
  λbindings.
    let emptyTx := graph.Graph{
      boundTerms = maps.empty,
      boundTypes = maps.empty,
      classConstraints = maps.empty,
      lambdaVariables = sets.empty,
      metadata = maps.empty,
      primitives = maps.empty,
      schemaTypes = maps.empty,
      typeVariables = sets.empty} in
    let term0 := model.Term{`let` = model.Let{bindings = bindings, body = model.Term{`unit`}}} in
    let term1 := hoistCaseStatements emptyTx term0 in
    environment.termAsBindings term1

## Transform a let-term by pulling polymorphic let bindings to the top level, using Graph. A binding is hoisted if: (1) It is polymorphic (has non-empty typeSchemeVariables), OR (2) Its type uses type variables from the Graph (i.e., from enclosing type lambdas). Bindings which are already at the top level are not hoisted. If a hoisted binding captures lambda-bound or let-bound variables from an enclosing scope, the binding is wrapped in lambdas for those variables, and references are replaced with applications. If a hoisted binding uses type variables from the context, those type variables are added to the binding's type scheme. Note: we assume that there is no variable shadowing; use hydra.core.rewriting.unshadowVariables first.
term hoistLetBindingsWithContext =
  λisParentBinding,cx,let0.hoistLetBindingsWithPredicate isParentBinding shouldHoistPolymorphic cx let0

## Transform a let-term by pulling let bindings to the top level. The isParentBinding predicate applies to top-level bindings and determines whether their subterm bindings are eligible for hoisting. The shouldHoistBinding predicate takes the Graph and a subterm binding, and returns True if the binding should be hoisted. This is useful for targets like Java that cannot have polymorphic definitions in arbitrary positions. The Graph provides information about type variables and lambda variables in scope. If a hoisted binding captures let-bound or lambda-bound variables from an enclosing scope, the binding is wrapped in lambdas for those variables, and references are replaced with applications. If a hoisted binding captures type variables from an enclosing type lambda scope, those type variables are added to the binding's type scheme, and references are replaced with type applications. Note: we assume that there is no variable shadowing; use hydra.core.rewriting.unshadowVariables first.
term hoistLetBindingsWithPredicate =
  λisParentBinding,shouldHoistBinding,cx0,let0.
    let hoistOne := λprefix,cx,pair,bindingWithCapturedVars.
        let bindingAndReplacementPairs := pairs.first pair in
        let alreadyUsedNames := pairs.second pair in
        let b := pairs.first bindingWithCapturedVars in
        let capturedTermVars := pairs.second bindingWithCapturedVars in
        let types := maps.map
            scoping.typeSchemeToFType
            (graph.Graph[boundTypes] cx) in
        let capturedTermVarTypePairs := lists.map
            (λv.(v, maps.lookup v types))
            capturedTermVars in
        let capturedTermVarTypes := lists.map
            (λtyp.strip.deannotateTypeParameters typ)
            (optionals.givens
              (lists.map
                pairs.second
                capturedTermVarTypePairs)) in
        let freeInBindingType := optionals.match
            (model.Binding[typeScheme] b)
            sets.empty
            (λts.variables.freeVariablesInType
                (model.TypeScheme[body] ts)) in
        let freeInCapturedVarTypes := sets.unions
            (lists.map
              (λt.variables.freeVariablesInType t)
              capturedTermVarTypes) in
        let capturedTypeVars := sets.toList
            (sets.intersection
              (graph.Graph[typeVariables] cx)
              (sets.union
                freeInBindingType
                freeInCapturedVarTypes)) in
        let globalBindingName := lexical.chooseUniqueName
            alreadyUsedNames
            model.Name{strings.concat2
              prefix
              (model.Name[] (model.Binding[name] b))} in
        let newUsedNames := sets.insert
            globalBindingName
            alreadyUsedNames in
        let newTypeScheme := logic.ifElse
            (equality.equal
              (lists.length capturedTermVarTypes)
              (lists.length capturedTermVarTypePairs))
            (optionals.map
              (λts.model.TypeScheme{
                  variables = lists.distinct
                      (lists.concat2
                        capturedTypeVars
                        (model.TypeScheme[variables] ts)),
                  body = lists.foldl
                      (λt,a.model.Type{
                          function = model.FunctionType{
                            domain = a,
                            codomain = t}})
                      (model.TypeScheme[body] ts)
                      (lists.reverse capturedTermVarTypes),
                  constraints = model.TypeScheme[constraints] ts})
              (model.Binding[typeScheme] b))
            none in
        let strippedTerm := strip.stripTypeLambdas
            (model.Binding[`term`] b) in
        let termWithLambdas := lists.foldl
            (λt,p.model.Term{
                lambda = model.Lambda{
                  parameter = pairs.first p,
                  domain = optionals.map
                      (λdom.strip.deannotateTypeParameters dom)
                      (pairs.second p),
                  body = t}})
            strippedTerm
            (lists.reverse capturedTermVarTypePairs) in
        let termWithTypeLambdas := lists.foldl
            (λt,v.model.Term{
                typeLambda = model.TypeLambda{
                  parameter = v,
                  body = t}})
            termWithLambdas
            (lists.reverse
              (optionals.match
                newTypeScheme
                []
                model.TypeScheme[variables])) in
        let withTypeApps := lists.foldl
            (λt,v.model.Term{
                typeApplication = model.TypeApplicationTerm{
                  body = t,
                  `type` = model.Type{
                    variable = v}}})
            model.Term{
              variable = globalBindingName}
            capturedTypeVars in
        let replacement := lists.foldl
            (λt,v.model.Term{
                application = model.Application{
                  function = t,
                  argument = model.Term{
                    variable = v}}})
            withTypeApps
            capturedTermVars in
        let newBindingAndReplacement := (model.Binding{name = globalBindingName, `term` = termWithTypeLambdas, typeScheme = newTypeScheme}, replacement) in
        let newPairs := lists.cons
            newBindingAndReplacement
            bindingAndReplacementPairs in
        (newPairs, newUsedNames) in
    let rewrite := λprefix,recurse,cx,bindingsAndNames,`term`.
        let previouslyFinishedBindings := pairs.first bindingsAndNames in
        let emptyBindingsAndNames := ([], pairs.second bindingsAndNames) in
        let result := recurse emptyBindingsAndNames `term` in
        let newBindingsAndNames := pairs.first result in
        let bindingsSoFar := pairs.first newBindingsAndNames in
        let alreadyUsedNames := pairs.second newBindingsAndNames in
        let newTerm := pairs.second result in
        cases(model.Term){
          `let`=λl.
              let body := model.Let[body] l in
              let partitionPair := lists.partition
                  (shouldHoistBinding cx)
                  (model.Let[bindings] l) in
              let hoistUs := pairs.first partitionPair in
              let keepUs := pairs.second partitionPair in
              let hoistedBindingNames := lists.map model.Binding[name] hoistUs in
              let polyLetVariables := sets.fromList
                  (lists.filter
                    (λv.optionals.match
                        (optionals.map
                          scoping.typeSchemeToFType
                          (maps.lookup
                            v
                            (graph.Graph[boundTypes] cx)))
                        false
                        resolution.fTypeIsPolymorphic)
                    (sets.toList
                      (sets.difference
                        (sets.fromList
                          (maps.keys (graph.Graph[boundTerms] cx)))
                        (graph.Graph[lambdaVariables] cx)))) in
              let boundTermVariables := sets.union
                  (graph.Graph[lambdaVariables] cx)
                  (sets.difference
                    (sets.fromList
                      (maps.keys (graph.Graph[boundTerms] cx)))
                    (graph.Graph[lambdaVariables] cx)) in
              let freeVariablesInEachBinding := lists.map
                  (λb.sets.toList
                      (sets.intersection
                        boundTermVariables
                        (variables.freeVariablesInTerm
                          (model.Binding[`term`] b))))
                  hoistUs in
              let bindingDependencies := lists.map
                  (λvars.lists.partition
                      (λv.sets.member
                          v
                          (sets.fromList hoistedBindingNames))
                      vars)
                  freeVariablesInEachBinding in
              let bindingEdges := lists.zip
                  hoistedBindingNames
                  (lists.map
                    pairs.first
                    bindingDependencies) in
              let bindingImmediateCapturedVars := lists.zip
                  hoistedBindingNames
                  (lists.map
                    pairs.second
                    bindingDependencies) in
              let capturedVarsMap := maps.fromList
                  (sorting.propagateTags
                    bindingEdges
                    bindingImmediateCapturedVars) in
              let bindingsWithCapturedVars := lists.map
                  (λb.(
                      b,
                      optionals.match
                        (maps.lookup (model.Binding[name] b) capturedVarsMap)
                        []
                        (λvars.sets.toList (sets.difference vars polyLetVariables))))
                  hoistUs in
              let hoistPairsAndNames := lists.foldl
                  (hoistOne prefix cx)
                  ([], alreadyUsedNames)
                  bindingsWithCapturedVars in
              let hoistPairs := lists.reverse
                  (pairs.first hoistPairsAndNames) in
              let hoistedBindings := lists.map pairs.first hoistPairs in
              let replacements := lists.map pairs.second hoistPairs in
              let finalUsedNames := pairs.second hoistPairsAndNames in
              let hoistNameReplacementPairs := lists.zip
                  (lists.map model.Binding[name] hoistUs)
                  replacements in
              let hoistBindingMap := maps.fromList
                  (lists.map
                    (λb.(model.Binding[name] b, b))
                    hoistUs) in
              let isCacheable := λname.
                  let multiRef := ordering.gte
                      (countVarOccurrences name body)
                      2:int32 in
                  let isPoly := optionals.match
                      (maps.lookup name hoistBindingMap)
                      false
                      (λb.bindingIsPolymorphic b) in
                  logic.and multiRef (logic.not isPoly) in
              let singleRefPairs := lists.filter
                  (λp.logic.not (isCacheable (pairs.first p)))
                  hoistNameReplacementPairs in
              let multiRefPairs := lists.filter
                  (λp.isCacheable (pairs.first p))
                  hoistNameReplacementPairs in
              let fullSubst := typing.TermSubst{maps.fromList hoistNameReplacementPairs} in
              let bodyOnlySubst := typing.TermSubst{maps.fromList singleRefPairs} in
              let bodySubst := substitution.substituteInTerm
                  bodyOnlySubst
                  body in
              let cacheBindings := lists.map
                  (λp.
                    let origType := optionals.match
                        (maps.lookup
                          (pairs.first p)
                          hoistBindingMap)
                        none
                        (λb.model.Binding[typeScheme] b)
                    in model.Binding{
                      name = pairs.first p,
                      `term` = pairs.second p,
                      typeScheme = origType})
                  multiRefPairs in
              let bodyWithCache := logic.ifElse
                  (lists.isEmpty cacheBindings)
                  bodySubst
                  model.Term{
                    `let` = model.Let{
                      bindings = cacheBindings,
                      body = bodySubst}} in
              let keepUsSubst := lists.map
                  (substitution.substituteInBinding
                    fullSubst)
                  keepUs in
              let hoistedBindingsSubst := lists.map
                  (substitution.substituteInBinding
                    fullSubst)
                  hoistedBindings in
              let bindingsSoFarSubst := lists.map
                  (substitution.substituteInBinding
                    fullSubst)
                  bindingsSoFar in
              let augmentResult := augmentBindingsWithNewFreeVars
                  cx
                  (sets.difference
                    boundTermVariables
                    polyLetVariables)
                  bindingsSoFarSubst in
              let bindingsSoFarAugmented := pairs.first augmentResult in
              let augmentSubst := pairs.second augmentResult in
              let hoistedBindingsFinal := lists.map
                  (substitution.substituteInBinding
                    augmentSubst)
                  hoistedBindingsSubst in
              let bindingsSoFarFinal := lists.map
                  (substitution.substituteInBinding
                    augmentSubst)
                  bindingsSoFarAugmented in
              let bodyFinal := substitution.substituteInTerm
                  augmentSubst
                  bodyWithCache in
              let keepUsFinal := lists.map
                  (substitution.substituteInBinding
                    augmentSubst)
                  keepUsSubst in
              let finalTerm := logic.ifElse
                  (lists.isEmpty keepUsFinal)
                  bodyFinal
                  model.Term{
                    `let` = model.Let{
                      bindings = keepUsFinal,
                      body = bodyFinal}} in
              ((lists.concat [previouslyFinishedBindings, hoistedBindingsFinal, bindingsSoFarFinal], finalUsedNames), finalTerm),
          `_`=((lists.concat2 previouslyFinishedBindings bindingsSoFar, alreadyUsedNames), newTerm)}
          newTerm in
    let cx1 := scoping.extendGraphForLet (λc,b.none) cx0 let0 in
    let forActiveBinding := λb.
        let prefix := strings.concat2
            (model.Name[] (model.Binding[name] b))
            "_" in
        let init := ([], sets.singleton (model.Binding[name] b)) in
        let resultPair := rewriting.rewriteAndFoldTermWithGraph
            (rewrite prefix)
            cx1
            init
            (model.Binding[`term`] b) in
        let resultBindings := pairs.first (pairs.first resultPair) in
        let resultTerm := pairs.second resultPair in
        lists.cons
          model.Binding{
            name = model.Binding[name] b,
            `term` = resultTerm,
            typeScheme = model.Binding[typeScheme] b}
          resultBindings in
    let forBinding := λb.logic.ifElse
          (isParentBinding b)
          (forActiveBinding b)
          [b] in
    model.Let{
      bindings = lists.concat
          (lists.map forBinding (model.Let[bindings] let0)),
      body = model.Let[body] let0}

## Transform a let-term by pulling all polymorphic let bindings to the top level. This is useful to ensure that polymorphic bindings are not nested within other terms, which is unsupported by certain targets such as Java. Polymorphic bindings are those with a non-empty list of type scheme variables. If a hoisted binding captures lambda-bound variables from an enclosing scope, the binding is wrapped in lambdas for those variables, and references are replaced with applications. Note: Assumes no variable shadowing; use hydra.core.rewriting.unshadowVariables first.
term hoistPolymorphicLetBindings =
  λisParentBinding,let0.
    let emptyCx := graph.Graph{
      boundTerms = maps.empty,
      boundTypes = maps.empty,
      classConstraints = maps.empty,
      lambdaVariables = sets.empty,
      metadata = maps.empty,
      primitives = maps.empty,
      schemaTypes = maps.empty,
      typeVariables = sets.empty}
    in hoistLetBindingsWithPredicate isParentBinding shouldHoistPolymorphic emptyCx let0

## Hoist subterms into local let bindings based on a path-aware predicate. The predicate receives a pair of (path, term) where path is the list of SubtermSteps from the root to the current term, and returns True if the term should be hoisted. For each let term found, the immediate subterms (binding values and body) are processed: matching subterms within each immediate subterm are collected and hoisted into a local let that wraps that immediate subterm. If a hoisted term contains free variables that are lambda-bound at an enclosing scope, the hoisted binding is wrapped in lambdas for those variables, and the reference is replaced with an application of those variables.
term hoistSubterms =
  λshouldHoist,cx0,term0.
    let processImmediateSubterm := λcx,counter,namePrefix,pathPrefix,subterm.
        let baselineLambdaVars := graph.Graph[lambdaVariables] cx in
        let collectAndReplace := λrecurse,path,cxInner,acc,`term`.
            let currentCounter := pairs.first acc in
            let collectedBindings := pairs.second acc in
            cases(model.Term){
              `let`=λ`_`.(acc, `term`),
              typeLambda=λ`_`.(acc, `term`),
              `_`=let result := recurse acc `term` in
                let newAcc := pairs.first result in
                let processedTerm := pairs.second result in
                let newCounter := pairs.first newAcc in
                let newBindings := pairs.second newAcc in
                let fullPath := lists.concat2 pathPrefix path in
                logic.ifElse
                  (shouldHoist (fullPath, processedTerm))
                  (let proposedName := model.Name{strings.concat
                    ["_hoist_", namePrefix, "_", literals.printInt32 newCounter]} in
                  let existingNames := sets.fromList
                      (lists.map
                        (λb.model.Binding[name] b)
                        newBindings) in
                  let freeVarsInSubterm := variables.freeVariablesInTerm subterm in
                  let allReserved := sets.union
                      existingNames
                      freeVarsInSubterm in
                  let bindingName := lexical.chooseUniqueName
                      allReserved
                      proposedName in
                  let allLambdaVars := graph.Graph[lambdaVariables] cxInner in
                  let newLambdaVars := sets.difference
                      allLambdaVars
                      baselineLambdaVars in
                  let freeVars := variables.freeVariablesInTerm
                      processedTerm in
                  let capturedVars := sets.toList
                      (sets.intersection newLambdaVars freeVars) in
                  let typeMap := maps.map
                      scoping.typeSchemeToFType
                      (graph.Graph[boundTypes] cxInner) in
                  let wrappedTerm := lists.foldl
                      (λbody,varName.model.Term{
                          lambda = model.Lambda{
                            parameter = varName,
                            domain = maps.lookup varName typeMap,
                            body = body}})
                      processedTerm
                      (lists.reverse capturedVars) in
                  let reference := lists.foldl
                      (λfn,varName.model.Term{
                          application = model.Application{
                            function = fn,
                            argument = model.Term{
                              variable = varName}}})
                      model.Term{
                        variable = bindingName}
                      capturedVars in
                  let newBinding := model.Binding{
                    name = bindingName,
                    `term` = wrappedTerm,
                    typeScheme = none} in
                  ((math.add newCounter 1:int32, lists.cons newBinding newBindings), reference))
                  (newAcc, processedTerm)}
              `term` in
        let result := rewriting.rewriteAndFoldTermWithGraphAndPath
            collectAndReplace
            cx
            (counter, [])
            subterm in
        let finalAcc := pairs.first result in
        let transformedSubterm := pairs.second result in
        let finalCounter := pairs.first finalAcc in
        let bindings := pairs.second finalAcc in
        logic.ifElse
          (lists.isEmpty bindings)
          (finalCounter, transformedSubterm)
          (let localLet := model.Term{
            `let` = model.Let{
              bindings = lists.reverse bindings,
              body = transformedSubterm}}
          in (finalCounter, localLet)) in
    let processLetTerm := λcx,counter,path,lt.
        let bindings := model.Let[bindings] lt in
        let body := model.Let[body] lt in
        let processBinding := λacc,binding.
            let namePrefix := strings.join
                "_"
                (strings.splitOn
                  "."
                  (model.Name[]
                    (model.Binding[name] binding))) in
            let bindingPathPrefix := lists.concat2
                path
                [paths.SubtermStep{letBinding = model.Binding[name] binding}] in
            let result := processImmediateSubterm
                cx
                1:int32
                namePrefix
                bindingPathPrefix
                (model.Binding[`term`] binding) in
            let newValue := pairs.second result in
            let newBinding := model.Binding{
              name = model.Binding[name] binding,
              `term` = newValue,
              typeScheme = model.Binding[typeScheme] binding} in
            lists.cons newBinding acc in
        let newBindingsReversed := lists.foldl processBinding [] bindings in
        let newBindings := lists.reverse newBindingsReversed in
        let bodyPathPrefix := lists.concat2
            path
            [paths.SubtermStep{letBody}] in
        let firstBindingName := optionals.match
            (lists.head bindings)
            "body"
            (λb.strings.join
                "_"
                (strings.splitOn
                  "."
                  (model.Name[] (model.Binding[name] b)))) in
        let bodyPrefix := strings.concat2 firstBindingName "_body" in
        let bodyResult := processImmediateSubterm
            cx
            1:int32
            bodyPrefix
            bodyPathPrefix
            body in
        let newBody := pairs.second bodyResult in
        (counter, model.Term{`let` = model.Let{bindings = newBindings, body = newBody}}) in
    let rewrite := λrecurse,path,cx,counter,`term`.cases(model.Term){
          `let`=λlt.
              let recursed := recurse counter `term` in
              let newCounter := pairs.first recursed in
              let recursedTerm := pairs.second recursed in
              cases(model.Term){
                `let`=λlt2.processLetTerm cx newCounter path lt2,
                `_`=(newCounter, recursedTerm)}
                recursedTerm,
          `_`=recurse counter `term`}
          `term` in
    pairs.second (rewriting.rewriteAndFoldTermWithGraphAndPath rewrite cx0 1:int32 term0)

## Check whether a SubtermStep is the applicationFunction step
term isApplicationFunction = λacc.cases(paths.SubtermStep){applicationFunction=λ`_`.true, `_`=false} acc

## Check whether a SubtermStep is the lambdaBody step
term isLambdaBody = λacc.cases(paths.SubtermStep){lambdaBody=λ`_`.true, `_`=false} acc

## Check if a term is a union elimination (case statement)
term isUnionElimination = λ`term`.cases(model.Term){`cases`=λ`_`.true, `_`=false} `term`

## Check if a term is an application of a union elimination (case statement applied to an argument)
term isUnionEliminationApplication =
  λ`term`.cases(model.Term){
      application=λapp.isUnionElimination
            (strip.deannotateAndDetypeTerm (model.Application[function] app)),
      `_`=false}
      `term`

## Normalize a path for hoisting by treating immediately-applied lambdas as let bindings. Replaces [applicationFunction, lambdaBody, ...] with [letBody, ...].
term normalizePathForHoisting =
  λpath.
    let go := λremaining.optionals.match
          (lists.uncons remaining)
          remaining
          (λuc1.
            let first := pairs.first uc1 in
            let afterFirst := pairs.second uc1 in
            optionals.match
              (lists.uncons afterFirst)
              remaining
              (λuc2.
                let second := pairs.first uc2 in
                let rest := pairs.second uc2 in
                logic.ifElse
                  (logic.and (isApplicationFunction first) (isLambdaBody second))
                  (lists.cons paths.SubtermStep{letBody} (go rest))
                  (lists.cons first (go afterFirst))))
    in go path

## Predicate that always returns True, for hoisting all bindings unconditionally.
term shouldHoistAll = λ`_`,`_`.true

## Predicate for case statement hoisting. Returns True if term is a union elimination (bare case function) or a case statement application (union elimination applied to an argument) AND not at top level. Top level = reachable through annotations, let body/binding, lambda bodies, or ONE app LHS. Once through an app LHS, lambda bodies no longer pass through.
term shouldHoistCaseStatement =
  λpathAndTerm.
    let path := pairs.first pathAndTerm in
    let `term` := pairs.second pathAndTerm in
    logic.ifElse
      (logic.not (logic.or (isUnionElimination `term`) (isUnionEliminationApplication `term`)))
      false
      (let finalState := lists.foldl (λst,acc.updateHoistState acc st) (true, false) path
      in logic.not (pairs.first finalState))

## Predicate for hoisting polymorphic bindings. Returns True if the binding is polymorphic (has type scheme variables) or if its type uses any type variables from the Graph.
term shouldHoistPolymorphic =
  λcx,binding.logic.or (bindingIsPolymorphic binding) (bindingUsesContextTypeVars cx binding)

## Update hoisting state when traversing an accessor. State is (atTopLevel, usedAppLHS). Returns updated state.
term updateHoistState =
  λaccessor,state.
    let atTop := pairs.first state in
    let usedApp := pairs.second state in
    logic.ifElse
      (logic.not atTop)
      (false, usedApp)
      (cases(paths.SubtermStep){
        annotatedBody=λ`_`.(true, usedApp),
        letBody=λ`_`.(true, usedApp),
        letBinding=λ`_`.(true, usedApp),
        typeApplicationBody=λ`_`.(true, usedApp),
        typeLambdaBody=λ`_`.(true, usedApp),
        lambdaBody=λ`_`.logic.ifElse usedApp (false, true) (true, false),
        casesCase=λ`_`.logic.ifElse usedApp (false, true) (true, false),
        casesDefault=λ`_`.logic.ifElse usedApp (false, true) (true, false),
        applicationFunction=λ`_`.logic.ifElse usedApp (false, true) (true, true),
        applicationArgument=λ`_`.(false, usedApp),
        `_`=(false, usedApp)}
        accessor)