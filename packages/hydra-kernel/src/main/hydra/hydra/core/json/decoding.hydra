## Decoding functions for JSON data
module hydra.core.json.decoding

import hydra.core.json.model
import hydra.core.lib.eithers as eithers
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals
import hydra.core.lib.strings

## Decode a JSON array using a decoder for elements
term decodeArray =
  λdecodeElem.cases(Value){array=λa.eithers.mapList decodeElem a, `_`=left("expected an array")}

## Decode a JSON boolean value
term decodeBoolean = cases(Value){`boolean`=λb.right(b), `_`=left("expected a boolean")}

## Decode a required field from a JSON object
term decodeField =
  λdecodeValue,name,m.eithers.bind
      (decodeOptionalField decodeValue name m)
      (λmf.match mf left(concat2 "missing field: " name) (λf.right(f)))

## Decode a JSON object value to a name-keyed map. Field order is not preserved; decoding looks fields up by name.
term decodeObject = cases(Value){object=λo.right(maps.fromList o), `_`=left("expected an object")}

## Decode an optional field from a JSON object
term decodeOptionalField =
  λdecodeValue,name,m.match (maps.lookup name m) right(none) (λv.eithers.map (λx.given(x)) (decodeValue v))

## Decode a JSON string value
term decodeString = cases(Value){`string`=λs.right(s), `_`=left("expected a string")}