## A JSON syntax model. See the BNF at https://www.json.org
module hydra.core.json.model



## Layout options for hydra.core.json.writer.printJsonWith
type JsonWriterOptions = record{
  ## Whether to omit all insignificant whitespace. When true, the value is rendered on a single line with no space after ':' or ',' and the indent, maxLineWidth, and maxIndentDepth fields are ignored.
  compact: boolean,
  ## The string used to indent each level of nesting when pretty-printing
  indent: string,
  ## The maximum estimated line width before an object or array breaks onto multiple lines. Ignored when compact is true.
  maxLineWidth: int32,
  ## The nesting depth at or beyond which objects and arrays are always rendered inline, regardless of estimated width. Depth 0 is the top-level value, so maxIndentDepth = 0 renders the entire value on one line. None means no depth-based limit. Ignored when compact is true.
  maxIndentDepth: optional<int32>}

## A JSON value
type Value = union{
  ## A JSON array
  array: list<Value>,
  ## A boolean value
  `boolean`: boolean,
  ## JSON's null value
  null: unit,
  ## A numeric value
  number: decimal,
  ## A JSON object as an ordered list of key/value pairs. The ordering preserves the declaration order of the record from which the object was encoded, rather than alphabetizing keys. As a consequence, equality of Value objects is order-sensitive: two objects with the same pairs in a different order are equal as JSON, but not as Hydra Values.
  object: list<(string, Value)>,
  ## A string value
  `string`: string}