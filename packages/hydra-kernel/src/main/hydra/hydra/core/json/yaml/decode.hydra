## YAML-to-JSON decoding. Converts YAML Nodes to JSON Values (may fail for non-JSON YAML), and YAML Nodes to Hydra Terms via JSON.
module hydra.core.json.yaml.decode

import hydra.core.json.decode as decode
import hydra.core.json.model as json.model
import hydra.core.lib.eithers as eithers
import hydra.core.lib.literals as literals
import hydra.core.lib.maps as maps
import hydra.core.lib.pairs as pairs
import hydra.core.yaml.model as yaml.model

## Decode a YAML node to a Hydra term via JSON decoding.
term fromYaml = λtypes,tname,typ,node.let jsonResult := yamlToJson node in eithers.either (λerr.left(err)) (λjson.decode.fromJson types false tname typ json) jsonResult

## Convert a YAML node to a JSON value. Fails for non-JSON YAML features (e.g. non-string mapping keys).
term yamlToJson = λnode.cases(yaml.model.Node){mapping=λm.let convertEntry := λkv.let keyNode := pairs.first kv in let valNode := pairs.second kv in let keyResult := cases(yaml.model.Node){scalar=λs.cases(yaml.model.Scalar){str=λstr.right(str), `_`=left("non-string YAML mapping key")} s, `_`=left("non-scalar YAML mapping key")} keyNode in eithers.either (λerr.left(err)) (λkey.let valResult := yamlToJson valNode in eithers.map (λv.(key, v)) valResult) keyResult in let entries := eithers.mapList convertEntry (maps.toList m) in eithers.map (λes.json.model.Value{object = es}) entries, scalar=λs.cases(yaml.model.Scalar){bool=λb.right(json.model.Value{`boolean` = b}), `decimal`=λd.right(json.model.Value{number = d}), float=λf.right(json.model.Value{number = literals.float64ToDecimal f}), int=λi.right(json.model.Value{number = literals.bigintToDecimal i}), null=λ`_`.right(json.model.Value{null}), str=λstr.right(json.model.Value{`string` = str})} s, sequence=λnodes.let results := eithers.mapList (λn.yamlToJson n) nodes in eithers.map (λvs.json.model.Value{array = vs}) results} node