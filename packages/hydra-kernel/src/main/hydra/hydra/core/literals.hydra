## Conversion functions for literal values.
module hydra.core.literals

import hydra.core.lib.literals
import hydra.core.model

## Convert a bigint to an integer value of a given type (note: lossy)
term bigintToIntegerValue =
  λit,bi.cases(IntegerType){
      `bigint`=λ`_`.IntegerValue{`bigint` = bi},
      `int8`=λ`_`.IntegerValue{`int8` = bigintToInt8 bi},
      `int16`=λ`_`.IntegerValue{`int16` = bigintToInt16 bi},
      `int32`=λ`_`.IntegerValue{`int32` = bigintToInt32 bi},
      `int64`=λ`_`.IntegerValue{`int64` = bigintToInt64 bi},
      `uint8`=λ`_`.IntegerValue{`uint8` = bigintToUint8 bi},
      `uint16`=λ`_`.IntegerValue{`uint16` = bigintToUint16 bi},
      `uint32`=λ`_`.IntegerValue{`uint32` = bigintToUint32 bi},
      `uint64`=λ`_`.IntegerValue{`uint64` = bigintToUint64 bi}}
      it

## Convert an integer value of any precision to a bigint
term integerValueToBigint =
  cases(IntegerValue){
    `bigint`=λbi.bi,
    `int8`=λi8.int8ToBigint i8,
    `int16`=λi16.int16ToBigint i16,
    `int32`=λi32.int32ToBigint i32,
    `int64`=λi64.int64ToBigint i64,
    `uint8`=λui8.uint8ToBigint ui8,
    `uint16`=λui16.uint16ToBigint ui16,
    `uint32`=λui32.uint32ToBigint ui32,
    `uint64`=λui64.uint64ToBigint ui64}