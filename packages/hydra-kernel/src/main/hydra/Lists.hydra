## Primitives in the hydra.core.lib.lists module.
##
## Lists form a monad: singleton is its unit and bind its bind, with map, apply, and compose completing the functor, applicative, and Kleisli structure.
## The traversal family mapList, mapOptional, and mapSet traverses a container in the list monad, and foldList is the monadic fold.
## The bare foldl and foldr are the plain, non-monadic folds.
module hydra.core.lib.lists

import hydra.core.paths
import hydra.core.ast
import hydra.core.coders
import hydra.core.model
import hydra.core.diff
import hydra.core.docs
import hydra.core.error.checking
import hydra.core.error.model
import hydra.core.error.file
import hydra.core.error.packaging
import hydra.core.error.system
import hydra.core.errors
import hydra.core.file
import hydra.core.graph
import hydra.core.json.model
import hydra.core.markdown
import hydra.core.packaging
import hydra.core.parsing
import hydra.core.query
import hydra.core.regex
import hydra.core.relational
import hydra.core.system
import hydra.core.tabular
import hydra.core.testing
import hydra.core.time
import hydra.core.topology
import hydra.core.typed
import hydra.core.typing
import hydra.core.util
import hydra.core.validation
import hydra.core.variants

## Apply a list of functions to a list of values (applicative style).
##
## apply(fs, xs) returns the list of all f x for f in fs and x in xs, in order: for each f in fs (outer loop), for each x in xs (inner loop).
## Equivalent to the applicative list instance.
## Total. Corresponds to Haskell's (<*>) :: [a -> b] -> [a] -> [b].
##
## @availableSince 0.15
## @requirement sequentialComposition apply threads the input list through every function in the function list in order, concatenating each function's output.
## @requirement identityCases apply with an empty function list, or an empty input list, or a single function/input, degrades correctly: zero functions or zero inputs yields an empty result; one of either acts as a direct map.
primitive apply : ∀x,y.list<x → y> → list<x> → list<y>

## Return the element at the given index, or Nothing if out of bounds.
##
## at(i, xs) returns Just(xs[i]) if 0 <= i < length(xs), or Nothing otherwise.
## Total. Wraps the Haskell (!!) operator, which is partial, in maybe to make out-of-bounds total.
## Renamed from hydra.lib.lists.maybeAt.
##
## @availableSince 0.17.6
## @requirement returnsElementAtIndex at returns the element at the given zero-based index, wrapped, for any valid index including the first and last.
## @requirement noneWhenOutOfRange at returns none when the index is negative, at or beyond the list's length, or when the list is empty.
primitive at : ∀x.int32 → list<x> → optional<x>

## Apply a function that returns lists to each element and flatten the results.
##
## bind(xs, f) applies f to each element of xs and concatenates the resulting lists in order. Equivalent to concatMap.
## Total. Corresponds to Haskell's (>>=) :: [a] -> (a -> [b]) -> [b].
##
## @availableSince 0.15
## @requirement flatMapsOverElements bind applies a list-producing function to each element and concatenates the results, in order, including when the function returns duplicate or negative values.
## @requirement emptyInput bind over an empty list is the empty list, regardless of the function supplied.
primitive bind : ∀x,y.list<x> → (x → list<y>) → list<y> = λxs.λf.hydra.core.lib.lists.foldr (λx.λacc.hydra.core.lib.lists.concat2 (f x) acc) [] xs

## Compose two functions that return lists (Kleisli composition in the list monad).
##
## compose(f, g, x) is bind(f(x), g); this defining equation is the specification. The results of applying g to each element of f(x) are concatenated in order.
## Total. Corresponds to Kleisli composition (>=>) in the list monad.
##
## @availableSince 0.17.6
primitive compose : ∀x,y,z.(x → list<y>) → (y → list<z>) → x → list<z> = λf.λg.λx.hydra.core.lib.lists.bind (f x) g

## Concatenate a list of lists.
##
## concat(xss) returns the list obtained by appending all the lists in xss in order.
## Total. Corresponds to Haskell's concat :: [[a]] -> [a].
##
## @availableSince 0.15
## @requirement flattensPreservingOrder concat flattens a list of lists into a single list, preserving element order within and across the constituent lists.
## @requirement emptyInputs concat of a list of lists in which every list is empty, or of an empty list of lists, is the empty list.
primitive concat : ∀x.list<list<x>> → list<x>

## Concatenate two lists.
##
## concat2(xs, ys) returns xs with ys appended.
## Total. Corresponds to Haskell's (++) :: [a] -> [a] -> [a].
##
## @availableSince 0.15
## @requirement appendsPreservingOrder concat2 appends its second list argument to its first, preserving the order of both, for both numeric and string element types.
## @requirement identityOnEmpty concat2 with either or both arguments empty returns the other argument unchanged (the empty list is the identity element).
primitive concat2 : ∀x.list<x> → list<x> → list<x>

## Prepend a value to a list.
##
## cons(x, xs) returns a list whose head is x and whose tail is xs.
## Total. Corresponds to Haskell's (:) :: a -> [a] -> [a].
##
## @availableSince 0.15
## @requirement prependsElement cons prepends its first argument to the front of its second argument (the list), for empty and non-empty lists, any element type, and any value including negative numbers.
primitive cons : ∀x.x → list<x> → list<x>

## Remove duplicate elements from a list.
##
## distinct(xs) returns the list of distinct elements of xs, in the order of their first occurrence.
## Requires an 'equality' constraint on the element type.
## Total. Corresponds to Haskell's Data.List.nub :: Eq a => [a] -> [a].
## Renamed from hydra.lib.lists.nub.
##
## @availableSince 0.17.6
## @requirement removesDuplicatesPreservingFirstOccurrence distinct removes repeated elements, keeping only the first occurrence of each distinct value and preserving the relative order of the survivors, for numeric and string element types.
## @requirement emptyInput distinct of an empty list is the empty list.
primitive distinct : ∀x.(equality x) ⇒ list<x> → list<x>

## Drop the first n elements from a list.
##
## drop(n, xs) returns the suffix of xs after dropping the first n elements; if n is greater than or equal to length(xs) the result is the empty list; if n is non-positive the result is xs unchanged.
## Total. Corresponds to Haskell's drop :: Int -> [a] -> [a].
##
## @availableSince 0.15
## @requirement dropsFromFront drop n removes the first n elements from the front of the list, or all elements if n is greater than or equal to the list's length.
## @requirement nonPositiveIsIdentity drop with n equal to zero or negative returns the list unchanged.
primitive drop : ∀x.int32 → list<x> → list<x>

## Drop elements from the beginning of a list while the predicate is true.
##
## dropWhile(p, xs) returns the suffix of xs starting at the first element for which p returns false. If p is true for every element, the result is the empty list.
## Total. Corresponds to Haskell's dropWhile :: (a -> Bool) -> [a] -> [a].
##
## @availableSince 0.15
## @requirement dropsLeadingMatches dropWhile removes elements from the front of the list for as long as the predicate holds, stopping at (and keeping) the first element for which it does not; an empty list, a predicate matching no elements, or a predicate matching every element are each handled correctly as boundary cases.
primitive dropWhile : ∀x.(x → boolean) → list<x> → list<x> = λp.λxs.hydra.core.lib.pairs.second (hydra.core.lib.lists.span p xs)

## Filter a list by a predicate.
##
## filter(p, xs) returns the list of elements x in xs for which p(x) is true, in original order.
## Total. Corresponds to Haskell's filter :: (a -> Bool) -> [a] -> [a].
##
## @availableSince 0.15
## @requirement keepsMatchingElements filter returns the sublist of elements satisfying the predicate, preserving their relative order, whether the predicate matches some, all, or none of the elements.
## @requirement emptyInput filter over an empty list is the empty list, regardless of the predicate.
primitive filter : ∀x.(x → boolean) → list<x> → list<x> = λp.λxs.hydra.core.lib.lists.foldr (λx.λacc.hydra.core.lib.logic.ifElse (p x) (hydra.core.lib.lists.cons x acc) acc) [] xs

## Find the first element matching a predicate.
##
## find(p, xs) returns Just(x) where x is the first element of xs for which p(x) is true, or Nothing if no such element exists.
## Total. Corresponds to Haskell's find :: (a -> Bool) -> [a] -> Maybe a.
##
## @availableSince 0.15
## @requirement returnsFirstMatch find returns the first element (wrapped) satisfying the predicate, scanning in list order.
## @requirement noneWhenNoMatchOrEmpty find returns none when no element satisfies the predicate, including when the list is empty.
primitive find : ∀x.(x → boolean) → list<x> → optional<x> = λp.λxs.hydra.core.lib.lists.foldr (λx.λacc.hydra.core.lib.logic.ifElse (p x) given(x) acc) none xs

## Left-fold a list in the list monad (a nondeterministic fold).
##
## foldList(f, acc0, xs) folds xs from the left, branching the accumulator over every result of the step function at each element: after each element the set of accumulators is replaced by all results of applying f to each current accumulator and that element.
## foldList(f, acc0, xs) is foldl(\macc el -> bind(macc, \acc -> f(acc, el)), singleton(acc0), xs); this defining equation is the specification. For the empty list the result is singleton(acc0).
## Total on finite inputs. The list-monad instance of the monadic left fold.
## For example, if f(acc, x) returns the two-element list containing acc and the sum of acc and x, then foldList(f, 0, xs) computes the sums of all subsets of xs.
##
## @availableSince 0.17.6
primitive foldList : ∀x,y.(x → y → list<x>) → x → list<y> → list<x> = λf.λacc0.λxs.hydra.core.lib.lists.foldl (λmacc.λel.hydra.core.lib.lists.bind macc (λacc.f acc el)) [acc0] xs

## Left-fold a list with an accumulator.
##
## foldl(f, acc0, xs) reduces xs left-associatively: foldl(f, acc0, [x1, x2, ..., xn]) = f(f(f(acc0, x1), x2), ..., xn). For the empty list the result is acc0.
## Strict in the accumulator on hosts where laziness would otherwise leak space.
## Total on finite inputs. Corresponds to Haskell's foldl' :: (b -> a -> b) -> b -> [a] -> b.
##
## @availableSince 0.15
## @requirement appliesLeftAssociatively foldl combines the accumulator with each element left-to-right using the given binary operation, so order-sensitive operations (e.g. subtraction) reflect strict left associativity.
## @requirement emptyListReturnsAccumulator foldl over an empty list returns the initial accumulator unchanged.
primitive foldl : ∀y,x.(y → x → y) → y → list<x> → y

## Right-fold a list with an accumulator.
##
## foldr(f, acc0, xs) reduces xs right-associatively: foldr(f, acc0, [x1, ..., xn]) = f(x1, f(x2, ..., f(xn, acc0))). For the empty list the result is acc0.
## Total on finite inputs. Corresponds to Haskell's foldr :: (a -> b -> b) -> b -> [a] -> b.
##
## @availableSince 0.15
## @requirement appliesRightAssociatively foldr combines each element with the accumulator right-to-left using the given binary operation, so order-sensitive operations (e.g. subtraction) reflect strict right associativity, and differ from the equivalent foldl where the operation is non-commutative.
## @requirement emptyListReturnsAccumulator foldr over an empty list returns the initial accumulator unchanged.
primitive foldr : ∀x,y.(x → y → y) → y → list<x> → y

## Group consecutive equal elements.
##
## group(xs) returns a list of lists obtained by grouping consecutive equal elements of xs together. Each inner list is non-empty and contains equal elements; the concatenation of the result equals xs.
## Equality is determined by the element type's 'equality' constraint.
## Total. Corresponds to Haskell's Data.List.group :: Eq a => [a] -> [[a]].
##
## @availableSince 0.15
## @requirement groupsConsecutiveDuplicates group partitions the list into maximal runs of consecutive equal elements, preserving overall order; non-adjacent duplicates (e.g. [1,1,2,2,2,3,1]) are not merged into the same run.
## @requirement emptyInput group of an empty list is the empty list.
primitive group : ∀x.(equality x) ⇒ list<x> → list<list<x>>

## Return the first element, or Nothing if the list is empty.
##
## head(xs) returns Just(x) where x is the first element of xs, or Nothing if xs is empty.
## Total. Wraps Haskell's partial head in maybe.
## Renamed from hydra.lib.lists.maybeHead.
##
## @availableSince 0.17.6
## @requirement returnsFirstElement head returns the first element of a non-empty list, wrapped, for any element type.
## @requirement noneWhenEmpty head of an empty list is none, for any element type.
primitive head : ∀x.list<x> → optional<x>

## Return all elements except the last, or Nothing if the list is empty.
##
## init(xs) returns Just(ys) where ys is xs with its last element removed, or Nothing if xs is empty.
## Total. Wraps Haskell's partial init in maybe.
## Renamed from hydra.lib.lists.maybeInit.
##
## @availableSince 0.17.6
## @requirement returnsAllButLast init returns all elements of a non-empty list except the last, wrapped, including the empty list when the input has exactly one element.
## @requirement noneWhenEmpty init of an empty list is none.
primitive init : ∀x.list<x> → optional<list<x>>

## Intersperse a value between consecutive elements of a list.
##
## intersperse(sep, xs) returns xs with sep inserted between each pair of adjacent elements; for lists of length 0 or 1 the input is returned unchanged.
## Total. Corresponds to Haskell's intersperse :: a -> [a] -> [a].
##
## @availableSince 0.15
## @requirement insertsElementBetweenItems intersperse inserts a copy of the given element between each pair of adjacent elements of the list (not before the first or after the last), for string and numeric element types.
## @requirement noInsertionBelowTwoElements intersperse on a list of zero or one elements returns the list unchanged -- there are no adjacent pairs to separate.
primitive intersperse : ∀x.x → list<x> → list<x>

## Test whether a list is empty.
##
## isEmpty(xs) returns true iff xs is the empty list.
## Total. Corresponds to Haskell's null :: [a] -> Bool.
##
## @availableSince 0.15
## @requirement testsZeroLength isEmpty returns true exactly when the list has no elements, for any element type.
primitive isEmpty : ∀x.list<x> → boolean

## Intercalate a list of lists with a separator list between each.
##
## join(sep, xss) returns the concatenation of xss with sep inserted between consecutive lists. Equivalent to concat(intersperse(sep, xss)).
## Total. Corresponds to Haskell's intercalate :: [a] -> [[a]] -> [a].
## Renamed from hydra.lib.lists.intercalate.
##
## @availableSince 0.17.6
## @requirement insertsSeparatorBetweenLists join concatenates a list of lists with a copy of the separator list inserted between each pair of adjacent lists (not before the first or after the last), for separators of any length including empty, and skips the separator insertion where it has no visible effect (a single list, or lists containing empty lists).
## @requirement emptyListOfLists join of an empty list of lists is the empty list, regardless of the separator.
primitive join : ∀x.list<x> → list<list<x>> → list<x>

## Return the last element, or Nothing if the list is empty.
##
## last(xs) returns Just(x) where x is the last element of xs, or Nothing if xs is empty.
## Total. Wraps Haskell's partial last in maybe.
## Renamed from hydra.lib.lists.maybeLast.
##
## @availableSince 0.17.6
## @requirement returnsLastElement last returns the final element of a non-empty list, wrapped, for any element type.
## @requirement noneWhenEmpty last of an empty list is none.
primitive last : ∀x.list<x> → optional<x>

## Return the length of a list.
##
## length(xs) returns the number of elements in xs as an int32. Returns 0 for the empty list.
## Total on finite inputs; the int32 result overflows for lists longer than 2^31-1 elements.
## Corresponds to Haskell's length :: [a] -> Int (with narrowing to Int32).
##
## @availableSince 0.15
## @requirement countsElements length returns the number of elements in the list, for any element type, including zero for the empty list.
primitive length : ∀x.list<x> → int32

## Map a function over a list.
##
## map(f, xs) returns the list of f(x) for each x in xs, in original order.
## Total. Corresponds to Haskell's map :: (a -> b) -> [a] -> [b] / fmap on lists.
##
## @availableSince 0.15
## @requirement appliesFunctionElementwise map applies the given function to each element of the list in place, preserving list order and length, for any element and function.
## @requirement identityAndEmptyCases map with the identity function returns the list unchanged; map over an empty list is the empty list.
primitive map : ∀x,y.(x → y) → list<x> → list<y>

## Map a partial function over a list, keeping only the present results.
##
## mapGivens(f, xs) applies f to each element of xs and returns the list of contained values from given results in original order; none results are discarded.
## Total. Corresponds to Haskell's Data.Maybe.mapMaybe :: (a -> Maybe b) -> [a] -> [b].
primitive mapGivens : ∀x,y.(x → optional<y>) → list<x> → list<y> = λf.λxs.hydra.core.lib.optionals.givens (hydra.core.lib.lists.map f xs)

## Traverse a list in the list monad.
##
## mapList(f, xs) returns all combinations obtainable by choosing one element from f(x) for each x in xs: each result list has the same length as xs, with its element at each position drawn from the corresponding f(x).
## Results appear in the lexicographic order of the choices, with the choice for the first element varying slowest. The number of results is the product of the lengths of the lists f(x); if f(x) is empty for any element, the result is the empty list; mapList(f, []) is singleton([]).
## Total on finite inputs. The list-monad instance of the traversal family.
##
## @availableSince 0.17.6
primitive mapList : ∀x,y.(x → list<y>) → list<x> → list<list<y>> = λf.λxs.hydra.core.lib.lists.foldr (λx.λacc.hydra.core.lib.lists.bind (f x) (λy.hydra.core.lib.lists.bind acc (λys.[hydra.core.lib.lists.cons y ys]))) [[]] xs

## Traverse an optional value in the list monad.
##
## mapOptional(f, m) returns the single-element list containing none when m is none; for given(x) it returns given(y) for each element y of f(x), in order.
## Total on finite inputs. The list-monad instance of the traversal family, applied to the optional container.
##
## @availableSince 0.17.6
primitive mapOptional : ∀x,y.(x → list<y>) → optional<x> → list<optional<y>> = λf.λm.hydra.core.lib.optionals.match m [none] (λx.hydra.core.lib.lists.bind (f x) (λy.[given(y)]))

## Traverse a set in the list monad.
##
## mapSet(f, s) returns all sets obtainable by choosing one element from f(x) for each element x of s. Elements of s are traversed in ascending order, and results appear in the lexicographic order of the choices, with the choice for the least element varying slowest.
## A result set may have fewer elements than s when distinct choices coincide. If f(x) is empty for any element, the result is the empty list; for the empty set the result is the single-element list containing the empty set.
## Requires 'ordering' constraints on both element types (the set type contract).
##
## @availableSince 0.17.6
primitive mapSet : ∀x,y.(ordering x, ordering y) ⇒ (x → list<y>) → set<x> → list<set<y>> = λf.λs.hydra.core.lib.lists.map (λys.hydra.core.lib.sets.fromList ys) (hydra.core.lib.lists.foldr (λx.λacc.hydra.core.lib.lists.bind (f x) (λy.hydra.core.lib.lists.bind acc (λys.[hydra.core.lib.lists.cons y ys]))) [[]] (hydra.core.lib.sets.toList s))

## Test whether an element is in a list.
##
## member(x, xs) returns true iff some element of xs is equal to x.
## Requires an 'equality' constraint on the element type.
## Total. Corresponds to Haskell's elem :: Eq a => a -> [a] -> Bool.
## Renamed from hydra.lib.lists.elem.
##
## @availableSince 0.17.6
## @requirement testsSetMembership member returns true exactly when the given value occurs at least once in the list, for both numeric and string elements, including lists with duplicates.
## @requirement falseWhenAbsentOrEmpty member returns false when the value does not occur in the list, including when the list is empty.
primitive member : ∀x.(equality x) ⇒ x → list<x> → boolean

## Partition a list into elements that satisfy a predicate and those that do not.
##
## partition(p, xs) returns a pair (yes, no) where yes is the list of elements of xs for which p is true and no is the list of elements for which p is false, each preserving original order.
## Total. Corresponds to Haskell's partition :: (a -> Bool) -> [a] -> ([a], [a]).
##
## @availableSince 0.15
## @requirement splitsBySatisfaction partition returns a pair of (elements satisfying the predicate, elements not satisfying it), each sublist preserving the original relative order of its members.
## @requirement boundaryCases partition degrades correctly at the boundaries: a predicate matching every element yields (whole list, empty); matching none yields (empty, whole list); an empty input list yields (empty, empty).
primitive partition : ∀x.(x → boolean) → list<x> → (list<x>, list<x>) = λp.λxs.hydra.core.lib.lists.foldr (λx.λacc.hydra.core.lib.logic.ifElse (p x) (hydra.core.lib.lists.cons x (hydra.core.lib.pairs.first acc), hydra.core.lib.pairs.second acc) (hydra.core.lib.pairs.first acc, hydra.core.lib.lists.cons x (hydra.core.lib.pairs.second acc))) ([], []) xs

## Build a list of n copies of a value.
##
## replicate(n, x) returns a list of n copies of x; for n <= 0 the result is the empty list.
## Total. Corresponds to Haskell's replicate :: Int -> a -> [a].
##
## @availableSince 0.15
## @requirement repeatsValueNTimes replicate n x returns a list containing n copies of x, including the empty list when n is zero, for numeric and string element types.
primitive replicate : ∀x.int32 → x → list<x>

## Reverse a list.
##
## reverse(xs) returns the elements of xs in reverse order.
## Total. Corresponds to Haskell's reverse :: [a] -> [a].
##
## @availableSince 0.15
## @requirement reversesElementOrder reverse returns the list with its elements in the opposite order, for any element type, including lists of zero or one elements (which are unaffected).
primitive reverse : ∀x.list<x> → list<x>

## Construct a single-element list.
##
## singleton(x) = [x].
## The constructor for a single-element list; useful point-free (e.g. map singleton xs).
## Total. Corresponds to Haskell's singleton :: a -> [a].
##
## @availableSince 0.15
## @requirement wrapsOneElement singleton x returns a one-element list containing exactly x, for any value including negative numbers, zero, and strings.
primitive singleton : ∀x.x → list<x>

## Sort a list.
##
## sort(xs) returns xs sorted in ascending order under the element type's ordering. Sort is stable: equal elements preserve their original relative order.
## Requires an 'ordering' constraint on the element type.
## Total. Corresponds to Haskell's Data.List.sort :: Ord a => [a] -> [a].
##
## @availableSince 0.15
## @requirement ordersAscending sort returns the list's elements in ascending order under the type's natural ordering, preserving multiplicity (duplicates are kept), and leaves already-sorted or single-element lists unchanged.
primitive sort : ∀x.(ordering x) ⇒ list<x> → list<x>

## Sort a list using a key-extraction function.
##
## sortBy(f, xs) returns xs sorted in ascending order by f(x) for each element x. Sort is stable: elements with equal keys preserve their original relative order.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.List.sortOn :: Ord b => (a -> b) -> [a] -> [a].
## Renamed from hydra.lib.lists.sortOn.
##
## @availableSince 0.17.6
## @requirement ordersByKeyFunction sortBy returns the list ordered ascending by the natural ordering of the given key function's output, not the elements' own ordering, so the result changes with the key function (e.g. sorting strings by length, or numbers by absolute value, differs from sorting by natural value).
## @requirement boundaryInputs sortBy on an empty or single-element list returns it unchanged, regardless of the key function.
primitive sortBy : ∀x,y.(ordering y) ⇒ (x → y) → list<x> → list<x>

## Split a list at the first element where the predicate fails.
##
## span(p, xs) returns a pair (ys, zs) where ys is the longest prefix of xs whose elements all satisfy p, and zs is the remainder of xs starting at the first element that fails p (or zs is empty if all elements satisfy p).
## Total. Corresponds to Haskell's span :: (a -> Bool) -> [a] -> ([a], [a]).
##
## @availableSince 0.15
## @requirement splitsAtFirstNonMatch span returns a pair of (longest prefix for which the predicate holds, the remaining suffix), degrading correctly when the predicate matches every element (whole list, empty), no elements (empty, whole list), or the input is empty (empty, empty).
primitive span : ∀x.(x → boolean) → list<x> → (list<x>, list<x>) = λp.λxs.hydra.core.lib.lists.foldl (λacc.λx.hydra.core.lib.logic.ifElse (hydra.core.lib.logic.and (hydra.core.lib.lists.isEmpty (hydra.core.lib.pairs.second acc)) (p x)) (hydra.core.lib.lists.concat2 (hydra.core.lib.pairs.first acc) [x], hydra.core.lib.pairs.second acc) (hydra.core.lib.pairs.first acc, hydra.core.lib.lists.concat2 (hydra.core.lib.pairs.second acc) [x])) ([], []) xs

## Return all elements except the first, or Nothing if the list is empty.
##
## tail(xs) returns Just(ys) where ys is xs with its first element removed, or Nothing if xs is empty.
## Total. Wraps Haskell's partial tail in maybe.
## Renamed from hydra.lib.lists.maybeTail.
##
## @availableSince 0.17.6
## @requirement returnsAllButFirst tail returns all elements of a non-empty list except the first, wrapped, including the empty list when the input has exactly one element.
## @requirement noneWhenEmpty tail of an empty list is none.
primitive tail : ∀x.list<x> → optional<list<x>>

## Take the first n elements of a list.
##
## take(n, xs) returns the prefix of xs of length min(n, length(xs)); if n is non-positive the result is the empty list.
## Total. Corresponds to Haskell's take :: Int -> [a] -> [a].
##
## @availableSince 0.15
## @requirement takesFromFront take n returns the first n elements of the list, or the whole list if n is greater than or equal to its length.
## @requirement nonPositiveIsEmpty take with n equal to zero or negative returns the empty list.
primitive take : ∀x.int32 → list<x> → list<x>

## Take elements from the beginning of a list while a predicate holds.
##
## takeWhile(p, xs) returns the longest prefix of xs whose elements all satisfy p. If p fails for the first element the result is the empty list; if p holds for every element the result is xs unchanged.
## dropWhile returns the complementary suffix, and span(p, xs) returns the pair of takeWhile(p, xs) and dropWhile(p, xs).
## Total. Corresponds to Haskell's takeWhile :: (a -> Bool) -> [a] -> [a].
##
## @availableSince 0.17.6
primitive takeWhile : ∀x.(x → boolean) → list<x> → list<x> = λp.λxs.hydra.core.lib.pairs.first (hydra.core.lib.lists.span p xs)

## Transpose a list of lists.
##
## transpose(xss) returns a list of lists where the i-th inner list contains the i-th element of every inner list of xss that has at least i+1 elements. Inner lists of differing lengths produce a ragged result rather than an error.
## Total. Corresponds to Haskell's Data.List.transpose :: [[a]] -> [[a]].
##
## @availableSince 0.15
## @requirement swapsRowsAndColumns transpose converts a list of rows into a list of columns, where column i holds the i-th element of every row that has one; rows need not be the same length (a ragged matrix is handled by omitting absent elements, not by padding or erroring), and an empty list of rows yields the empty list.
primitive transpose : ∀x.list<list<x>> → list<list<x>>

## Decompose a list into its head and tail, or Nothing if empty.
##
## uncons(xs) returns Just(head, tail) where head is the first element of xs and tail is the remaining list, or Nothing if xs is empty.
## Total. Corresponds to Haskell's Data.List.uncons :: [a] -> Maybe (a, [a]).
##
## @availableSince 0.15
## @requirement splitsHeadAndTail uncons on a non-empty list returns (wrapped) the pair of its first element and the remaining list, including when the remaining list is empty.
## @requirement noneWhenEmpty uncons of an empty list is none.
primitive uncons : ∀x.list<x> → optional<(x, list<x>)>

## Zip two lists element-wise into pairs.
##
## zip(xs, ys) returns the list of pairs (xs[i], ys[i]) for i from 0 to min(length(xs), length(ys))-1. The result has length equal to the shorter of the two inputs.
## Total. Corresponds to Haskell's zip :: [a] -> [b] -> [(a, b)].
##
## @availableSince 0.15
## @requirement pairsElementwise zip combines two lists into a list of pairs by position, truncating to the length of the shorter list when the lengths differ.
## @requirement emptyWhenEitherEmpty zip is the empty list whenever either input list is empty.
primitive zip : ∀x,y.list<x> → list<y> → list<(x, y)>

## Zip two lists with a combining function.
##
## zipWith(f, xs, ys) returns the list of f(xs[i], ys[i]) for i from 0 to min(length(xs), length(ys))-1. The result has length equal to the shorter of the two inputs.
## Total. Corresponds to Haskell's zipWith :: (a -> b -> c) -> [a] -> [b] -> [c].
##
## @availableSince 0.15
## @requirement combinesElementwiseByFunction zipWith combines two lists position-by-position using the given binary function, truncating to the length of the shorter list when the lengths differ, for numeric and string element/result types.
## @requirement emptyWhenEitherEmpty zipWith is the empty list whenever either input list is empty, regardless of the function.
primitive zipWith : ∀x,y,z.(x → y → z) → list<x> → list<y> → list<z>