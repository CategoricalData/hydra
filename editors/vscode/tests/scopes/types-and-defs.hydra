# SYNTAX TEST "source.hydra" "type constructors, module header, defs, cases, reserved-word escaping"

## A doc comment above the module header (§6.2).
## @availableSince 0.20
module hydra.test.types
#      ^^^^^^^^^^^^^^^^ entity.name.namespace.hydra

import hydra.core.model
#^^^^^ keyword.control.import.hydra
#      ^^^^^^^^^^^^^^^^ entity.name.namespace.hydra

import hydra.core.lists as lists from hydra-core
#                       ^^ keyword.control.import.hydra
#                                ^^^^ keyword.control.import.hydra

type MyList = ∀t.list<t>
#^^^ keyword.other.definition.hydra
#    ^^^^^^ entity.name.type.hydra
#             ^ keyword.control.forall.hydra
#              ^ variable.parameter.hydra
#                ^^^^ support.type.hydra

type Rec = record{x: int32}
#          ^^^^^^ support.type.hydra

type Wrapped = wrap(int32)
#              ^^^^ support.type.hydra

type U = union{a: unit, b: string}
#        ^^^^^ support.type.hydra

type Pair2 = ∀.map<string, int32>
#            ^ keyword.control.forall.hydra
#              ^^^ support.type.hydra
#                  ^^^^^^ support.type.hydra

# A USER type name inside type-arg brackets is a type reference (entity.name.type),
# not variable.other — determined by position (inside <...>), no uppercase heuristic.
type ListOfExpr = ∀.list<Expr>
#                        ^^^^ entity.name.type.hydra

type Pairing = ∀.map<Name, Term>
#                    ^^^^ entity.name.type.hydra
#                          ^^^^ entity.name.type.hydra

# Nested type-arg brackets and a qualified type name both scope as types.
type Nested = ∀.optional<list<hydra.core.model.Term>>
#                             ^^^^^^^^^^^^^^^^^^^^^ entity.name.type.hydra

# A function type inside type-arg brackets: arrow stays an arrow, names are types.
type EffFn = ∀x,y.effect<x → y>
#                        ^ entity.name.type.hydra
#                          ^ keyword.control.arrow.hydra
#                            ^ entity.name.type.hydra

impure partial primitive risky : ∀.unit → effect<unit>
#^^^^^ storage.modifier.impure.hydra
#      ^^^^^^^ storage.modifier.partial.hydra
#              ^^^^^^^^^ keyword.other.definition.hydra
#                        ^^^^^ entity.name.function.hydra

term constr = x ⇒ y
#               ^ keyword.control.constraint-arrow.hydra

term resv = `let`
#           ^ variable.other.escaped.hydra punctuation.definition.name.begin.hydra

term c = cases (Color) {red = 1:int32, _ = 0:int32}
#        ^^^^^ keyword.control.hydra

# Doc-comment directives, incl. @param/@return from the named-primitive-parameter
# signatures (#837, batch 30). Anchored to '## ' line-start so @-words in prose/strings
# do NOT get the directive scope.
## @param p: the first operand
#  ^^^^^^ keyword.other.documentation.directive.hydra
## @return the result
#  ^^^^^^^ keyword.other.documentation.directive.hydra
primitive demo (p: boolean, q: lazy boolean) : boolean
#^^^^^^^^ keyword.other.definition.hydra
#         ^^^^ entity.name.function.hydra
#                  ^^^^^^^ support.type.hydra
#                              ^^^^ keyword.control.hydra
