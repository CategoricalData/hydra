## Utilities for type unification.
module hydra.core.unification

import hydra.core.coders
import hydra.core.errors
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps
import hydra.core.lib.optionals
import hydra.core.lib.pairs
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.rewriting
import hydra.core.strip
import hydra.core.substitution
import hydra.core.typing

## Join two types, producing a list of type constraints.The comment is used to provide context for the constraints.
term joinTypes =
  λcx,`left`,`right`,comment.
    let sleft := deannotateType `left` in
    let sright := deannotateType `right` in
    let joinOne := λl,r.TypeConstraint{
          `left` = l,
          `right` = r,
          comment = strings.concat2 "join types; " comment} in
    let cannotUnify := left(UnificationError{
        leftType = sleft,
        rightType = sright,
        message = strings.concat2
            (strings.concat2
              (strings.concat2
                "cannot unify "
                (`type` sleft))
              " with ")
            (`type` sright)}) in
    let assertEqual := ifElse (equal sleft sright) right([]) cannotUnify in
    let joinList := λlefts,rights.ifElse
          (equal (lists.length lefts) (lists.length rights))
          right(lists.zipWith joinOne lefts rights)
          cannotUnify in
    let joinRowTypes := λ`left`,`right`.ifElse
          (and
            (equal
              (lists.length (lists.map FieldType[name] `left`))
              (lists.length (lists.map FieldType[name] `right`)))
            (lists.foldl
              (λacc,x.and acc x)
              true
              (lists.zipWith
                (λ`left`,`right`.equal (Name[] `left`) (Name[] `right`))
                (lists.map FieldType[name] `left`)
                (lists.map FieldType[name] `right`))))
          (joinList
            (lists.map FieldType[`type`] `left`)
            (lists.map FieldType[`type`] `right`))
          cannotUnify in
    cases(Type){
      application=λl.cases(Type){
            application=λr.right([
                  joinOne (ApplicationType[function] l) (ApplicationType[function] r),
                  joinOne (ApplicationType[argument] l) (ApplicationType[argument] r)]),
            `_`=cannotUnify}
            sright,
      `either`=λl.cases(Type){
            `either`=λr.right([joinOne (EitherType[`left`] l) (EitherType[`left`] r), joinOne (EitherType[`right`] l) (EitherType[`right`] r)]),
            `_`=cannotUnify}
            sright,
      `effect`=λl.cases(Type){`effect`=λr.right([joinOne l r]), `_`=cannotUnify}
            sright,
      function=λl.cases(Type){
            function=λr.right([
                  joinOne (FunctionType[domain] l) (FunctionType[domain] r),
                  joinOne (FunctionType[codomain] l) (FunctionType[codomain] r)]),
            `_`=cannotUnify}
            sright,
      `list`=λl.cases(Type){`list`=λr.right([joinOne l r]), `_`=cannotUnify}
            sright,
      literal=λ`_`.assertEqual,
      `map`=λl.cases(Type){
            `map`=λr.right([joinOne (MapType[keys] l) (MapType[keys] r), joinOne (MapType[values] l) (MapType[values] r)]),
            `_`=cannotUnify}
            sright,
      `optional`=λl.cases(Type){`optional`=λr.right([joinOne l r]), `_`=cannotUnify}
            sright,
      pair=λl.cases(Type){
            pair=λr.right([joinOne (PairType[first] l) (PairType[first] r), joinOne (PairType[second] l) (PairType[second] r)]),
            `_`=cannotUnify}
            sright,
      `record`=λl.cases(Type){`record`=λr.joinRowTypes l r, `_`=cannotUnify}
            sright,
      `set`=λl.cases(Type){`set`=λr.right([joinOne l r]), `_`=cannotUnify}
            sright,
      `union`=λl.cases(Type){`union`=λr.joinRowTypes l r, `_`=cannotUnify}
            sright,
      `unit`=λ`_`.cases(Type){`unit`=λ`_`.right([]), `_`=cannotUnify} sright,
      `void`=λ`_`.cases(Type){`void`=λ`_`.right([]), `_`=cannotUnify} sright,
      `wrap`=λl.cases(Type){`wrap`=λr.right([joinOne l r]), `_`=cannotUnify}
            sright,
      `_`=cannotUnify}
      sleft

## Robinson's algorithm, following https://www.cs.cornell.edu/courses/cs6110/2017sp/lectures/lec23.pdf
## Specifically this is an implementation of the following rules:
##   * Unify({(x, t)} ∪ E) = {t/x} Unify(E{t/x}) if x ∉ FV(t)
##   * Unify(∅) = I (the identity substitution x ↦ x)
##   * Unify({(x, x)} ∪ E) = Unify(E)
##   * Unify({(f(s1, ..., sn), f(t1, ..., tn))} ∪ E) = Unify({(s1, t1), ..., (sn, tn)} ∪ E))
term unifyTypeConstraints =
  λcx,schemaTypes,constraints.
    let withConstraint := λc,rest.
        let sleft := deannotateType (TypeConstraint[`left`] c) in
        let sright := deannotateType (TypeConstraint[`right`] c) in
        let comment := TypeConstraint[comment] c in
        let bind := λv,t.
            let subst := singletonTypeSubst v t in
            let withResult := λs.composeTypeSubst subst s in
            eithers.map
              withResult
              (unifyTypeConstraints
                cx
                schemaTypes
                (substituteInConstraints subst rest)) in
        let tryBinding := λv,t.ifElse
              (variableOccursInType v t)
              left(UnificationError{
                leftType = sleft,
                rightType = sright,
                message = strings.concat2
                    (strings.concat2
                      (strings.concat2
                        (strings.concat2
                          (strings.concat2
                            (strings.concat2 "Variable " (Name[] v))
                            " appears free in type ")
                          (`type` t))
                        " (")
                      comment)
                    ")"})
              (bind v t) in
        let isNominalSchemaType := λts.cases(Type){
              `record`=λ`_`.true,
              `union`=λ`_`.true,
              `wrap`=λ`_`.true,
              `_`=false}
              (deannotateType (TypeScheme[body] ts)) in
        let tryBindOrSchema := λv,t.match
              (lookup v schemaTypes)
              (tryBinding v t)
              (λts.ifElse
                  (isNominalSchemaType ts)
                  left(UnificationError{
                    leftType = sleft,
                    rightType = sright,
                    message = strings.concat2
                        (strings.concat2
                          (strings.concat2
                            (strings.concat2
                              (strings.concat2
                                (strings.concat2
                                  "Cannot unify schema name "
                                  (Name[] v))
                                " with type ")
                              (`type` t))
                            " (")
                          comment)
                        ")"})
                  (tryBinding v t)) in
        let noVars := let withConstraints := λconstraints2.unifyTypeConstraints
                cx
                schemaTypes
                (lists.concat2 constraints2 rest)
          in eithers.bind
            (joinTypes cx sleft sright comment)
            withConstraints in
        let dflt := cases(Type){
            variable=λname.tryBindOrSchema name sleft,
            `_`=noVars}
            sright in
        cases(Type){
          variable=λname.cases(Type){
                variable=λname2.ifElse
                      (equal (Name[] name) (Name[] name2))
                      (unifyTypeConstraints cx schemaTypes rest)
                      (ifElse
                        (isGiven (lookup name schemaTypes))
                        (ifElse
                          (isGiven (lookup name2 schemaTypes))
                          left(UnificationError{
                            leftType = sleft,
                            rightType = sright,
                            message = strings.concat2
                                (strings.concat2
                                  (strings.concat2
                                    (strings.concat2
                                      (strings.concat2
                                        (strings.concat2
                                          "Attempted to unify schema names "
                                          (Name[] name))
                                        " and ")
                                      (Name[] name2))
                                    " (")
                                  comment)
                                ")"})
                          (bind name2 sleft))
                        (bind name sright)),
                `_`=tryBindOrSchema name sright}
                sright,
          `_`=dflt}
          sleft
    in match
      (lists.uncons constraints)
      right(idTypeSubst)
      (λuc.withConstraint (first uc) (second uc))

## Unify two lists of types pairwise, producing a single substitution that satisfies every pair. The lists must have the same length; the comment is attached to each generated constraint for diagnostics.
term unifyTypeLists =
  λcx,schemaTypes,l,r,comment.
    let toConstraint := λl,r.TypeConstraint{`left` = l, `right` = r, comment = comment}
    in unifyTypeConstraints cx schemaTypes (lists.zipWith toConstraint l r)

## Unify two types, producing a substitution that makes them equal (or an error). The comment is attached to the generated constraint for diagnostics.
term unifyTypes =
  λcx,schemaTypes,l,r,comment.unifyTypeConstraints
      cx
      schemaTypes
      [TypeConstraint{`left` = l, `right` = r, comment = comment}]

## Determine whether a type variable appears within a type expression.No distinction is made between free and bound type variables.
term variableOccursInType =
  λvar,typ0.
    let tryType := λb,typ.cases(Type){variable=λv.or b (equal (Name[] v) (Name[] var)), `_`=b} typ
    in foldOverType TraversalOrder{pre} tryType false typ0