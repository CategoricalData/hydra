>
>## Robinson's algorithm, following https://www.cs.cornell.edu/courses/cs6110/2017sp/lectures/lec23.pdf
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>## Specifically this is an implementation of the following rules:
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>##   * Unify({(x, t)} ∪ E) = {t/x} Unify(E{t/x}) if x ∉ FV(t)
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>##   * Unify(∅) = I (the identity substitution x ↦ x)
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>##   * Unify({(x, x)} ∪ E) = Unify(E)
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>##   * Unify({(f(s1, ..., sn), f(t1, ..., tn))} ∪ E) = Unify({(s1, t1), ..., (sn, tn)} ∪ E))
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term unifyTypeConstraints = λcx,schemaTypes,constraints.let withConstraint := λc,rest.let sleft := strip.deannotateType (typing.TypeConstraint[`left`] c) in let sright := strip.deannotateType (typing.TypeConstraint[`right`] c) in let comment := typing.TypeConstraint[comment] c in let bind := λv,t.let subst := substitution.singletonTypeSubst v t in let withResult := λs.substitution.composeTypeSubst subst s in eithers.map withResult (unifyTypeConstraints cx schemaTypes (substitution.substituteInConstraints subst rest)) in let tryBinding := λv,t.logic.ifElse (variableOccursInType v t) left(errors.UnificationError{leftType = sleft, rightType = sright, message = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "Variable " (model.Name[] v)) " appears free in type ") (print.model.type t)) " (") comment) ")"}) (bind v t) in let isNominalSchemaType := λts.cases(model.Type){`record`=λ`_`.true, `union`=λ`_`.true, `wrap`=λ`_`.true, `_`=false} (strip.deannotateType (model.TypeScheme[body] ts)) in let tryBindOrSchema := λv,t.optionals.match (maps.lookup v schemaTypes) (tryBinding v t) (λts.logic.ifElse (isNominalSchemaType ts) left(errors.UnificationError{leftType = sleft, rightType = sright, message = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "Cannot unify schema name " (model.Name[] v)) " with type ") (print.model.type t)) " (") comment) ")"}) (tryBinding v t)) in let noVars := let withConstraints := λconstraints2.unifyTypeConstraints cx schemaTypes (lists.concat2 constraints2 rest) in eithers.bind (joinTypes cx sleft sright comment) withConstraints in let dflt := cases(model.Type){variable=λname.tryBindOrSchema name sleft, `_`=noVars} sright in cases(model.Type){variable=λname.cases(model.Type){variable=λname2.logic.ifElse (equality.equal (model.Name[] name) (model.Name[] name2)) (unifyTypeConstraints cx schemaTypes rest) (logic.ifElse (optionals.isGiven (maps.lookup name schemaTypes)) (logic.ifElse (optionals.isGiven (maps.lookup name2 schemaTypes)) left(errors.UnificationError{leftType = sleft, rightType = sright, message = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "Attempted to unify schema names " (model.Name[] name)) " and ") (model.Name[] name2)) " (") comment) ")"}) (bind name2 sleft)) (bind name sright)), `_`=tryBindOrSchema name sright} sright, `_`=dflt} sleft in optionals.match (lists.uncons constraints) right(substitution.idTypeSubst) (λuc.withConstraint (pairs.first uc) (pairs.second uc))
