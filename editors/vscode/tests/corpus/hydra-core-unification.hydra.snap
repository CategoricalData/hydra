>## Join two types, producing a list of type constraints.The comment is used to provide context for the constraints.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term joinTypes = λcx,`left`,`right`,comment.let sleft := strip.deannotateType `left` in let sright := strip.deannotateType `right` in let joinOne := λl,r.typing.TypeConstraint{`left` = l, `right` = r, comment = strings.concat2 "join types; " comment} in let cannotUnify := left(errors.UnificationError{leftType = sleft, rightType = sright, message = strings.concat2 (strings.concat2 (strings.concat2 "cannot unify " (print.model.type sleft)) " with ") (print.model.type sright)}) in let assertEqual := logic.ifElse (equality.equal sleft sright) right([]) cannotUnify in let joinList := λlefts,rights.logic.ifElse (equality.equal (lists.length lefts) (lists.length rights)) right(lists.zipWith joinOne lefts rights) cannotUnify in let joinRowTypes := λ`left`,`right`.logic.ifElse (logic.and (equality.equal (lists.length (lists.map model.FieldType[name] `left`)) (lists.length (lists.map model.FieldType[name] `right`))) (lists.foldl (λacc,x.logic.and acc x) true (lists.zipWith (λ`left`,`right`.equality.equal (model.Name[] `left`) (model.Name[] `right`)) (lists.map model.FieldType[name] `left`) (lists.map model.FieldType[name] `right`)))) (joinList (lists.map model.FieldType[`type`] `left`) (lists.map model.FieldType[`type`] `right`)) cannotUnify in cases(model.Type){application=λl.cases(model.Type){application=λr.right([joinOne (model.ApplicationType[function] l) (model.ApplicationType[function] r), joinOne (model.ApplicationType[argument] l) (model.ApplicationType[argument] r)]), `_`=cannotUnify} sright, `either`=λl.cases(model.Type){`either`=λr.right([joinOne (model.EitherType[`left`] l) (model.EitherType[`left`] r), joinOne (model.EitherType[`right`] l) (model.EitherType[`right`] r)]), `_`=cannotUnify} sright, `effect`=λl.cases(model.Type){`effect`=λr.right([joinOne l r]), `_`=cannotUnify} sright, function=λl.cases(model.Type){function=λr.right([joinOne (model.FunctionType[domain] l) (model.FunctionType[domain] r), joinOne (model.FunctionType[codomain] l) (model.FunctionType[codomain] r)]), `_`=cannotUnify} sright, `list`=λl.cases(model.Type){`list`=λr.right([joinOne l r]), `_`=cannotUnify} sright, literal=λ`_`.assertEqual, `map`=λl.cases(model.Type){`map`=λr.right([joinOne (model.MapType[keys] l) (model.MapType[keys] r), joinOne (model.MapType[values] l) (model.MapType[values] r)]), `_`=cannotUnify} sright, `optional`=λl.cases(model.Type){`optional`=λr.right([joinOne l r]), `_`=cannotUnify} sright, pair=λl.cases(model.Type){pair=λr.right([joinOne (model.PairType[first] l) (model.PairType[first] r), joinOne (model.PairType[second] l) (model.PairType[second] r)]), `_`=cannotUnify} sright, `record`=λl.cases(model.Type){`record`=λr.joinRowTypes l r, `_`=cannotUnify} sright, `set`=λl.cases(model.Type){`set`=λr.right([joinOne l r]), `_`=cannotUnify} sright, `union`=λl.cases(model.Type){`union`=λr.joinRowTypes l r, `_`=cannotUnify} sright, `unit`=λ`_`.cases(model.Type){`unit`=λ`_`.right([]), `_`=cannotUnify} sright, `void`=λ`_`.cases(model.Type){`void`=λ`_`.right([]), `_`=cannotUnify} sright, `wrap`=λl.cases(model.Type){`wrap`=λr.right([joinOne l r]), `_`=cannotUnify} sright, `_`=cannotUnify} sleft
