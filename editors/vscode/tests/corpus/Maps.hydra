## Primitives in the hydra.core.lib.maps module.
##
## Ordered maps: finite collections of key-value bindings, with at most one value per key.
## Hydra maps are ordered collections: iteration -- elems, keys, toList -- is in ascending key order, under the total order defined in the ordering-and-equality specification.
## Because key ordering is part of the map type's contract, every map-typed variable in this module's signatures carries the ordering constraint on its key type, including in primitives that perform no comparison themselves.
module hydra.core.lib.maps

import hydra.core.paths
import hydra.core.ast
import hydra.core.coders
import hydra.core.model
import hydra.core.diff
import hydra.core.docs
import hydra.core.error.checking
import hydra.core.error.model
import hydra.core.error.file
import hydra.core.error.packaging
import hydra.core.error.system
import hydra.core.errors
import hydra.core.file
import hydra.core.graph
import hydra.core.json.model
import hydra.core.markdown
import hydra.core.packaging
import hydra.core.parsing
import hydra.core.query
import hydra.core.regex
import hydra.core.relational
import hydra.core.system
import hydra.core.tabular
import hydra.core.testing
import hydra.core.time
import hydra.core.topology
import hydra.core.typed
import hydra.core.typing
import hydra.core.util
import hydra.core.validation
import hydra.core.variants

## Alter a value at a key using a function which sees the optional current value.
##
## alter(f, k, m) applies f to Just(v) when m contains key k with value v, or to Nothing when k is absent. If f returns Just(v'), the binding (k, v') is set in the result; if f returns Nothing, k is removed from the result.
## A single primitive that subsumes insert, delete, and adjust.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.alter :: Ord k => (Maybe v -> Maybe v) -> k -> Map k v -> Map k v.
##
## @availableSince 0.15
## @requirement insertsUpdatesOrDeletes alter applies the given function to the optional current value at the key: if the function returns given(v'), that binding is set (inserting if absent, overwriting if present); if it returns none, the key is removed.
primitive alter : ∀v,k.(ordering k) ⇒ (optional<v> → optional<v>) → k → map<k, v> → map<k, v> = λf.λk.λm.hydra.core.lib.optionals.match (f (hydra.core.lib.maps.lookup k m)) (hydra.core.lib.maps.delete k m) (λvNew.hydra.core.lib.maps.insert k vNew m)

## Map functions over both the keys and values of a map.
##
## bimap(fk, fv, m) returns a new map with key fk(k) and value fv(v) for each binding (k, v) in m.
## Key collisions after applying fk are resolved by keeping the last binding encountered (host may differ on collision policy if fk is not injective).
## Requires 'ordering' constraints on both the input and output key types.
## Total. Corresponds to a key-and-value lift of Haskell's Data.Map.fromList . map (\(k,v) -> (fk k, fv v)) . toList.
##
## @availableSince 0.15
## @requirement transformsKeysAndValues bimap returns a new map where each binding (k, v) becomes (fk(k), fv(v)), applying the key function and value function independently to every binding.
## @requirement emptyInput bimap of the empty map is the empty map, regardless of the key and value functions.
primitive bimap : ∀k1,k2,v1,v2.(ordering k1, ordering k2) ⇒ (k1 → k2) → (v1 → v2) → map<k1, v1> → map<k2, v2> = λfk.λfv.λm.hydra.core.lib.maps.fromList (hydra.core.lib.lists.map (λp.(fk (hydra.core.lib.pairs.first p), fv (hydra.core.lib.pairs.second p))) (hydra.core.lib.maps.toList m))

## Remove a key from a map.
##
## delete(k, m) returns m with the binding for k removed; if k is not present, m is returned unchanged.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.delete :: Ord k => k -> Map k v -> Map k v.
##
## @availableSince 0.15
## @requirement removesKeyIfPresent delete removes the binding for the given key if present, leaving the rest of the map unchanged.
## @requirement noOpWhenAbsentOrEmpty delete leaves the map unchanged when the key is absent, including when the map is empty.
primitive delete : ∀k,v.(ordering k) ⇒ k → map<k, v> → map<k, v>

## Compute the difference of two maps by key.
##
## difference(m1, m2) returns the map containing exactly the bindings of m1 whose keys do not appear in m2. Only the key set of m2 matters; its values are ignored.
## The key-set analogue is hydra.core.lib.sets.difference.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.difference :: Ord k => Map k v -> Map k v -> Map k v.
##
## @availableSince 0.17.6
## @requirement removesBindingsWithKeysInSecondMap difference returns the bindings of the first map whose keys do not occur in the second map.
## @requirement identityWhenSecondEmpty difference with an empty second map returns the first map unchanged.
primitive difference : ∀k,v.(ordering k) ⇒ map<k, v> → map<k, v> → map<k, v>

## Return the values of a map (in key order).
##
## elems(m) returns the values of m as a list, ordered by their keys' ascending order.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.elems :: Map k v -> [v].
##
## @availableSince 0.15
## @requirement returnsValuesInKeyOrder elems returns the map's values as a list ordered by ascending key, including when keys were inserted out of order.
## @requirement emptyInput elems of the empty map is the empty list.
primitive elems : ∀k,v.(ordering k) ⇒ map<k, v> → list<v>

## The empty map.
##
## empty is the map with no bindings.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.empty :: Map k v.
##
## @availableSince 0.15
## @requirement hasNoBindings empty is the map containing no bindings.
primitive empty : ∀k,v.(ordering k) ⇒ map<k, v>

## Filter a map by value.
##
## filter(p, m) returns the submap of m containing exactly the bindings (k, v) for which p(v) is true.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.filter :: (v -> Bool) -> Map k v -> Map k v.
##
## @availableSince 0.15
## @requirement keepsMatchingValues filter returns the submap containing exactly the bindings whose value satisfies the predicate, preserving all matching keys.
## @requirement boundaryCases filter degrades correctly at the boundaries: a predicate matching no value yields the empty map; filtering the empty map yields the empty map.
primitive filter : ∀v,k.(ordering k) ⇒ (v → boolean) → map<k, v> → map<k, v> = λp.λm.hydra.core.lib.maps.fromList (hydra.core.lib.lists.filter (λpr.p (hydra.core.lib.pairs.second pr)) (hydra.core.lib.maps.toList m))

## Filter a map by key and value.
##
## filterWithKey(p, m) returns the submap of m containing exactly the bindings (k, v) for which p(k, v) is true.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.filterWithKey :: (k -> v -> Bool) -> Map k v -> Map k v.
##
## @availableSince 0.15
## @requirement keepsMatchingBindings filterWithKey returns the submap containing exactly the bindings for which the predicate, given both key and value, is true.
## @requirement boundaryCases filterWithKey degrades correctly at the boundaries: a predicate matching no binding yields the empty map; filtering the empty map yields the empty map.
primitive filterWithKey : ∀k,v.(ordering k) ⇒ (k → v → boolean) → map<k, v> → map<k, v> = λp.λm.hydra.core.lib.maps.fromList (hydra.core.lib.lists.filter (λpr.p (hydra.core.lib.pairs.first pr) (hydra.core.lib.pairs.second pr)) (hydra.core.lib.maps.toList m))

## Look up a value with a default if the key is absent.
##
## findWithDefault(def, k, m) returns the value bound to k in m if k is present, or def otherwise. Equivalent to maybe(def, identity, lookup(k, m)).
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.findWithDefault :: Ord k => v -> k -> Map k v -> v.
##
## @availableSince 0.15
## @requirement returnsBoundValueOrDefault findWithDefault returns the value bound to the key when present, or the supplied default value when the key is absent.
primitive findWithDefault : ∀v,k.(ordering k) ⇒ lazy v → k → map<k, v> → v = λdef.λk.λm.hydra.core.lib.optionals.withDefault def (hydra.core.lib.maps.lookup k m)

## Build a map from a list of key-value pairs.
##
## fromList(xs) returns the map containing exactly the bindings in xs. If xs contains multiple entries for the same key, the last one wins (matching Haskell's fromList behavior).
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.fromList :: Ord k => [(k, v)] -> Map k v.
##
## @availableSince 0.15
## @requirement buildsMapFromPairs fromList returns the map containing exactly the bindings in the input list of key-value pairs.
## @requirement lastDuplicateWins fromList resolves multiple entries for the same key by keeping the value from the last occurrence in the input list.
## @requirement emptyInput fromList of the empty list of pairs is the empty map.
primitive fromList : ∀k,v.(ordering k) ⇒ list<(k, v)> → map<k, v>

## Insert a key-value pair into a map.
##
## insert(k, v, m) returns m with the binding (k, v) added or updated. If k is already present, its value is overwritten.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.insert :: Ord k => k -> v -> Map k v -> Map k v.
##
## @availableSince 0.15
## @requirement addsOrOverwritesBinding insert adds the given key-value binding to the map, overwriting any existing value at that key, including when the map was empty.
primitive insert : ∀k,v.(ordering k) ⇒ k → v → map<k, v> → map<k, v>

## Compute the intersection of two maps by key.
##
## intersection(m1, m2) returns the map containing exactly the bindings of m1 whose keys also appear in m2. On each common key the value is taken from m1; only the key set of m2 matters, and its values are ignored.
## The key-set analogue is hydra.core.lib.sets.intersection.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.intersection :: Ord k => Map k v -> Map k v -> Map k v.
##
## @availableSince 0.17.6
## @requirement keepsBindingsWithKeysInBoth intersection returns the bindings of the first map whose keys also occur in the second map, taking the value from the first map on each common key.
## @requirement emptyWhenNoOverlapOrEitherEmpty intersection is the empty map when the two maps share no keys, or when either map is empty.
primitive intersection : ∀k,v.(ordering k) ⇒ map<k, v> → map<k, v> → map<k, v>

## Test whether a map is empty.
##
## isEmpty(m) returns true iff m has no bindings.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.null :: Map k v -> Bool.
##
## @availableSince 0.15
## @requirement testsZeroBindings isEmpty returns true exactly when the map has no bindings.
primitive isEmpty : ∀k,v.(ordering k) ⇒ map<k, v> → boolean

## Return the keys of a map (in key order).
##
## keys(m) returns the keys of m as a list, in ascending order.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.keys :: Map k v -> [k].
##
## @availableSince 0.15
## @requirement returnsKeysInOrder keys returns the map's keys as a list in ascending order, including when keys were inserted out of order.
## @requirement emptyInput keys of the empty map is the empty list.
primitive keys : ∀k,v.(ordering k) ⇒ map<k, v> → list<k>

## Look up a value in a map by key, returning Nothing if absent.
##
## lookup(k, m) returns Just(v) where v is the value bound to k in m, or Nothing if k is not present.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.lookup :: Ord k => k -> Map k v -> Maybe v.
##
## @availableSince 0.15
## @requirement returnsBoundValue lookup returns the value bound to the given key, wrapped, when the key is present.
## @requirement noneWhenAbsentOrEmpty lookup returns none when the key is absent, including when the map is empty.
primitive lookup : ∀k,v.(ordering k) ⇒ k → map<k, v> → optional<v>

## Map a function over the values of a map.
##
## map(f, m) returns a map with the same keys as m and value f(v) for each binding (k, v).
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.map :: (v -> w) -> Map k v -> Map k w / fmap on Map.
##
## @availableSince 0.15
## @requirement appliesFunctionToValues map applies the given function to every value in the map, leaving keys unchanged.
## @requirement emptyInput map over the empty map is the empty map, regardless of the function.
primitive map : ∀v1,v2,k.(ordering k) ⇒ (v1 → v2) → map<k, v1> → map<k, v2> = λf.λm.hydra.core.lib.maps.fromList (hydra.core.lib.lists.map (λp.(hydra.core.lib.pairs.first p, f (hydra.core.lib.pairs.second p))) (hydra.core.lib.maps.toList m))

## Map a function over the keys of a map.
##
## mapKeys(f, m) returns a map where each binding (k, v) becomes (f(k), v). If f maps multiple keys to the same image, key collisions are resolved by keeping the binding with the greater original key (matching Haskell's mapKeys behavior).
## Requires 'ordering' constraints on both the input and output key types.
## Total. Corresponds to Haskell's Data.Map.mapKeys :: (Ord k1, Ord k2) => (k1 -> k2) -> Map k1 v -> Map k2 v.
##
## @availableSince 0.15
## @requirement appliesFunctionToKeys mapKeys applies the given function to every key in the map, leaving the bound values unchanged.
## @requirement emptyInput mapKeys over the empty map is the empty map, regardless of the function.
primitive mapKeys : ∀k1,k2,v.(ordering k1, ordering k2) ⇒ (k1 → k2) → map<k1, v> → map<k2, v> = λf.λm.hydra.core.lib.maps.fromList (hydra.core.lib.lists.map (λp.(f (hydra.core.lib.pairs.first p), hydra.core.lib.pairs.second p)) (hydra.core.lib.maps.toList m))

## Test whether a key is present in a map.
##
## member(k, m) returns true iff k is a key in m.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.member :: Ord k => k -> Map k v -> Bool.
##
## @availableSince 0.15
## @requirement testsKeyPresence member returns true exactly when the given key is present in the map.
## @requirement falseWhenAbsentOrEmpty member returns false when the key is absent, including when the map is empty.
primitive member : ∀k,v.(ordering k) ⇒ k → map<k, v> → boolean

## Construct a map with a single key-value pair.
##
## singleton(k, v) returns the map containing exactly the binding (k, v).
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.singleton :: k -> v -> Map k v.
##
## @availableSince 0.15
## @requirement wrapsOneBinding singleton returns the map containing exactly the one given key-value binding.
primitive singleton : ∀k,v.(ordering k) ⇒ k → v → map<k, v>

## Return the number of key-value pairs in a map.
##
## size(m) returns the number of bindings in m as an int32.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.size :: Map k v -> Int (with narrowing to int32).
##
## @availableSince 0.15
## @requirement countsBindings size returns the number of bindings in the map, including zero for the empty map.
primitive size : ∀k,v.(ordering k) ⇒ map<k, v> → int32

## Convert a map to a list of key-value pairs (in key order).
##
## toList(m) returns the bindings of m as a list of (key, value) pairs, in ascending key order.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.toList :: Map k v -> [(k, v)].
##
## @availableSince 0.15
## @requirement returnsPairsInKeyOrder toList returns the map's bindings as a list of key-value pairs ordered by ascending key, including when keys were inserted out of order.
## @requirement emptyInput toList of the empty map is the empty list.
primitive toList : ∀k,v.(ordering k) ⇒ map<k, v> → list<(k, v)>

## Compute the union of two maps; the first map's bindings take precedence on key collision.
##
## union(m1, m2) returns the map containing all bindings from m1 plus the bindings of m2 whose keys are not in m1. On key collision, the binding from m1 is preferred.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.union :: Ord k => Map k v -> Map k v -> Map k v.
##
## @availableSince 0.15
## @requirement firstMapTakesPrecedence union returns the map containing all bindings from the first map plus the bindings of the second map whose keys are not in the first; on key collision the first map's binding is kept.
## @requirement identityWithEmpty union with either map empty returns the other map unchanged.
primitive union : ∀k,v.(ordering k) ⇒ map<k, v> → map<k, v> → map<k, v>

## Compute the left-biased union of a list of maps.
##
## unions(ms) returns the map containing every binding of every map in ms; when a key occurs in more than one map, the binding from the earliest such map in the list wins.
## unions(ms) is equivalent to folding union over ms from the left, starting from empty; unions([]) is empty, and the bias matches union and hydra.core.lib.sets.unions.
## Requires an 'ordering' constraint on the key type.
## Total. Corresponds to Haskell's Data.Map.unions :: Ord k => [Map k v] -> Map k v.
##
## @availableSince 0.17.6
## @requirement earliestMapTakesPrecedence unions returns the bindings of every map in the list; when a key occurs in more than one map, the binding from the earliest such map in the list is kept.
## @requirement emptyListOfMapsYieldsEmptyMap unions of an empty list of maps is the empty map.
primitive unions : ∀k,v.(ordering k) ⇒ list<map<k, v>> → map<k, v>