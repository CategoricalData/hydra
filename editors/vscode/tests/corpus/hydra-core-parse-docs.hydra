## Parser for Hydra documentation strings, producing DocSegment lists. A bespoke helper parser, not a parse<T> convention function (see docs/specification/index.md, Conventions).
module hydra.core.parse.docs

import hydra.core.docs
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.optionals
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.packaging

## Parse the content between the doc-escape delimiters into an EntityReference. The input is the inner content (tag and optional rhs), e.g. "type hydra.core.model.Lambda". Returns nothing for unrecognized tags.
term parseDocAnnotation =
  λinner.
    let parts := strings.splitOn " " inner, tag := withDefault "" (lists.head parts), rhs := strings.join " " (lists.drop 1:int32 parts)
    in ifElse
      (equal tag "primitive")
      given(EntityReference{definition = DefinitionReference{`primitive` = wrap(Name){rhs}}})
      (ifElse
        (equal tag "term")
        given(EntityReference{definition = DefinitionReference{`term` = wrap(Name){rhs}}})
        (ifElse
          (equal tag "type")
          given(EntityReference{definition = DefinitionReference{`type` = wrap(Name){rhs}}})
          (ifElse
            (equal tag "module")
            given(EntityReference{`module` = wrap(ModuleName){rhs}})
            (ifElse
              (equal tag "package")
              given(EntityReference{package = wrap(PackageName){rhs}})
              (ifElse
                (equal tag "term-expr")
                given(EntityReference{termExpr = rhs})
                (ifElse (equal tag "type-expr") given(EntityReference{typeExpr = rhs}) none))))))

## Parse a documentation string into a list of {@type hydra.core.docs.DocSegment}s. Recognized doc-escape tags become DocSegment.ref segments (wrapping a {@type hydra.core.packaging.EntityReference}); all other text (including unrecognized doc-escape blocks) becomes DocSegment.text segments. Adjacent text fragments are not merged.
term parseDocString =
  λs.
    let parts := strings.splitOn "{@" s, `head_` := withDefault "" (lists.head parts), `tail_` := lists.drop 1:int32 parts, toSeg := λpart.
        let subparts := strings.splitOn "}" part, inner := withDefault "" (lists.head subparts), after := strings.join "}" (lists.drop 1:int32 subparts), mref := parseDocAnnotation inner
        in match
          mref
          [DocSegment{text = strings.concat2 "{@" part}]
          (λref.givens
              [given(DocSegment{ref = ref}), ifElse (equal after "") none given(DocSegment{text = after})])
    in lists.cons DocSegment{text = `head_`} (lists.concat (lists.map toSeg `tail_`))