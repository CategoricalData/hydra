## Parser for Hydra documentation strings, producing DocSegment lists. A bespoke helper parser, not a parse<T> convention function (see docs/specification/index.md, Conventions).
module hydra.core.parse.docs

import hydra.core.docs as docs
import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic as logic
import hydra.core.lib.optionals as optionals
import hydra.core.lib.strings as strings
import hydra.core.model as model
import hydra.core.packaging as packaging

term parseDocAnnotation = (λinner.let parts := strings.splitOn " " inner, tag := optionals.withDefault "" (lists.head parts), rhs := strings.join " " (lists.drop 1:int32 parts) in logic.ifElse (equality.equal tag "primitive") given(packaging.EntityReference{definition = packaging.DefinitionReference{`primitive` = wrap(model.Name){rhs}}}) (logic.ifElse (equality.equal tag "term") given(packaging.EntityReference{definition = packaging.DefinitionReference{`term` = wrap(model.Name){rhs}}}) (logic.ifElse (equality.equal tag "type") given(packaging.EntityReference{definition = packaging.DefinitionReference{`type` = wrap(model.Name){rhs}}}) (logic.ifElse (equality.equal tag "module") given(packaging.EntityReference{`module` = wrap(packaging.ModuleName){rhs}}) (logic.ifElse (equality.equal tag "package") given(packaging.EntityReference{package = wrap(packaging.PackageName){rhs}}) (logic.ifElse (equality.equal tag "term-expr") given(packaging.EntityReference{termExpr = rhs}) (logic.ifElse (equality.equal tag "type-expr") given(packaging.EntityReference{typeExpr = rhs}) none)))))))@{description="Parse the content between the doc-escape delimiters into an EntityReference. The input is the inner content (tag and optional rhs), e.g. \"type hydra.core.model.Lambda\". Returns nothing for unrecognized tags."}

term parseDocString = (λs.let parts := strings.splitOn "{@" s, `head_` := optionals.withDefault "" (lists.head parts), `tail_` := lists.drop 1:int32 parts, toSeg := λpart.let subparts := strings.splitOn "}" part, inner := optionals.withDefault "" (lists.head subparts), after := strings.join "}" (lists.drop 1:int32 subparts), mref := parseDocAnnotation inner in optionals.match mref [docs.DocSegment{text = strings.concat2 "{@" part}] (λref.optionals.givens [given(docs.DocSegment{ref = ref}), logic.ifElse (equality.equal after "") none given(docs.DocSegment{text = after})]) in lists.cons docs.DocSegment{text = `head_`} (lists.concat (lists.map toSeg `tail_`)))@{description="Parse a documentation string into a list of {@type hydra.core.docs.DocSegment}s. Recognized doc-escape tags become DocSegment.ref segments (wrapping a {@type hydra.core.packaging.EntityReference}); all other text (including unrecognized doc-escape blocks) becomes DocSegment.text segments. Adjacent text fragments are not merged."}