## Per-dialect printer rendering the hydra.core.regex AST into GNU Emacs regexp syntax. Emacs inverts several escaping conventions relative to POSIX ERE (probe-verified, Emacs 28.2): alternation is \| (bare | is literal), grouping is \( \) (bare ( ) are literal), and bounded quantifiers are \{n,m\} (bare braces are literal). The quantifiers * + ? are bare as usual. Hydra's . (any incl. newline) renders as [^z-a] — an empty negated range that matches every character including newline (Emacs . excludes newline). Three further divergences, each probe-verified (issue #603): (1) anchors ^ and $ (whole-STRING boundaries in Hydra) render as the GNU whole-buffer anchors \` and \', because Emacs's native ^ and $ are line-oriented; (2) character-class metacharacters ] ^ - are disambiguated POSITIONALLY (] first, - last, ^ never first) rather than by backslash-escaping, because Emacs bracket expressions are POSIX-like and have no escape mechanism inside [...] (a backslash there is an ordinary character); (3) alternation branches are ordered by descending rendered length, because Emacs's alternation is leftmost-FIRST, unlike Hydra's leftmost-LONGEST semantics. See docs/specification/regex.md and issue #567/#603.
module hydra.core.print.emacs.regex

import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.pairs
import hydra.core.lib.strings as strings
import hydra.core.regex

## Render an alternation, joining its branches with Emacs's \| operator. Branches are ordered by descending rendered length so that Emacs's leftmost-first matching agrees with Hydra's leftmost-longest semantics for fixed-length alternatives.
term alternation =
  λalt.
    let rendered := lists.map regexSequence alt, byLength := lists.sortBy strings.length rendered
    in strings.join "\\|" (lists.reverse byLength)

## The Emacs rendering of Hydra's . (any character incl. newline): the empty-negated-range [^z-a].
term anyClass = "[^z-a]"

## Render a single atom; . -> [^z-a], and groups use Emacs's \( \) escaping.
term atom =
  λa.cases(Atom){
      literal=λc.escapeLiteral c,
      any=λ`_`.anyClass,
      anchorStart=λ`_`."\\`",
      anchorEnd=λ`_`."\\'",
      group=λg.strings.concat ["\\(", alternation g, "\\)"],
      class=λcc.characterClass cc}
      a

## Render a character class, including the leading ^ for a negated class. Reorders items positionally for Emacs (which has no bracket-expression escaping): a literal ] is moved to the front (immediately after the optional negating ^), a literal - is moved to the back, and (only when there is no literal ] item to occupy the first slot) a literal ^ is moved after the first non-^ item -- Emacs treats a leading ^ as the negation marker regardless of Hydra's negated flag. The one residual gap: a class whose only member is a literal ^ has no safe position on Emacs; this is an extreme corner case (single-item classes are otherwise unremarkable) and is left unhandled here.
term characterClass =
  λcc.
    let items := CharacterClass[items] cc, bracketAndRest := lists.partition (classItemIsLiteral 93:int32) items, bracketItems := first bracketAndRest, afterBracket := second bracketAndRest, dashAndRest := lists.partition (classItemIsLiteral 45:int32) afterBracket, dashItems := first dashAndRest, rest := second dashAndRest, caretAndNonCaret := lists.partition (classItemIsLiteral 94:int32) rest, caretItems := first caretAndNonCaret, nonCaretItems := second caretAndNonCaret, safeRest := ifElse
        (or (not (lists.isEmpty bracketItems)) (lists.isEmpty nonCaretItems))
        rest
        (lists.concat2 nonCaretItems caretItems), ordered := lists.concat [bracketItems, safeRest, dashItems]
    in strings.concat ["[", ifElse (CharacterClass[negated] cc) "^" "", strings.concat (lists.map classItem ordered), "]"]

## Render one character-class member (a single character or an inclusive range). Emacs bracket expressions do NOT support backslash escaping (probe-verified: \- and \] inside [...] are two literal characters, not an escape); the metacharacters ] ^ - are instead disambiguated positionally by characterClass (] first, - last, ^ never first), so a plain character or range here never needs an escape.
term classItem =
  λitem.cases(ClassItem){
      character=λc.printCodePoint c,
      range=λr.strings.concat
            [printCodePoint (CharacterRange[`from`] r), "-", printCodePoint (CharacterRange[to] r)]}
      item

## True if a ClassItem is the single literal character code point c (not a range).
term classItemIsLiteral = λc,item.cases(ClassItem){character=λic.equal ic c, `_`=false} item

## Render a literal code point in top-level context under Emacs regexp, escaping only the characters that are special bare in Emacs: . * + ? [ ] ^ $ \. Note | ( ) { } are literal in Emacs and are NOT escaped here.
term escapeLiteral =
  λc.
    let isMeta := lists.foldl
        (λacc,m.or acc (equal c m))
        false
        [46:int32, 42:int32, 43:int32, 63:int32, 91:int32, 93:int32, 94:int32, 36:int32, 92:int32]
    in ifElse isMeta (strings.concat2 "\\" (printCodePoint c)) (printCodePoint c)

## Render a single Unicode code point as a one-character string.
term printCodePoint = λc.strings.fromList [c]

## Render a hydra.core.regex AST into GNU Emacs regexp syntax (escaped \| \( \) \{..\}, . as [^z-a]).
term printRegex = λr.alternation r

## Render an atom followed by its quantifier suffix.
term quantified = λqa.strings.concat2 (atom (Quantified[atom] qa)) (quantifier (Quantified[quantifier] qa))

## Render a quantifier suffix; bounded {..} forms use Emacs's escaped braces \{..\}.
term quantifier =
  λq.cases(Quantifier){
      one=λ`_`."",
      zeroOrOne=λ`_`."?",
      zeroOrMore=λ`_`."*",
      oneOrMore=λ`_`."+",
      exactly=λn.strings.concat ["\\{", printInt32 n, "\\}"],
      atLeast=λn.strings.concat ["\\{", printInt32 n, ",\\}"],
      range=λr.strings.concat
            ["\\{", printInt32 (QuantifierRange[min] r), ",", printInt32 (QuantifierRange[max] r), "\\}"]}
      q

## Render a sequence of quantified atoms by concatenation.
term regexSequence = λs.strings.concat (lists.map quantified s)