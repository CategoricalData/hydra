>## Decode a list of type-encoding bindings into a map of named types
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term graphToSchema = λcx,graph,els.let toPair := λel.let name := model.Binding[name] el in eithers.bind (decode.model.type graph (model.Binding[`term`] el)) (λt.right((name, t))) in eithers.bind (eithers.mapList toPair els) (λpairs.right(maps.fromList pairs))
