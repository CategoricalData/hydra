>## Given a graph schema and a nonrecursive type, instantiate it with default values. If the minimal flag is set, the smallest possible term is produced; otherwise, exactly one subterm is produced for constructors which do not otherwise require one, e.g. in lists and optionals. The name parameter provides the element name for nominal type construction.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term instantiateTemplate = λcx,minimal,schema,tname,t.let inst := λtn.instantiateTemplate cx minimal schema tn in let noPoly := left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = "non-polymorphic type", actual = "polymorphic or function type"}}}) in let forFloat := λft.cases(model.FloatType){`float32`=λ`_`.model.FloatValue{`float32` = 0.0:float32}, `float64`=λ`_`.model.FloatValue{`float64` = 0.0:float64}} ft in let forInteger := λit.cases(model.IntegerType){`bigint`=λ`_`.model.IntegerValue{`bigint` = 0:bigint}, `int8`=λ`_`.model.IntegerValue{`int8` = 0:int8}, `int16`=λ`_`.model.IntegerValue{`int16` = 0:int16}, `int32`=λ`_`.model.IntegerValue{`int32` = 0:int32}, `int64`=λ`_`.model.IntegerValue{`int64` = 0:int64}, `uint8`=λ`_`.model.IntegerValue{`uint8` = 0:uint8}, `uint16`=λ`_`.model.IntegerValue{`uint16` = 0:uint16}, `uint32`=λ`_`.model.IntegerValue{`uint32` = 0:uint32}, `uint64`=λ`_`.model.IntegerValue{`uint64` = 0:uint64}} it in let forLiteral := λlt.cases(model.LiteralType){`binary`=λ`_`.model.Literal{`string` = ""}, `boolean`=λ`_`.model.Literal{`boolean` = false}, `decimal`=λ`_`.model.Literal{`decimal` = 0}, integer=λit.model.Literal{integer = forInteger it}, float=λft.model.Literal{float = forFloat ft}, `string`=λ`_`.model.Literal{`string` = ""}} lt in cases(model.Type){annotated=λat.inst tname (model.AnnotatedType[body] at), application=λ`_`.noPoly, function=λ`_`.noPoly, `forall`=λ`_`.noPoly, `list`=λet.logic.ifElse minimal right(model.Term{`list` = []}) (eithers.bind (inst tname et) (λe.right(model.Term{`list` = [e]}))), literal=λlt.right(model.Term{literal = forLiteral lt}), `map`=λmt.let kt := model.MapType[keys] mt in let vt := model.MapType[values] mt in logic.ifElse minimal right(model.Term{`map` = maps.empty}) (eithers.bind (inst tname kt) (λke.eithers.bind (inst tname vt) (λve.right(model.Term{`map` = maps.singleton ke ve})))), `optional`=λot.logic.ifElse minimal right(model.Term{`optional` = none}) (eithers.bind (inst tname ot) (λe.right(model.Term{`optional` = given(e)}))), `record`=λrt.let toField := λft.eithers.bind (inst tname (model.FieldType[`type`] ft)) (λe.right(model.Field{name = model.FieldType[name] ft, `term` = e})) in eithers.bind (eithers.mapList toField rt) (λdfields.right(model.Term{`record` = model.Record{typeName = tname, fields = dfields}})), `set`=λet.logic.ifElse minimal right(model.Term{`set` = sets.empty}) (eithers.bind (inst tname et) (λe.right(model.Term{`set` = sets.fromList [e]}))), variable=λvname.optionals.match (maps.lookup vname schema) left(errors.Error{resolution = errors.ResolutionError{unexpectedShape = errors.UnexpectedShapeError{expected = "bound type variable", actual = strings.concat2 "unbound variable " (model.Name[] vname)}}}) (inst vname), `wrap`=λwt.eithers.bind (inst tname wt) (λe.right(model.Term{`wrap` = model.WrappedTerm{typeName = tname, body = e}}))} t
