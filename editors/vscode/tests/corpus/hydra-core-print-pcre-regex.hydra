## Per-dialect printer rendering the hydra.core.regex AST into the PCRE / java.util.regex / ECMA family syntax (Java, Scala, Clojure, Python, Common Lisp, TypeScript). Differs from the canonical hydra.core.print.regex in exactly one place: Hydra's . (any character INCLUDING newline) renders as [\s\S] rather than a bare . (whose native meaning excludes newline in these engines). All other productions match the canonical form. See docs/specification/regex.md and issue #567.
module hydra.core.print.pcre.regex

import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals as literals
import hydra.core.lib.logic as logic
import hydra.core.lib.strings as strings
import hydra.core.regex as regex

term alternation = (λalt.let rendered := lists.map regexSequence alt, byLength := lists.sortBy strings.length rendered in strings.join "|" (lists.reverse byLength))@{description="Render an alternation, joining its branches with the | operator. Branches are ordered by descending rendered length so that PCRE/ECMA's leftmost-first matching agrees with Hydra's leftmost-longest semantics for fixed-length alternatives."}

term atom = (λa.cases(regex.Atom){literal=λc.escapeLiteral c, any=λ`_`."[\\s\\S]", anchorStart=λ`_`."^", anchorEnd=λ`_`."$", group=λg.strings.concat ["(", alternation g, ")"], class=λcc.characterClass cc} a)@{description="Render a single atom; the . metacharacter renders as [\\s\\S] to preserve newline-inclusive 'any'."}

term characterClass = (λcc.strings.concat ["[", logic.ifElse (regex.CharacterClass[negated] cc) "^" "", strings.concat (lists.map classItem (regex.CharacterClass[items] cc)), "]"])@{description="Render a character class, including the leading ^ for a negated class."}

term classItem = (λitem.cases(regex.ClassItem){character=λc.escapeClassChar c, range=λr.strings.concat [escapeClassChar (regex.CharacterRange[`from`] r), "-", escapeClassChar (regex.CharacterRange[to] r)]} item)@{description="Render one character-class member (a single character or an inclusive range)."}

term escapeClassChar = (λc.let isMeta := lists.foldl (λacc.λm.logic.or acc (equality.equal c m)) false [92:int32, 93:int32, 94:int32, 45:int32] in logic.ifElse isMeta (strings.concat2 "\\" (printCodePoint c)) (printCodePoint c))@{description="Render a code point inside a character class, uniformly escaping the class metacharacters \\ ] ^ -."}

term escapeLiteral = (λc.let isMeta := lists.foldl (λacc.λm.logic.or acc (equality.equal c m)) false [46:int32, 94:int32, 36:int32, 42:int32, 43:int32, 63:int32, 40:int32, 41:int32, 91:int32, 93:int32, 123:int32, 125:int32, 124:int32, 92:int32] in logic.ifElse isMeta (strings.concat2 "\\" (printCodePoint c)) (printCodePoint c))@{description="Render a literal code point in top-level context, backslash-escaping PCRE/ECMA metacharacters."}

term printCodePoint = (λc.strings.fromList [c])@{description="Render a single Unicode code point as a one-character string."}

term printRegex = (λr.alternation r)@{description="Render a hydra.core.regex AST into PCRE / java.util.regex / ECMA syntax. Identical to the canonical printer except that . (any incl. newline) becomes [\\s\\S]."}

term quantified = (λqa.strings.concat2 (atom (regex.Quantified[atom] qa)) (quantifier (regex.Quantified[quantifier] qa)))@{description="Render an atom followed by its quantifier suffix."}

term quantifier = (λq.cases(regex.Quantifier){one=λ`_`."", zeroOrOne=λ`_`."?", zeroOrMore=λ`_`."*", oneOrMore=λ`_`."+", exactly=λn.strings.concat ["{", literals.printInt32 n, "}"], atLeast=λn.strings.concat ["{", literals.printInt32 n, ",}"], range=λr.strings.concat ["{", literals.printInt32 (regex.QuantifierRange[min] r), ",", literals.printInt32 (regex.QuantifierRange[max] r), "}"]} q)@{description="Render a quantifier suffix; the 'one' quantifier renders as the empty string."}

term regexSequence = (λs.strings.concat (lists.map quantified s))@{description="Render a sequence of quantified atoms by concatenation."}