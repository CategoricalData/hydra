>
>## Extract a field value from a list of fields
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term field = λfname,mapping,graph,fields.let matchingFields := lists.filter (λf.equality.equal (model.Name[] (model.Field[name] f)) (model.Name[] fname)) fields in let noMatchErr := left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 "field " (model.Name[] fname), actual = "no matching field"}}}) in logic.ifElse (lists.isEmpty matchingFields) noMatchErr (logic.ifElse (equality.equal (lists.length matchingFields) 1:int32) (optionals.match (lists.head matchingFields) noMatchErr (λmf.eithers.bind (lexical.stripAndDereferenceTerm graph (model.Field[`term`] mf)) (λstripped.mapping stripped))) left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = "single field", actual = strings.concat2 "multiple fields named " (model.Name[] fname)}}}))
