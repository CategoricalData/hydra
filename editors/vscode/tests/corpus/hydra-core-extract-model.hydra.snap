>## Extract case statement from a term
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term cases = λname,graph,term0.eithers.bind (lexical.stripAndDereferenceTerm graph term0) (λ`term`.cases(model.Term){`cases`=λcs.logic.ifElse (equality.equal (model.Name[] (model.CaseStatement[typeName] cs)) (model.Name[] name)) right(cs) left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 "case statement for type " (model.Name[] name), actual = print.model.term `term`}}}), `_`=left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = "case statement", actual = print.model.term `term`}}})} `term`)
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^ source.hydra entity.name.function.hydra
#          ^ source.hydra
#           ^ source.hydra keyword.operator.equals.hydra
#            ^ source.hydra
#             ^ source.hydra keyword.operator.lambda.hydra
#              ^^^^ source.hydra variable.parameter.hydra
#                  ^ source.hydra punctuation.separator.binder.hydra
#                   ^^^^^ source.hydra variable.parameter.hydra
#                        ^ source.hydra punctuation.separator.binder.hydra
#                         ^^^^^ source.hydra variable.parameter.hydra
#                              ^ source.hydra punctuation.separator.binder.hydra
#                               ^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                           ^^ source.hydra
#                                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                            ^ source.hydra
#                                                                             ^^^^^ source.hydra variable.other.hydra
