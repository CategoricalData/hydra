>
>## Extract a map of key-value pairs from a term, mapping functions over each key and value
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term map = λfk,fv,graph,term0.let pair := λkvPair.let kterm := pairs.first kvPair in let vterm := pairs.second kvPair in eithers.bind (fk kterm) (λkval.eithers.bind (fv vterm) (λvval.right((kval, vval)))) in eithers.bind (lexical.stripAndDereferenceTerm graph term0) (λ`term`.cases(model.Term){`map`=λm.eithers.map maps.fromList (eithers.mapList pair (maps.toList m)), `_`=left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = "map", actual = print.model.term `term`}}})} `term`)
