>term injection = λexpected,graph,term0.eithers.bind (lexical.stripAndDereferenceTerm graph term0) (λ`term`.cases(model.Term){`inject`=λinjection.logic.ifElse (equality.equal (model.Name[] (model.Injection[typeName] injection)) (model.Name[] expected)) right(model.Injection[field] injection) left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 "injection of type " (model.Name[] expected), actual = model.Name[] (model.Injection[typeName] injection)}}}), `_`=left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = "injection", actual = print.model.term `term`}}})} `term`)
