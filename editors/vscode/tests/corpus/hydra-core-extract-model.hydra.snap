>
>## Extract the base type from an optional type
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term optionalType = λtyp.let stripped := strip.deannotateType typ in cases(model.Type){`optional`=λt.right(t), `_`=left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = "optional type", actual = print.model.type typ}}})} stripped
