>## Ensure a function has the expected number of arguments
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term nArgs = λname,n,args.logic.ifElse (equality.equal (lists.length args) n) right(unit) left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat [literals.printInt32 n, " arguments to primitive ", literals.printString (model.Name[] name)], actual = literals.printInt32 (lists.length args)}}})
