>## Decode a Map using the provided key and value decoders
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term decodeMap = λkeyDecoder,valDecoder,g,`term`.eithers.bind (stripWithDecodingError g `term`) (λstripped.cases(model.Term){`map`=λm.eithers.map maps.fromList (eithers.mapList (λkv.eithers.bind (keyDecoder g (pairs.first kv)) (λk.eithers.map (λv.(k, v)) (valDecoder g (pairs.second kv)))) (maps.toList m)), `_`=left(errors.DecodingError{"expected map"})} stripped)
