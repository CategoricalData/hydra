>## Extract an integer literal from a Literal value
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term integerLiteral = λlit.cases(model.Literal){integer=λv.right(v), `_`=left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = "integer value", actual = print.model.literal lit}}})} lit
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                   ^ source.hydra
#                    ^ source.hydra keyword.operator.equals.hydra
#                     ^ source.hydra
