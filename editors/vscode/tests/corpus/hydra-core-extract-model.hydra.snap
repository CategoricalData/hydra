>
>## Extract a binding with the given name from a let term
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term letBinding = λn,graph,`term`.let name := wrap(model.Name){n} in eithers.bind (`let` graph `term`) (λletExpr.let matchingBindings := lists.filter (λb.equality.equal (model.Name[] (model.Binding[name] b)) (model.Name[] name)) (model.Let[bindings] letExpr) in let noBindingErr := left(errors.Error{extraction = errors.ExtractionError{noSuchBinding = errors.NoSuchBindingError{name = name}}}) in logic.ifElse (lists.isEmpty matchingBindings) noBindingErr (logic.ifElse (equality.equal (lists.length matchingBindings) 1:int32) (optionals.match (lists.head matchingBindings) noBindingErr (λb.right(model.Binding[`term`] b))) left(errors.Error{extraction = errors.ExtractionError{multipleBindings = errors.MultipleBindingsError{name = name}}})))
