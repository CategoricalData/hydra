>
>## Extract the wrapped value from a wrapped term
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term wrap = λexpected,graph,term0.eithers.bind (lexical.stripAndDereferenceTerm graph term0) (λ`term`.cases(model.Term){`wrap`=λwrappedTerm.logic.ifElse (equality.equal (model.Name[] (model.WrappedTerm[typeName] wrappedTerm)) (model.Name[] expected)) right(model.WrappedTerm[body] wrappedTerm) left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 "wrapper of type " (model.Name[] expected), actual = model.Name[] (model.WrappedTerm[typeName] wrappedTerm)}}}), `_`=left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 (strings.concat2 "wrap(" (model.Name[] expected)) ")", actual = print.model.term `term`}}})} `term`)
