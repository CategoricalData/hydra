>
>## Extract a record's fields from a term
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term record = λexpected,graph,term0.eithers.bind (termRecord graph term0) (λ`record`.logic.ifElse (equality.equal (model.Record[typeName] `record`) expected) right(model.Record[fields] `record`) left(errors.Error{extraction = errors.ExtractionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 "record of type " (model.Name[] expected), actual = model.Name[] (model.Record[typeName] `record`)}}}))
