#^^ source.hydra comment.block.documentation.hydra
#  ^ source.hydra comment.block.documentation.hydra
#   ^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra keyword.other.documentation.directive.hydra
#                  ^^^^^^^ source.hydra comment.block.documentation.hydra
>primitive mapOptional : ∀x,y.(x → list<y>) → optional<x> → list<optional<y>> = λf.λm.hydra.core.lib.optionals.match m [none] (λx.hydra.core.lib.lists.bind (f x) (λy.[given(y)]))
