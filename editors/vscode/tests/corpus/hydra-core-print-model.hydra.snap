>term printNameAliased = (λaliases.λn.let s := model.Name[] n in let segs := strings.splitOn "." s in let segCount := lists.length segs in logic.ifElse (ordering.lt segCount 2:int32) (printName n) (let dropCount := math.sub segCount 1:int32 in let localName := strings.join "." (lists.drop dropCount segs) in let modStr := strings.join "." (lists.take dropCount segs) in let modName := wrap(packaging.ModuleName){modStr} in optionals.match (maps.lookup modName aliases) (printName n) (λalias.logic.ifElse (strings.isEmpty alias) (printName wrap(model.Name){localName}) (printName model.Name{strings.concat [alias, ".", localName]}))))@{description="Show a nominal name, shortened via the given import-alias map when its module is aliased (#803)."}
