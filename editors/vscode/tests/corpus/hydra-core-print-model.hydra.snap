>term sugarFields = (λaliases.λflds.let fieldStrs := lists.map (sugarField aliases) flds in strings.concat ["{", strings.join ", " fieldStrs, "}"])@{description="Show fields as nominal-construction sugar, abbreviating unit-valued fields bareword (#809)"}
