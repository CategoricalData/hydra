>term bindingAliased = (λaliases.λel.let name := printName (model.Binding[name] el) in let t := model.Binding[`term`] el in let typeStr := optionals.match (model.Binding[typeScheme] el) "" (λts.strings.concat [":(", typeSchemeAliased aliases ts, ")"]) in strings.concat [name, typeStr, " := ", termAliased aliases t])@{description="Show a binding as a string, shortening nominal references via the given import-alias map (#803)"}
