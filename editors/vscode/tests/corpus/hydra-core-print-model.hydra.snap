>term typeAtPrec = (λaliases.λctx.λtyp.let showRowType := λflds.let fieldExprs := lists.map (fieldTypeExpr aliases) flds in serialization.printExpr (serialization.curlyBracesList none serialization.halfBlockStyle fieldExprs) in let gatherTypes := λprev.λapp.let lhs := model.ApplicationType[function] app in let rhs := model.ApplicationType[argument] app in cases(model.Type){application=λapp2.gatherTypes (lists.cons rhs prev) app2, `_`=lists.cons lhs (lists.cons rhs prev)} lhs in let gatherFunctionTypes := λprev.λt.cases(model.Type){function=λft.let dom := model.FunctionType[domain] ft in let cod := model.FunctionType[codomain] ft in gatherFunctionTypes (lists.cons dom prev) cod, `_`=lists.reverse (lists.cons t prev)} t in cases(model.Type){annotated=λat.let bodyStr := typeAtPrec aliases 3:int32 (model.AnnotatedType[body] at) in let annStr := termAtPrec aliases 3:int32 (model.AnnotatedType[annotation] at) in logic.ifElse (ordering.lt 3:int32 ctx) (strings.concat ["(", strings.concat [bodyStr, "@", annStr], ")"]) (strings.concat [bodyStr, "@", annStr]), application=λapp.let types := gatherTypes [] app in let typeStrs := lists.map (λe.typeAtPrec aliases 3:int32 e) types in logic.ifElse (ordering.lt 2:int32 ctx) (strings.concat ["(", strings.join " " typeStrs, ")"]) (strings.join " " typeStrs), `effect`=λetyp.strings.concat ["effect<", typeAliased aliases etyp, ">"], `either`=λet.let leftTyp := model.EitherType[`left`] et in let rightTyp := model.EitherType[`right`] et in strings.concat ["either<", typeAliased aliases leftTyp, ", ", typeAliased aliases rightTyp, ">"], `forall`=λft.let v := printBinderName (model.ForallType[parameter] ft) in let body := model.ForallType[body] ft in logic.ifElse (ordering.lt 0:int32 ctx) (strings.concat ["(", strings.concat ["forall ", v, ". ", typeAliased aliases body], ")"]) (strings.concat ["forall ", v, ". ", typeAliased aliases body]), function=λft.let types := gatherFunctionTypes [] typ in let typeStrs := lists.map (λe.typeAtPrec aliases 2:int32 e) types in logic.ifElse (ordering.lt 1:int32 ctx) (strings.concat ["(", strings.join " → " typeStrs, ")"]) (strings.join " → " typeStrs), `list`=λetyp.strings.concat ["list<", typeAliased aliases etyp, ">"], literal=λlt.literalType lt, `map`=λmt.let keyTyp := model.MapType[keys] mt in let valTyp := model.MapType[values] mt in strings.concat ["map<", typeAliased aliases keyTyp, ", ", typeAliased aliases valTyp, ">"], `optional`=λetyp.strings.concat ["optional<", typeAliased aliases etyp, ">"], pair=λpt.let firstTyp := model.PairType[first] pt in let secondTyp := model.PairType[second] pt in strings.concat ["(", typeAliased aliases firstTyp, ", ", typeAliased aliases secondTyp, ")"], `record`=λrt.strings.concat2 "record" (showRowType rt), `set`=λetyp.strings.concat ["set<", typeAliased aliases etyp, ">"], `union`=λrt.strings.concat2 "union" (showRowType rt), `unit`=λ`_`."unit", variable=λname.printNameAliased aliases name, `void`=λ`_`."void", `wrap`=λwt.strings.concat ["wrap(", typeAliased aliases wt, ")"]} typ)@{description="Show a type as a string at a given minimum context precedence, adding minimal parentheses"}
