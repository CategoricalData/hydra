>term isBareSegment = (λseg.logic.and (logic.not (strings.isEmpty seg)) (lists.foldl (λacc.λc.logic.and acc (chars.isAlphaNum c)) true (strings.toList seg)))@{description="True iff a name segment is a nonempty sequence of alphanumeric characters (the bare alphabet)."}
