>term typeAliased = (λaliases.λtyp.typeAtPrec aliases 0:int32 typ)@{description="Show a type as a string, shortening nominal references via the given import-alias map (#803)"}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                ^ source.hydra
#                 ^ source.hydra keyword.operator.equals.hydra
