>term toHex2 = (λc.let hi := optionals.withDefault 0:int32 (math.div c 16:int32) in let lo := optionals.withDefault 0:int32 (math.mod c 16:int32) in strings.concat [hexDigit hi, hexDigit lo])@{description="Render a small code point as a two-digit lowercase hex string."}
