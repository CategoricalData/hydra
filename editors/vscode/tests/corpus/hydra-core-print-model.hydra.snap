>term printName = (λn.let s := model.Name[] n in logic.ifElse (logic.and (isBareName s) (logic.not (isReservedWord s))) s (printBacktickedName s))@{description="Show a name as a string, backtick-escaping iff it is not bare or is a reserved word (#2.4)."}
