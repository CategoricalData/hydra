>term map = (λshowK.λshowV.λm.let pairStrs := lists.map (λp.strings.concat [showK (pairs.first p), "=", showV (pairs.second p)]) (lists.sortBy pairs.first (maps.toList m)) in strings.concat ["{", strings.join ", " pairStrs, "}"])@{description="Show a map using given functions to show keys and values, in canonical (ascending key) order"}
