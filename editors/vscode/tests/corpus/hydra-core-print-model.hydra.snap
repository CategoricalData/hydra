>term injection = (λaliases.λinj.let tname := model.Injection[typeName] inj in let f := model.Injection[field] inj in strings.concat [printNameAliased aliases tname, sugarFields aliases [f]])@{description="Show an injection as a string, shortening the type name via the given import-alias map (#803)"}
