>term isBareName = (λs.let segs := strings.splitOn "." s in logic.and (logic.not (lists.isEmpty segs)) (lists.foldl (λacc.λseg.logic.and acc (isBareSegment seg)) true segs))@{description="True iff a name is a nonempty sequence of dot-separated segments of alphanumeric characters."}
