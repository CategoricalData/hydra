>term fieldTypeExpr = (λaliases.λft.let ftyp := model.FieldType[`type`] ft in let peeled := peelDescriptionAnnotation ftyp in let mdesc := pairs.first peeled in let fname := printName (model.FieldType[name] ft) in let declLine := strings.concat [fname, ": ", typeAliased aliases (pairs.second peeled)] in serialization.cst (optionals.match mdesc declLine (λd.strings.concat ["## ", d, "\n", declLine])))@{description="Show a field type as a block-layout expression, with its description (if any) as a preceding '##' comment line"}
