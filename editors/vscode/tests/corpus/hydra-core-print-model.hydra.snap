>term either = (λshowA.λshowB.λe.eithers.either (λa.strings.concat2 "left(" (strings.concat2 (showA a) ")")) (λb.strings.concat2 "right(" (strings.concat2 (showB b) ")")) e)@{description="Show an Either value using given functions for left and right"}
