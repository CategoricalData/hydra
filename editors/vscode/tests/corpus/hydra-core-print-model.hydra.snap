>
>term termSignature = (termSignatureAliased maps.empty)@{description="Show a term signature as a string, preserving each parameter's lazy marking"}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                  ^ source.hydra
#                   ^ source.hydra keyword.operator.equals.hydra
#                    ^^ source.hydra
#                      ^^^^^^^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                          ^ source.hydra
#                                           ^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                     ^ source.hydra
#                                                      ^ source.hydra keyword.operator.annotation.hydra
#                                                       ^ source.hydra
#                                                        ^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                   ^ source.hydra keyword.operator.equals.hydra
#                                                                    ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra string.quoted.double.hydra
#                                                                                                                                                ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                                                                                 ^^ source.hydra
>
>term termSignatureAliased = (λaliases.λsig.let typeParams := typing.TermSignature[typeParameters] sig in let params := typing.TermSignature[parameters] sig in let result := typing.TermSignature[result] sig in let varNames := lists.map (λtp.printBinderName (typing.TypeParameter[name] tp)) typeParams in let constraintClassName := λc.cases(model.TypeClassConstraint){simple=λn.model.Name[] n} c in let toConstraintPairsForParam := λtp.let v := typing.TypeParameter[name] tp in lists.map (λc.strings.concat [constraintClassName c, " ", model.Name[] v]) (lists.sortBy constraintClassName (typing.TypeParameter[constraints] tp)) in let tc := lists.concat (lists.map toConstraintPairsForParam typeParams) in let paramStr := λp.let tyStr := typeAtPrec aliases 2:int32 (typing.Parameter[`type`] p) in logic.ifElse (typing.Parameter[isLazy] p) (strings.concat2 "lazy " tyStr) tyStr in let paramStrs := lists.map paramStr params in let resultStr := typeAtPrec aliases 2:int32 (typing.Result[`type`] result) in let bodyStr := strings.join " → " (lists.concat2 paramStrs [resultStr]) in logic.ifElse (lists.isEmpty varNames) bodyStr (strings.concat ["∀", strings.join "," varNames, ".", logic.ifElse (lists.isEmpty tc) "" (strings.concat ["(", strings.join ", " tc, ") ⇒ "]), bodyStr]))@{description="Show a term signature as a string (preserving lazy markings), shortening nominal references via the given alias map (#803)"}
