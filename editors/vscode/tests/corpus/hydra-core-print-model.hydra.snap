>term printBinderName = (λn.let s := model.Name[] n in logic.ifElse (logic.and (isBareSegment s) (logic.not (isReservedWord s))) s (printBacktickedName s))@{description="Show a binder-head name as a string; a dot forces backtick-escaping here (#2.4 case 3)."}
