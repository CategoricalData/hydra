>term escapeBacktickChar = (λc.let isChar := λcode.equality.equal c code in logic.ifElse (isChar 96:int32) "\\`" (logic.ifElse (isChar 92:int32) "\\\\" (logic.ifElse (isChar 8:int32) "\\b" (logic.ifElse (isChar 12:int32) "\\f" (logic.ifElse (isChar 10:int32) "\\n" (logic.ifElse (isChar 13:int32) "\\r" (logic.ifElse (isChar 9:int32) "\\t" (logic.ifElse (ordering.lt c 32:int32) (strings.concat ["\\u00", toHex2 c]) (strings.fromList [c])))))))))@{description="Escape a single code point for backticked-name content."}
