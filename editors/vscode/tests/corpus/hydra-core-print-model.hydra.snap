>term caseStatement = (λaliases.λcs.let tname := printNameAliased aliases (model.CaseStatement[typeName] cs) in let mdef := model.CaseStatement[default] cs in let csCases := model.CaseStatement[`cases`] cs in let caseFields := lists.map (λalt.model.Field{name = model.CaseAlternative[name] alt, `term` = model.CaseAlternative[handler] alt}) csCases in let defaultField := optionals.match mdef [] (λd.[model.Field{name = model.Name{"_"}, `term` = d}]) in let allFields := lists.concat [caseFields, defaultField] in strings.concat ["cases(", tname, ")", fields aliases allFields])@{description="Show a case statement as a string, shortening nominal references via the given import-alias map (#803)"}
