>term lambda = (λaliases.λl.let v := printBinderName (model.Lambda[parameter] l) in let mt := model.Lambda[domain] l in let body := model.Lambda[body] l in let typeStr := optionals.match mt "" (λt.strings.concat2 ":" (typeAliased aliases t)) in strings.concat ["λ", v, typeStr, ".", termAliased aliases body])@{description="Show a lambda as a string, shortening nominal references in its domain/body via the given alias map (#803)"}
