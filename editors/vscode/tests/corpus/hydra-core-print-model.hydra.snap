>term isReservedWord = (λs.sets.member s (sets.fromList ["_", "as", "bigint", "binary", "boolean", "cases", "decimal", "do", "effect", "either", "false", "float32", "float64", "forall", "from", "given", "impure", "in", "import", "inject", "int8", "int16", "int32", "int64", "left", "let", "list", "map", "module", "none", "optional", "partial", "primitive", "project", "record", "right", "set", "string", "term", "true", "type", "uint8", "uint16", "uint32", "uint64", "union", "unit", "unwrap", "void", "wrap", "NaN", "Infinity"]))@{description="True iff the given string is a reserved word which must be backtick-escaped when used as a name."}
