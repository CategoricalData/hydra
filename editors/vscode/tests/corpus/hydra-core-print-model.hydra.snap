>term termAtPrec = (λaliases.λctx.λt.let gatherTerms := λprev.λapp.let lhs := model.Application[function] app in let rhs := model.Application[argument] app in cases(model.Term){application=λapp2.gatherTerms (lists.cons rhs prev) app2, `_`=lists.cons lhs (lists.cons rhs prev)} lhs in cases(model.Term){annotated=λat.let bodyStr := termAtPrec aliases 3:int32 (model.AnnotatedTerm[body] at) in let annStr := termAtPrec aliases 3:int32 (model.AnnotatedTerm[annotation] at) in logic.ifElse (ordering.lt 3:int32 ctx) (strings.concat ["(", strings.concat [bodyStr, "@", annStr], ")"]) (strings.concat [bodyStr, "@", annStr]), application=λapp.let terms := gatherTerms [] app in let termStrs := lists.map (λe.termAtPrec aliases 3:int32 e) terms in logic.ifElse (ordering.lt 2:int32 ctx) (strings.concat ["(", strings.join " " termStrs, ")"]) (strings.join " " termStrs), `cases`=λcs.caseStatement aliases cs, `either`=λe.eithers.either (λl.strings.concat ["left(", termAliased aliases l, ")"]) (λr.strings.concat ["right(", termAliased aliases r, ")"]) e, lambda=λl.logic.ifElse (ordering.lt 0:int32 ctx) (strings.concat ["(", lambda aliases l, ")"]) (lambda aliases l), `let`=λl.logic.ifElse (ordering.lt 0:int32 ctx) (strings.concat ["(", letAliased aliases l, ")"]) (letAliased aliases l), `list`=λels.let termStrs := lists.map (termAliased aliases) els in strings.concat ["[", strings.join ", " termStrs, "]"], literal=λlit.literal lit, `map`=λm.let entry := λp.strings.concat [termAliased aliases (pairs.first p), "=", termAliased aliases (pairs.second p)] in strings.concat ["{", strings.join ", " (lists.map entry (lists.sortBy pairs.first (maps.toList m))), "}"], `optional`=λmt.optionals.match mt "none" (λt.strings.concat ["given(", termAliased aliases t, ")"]), pair=λp.strings.concat ["(", termAliased aliases (pairs.first p), ", ", termAliased aliases (pairs.second p), ")"], `project`=λproj.projection aliases proj, `record`=λrec.let tname := printNameAliased aliases (model.Record[typeName] rec) in let flds := model.Record[fields] rec in strings.concat [tname, sugarFields aliases flds], `set`=λs.strings.concat ["{", strings.join ", " (lists.map (termAliased aliases) (lists.sort (sets.toList s))), "}"], typeLambda=λta.let param := printBinderName (model.TypeLambda[parameter] ta) in let body := model.TypeLambda[body] ta in logic.ifElse (ordering.lt 0:int32 ctx) (strings.concat ["(", strings.concat ["Λ", param, ".", termAliased aliases body], ")"]) (strings.concat ["Λ", param, ".", termAliased aliases body]), typeApplication=λtt.let t2 := model.TypeApplicationTerm[body] tt in let typ := model.TypeApplicationTerm[`type`] tt in let bodyStr := termAtPrec aliases 3:int32 t2 in logic.ifElse (ordering.lt 3:int32 ctx) (strings.concat ["(", strings.concat [bodyStr, "⟨", typeAliased aliases typ, "⟩"], ")"]) (strings.concat [bodyStr, "⟨", typeAliased aliases typ, "⟩"]), `inject`=λinj.injection aliases inj, `unit`=λ`_`."unit", `unwrap`=λtname.strings.concat [printNameAliased aliases tname, "[]"], variable=λname.printNameAliased aliases name, `wrap`=λwt.let tname := printNameAliased aliases (model.WrappedTerm[typeName] wt) in let term1 := model.WrappedTerm[body] wt in logic.ifElse (isVariableTerm term1) (strings.concat ["wrap(", tname, "){", termAliased aliases term1, "}"]) (strings.concat [tname, "{", termAliased aliases term1, "}"])} t)@{description="Show a term as a string at a given minimum context precedence, adding minimal parentheses"}
