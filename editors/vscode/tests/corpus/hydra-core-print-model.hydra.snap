>term letAliased = (λaliases.λl.let bindings := model.Let[bindings] l in let env := model.Let[body] l in let bindingStrs := lists.map (bindingAliased aliases) bindings in strings.concat ["let ", strings.join ", " bindingStrs, " in ", termAliased aliases env])@{description="Show a let expression as a string, shortening nominal references via the given import-alias map (#803)"}
