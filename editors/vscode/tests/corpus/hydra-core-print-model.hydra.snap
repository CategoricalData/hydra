>term projection = (λaliases.λproj.let tname := printNameAliased aliases (model.Projection[typeName] proj) in let fname := printNameAliased aliases (model.Projection[fieldName] proj) in strings.concat [tname, "[", fname, "]"])@{description="Show a projection as a string, shortening the type name via the given import-alias map (#803)"}
