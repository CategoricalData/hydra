>term peelDescriptionAnnotation = (λtyp.cases(model.Type){annotated=λat.let body := model.AnnotatedType[body] at in let ann := model.AnnotatedType[annotation] at in cases(model.Term){`map`=λm.let entries := maps.toList m in logic.ifElse (equality.equal (lists.length entries) 1:int32) (let entry := optionals.withDefault (model.Term{`unit`}, model.Term{`unit`}) (lists.head entries) in let k := pairs.first entry in let v := pairs.second entry in cases(model.Term){variable=λn.logic.ifElse (equality.equal (model.Name[] n) "description") (cases(model.Term){literal=λl.cases(model.Literal){`string`=λs.(given(s), body), `_`=(none, typ)} l, `_`=(none, typ)} v) (none, typ), `_`=(none, typ)} k) (none, typ), `_`=(none, typ)} ann, `_`=(none, typ)} typ)@{description="Peel a single '@{description = ...}' annotation off a type, returning (description, body) if found"}
