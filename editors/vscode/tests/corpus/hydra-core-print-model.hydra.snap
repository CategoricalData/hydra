>term integer = (λiv.cases(model.IntegerValue){`bigint`=λv.strings.concat2 (literals.printBigint v) ":bigint", `int8`=λv.strings.concat2 (literals.printInt8 v) ":int8", `int16`=λv.strings.concat2 (literals.printInt16 v) ":int16", `int32`=λv.strings.concat2 (literals.printInt32 v) ":int32", `int64`=λv.strings.concat2 (literals.printInt64 v) ":int64", `uint8`=λv.strings.concat2 (literals.printUint8 v) ":uint8", `uint16`=λv.strings.concat2 (literals.printUint16 v) ":uint16", `uint32`=λv.strings.concat2 (literals.printUint32 v) ":uint32", `uint64`=λv.strings.concat2 (literals.printUint64 v) ":uint64"} iv)@{description="Show an integer value as a string"}
