>
>term typeScheme = (typeSchemeAliased maps.empty)@{description="Show a type scheme as a string"}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^ source.hydra entity.name.function.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.equals.hydra
#                 ^^ source.hydra
#                   ^^^^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                    ^ source.hydra
#                                     ^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                               ^ source.hydra
#                                                ^ source.hydra keyword.operator.annotation.hydra
#                                                 ^ source.hydra
#                                                  ^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                             ^ source.hydra keyword.operator.equals.hydra
#                                                              ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra string.quoted.double.hydra
#                                                                                             ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                              ^^ source.hydra
>
>term typeSchemeAliased = (λaliases.λts.let vars := model.TypeScheme[variables] ts in let body := model.TypeScheme[body] ts in let varNames := lists.map printBinderName vars in let constraintClassName := λc.cases(model.TypeClassConstraint){simple=λn.model.Name[] n} c in let toConstraintPair := λv.λc.strings.concat [constraintClassName c, " ", model.Name[] v] in let toConstraintPairs := λp.lists.map (toConstraintPair (pairs.first p)) (lists.sortBy constraintClassName (sets.toList (model.TypeVariableConstraints[classes] (pairs.second p)))) in let tc := lists.concat (lists.map toConstraintPairs (lists.sortBy pairs.first (maps.toList (model.TypeScheme[constraints] ts)))) in let bodyStr := typeAliased aliases body in logic.ifElse (lists.isEmpty varNames) bodyStr (strings.concat ["∀", strings.join "," varNames, ".", logic.ifElse (lists.isEmpty tc) "" (strings.concat ["(", strings.join ", " tc, ") ⇒ "]), bodyStr]))@{description="Show a type scheme as a string, shortening nominal references in its body via the given alias map (#803)"}
