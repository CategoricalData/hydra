>term sugarField = (λaliases.λfield.let fname := printName (model.Field[name] field) in let fterm := model.Field[`term`] field in logic.ifElse (fieldTermIsUnit fterm) fname (strings.concat [fname, " = ", termAliased aliases fterm]))@{description="Show a single field in sugar form: bareword 'name' for a unit value, else 'name = term' (#809)"}
