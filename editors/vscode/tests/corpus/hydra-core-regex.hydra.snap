>## A model for Hydra's translingual regular-expression syntax: the abstract syntax tree (AST) into which hydra.core.parse.regex parses a pattern and from which hydra.core.print.regex (and the per-dialect hydra.core.print.<dialect>.regex renderers) emit target syntax. Covers the minimal core defined in docs/specification/regex.md (literals, character classes, ., quantifiers, alternation, anchors, grouping). See issue #567.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>module hydra.core.regex
#^^^^^^ source.hydra keyword.control.module.hydra
#      ^ source.hydra
#       ^^^^^^^^^^^^^^^^ source.hydra entity.name.namespace.hydra
>
>
>
>## A non-empty list of alternative sequences, joined by the | operator. Matches if any alternative matches.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>type Alternation = list<RegexSequence>
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                ^ source.hydra
#                 ^ source.hydra keyword.operator.equals.hydra
#                  ^ source.hydra
#                   ^^^^ source.hydra support.type.hydra
#                       ^ source.hydra punctuation.definition.typeargs.begin.hydra
#                        ^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                     ^ source.hydra punctuation.definition.typeargs.end.hydra
>
>## A single, unquantified regex element: the smallest unit to which a quantifier may apply.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>type Atom = union{
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^ source.hydra entity.name.function.hydra
#         ^ source.hydra
#          ^ source.hydra keyword.operator.equals.hydra
#           ^ source.hydra
#            ^^^^^ source.hydra support.type.hydra
#                 ^^ source.hydra
>  ## A literal character, matched exactly. The character is a Unicode scalar value in the range [U+0000, U+10FFFF] (surrogates excluded), held as an int32 code point (the range fits in signed 32-bit, and int32 matches Hydra's string/parser code-point representation). In concrete syntax, a metacharacter is written escaped (e.g. \.); escaping is purely a concrete-syntax concern, so the AST holds the bare code point.
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  literal: int32,
#^^ source.hydra
#  ^^^^^^^ source.hydra variable.other.hydra
#         ^ source.hydra punctuation.separator.type.hydra
#          ^ source.hydra
#           ^^^^^ source.hydra support.type.hydra
#                ^^ source.hydra
>  ## The . metacharacter; matches any single character, INCLUDING newline (unlike most host engines, whose native . excludes newline). To exclude newline, write [^\n] explicitly.
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  any: unit,
#^^ source.hydra
#  ^^^ source.hydra variable.other.hydra
#     ^ source.hydra punctuation.separator.type.hydra
#      ^ source.hydra
#       ^^^^ source.hydra support.type.hydra
#           ^^ source.hydra
>  ## The ^ anchor; matches the empty string at the start of input.
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  anchorStart: unit,
#^^ source.hydra
#  ^^^^^^^^^^^ source.hydra variable.other.hydra
#             ^ source.hydra punctuation.separator.type.hydra
#              ^ source.hydra
#               ^^^^ source.hydra support.type.hydra
#                   ^^ source.hydra
>  ## The $ anchor; matches the empty string at the end of input.
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  anchorEnd: unit,
