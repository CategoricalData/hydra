## YAML-to-JSON decoding. Converts YAML Nodes to JSON Values (may fail for non-JSON YAML), and YAML Nodes to Hydra Terms via JSON.
module hydra.core.json.yaml.decode

import hydra.core.json.decode
import hydra.core.json.model
import hydra.core.lib.eithers as eithers
import hydra.core.lib.literals
import hydra.core.lib.maps
import hydra.core.lib.pairs
import hydra.core.yaml.model

## Decode a YAML node to a Hydra term via JSON decoding.
term fromYaml =
  λtypes,tname,typ,node.
    let jsonResult := yamlToJson node
    in eithers.either (λerr.left(err)) (λjson.fromJson types false tname typ json) jsonResult

## Convert a YAML node to a JSON value. Fails for non-JSON YAML features (e.g. non-string mapping keys).
term yamlToJson =
  λnode.cases(Node){
      mapping=λm.
          let convertEntry := λkv.
              let keyNode := first kv in
              let valNode := second kv in
              let keyResult := cases(Node){
                  scalar=λs.cases(Scalar){
                        str=λstr.right(str),
                        `_`=left("non-string YAML mapping key")}
                        s,
                  `_`=left("non-scalar YAML mapping key")}
                  keyNode in
              eithers.either
                (λerr.left(err))
                (λkey.
                  let valResult := yamlToJson valNode
                  in eithers.map (λv.(key, v)) valResult)
                keyResult in
          let entries := eithers.mapList convertEntry (toList m) in
          eithers.map (λes.Value{object = es}) entries,
      scalar=λs.cases(Scalar){
            bool=λb.right(Value{`boolean` = b}),
            `decimal`=λd.right(Value{number = d}),
            float=λf.right(Value{number = float64ToDecimal f}),
            int=λi.right(Value{number = bigintToDecimal i}),
            null=λ`_`.right(Value{null}),
            str=λstr.right(Value{`string` = str})}
            s,
      sequence=λnodes.
          let results := eithers.mapList (λn.yamlToJson n) nodes
          in eithers.map (λvs.Value{array = vs}) results}
      node