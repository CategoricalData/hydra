## Abstractions for paired transformations between languages
module hydra.core.coders

import hydra.core.errors
import hydra.core.file
import hydra.core.graph
import hydra.core.model
import hydra.core.util
import hydra.core.variants

## A two-level bidirectional encoder which adapts types to types and terms to terms
type Adapter = forall t1, t2, v1, v2, e. record{

  ## Whether information may be lost in the course of this adaptation
  isLossy: boolean,

  ## The source type
  source: t1,

  ## The target type
  target: t2,

  ## The coder for transforming instances of the source type to instances of the target type
  coder: Coder v1 v2 e}

## An evaluation context together with a source language and a target language
type AdapterContext = record{

  ## The underlying graph of elements and primitives
  graph: Graph,

  ## The language being encoded or decoded
  language: Language,

  ## A map of type names to adapters for those types
  adapters: map<Name, Adapter Type Type Term Term Error>}

## A two-level encoder and decoder, operating both at a type level and an instance (data) level
type Bicoder = forall t1, t2, v1, v2, e. record{

  ## A function from source types to adapters
  encode: t1 → Adapter t1 t2 v1 v2 e,

  ## A function from target types to adapters
  decode: t2 → Adapter t2 t1 v2 v1 e}

## Per-target case conventions for name forms that vary across emission targets
type CaseConventions = record{

  ## Convention for compile-time constant names
  constant: CaseConvention,

  ## Convention for each directory level in the emitted source tree
  directory: CaseConvention,

  ## Convention for enum-variant value names
  enumValue: CaseConvention,

  ## Convention for record field names
  field: CaseConvention,

  ## Convention for the source-file basename
  file: CaseConvention,

  ## Convention for a single segment of a module name
  `module`: CaseConvention,

  ## Convention for top-level term definitions (functions, module-level values)
  `term`: CaseConvention,

  ## Convention for locally-bound term names (lambda parameters, let-bindings)
  termVariable: CaseConvention,

  ## Convention for type names
  `type`: CaseConvention,

  ## Convention for type-level variable names
  typeVariable: CaseConvention}

## An encoder and decoder; a pair of partial functions between two types
type Coder = forall v1, v2, e. record{

  ## A function which encodes a domain value to a codomain value, with the possibility of failure
  encode: v1 → either<e, v2>,

  ## A function which decodes a codomain value to a domain value, with the possibility of failure
  decode: v2 → either<e, v1>}

## Indicates either the 'out' or the 'in' direction of a coder
type CoderDirection = union{
  encode: unit,
  decode: unit}

## A named language together with its grammar constraints, capability profile, naming conventions, and conventional file extension
type Language = record{

  ## The unique name of the language
  name: LanguageName,

  ## Constraints which characterize the language's type and term grammars
  constraints: LanguageConstraints,

  ## Target-language or target-runtime capabilities the emitter may assume are available
  supportedFeatures: set<LanguageFeature>,

  ## Per-target case conventions for the various kinds of identifiers emitted by the coder
  caseConventions: CaseConventions,

  ## Conventional file extension for emitted source files, without the leading dot (e.g. "scala", "py")
  defaultFileExtension: FileExtension}

## A set of constraints on valid type and term expressions, characterizing a language
type LanguageConstraints = record{

  ## All supported literal variants
  literalVariants: set<LiteralVariant>,

  ## All supported float types
  floatTypes: set<FloatType>,

  ## All supported integer types
  integerTypes: set<IntegerType>,

  ## All supported term variants
  termVariants: set<TermVariant>,

  ## All supported type variants
  typeVariants: set<TypeVariant>,

  ## A logical set of types, as a predicate which tests a type for inclusion
  types: Type → boolean}

## A target-language or target-runtime capability the coder may rely on. Absence from a Language's supportedFeatures set means the emitter must work around the missing capability.
type LanguageFeature = union{

  ## The target runtime can invoke an n-ary function with fewer than n arguments without error. When absent, the emitter eta-expands partially-applied terms.
  partialApplication: unit,

  ## The target runtime can handle deeply nested case statements without stack issues. When absent, the emitter hoists cases out into top-level helpers.
  nestedCaseStatements: unit,

  ## The target language permits polymorphic let-bindings in expression position. When absent, the emitter hoists polymorphic lets to top level.
  nestedPolymorphicLetBindings: unit}

## The unique name of a language
type LanguageName = wrap(string)

## A bidirectional encoder which maps between the same type and term languages on either side
type SymmetricAdapter = forall t, v, e. Adapter t t v v e

## A 'let' binding within a TCO-lowered loop body, mirroring Core.Binding
type TcoBinding = record{

  ## The name of the bound variable
  name: Name,

  ## The term to which the variable is bound; recomputed on every loop iteration
  `term`: Term,

  ## The optional type scheme of the binding, needed to declare its own type parameters
  typeScheme: optional<TypeScheme>}

## A single alternative of a TCO-lowered case statement, mirroring Core.CaseAlternative. The original handler is always a lambda binding the variant's payload; 'parameter' preserves that bound name so coders know what to bind when printing the branch.
type TcoCaseAlternative = record{

  ## The name of the union variant matched by this alternative
  name: Name,

  ## The name bound to the matched variant's payload (from the original handler lambda)
  parameter: Name,

  ## The lowered handler body for the matched variant's payload
  handler: TcoStep}

## A TCO-lowered union elimination, mirroring Core.CaseStatement
type TcoCaseStatement = record{

  ## The name of the union type
  typeName: Name,

  ## The term being matched against; evaluated exactly once per dispatch
  scrutinee: Term,

  ## An optional default case, used if none of the explicit cases match
  default: optional<TcoStep>,

  ## A list of case alternatives, one per union variant being handled
  `cases`: list<TcoCaseAlternative>}

## A set of 'let' bindings together with a lowered body, mirroring Core.Let
type TcoLet = record{

  ## The list of variable bindings; recomputed on every loop iteration
  bindings: list<TcoBinding>,

  ## The lowered body term in which the variables are bound
  body: TcoStep}

## A self-tail-recursive function body, restructured into an explicit loop. Produced by lowerSelfTailRecursion; consumed by per-language coders to emit a native iteration construct.
type TcoLoopPlan = record{

  ## Parameter names, in order; these are the loop's mutable loop variables
  params: list<Name>,

  ## The loop body, with tail self-calls lowered to continuation steps
  body: TcoStep}

## One node of a TCO-lowered function body: a loop continuation, a terminal value, or a branch
type TcoStep = union{

  ## Reassign params to these new values, in the same order as TcoLoopPlan.params, and repeat the loop
  continue: list<Term>,

  ## Exit the loop, yielding this value
  return: Term,

  ## Branch on a union elimination; mirrors Core.CaseStatement but handlers are TcoStep
  `cases`: TcoCaseStatement,

  ## Bindings that must be recomputed on every iteration, mirroring Core.Let
  `let_`: TcoLet}

## Specifies either a pre-order or post-order traversal
type TraversalOrder = union{

  ## Pre-order traversal
  pre: unit,

  ## Post-order traversal
  post: unit}

## A function which maps a Hydra type to a symmetric adapter between types and terms
type TypeAdapter = AdapterContext → Type → either<string, SymmetricAdapter Type Term string>