>## Convert an integer value of any precision to a bigint
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term integerValueToBigint = cases(model.IntegerValue){`bigint`=λbi.bi, `int8`=λi8.literals.int8ToBigint i8, `int16`=λi16.literals.int16ToBigint i16, `int32`=λi32.literals.int32ToBigint i32, `int64`=λi64.literals.int64ToBigint i64, `uint8`=λui8.literals.uint8ToBigint ui8, `uint16`=λui16.literals.uint16ToBigint ui16, `uint32`=λui32.literals.uint32ToBigint ui32, `uint64`=λui64.literals.uint64ToBigint ui64}
