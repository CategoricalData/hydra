>term atom = (λa.cases(regex.Atom){literal=λc.escapeLiteral c, any=λ`_`.anyClass, anchorStart=λ`_`."\\`", anchorEnd=λ`_`."\\'", group=λg.strings.concat ["\\(", alternation g, "\\)"], class=λcc.characterClass cc} a)@{description="Render a single atom; . -> [^z-a], and groups use Emacs's \\( \\) escaping."}
