>term quantifier = (λq.cases(regex.Quantifier){one=λ`_`."", zeroOrOne=λ`_`."?", zeroOrMore=λ`_`."*", oneOrMore=λ`_`."+", exactly=λn.strings.concat ["\\{", literals.printInt32 n, "\\}"], atLeast=λn.strings.concat ["\\{", literals.printInt32 n, ",\\}"], range=λr.strings.concat ["\\{", literals.printInt32 (regex.QuantifierRange[min] r), ",", literals.printInt32 (regex.QuantifierRange[max] r), "\\}"]} q)@{description="Render a quantifier suffix; bounded {..} forms use Emacs's escaped braces \\{..\\}."}
