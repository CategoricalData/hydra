>term alternation = (λalt.let rendered := lists.map regexSequence alt, byLength := lists.sortBy strings.length rendered in strings.join "\\|" (lists.reverse byLength))@{description="Render an alternation, joining its branches with Emacs's \\| operator. Branches are ordered by descending rendered length so that Emacs's leftmost-first matching agrees with Hydra's leftmost-longest semantics for fixed-length alternatives."}
