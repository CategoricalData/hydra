>## The subtype-side analog of a subterm step on the data fragment, or nothing on the computation fragment
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term eraseSubtermStep = λstep.cases(paths.SubtermStep){listElement=λ`_`.given(paths.SubtypeStep{listElement}), setElement=λ`_`.given(paths.SubtypeStep{setElement}), optionalGiven=λ`_`.given(paths.SubtypeStep{optionalElement}), injectField=λn.given(paths.SubtypeStep{unionField = n}), recordField=λn.given(paths.SubtypeStep{recordField = n}), `_`=none} step
