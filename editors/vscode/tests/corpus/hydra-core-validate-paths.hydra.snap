>## Erase a subterm path to the subtype path of its type, if wholly within the data fragment
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term eraseSubtermPath = λpath.let steps := paths.SubtermPath[] path in let go := λacc,step.optionals.match acc none (λstateP.let out := pairs.first stateP in let pendingEntry := pairs.second stateP in logic.ifElse pendingEntry (cases(paths.SubtermStep){pairFirst=λ`_`.given((lists.concat2 out [paths.SubtypeStep{mapKeys}], false)), pairSecond=λ`_`.given((lists.concat2 out [paths.SubtypeStep{mapValues}], false)), `_`=none} step) (cases(paths.SubtermStep){mapEntry=λ`_`.given((out, true)), `_`=optionals.map (λst.(lists.concat2 out [st], false)) (eraseSubtermStep step)} step)) in let result := lists.foldl go given(([], false)) steps in optionals.bind result (λstateP.logic.ifElse (pairs.second stateP) none given(paths.SubtypePath{pairs.first stateP}))
