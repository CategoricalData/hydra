## String representations of hydra.core.typing types
module hydra.core.print.typing

import hydra.core.lib.lists as lists
import hydra.core.lib.maps as maps
import hydra.core.lib.pairs
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.typing

## Show a type constraint as a string
term typeConstraint =
  λtc.
    let ltyp := TypeConstraint[`left`] tc, rtyp := TypeConstraint[`right`] tc
    in strings.concat [`type` ltyp, "≡", `type` rtyp]

## Show a type substitution as a string
term typeSubst =
  λts.
    let subst := TypeSubst[] ts, pairs := maps.toList subst, showPair := λpair.
        let name := Name[] (first pair), typ := second pair
        in strings.concat [name, "↦", `type` typ], pairStrs := lists.map showPair pairs
    in strings.concat ["{", strings.join "," pairStrs, "}"]