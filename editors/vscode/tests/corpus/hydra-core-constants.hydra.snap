>## Regex matching a camelCase identifier: starts with a lowercase letter, then any letters or digits.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term regexCamelCase = "^[a-z][a-zA-Z0-9]*$"
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                   ^ source.hydra
#                    ^ source.hydra keyword.operator.equals.hydra
#                     ^ source.hydra
#                      ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                       ^^^^^^^^^^^^^^^^^^^ source.hydra string.quoted.double.hydra
#                                          ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
>
>## Regex matching a Hydra namespace: dot-separated camelCase segments, each starting with a lowercase letter.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term regexNamespace = "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$"
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                   ^ source.hydra
#                    ^ source.hydra keyword.operator.equals.hydra
#                     ^ source.hydra
#                      ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                       ^^^^^^^^^^^^^^^^^^^ source.hydra string.quoted.double.hydra
#                                          ^^ source.hydra string.quoted.double.hydra constant.character.escape.hydra
#                                            ^^^^^^^^^^^^^^^^^^^^^ source.hydra string.quoted.double.hydra
#                                                                 ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
>
>## Regex matching a Hydra package name: hyphen-separated lowercase segments, each starting with a letter.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term regexPackageName = "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                     ^ source.hydra
#                      ^ source.hydra keyword.operator.equals.hydra
#                       ^ source.hydra
#                        ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra string.quoted.double.hydra
#                                                           ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
>
>## Regex matching a PascalCase identifier: starts with an uppercase letter, then any letters or digits.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term regexPascalCase = "^[A-Z][a-zA-Z0-9]*$"
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                    ^ source.hydra
#                     ^ source.hydra keyword.operator.equals.hydra
#                      ^ source.hydra
#                       ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
