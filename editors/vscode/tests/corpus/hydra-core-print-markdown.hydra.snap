>term block = (λb.cases(markdown.Block){codeBlock=λcb.codeBlock cb, `list`=λl.`list` l, paragraph=λp.inlines (markdown.Paragraph[content] p), raw=λs.s, section=λs.let h := markdown.Section[heading] s in let content := markdown.Section[content] s in strings.join "\n\n" (lists.cons (heading h) (lists.map block content)), table=λt.table t} b)@{description="Render a single Block to its Markdown text form"}
