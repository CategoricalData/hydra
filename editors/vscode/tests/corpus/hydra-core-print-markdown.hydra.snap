>term codeBlock = (λcb.let lang := markdown.CodeBlock[language] cb in let content := markdown.CodeBlock[content] cb in let fence := strings.concat2 "```" (optionals.withDefault "" lang) in strings.join "\n" [fence, content, "```"])@{description="Render a CodeBlock as a fenced code block, with the language tag on the opening fence if present"}
