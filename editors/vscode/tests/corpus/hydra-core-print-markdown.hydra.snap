>term inline = (λi.cases(markdown.Inline){code=λs.strings.concat2 (strings.concat2 "`" s) "`", emphasis=λis.strings.concat2 (strings.concat2 "*" (inlines is)) "*", link=λlk.link lk, strong=λis.strings.concat2 (strings.concat2 "**" (inlines is)) "**", text=λs.s} i)@{description="Render a single Inline to its Markdown text form"}
