>term heading = (λh.let level := markdown.Heading[level] h in let content := markdown.Heading[content] h in let hashes := strings.concat (lists.replicate level "#") in strings.concat2 (strings.concat2 hashes " ") (inlines content))@{description="Render a Heading, prefixing its inline content with the appropriate number of `#` characters"}
