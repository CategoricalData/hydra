>
>term table = (λt.let header := markdown.Table[header] t in let rows := markdown.Table[rows] t in let headerCells := markdown.TableRow[] header in let sepRow := strings.concat2 "|" (strings.concat (lists.map (λ`_`." --- |") headerCells)) in strings.join "\n" (lists.cons (tableRow header) (lists.cons sepRow (lists.map tableRow rows))))@{description="Render a Table in GitHub-flavored Markdown pipe-table form, with a `---` separator row after the header"}
