>term document = (λd.let title := markdown.Document[title] d in let content := markdown.Document[content] d in strings.join "\n\n" (lists.cons (strings.concat2 "# " title) (lists.map block content)))@{description="Render a Document as its complete Markdown text, an H1 title followed by its blocks"}
