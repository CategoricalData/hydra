>term list = (λl.let ordered := markdown.List[ordered] l in let items := markdown.List[items] l in let itemContent := λit.blocks (markdown.ListItem[] it) in let indices := math.range 0:int32 (lists.length items) in let indexedItems := lists.zip indices items in let renderIndexed := λip.let idx := pairs.first ip in let it := pairs.second ip in let marker := logic.ifElse ordered (strings.concat2 (literals.printInt32 (math.add idx 1:int32)) ".") "-" in strings.concat2 (strings.concat2 marker " ") (itemContent it) in strings.join "\n" (lists.map renderIndexed indexedItems))@{description="Render a List as bulleted (`-`) or numbered (`1.`, `2.`, ...) lines, one per item; item content is joined with a blank line for items spanning multiple blocks"}
