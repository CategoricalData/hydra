## Extract a unit value from a term
term unit =
  λ`term`.cases(Term){
      `unit`=λ`_`.right(unit),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "unit",
              actual = model.term `term`}}})}
      `term`

## Extract a unit variant (a variant with an empty record value) from a union term
term unitVariant =
  λtname,graph,`term`.eithers.bind
      (injection tname graph `term`)
      (λfield.eithers.bind (`unit` (Field[`term`] field)) (λignored.right(Field[name] field)))

## Extract the wrapped value from a wrapped term
term wrap =
  λexpected,graph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `wrap`=λwrappedTerm.ifElse
                (equal
                  (Name[] (WrappedTerm[typeName] wrappedTerm))
                  (Name[] expected))
                right(WrappedTerm[body] wrappedTerm)
                left(Error{
                  extraction = ExtractionError{
                    unexpectedShape = UnexpectedShapeError{
                      expected = strings.concat2
                          "wrapper of type "
                          (Name[] expected),
                      actual = Name[]
                          (WrappedTerm[typeName] wrappedTerm)}}}),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = strings.concat2
                      (strings.concat2
                        "wrap("
                        (Name[] expected))
                      ")",
                  actual = model.term `term`}}})}
          `term`)

## Extract the wrapped type from a wrapper type
term wrappedType =
  λename,typ.
    let stripped := deannotateType typ
    in cases(Type){
      `wrap`=λinnerType.right(innerType),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "wrapped type",
              actual = model.type typ}}})}
      stripped