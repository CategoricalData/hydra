## Extract a floating-point literal from a Literal value
term floatLiteral =
  λlit.cases(Literal){
      float=λv.right(v),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "floating-point value",
              actual = model.literal lit}}})}
      lit

## Extract a float value from a term
term floatValue = λgraph,t.eithers.bind (literal graph t) (λl.floatLiteral l)

## Extract a function type from a type
term functionType =
  λtyp.
    let stripped := deannotateType typ
    in cases(Type){
      function=λft.right(ft),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "function type",
              actual = model.type typ}}})}
      stripped

## Extract a field from a union term
term injection =
  λexpected,graph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `inject`=λinjection.ifElse
                (equal
                  (Name[] (Injection[typeName] injection))
                  (Name[] expected))
                right(Injection[field] injection)
                left(Error{
                  extraction = ExtractionError{
                    unexpectedShape = UnexpectedShapeError{
                      expected = strings.concat2
                          "injection of type "
                          (Name[] expected),
                      actual = Name[] (Injection[typeName] injection)}}}),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "injection",
                  actual = model.term `term`}}})}
          `term`)

