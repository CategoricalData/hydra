## Extract an integer literal from a Literal value
term integerLiteral =
  λlit.cases(Literal){
      integer=λv.right(v),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "integer value",
              actual = model.literal lit}}})}
      lit

## Extract an integer value from a term
term integerValue = λgraph,t.eithers.bind (literal graph t) (λl.integerLiteral l)

## Extract a lambda from a term
term lambda =
  λgraph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          lambda=λl.right(l),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "lambda",
                  actual = model.term `term`}}})}
          `term`)

## Extract the body of a lambda term
term lambdaBody = λgraph,`term`.eithers.map Lambda[body] (lambda graph `term`)

## Extract a let expression from a term
term let =
  λgraph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `let`=λlt.right(lt),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "let term",
                  actual = model.term `term`}}})}
          `term`)

## Extract a binding with the given name from a let term
term letBinding =
  λn,graph,`term`.
    let name := wrap(Name){n}
    in eithers.bind
      (`let` graph `term`)
      (λletExpr.
        let matchingBindings := lists.filter
            (λb.equal (Name[] (Binding[name] b)) (Name[] name))
            (Let[bindings] letExpr) in
        let noBindingErr := left(Error{
            extraction = ExtractionError{
              noSuchBinding = NoSuchBindingError{
                name = name}}}) in
        ifElse
          (lists.isEmpty matchingBindings)
          noBindingErr
          (ifElse
            (equal (lists.length matchingBindings) 1:int32)
            (match (lists.head matchingBindings) noBindingErr (λb.right(Binding[`term`] b)))
            left(Error{
              extraction = ExtractionError{
                multipleBindings = MultipleBindingsError{
                  name = name}}})))

## Extract a list of terms from a term
term list =
  λgraph,`term`.eithers.bind
      (stripAndDereferenceTerm graph `term`)
      (λstripped.cases(Term){
          `list`=λl.right(l),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "list",
                  actual = model.term stripped}}})}
          stripped)

## Extract a list of values from a term, mapping a function over each element
term listOf = λf,graph,`term`.eithers.bind (`list` graph `term`) (λels.eithers.mapList f els)

## Extract the element type from a list type
term listType =
  λtyp.
    let stripped := deannotateType typ
    in cases(Type){
      `list`=λt.right(t),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "list type",
              actual = model.type typ}}})}
      stripped

## Extract a literal value from a term
term literal =
  λgraph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          literal=λlit.right(lit),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "literal",
                  actual = model.term `term`}}})}
          `term`)

## Extract a map of key-value pairs from a term, mapping functions over each key and value
term map =
  λfk,fv,graph,term0.
    let pair := λkvPair.
        let kterm := first kvPair in
        let vterm := second kvPair in
        eithers.bind
          (fk kterm)
          (λkval.eithers.bind (fv vterm) (λvval.right((kval, vval))))
    in eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `map`=λm.eithers.map maps.fromList (eithers.mapList pair (maps.toList m)),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "map",
                  actual = model.term `term`}}})}
          `term`)

## Extract the key and value types from a map type
term mapType =
  λtyp.
    let stripped := deannotateType typ
    in cases(Type){
      `map`=λmt.right(mt),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "map type",
              actual = model.type typ}}})}
      stripped

## Ensure a function has the expected number of arguments
term nArgs =
  λname,n,args.ifElse
      (equal (lists.length args) n)
      right(unit)
      left(Error{
        extraction = ExtractionError{
          unexpectedShape = UnexpectedShapeError{
            expected = strings.concat
                [printInt32 n, " arguments to primitive ", printString (Name[] name)],
            actual = printInt32 (lists.length args)}}})

## Extract an optional value from a term, applying a function to the value if present
term optionalTerm =
  λf,graph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `optional`=λmt.match mt right(none) (λt.eithers.map `given` (f t)),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "optional value",
                  actual = model.term `term`}}})}
          `term`)

## Extract the base type from an optional type
term optionalType =
  λtyp.
    let stripped := deannotateType typ
    in cases(Type){
      `optional`=λt.right(t),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "optional type",
              actual = model.type typ}}})}
      stripped

## Extract a pair of values from a term, applying functions to each component
term pair =
  λkf,vf,graph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          pair=λp.eithers.bind
                (kf (first p))
                (λkVal.eithers.bind (vf (second p)) (λvVal.right((kVal, vVal)))),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "pair",
                  actual = model.term `term`}}})}
          `term`)

## Extract a record's fields from a term
term record =
  λexpected,graph,term0.eithers.bind
      (termRecord graph term0)
      (λ`record`.ifElse
          (equal (Record[typeName] `record`) expected)
          right(Record[fields] `record`)
          left(Error{
            extraction = ExtractionError{
              unexpectedShape = UnexpectedShapeError{
                expected = strings.concat2
                    "record of type "
                    (Name[] expected),
                actual = Name[] (Record[typeName] `record`)}}}))

## Extract the field types from a record type
term recordType =
  λename,typ.
    let stripped := deannotateType typ
    in cases(Type){
      `record`=λfields.right(fields),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "record type",
              actual = model.type typ}}})}
      stripped

## Require a field from a record's field map and decode it
term requireField =
  λfieldName,decoder,fieldMap,g.match
      (maps.lookup wrap(Name){fieldName} fieldMap)
      left(DecodingError{strings.concat ["missing field ", fieldName, " in record"]})
      (λfieldTerm.decoder g fieldTerm)

## Extract a set of terms from a term
term set =
  λgraph,`term`.eithers.bind
      (stripAndDereferenceTerm graph `term`)
      (λstripped.cases(Term){
          `set`=λs.right(s),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "set",
                  actual = model.term stripped}}})}
          stripped)

## Extract a set of values from a term, mapping a function over each element
term setOf = λf,graph,`term`.eithers.bind (`set` graph `term`) (λels.eithers.mapSet f els)

## Extract the element type from a set type
term setType =
  λtyp.
    let stripped := deannotateType typ
    in cases(Type){
      `set`=λt.right(t),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "set type",
              actual = model.type typ}}})}
      stripped

## Extract a string value from a term
term string = λgraph,t.eithers.bind (literal graph t) (λl.stringLiteral l)

## Extract a string literal from a Literal value
term stringLiteral =
  λv.cases(Literal){
      `string`=λs.right(s),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "string",
              actual = model.literal v}}})}
      v

## Strip annotations and dereference variables, returning Either DecodingError Term
term stripWithDecodingError =
  λg,`term`.eithers.bimap (λ`_e`.DecodingError{error `_e`}) (λx.x) (stripAndDereferenceTermEither g `term`)

## Extract a record from a term
term termRecord =
  λgraph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `record`=λ`record`.right(`record`),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "record",
                  actual = model.term `term`}}})}
          `term`)

## Convert a Record's fields to a Map from Name to Term
term toFieldMap =
  λ`record`.maps.fromList (lists.map (λf.(Field[name] f, Field[`term`] f)) (Record[fields] `record`))

