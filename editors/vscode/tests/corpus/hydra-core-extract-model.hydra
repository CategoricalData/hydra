## Extraction and validation for hydra.core.model types
module hydra.core.extract.model

import hydra.core.errors
import hydra.core.lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.print.errors
import hydra.core.print.model as model
import hydra.core.strip

## Extract an arbitrary-precision integer value from a term
term bigint = λgraph,t.eithers.bind (literal graph t) (λl.eithers.bind (integerLiteral l) (λi.bigintValue i))

## Extract a bigint value from an IntegerValue
term bigintValue =
  λv.cases(IntegerValue){
      `bigint`=λi.right(i),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "bigint",
              actual = model.integer v}}})}
      v

## Extract a binary data value from a term
term binary = λgraph,t.eithers.bind (literal graph t) (λl.binaryLiteral l)

## Extract a binary literal from a Literal value
term binaryLiteral =
  λv.cases(Literal){
      `binary`=λb.right(b),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "binary",
              actual = model.literal v}}})}
      v

## Extract a boolean value from a term
term boolean = λgraph,t.eithers.bind (literal graph t) (λl.booleanLiteral l)

## Extract a boolean literal from a Literal value
term booleanLiteral =
  λv.cases(Literal){
      `boolean`=λb.right(b),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "boolean",
              actual = model.literal v}}})}
      v

## Extract case statement from a term
term cases =
  λname,graph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `cases`=λcs.ifElse
                (equal (Name[] (CaseStatement[typeName] cs)) (Name[] name))
                right(cs)
                left(Error{
                  extraction = ExtractionError{
                    unexpectedShape = UnexpectedShapeError{
                      expected = strings.concat2
                          "case statement for type "
                          (Name[] name),
                      actual = model.term `term`}}}),
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "case statement",
                  actual = model.term `term`}}})}
          `term`)

## Extract an arbitrary-precision decimal value from a term
term decimal = λgraph,t.eithers.bind (literal graph t) (λl.decimalLiteral l)

## Extract a decimal literal from a Literal value
term decimalLiteral =
  λv.cases(Literal){
      `decimal`=λd.right(d),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "decimal",
              actual = model.literal v}}})}
      v

## Decode an Either value using the provided left and right decoders
term decodeEither =
  λleftDecoder,rightDecoder,g,`term`.eithers.bind
      (stripWithDecodingError g `term`)
      (λstripped.cases(Term){
          `either`=λe.eithers.either
                (λlv.eithers.map (λx.left(x)) (leftDecoder g lv))
                (λrv.eithers.map
                    (λx.right(x))
                    (rightDecoder g rv))
                e,
          `_`=left(DecodingError{"expected either value"})}
          stripped)

## Decode a list of elements using the provided element decoder
term decodeList =
  λelemDecoder,g,`term`.eithers.bind
      (stripWithDecodingError g `term`)
      (λstripped.cases(Term){
          `list`=λels.eithers.mapList (elemDecoder g) els,
          `_`=left(DecodingError{"expected list"})}
          stripped)

## Decode a Map using the provided key and value decoders
term decodeMap =
  λkeyDecoder,valDecoder,g,`term`.eithers.bind
      (stripWithDecodingError g `term`)
      (λstripped.cases(Term){
          `map`=λm.eithers.map
                maps.fromList
                (eithers.mapList
                  (λkv.eithers.bind
                      (keyDecoder g (first kv))
                      (λk.eithers.map
                          (λv.(k, v))
                          (valDecoder g (second kv))))
                  (maps.toList m)),
          `_`=left(DecodingError{"expected map"})}
          stripped)

## Decode a Maybe value using the provided element decoder
term decodeMaybe =
  λelemDecoder,g,`term`.eithers.bind
      (stripWithDecodingError g `term`)
      (λstripped.cases(Term){
          `optional`=λopt.eithers.mapOptional (elemDecoder g) opt,
          `_`=left(DecodingError{"expected optional value"})}
          stripped)

## Decode a Pair using the provided first and second decoders
term decodePair =
  λfirstDecoder,secondDecoder,g,`term`.eithers.bind
      (stripWithDecodingError g `term`)
      (λstripped.cases(Term){
          pair=λp.eithers.bind
                (firstDecoder g (first p))
                (λf.eithers.map
                    (λs.(f, s))
                    (secondDecoder g (second p))),
          `_`=left(DecodingError{"expected pair"})}
          stripped)

## Decode a Set using the provided element decoder
term decodeSet =
  λelemDecoder,g,`term`.eithers.bind
      (stripWithDecodingError g `term`)
      (λstripped.cases(Term){
          `set`=λs.eithers.map
                sets.fromList
                (eithers.mapList (elemDecoder g) (sets.toList s)),
          `_`=left(DecodingError{"expected set"})}
          stripped)

## Decode a unit value
term decodeUnit =
  λg,`term`.eithers.bind
      (stripWithDecodingError g `term`)
      (λstripped.cases(Term){`unit`=λ`_`.right(unit), `_`=left(DecodingError{"expected a unit value"})}
          stripped)

## Extract an either value from a term, applying functions to the left and right values
term eitherTerm =
  λleftFun,rightFun,graph,term0.eithers.bind
      (stripAndDereferenceTerm graph term0)
      (λ`term`.cases(Term){
          `either`=λet.eithers.either
                (λl.eithers.map (λx.left(x)) (leftFun l))
                (λr.eithers.map (λx.right(x)) (rightFun r))
                et,
          `_`=left(Error{
              extraction = ExtractionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "either value",
                  actual = model.term `term`}}})}
          `term`)

## Extract the left and right types from an either type
term eitherType =
  λtyp.
    let stripped := deannotateType typ
    in cases(Type){
      `either`=λet.right(et),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "either type",
              actual = model.type typ}}})}
      stripped

## Extract a field value from a list of fields
term field =
  λfname,mapping,graph,fields.
    let matchingFields := lists.filter
        (λf.equal (Name[] (Field[name] f)) (Name[] fname))
        fields in
    let noMatchErr := left(Error{
        extraction = ExtractionError{
          unexpectedShape = UnexpectedShapeError{
            expected = strings.concat2 "field " (Name[] fname),
            actual = "no matching field"}}}) in
    ifElse
      (lists.isEmpty matchingFields)
      noMatchErr
      (ifElse
        (equal (lists.length matchingFields) 1:int32)
        (match
          (lists.head matchingFields)
          noMatchErr
          (λmf.eithers.bind
              (stripAndDereferenceTerm graph (Field[`term`] mf))
              (λstripped.mapping stripped)))
        left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "single field",
              actual = strings.concat2
                  "multiple fields named "
                  (Name[] fname)}}}))

## Extract a 32-bit floating-point value from a term
term float32 = λgraph,t.eithers.bind (literal graph t) (λl.eithers.bind (floatLiteral l) (λf.float32Value f))

## Extract a float32 value from a FloatValue
term float32Value =
  λv.cases(FloatValue){
      `float32`=λf.right(f),
      `_`=left(Error{
          extraction = ExtractionError{
            unexpectedShape = UnexpectedShapeError{
              expected = "float32",
              actual = model.float v}}})}
      v

