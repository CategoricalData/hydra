>term satisfy = (λpred.let parse := λinput.optionals.match (lists.uncons (parsing.ParseInput[codepoints] input)) parsing.ParseResult{failure = parsing.ParseError{message = "unexpected end of input", remainder = input}} (λuc.let c := pairs.first uc in let rest := pairs.second uc in logic.ifElse (pred c) parsing.ParseResult{success = parsing.ParseSuccess{value = c, remainder = parsing.ParseInput{offset = math.add (parsing.ParseInput[offset] input) 1:int32, tokenEnd = parsing.ParseInput[tokenEnd] input, codepoints = rest}}} parsing.ParseResult{failure = parsing.ParseError{message = "character did not satisfy predicate", remainder = input}}) in wrap(parsing.Parser){parse})@{description="Parse a character (codepoint) that satisfies the given predicate"}
