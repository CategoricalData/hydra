>term alt = (λp1.λp2.let parse := λinput.cases(parsing.ParseResult){success=λs.parsing.ParseResult{success = s}, failure=λe.logic.ifElse (equality.equal (parsing.ParseInput[offset] (parsing.ParseError[remainder] e)) (parsing.ParseInput[offset] input)) (parsing.Parser[] p2 input) parsing.ParseResult{failure = e}} (parsing.Parser[] p1 input) in wrap(parsing.Parser){parse})@{description="Try the first parser; if it fails without consuming input, try the second"}
