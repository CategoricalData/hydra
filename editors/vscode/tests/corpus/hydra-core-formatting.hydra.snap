>## A helper which maps the first letter of a string to another string
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term mapFirstLetter = λmapping,s.logic.ifElse (strings.isEmpty s) s (let `list` := strings.toList s in optionals.withDefault s (optionals.map (λuc.let firstLetter := mapping (strings.fromList (lists.singleton (pairs.first uc))) in strings.concat2 firstLetter (strings.fromList (pairs.second uc))) (lists.uncons `list`)))
