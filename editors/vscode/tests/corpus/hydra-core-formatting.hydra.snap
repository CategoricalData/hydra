>
>## A simple soft line wrap which is suitable for code comments
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term wrapLine = λmaxlen,input.let helper := λprev,rem.let trunc := lists.take maxlen rem, spanResult := lists.span (λc.logic.and (logic.not (equality.equal c 32:int32)) (logic.not (equality.equal c 9:int32))) (lists.reverse trunc), prefix := lists.reverse (pairs.second spanResult), suffix := lists.reverse (pairs.first spanResult) in logic.ifElse (ordering.lte (lists.length rem) maxlen) (lists.reverse (lists.cons rem prev)) (logic.ifElse (lists.isEmpty prefix) (helper (lists.cons trunc prev) (lists.drop maxlen rem)) (optionals.withDefault (helper (lists.cons trunc prev) (lists.drop maxlen rem)) (optionals.map (λpfxInit.helper (lists.cons pfxInit prev) (lists.concat2 suffix (lists.drop maxlen rem))) (lists.init prefix)))) in strings.fromList (lists.join [10:int32] (helper [] (strings.toList input)))
