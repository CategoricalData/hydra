>## Normalize a comment string for consistent output across coders
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term normalizeComment = λs.let stripped := stripLeadingAndTrailingWhitespace s in logic.ifElse (strings.isEmpty stripped) "" (let lastIdx := math.sub (strings.length stripped) 1:int32 in let appended := strings.concat2 stripped "." in optionals.match (strings.charAt lastIdx stripped) appended (λlastChar.logic.ifElse (equality.equal lastChar 46:int32) stripped appended))
