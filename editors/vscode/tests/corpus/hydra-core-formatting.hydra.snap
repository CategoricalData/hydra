>term mapFirstLetter = (λmapping.λs.logic.ifElse (strings.isEmpty s) s (let `list` := strings.toList s in optionals.withDefault s (optionals.map (λuc.let firstLetter := mapping (strings.fromList (lists.singleton (pairs.first uc))) in strings.concat2 firstLetter (strings.fromList (pairs.second uc))) (lists.uncons `list`))))@{description="A helper which maps the first letter of a string to another string"}
