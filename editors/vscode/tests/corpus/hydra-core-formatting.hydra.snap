>term convertCaseCamelOrUnderscoreToLowerSnake = (λs.let parts := strings.splitOn "_" s in let snakeParts := lists.map (λp.convertCaseCamelToLowerSnake p) parts in strings.join "_" snakeParts)@{description="Convert a string from camel case (possibly with underscores) to lower snake case. Splits on underscores first, then converts each part from camel case."}
