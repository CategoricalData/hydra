>term capitalize = (mapFirstLetter strings.toUpper)@{description="Capitalize the first letter of a string"}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^ source.hydra entity.name.function.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.equals.hydra
#                 ^^ source.hydra
#                   ^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                 ^ source.hydra
#                                  ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                 ^ source.hydra
#                                                  ^ source.hydra keyword.operator.annotation.hydra
#                                                   ^ source.hydra
