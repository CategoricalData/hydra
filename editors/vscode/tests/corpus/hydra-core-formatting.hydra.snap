>
>## Convert a string from camel case (possibly with underscores) to lower snake case. Splits on underscores first, then converts each part from camel case.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term convertCaseCamelOrUnderscoreToLowerSnake = λs.let parts := strings.splitOn "_" s in let snakeParts := lists.map (λp.convertCaseCamelToLowerSnake p) parts in strings.join "_" snakeParts
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                                             ^ source.hydra
#                                              ^ source.hydra keyword.operator.equals.hydra
#                                               ^ source.hydra
#                                                ^ source.hydra keyword.operator.lambda.hydra
#                                                 ^ source.hydra variable.parameter.hydra
#                                                  ^ source.hydra punctuation.separator.binder.hydra
#                                                   ^^^ source.hydra keyword.control.hydra
#                                                      ^ source.hydra
#                                                       ^^^^^ source.hydra variable.other.hydra
#                                                            ^ source.hydra
#                                                             ^^ source.hydra keyword.operator.assignment.hydra
#                                                               ^ source.hydra
#                                                                ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                               ^ source.hydra
#                                                                                ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                                 ^ source.hydra string.quoted.double.hydra
#                                                                                  ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                   ^ source.hydra
#                                                                                    ^ source.hydra variable.other.hydra
#                                                                                     ^ source.hydra
#                                                                                      ^^ source.hydra keyword.control.hydra
#                                                                                        ^ source.hydra
#                                                                                         ^^^ source.hydra keyword.control.hydra
#                                                                                            ^ source.hydra
#                                                                                             ^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                                       ^ source.hydra
#                                                                                                        ^^ source.hydra keyword.operator.assignment.hydra
#                                                                                                          ^ source.hydra
#                                                                                                           ^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                                                                    ^^ source.hydra
#                                                                                                                      ^ source.hydra keyword.operator.lambda.hydra
#                                                                                                                       ^ source.hydra variable.parameter.hydra
#                                                                                                                        ^ source.hydra punctuation.separator.binder.hydra
#                                                                                                                         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                                                                                     ^ source.hydra
#                                                                                                                                                      ^ source.hydra variable.other.hydra
#                                                                                                                                                       ^^ source.hydra
#                                                                                                                                                         ^^^^^ source.hydra variable.other.hydra
#                                                                                                                                                              ^ source.hydra
#                                                                                                                                                               ^^ source.hydra keyword.control.hydra
#                                                                                                                                                                 ^ source.hydra
#                                                                                                                                                                  ^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                                                                                                                              ^ source.hydra
#                                                                                                                                                                               ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                                                                                                                                ^ source.hydra string.quoted.double.hydra
#                                                                                                                                                                                 ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                                                                                                                  ^ source.hydra
#                                                                                                                                                                                   ^^^^^^^^^^ source.hydra variable.other.hydra
>
>## Convert a string from camel case to lower snake case
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term convertCaseCamelToLowerSnake = convertCase util.CaseConvention{camel} util.CaseConvention{lowerSnake}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                                 ^ source.hydra
#                                  ^ source.hydra keyword.operator.equals.hydra
#                                   ^ source.hydra
#                                    ^^^^^^^^^^^ source.hydra variable.other.hydra
#                                               ^ source.hydra
#                                                ^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                                   ^ source.hydra
#                                                                    ^^^^^ source.hydra variable.other.hydra
#                                                                         ^^ source.hydra
#                                                                           ^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                                                              ^ source.hydra
#                                                                                               ^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                                         ^^ source.hydra
>
>## Convert a string from camel case to upper snake case
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term convertCaseCamelToUpperSnake = convertCase util.CaseConvention{camel} util.CaseConvention{upperSnake}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                                 ^ source.hydra
#                                  ^ source.hydra keyword.operator.equals.hydra
#                                   ^ source.hydra
#                                    ^^^^^^^^^^^ source.hydra variable.other.hydra
#                                               ^ source.hydra
#                                                ^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                                   ^ source.hydra
#                                                                    ^^^^^ source.hydra variable.other.hydra
#                                                                         ^^ source.hydra
#                                                                           ^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                                                              ^ source.hydra
#                                                                                               ^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                                         ^^ source.hydra
>
>## Convert a string from pascal case to upper snake case
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term convertCasePascalToUpperSnake = convertCase util.CaseConvention{pascal} util.CaseConvention{upperSnake}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                                  ^ source.hydra
#                                   ^ source.hydra keyword.operator.equals.hydra
#                                    ^ source.hydra
#                                     ^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                ^ source.hydra
#                                                 ^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                                    ^ source.hydra
#                                                                     ^^^^^^ source.hydra variable.other.hydra
#                                                                           ^^ source.hydra
#                                                                             ^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                                                                ^ source.hydra
#                                                                                                 ^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                                           ^^ source.hydra
>
>## Decapitalize the first letter of a string
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term decapitalize = mapFirstLetter strings.toLower
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                 ^ source.hydra
#                  ^ source.hydra keyword.operator.equals.hydra
#                   ^ source.hydra
#                    ^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                  ^ source.hydra
#                                   ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
>
>## Escape reserved words by appending an underscore
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term escapeWithUnderscore = λreserved,s.logic.ifElse (sets.member s reserved) (strings.concat2 s "_") s
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                         ^ source.hydra
#                          ^ source.hydra keyword.operator.equals.hydra
#                           ^ source.hydra
#                            ^ source.hydra keyword.operator.lambda.hydra
#                             ^^^^^^^^ source.hydra variable.parameter.hydra
#                                     ^ source.hydra punctuation.separator.binder.hydra
#                                      ^ source.hydra variable.parameter.hydra
#                                       ^ source.hydra punctuation.separator.binder.hydra
