>## Replace special characters with their alphanumeric aliases
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term withCharacterAliases = λoriginal.let aliases := maps.fromList [(32:int32, "sp"), (33:int32, "excl"), (34:int32, "quot"), (35:int32, "num"), (36:int32, "dollar"), (37:int32, "percnt"), (38:int32, "amp"), (39:int32, "apos"), (40:int32, "lpar"), (41:int32, "rpar"), (42:int32, "ast"), (43:int32, "plus"), (44:int32, "comma"), (45:int32, "minus"), (46:int32, "period"), (47:int32, "sol"), (58:int32, "colon"), (59:int32, "semi"), (60:int32, "lt"), (61:int32, "equals"), (62:int32, "gt"), (63:int32, "quest"), (64:int32, "commat"), (91:int32, "lsqb"), (92:int32, "bsol"), (93:int32, "rsqb"), (94:int32, "circ"), (95:int32, "lowbar"), (96:int32, "grave"), (123:int32, "lcub"), (124:int32, "verbar"), (125:int32, "rcub"), (126:int32, "tilde")], alias := λc.optionals.withDefault (lists.singleton c) (optionals.map strings.toList (maps.lookup c aliases)) in strings.fromList (lists.filter chars.isAlphaNum (lists.concat (lists.map alias (strings.toList original))))
