## Functions for generating domain-specific DSL modules from type modules
module hydra.core.dsls

import hydra.core.annotations
import hydra.core.coders
import hydra.core.constants
import hydra.core.decode.model as decode.model
import hydra.core.encode.model as encode.model
import hydra.core.errors
import hydra.core.formatting
import hydra.core.lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.names
import hydra.core.packaging
import hydra.core.reflect
import hydra.core.rewriting
import hydra.core.scoping
import hydra.core.strip
import hydra.core.typing
import hydra.core.variants

## Collect forall type variable names from a type
term collectForallVars =
  λtyp.cases(Type){
      annotated=λat.collectForallVars (AnnotatedType[body] at),
      `forall`=λft.lists.cons (ForallType[parameter] ft) (collectForallVars (ForallType[body] ft)),
      `_`=[]}
      typ

## Deduplicate bindings by appending numeric suffixes to duplicate names
term deduplicateBindings =
  λbindings.lists.foldl
      (λacc,b.
        let usedNames := sets.fromList (lists.map (λa.Binding[name] a) acc) in
        let uniqueName := chooseUniqueName usedNames (Binding[name] b) in
        lists.concat2
          acc
          [Binding{name = uniqueName, `term` = Binding[`term`] b, typeScheme = Binding[typeScheme] b}])
      []
      bindings

## Generate a binding name for a DSL function from a type name
term dslBindingName = derivedBindingName ["dsl"] false

## Generate a qualified DSL element name from a type name and local element name
term dslDefinitionName = derivedDefinitionName ["dsl"] false true

## Transform a source module into a DSL module
term dslModule =
  λcx,graph,mod.eithers.bind
      (filterTypeBindings
        cx
        graph
        (optionals.givens
          (lists.map
            (λd.cases(Definition){
                `type`=λtd.given((λname,typ.
                      let schemaTerm := Term{
                        variable = Name{"hydra.core.model.Type"}} in
                      let dataTerm := normalizeTermAnnotations
                          Term{
                            annotated = AnnotatedTerm{
                              body = encode.model.type typ,
                              annotation = wrapAnnotationMap
                                  (maps.fromList [(keyType, schemaTerm)])}} in
                      Binding{
                        name = name,
                        `term` = dataTerm,
                        typeScheme = given(TypeScheme{
                            variables = [],
                            body = Type{
                              variable = Name{"hydra.core.model.Type"}},
                            constraints = maps.empty})})
                      (TypeDefinition[name] td)
                      (TypeScheme[body] (TypeDefinition[body] td))),
                `_`=none}
                d)
            (Module[definitions] mod))))
      (λtypeBindings.eithers.bind
          (eithers.mapList
            (λb.eithers.bimap
                (λ`_e`.Error{decoding = `_e`})
                (λx.x)
                (generateBindingsForType cx graph b))
            typeBindings)
          (λtypeDslBindings.eithers.bind
              (eithers.mapList (λd.generateRefBindings d) (Module[definitions] mod))
              (λrefDslBindings.
                let allBindings := deduplicateBindings
                    (lists.concat2
                      (lists.concat typeDslBindings)
                      (lists.concat refDslBindings))
                in ifElse
                  (lists.isEmpty allBindings)
                  right(none)
                  right(given(Module{
                    name = dslModuleName (Module[name] mod),
                    metadata = given(EntityMetadata{
                        description = given(strings.concat
                            ["DSL functions for ", ModuleName[] (Module[name] mod)]),
                        comments = [],
                        seeAlso = [],
                        lifecycle = none,
                        provisions = []}),
                    dependencies = lists.map
                        (λns.ModuleDependency{
                            `module` = ns,
                            package = none})
                        (lists.distinct
                          (lists.concat2
                            [
                              Module[name] mod,
                              ModuleName{"hydra.core.typed"},
                              derivedModuleName ["encode"] true (Module[name] mod),
                              derivedModuleName ["decode"] true (Module[name] mod)]
                            (lists.concat2
                              (lists.map
                                (λdep.ModuleDependency[`module`] dep)
                                (Module[dependencies] mod))
                              (lists.map
                                dslModuleName
                                (lists.map
                                  (λdep.ModuleDependency[`module`] dep)
                                  (Module[dependencies] mod)))))),
                    definitions = lists.map
                        (λb.Definition{
                            `term` = TermDefinition{
                              name = Binding[name] b,
                              metadata = none,
                              signature = optionals.map
                                  typeSchemeToTermSignature
                                  (Binding[typeScheme] b),
                              body = Binding[`term`] b}})
                        allBindings})))))

## Generate a DSL module name from a source module name
term dslModuleName = derivedModuleName ["dsl"] false

## Build a TypedTerm-wrapped TypeScheme (functions of phantom terms) from a TermSignature
term dslSignatureTypeScheme =
  λsig.
    let typeVars := lists.map (λtp.TypeParameter[name] tp) (TermSignature[typeParameters] sig) in
    let paramTypes := lists.map (λp.Parameter[`type`] p) (TermSignature[parameters] sig) in
    let resultType := Result[`type`] (TermSignature[result] sig) in
    let wrappedResult := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = resultType}} in
    let funType := lists.foldr
        (λparamType,acc.Type{
            function = FunctionType{
              domain = ifElse
                  ((λt.cases(Type){
                      application=λa.cases(Type){
                            variable=λv.equal
                                  v
                                  Name{"hydra.core.typed.TypedName"},
                            `_`=false}
                            (deannotateType
                              (ApplicationType[function] a)),
                      `_`=false}
                      (deannotateType t))
                    (deannotateType paramType))
                  paramType
                  Type{
                    application = ApplicationType{
                      function = Type{
                        variable = Name{"hydra.core.typed.TypedTerm"}},
                      argument = paramType}},
              codomain = acc}})
        wrappedResult
        paramTypes in
    TypeScheme{variables = typeVars, body = funType, constraints = maps.empty}

## Build a TypeScheme with TypedTerm-wrapped parameter and result types
term dslTypeScheme =
  λorigType,paramTypes,resultType.
    let typeVars := collectForallVars origType in
    let wrappedResult := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = resultType}} in
    let funType := lists.foldr
        (λparamType,acc.Type{
            function = FunctionType{
              domain = Type{
                application = ApplicationType{
                  function = Type{
                    variable = Name{"hydra.core.typed.TypedTerm"}},
                  argument = paramType}},
              codomain = acc}})
        wrappedResult
        paramTypes in
    TypeScheme{variables = typeVars, body = funType, constraints = maps.empty}

## Filter bindings to only DSL-eligible type definitions
term filterTypeBindings =
  λcx,graph,bindings.eithers.map
      optionals.givens
      (eithers.mapList (isDslEligibleBinding cx graph) (lists.filter isNativeType bindings))

## Generate all DSL bindings for a type binding
term generateBindingsForType =
  λcx,graph,b.
    let typeName := Binding[name] b
    in eithers.bind
      (decode.model.type graph (Binding[`term`] b))
      (λrawType.
        let typ := deannotateTypeParameters (deannotateType rawType)
        in right(cases(Type){
          `record`=λfts.lists.concat
                [
                  [generateTypeNameToken rawType typeName],
                  generateParametricRefBuilders rawType typeName,
                  generateRecordConstructor rawType typeName fts,
                  lists.map (generateRecordAccessor rawType typeName) fts,
                  lists.map (generateRecordWithUpdater rawType typeName fts) fts],
          `union`=λfts.lists.concat
                [
                  [generateTypeNameToken rawType typeName],
                  generateParametricRefBuilders rawType typeName,
                  lists.map (generateUnionInjector rawType typeName) fts],
          `wrap`=λinnerType.lists.concat
                [
                  [generateTypeNameToken rawType typeName],
                  generateParametricRefBuilders rawType typeName,
                  generateWrappedTypeAccessors rawType typeName innerType],
          `_`=[]}
          typ))

## Generate encode/decode composition builders for a parametric type definition
term generateParametricRefBuilders =
  λorigType,typeName.
    let vars := collectForallVars origType
    in ifElse
      (lists.isEmpty vars)
      []
      [
        let vars := collectForallVars origType in
        let localName := localNameOf typeName in
        let builderLocalName := strings.concat ["encode", localName] in
        let builderName := dslDefinitionName typeName builderLocalName in
        let refName := derivedBindingName ["encode"] true typeName in
        let paramPairs := lists.map
            (λv.(
                Name[] v,
                Type{
                  application = ApplicationType{
                    function = Type{variable = Name{"hydra.core.typed.TypedTerm"}},
                    argument = Type{
                      function = FunctionType{
                        domain = Type{variable = v},
                        codomain = Type{
                          variable = Name{"hydra.core.model.Term"}}}}}}))
            vars in
        let appBody := lists.foldl
            (λacc,pp.Term{
                `inject` = Injection{
                  typeName = Name{"hydra.core.model.Term"},
                  field = Field{
                    name = Name{"application"},
                    `term` = Term{
                      `record` = Record{
                        typeName = Name{"hydra.core.model.Application"},
                        fields = [
                          Field{name = Name{"function"}, `term` = acc},
                          Field{
                            name = Name{"argument"},
                            `term` = Term{
                              application = Application{
                                function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                                argument = Term{variable = Name{first pp}}}}}]}}}}})
            Term{
              `inject` = Injection{
                typeName = Name{"hydra.core.model.Term"},
                field = Field{
                  name = Name{"variable"},
                  `term` = Term{
                    `wrap` = WrappedTerm{
                      typeName = Name{"hydra.core.model.Name"},
                      body = Term{
                        literal = Literal{
                          `string` = Name[] refName}}}}}}}
            paramPairs in
        let builderTerm := Term{`wrap` = WrappedTerm{typeName = Name{"hydra.core.typed.TypedTerm"}, body = appBody}} in
        let rawBody := lists.foldl
            (λacc,pp.Term{lambda = Lambda{parameter = Name{first pp}, domain = given(second pp), body = acc}})
            builderTerm
            (lists.reverse paramPairs) in
        let description := strings.concat ["DSL composition builder for the ", "encode", "r of ", Name[] typeName] in
        let body := setTermDescription given(description) rawBody in
        let resultType := nominalResultType typeName origType in
        let paramTypes := lists.map
            (λv.Type{
                function = FunctionType{
                  domain = Type{variable = v},
                  codomain = Type{variable = Name{"hydra.core.model.Term"}}}})
            vars in
        let ts := dslTypeScheme
            origType
            paramTypes
            Type{
              function = FunctionType{
                domain = resultType,
                codomain = Type{variable = Name{"hydra.core.model.Term"}}}} in
        Binding{name = builderName, `term` = body, typeScheme = given(ts)},
        let vars := collectForallVars origType in
        let localName := localNameOf typeName in
        let builderLocalName := strings.concat ["decode", localName] in
        let builderName := dslDefinitionName typeName builderLocalName in
        let refName := derivedBindingName ["decode"] true typeName in
        let paramPairs := lists.map
            (λv.(
                Name[] v,
                Type{
                  application = ApplicationType{
                    function = Type{variable = Name{"hydra.core.typed.TypedTerm"}},
                    argument = Type{
                      function = FunctionType{
                        domain = Type{
                          variable = Name{"hydra.core.graph.Graph"}},
                        codomain = Type{
                          function = FunctionType{
                            domain = Type{
                              variable = Name{"hydra.core.model.Term"}},
                            codomain = Type{
                              `either` = EitherType{
                                `left` = Type{
                                  variable = Name{"hydra.core.errors.DecodingError"}},
                                `right` = Type{
                                  variable = v}}}}}}}}}))
            vars in
        let appBody := lists.foldl
            (λacc,pp.Term{
                `inject` = Injection{
                  typeName = Name{"hydra.core.model.Term"},
                  field = Field{
                    name = Name{"application"},
                    `term` = Term{
                      `record` = Record{
                        typeName = Name{"hydra.core.model.Application"},
                        fields = [
                          Field{name = Name{"function"}, `term` = acc},
                          Field{
                            name = Name{"argument"},
                            `term` = Term{
                              application = Application{
                                function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                                argument = Term{variable = Name{first pp}}}}}]}}}}})
            Term{
              `inject` = Injection{
                typeName = Name{"hydra.core.model.Term"},
                field = Field{
                  name = Name{"variable"},
                  `term` = Term{
                    `wrap` = WrappedTerm{
                      typeName = Name{"hydra.core.model.Name"},
                      body = Term{
                        literal = Literal{
                          `string` = Name[] refName}}}}}}}
            paramPairs in
        let builderTerm := Term{`wrap` = WrappedTerm{typeName = Name{"hydra.core.typed.TypedTerm"}, body = appBody}} in
        let rawBody := lists.foldl
            (λacc,pp.Term{lambda = Lambda{parameter = Name{first pp}, domain = given(second pp), body = acc}})
            builderTerm
            (lists.reverse paramPairs) in
        let description := strings.concat ["DSL composition builder for the ", "decode", "r of ", Name[] typeName] in
        let body := setTermDescription given(description) rawBody in
        let resultType := nominalResultType typeName origType in
        let paramTypes := lists.map
            (λv.Type{
                function = FunctionType{
                  domain = Type{variable = Name{"hydra.core.graph.Graph"}},
                  codomain = Type{
                    function = FunctionType{
                      domain = Type{
                        variable = Name{"hydra.core.model.Term"}},
                      codomain = Type{
                        `either` = EitherType{
                          `left` = Type{
                            variable = Name{"hydra.core.errors.DecodingError"}},
                          `right` = Type{
                            variable = v}}}}}}})
            vars in
        let ts := dslTypeScheme
            origType
            paramTypes
            Type{
              function = FunctionType{
                domain = Type{variable = Name{"hydra.core.graph.Graph"}},
                codomain = Type{
                  function = FunctionType{
                    domain = Type{
                      variable = Name{"hydra.core.model.Term"}},
                    codomain = Type{
                      `either` = EitherType{
                        `left` = Type{
                          variable = Name{"hydra.core.errors.DecodingError"}},
                        `right` = resultType}}}}}} in
        Binding{name = builderName, `term` = body, typeScheme = given(ts)}]

## Generate a record field accessor function
term generateRecordAccessor =
  λorigType,typeName,ft.
    let fieldName := FieldType[name] ft in
    let accessorLocalName := strings.concat
        [
          decapitalize (localNameOf typeName),
          strings.join "" (lists.map (λs.capitalize s) (strings.splitOn "." (Name[] fieldName)))] in
    let accessorName := dslDefinitionName typeName accessorLocalName in
    let paramDomain := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = nominalResultType typeName origType}} in
    let rawBody := Term{
      lambda = Lambda{
        parameter = Name{"x"},
        domain = given(paramDomain),
        body = Term{
          `wrap` = WrappedTerm{
            typeName = Name{"hydra.core.typed.TypedTerm"},
            body = Term{
              `inject` = Injection{
                typeName = Name{"hydra.core.model.Term"},
                field = Field{
                  name = Name{"application"},
                  `term` = Term{
                    `record` = Record{
                      typeName = Name{"hydra.core.model.Application"},
                      fields = [
                        Field{
                          name = Name{"function"},
                          `term` = Term{
                            `inject` = Injection{
                              typeName = Name{"hydra.core.model.Term"},
                              field = Field{
                                name = Name{"project"},
                                `term` = Term{
                                  `record` = Record{
                                    typeName = Name{"hydra.core.model.Projection"},
                                    fields = [
                                      Field{
                                        name = Name{"typeName"},
                                        `term` = Term{
                                          `wrap` = WrappedTerm{
                                            typeName = Name{"hydra.core.model.Name"},
                                            body = Term{literal = Literal{`string` = Name[] typeName}}}}},
                                      Field{
                                        name = Name{"fieldName"},
                                        `term` = Term{
                                          `wrap` = WrappedTerm{
                                            typeName = Name{"hydra.core.model.Name"},
                                            body = Term{literal = Literal{`string` = Name[] fieldName}}}}}]}}}}}},
                        Field{
                          name = Name{"argument"},
                          `term` = Term{
                            application = Application{
                              function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                              argument = Term{variable = Name{"x"}}}}}]}}}}}}}}} in
    let description := strings.concat
        ["DSL accessor for the ", Name[] fieldName, " field of ", Name[] typeName] in
    let body := setTermDescription given(description) rawBody in
    let ts := dslTypeScheme origType [nominalResultType typeName origType] (FieldType[`type`] ft) in
    Binding{name = accessorName, `term` = body, typeScheme = given(ts)}

## Generate a record constructor function
term generateRecordConstructor =
  λorigType,typeName,fieldTypes.
    let dFields := lists.map
        (λft.Term{
            `record` = Record{
              typeName = Name{"hydra.core.model.Field"},
              fields = [
                Field{
                  name = Name{"name"},
                  `term` = Term{
                    `wrap` = WrappedTerm{
                      typeName = Name{"hydra.core.model.Name"},
                      body = Term{literal = Literal{`string` = Name[] (FieldType[name] ft)}}}}},
                Field{
                  name = Name{"term"},
                  `term` = Term{
                    application = Application{
                      function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                      argument = Term{
                        variable = Name{decapitalize
                          (localNameOf (FieldType[name] ft))}}}}}]}})
        fieldTypes in
    let recordTerm := Term{
      `wrap` = WrappedTerm{
        typeName = Name{"hydra.core.typed.TypedTerm"},
        body = Term{
          `inject` = Injection{
            typeName = Name{"hydra.core.model.Term"},
            field = Field{
              name = Name{"record"},
              `term` = Term{
                `record` = Record{
                  typeName = Name{"hydra.core.model.Record"},
                  fields = [
                    Field{
                      name = Name{"typeName"},
                      `term` = Term{
                        `wrap` = WrappedTerm{
                          typeName = Name{"hydra.core.model.Name"},
                          body = Term{literal = Literal{`string` = Name[] typeName}}}}},
                    Field{name = Name{"fields"}, `term` = Term{`list` = dFields}}]}}}}}}} in
    let paramPairs := lists.map
        (λft.(
            decapitalize (localNameOf (FieldType[name] ft)),
            Type{
              application = ApplicationType{
                function = Type{variable = Name{"hydra.core.typed.TypedTerm"}},
                argument = FieldType[`type`] ft}}))
        fieldTypes in
    let rawBody := lists.foldl
        (λacc,pp.Term{
            lambda = Lambda{
              parameter = Name{first pp},
              domain = given(second pp),
              body = acc}})
        recordTerm
        (lists.reverse paramPairs) in
    let description := strings.concat ["DSL constructor for ", Name[] typeName] in
    let body := setTermDescription given(description) rawBody in
    let paramTypes := lists.map (λft.FieldType[`type`] ft) fieldTypes in
    let resultType := nominalResultType typeName origType in
    let ts := dslTypeScheme origType paramTypes resultType in
    [Binding{name = dslBindingName typeName, `term` = body, typeScheme = given(ts)}]

## Generate a withXxx record field updater function
term generateRecordWithUpdater =
  λorigType,typeName,allFields,targetField.
    let targetFieldName := FieldType[name] targetField in
    let updaterLocalName := strings.concat
        [
          decapitalize (localNameOf typeName),
          "With",
          strings.join "" (lists.map (λs.capitalize s) (strings.splitOn "." (Name[] targetFieldName)))] in
    let updaterName := dslDefinitionName typeName updaterLocalName in
    let dFields := lists.map
        (λft.Term{
            `record` = Record{
              typeName = Name{"hydra.core.model.Field"},
              fields = [
                Field{
                  name = Name{"name"},
                  `term` = Term{
                    `wrap` = WrappedTerm{
                      typeName = Name{"hydra.core.model.Name"},
                      body = Term{literal = Literal{`string` = Name[] (FieldType[name] ft)}}}}},
                Field{
                  name = Name{"term"},
                  `term` = ifElse
                      (equal (Name[] (FieldType[name] ft)) (Name[] targetFieldName))
                      Term{
                        application = Application{
                          function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                          argument = Term{variable = Name{"newVal"}}}}
                      Term{
                        `inject` = Injection{
                          typeName = Name{"hydra.core.model.Term"},
                          field = Field{
                            name = Name{"application"},
                            `term` = Term{
                              `record` = Record{
                                typeName = Name{"hydra.core.model.Application"},
                                fields = [
                                  Field{
                                    name = Name{"function"},
                                    `term` = Term{
                                      `inject` = Injection{
                                        typeName = Name{"hydra.core.model.Term"},
                                        field = Field{
                                          name = Name{"project"},
                                          `term` = Term{
                                            `record` = Record{
                                              typeName = Name{"hydra.core.model.Projection"},
                                              fields = [
                                                Field{
                                                  name = Name{"typeName"},
                                                  `term` = Term{
                                                    `wrap` = WrappedTerm{
                                                      typeName = Name{"hydra.core.model.Name"},
                                                      body = Term{literal = Literal{`string` = Name[] typeName}}}}},
                                                Field{
                                                  name = Name{"fieldName"},
                                                  `term` = Term{
                                                    `wrap` = WrappedTerm{
                                                      typeName = Name{"hydra.core.model.Name"},
                                                      body = Term{literal = Literal{`string` = Name[] (FieldType[name] ft)}}}}}]}}}}}},
                                  Field{
                                    name = Name{"argument"},
                                    `term` = Term{
                                      application = Application{
                                        function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                                        argument = Term{variable = Name{"original"}}}}}]}}}}}}]}})
        allFields in
    let recDomain := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = nominalResultType typeName origType}} in
    let fieldDomain := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = FieldType[`type`] targetField}} in
    let rawBody := Term{
      lambda = Lambda{
        parameter = Name{"original"},
        domain = given(recDomain),
        body = Term{
          lambda = Lambda{
            parameter = Name{"newVal"},
            domain = given(fieldDomain),
            body = Term{
              `wrap` = WrappedTerm{
                typeName = Name{"hydra.core.typed.TypedTerm"},
                body = Term{
                  `inject` = Injection{
                    typeName = Name{"hydra.core.model.Term"},
                    field = Field{
                      name = Name{"record"},
                      `term` = Term{
                        `record` = Record{
                          typeName = Name{"hydra.core.model.Record"},
                          fields = [
                            Field{
                              name = Name{"typeName"},
                              `term` = Term{
                                `wrap` = WrappedTerm{
                                  typeName = Name{"hydra.core.model.Name"},
                                  body = Term{literal = Literal{`string` = Name[] typeName}}}}},
                            Field{name = Name{"fields"}, `term` = Term{`list` = dFields}}]}}}}}}}}}}} in
    let description := strings.concat
        ["DSL updater for the ", Name[] targetFieldName, " field of ", Name[] typeName] in
    let body := setTermDescription given(description) rawBody in
    let recType := nominalResultType typeName origType in
    let ts := dslTypeScheme
        origType
        [recType, FieldType[`type`] targetField]
        recType in
    Binding{name = updaterName, `term` = body, typeScheme = given(ts)}

## Generate typed reference DSL bindings for a primitive (or signature-carrying term) definition
term generateRefBindings =
  λd.cases(Definition){
      `type`=λ`_`.right([]),
      `term`=λtd.optionals.match
            (TermDefinition[signature] td)
            right([])
            (λsig.ifElse
                (signatureIsVoidFree sig)
                right([generateSignatureRef (TermDefinition[name] td) sig])
                right([])),
      `primitive`=λpd.ifElse
            (signatureIsVoidFree (PrimitiveDefinition[signature] pd))
            right([generateSignatureRef (PrimitiveDefinition[name] pd) (PrimitiveDefinition[signature] pd)])
            right([]),
      `_`=right([])}
      d

## Generate a typed-reference DSL wrapper from a term/primitive name and signature
term generateSignatureRef =
  λrefName,sig.
    let params := TermSignature[parameters] sig in
    let paramFlags := lists.map
        (λp.(
            Name[] (Parameter[name] p),
            (λt.cases(Type){
                application=λa.cases(Type){variable=λv.equal v Name{"hydra.core.typed.TypedName"}, `_`=false}
                      (deannotateType (ApplicationType[function] a)),
                `_`=false}
                (deannotateType t))
              (deannotateType (Parameter[`type`] p))))
        params in
    let paramPairs := lists.map
        (λp.
          let pt := Parameter[`type`] p
          in (
            Name[] (Parameter[name] p),
            ifElse
              ((λt.cases(Type){
                  application=λa.cases(Type){variable=λv.equal v Name{"hydra.core.typed.TypedName"}, `_`=false}
                        (deannotateType (ApplicationType[function] a)),
                  `_`=false}
                  (deannotateType t))
                (deannotateType pt))
              pt
              Type{application = ApplicationType{function = Type{variable = Name{"hydra.core.typed.TypedTerm"}}, argument = pt}}))
        params in
    let appBody := lists.foldl
        (λacc,pf.Term{
            `inject` = Injection{
              typeName = Name{"hydra.core.model.Term"},
              field = Field{
                name = Name{"application"},
                `term` = Term{
                  `record` = Record{
                    typeName = Name{"hydra.core.model.Application"},
                    fields = [
                      Field{name = Name{"function"}, `term` = acc},
                      Field{
                        name = Name{"argument"},
                        `term` = ifElse
                            (second pf)
                            Term{
                              `inject` = Injection{
                                typeName = Name{"hydra.core.model.Term"},
                                field = Field{
                                  name = Name{"variable"},
                                  `term` = Term{
                                    application = Application{
                                      function = Term{
                                        `unwrap` = Name{"hydra.core.typed.TypedName"}},
                                      argument = Term{
                                        variable = Name{first pf}}}}}}}
                            Term{
                              application = Application{
                                function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                                argument = Term{variable = Name{first pf}}}}}]}}}}})
        Term{
          `inject` = Injection{
            typeName = Name{"hydra.core.model.Term"},
            field = Field{
              name = Name{"variable"},
              `term` = Term{
                `wrap` = WrappedTerm{
                  typeName = Name{"hydra.core.model.Name"},
                  body = Term{
                    literal = Literal{
                      `string` = Name[] refName}}}}}}}
        paramFlags in
    let refTerm := Term{`wrap` = WrappedTerm{typeName = Name{"hydra.core.typed.TypedTerm"}, body = appBody}} in
    let rawBody := lists.foldl
        (λacc,pp.Term{
            lambda = Lambda{
              parameter = Name{first pp},
              domain = given(second pp),
              body = acc}})
        refTerm
        (lists.reverse paramPairs) in
    let description := strings.concat ["DSL reference to ", Name[] refName] in
    let body := setTermDescription given(description) rawBody in
    let ts := dslSignatureTypeScheme sig in
    Binding{
      name = dslDefinitionName refName (localNameOf refName),
      `term` = body,
      typeScheme = given(ts)}

## Generate a TypedName token constant for a type definition
term generateTypeNameToken =
  λorigType,typeName.
    let localName := localNameOf typeName in
    let tokenLocalName := strings.concat [decapitalize localName, localName] in
    let tokenName := dslDefinitionName typeName tokenLocalName in
    let description := strings.concat ["DSL name token for ", Name[] typeName] in
    let body := setTermDescription
        given(description)
        Term{
          `wrap` = WrappedTerm{
            typeName = Name{"hydra.core.typed.TypedName"},
            body = Term{
              `wrap` = WrappedTerm{
                typeName = Name{"hydra.core.model.Name"},
                body = Term{
                  literal = Literal{
                    `string` = Name[] typeName}}}}}} in
    let ts := TypeScheme{
      variables = collectForallVars origType,
      body = Type{
        application = ApplicationType{
          function = Type{
            variable = Name{"hydra.core.typed.TypedName"}},
          argument = nominalResultType typeName origType}},
      constraints = maps.empty} in
    Binding{name = tokenName, `term` = body, typeScheme = given(ts)}

## Generate a union injection helper
term generateUnionInjector =
  λorigType,typeName,ft.
    let fieldName := FieldType[name] ft in
    let fieldType := FieldType[`type`] ft in
    let injectorLocalName := strings.concat
        [
          decapitalize (localNameOf typeName),
          strings.join "" (lists.map (λs.capitalize s) (strings.splitOn "." (Name[] fieldName)))] in
    let injectorName := dslDefinitionName typeName injectorLocalName in
    let isUnit := (λt.cases(Type){`unit`=λ`_`.true, `_`=false} (deannotateType t)) fieldType in
    let dFieldValue := ifElse
        isUnit
        Term{
          `inject` = Injection{
            typeName = Name{"hydra.core.model.Term"},
            field = Field{
              name = Name{"unit"},
              `term` = Term{`unit`}}}}
        Term{
          application = Application{
            function = Term{
              `unwrap` = Name{"hydra.core.typed.TypedTerm"}},
            argument = Term{variable = Name{"x"}}}} in
    let injectionTerm := Term{
      `wrap` = WrappedTerm{
        typeName = Name{"hydra.core.typed.TypedTerm"},
        body = Term{
          `inject` = Injection{
            typeName = Name{"hydra.core.model.Term"},
            field = Field{
              name = Name{"inject"},
              `term` = Term{
                `record` = Record{
                  typeName = Name{"hydra.core.model.Injection"},
                  fields = [
                    Field{
                      name = Name{"typeName"},
                      `term` = Term{
                        `wrap` = WrappedTerm{
                          typeName = Name{"hydra.core.model.Name"},
                          body = Term{literal = Literal{`string` = Name[] typeName}}}}},
                    Field{
                      name = Name{"field"},
                      `term` = Term{
                        `record` = Record{
                          typeName = Name{"hydra.core.model.Field"},
                          fields = [
                            Field{
                              name = Name{"name"},
                              `term` = Term{
                                `wrap` = WrappedTerm{
                                  typeName = Name{"hydra.core.model.Name"},
                                  body = Term{literal = Literal{`string` = Name[] fieldName}}}}},
                            Field{name = Name{"term"}, `term` = dFieldValue}]}}}]}}}}}}} in
    let variantDomain := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = FieldType[`type`] ft}} in
    let rawBody := ifElse
        isUnit
        injectionTerm
        Term{
          lambda = Lambda{
            parameter = Name{"x"},
            domain = given(variantDomain),
            body = injectionTerm}} in
    let description := strings.concat
        ["DSL injection for the ", Name[] fieldName, " variant of ", Name[] typeName] in
    let body := setTermDescription given(description) rawBody in
    let unionType := nominalResultType typeName origType in
    let ts := ifElse
        isUnit
        (dslTypeScheme origType [] unionType)
        (dslTypeScheme origType [FieldType[`type`] ft] unionType) in
    Binding{name = injectorName, `term` = body, typeScheme = given(ts)}

## Generate wrap/unwrap accessors for a wrapped type
term generateWrappedTypeAccessors =
  λorigType,typeName,innerType.
    let localName := localNameOf typeName in
    let wrapName := dslDefinitionName typeName (decapitalize localName) in
    let unwrapLocalName := strings.concat ["un", localName] in
    let unwrapName := dslDefinitionName typeName unwrapLocalName in
    let wrapperType := nominalResultType typeName origType in
    let wrapDomain := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = innerType}} in
    let rawWrapBody := Term{
      lambda = Lambda{
        parameter = Name{"x"},
        domain = given(wrapDomain),
        body = Term{
          `wrap` = WrappedTerm{
            typeName = Name{"hydra.core.typed.TypedTerm"},
            body = Term{
              `inject` = Injection{
                typeName = Name{"hydra.core.model.Term"},
                field = Field{
                  name = Name{"wrap"},
                  `term` = Term{
                    `record` = Record{
                      typeName = Name{"hydra.core.model.WrappedTerm"},
                      fields = [
                        Field{
                          name = Name{"typeName"},
                          `term` = Term{
                            `wrap` = WrappedTerm{
                              typeName = Name{"hydra.core.model.Name"},
                              body = Term{literal = Literal{`string` = Name[] typeName}}}}},
                        Field{
                          name = Name{"body"},
                          `term` = Term{
                            application = Application{
                              function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                              argument = Term{variable = Name{"x"}}}}}]}}}}}}}}} in
    let wrapDescription := strings.concat
        ["DSL constructor for the ", Name[] typeName, " wrapper"] in
    let wrapBody := setTermDescription given(wrapDescription) rawWrapBody in
    let unwrapDomain := Type{
      application = ApplicationType{
        function = Type{
          variable = Name{"hydra.core.typed.TypedTerm"}},
        argument = wrapperType}} in
    let rawUnwrapBody := Term{
      lambda = Lambda{
        parameter = Name{"x"},
        domain = given(unwrapDomain),
        body = Term{
          `wrap` = WrappedTerm{
            typeName = Name{"hydra.core.typed.TypedTerm"},
            body = Term{
              `inject` = Injection{
                typeName = Name{"hydra.core.model.Term"},
                field = Field{
                  name = Name{"application"},
                  `term` = Term{
                    `record` = Record{
                      typeName = Name{"hydra.core.model.Application"},
                      fields = [
                        Field{
                          name = Name{"function"},
                          `term` = Term{
                            `inject` = Injection{
                              typeName = Name{"hydra.core.model.Term"},
                              field = Field{
                                name = Name{"unwrap"},
                                `term` = Term{
                                  `wrap` = WrappedTerm{
                                    typeName = Name{"hydra.core.model.Name"},
                                    body = Term{
                                      literal = Literal{
                                        `string` = Name[] typeName}}}}}}}},
                        Field{
                          name = Name{"argument"},
                          `term` = Term{
                            application = Application{
                              function = Term{`unwrap` = Name{"hydra.core.typed.TypedTerm"}},
                              argument = Term{variable = Name{"x"}}}}}]}}}}}}}}} in
    let unwrapDescription := strings.concat ["DSL accessor for the body of ", Name[] typeName] in
    let unwrapBody := setTermDescription given(unwrapDescription) rawUnwrapBody in
    let wrapTs := dslTypeScheme origType [innerType] wrapperType in
    let unwrapTs := dslTypeScheme origType [wrapperType] innerType in
    [
      Binding{name = wrapName, `term` = wrapBody, typeScheme = given(wrapTs)},
      Binding{name = unwrapName, `term` = unwrapBody, typeScheme = given(unwrapTs)}]

## Check if a binding is eligible for DSL generation
term isDslEligibleBinding =
  λcx,graph,b.
    let ns := moduleNameOf (Binding[name] b)
    in ifElse (equal (optionals.match ns "" ModuleName[]) "hydra.core.typed") right(none) right(given(b))

## Build the nominal result type with type applications for forall variables
term nominalResultType =
  λtypeName,origType.
    let vars := collectForallVars origType
    in lists.foldl
      (λacc,v.Type{application = ApplicationType{function = acc, argument = Type{variable = v}}})
      Type{variable = typeName}
      vars

## Check whether a term signature's parameter and result types are all void-free
term signatureIsVoidFree =
  λsig.
    let paramTypes := lists.map (λp.Parameter[`type`] p) (TermSignature[parameters] sig) in
    let resultType := Result[`type`] (TermSignature[result] sig) in
    lists.foldl (λacc,t.and acc (typeIsVoidFree t)) (typeIsVoidFree resultType) paramTypes

## Check whether a type contains no occurrence of the void type at any depth
term typeIsVoidFree =
  λtyp.
    let allVariants := sets.fromList
        (lists.map typeVariant (foldOverType TraversalOrder{pre} (λm,t.lists.cons t m) [] typ))
    in not (sets.member TypeVariant{`void`} allVariants)