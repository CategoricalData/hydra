## Canonical printer for Hydra's translingual regular-expression syntax (docs/specification/regex.md): hydra.core.regex AST -> canonical text. Escapes minimally (a character is escaped only where it is special in its context), so that print.regex . parse.regex is idempotent on well-formed input. Per-dialect renderers (hydra.core.print.<dialect>.regex) build on this. See issue #567.
module hydra.core.print.regex

import hydra.core.lib.equality
import hydra.core.lib.lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.strings as strings
import hydra.core.regex

## Render an alternation, joining its branches with the | operator.
term alternation = λalt.strings.join "|" (`map` regexSequence alt)

## Render a single atom (literal, ., anchor, group, or class) to canonical text.
term atom =
  λa.cases(Atom){
      literal=λc.escapeLiteral c,
      any=λ`_`.".",
      anchorStart=λ`_`."^",
      anchorEnd=λ`_`."$",
      group=λg.strings.concat ["(", alternation g, ")"],
      class=λcc.characterClass cc}
      a

## Render a character class, including the leading ^ for a negated class.
term characterClass =
  λcc.strings.concat
      ["[", ifElse (CharacterClass[negated] cc) "^" "", strings.concat (`map` classItem (CharacterClass[items] cc)), "]"]

## Render one character-class member (a single character or an inclusive range) to canonical text.
term classItem =
  λitem.cases(ClassItem){
      character=λc.escapeClassChar c,
      range=λr.strings.concat
            [escapeClassChar (CharacterRange[`from`] r), "-", escapeClassChar (CharacterRange[to] r)]}
      item

## Render a code point inside a character class, backslash-escaping it iff it is one of the class metacharacters \ ] ^ -. Escaping is uniform, with no positional exceptions (a literal '-' always prints as \-).
term escapeClassChar =
  λc.
    let isMeta := foldl (λacc,m.or acc (equal c m)) false [92:int32, 93:int32, 94:int32, 45:int32]
    in ifElse isMeta (strings.concat2 "\\" (printCodePoint c)) (printCodePoint c)

## Render a literal code point in top-level context, backslash-escaping it iff it is one of the top-level metacharacters . ^ $ * + ? ( ) [ ] { } | \. A '-' is not special at top level and prints bare.
term escapeLiteral =
  λc.
    let isMeta := foldl
        (λacc,m.or acc (equal c m))
        false
        [
          46:int32,
          94:int32,
          36:int32,
          42:int32,
          43:int32,
          63:int32,
          40:int32,
          41:int32,
          91:int32,
          93:int32,
          123:int32,
          125:int32,
          124:int32,
          92:int32]
    in ifElse isMeta (strings.concat2 "\\" (printCodePoint c)) (printCodePoint c)

## Render a single Unicode code point as a one-character string.
term printCodePoint = λc.strings.fromList [c]

## Render a hydra.core.regex AST to canonical Hydra regex text. Escapes minimally, so that printRegex . parseRegex is the identity on well-formed patterns.
term printRegex = λr.alternation r

## Render an atom followed by its quantifier suffix.
term quantified = λqa.strings.concat2 (atom (Quantified[atom] qa)) (quantifier (Quantified[quantifier] qa))

## Render a quantifier suffix; the 'one' quantifier renders as the empty string.
term quantifier =
  λq.cases(Quantifier){
      one=λ`_`."",
      zeroOrOne=λ`_`."?",
      zeroOrMore=λ`_`."*",
      oneOrMore=λ`_`."+",
      exactly=λn.strings.concat ["{", printInt32 n, "}"],
      atLeast=λn.strings.concat ["{", printInt32 n, ",}"],
      range=λr.strings.concat
            ["{", printInt32 (QuantifierRange[min] r), ",", printInt32 (QuantifierRange[max] r), "}"]}
      q

## Render a sequence of quantified atoms by concatenation.
term regexSequence = λs.strings.concat (`map` quantified s)