## A module for tier-0 constants.
module hydra.core.constants

import hydra.core.model as model

term fieldNameValue = "value"@{description="The conventional field name used when normalizing a wrapped (newtype) value to a single-field record"}

term ignoredVariable = "_"@{description="The name used for ignored variables"}

term keyClasses = model.Name{"classes"}@{description="Annotation key for type classes"}

term keyDebugId = model.Name{"debugId"}@{description="Annotation key for debug identifiers"}

term keyDeprecated = model.Name{"deprecated"}@{description="Annotation key for deprecated markers"}

term keyDescription = model.Name{"description"}@{description="Annotation key for descriptions"}

term keyExclude = model.Name{"exclude"}@{description="Annotation key for exclusions"}

term keyFirstClassType = model.Name{"firstClassType"}@{description="A flag which tells the language coders to encode a given encoded type as a term rather than a native type"}

term keyFreshTypeVariableCount = model.Name{"freshTypeVariableCount"}@{description="A counter for generating fresh type variable names"}

term keyMaxLength = model.Name{"maxLength"}@{description="Annotation key for maximum length constraints"}

term keyMinLength = model.Name{"minLength"}@{description="Annotation key for minimum length constraints"}

term keyPreserveFieldName = model.Name{"preserveFieldName"}@{description="Annotation key for preserving field names during code generation"}

term keyType = model.Name{"type"}@{description="Annotation key for type information"}

term maxInt32 = 2147483647:int32@{description="The maximum value of a 32-bit integer"}

term maxTraceDepth = 5000:int32@{description="A maximum depth for nested computations. Currently, this is set very high because deep recursion is common in type inference over the Hydra kernel."}

term regexCamelCase = "^[a-z][a-zA-Z0-9]*$"@{description="Regex matching a camelCase identifier: starts with a lowercase letter, then any letters or digits."}

term regexNamespace = "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$"@{description="Regex matching a Hydra namespace: dot-separated camelCase segments, each starting with a lowercase letter."}

term regexPackageName = "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"@{description="Regex matching a Hydra package name: hyphen-separated lowercase segments, each starting with a letter."}

term regexPascalCase = "^[A-Z][a-zA-Z0-9]*$"@{description="Regex matching a PascalCase identifier: starts with an uppercase letter, then any letters or digits."}

term warningAutoGeneratedFile = "Note: this is an automatically generated file. Do not edit."@{description="A standard warning message for auto-generated files"}