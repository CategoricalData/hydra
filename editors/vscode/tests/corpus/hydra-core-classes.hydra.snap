>## Check whether a type is an instance of a constraint class, by the class's short name.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term classIsSatisfiedByType = λclassName,typ.let isIntegerLiteral := cases(model.Type){literal=λlt.cases(model.LiteralType){integer=λ`_`.true, `_`=false} lt, `_`=false} (strip.deannotateType typ) in let isFloatLiteral := cases(model.Type){literal=λlt.cases(model.LiteralType){float=λ`_`.true, `_`=false} lt, `_`=false} (strip.deannotateType typ) in logic.ifElse (equality.equal className model.Name{"equality"}) true (logic.ifElse (equality.equal className model.Name{"ordering"}) true (logic.ifElse (equality.equal className model.Name{"numeric"}) (logic.or isIntegerLiteral isFloatLiteral) (logic.ifElse (equality.equal className model.Name{"integral"}) isIntegerLiteral (logic.ifElse (equality.equal className model.Name{"fractional"}) isFloatLiteral false))))
