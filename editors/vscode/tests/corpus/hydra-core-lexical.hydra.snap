>## Build a Graph from element bindings, environment, and primitives
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term buildGraph = λelements,environment,primitives.let elementTerms := maps.fromList (lists.map (λb.(model.Binding[name] b, model.Binding[`term`] b)) elements) in let letTerms := maps.fromList (optionals.mapOptional (λkv.optionals.map (λt.(pairs.first kv, t)) (pairs.second kv)) (maps.toList environment)) in let mergedTerms := maps.union elementTerms letTerms in let filteredTerms := maps.filterWithKey (λk,`_v`.logic.not (maps.member k primitives)) mergedTerms in let elementTypes := maps.fromList (optionals.givens (lists.map (λb.optionals.map (λts.(model.Binding[name] b, ts)) (model.Binding[typeScheme] b)) elements)) in let filteredTypes := maps.filterWithKey (λk,`_v`.logic.not (maps.member k primitives)) elementTypes in graph.Graph{boundTerms = filteredTerms, boundTypes = filteredTypes, classConstraints = maps.empty, lambdaVariables = sets.fromList (maps.keys (maps.filter (λmt.optionals.isNone mt) environment)), metadata = maps.empty, primitives = primitives, schemaTypes = maps.empty, typeVariables = sets.empty}
