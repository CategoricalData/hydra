>
>## Build a (fieldName, decoder) pair for a unit-valued union variant: the decoder ignores its argument and returns a fixed value
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term matchUnitField = λfname,x.(fname, λignored.right(x))
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                   ^ source.hydra
#                    ^ source.hydra keyword.operator.equals.hydra
#                     ^ source.hydra
#                      ^ source.hydra keyword.operator.lambda.hydra
#                       ^^^^^ source.hydra variable.parameter.hydra
#                            ^ source.hydra punctuation.separator.binder.hydra
#                             ^ source.hydra variable.parameter.hydra
#                              ^ source.hydra punctuation.separator.binder.hydra
#                               ^ source.hydra
#                                ^^^^^ source.hydra variable.other.hydra
#                                     ^^ source.hydra
#                                       ^ source.hydra keyword.operator.lambda.hydra
#                                        ^^^^^^^ source.hydra variable.parameter.hydra
#                                               ^ source.hydra punctuation.separator.binder.hydra
#                                                ^^^^^ source.hydra keyword.control.hydra
#                                                     ^ source.hydra
#                                                      ^ source.hydra variable.other.hydra
#                                                       ^^^ source.hydra
>
>## Look up a binding in a graph by name, failing with a list of available names if it is not found
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term requireBinding = λgraph,name.let showAll := false in let ellipsis := λstrings.logic.ifElse (logic.and (ordering.gt (lists.length strings) 3:int32) (logic.not showAll)) (lists.concat2 (lists.take 3:int32 strings) ["..."]) strings in let errMsg := strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "no such element: " (model.Name[] name)) ". Available elements: {") (strings.join ", " (ellipsis (lists.map model.Name[] (maps.keys (graph.Graph[boundTerms] graph)))))) "}" in optionals.match (lookupBinding graph name) left(errors.Error{resolution = errors.ResolutionError{other = wrap(errors.OtherResolutionError){errMsg}}}) (λx.right(x))
