>term elementsToGraph = λparent,schemaTypes,elements.let prims := graph.Graph[primitives] parent in let g := buildGraph elements maps.empty prims in graph.Graph{boundTerms = graph.Graph[boundTerms] g, boundTypes = graph.Graph[boundTypes] g, classConstraints = graph.Graph[classConstraints] g, lambdaVariables = graph.Graph[lambdaVariables] g, metadata = graph.Graph[metadata] g, primitives = graph.Graph[primitives] g, schemaTypes = schemaTypes, typeVariables = graph.Graph[typeVariables] g}
