>## Pick a name that does not collide with a reserved set, by appending a numeric suffix to the requested name when necessary
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term chooseUniqueName = λreserved,name.let tryName := λindex.let candidate := logic.ifElse (equality.equal index 1:int32) name model.Name{strings.concat2 (model.Name[] name) (literals.printInt32 index)} in logic.ifElse (sets.member candidate reserved) (tryName (math.add index 1:int32)) candidate in tryName 1:int32
