>
>## Match a term against a union type, dispatching on the injected variant to the appropriate decoder. Variable terms are dereferenced through the graph before matching.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term matchUnion = λgraph,tname,pairs,`term`.let stripped := strip.deannotateAndDetypeTerm `term` in let mapping := maps.fromList pairs in cases(model.Term){variable=λname.eithers.bind (requireBinding graph name) (λel.matchUnion graph tname pairs (model.Binding[`term`] el)), `inject`=λinjection.let exp := let fname := model.Field[name] (model.Injection[field] injection) in let val := model.Field[`term`] (model.Injection[field] injection) in optionals.match (maps.lookup fname mapping) left(errors.Error{resolution = errors.ResolutionError{noMatchingField = errors.NoMatchingFieldError{fieldName = fname}}}) (λf.f val) in logic.ifElse (equality.equal (model.Name[] (model.Injection[typeName] injection)) (model.Name[] tname)) exp left(errors.Error{resolution = errors.ResolutionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 "injection for type " (model.Name[] tname), actual = print.model.term `term`}}}), `_`=left(errors.Error{resolution = errors.ResolutionError{unexpectedShape = errors.UnexpectedShapeError{expected = strings.concat2 "injection for type " (model.Name[] tname), actual = print.model.term stripped}}})} stripped
