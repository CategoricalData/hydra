>## Resolve a schema type through a chain of zero or more typedefs
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term dereferenceSchemaType = λname,types.let forType := λt.cases(model.Type){annotated=λat.forType (model.AnnotatedType[body] at), `forall`=λft.optionals.map (λts.model.TypeScheme{variables = lists.cons (model.ForallType[parameter] ft) (model.TypeScheme[variables] ts), body = model.TypeScheme[body] ts, constraints = model.TypeScheme[constraints] ts}) (forType (model.ForallType[body] ft)), variable=λv.dereferenceSchemaType v types, `_`=given(model.TypeScheme{variables = [], body = t, constraints = maps.empty})} t in optionals.bind (maps.lookup name types) (λts.optionals.map (λts2.model.TypeScheme{variables = lists.concat2 (model.TypeScheme[variables] ts) (model.TypeScheme[variables] ts2), body = model.TypeScheme[body] ts2, constraints = model.TypeScheme[constraints] ts2}) (forType (model.TypeScheme[body] ts)))
