>
>term rewriteTermM = (λf.λterm0.let fsub := λrecurse.λ`term`.let forField := λfield.eithers.bind (recurse (model.Field[`term`] field)) (λt.right(model.Field{name = model.Field[name] field, `term` = t})) in let forCaseAlternative := λalt.eithers.bind (recurse (model.CaseAlternative[handler] alt)) (λt.right(model.CaseAlternative{name = model.CaseAlternative[name] alt, handler = t})) in let forPair := λkv.eithers.bind (recurse (pairs.first kv)) (λk.eithers.bind (recurse (pairs.second kv)) (λv.right((k, v)))) in let mapBinding := λb.eithers.bind (recurse (model.Binding[`term`] b)) (λv.right(model.Binding{name = model.Binding[name] b, `term` = v, typeScheme = model.Binding[typeScheme] b})) in cases(model.Term){annotated=λat.eithers.bind (recurse (model.AnnotatedTerm[body] at)) (λex.right(model.Term{annotated = model.AnnotatedTerm{body = ex, annotation = model.AnnotatedTerm[annotation] at}})), application=λapp.eithers.bind (recurse (model.Application[function] app)) (λlhs.eithers.bind (recurse (model.Application[argument] app)) (λrhs.right(model.Term{application = model.Application{function = lhs, argument = rhs}}))), `cases`=λcs.let n := model.CaseStatement[typeName] cs in let def := model.CaseStatement[default] cs in let csCases := model.CaseStatement[`cases`] cs in eithers.bind (optionals.match def right(none) (λt.eithers.map optionals.given (recurse t))) (λrdef.eithers.map (λrcases.model.Term{`cases` = model.CaseStatement{typeName = n, default = rdef, `cases` = rcases}}) (eithers.mapList forCaseAlternative csCases)), `either`=λe.eithers.bind (eithers.either (λl.eithers.map (λx.left(x)) (recurse l)) (λr.eithers.map (λx.right(x)) (recurse r)) e) (λre.right(model.Term{`either` = re})), lambda=λl.let v := model.Lambda[parameter] l in let d := model.Lambda[domain] l in let body := model.Lambda[body] l in eithers.bind (recurse body) (λrbody.right(model.Term{lambda = model.Lambda{parameter = v, domain = d, body = rbody}})), `let`=λlt.let bindings := model.Let[bindings] lt in let env := model.Let[body] lt in eithers.bind (eithers.mapList mapBinding bindings) (λrbindings.eithers.bind (recurse env) (λrenv.right(model.Term{`let` = model.Let{bindings = rbindings, body = renv}}))), `list`=λels.eithers.bind (eithers.mapList recurse els) (λrels.right(model.Term{`list` = rels})), literal=λv.right(model.Term{literal = v}), `map`=λm.eithers.bind (eithers.mapList forPair (maps.toList m)) (λpairs.right(model.Term{`map` = maps.fromList pairs})), `optional`=λm.eithers.bind (eithers.mapOptional recurse m) (λrm.right(model.Term{`optional` = rm})), pair=λp.eithers.bind (recurse (pairs.first p)) (λrf.eithers.bind (recurse (pairs.second p)) (λrs.right(model.Term{pair = (rf, rs)}))), `project`=λp.right(model.Term{`project` = p}), `record`=λr.let n := model.Record[typeName] r in let fields := model.Record[fields] r in eithers.map (λrfields.model.Term{`record` = model.Record{typeName = n, fields = rfields}}) (eithers.mapList forField fields), `set`=λs.eithers.bind (eithers.mapList recurse (sets.toList s)) (λrlist.right(model.Term{`set` = sets.fromList rlist})), typeApplication=λtt.eithers.bind (recurse (model.TypeApplicationTerm[body] tt)) (λt.right(model.Term{typeApplication = model.TypeApplicationTerm{body = t, `type` = model.TypeApplicationTerm[`type`] tt}})), typeLambda=λtl.let v := model.TypeLambda[parameter] tl in let body := model.TypeLambda[body] tl in eithers.bind (recurse body) (λrbody.right(model.Term{typeLambda = model.TypeLambda{parameter = v, body = rbody}})), `inject`=λi.let n := model.Injection[typeName] i in let field := model.Injection[field] i in eithers.map (λrfield.model.Term{`inject` = model.Injection{typeName = n, field = rfield}}) (forField field), `unit`=λ`_`.right(model.Term{`unit`}), `unwrap`=λn.right(model.Term{`unwrap` = n}), variable=λv.right(model.Term{variable = v}), `wrap`=λwt.let name := model.WrappedTerm[typeName] wt in let t := model.WrappedTerm[body] wt in eithers.bind (recurse t) (λrt.right(model.Term{`wrap` = model.WrappedTerm{typeName = name, body = rt}}))} `term` in let recurse := f (fsub recurse) in recurse term0)@{description="Either-based term rewriting with custom transformation function"}
