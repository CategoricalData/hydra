>term applyInsideTypeLambdasAndAnnotations = (λf.λterm0.cases(model.Term){annotated=λat.model.Term{annotated = model.AnnotatedTerm{body = applyInsideTypeLambdasAndAnnotations f (model.AnnotatedTerm[body] at), annotation = model.AnnotatedTerm[annotation] at}}, typeLambda=λtl.model.Term{typeLambda = model.TypeLambda{parameter = model.TypeLambda[parameter] tl, body = applyInsideTypeLambdasAndAnnotations f (model.TypeLambda[body] tl)}}, `_`=f term0} term0)@{description="Apply a term-level function inside any leading type lambdas"}
