>term subtermsWithSteps = cases(model.Term){annotated=λat.[(paths.SubtermStep{annotatedBody}, model.AnnotatedTerm[body] at)], application=λp.[(paths.SubtermStep{applicationFunction}, model.Application[function] p), (paths.SubtermStep{applicationArgument}, model.Application[argument] p)], `cases`=λcs.lists.concat2 (optionals.match (model.CaseStatement[default] cs) [] (λt.[(paths.SubtermStep{casesDefault}, t)])) (lists.map (λf.(paths.SubtermStep{casesCase = model.CaseAlternative[name] f}, model.CaseAlternative[handler] f)) (model.CaseStatement[`cases`] cs)), `either`=λe.eithers.either (λl.[(paths.SubtermStep{eitherLeft}, l)]) (λr.[(paths.SubtermStep{eitherRight}, r)]) e, lambda=λl.[(paths.SubtermStep{lambdaBody}, model.Lambda[body] l)], `let`=λlt.lists.cons (paths.SubtermStep{letBody}, model.Let[body] lt) (lists.map (λb.(paths.SubtermStep{letBinding = model.Binding[name] b}, model.Binding[`term`] b)) (model.Let[bindings] lt)), `list`=λl.lists.map (λip.(paths.SubtermStep{listElement = pairs.first ip}, pairs.second ip)) (lists.reverse (pairs.second (lists.foldl (λr.λel.let idx := pairs.first r in (math.add idx 1:int32, lists.cons (idx, el) (pairs.second r))) (0:int32, []) l))), literal=λ`_`.[], `map`=λm.lists.map (λip.(paths.SubtermStep{mapEntry = pairs.first ip}, model.Term{pair = (pairs.first (pairs.second ip), pairs.second (pairs.second ip))})) (lists.reverse (pairs.second (lists.foldl (λr.λel.let idx := pairs.first r in (math.add idx 1:int32, lists.cons (idx, el) (pairs.second r))) (0:int32, []) (maps.toList m)))), `optional`=λm.optionals.match m [] (λt.[(paths.SubtermStep{optionalGiven}, t)]), pair=λp.[(paths.SubtermStep{pairFirst}, pairs.first p), (paths.SubtermStep{pairSecond}, pairs.second p)], `project`=λ`_`.[], `record`=λrt.lists.map (λf.(paths.SubtermStep{recordField = model.Field[name] f}, model.Field[`term`] f)) (model.Record[fields] rt), `set`=λs.lists.map (λip.(paths.SubtermStep{setElement = pairs.first ip}, pairs.second ip)) (lists.reverse (pairs.second (lists.foldl (λr.λel.let idx := pairs.first r in (math.add idx 1:int32, lists.cons (idx, el) (pairs.second r))) (0:int32, []) (sets.toList s)))), typeApplication=λta.[(paths.SubtermStep{typeApplicationBody}, model.TypeApplicationTerm[body] ta)], typeLambda=λta.[(paths.SubtermStep{typeLambdaBody}, model.TypeLambda[body] ta)], `inject`=λut.[(paths.SubtermStep{injectField = model.Field[name] (model.Injection[field] ut)}, model.Field[`term`] (model.Injection[field] ut))], `unit`=λ`_`.[], `unwrap`=λ`_`.[], variable=λ`_`.[], `wrap`=λn.[(paths.SubtermStep{wrapBody}, model.WrappedTerm[body] n)]}@{description="Find the children of a given term"}
