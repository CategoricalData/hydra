>term rewriteAndFoldTerm = (λf.λterm0.let fsub := λrecurse.λval0.λterm0.let forSingle := λrec.λcons.λval.λ`term`.let r := rec val `term` in (pairs.first r, cons (pairs.second r)) in let forMany := λrec.λcons.λval.λels.let rr := lists.foldl (λr.λel.let r2 := rec (pairs.first r) el in (pairs.first r2, lists.cons (pairs.second r2) (pairs.second r))) (val, []) els in (pairs.first rr, cons (lists.reverse (pairs.second rr))) in let forField := λval.λfield.let r := recurse val (model.Field[`term`] field) in (pairs.first r, model.Field{name = model.Field[name] field, `term` = pairs.second r}) in let forFields := forMany forField (λx.x) in let forCaseAlternative := λval.λalt.let r := recurse val (model.CaseAlternative[handler] alt) in (pairs.first r, model.CaseAlternative{name = model.CaseAlternative[name] alt, handler = pairs.second r}) in let forCaseAlternatives := forMany forCaseAlternative (λx.x) in let forPair := λval.λkv.let rk := recurse val (pairs.first kv) in let rv := recurse (pairs.first rk) (pairs.second kv) in (pairs.first rv, (pairs.second rk, pairs.second rv)) in let forBinding := λval.λbinding.let r := recurse val (model.Binding[`term`] binding) in (pairs.first r, model.Binding{name = model.Binding[name] binding, `term` = pairs.second r, typeScheme = model.Binding[typeScheme] binding}) in let dflt := (val0, term0) in cases(model.Term){annotated=λat.forSingle recurse (λt.model.Term{annotated = model.AnnotatedTerm{body = t, annotation = model.AnnotatedTerm[annotation] at}}) val0 (model.AnnotatedTerm[body] at), application=λa.let rlhs := recurse val0 (model.Application[function] a) in let rrhs := recurse (pairs.first rlhs) (model.Application[argument] a) in (pairs.first rrhs, model.Term{application = model.Application{function = pairs.second rlhs, argument = pairs.second rrhs}}), `cases`=λcs.let rmd := optionals.map (recurse val0) (model.CaseStatement[default] cs) in let val1 := optionals.match rmd val0 pairs.first in let rcases := forCaseAlternatives val1 (model.CaseStatement[`cases`] cs) in (pairs.first rcases, model.Term{`cases` = model.CaseStatement{typeName = model.CaseStatement[typeName] cs, default = optionals.map pairs.second rmd, `cases` = pairs.second rcases}}), `either`=λe.eithers.either (λl.let rl := recurse val0 l in (pairs.first rl, model.Term{`either` = left(pairs.second rl)})) (λr.let rr := recurse val0 r in (pairs.first rr, model.Term{`either` = right(pairs.second rr)})) e, lambda=λl.let rl := recurse val0 (model.Lambda[body] l) in (pairs.first rl, model.Term{lambda = model.Lambda{parameter = model.Lambda[parameter] l, domain = model.Lambda[domain] l, body = pairs.second rl}}), `let`=λl.let renv := recurse val0 (model.Let[body] l) in forMany forBinding (λbins.model.Term{`let` = model.Let{bindings = bins, body = pairs.second renv}}) (pairs.first renv) (model.Let[bindings] l), `list`=λels.forMany recurse (λx.model.Term{`list` = x}) val0 els, `map`=λm.forMany forPair (λpairs.model.Term{`map` = maps.fromList pairs}) val0 (maps.toList m), `optional`=λmt.optionals.match mt dflt (λt.forSingle recurse (λt1.model.Term{`optional` = given(t1)}) val0 t), pair=λp.let rf := recurse val0 (pairs.first p) in let rs := recurse (pairs.first rf) (pairs.second p) in (pairs.first rs, model.Term{pair = (pairs.second rf, pairs.second rs)}), `project`=λp.(val0, model.Term{`project` = p}), `record`=λr.forMany forField (λfields.model.Term{`record` = model.Record{typeName = model.Record[typeName] r, fields = fields}}) val0 (model.Record[fields] r), `set`=λels.forMany recurse (λe.model.Term{`set` = sets.fromList e}) val0 (sets.toList els), typeApplication=λta.forSingle recurse (λt.model.Term{typeApplication = model.TypeApplicationTerm{body = t, `type` = model.TypeApplicationTerm[`type`] ta}}) val0 (model.TypeApplicationTerm[body] ta), typeLambda=λtl.forSingle recurse (λt.model.Term{typeLambda = model.TypeLambda{parameter = model.TypeLambda[parameter] tl, body = t}}) val0 (model.TypeLambda[body] tl), `inject`=λinj.forSingle recurse (λt.model.Term{`inject` = model.Injection{typeName = model.Injection[typeName] inj, field = model.Field{name = model.Field[name] (model.Injection[field] inj), `term` = t}}}) val0 (model.Field[`term`] (model.Injection[field] inj)), `unwrap`=λn.(val0, model.Term{`unwrap` = n}), `wrap`=λwt.forSingle recurse (λt.model.Term{`wrap` = model.WrappedTerm{typeName = model.WrappedTerm[typeName] wt, body = t}}) val0 (model.WrappedTerm[body] wt), `_`=dflt} term0 in let recurse := f (fsub recurse) in recurse term0)@{description="Rewrite a term, and at the same time, fold a function over it, accumulating a value"}
