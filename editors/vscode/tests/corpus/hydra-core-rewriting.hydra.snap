>
>term rewriteTypeM = (λf.λtyp0.let fsub := λrecurse.λtyp.cases(model.Type){annotated=λat.eithers.bind (recurse (model.AnnotatedType[body] at)) (λt.right(model.Type{annotated = model.AnnotatedType{body = t, annotation = model.AnnotatedType[annotation] at}})), application=λat.eithers.bind (recurse (model.ApplicationType[function] at)) (λlhs.eithers.bind (recurse (model.ApplicationType[argument] at)) (λrhs.right(model.Type{application = model.ApplicationType{function = lhs, argument = rhs}}))), `effect`=λt.eithers.bind (recurse t) (λrt.right(model.Type{`effect` = rt})), `either`=λet.eithers.bind (recurse (model.EitherType[`left`] et)) (λ`left`.eithers.bind (recurse (model.EitherType[`right`] et)) (λ`right`.right(model.Type{`either` = model.EitherType{`left` = `left`, `right` = `right`}}))), pair=λpt.eithers.bind (recurse (model.PairType[first] pt)) (λpairFirst.eithers.bind (recurse (model.PairType[second] pt)) (λpairSecond.right(model.Type{pair = model.PairType{first = pairFirst, second = pairSecond}}))), function=λft.eithers.bind (recurse (model.FunctionType[domain] ft)) (λdom.eithers.bind (recurse (model.FunctionType[codomain] ft)) (λcod.right(model.Type{function = model.FunctionType{domain = dom, codomain = cod}}))), `forall`=λft.eithers.bind (recurse (model.ForallType[body] ft)) (λb.right(model.Type{`forall` = model.ForallType{parameter = model.ForallType[parameter] ft, body = b}})), `list`=λt.eithers.bind (recurse t) (λrt.right(model.Type{`list` = rt})), literal=λlt.right(model.Type{literal = lt}), `map`=λmt.eithers.bind (recurse (model.MapType[keys] mt)) (λkt.eithers.bind (recurse (model.MapType[values] mt)) (λvt.right(model.Type{`map` = model.MapType{keys = kt, values = vt}}))), `optional`=λt.eithers.bind (recurse t) (λrt.right(model.Type{`optional` = rt})), `record`=λrt.let forField := λf.eithers.bind (recurse (model.FieldType[`type`] f)) (λt.right(model.FieldType{name = model.FieldType[name] f, `type` = t})) in eithers.bind (eithers.mapList forField rt) (λrfields.right(model.Type{`record` = rfields})), `set`=λt.eithers.bind (recurse t) (λrt.right(model.Type{`set` = rt})), `union`=λrt.let forField := λf.eithers.bind (recurse (model.FieldType[`type`] f)) (λt.right(model.FieldType{name = model.FieldType[name] f, `type` = t})) in eithers.bind (eithers.mapList forField rt) (λrfields.right(model.Type{`union` = rfields})), `unit`=λ`_`.right(model.Type{`unit`}), variable=λv.right(model.Type{variable = v}), `void`=λ`_`.right(model.Type{`void`}), `wrap`=λwt.eithers.bind (recurse wt) (λt.right(model.Type{`wrap` = t}))} typ in let recurse := f (fsub recurse) in recurse typ0)@{description="Either-based type rewriting"}
