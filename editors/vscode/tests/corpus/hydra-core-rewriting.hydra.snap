>term subtypesWithSteps = cases(model.Type){annotated=λat.[(paths.SubtypeStep{annotatedBody}, model.AnnotatedType[body] at)], application=λat.[(paths.SubtypeStep{applicationFunction}, model.ApplicationType[function] at), (paths.SubtypeStep{applicationArgument}, model.ApplicationType[argument] at)], `effect`=λet.[(paths.SubtypeStep{effectValue}, et)], `either`=λet.[(paths.SubtypeStep{eitherLeft}, model.EitherType[`left`] et), (paths.SubtypeStep{eitherRight}, model.EitherType[`right`] et)], `forall`=λlt.[(paths.SubtypeStep{forallBody}, model.ForallType[body] lt)], function=λft.[(paths.SubtypeStep{functionDomain}, model.FunctionType[domain] ft), (paths.SubtypeStep{functionCodomain}, model.FunctionType[codomain] ft)], `list`=λlt.[(paths.SubtypeStep{listElement}, lt)], literal=λ`_`.[], `map`=λmt.[(paths.SubtypeStep{mapKeys}, model.MapType[keys] mt), (paths.SubtypeStep{mapValues}, model.MapType[values] mt)], `optional`=λot.[(paths.SubtypeStep{optionalElement}, ot)], pair=λpt.[(paths.SubtypeStep{pairFirst}, model.PairType[first] pt), (paths.SubtypeStep{pairSecond}, model.PairType[second] pt)], `record`=λrt.lists.map (λf.(paths.SubtypeStep{recordField = model.FieldType[name] f}, model.FieldType[`type`] f)) rt, `set`=λst.[(paths.SubtypeStep{setElement}, st)], `union`=λrt.lists.map (λf.(paths.SubtypeStep{unionField = model.FieldType[name] f}, model.FieldType[`type`] f)) rt, `unit`=λ`_`.[], variable=λ`_`.[], `void`=λ`_`.[], `wrap`=λnt.[(paths.SubtypeStep{wrapBody}, nt)]}@{description="Find the children of a given type expression, each paired with the step by which it is reached"}
