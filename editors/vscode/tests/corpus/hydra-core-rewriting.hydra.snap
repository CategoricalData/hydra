>term rewriteType = (λf.λtyp0.let fsub := λrecurse.λtyp.let forField := λfield.model.FieldType{name = model.FieldType[name] field, `type` = recurse (model.FieldType[`type`] field)} in cases(model.Type){annotated=λat.model.Type{annotated = model.AnnotatedType{body = recurse (model.AnnotatedType[body] at), annotation = model.AnnotatedType[annotation] at}}, application=λapp.model.Type{application = model.ApplicationType{function = recurse (model.ApplicationType[function] app), argument = recurse (model.ApplicationType[argument] app)}}, `effect`=λt.model.Type{`effect` = recurse t}, `either`=λet.model.Type{`either` = model.EitherType{`left` = recurse (model.EitherType[`left`] et), `right` = recurse (model.EitherType[`right`] et)}}, pair=λpt.model.Type{pair = model.PairType{first = recurse (model.PairType[first] pt), second = recurse (model.PairType[second] pt)}}, function=λfun.model.Type{function = model.FunctionType{domain = recurse (model.FunctionType[domain] fun), codomain = recurse (model.FunctionType[codomain] fun)}}, `forall`=λlt.model.Type{`forall` = model.ForallType{parameter = model.ForallType[parameter] lt, body = recurse (model.ForallType[body] lt)}}, `list`=λt.model.Type{`list` = recurse t}, literal=λlt.model.Type{literal = lt}, `map`=λmt.model.Type{`map` = model.MapType{keys = recurse (model.MapType[keys] mt), values = recurse (model.MapType[values] mt)}}, `optional`=λt.model.Type{`optional` = recurse t}, `record`=λrt.model.Type{`record` = lists.map forField rt}, `set`=λt.model.Type{`set` = recurse t}, `union`=λrt.model.Type{`union` = lists.map forField rt}, `unit`=λ`_`.model.Type{`unit`}, variable=λv.model.Type{variable = v}, `void`=λ`_`.model.Type{`void`}, `wrap`=λwt.model.Type{`wrap` = recurse wt}} typ in let recurse := f (fsub recurse) in recurse typ0)@{description="Rewrite a type with a custom transformation function. The function receives a recursive walker and the current type and decides whether to recurse, replace, or both."}
