>primitive mapList : ∀x,y.(x → optional<y>) → list<x> → optional<list<y>> = λf.λxs.hydra.core.lib.lists.foldr (λx.λacc.hydra.core.lib.optionals.bind (f x) (λy.hydra.core.lib.optionals.map (λys.hydra.core.lib.lists.cons y ys) acc)) (hydra.core.lib.optionals.given []) xs
