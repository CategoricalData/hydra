>
>## Strip outer type lambda wrappers from a term, preserving type application wrappers and annotations
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term stripTypeLambdas = λt.cases(model.Term){annotated=λat.let subj := model.AnnotatedTerm[body] at in let ann := model.AnnotatedTerm[annotation] at in model.Term{annotated = model.AnnotatedTerm{body = stripTypeLambdas subj, annotation = ann}}, typeLambda=λta.stripTypeLambdas (model.TypeLambda[body] ta), `_`=t} t
