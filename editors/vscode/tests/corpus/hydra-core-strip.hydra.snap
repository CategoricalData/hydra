>## Strip System F type annotations from the top levels of a term, but leave application-specific annotations intact
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term detypeTerm = λt.cases(model.Term){annotated=λat.let subj := model.AnnotatedTerm[body] at in let ann := model.AnnotatedTerm[annotation] at in model.Term{annotated = model.AnnotatedTerm{body = detypeTerm subj, annotation = ann}}, typeApplication=λtt.deannotateAndDetypeTerm (model.TypeApplicationTerm[body] tt), typeLambda=λta.deannotateAndDetypeTerm (model.TypeLambda[body] ta), `_`=t} t
