>## Fully strip a type of forall quantifiers, normalizing bound variable names for alpha-equivalence comparison
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term fullyStripAndNormalizeType = λtyp.let go := λdepth,subst,t.cases(model.Type){`forall`=λft.let oldVar := model.ForallType[parameter] ft in let newVar := model.Name{strings.concat2 "_" (literals.printInt32 depth)} in go (math.add depth 1:int32) (maps.insert oldVar newVar subst) (model.ForallType[body] ft), `_`=(subst, t)} (strip.deannotateType t) in let result := go 0:int32 maps.empty typ in let subst := pairs.first result in let body := pairs.second result in variables.substituteTypeVariables subst body
