>term fieldTypes = λcx,graph,t.let toMap := λfields.maps.fromList (lists.map (λft.(model.FieldType[name] ft, model.FieldType[`type`] ft)) fields) in cases(model.Type){`forall`=λft.fieldTypes cx graph (model.ForallType[body] ft), `record`=λrt.right(toMap rt), `union`=λrt.right(toMap rt), variable=λname.optionals.match (maps.lookup name (graph.Graph[schemaTypes] graph)) (eithers.bind (lexical.requireBinding graph name) (λel.eithers.bind (eithers.bimap (λ`_e`.errors.Error{resolution = errors.ResolutionError{unexpectedShape = errors.UnexpectedShapeError{expected = "type", actual = errors.DecodingError[] `_e`}}}) (λ`_a`.`_a`) (decode.model.type graph (model.Binding[`term`] el))) (λdecodedType.fieldTypes cx graph decodedType))) (λts.fieldTypes cx graph (model.TypeScheme[body] ts)), `_`=left(errors.Error{resolution = errors.ResolutionError{unexpectedShape = errors.UnexpectedShapeError{expected = "record or union type", actual = print.model.type t}}})} (strip.deannotateType t)
