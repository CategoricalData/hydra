#   ^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra keyword.other.documentation.directive.hydra
#                  ^^^^^ source.hydra comment.block.documentation.hydra
>## @requirement extractsLeftValuesPreservingOrder lefts returns the list of every left value in the input list, in original order, discarding right values; given a list of only right values, or an empty list, the result is the empty list.
#^^ source.hydra comment.block.documentation.hydra
#  ^ source.hydra comment.block.documentation.hydra
#   ^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra keyword.other.documentation.directive.hydra
#               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>primitive lefts : ∀x,y.list<either<x, y>> → list<x> = λxs.hydra.core.lib.lists.foldr (λe.λacc.hydra.core.lib.eithers.either (λl.hydra.core.lib.lists.cons l acc) (λ`_`.acc) e) [] xs
