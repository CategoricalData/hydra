>
>## Visit a vertex and recursively explore its successors
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term strongConnect = λgraph,v,st.let i := topology.TarjanState[counter] st in let newSt := topology.TarjanState{counter = math.add i 1:int32, indices = maps.insert v i (topology.TarjanState[indices] st), lowLinks = maps.insert v i (topology.TarjanState[lowLinks] st), stack = lists.cons v (topology.TarjanState[stack] st), onStack = sets.insert v (topology.TarjanState[onStack] st), sccs = topology.TarjanState[sccs] st} in let neighbors := maps.findWithDefault [] v graph in let processNeighbor := λ`st_`,w.let lowLink := λs.let lowV1 := maps.findWithDefault constants.maxInt32 v (topology.TarjanState[lowLinks] s) in let `idx_w` := maps.findWithDefault constants.maxInt32 w (topology.TarjanState[indices] s) in topology.TarjanState{counter = topology.TarjanState[counter] s, indices = topology.TarjanState[indices] s, lowLinks = maps.insert v (ordering.min lowV1 `idx_w`) (topology.TarjanState[lowLinks] s), stack = topology.TarjanState[stack] s, onStack = topology.TarjanState[onStack] s, sccs = topology.TarjanState[sccs] s} in logic.ifElse (logic.not (maps.member w (topology.TarjanState[indices] `st_`))) (let stAfter := strongConnect graph w `st_` in let lowV2 := maps.findWithDefault constants.maxInt32 v (topology.TarjanState[lowLinks] stAfter) in let `low_w` := maps.findWithDefault constants.maxInt32 w (topology.TarjanState[lowLinks] stAfter) in topology.TarjanState{counter = topology.TarjanState[counter] stAfter, indices = topology.TarjanState[indices] stAfter, lowLinks = maps.insert v (ordering.min lowV2 `low_w`) (topology.TarjanState[lowLinks] stAfter), stack = topology.TarjanState[stack] stAfter, onStack = topology.TarjanState[onStack] stAfter, sccs = topology.TarjanState[sccs] stAfter}) (logic.ifElse (sets.member w (topology.TarjanState[onStack] `st_`)) (lowLink `st_`) `st_`) in let stAfterNeighbors := lists.foldl processNeighbor newSt neighbors in let `low_v` := maps.findWithDefault constants.maxInt32 v (topology.TarjanState[lowLinks] stAfterNeighbors) in let `idx_v` := maps.findWithDefault constants.maxInt32 v (topology.TarjanState[indices] stAfterNeighbors) in logic.ifElse (equality.equal `low_v` `idx_v`) (let compResult := popStackUntil v stAfterNeighbors in let comp := pairs.first compResult in let stPopped := pairs.second compResult in topology.TarjanState{counter = topology.TarjanState[counter] stPopped, indices = topology.TarjanState[indices] stPopped, lowLinks = topology.TarjanState[lowLinks] stPopped, stack = topology.TarjanState[stack] stPopped, onStack = topology.TarjanState[onStack] stPopped, sccs = lists.cons comp (topology.TarjanState[sccs] stPopped)}) stAfterNeighbors
