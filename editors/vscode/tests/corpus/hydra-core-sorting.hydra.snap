>## Convert an adjacency list to a map, concatenating values for duplicate keys
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term adjacencyListToMap = λpairs.lists.foldl (λmp,p.let k := pairs.first p in let vs := pairs.second p in let existing := optionals.match (maps.lookup k mp) [] functions.identity in maps.insert k (lists.concat2 existing vs) mp) maps.empty pairs
