>## Pop vertices off the stack until the given vertex is reached, collecting the current strongly connected component
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term popStackUntil = λv,st0.let go := λacc,st.optionals.match (lists.uncons (topology.TarjanState[stack] st)) (lists.reverse acc, st) (λuc.let x := pairs.first uc in let xs := pairs.second uc in let newSt := topology.TarjanState{counter = topology.TarjanState[counter] st, indices = topology.TarjanState[indices] st, lowLinks = topology.TarjanState[lowLinks] st, stack = xs, onStack = topology.TarjanState[onStack] st, sccs = topology.TarjanState[sccs] st} in let newSt2 := topology.TarjanState{counter = topology.TarjanState[counter] newSt, indices = topology.TarjanState[indices] newSt, lowLinks = topology.TarjanState[lowLinks] newSt, stack = topology.TarjanState[stack] newSt, onStack = sets.delete x (topology.TarjanState[onStack] st), sccs = topology.TarjanState[sccs] newSt} in let `acc'` := lists.cons x acc in logic.ifElse (equality.equal x v) (lists.reverse `acc'`, newSt2) (go `acc'` newSt2)) in go [] st0
