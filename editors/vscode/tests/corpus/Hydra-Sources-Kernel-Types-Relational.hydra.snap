#                    ^^^^^^ source.hydra support.type.hydra
#                          ^ source.hydra
#                           ^ source.hydra variable.parameter.hydra
#                            ^ source.hydra punctuation.separator.binder.hydra
#                             ^ source.hydra
#                              ^^^^^^ source.hydra keyword.control.hydra
#                                    ^^ source.hydra
>  ## A unique name for the column
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  name: ColumnName,
#^^ source.hydra
#  ^^^^ source.hydra variable.other.hydra
#      ^ source.hydra punctuation.separator.type.hydra
#       ^ source.hydra
#        ^^^^^^^^^^ source.hydra variable.other.hydra
#                  ^^ source.hydra
>  ## The domain (type) of the column
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
