>term undeclaredDependencyError = (λe.strings.concat ["module ", packaging.ModuleName[] (error.packaging.UndeclaredDependencyError[moduleName] e), " references ", model.Name[] (error.packaging.UndeclaredDependencyError[referencedName] e), ", whose owning module ", packaging.ModuleName[] (error.packaging.UndeclaredDependencyError[owningModuleName] e), " is not among its declared dependencies; add it to moduleDependencies"])@{description="Show an undeclared dependency error as a string"}
