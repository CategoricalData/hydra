## A utility which instantiates a nonrecursive type with default values
module hydra.core.templates

import hydra.core.decode.model as model
import hydra.core.errors
import hydra.core.lib.eithers as eithers
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals
import hydra.core.lib.sets as sets
import hydra.core.lib.strings
import hydra.core.model

## Decode a list of type-encoding bindings into a map of named types
term graphToSchema =
  λcx,graph,els.
    let toPair := λel.
        let name := Binding[name] el
        in eithers.bind (model.type graph (Binding[`term`] el)) (λt.right((name, t)))
    in eithers.bind (eithers.mapList toPair els) (λpairs.right(maps.fromList pairs))

## Given a graph schema and a nonrecursive type, instantiate it with default values. If the minimal flag is set, the smallest possible term is produced; otherwise, exactly one subterm is produced for constructors which do not otherwise require one, e.g. in lists and optionals. The name parameter provides the element name for nominal type construction.
term instantiateTemplate =
  λcx,minimal,schema,tname,t.
    let inst := λtn.instantiateTemplate cx minimal schema tn in
    let noPoly := left(Error{
        extraction = ExtractionError{
          unexpectedShape = UnexpectedShapeError{
            expected = "non-polymorphic type",
            actual = "polymorphic or function type"}}}) in
    let forFloat := λft.cases(FloatType){
          `float32`=λ`_`.FloatValue{`float32` = 0.0:float32},
          `float64`=λ`_`.FloatValue{`float64` = 0.0:float64}}
          ft in
    let forInteger := λit.cases(IntegerType){
          `bigint`=λ`_`.IntegerValue{`bigint` = 0:bigint},
          `int8`=λ`_`.IntegerValue{`int8` = 0:int8},
          `int16`=λ`_`.IntegerValue{`int16` = 0:int16},
          `int32`=λ`_`.IntegerValue{`int32` = 0:int32},
          `int64`=λ`_`.IntegerValue{`int64` = 0:int64},
          `uint8`=λ`_`.IntegerValue{`uint8` = 0:uint8},
          `uint16`=λ`_`.IntegerValue{`uint16` = 0:uint16},
          `uint32`=λ`_`.IntegerValue{`uint32` = 0:uint32},
          `uint64`=λ`_`.IntegerValue{`uint64` = 0:uint64}}
          it in
    let forLiteral := λlt.cases(LiteralType){
          `binary`=λ`_`.Literal{`string` = ""},
          `boolean`=λ`_`.Literal{`boolean` = false},
          `decimal`=λ`_`.Literal{`decimal` = 0},
          integer=λit.Literal{integer = forInteger it},
          float=λft.Literal{float = forFloat ft},
          `string`=λ`_`.Literal{`string` = ""}}
          lt in
    cases(Type){
      annotated=λat.inst tname (AnnotatedType[body] at),
      application=λ`_`.noPoly,
      function=λ`_`.noPoly,
      `forall`=λ`_`.noPoly,
      `list`=λet.ifElse
            minimal
            right(Term{`list` = []})
            (eithers.bind (inst tname et) (λe.right(Term{`list` = [e]}))),
      literal=λlt.right(Term{literal = forLiteral lt}),
      `map`=λmt.
          let kt := MapType[keys] mt in
          let vt := MapType[values] mt in
          ifElse
            minimal
            right(Term{`map` = maps.empty})
            (eithers.bind
              (inst tname kt)
              (λke.eithers.bind
                  (inst tname vt)
                  (λve.right(Term{`map` = maps.singleton ke ve})))),
      `optional`=λot.ifElse
            minimal
            right(Term{`optional` = none})
            (eithers.bind
              (inst tname ot)
              (λe.right(Term{`optional` = given(e)}))),
      `record`=λrt.
          let toField := λft.eithers.bind
                (inst tname (FieldType[`type`] ft))
                (λe.right(Field{
                    name = FieldType[name] ft,
                    `term` = e}))
          in eithers.bind
            (eithers.mapList toField rt)
            (λdfields.right(Term{
                `record` = Record{
                  typeName = tname,
                  fields = dfields}})),
      `set`=λet.ifElse
            minimal
            right(Term{`set` = sets.empty})
            (eithers.bind
              (inst tname et)
              (λe.right(Term{`set` = sets.fromList [e]}))),
      variable=λvname.match
            (maps.lookup vname schema)
            left(Error{
              resolution = ResolutionError{
                unexpectedShape = UnexpectedShapeError{
                  expected = "bound type variable",
                  actual = concat2
                      "unbound variable "
                      (Name[] vname)}}})
            (inst vname),
      `wrap`=λwt.eithers.bind
            (inst tname wt)
            (λe.right(Term{`wrap` = WrappedTerm{typeName = tname, body = e}}))}
      t