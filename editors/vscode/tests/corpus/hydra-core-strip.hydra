## Annotation and type stripping and normalization
module hydra.core.strip

import hydra.core.lib.lists
import hydra.core.model
import hydra.core.rewriting

## Strip type annotations from the top levels of a term
term deannotateAndDetypeTerm =
  λt.cases(Term){
      annotated=λat.deannotateAndDetypeTerm (AnnotatedTerm[body] at),
      typeApplication=λtt.deannotateAndDetypeTerm (TypeApplicationTerm[body] tt),
      typeLambda=λta.deannotateAndDetypeTerm (TypeLambda[body] ta),
      `_`=t}
      t

## Strip all annotations (including System F type annotations) from the top levels of a term
term deannotateTerm = λt.cases(Term){annotated=λat.deannotateTerm (AnnotatedTerm[body] at), `_`=t} t

## Strip all annotations from a term
term deannotateType = λt.cases(Type){annotated=λ`arg_`.deannotateType (AnnotatedType[body] `arg_`), `_`=t} t

## Strip any top-level type lambdas from a type, extracting the (possibly nested) type body
term deannotateTypeParameters =
  λt.cases(Type){`forall`=λlt.deannotateTypeParameters (ForallType[body] lt), `_`=t} (deannotateType t)

## Recursively strip all annotations from a type
term deannotateTypeRecursive =
  λtyp.
    let strip := λrecurse,typ.
        let rewritten := recurse typ
        in cases(Type){annotated=λat.AnnotatedType[body] at, `_`=rewritten} rewritten
    in rewriteType strip typ

## Recursively strip all annotations from a type scheme
term deannotateTypeSchemeRecursive =
  λts.
    let vars := TypeScheme[variables] ts in
    let typ := TypeScheme[body] ts in
    let constraints := TypeScheme[constraints] ts in
    TypeScheme{variables = vars, body = deannotateTypeRecursive typ, constraints = constraints}

## Strip System F type annotations from the top levels of a term, but leave application-specific annotations intact
term detypeTerm =
  λt.cases(Term){
      annotated=λat.
          let subj := AnnotatedTerm[body] at in
          let ann := AnnotatedTerm[annotation] at in
          Term{annotated = AnnotatedTerm{body = detypeTerm subj, annotation = ann}},
      typeApplication=λtt.deannotateAndDetypeTerm (TypeApplicationTerm[body] tt),
      typeLambda=λta.deannotateAndDetypeTerm (TypeLambda[body] ta),
      `_`=t}
      t

## Recursively remove term annotations, including within subterms
term removeTermAnnotations =
  λ`term`.
    let remove := λrecurse,`term`.
        let rewritten := recurse `term`
        in cases(Term){annotated=λat.AnnotatedTerm[body] at, `_`=rewritten} `term`
    in rewriteTerm remove `term`

## Recursively remove type annotations, including within subtypes
term removeTypeAnnotations =
  λtyp.
    let remove := λrecurse,typ.
        let rewritten := recurse typ
        in cases(Type){annotated=λat.AnnotatedType[body] at, `_`=rewritten} rewritten
    in rewriteType remove typ

## Strip type annotations (TypeLambda, TypeApplication, binding type schemes) from terms while preserving lambda domain types and other annotations
term removeTypeAnnotationsFromTerm =
  λ`term`.
    let strip := λrecurse,`term`.
        let rewritten := recurse `term` in
        let stripBinding := λb.Binding{
              name = Binding[name] b,
              `term` = Binding[`term`] b,
              typeScheme = none} in
        cases(Term){
          `let`=λlt.Term{
                `let` = Let{
                  bindings = `map` stripBinding (Let[bindings] lt),
                  body = Let[body] lt}},
          typeApplication=λtt.TypeApplicationTerm[body] tt,
          typeLambda=λta.TypeLambda[body] ta,
          `_`=rewritten}
          rewritten
    in rewriteTerm strip `term`

## Strip type annotations from terms while preserving other annotations
term removeTypesFromTerm =
  λ`term`.
    let strip := λrecurse,`term`.
        let rewritten := recurse `term` in
        let stripBinding := λb.Binding{
              name = Binding[name] b,
              `term` = Binding[`term`] b,
              typeScheme = none} in
        cases(Term){
          lambda=λl.Term{
                lambda = Lambda{
                  parameter = Lambda[parameter] l,
                  domain = none,
                  body = Lambda[body] l}},
          `let`=λlt.Term{
                `let` = Let{
                  bindings = `map` stripBinding (Let[bindings] lt),
                  body = Let[body] lt}},
          typeApplication=λtt.TypeApplicationTerm[body] tt,
          typeLambda=λta.TypeLambda[body] ta,
          `_`=rewritten}
          rewritten
    in rewriteTerm strip `term`

## Strip outer type lambda wrappers from a term, preserving type application wrappers and annotations
term stripTypeLambdas =
  λt.cases(Term){
      annotated=λat.
          let subj := AnnotatedTerm[body] at in
          let ann := AnnotatedTerm[annotation] at in
          Term{annotated = AnnotatedTerm{body = stripTypeLambdas subj, annotation = ann}},
      typeLambda=λta.stripTypeLambdas (TypeLambda[body] ta),
      `_`=t}
      t