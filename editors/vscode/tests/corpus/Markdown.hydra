## A Markdown document model, used as the target representation for generated documentation
module hydra.core.markdown



type Block = union{
  ## A fenced code block
  codeBlock: CodeBlock,
  ## An ordered or unordered list
  `list`: List,
  ## A paragraph of inline content
  paragraph: Paragraph,
  ## Raw, verbatim passthrough content (e.g. an HTML comment), emitted with no escaping or reformatting. Used for constructs the rest of the Block union cannot represent, such as the generated-file notice banner at the top of a generated page.
  raw: string,
  ## A heading followed by its own block content, nested to form a document outline
  section: Section,
  ## A table
  table: Table}@{description="A block-level Markdown element"}

type CodeBlock = record{
  ## The optional language tag used for syntax highlighting, e.g. "haskell"
  language: optional<string>,
  ## The literal text content of the code block
  content: string}@{description="A fenced code block"}

type Document = record{
  ## The document's top-level title, rendered as an H1 heading
  title: string,
  ## The block-level content of the document, following the title
  content: list<Block>}@{description="A complete Markdown document"}

type Heading = record{
  ## The heading level, where 1 corresponds to an H1 heading; levels increase with nesting depth
  level: int32,
  ## The inline content of the heading
  content: list<Inline>,
  ## An optional explicit anchor identifier for linking directly to this heading. Headings can usually derive an anchor from their rendered text, but an explicit anchor is provided for cases (e.g. renderer-specific slug rules) where that derivation is ambiguous or undesired.
  anchor: optional<string>}@{description="A section heading"}

type Inline = union{
  ## An inline code span
  code: string,
  ## Emphasized (italicized) text
  emphasis: list<Inline>,
  ## A hyperlink
  link: Link,
  ## Strongly emphasized (bolded) text
  strong: list<Inline>,
  ## A raw text fragment
  text: string}@{description="An inline Markdown element"}

type Link = record{
  ## The visible link text
  text: list<Inline>,
  ## The link target, either a URL or a relative path
  target: string}@{description="A hyperlink"}

type List = record{
  ## Whether the list is numbered (ordered) rather than bulleted (unordered)
  ordered: boolean,
  ## The items of the list
  items: list<ListItem>}@{description="An ordered or unordered list"}

type ListItem = wrap(list<Block>)@{description="A single item of a list"}

type Paragraph = record{
  ## The inline content of the paragraph
  content: list<Inline>,
  ## An optional explicit anchor identifier for linking directly to this paragraph. Needed for elements such as rendered provisions, which are bold-led prose within a paragraph rather than a heading, so they carry no heading-derived anchor of their own.
  anchor: optional<string>}@{description="A paragraph of inline content"}

type Section = record{
  ## The section's heading
  heading: Heading,
  ## The block-level content of the section, following the heading
  content: list<Block>,
  ## An optional explicit anchor identifier for linking directly to this section, distinct from the heading's own anchor (a section's anchor identifies the section as a whole; a heading's identifies the heading line specifically).
  anchor: optional<string>}@{description="A heading followed by its own block content, nested to form a document outline"}

type Table = record{
  ## The header row of the table
  header: TableRow,
  ## The data rows of the table
  rows: list<TableRow>}@{description="A table, consisting of a header row and any number of data rows"}

type TableCell = wrap(list<Inline>)@{description="A single cell of a table row"}

type TableRow = wrap(list<TableCell>)@{description="A single row of a table"}