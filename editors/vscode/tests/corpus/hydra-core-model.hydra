## Hydra's core data model, consisting of the fundamental hydra.core.model.Term type and all of its dependencies.
module hydra.core.model



type AnnotatedTerm = record{
  ## The term being annotated
  body: Term,
  ## The annotation as a single term. By convention this is a map term (Name -> Term) so that multiple independent annotations can coexist, but applications are free to use any term shape.
  annotation: Term}@{description="A term together with an annotation"}

type AnnotatedType = record{
  ## The type being annotated
  body: Type,
  ## The annotation as a single term. By convention this is a map term (Name -> Term) so that multiple independent annotations can coexist, but applications are free to use any term shape.
  annotation: Term}@{description="A type together with an annotation"}

type Application = record{
  ## The left-hand side of the application
  function: Term,
  ## The right-hand side of the application
  argument: Term}@{description="A term which applies a function to an argument"}

type ApplicationType = record{
  ## The left-hand side of the application
  function: Type,
  ## The right-hand side of the application
  argument: Type}@{description="The type-level analog of an application term"}

type Binding = record{
  ## The name of the bound variable
  name: Name,
  ## The term to which the variable is bound
  `term`: Term,
  ## The optional type scheme of the bound term
  typeScheme: optional<TypeScheme>}@{description="A field with an optional type scheme, used to bind variables to terms in a 'let' expression"}

type CaseAlternative = record{
  ## The name of the union variant matched by this alternative
  name: Name,
  ## The handler applied to the matched variant's payload
  handler: Term}@{description="A single alternative of a case statement (union elimination): the variant being matched, together with the term that handles it."}

type CaseStatement = record{
  ## The name of the union type
  typeName: Name,
  ## An optional default case, used if none of the explicit cases match
  default: optional<Term>,
  ## A list of case alternatives, one per union variant being handled
  cases: list<CaseAlternative>}@{description="A union elimination; a case statement"}

type EitherType = record{
  ## The 'left' alternative
  `left`: Type,
  ## The 'right' alternative
  `right`: Type}@{description="A type which provides a choice between a 'left' type and a 'right' type"}

type Field = record{
  ## The name of the field
  name: Name,
  ## The value of the field
  `term`: Term}@{description="A name/term pair"}

type FieldType = record{
  ## The name of the field
  name: Name,
  ## The type of the field
  `type`: Type}@{description="A name/type pair"}

type FloatType = union{
  ## A 32-bit floating-point type
  `float32`: unit,
  ## A 64-bit floating-point type
  `float64`: unit}@{description="A floating-point type"}

type FloatValue = union{
  ## A 32-bit floating-point value
  `float32`: float32,
  ## A 64-bit floating-point value
  `float64`: float64}@{description="A floating-point literal value"}

type ForallType = record{
  ## The variable which is bound by the lambda
  parameter: Name,
  ## The body of the lambda
  body: Type}@{description="A universally quantified type; the System F equivalent of a type scheme, and the type-level equivalent of a lambda term."}

type FunctionType = record{
  ## The domain (input) type of the function
  domain: Type,
  ## The codomain (output) type of the function
  codomain: Type}@{description="A function type, also known as an arrow type"}

type Injection = record{
  ## The name of the union type
  typeName: Name,
  ## The field being injected, including its name and value
  field: Field}@{description="An instance of a union type; i.e. a string-indexed generalization of inl() or inr()"}

type IntegerType = union{
  ## An arbitrary-precision integer type
  `bigint`: unit,
  ## An 8-bit signed integer type
  `int8`: unit,
  ## A 16-bit signed integer type
  `int16`: unit,
  ## A 32-bit signed integer type
  `int32`: unit,
  ## A 64-bit signed integer type
  `int64`: unit,
  ## An 8-bit unsigned integer type
  `uint8`: unit,
  ## A 16-bit unsigned integer type
  `uint16`: unit,
  ## A 32-bit unsigned integer type
  `uint32`: unit,
  ## A 64-bit unsigned integer type
  `uint64`: unit}@{description="An integer type"}

type IntegerValue = union{
  ## An arbitrary-precision integer value
  `bigint`: bigint,
  ## An 8-bit signed integer value
  `int8`: int8,
  ## A 16-bit signed integer value (short value)
  `int16`: int16,
  ## A 32-bit signed integer value (int value)
  `int32`: int32,
  ## A 64-bit signed integer value (long value)
  `int64`: int64,
  ## An 8-bit unsigned integer value (byte)
  `uint8`: uint8,
  ## A 16-bit unsigned integer value
  `uint16`: uint16,
  ## A 32-bit unsigned integer value (unsigned int)
  `uint32`: uint32,
  ## A 64-bit unsigned integer value (unsigned long)
  `uint64`: uint64}@{description="An integer literal value"}

type Lambda = record{
  ## The parameter of the lambda
  parameter: Name,
  ## An optional domain type for the lambda
  domain: optional<Type>,
  ## The body of the lambda
  body: Term}@{description="A function abstraction (lambda)"}

type Let = record{
  ## The list of variable bindings
  bindings: list<Binding>,
  ## The body term in which the variables are bound
  body: Term}@{description="A set of (possibly recursive) 'let' bindings together with a body in which they are bound"}

type Literal = union{
  ## A binary literal
  `binary`: binary,
  ## A boolean literal
  `boolean`: boolean,
  ## An arbitrary-precision decimal literal
  `decimal`: decimal,
  ## A floating-point literal
  float: FloatValue,
  ## An integer literal
  integer: IntegerValue,
  ## A string literal
  `string`: string}@{description="A term constant; an instance of a literal type"}

type LiteralType = union{
  ## The type of a binary (byte string) value
  `binary`: unit,
  ## The type of a boolean (true/false) value
  `boolean`: unit,
  ## The type of an arbitrary-precision decimal value
  `decimal`: unit,
  ## The type of a floating-point value
  float: FloatType,
  ## The type of an integer value
  integer: IntegerType,
  ## The type of a string value
  `string`: unit}@{description="Any of a fixed set of literal types, also called atomic types, base types, primitive types, or type constants"}

type MapType = record{
  ## The type of keys in the map
  keys: Type,
  ## The type of values in the map
  values: Type}@{description="A map type"}

type Name = wrap(string)@{description="A unique identifier in some context; a string-valued key"}

type PairType = record{
  ## The first component of the pair
  first: Type,
  ## The second component of the pair
  second: Type}@{description="A type which pairs a 'first' type and a 'second' type"}

type Projection = record{
  ## The name of the record type
  typeName: Name,
  ## The name of the projected field
  fieldName: Name}@{description="A record elimination; a projection"}

type Record = record{
  ## The name of the record type
  typeName: Name,
  ## The fields of the record, as a list of name/term pairs
  fields: list<Field>}@{description="A record, or labeled tuple; a map of field names to terms"}

type Term = union{
  ## A term annotated with metadata
  annotated: AnnotatedTerm,
  ## A function application
  application: Application,
  ## A union elimination; a case statement
  cases: CaseStatement,
  ## An either value
  `either`: either<Term, Term>,
  ## An injection; an instance of a union type
  `inject`: Injection,
  ## A function abstraction (lambda)
  lambda: Lambda,
  ## A 'let' term, which binds variables to terms
  `let`: Let,
  ## A list
  `list`: list<Term>,
  ## A literal value
  literal: Literal,
  ## A map of keys to values
  `map`: map<Term, Term>,
  ## An optional value
  `optional`: optional<Term>,
  ## A pair (2-tuple)
  pair: (Term, Term),
  ## A record elimination; a projection
  `project`: Projection,
  ## A record term
  `record`: Record,
  ## A set of values
  `set`: set<Term>,
  ## A System F type application term
  typeApplication: TypeApplicationTerm,
  ## A System F type abstraction term
  typeLambda: TypeLambda,
  ## A unit value; a term with no value
  `unit`: unit,
  ## An unwrap elimination; the inverse of a wrap. Given the name of a wrapper type, unwraps an instance of that type to its underlying body value.
  `unwrap`: Name,
  ## A variable reference
  variable: Name,
  ## A wrapped term; an instance of a wrapper type (newtype)
  `wrap`: WrappedTerm}@{description="A data term"}

type Type = union{
  ## An annotated type
  annotated: AnnotatedType,
  ## A type application
  application: ApplicationType,
  ## An effectful computation which, when interpreted by a host application, may perform host interactions and produce a value of the given type
  `effect`: Type,
  ## An either (sum) type
  `either`: EitherType,
  ## A universally quantified (polymorphic) type
  `forall`: ForallType,
  ## A function type
  function: FunctionType,
  ## A list type
  `list`: Type,
  ## A literal type
  literal: LiteralType,
  ## A map type
  `map`: MapType,
  ## An optional type
  `optional`: Type,
  ## A pair (2-tuple) type
  pair: PairType,
  ## A record type
  `record`: list<FieldType>,
  ## A set type
  `set`: Type,
  ## A union type with field names
  `union`: list<FieldType>,
  ## The unit type — the nullary conjunction; one inhabitant. Dual to `void`.
  `unit`: unit,
  ## A type variable
  variable: Name,
  ## The void (uninhabited, or bottom) type — the nullary disjunction; zero inhabitants. Dual to `unit`.
  `void`: unit,
  ## A wrapped type (newtype). There is no corresponding `unwrap` variant at the type level: wrap is the introduction form, and a wrapper type's underlying body type is given by the `wrap` variant's argument.
  `wrap`: Type}@{description="A data type"}

type TypeApplicationTerm = record{
  ## The term being applied to a type
  body: Term,
  ## The type argument
  `type`: Type}@{description="A term applied to a type; a type application."}

type TypeClassConstraint = union{
  ## A simple type class constraint, naming a single type class
  simple: Name}@{description="A type class constraint on a type variable. Currently has only one variant, but designed to be forward-compatible with multi-parameter type classes and constraints on type expressions."}

type TypeLambda = record{
  ## The type variable introduced by the abstraction
  parameter: Name,
  ## The body of the abstraction
  body: Term}@{description="A System F type abstraction term"}

type TypeScheme = record{
  ## The free type variables
  variables: list<Name>,
  ## The type expression
  body: Type,
  ## Constraints on type variables, including typeclass constraints. The map keys are type variable names; an empty map means no constraints.
  constraints: map<Name, TypeVariableConstraints>}@{description="A type expression together with free type variables occurring in the expression"}

type TypeVariableConstraints = record{
  ## The typeclass constraints on this type variable
  classes: set<TypeClassConstraint>}@{description="Constraints associated with a type variable, including typeclass constraints"}

type WrappedTerm = record{
  ## The name of the wrapper type
  typeName: Name,
  ## The wrapped term
  body: Term}@{description="A term wrapped in a type name"}