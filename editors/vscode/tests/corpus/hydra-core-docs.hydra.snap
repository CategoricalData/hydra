>## A segment of a documentation string, either a raw text fragment or an inline entity reference. Documentation strings are parsed into a sequence of DocSegments for host-specific rendering.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>type DocSegment = union{
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^ source.hydra entity.name.function.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.equals.hydra
#                 ^ source.hydra
#                  ^^^^^ source.hydra support.type.hydra
#                       ^^ source.hydra
>  ## An inline reference to a Hydra entity
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  ref: packaging.EntityReference,
#^^ source.hydra
#  ^^^ source.hydra variable.other.hydra
#     ^ source.hydra punctuation.separator.type.hydra
#      ^ source.hydra
#       ^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                ^^ source.hydra
>  ## A raw prose fragment, passed through verbatim
#^^ source.hydra
