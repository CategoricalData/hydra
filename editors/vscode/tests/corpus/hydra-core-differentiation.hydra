## Source-to-source automatic differentiation for Float64 terms.
module hydra.core.differentiation

import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.optionals
import hydra.core.lib.pairs
import hydra.core.model

## Differentiate a binary primitive application given both arguments and their derivatives
term differentiateBinary =
  λbfname,a,b,da,db.ifElse
      (or
        (equal bfname Name{"hydra.core.lib.math.add"})
        (equal bfname Name{"hydra.core.lib.math.addFloat64"}))
      Term{
        application = Application{
          function = Term{
            application = Application{
              function = Term{
                variable = Name{"hydra.core.lib.math.addFloat64"}},
              argument = da}},
          argument = db}}
      (ifElse
        (or
          (equal bfname Name{"hydra.core.lib.math.sub"})
          (equal bfname Name{"hydra.core.lib.math.subFloat64"}))
        Term{
          application = Application{
            function = Term{
              application = Application{
                function = Term{
                  variable = Name{"hydra.core.lib.math.subFloat64"}},
                argument = da}},
            argument = db}}
        (ifElse
          (or
            (equal bfname Name{"hydra.core.lib.math.mul"})
            (equal bfname Name{"hydra.core.lib.math.mulFloat64"}))
          Term{
            application = Application{
              function = Term{
                application = Application{
                  function = Term{
                    variable = Name{"hydra.core.lib.math.addFloat64"}},
                  argument = Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.math.mulFloat64"}},
                          argument = a}},
                      argument = db}}}},
              argument = Term{
                application = Application{
                  function = Term{
                    application = Application{
                      function = Term{
                        variable = Name{"hydra.core.lib.math.mulFloat64"}},
                      argument = b}},
                  argument = da}}}}
          (ifElse
            (equal bfname Name{"hydra.core.lib.math.pow"})
            Term{
              application = Application{
                function = Term{
                  application = Application{
                    function = Term{
                      variable = Name{"hydra.core.lib.math.mulFloat64"}},
                    argument = Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.pow"}},
                            argument = a}},
                        argument = b}}}},
                argument = Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          variable = Name{"hydra.core.lib.math.addFloat64"}},
                        argument = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                argument = db}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.math.log"}},
                                argument = a}}}}}},
                    argument = Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.mulFloat64"}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                    argument = b}},
                                argument = da}}}},
                        argument = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.math.pow"}},
                                argument = a}},
                            argument = Term{
                              literal = Literal{
                                float = FloatValue{
                                  `float64` = -1.0:float64}}}}}}}}}}}
            (ifElse
              (equal bfname Name{"hydra.core.lib.math.atan2"})
              Term{
                application = Application{
                  function = Term{
                    application = Application{
                      function = Term{
                        variable = Name{"hydra.core.lib.math.mulFloat64"}},
                      argument = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"hydra.core.lib.math.subFloat64"}},
                              argument = Term{
                                application = Application{
                                  function = Term{
                                    application = Application{
                                      function = Term{
                                        variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                      argument = b}},
                                  argument = da}}}},
                          argument = Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                  argument = a}},
                              argument = db}}}}}},
                  argument = Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.math.pow"}},
                          argument = Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.math.addFloat64"}},
                                  argument = Term{
                                    application = Application{
                                      function = Term{
                                        application = Application{
                                          function = Term{
                                            variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                          argument = a}},
                                      argument = a}}}},
                              argument = Term{
                                application = Application{
                                  function = Term{
                                    application = Application{
                                      function = Term{
                                        variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                      argument = b}},
                                  argument = b}}}}}},
                      argument = Term{
                        literal = Literal{
                          float = FloatValue{
                            `float64` = -1.0:float64}}}}}}}
              (ifElse
                (equal bfname Name{"hydra.core.lib.math.logBase"})
                Term{
                  application = Application{
                    function = Term{
                      application = Application{
                        function = Term{
                          variable = Name{"hydra.core.lib.math.mulFloat64"}},
                        argument = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.math.subFloat64"}},
                                argument = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                        argument = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.log"}},
                                            argument = a}}}},
                                    argument = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                            argument = db}},
                                        argument = Term{
                                          application = Application{
                                            function = Term{
                                              application = Application{
                                                function = Term{
                                                  variable = Name{"hydra.core.lib.math.pow"}},
                                                argument = b}},
                                            argument = Term{
                                              literal = Literal{
                                                float = FloatValue{
                                                  `float64` = -1.0:float64}}}}}}}}}}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                    argument = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.log"}},
                                        argument = b}}}},
                                argument = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                        argument = da}},
                                    argument = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.pow"}},
                                            argument = a}},
                                        argument = Term{
                                          literal = Literal{
                                            float = FloatValue{
                                              `float64` = -1.0:float64}}}}}}}}}}}}},
                    argument = Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.pow"}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                    argument = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.log"}},
                                        argument = a}}}},
                                argument = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.log"}},
                                    argument = a}}}}}},
                        argument = Term{
                          literal = Literal{
                            float = FloatValue{
                              `float64` = -1.0:float64}}}}}}}
                Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}})))))

## Differentiate a function term (Float64 -> Float64) with respect to its parameter
term differentiateFunction =
  λ`term`.cases(Term){
      annotated=λat.differentiateFunction (AnnotatedTerm[body] at),
      lambda=λl.
          let paramName := Lambda[parameter] l in
          let body := Lambda[body] l in
          Term{
            lambda = Lambda{
              parameter = paramName,
              domain = Lambda[domain] l,
              body = differentiateTerm paramName body}},
      `_`=`term`}
      `term`

## Differentiate a term with respect to a named variable
term differentiateTerm =
  λdx,`term`.cases(Term){
      variable=λv.ifElse
            (equal v dx)
            Term{literal = Literal{float = FloatValue{`float64` = 1.0:float64}}}
            Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      literal=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      application=λapp.
          let func := Application[function] app in
          let arg := Application[argument] app in
          cases(Term){
            variable=λfname.match
                  (primitiveDerivative fname)
                  (differentiateTerm
                    dx
                    Term{
                      application = Application{
                        function = func,
                        argument = arg}})
                  (λderivTerm.Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.mulFloat64"}},
                            argument = Term{
                              application = Application{
                                function = derivTerm,
                                argument = arg}}}},
                        argument = differentiateTerm dx arg}}),
            application=λinnerApp.
                let innerFunc := Application[function] innerApp in
                let innerArg := Application[argument] innerApp in
                cases(Term){
                  variable=λbfname.differentiateBinary
                        bfname
                        innerArg
                        arg
                        (differentiateTerm dx innerArg)
                        (differentiateTerm dx arg),
                  `_`=Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.math.mulFloat64"}},
                          argument = differentiateTerm
                              dx
                              Term{
                                application = Application{
                                  function = func,
                                  argument = arg}}}},
                      argument = differentiateTerm dx arg}}}
                  innerFunc,
            `_`=Term{
              application = Application{
                function = Term{
                  application = Application{
                    function = Term{
                      variable = Name{"hydra.core.lib.math.mulFloat64"}},
                    argument = differentiateTerm
                        dx
                        Term{
                          application = Application{
                            function = func,
                            argument = arg}}}},
                argument = differentiateTerm dx arg}}}
            func,
      lambda=λl.ifElse
            (equal (Lambda[parameter] l) dx)
            Term{
              lambda = Lambda{
                parameter = Lambda[parameter] l,
                domain = Lambda[domain] l,
                body = Term{
                  literal = Literal{
                    float = FloatValue{
                      `float64` = 0.0:float64}}}}}
            Term{
              lambda = Lambda{
                parameter = Lambda[parameter] l,
                domain = Lambda[domain] l,
                body = differentiateTerm dx (Lambda[body] l)}},
      `cases`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `project`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `unwrap`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `let`=λl.Term{
            `let` = Let{
              bindings = lists.map
                  (λb.Binding{
                      name = Binding[name] b,
                      `term` = differentiateTerm dx (Binding[`term`] b),
                      typeScheme = none})
                  (Let[bindings] l),
              body = differentiateTerm dx (Let[body] l)}},
      annotated=λat.differentiateTerm dx (AnnotatedTerm[body] at),
      `list`=λelems.Term{`list` = lists.map (differentiateTerm dx) elems},
      pair=λp.Term{pair = (differentiateTerm dx (first p), differentiateTerm dx (second p))},
      `record`=λr.Term{
            `record` = Record{
              typeName = Record[typeName] r,
              fields = lists.map
                  (λfld.Field{
                      name = Field[name] fld,
                      `term` = differentiateTerm dx (Field[`term`] fld)})
                  (Record[fields] r)}},
      typeApplication=λta.differentiateTerm dx (TypeApplicationTerm[body] ta),
      typeLambda=λtl.differentiateTerm dx (TypeLambda[body] tl),
      `unit`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `set`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `map`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `either`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `optional`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `inject`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}},
      `wrap`=λ`_`.Term{literal = Literal{float = FloatValue{`float64` = 0.0:float64}}}}
      `term`

## Compute the gradient of a term as a record of partial derivatives
term gradient =
  λtypeName,vars,`term`.Term{
      `record` = Record{
        typeName = typeName,
        fields = lists.map
            (λv.Field{name = v, `term` = differentiateTerm v `term`})
            vars}}

## Look up the derivative of a unary Float64 primitive
term primitiveDerivative =
  λname.ifElse
      (equal name Name{"hydra.core.lib.math.sin"})
      given(Term{variable = Name{"hydra.core.lib.math.cos"}})
      (ifElse
        (equal name Name{"hydra.core.lib.math.cos"})
        given(Term{
          lambda = Lambda{
            parameter = Name{"_x"},
            domain = none,
            body = Term{
              application = Application{
                function = Term{
                  variable = Name{"hydra.core.lib.math.negateFloat64"}},
                argument = Term{
                  application = Application{
                    function = Term{
                      variable = Name{"hydra.core.lib.math.sin"}},
                    argument = Term{
                      variable = Name{"_x"}}}}}}}})
        (ifElse
          (equal name Name{"hydra.core.lib.math.tan"})
          given(Term{
            lambda = Lambda{
              parameter = Name{"_x"},
              domain = none,
              body = Term{
                application = Application{
                  function = Term{
                    application = Application{
                      function = Term{
                        variable = Name{"hydra.core.lib.math.pow"}},
                      argument = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.math.cos"}},
                          argument = Term{
                            variable = Name{"_x"}}}}}},
                  argument = Term{
                    literal = Literal{
                      float = FloatValue{
                        `float64` = -2.0:float64}}}}}}})
          (ifElse
            (equal name Name{"hydra.core.lib.math.exp"})
            given(Term{variable = Name{"hydra.core.lib.math.exp"}})
            (ifElse
              (equal name Name{"hydra.core.lib.math.log"})
              given(Term{
                lambda = Lambda{
                  parameter = Name{"_x"},
                  domain = none,
                  body = Term{
                    application = Application{
                      function = Term{
                        application = Application{
                          function = Term{
                            variable = Name{"hydra.core.lib.math.pow"}},
                          argument = Term{
                            variable = Name{"_x"}}}},
                      argument = Term{
                        literal = Literal{
                          float = FloatValue{
                            `float64` = -1.0:float64}}}}}}})
              (ifElse
                (equal name Name{"hydra.core.lib.math.sqrt"})
                given(Term{
                  lambda = Lambda{
                    parameter = Name{"_x"},
                    domain = none,
                    body = Term{
                      application = Application{
                        function = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.mulFloat64"}},
                            argument = Term{
                              literal = Literal{
                                float = FloatValue{
                                  `float64` = 0.5:float64}}}}},
                        argument = Term{
                          application = Application{
                            function = Term{
                              application = Application{
                                function = Term{
                                  variable = Name{"hydra.core.lib.math.pow"}},
                                argument = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.sqrt"}},
                                    argument = Term{
                                      variable = Name{"_x"}}}}}},
                            argument = Term{
                              literal = Literal{
                                float = FloatValue{
                                  `float64` = -1.0:float64}}}}}}}}})
                (ifElse
                  (equal name Name{"hydra.core.lib.math.asin"})
                  given(Term{
                    lambda = Lambda{
                      parameter = Name{"_x"},
                      domain = none,
                      body = Term{
                        application = Application{
                          function = Term{
                            application = Application{
                              function = Term{
                                variable = Name{"hydra.core.lib.math.pow"}},
                              argument = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.math.sqrt"}},
                                  argument = Term{
                                    application = Application{
                                      function = Term{
                                        application = Application{
                                          function = Term{
                                            variable = Name{"hydra.core.lib.math.subFloat64"}},
                                          argument = Term{
                                            literal = Literal{
                                              float = FloatValue{
                                                `float64` = 1.0:float64}}}}},
                                      argument = Term{
                                        application = Application{
                                          function = Term{
                                            application = Application{
                                              function = Term{
                                                variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                              argument = Term{
                                                variable = Name{"_x"}}}},
                                          argument = Term{
                                            variable = Name{"_x"}}}}}}}}}},
                          argument = Term{
                            literal = Literal{
                              float = FloatValue{
                                `float64` = -1.0:float64}}}}}}})
                  (ifElse
                    (equal name Name{"hydra.core.lib.math.acos"})
                    given(Term{
                      lambda = Lambda{
                        parameter = Name{"_x"},
                        domain = none,
                        body = Term{
                          application = Application{
                            function = Term{
                              variable = Name{"hydra.core.lib.math.negateFloat64"}},
                            argument = Term{
                              application = Application{
                                function = Term{
                                  application = Application{
                                    function = Term{
                                      variable = Name{"hydra.core.lib.math.pow"}},
                                    argument = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.sqrt"}},
                                        argument = Term{
                                          application = Application{
                                            function = Term{
                                              application = Application{
                                                function = Term{
                                                  variable = Name{"hydra.core.lib.math.subFloat64"}},
                                                argument = Term{
                                                  literal = Literal{
                                                    float = FloatValue{
                                                      `float64` = 1.0:float64}}}}},
                                            argument = Term{
                                              application = Application{
                                                function = Term{
                                                  application = Application{
                                                    function = Term{
                                                      variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                                    argument = Term{
                                                      variable = Name{"_x"}}}},
                                                argument = Term{
                                                  variable = Name{"_x"}}}}}}}}}},
                                argument = Term{
                                  literal = Literal{
                                    float = FloatValue{
                                      `float64` = -1.0:float64}}}}}}}}})
                    (ifElse
                      (equal name Name{"hydra.core.lib.math.atan"})
                      given(Term{
                        lambda = Lambda{
                          parameter = Name{"_x"},
                          domain = none,
                          body = Term{
                            application = Application{
                              function = Term{
                                application = Application{
                                  function = Term{
                                    variable = Name{"hydra.core.lib.math.pow"}},
                                  argument = Term{
                                    application = Application{
                                      function = Term{
                                        application = Application{
                                          function = Term{
                                            variable = Name{"hydra.core.lib.math.addFloat64"}},
                                          argument = Term{
                                            literal = Literal{
                                              float = FloatValue{
                                                `float64` = 1.0:float64}}}}},
                                      argument = Term{
                                        application = Application{
                                          function = Term{
                                            application = Application{
                                              function = Term{
                                                variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                              argument = Term{
                                                variable = Name{"_x"}}}},
                                          argument = Term{
                                            variable = Name{"_x"}}}}}}}},
                              argument = Term{
                                literal = Literal{
                                  float = FloatValue{
                                    `float64` = -1.0:float64}}}}}}})
                      (ifElse
                        (equal name Name{"hydra.core.lib.math.sinh"})
                        given(Term{variable = Name{"hydra.core.lib.math.cosh"}})
                        (ifElse
                          (equal name Name{"hydra.core.lib.math.cosh"})
                          given(Term{variable = Name{"hydra.core.lib.math.sinh"}})
                          (ifElse
                            (equal name Name{"hydra.core.lib.math.tanh"})
                            given(Term{
                              lambda = Lambda{
                                parameter = Name{"_x"},
                                domain = none,
                                body = Term{
                                  application = Application{
                                    function = Term{
                                      application = Application{
                                        function = Term{
                                          variable = Name{"hydra.core.lib.math.subFloat64"}},
                                        argument = Term{
                                          literal = Literal{
                                            float = FloatValue{
                                              `float64` = 1.0:float64}}}}},
                                    argument = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                            argument = Term{
                                              application = Application{
                                                function = Term{
                                                  variable = Name{"hydra.core.lib.math.tanh"}},
                                                argument = Term{
                                                  variable = Name{"_x"}}}}}},
                                        argument = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.tanh"}},
                                            argument = Term{
                                              variable = Name{"_x"}}}}}}}}}})
                            (ifElse
                              (equal name Name{"hydra.core.lib.math.asinh"})
                              given(Term{
                                lambda = Lambda{
                                  parameter = Name{"_x"},
                                  domain = none,
                                  body = Term{
                                    application = Application{
                                      function = Term{
                                        application = Application{
                                          function = Term{
                                            variable = Name{"hydra.core.lib.math.pow"}},
                                          argument = Term{
                                            application = Application{
                                              function = Term{
                                                variable = Name{"hydra.core.lib.math.sqrt"}},
                                              argument = Term{
                                                application = Application{
                                                  function = Term{
                                                    application = Application{
                                                      function = Term{
                                                        variable = Name{"hydra.core.lib.math.addFloat64"}},
                                                      argument = Term{
                                                        application = Application{
                                                          function = Term{
                                                            application = Application{
                                                              function = Term{
                                                                variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                                              argument = Term{
                                                                variable = Name{"_x"}}}},
                                                          argument = Term{
                                                            variable = Name{"_x"}}}}}},
                                                  argument = Term{
                                                    literal = Literal{
                                                      float = FloatValue{
                                                        `float64` = 1.0:float64}}}}}}}}},
                                      argument = Term{
                                        literal = Literal{
                                          float = FloatValue{
                                            `float64` = -1.0:float64}}}}}}})
                              (ifElse
                                (equal name Name{"hydra.core.lib.math.acosh"})
                                given(Term{
                                  lambda = Lambda{
                                    parameter = Name{"_x"},
                                    domain = none,
                                    body = Term{
                                      application = Application{
                                        function = Term{
                                          application = Application{
                                            function = Term{
                                              variable = Name{"hydra.core.lib.math.pow"}},
                                            argument = Term{
                                              application = Application{
                                                function = Term{
                                                  variable = Name{"hydra.core.lib.math.sqrt"}},
                                                argument = Term{
                                                  application = Application{
                                                    function = Term{
                                                      application = Application{
                                                        function = Term{
                                                          variable = Name{"hydra.core.lib.math.subFloat64"}},
                                                        argument = Term{
                                                          application = Application{
                                                            function = Term{
                                                              application = Application{
                                                                function = Term{
                                                                  variable = Name{"hydra.core.lib.math.mulFloat64"}},
                                                                argument = Term{
                                                                  variable = Name{"_x"}}}},
                                                            argument = Term{
                                                              variable = Name{"_x"}}}}}},
                                                    argument = Term{
                                                      literal = Literal{
                                                        float = FloatValue{
                                                          `float64` = 1.0:float64}}}}}}}}},
                                        argument = Term{
                                          literal = Literal{
                                            float = FloatValue{
