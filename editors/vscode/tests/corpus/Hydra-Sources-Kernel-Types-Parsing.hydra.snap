>## An error which occurred while parsing
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>type ParseError = record{
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^ source.hydra entity.name.function.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.equals.hydra
#                 ^ source.hydra
#                  ^^^^^^ source.hydra keyword.control.hydra
#                        ^^ source.hydra
>  ## An error message
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  message: string,
#^^ source.hydra
#  ^^^^^^^ source.hydra variable.other.hydra
#         ^ source.hydra punctuation.separator.type.hydra
#          ^ source.hydra
#           ^^^^^^ source.hydra support.type.hydra
#                 ^^ source.hydra
>  ## The remaining input at the point of failure
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  remainder: ParseInput}
#^^ source.hydra
#  ^^^^^^^^^ source.hydra variable.other.hydra
#           ^ source.hydra punctuation.separator.type.hydra
#            ^ source.hydra
#             ^^^^^^^^^^ source.hydra variable.other.hydra
#                       ^^ source.hydra
>
>## The input state threaded through a parser: the unconsumed codepoints, together with the number of codepoints already consumed, and where the last token ended. The offset makes the absolute source position of any parse step available in constant time, without rescanning the input.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>type ParseInput = record{
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^ source.hydra entity.name.function.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.equals.hydra
#                 ^ source.hydra
#                  ^^^^^^ source.hydra keyword.control.hydra
#                        ^^ source.hydra
>  ## The number of codepoints consumed so far, i.e. the absolute offset of the first remaining codepoint
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  offset: int32,
#^^ source.hydra
#  ^^^^^^ source.hydra variable.other.hydra
#        ^ source.hydra punctuation.separator.type.hydra
#         ^ source.hydra
#          ^^^^^ source.hydra support.type.hydra
#               ^^ source.hydra
>  ## The offset just past the most recently completed token, excluding any whitespace or comments that followed it. Used to give source spans a tight end
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  tokenEnd: int32,
#^^ source.hydra
#  ^^^^^^^^ source.hydra variable.other.hydra
#          ^ source.hydra punctuation.separator.type.hydra
#           ^ source.hydra
#            ^^^^^ source.hydra support.type.hydra
#                 ^^ source.hydra
>  ## The remaining unparsed input, as codepoints. Represented as a list rather than a string, so that consuming one character is a constant-time operation
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  codepoints: list<int32>}
#^^ source.hydra
#  ^^^^^^^^^^ source.hydra variable.other.hydra
#            ^ source.hydra punctuation.separator.type.hydra
#             ^ source.hydra
#              ^^^^ source.hydra support.type.hydra
#                  ^ source.hydra punctuation.definition.typeargs.begin.hydra
#                   ^^^^^ source.hydra support.type.hydra
#                        ^ source.hydra punctuation.definition.typeargs.end.hydra
#                         ^^ source.hydra
>
>## The result of a parse operation
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>type ParseResult = forall a. union{
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                ^ source.hydra
#                 ^ source.hydra keyword.operator.equals.hydra
#                  ^ source.hydra
#                   ^^^^^^ source.hydra support.type.hydra
#                         ^ source.hydra
#                          ^ source.hydra variable.parameter.hydra
#                           ^ source.hydra punctuation.separator.binder.hydra
#                            ^ source.hydra
#                             ^^^^^ source.hydra support.type.hydra
#                                  ^^ source.hydra
>  ## A successful parse, with a value and the remaining unparsed input
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  success: ParseSuccess a,
#^^ source.hydra
#  ^^^^^^^ source.hydra variable.other.hydra
#         ^ source.hydra punctuation.separator.type.hydra
#          ^ source.hydra
#           ^^^^^^^^^^^^ source.hydra variable.other.hydra
#                       ^ source.hydra
#                        ^ source.hydra variable.other.hydra
#                         ^^ source.hydra
>  ## A failed parse, with an error message and the remaining input
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  failure: ParseError}
#^^ source.hydra
#  ^^^^^^^ source.hydra variable.other.hydra
#         ^ source.hydra punctuation.separator.type.hydra
#          ^ source.hydra
#           ^^^^^^^^^^ source.hydra variable.other.hydra
#                     ^^ source.hydra
>
>## A successful parse result
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>type ParseSuccess = forall a. record{
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                 ^ source.hydra
#                  ^ source.hydra keyword.operator.equals.hydra
#                   ^ source.hydra
#                    ^^^^^^ source.hydra support.type.hydra
