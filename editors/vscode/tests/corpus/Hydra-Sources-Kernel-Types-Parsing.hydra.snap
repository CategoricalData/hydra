#    ^ source.hydra
#     ^^^^^^^^^^ source.hydra entity.name.function.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.equals.hydra
#                 ^ source.hydra
#                  ^^^^^^ source.hydra keyword.control.hydra
#                        ^^ source.hydra
>  ## The offset of the first codepoint of the span
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  start: int32,
#^^ source.hydra
#  ^^^^^ source.hydra variable.other.hydra
#       ^ source.hydra punctuation.separator.type.hydra
#        ^ source.hydra
#         ^^^^^ source.hydra support.type.hydra
#              ^^ source.hydra
>  ## The offset one past the last codepoint of the span
#^^ source.hydra
#  ^^ source.hydra comment.block.documentation.hydra
#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  end: int32}
#^^ source.hydra
#  ^^^ source.hydra variable.other.hydra
#     ^ source.hydra punctuation.separator.type.hydra
#      ^ source.hydra
#       ^^^^^ source.hydra support.type.hydra
