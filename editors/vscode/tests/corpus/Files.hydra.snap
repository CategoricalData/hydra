#                                                                                 ^^^^^^ source.hydra support.type.hydra
#                                                                                       ^ source.hydra punctuation.definition.typeargs.begin.hydra
#                                                                                        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                                                                       ^^ source.hydra
