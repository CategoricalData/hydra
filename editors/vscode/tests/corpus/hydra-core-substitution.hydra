## Variable substitution in type and term expressions.
module hydra.core.substitution

import hydra.core.classes
import hydra.core.graph
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.rewriting
import hydra.core.typing
import hydra.core.variables

## Compose two type substitutions
term composeTypeSubst =
  λs1,s2.ifElse
      (maps.isEmpty (TypeSubst[] s1))
      s2
      (ifElse (maps.isEmpty (TypeSubst[] s2)) s1 (composeTypeSubstNonEmpty s1 s2))

## Compose a list of type substitutions
term composeTypeSubstList = lists.foldl composeTypeSubst idTypeSubst

## Compose two non-empty type substitutions (internal helper)
term composeTypeSubstNonEmpty =
  λs1,s2.
    let isExtra := λk,v.optionals.isNone (maps.lookup k (TypeSubst[] s1)), withExtra := maps.filterWithKey isExtra (TypeSubst[] s2)
    in TypeSubst{maps.union withExtra (maps.map (substInType s2) (TypeSubst[] s1))}

## The identity type substitution
term idTypeSubst = wrap(TypeSubst){maps.empty}

## Create a type substitution with a single variable mapping
term singletonTypeSubst = λv,t.TypeSubst{maps.singleton v t}

## Apply a type substitution to class constraints, propagating to free variables or discharging/retaining on concrete resolution
term substInClassConstraints =
  λsubst,constraints.
    let substMap := TypeSubst[] subst
    in ifElse
      (or (maps.isEmpty substMap) (maps.isEmpty constraints))
      constraints
      (let isGenuineVarName := λname.lte (lists.length (splitOn "." (Name[] name))) 1:int32 in
      let insertOrMerge := λvarName,metadata,acc.optionals.match
            (maps.lookup varName acc)
            (maps.insert varName metadata acc)
            (λexisting.
              let merged := TypeVariableConstraints{
                classes = sets.union
                    (TypeVariableConstraints[classes]
                      existing)
                    (TypeVariableConstraints[classes]
                      metadata)}
              in maps.insert varName merged acc) in
      lists.foldl
        (λacc,pair.
          let varName := first pair in
          let metadata := second pair in
          optionals.match
            (maps.lookup varName substMap)
            (insertOrMerge varName metadata acc)
            (λtargetType.
              let genuineVars := lists.filter
                  isGenuineVarName
                  (sets.toList (freeVariablesInType targetType))
              in ifElse
                (not (lists.isEmpty genuineVars))
                (lists.foldl
                  (λacc2,freeVar.insertOrMerge freeVar metadata acc2)
                  acc
                  genuineVars)
                (let unsatisfied := sets.filter
                    (λc.not
                        (classIsSatisfiedByType
                          (cases(TypeClassConstraint){simple=λn.n} c)
                          targetType))
                    (TypeVariableConstraints[classes] metadata)
                in ifElse
                  (sets.isEmpty unsatisfied)
                  acc
                  (insertOrMerge varName TypeVariableConstraints{classes = unsatisfied} acc))))
        maps.empty
        (maps.toList constraints))

## Apply a type substitution to a graph's bound types and class constraints
term substInContext =
  λsubst,cx.
    let newBoundTypes := maps.map (substInTypeScheme subst) (Graph[boundTypes] cx) in
    let newClassConstraints := substInClassConstraints subst (Graph[classConstraints] cx) in
    let cx2 := Graph{
      boundTerms = Graph[boundTerms] cx,
      boundTypes = newBoundTypes,
      classConstraints = Graph[classConstraints] cx,
      lambdaVariables = Graph[lambdaVariables] cx,
      metadata = Graph[metadata] cx,
      primitives = Graph[primitives] cx,
      schemaTypes = Graph[schemaTypes] cx,
      typeVariables = Graph[typeVariables] cx} in
    Graph{
      boundTerms = Graph[boundTerms] cx2,
      boundTypes = Graph[boundTypes] cx2,
      classConstraints = newClassConstraints,
      lambdaVariables = Graph[lambdaVariables] cx2,
      metadata = Graph[metadata] cx2,
      primitives = Graph[primitives] cx2,
      schemaTypes = Graph[schemaTypes] cx2,
      typeVariables = Graph[typeVariables] cx2}

## Apply a type substitution to a type
term substInType = λsubst,typ0.ifElse (maps.isEmpty (TypeSubst[] subst)) typ0 (substInTypeNonEmpty subst typ0)

## Apply a non-empty type substitution to a type (internal helper)
term substInTypeNonEmpty =
  λsubst,typ0.
    let rewrite := λrecurse,typ.cases(Type){
          `forall`=λlt.optionals.match
                (maps.lookup
                  (ForallType[parameter] lt)
                  (TypeSubst[] subst))
                (recurse typ)
                (λstyp.Type{
                    `forall` = ForallType{
                      parameter = ForallType[parameter] lt,
                      body = substInType
                          (removeVar (ForallType[parameter] lt))
                          (ForallType[body] lt)}}),
          variable=λv.optionals.match
                (maps.lookup v (TypeSubst[] subst))
                typ
                (λstyp.styp),
          `_`=recurse typ}
          typ, removeVar := λv.TypeSubst{maps.delete v (TypeSubst[] subst)}
    in rewriteType rewrite typ0

## Apply a type substitution to a type scheme. The scheme's quantifier variables shadow the substitution: any name in typeSchemeVariables is removed from subst before substituting into the body and constraints. Without this, a substitution like {t0 -> Foo} applied to `forall [t0]. t0 -> t0` would incorrectly replace the bound t0.
term substInTypeScheme =
  λsubst,ts.
    let scopedSubst := TypeSubst{lists.foldl
      (λm,v.maps.delete v m)
      (TypeSubst[] subst)
      (TypeScheme[variables] ts)}
    in TypeScheme{
      variables = TypeScheme[variables] ts,
      body = substInType scopedSubst (TypeScheme[body] ts),
      constraints = substInClassConstraints scopedSubst (TypeScheme[constraints] ts)}

## Apply a type substitution to the type annotations within a term
term substTypesInTerm =
  λsubst,term0.
    let rewrite := λrecurse,`term`.
        let dflt := recurse `term`, forLambda := λl.Term{
              lambda = Lambda{
                parameter = Lambda[parameter] l,
                domain = optionals.map
                    (substInType subst)
                    (Lambda[domain] l),
                body = substTypesInTerm subst (Lambda[body] l)}}, forLet := λl.
            let rewriteBinding := λb.Binding{
                  name = Binding[name] b,
                  `term` = substTypesInTerm
                      subst
                      (Binding[`term`] b),
                  typeScheme = optionals.map
                      (substInTypeScheme subst)
                      (Binding[typeScheme] b)}
            in Term{
              `let` = Let{
                bindings = lists.map
                    rewriteBinding
                    (Let[bindings] l),
                body = substTypesInTerm subst (Let[body] l)}}, forTypeApplication := λtt.Term{
              typeApplication = TypeApplicationTerm{
                body = substTypesInTerm
                    subst
                    (TypeApplicationTerm[body] tt),
                `type` = substInType
                    subst
                    (TypeApplicationTerm[`type`] tt)}}, forTypeLambda := λta.
            let param := TypeLambda[parameter] ta, subst2 := TypeSubst{maps.delete param (TypeSubst[] subst)}
            in Term{
              typeLambda = TypeLambda{
                parameter = param,
                body = substTypesInTerm
                    subst2
                    (TypeLambda[body] ta)}}
        in cases(Term){
          lambda=λl.forLambda l,
          `let`=λl.forLet l,
          typeApplication=λta.forTypeApplication ta,
          typeLambda=λtl.forTypeLambda tl,
          `_`=dflt}
          `term`
    in rewriteTerm rewrite term0

## Apply a term substitution to a binding
term substituteInBinding =
  λsubst,b.Binding{
      name = Binding[name] b,
      `term` = substituteInTerm subst (Binding[`term`] b),
      typeScheme = Binding[typeScheme] b}

## Apply a type substitution to a type constraint
term substituteInConstraint =
  λsubst,c.TypeConstraint{
      `left` = substInType subst (TypeConstraint[`left`] c),
      `right` = substInType subst (TypeConstraint[`right`] c),
      comment = TypeConstraint[comment] c}

## Apply a type substitution to a list of type constraints
term substituteInConstraints = λsubst,cs.lists.map (substituteInConstraint subst) cs

## Apply a term substitution to a term
term substituteInTerm =
  λsubst,term0.
    let s := TermSubst[] subst, rewrite := λrecurse,`term`.
        let withLambda := λl.
            let v := Lambda[parameter] l, subst2 := TermSubst{maps.delete v s}
            in Term{
              lambda = Lambda{
                parameter = v,
                domain = Lambda[domain] l,
                body = substituteInTerm subst2 (Lambda[body] l)}}, withLet := λlt.
            let bindings := Let[bindings] lt, names := sets.fromList
                (lists.map Binding[name] bindings), subst2 := TermSubst{maps.filterWithKey
              (λk,v.not (sets.member k names))
              s}, rewriteBinding := λb.Binding{
                  name = Binding[name] b,
                  `term` = substituteInTerm
                      subst2
                      (Binding[`term`] b),
                  typeScheme = Binding[typeScheme] b}
            in Term{
              `let` = Let{
                bindings = lists.map rewriteBinding bindings,
                body = substituteInTerm subst2 (Let[body] lt)}}
        in cases(Term){
          lambda=λl.withLambda l,
          `let`=λl.withLet l,
          variable=λname.optionals.match
                (maps.lookup name s)
                (recurse `term`)
                (λsterm.sterm),
          `_`=recurse `term`}
          `term`
    in rewriteTerm rewrite term0