## Round-trip test cases for JSON encoding and decoding
module hydra.core.test.json.roundtrip

import hydra.core.coders
import hydra.core.json.decode
import hydra.core.json.encode
import hydra.core.json.model
import hydra.core.json.writer
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.strings
import hydra.core.model
import hydra.core.print.model
import hydra.core.testing

## Round-trip test cases for JSON encoding and decoding
term allTests =
  TestGroup{
    name = "JSON round-trip",
    description = none,
    subgroups = [
      TestGroup{
        name = "literal types",
        description = none,
        subgroups = [],
        `cases` = [
          TestCaseWithMetadata{
            name = "boolean true",
            case = TestCase{
              universal = UniversalTestCase{
                actual = λ`_`.eithers.either
                      (λe.e)
                      (λjson.eithers.either
                          (λe.e)
                          (λdecoded.`term` decoded)
                          (ifElse
                            (equal
                              (eithers.map
                                (λt.`term` t)
                                (Coder[decode]
                                  (jsonCoder
                                    maps.empty
                                    true
                                    Name{"test"}
                                    Type{
                                      literal = LiteralType{
                                        `boolean`}})
                                  json))
                              (eithers.map
                                (λt.`term` t)
                                (fromJson
                                  maps.empty
                                  true
                                  Name{"test"}
                                  Type{
                                    literal = LiteralType{
                                      `boolean`}}
                                  json)))
                            (fromJson
                              maps.empty
                              true
                              Name{"test"}
                              Type{
                                literal = LiteralType{
                                  `boolean`}}
                              json)
                            left("staged jsonCoder decode disagrees with fromJson")))
                      (ifElse
                        (equal
                          (Coder[encode]
                            (jsonCoder
                              maps.empty
                              true
                              Name{"test"}
                              Type{
                                literal = LiteralType{
                                  `boolean`}})
                            Term{
                              literal = Literal{
                                `boolean` = true}})
                          (toJson
                            maps.empty
                            true
                            Name{"test"}
                            Type{
                              literal = LiteralType{
                                `boolean`}}
                            Term{
                              literal = Literal{
                                `boolean` = true}}))
                        (toJson
                          maps.empty
                          true
                          Name{"test"}
                          Type{
                            literal = LiteralType{
                              `boolean`}}
                          Term{
                            literal = Literal{
                              `boolean` = true}})
                        left("staged jsonCoder encode disagrees with toJson")),
                expected = λ`_`.`term`
                      Term{
                        literal = Literal{
                          `boolean` = true}}}},
            description = none,
            tags = [],
            provisions = []},
          TestCaseWithMetadata{
            name = "boolean false",
            case = TestCase{
              universal = UniversalTestCase{
