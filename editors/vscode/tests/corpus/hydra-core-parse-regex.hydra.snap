>term quantifier = (parsers.alt (parsers.choice [parsers.bind (parsers.char 42:int32) (λ`_`.parsers.pure regex.Quantifier{zeroOrMore}), parsers.bind (parsers.char 43:int32) (λ`_`.parsers.pure regex.Quantifier{oneOrMore}), parsers.bind (parsers.char 63:int32) (λ`_`.parsers.pure regex.Quantifier{zeroOrOne}), parsers.bind (parsers.char 123:int32) (λ`_`.parsers.bind unsignedInt (λn.parsers.bind (parsers.optional (parsers.char 44:int32)) (λcomma.optionals.match comma (parsers.bind (parsers.char 125:int32) (λ`_`.parsers.pure regex.Quantifier{exactly = n})) (λ`_`.parsers.bind (parsers.optional unsignedInt) (λmm.parsers.bind (parsers.char 125:int32) (λ`_`.optionals.match mm (parsers.pure regex.Quantifier{atLeast = n}) (λm.parsers.pure regex.Quantifier{range = regex.QuantifierRange{min = n, max = m}})))))))]) (parsers.pure regex.Quantifier{one}))@{description="Parse an optional quantifier following an atom; yields 'one' when no quantifier is present."}
