>
>## Show an inference error as a string, including the subterm path where applicable
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term inferenceError = λe.cases(errors.InferenceError){checking=checkingError, other=λe.let path := errors.OtherInferenceError[path] e in let msg := errors.OtherInferenceError[message] e in strings.concat ["inference error at ", subtermPath path, ": ", msg], unification=λe.let path := errors.UnificationInferenceError[path] e in let cause := errors.UnificationInferenceError[cause] e in strings.concat ["inference error at ", subtermPath path, ": ", unificationError cause]} e
