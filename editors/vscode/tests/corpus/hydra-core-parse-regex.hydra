## Parser for Hydra's translingual regular-expression syntax (docs/specification/regex.md): text -> hydra.core.regex AST. Built on the hydra.core.parsers combinators. Rejects ill-formed patterns (empty alternation branches, empty classes, out-of-range code points) via the ParseResult failure channel, so 'well-formed' is portable across hosts. See issue #567. A structured textual-syntax parser (precedent for the general parser in #497), not a scalar parse<T> convention function (see docs/specification/index.md, Conventions).
module hydra.core.parse.regex

import hydra.core.lib.equality as equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic as logic
import hydra.core.lib.math as math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering as ordering
import hydra.core.parsers as parsers
import hydra.core.parsing as parsing
import hydra.core.regex as regex

term alternation = (parsers.bind (parsers.sepBy1 (parsers.lazy (λ`_`.regexSequence)) (parsers.char 124:int32)) (λbranches.let hasEmpty := lists.foldl (λacc.λb.logic.or acc (lists.isEmpty b)) false branches, multi := ordering.gt (lists.length branches) 1:int32 in logic.ifElse (logic.and hasEmpty multi) (parsers.fail "empty alternation branch") (parsers.pure branches)))@{description="Parse an alternation of sequences separated by |. When there is more than one branch, each branch must be non-empty; empty branches (a|, |b, a||b, and the nested (a|)) are rejected at every level. A single empty branch is the legal empty case (empty whole pattern / empty group)."}

term atom = (parsers.choice [parsers.map (λg.regex.Atom{group = g}) (parsers.between (parsers.char 40:int32) (parsers.char 41:int32) (parsers.lazy (λ`_`.alternation))), characterClass, parsers.bind (parsers.char 46:int32) (λ`_`.parsers.pure regex.Atom{any}), parsers.bind (parsers.char 94:int32) (λ`_`.parsers.pure regex.Atom{anchorStart}), parsers.bind (parsers.char 36:int32) (λ`_`.parsers.pure regex.Atom{anchorEnd}), literalAtom])@{description="Parse a single atom: a group ( ... ), a class [ ... ], ., an anchor ^ or $, or a literal."}

term characterClass = (parsers.bind (parsers.char 91:int32) (λ`_`.parsers.bind (parsers.optional (parsers.char 94:int32)) (λneg.parsers.bind (parsers.some classItem) (λitems.parsers.bind (parsers.char 93:int32) (λ`_`.parsers.pure regex.Atom{class = regex.CharacterClass{negated = optionals.match neg false (λ`_`.true), items = items}})))))@{description="Parse a character class [ ... ] or [^ ... ]; the class must be non-empty."}

term classItem = (let classChar := parsers.alt escapedChar (parsers.satisfy (λc.logic.and (logic.not (equality.equal c 93:int32)) (logic.not (equality.equal c 92:int32)))) in parsers.bind classChar (λ`from`.parsers.alt (parsers.bind (parsers.char 45:int32) (λ`_`.parsers.map (λto.regex.ClassItem{range = regex.CharacterRange{`from` = `from`, to = to}}) classChar)) (parsers.pure regex.ClassItem{character = `from`})))@{description="Parse one member of a character class: a range like a-z, or a single character (escapes allowed)."}

term escapedChar = (parsers.bind (parsers.char 92:int32) (λ`_`.parsers.anyChar))@{description="Parse a backslash followed by any character; yields that character's codepoint (the escape is consumed)."}

term isMetachar = (λc.lists.foldl (λacc.λm.logic.or acc (equality.equal c m)) false [46:int32, 94:int32, 36:int32, 42:int32, 43:int32, 63:int32, 40:int32, 41:int32, 91:int32, 93:int32, 123:int32, 125:int32, 124:int32, 92:int32])@{description="True if the codepoint is a top-level regex metacharacter that must be escaped to match literally."}

term literalAtom = (parsers.map (λc.regex.Atom{literal = c}) (parsers.alt escapedChar (parsers.satisfy (λc.logic.not (isMetachar c)))))@{description="Parse a literal character (an escaped metacharacter, or any ordinary non-metacharacter) into an Atom."}

term parseRegex = (λinput.cases(parsing.ParseResult){success=λs.logic.ifElse (lists.isEmpty (parsing.ParseInput[codepoints] (parsing.ParseSuccess[remainder] s))) given(parsing.ParseSuccess[value] s) none, failure=λe.none} (parsers.runParser regex input))@{description="Parse a full regex pattern string into a hydra.core.regex AST. Returns nothing if the pattern is ill-formed or does not consume all input; a well-formed pattern is exactly one that parses here, so 'well-formed' is portable across all hosts."}

term quantified = (parsers.bind atom (λa.parsers.map (λq.regex.Quantified{atom = a, quantifier = q}) quantifier))@{description="Parse an atom followed by an optional quantifier."}

term quantifier = (parsers.alt (parsers.choice [parsers.bind (parsers.char 42:int32) (λ`_`.parsers.pure regex.Quantifier{zeroOrMore}), parsers.bind (parsers.char 43:int32) (λ`_`.parsers.pure regex.Quantifier{oneOrMore}), parsers.bind (parsers.char 63:int32) (λ`_`.parsers.pure regex.Quantifier{zeroOrOne}), parsers.bind (parsers.char 123:int32) (λ`_`.parsers.bind unsignedInt (λn.parsers.bind (parsers.optional (parsers.char 44:int32)) (λcomma.optionals.match comma (parsers.bind (parsers.char 125:int32) (λ`_`.parsers.pure regex.Quantifier{exactly = n})) (λ`_`.parsers.bind (parsers.optional unsignedInt) (λmm.parsers.bind (parsers.char 125:int32) (λ`_`.optionals.match mm (parsers.pure regex.Quantifier{atLeast = n}) (λm.parsers.pure regex.Quantifier{range = regex.QuantifierRange{min = n, max = m}})))))))]) (parsers.pure regex.Quantifier{one}))@{description="Parse an optional quantifier following an atom; yields 'one' when no quantifier is present."}

term regex = alternation@{description="Parse a complete regex (an alternation). The empty pattern parses to a single empty sequence."}

term regexSequence = (parsers.many quantified)@{description="Parse a sequence of quantified atoms (a single alternation branch). May be empty only as the whole pattern; as an alternation branch it is constrained to be non-empty by the alternation parser's use of sepBy1 plus a non-empty check."}

term unsignedInt = (parsers.map (λdigits.lists.foldl (λacc.λd.math.add (math.mul acc 10:int32) (math.sub d 48:int32)) 0:int32 digits) (parsers.some (parsers.satisfy (λc.logic.and (ordering.gte c 48:int32) (ordering.lte c 57:int32)))))@{description="Parse a non-negative decimal integer (one or more digits)."}