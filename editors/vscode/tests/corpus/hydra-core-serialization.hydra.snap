#                            ^ source.hydra punctuation.separator.binder.hydra
#                             ^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                         ^ source.hydra
#                                          ^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                      ^^ source.hydra
#                                                        ^^^^^^^^ source.hydra variable.other.hydra
#                                                                ^ source.hydra
#                                                                 ^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                            ^ source.hydra
#                                                                             ^^^ source.hydra variable.other.hydra
#                                                                                ^^^ source.hydra
#                                                                                   ^^^^^^^^ source.hydra variable.other.hydra
#                                                                                           ^ source.hydra
#                                                                                            ^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                                          ^ source.hydra
#                                                                                                           ^^^ source.hydra variable.other.hydra
#                                                                                                              ^^ source.hydra
>
