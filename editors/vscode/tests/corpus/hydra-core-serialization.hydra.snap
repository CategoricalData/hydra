>
>## Indent every line of an expression by four spaces
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term tabIndent = λe.ast.Expr{indent = ast.IndentedExpression{style = ast.IndentStyle{allLines = "    "}, expr = e}}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^ source.hydra entity.name.function.hydra
#              ^ source.hydra
#               ^ source.hydra keyword.operator.equals.hydra
#                ^ source.hydra
#                 ^ source.hydra keyword.operator.lambda.hydra
#                  ^ source.hydra variable.parameter.hydra
#                   ^ source.hydra punctuation.separator.binder.hydra
#                    ^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                            ^ source.hydra
#                             ^^^^^^ source.hydra variable.other.hydra
#                                   ^ source.hydra
#                                    ^ source.hydra keyword.operator.equals.hydra
#                                     ^ source.hydra
#                                      ^^^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                            ^ source.hydra
#                                                             ^^^^^ source.hydra variable.other.hydra
#                                                                  ^ source.hydra
#                                                                   ^ source.hydra keyword.operator.equals.hydra
#                                                                    ^ source.hydra
#                                                                     ^^^^^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                                                    ^ source.hydra
#                                                                                     ^^^^^^^^ source.hydra variable.other.hydra
#                                                                                             ^ source.hydra
#                                                                                              ^ source.hydra keyword.operator.equals.hydra
#                                                                                               ^ source.hydra
#                                                                                                ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                                                 ^^^^ source.hydra string.quoted.double.hydra
#                                                                                                     ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                                      ^^^ source.hydra
#                                                                                                         ^^^^ source.hydra variable.other.hydra
#                                                                                                             ^ source.hydra
#                                                                                                              ^ source.hydra keyword.operator.equals.hydra
#                                                                                                               ^ source.hydra
#                                                                                                                ^ source.hydra variable.other.hydra
#                                                                                                                 ^^^ source.hydra
>
>## Tab-indent a list of expressions, separated by blank lines
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term tabIndentDoubleSpace = λexprs.tabIndent (doubleNewlineSep exprs)
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                         ^ source.hydra
#                          ^ source.hydra keyword.operator.equals.hydra
#                           ^ source.hydra
#                            ^ source.hydra keyword.operator.lambda.hydra
#                             ^^^^^ source.hydra variable.parameter.hydra
#                                  ^ source.hydra punctuation.separator.binder.hydra
#                                   ^^^^^^^^^ source.hydra variable.other.hydra
#                                            ^^ source.hydra
#                                              ^^^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                              ^ source.hydra
#                                                               ^^^^^ source.hydra variable.other.hydra
#                                                                    ^^ source.hydra
>
>## Tab-indent a list of expressions, separated by single newlines
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term tabIndentSingleSpace = λexprs.tabIndent (newlineSep exprs)
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                         ^ source.hydra
#                          ^ source.hydra keyword.operator.equals.hydra
#                           ^ source.hydra
#                            ^ source.hydra keyword.operator.lambda.hydra
#                             ^^^^^ source.hydra variable.parameter.hydra
#                                  ^ source.hydra punctuation.separator.binder.hydra
#                                   ^^^^^^^^^ source.hydra variable.other.hydra
#                                            ^^ source.hydra
#                                              ^^^^^^^^^^ source.hydra variable.other.hydra
#                                                        ^ source.hydra
#                                                         ^^^^^ source.hydra variable.other.hydra
#                                                              ^^ source.hydra
>
>## Render a placeholder for a type the writer does not yet handle, e.g. `[bigint]`
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term unsupportedType = λlabel.cst (strings.concat2 (strings.concat2 "[" label) "]")
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                    ^ source.hydra
#                     ^ source.hydra keyword.operator.equals.hydra
#                      ^ source.hydra
#                       ^ source.hydra keyword.operator.lambda.hydra
#                        ^^^^^ source.hydra variable.parameter.hydra
#                             ^ source.hydra punctuation.separator.binder.hydra
#                              ^^^ source.hydra variable.other.hydra
#                                 ^^ source.hydra
#                                   ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                  ^^ source.hydra
#                                                    ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                   ^ source.hydra
#                                                                    ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                     ^ source.hydra string.quoted.double.hydra
#                                                                      ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                       ^ source.hydra
#                                                                        ^^^^^ source.hydra variable.other.hydra
#                                                                             ^^ source.hydra
#                                                                               ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                                ^ source.hydra string.quoted.double.hydra
#                                                                                 ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                  ^^ source.hydra
>
>## Render a placeholder for an unsupported variant, including a string representation of the offending value
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term unsupportedVariant = λlabel,obj.cst (strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "[unsupported " label) ": ") (literals.printString obj)) "]")
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                       ^ source.hydra
#                        ^ source.hydra keyword.operator.equals.hydra
#                         ^ source.hydra
#                          ^ source.hydra keyword.operator.lambda.hydra
#                           ^^^^^ source.hydra variable.parameter.hydra
#                                ^ source.hydra punctuation.separator.binder.hydra
#                                 ^^^ source.hydra variable.parameter.hydra
#                                    ^ source.hydra punctuation.separator.binder.hydra
#                                     ^^^ source.hydra variable.other.hydra
#                                        ^^ source.hydra
#                                          ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                         ^^ source.hydra
#                                                           ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                          ^^ source.hydra
#                                                                            ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                                           ^^ source.hydra
#                                                                                             ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                                                            ^ source.hydra
#                                                                                                             ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                                                              ^^^^^^^^^^^^^ source.hydra string.quoted.double.hydra
#                                                                                                                           ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                                                            ^ source.hydra
#                                                                                                                             ^^^^^ source.hydra variable.other.hydra
#                                                                                                                                  ^^ source.hydra
#                                                                                                                                    ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                                                                                     ^^ source.hydra string.quoted.double.hydra
#                                                                                                                                       ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                                                                        ^^^ source.hydra
#                                                                                                                                           ^^^^^^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                                                                                                               ^ source.hydra
#                                                                                                                                                                ^^^ source.hydra variable.other.hydra
#                                                                                                                                                                   ^^^ source.hydra
#                                                                                                                                                                      ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                                                                                                                                       ^ source.hydra string.quoted.double.hydra
#                                                                                                                                                                        ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                                                                                                                                         ^^ source.hydra
>
>## Append a trailing comma to an expression
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term withComma = λe.noSep [e, cst ","]
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^ source.hydra entity.name.function.hydra
#              ^ source.hydra
#               ^ source.hydra keyword.operator.equals.hydra
#                ^ source.hydra
#                 ^ source.hydra keyword.operator.lambda.hydra
#                  ^ source.hydra variable.parameter.hydra
#                   ^ source.hydra punctuation.separator.binder.hydra
#                    ^^^^^ source.hydra variable.other.hydra
#                         ^^ source.hydra
#                           ^ source.hydra variable.other.hydra
#                            ^^ source.hydra
#                              ^^^ source.hydra variable.other.hydra
