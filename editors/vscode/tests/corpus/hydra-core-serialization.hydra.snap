source.hydra variable.other.hydra
>
>## Separate elements with `;` inline
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term semicolonSep = symbolSep ";" inlineStyle
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                 ^ source.hydra
#                  ^ source.hydra keyword.operator.equals.hydra
#                   ^ source.hydra
#                    ^^^^^^^^^ source.hydra variable.other.hydra
#                             ^ source.hydra
#                              ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                               ^ source.hydra string.quoted.double.hydra
#                                ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                 ^ source.hydra
#                                  ^^^^^^^^^^^ source.hydra variable.other.hydra
>
>## Combine a list of expressions into a single OpExpr chain using the given operator. Returns the empty constant for an empty list.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term sep = λop,els.optionals.match (lists.head els) (cst "") (λh.lists.foldl (λacc,el.ifx op acc el) h (lists.drop 1:int32 els))
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^ source.hydra entity.name.function.hydra
#        ^ source.hydra
#         ^ source.hydra keyword.operator.equals.hydra
#          ^ source.hydra
#           ^ source.hydra keyword.operator.lambda.hydra
#            ^^ source.hydra variable.parameter.hydra
#              ^ source.hydra punctuation.separator.binder.hydra
#               ^^^ source.hydra variable.parameter.hydra
#                  ^ source.hydra punctuation.separator.binder.hydra
#                   ^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                  ^^ source.hydra
#                                    ^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                              ^ source.hydra
#                                               ^^^ source.hydra variable.other.hydra
#                                                  ^^^ source.hydra
#                                                     ^^^ source.hydra variable.other.hydra
#                                                        ^ source.hydra
#                                                         ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                                                          ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
#                                                           ^^^ source.hydra
#                                                              ^ source.hydra keyword.operator.lambda.hydra
#                                                               ^ source.hydra variable.parameter.hydra
#                                                                ^ source.hydra punctuation.separator.binder.hydra
#                                                                 ^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                            ^^ source.hydra
#                                                                              ^ source.hydra keyword.operator.lambda.hydra
#                                                                               ^^^ source.hydra variable.parameter.hydra
#                                                                                  ^ source.hydra punctuation.separator.binder.hydra
#                                                                                   ^^ source.hydra variable.parameter.hydra
#                                                                                     ^ source.hydra punctuation.separator.binder.hydra
#                                                                                      ^^^ source.hydra variable.other.hydra
#                                                                                         ^ source.hydra
#                                                                                          ^^ source.hydra variable.other.hydra
#                                                                                            ^ source.hydra
#                                                                                             ^^^ source.hydra variable.other.hydra
#                                                                                                ^ source.hydra
#                                                                                                 ^^ source.hydra variable.other.hydra
#                                                                                                   ^^ source.hydra
#                                                                                                     ^ source.hydra variable.other.hydra
#                                                                                                      ^^ source.hydra
#                                                                                                        ^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                                                                  ^ source.hydra
#                                                                                                                   ^ source.hydra constant.numeric.integer.hydra
#                                                                                                                    ^ source.hydra punctuation.separator.type.hydra
#                                                                                                                     ^^^^^ source.hydra support.type.literal.integer.hydra
#                                                                                                                          ^ source.hydra
#                                                                                                                           ^^^ source.hydra variable.other.hydra
#                                                                                                                              ^^^ source.hydra
>
>## Space-separate elements (no break between them)
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term spaceSep = sep ast.Op{symbol = sym "", padding = ast.Padding{`left` = ast.Ws{space}, `right` = ast.Ws{`none`}}, precedence = ast.Precedence{0:int32}, associativity = ast.Associativity{`none`}}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^ source.hydra entity.name.function.hydra
#             ^ source.hydra
#              ^ source.hydra keyword.operator.equals.hydra
#               ^ source.hydra
#                ^^^ source.hydra variable.other.hydra
#                   ^ source.hydra
#                    ^^^^^^ source.hydra entity.name.type.nominal.hydra
#                          ^ source.hydra
