>## Wrap an expression in the given bracket pair using the given block style
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term brackets = λbr,style,e.Expr{brackets = BracketExpr{brackets = br, enclosed = e, style = style}}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^ source.hydra entity.name.function.hydra
#             ^ source.hydra
#              ^ source.hydra keyword.operator.equals.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.lambda.hydra
#                 ^^ source.hydra variable.parameter.hydra
#                   ^ source.hydra punctuation.separator.binder.hydra
#                    ^^^^^ source.hydra variable.parameter.hydra
#                         ^ source.hydra punctuation.separator.binder.hydra
#                          ^ source.hydra variable.parameter.hydra
#                           ^ source.hydra punctuation.separator.binder.hydra
#                            ^^^^ source.hydra entity.name.type.nominal.hydra
#                                ^ source.hydra
#                                 ^^^^^^^^ source.hydra variable.other.hydra
#                                         ^ source.hydra
#                                          ^ source.hydra keyword.operator.equals.hydra
#                                           ^ source.hydra
#                                            ^^^^^^^^^^^ source.hydra entity.name.type.nominal.hydra
#                                                       ^ source.hydra
#                                                        ^^^^^^^^ source.hydra variable.other.hydra
#                                                                ^ source.hydra
#                                                                 ^ source.hydra keyword.operator.equals.hydra
#                                                                  ^ source.hydra
#                                                                   ^^ source.hydra variable.other.hydra
#                                                                     ^^ source.hydra
#                                                                       ^^^^^^^^ source.hydra variable.other.hydra
#                                                                               ^ source.hydra
#                                                                                ^ source.hydra keyword.operator.equals.hydra
#                                                                                 ^ source.hydra
#                                                                                  ^ source.hydra variable.other.hydra
#                                                                                   ^^ source.hydra
#                                                                                     ^^^^^ source.hydra variable.other.hydra
#                                                                                          ^ source.hydra
#                                                                                           ^ source.hydra keyword.operator.equals.hydra
#                                                                                            ^ source.hydra
#                                                                                             ^^^^^ source.hydra variable.other.hydra
#                                                                                                  ^^^ source.hydra
>
>## Pick between an inline and a multi-line layout for the same logical expression. Returns the inline form if its estimated width does not exceed the threshold, otherwise the block form. Note: the threshold is measured against the inline expression in isolation; surrounding indentation may push content beyond the threshold at print time. Callers that know they are nested can pass a smaller threshold to compensate.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term chooseLayout =
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                 ^ source.hydra
#                  ^ source.hydra keyword.operator.equals.hydra
>  λthreshold,inlineExpr,blockExpr.ifElse (gt (expressionLength inlineExpr) threshold) blockExpr inlineExpr
#^^ source.hydra
#  ^ source.hydra keyword.operator.lambda.hydra
#   ^^^^^^^^^ source.hydra variable.parameter.hydra
#            ^ source.hydra punctuation.separator.binder.hydra
#             ^^^^^^^^^^ source.hydra variable.parameter.hydra
#                       ^ source.hydra punctuation.separator.binder.hydra
#                        ^^^^^^^^^ source.hydra variable.parameter.hydra
#                                 ^ source.hydra punctuation.separator.binder.hydra
#                                  ^^^^^^ source.hydra variable.other.hydra
#                                        ^^ source.hydra
#                                          ^^ source.hydra variable.other.hydra
#                                            ^^ source.hydra
#                                              ^^^^^^^^^^^^^^^^ source.hydra variable.other.hydra
#                                                              ^ source.hydra
#                                                               ^^^^^^^^^^ source.hydra variable.other.hydra
#                                                                         ^^ source.hydra
#                                                                           ^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                    ^^ source.hydra
#                                                                                      ^^^^^^^^^ source.hydra variable.other.hydra
#                                                                                               ^ source.hydra
#                                                                                                ^^^^^^^^^^ source.hydra variable.other.hydra
>
>## Separate elements with a comma, using the given block style
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term commaSep = symbolSep ","
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^ source.hydra entity.name.function.hydra
#             ^ source.hydra
#              ^ source.hydra keyword.operator.equals.hydra
#               ^ source.hydra
#                ^^^^^^^^^ source.hydra variable.other.hydra
#                         ^ source.hydra
#                          ^ source.hydra string.quoted.double.hydra punctuation.definition.string.begin.hydra
#                           ^ source.hydra string.quoted.double.hydra
#                            ^ source.hydra string.quoted.double.hydra punctuation.definition.string.end.hydra
>
>## Comma-separate elements inline if the joined width fits, otherwise break onto separate lines.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term commaSepAdaptive = λels.chooseLayout maxLineWidth (commaSep inlineStyle els) (commaSep halfBlockStyle els)
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                     ^ source.hydra
#                      ^ source.hydra keyword.operator.equals.hydra
#                       ^ source.hydra
#                        ^ source.hydra keyword.operator.lambda.hydra
