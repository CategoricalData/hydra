>primitive intersection : ∀x.(ordering x) ⇒ set<x> → set<x> → set<x> = λs1.λs2.hydra.core.lib.lists.foldl (λacc.λel.hydra.core.lib.logic.ifElse (hydra.core.lib.sets.member el s2) (hydra.core.lib.sets.insert el acc) acc) hydra.core.lib.sets.empty (hydra.core.lib.sets.toList s1)
