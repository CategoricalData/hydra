#                 ^ source.hydra
#                  ^^^^^ source.hydra variable.other.hydra
#                       ^ source.hydra
#                        ^ source.hydra keyword.operator.arrow.hydra
#                         ^ source.hydra
#                          ^^^^ source.hydra support.type.hydra
#                              ^ source.hydra punctuation.definition.typeargs.begin.hydra
#                               ^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                         ^ source.hydra punctuation.definition.typeargs.end.hydra
#                                          ^ source.hydra
#                                           ^ source.hydra keyword.operator.arrow.hydra
#                                            ^ source.hydra
#                                             ^^^^^^ source.hydra support.type.hydra
#                                                   ^ source.hydra punctuation.definition.typeargs.begin.hydra
#                                                    ^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                ^^ source.hydra
#                                                                  ^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                                                            ^ source.hydra punctuation.definition.typeargs.end.hydra
#                                                                             ^^ source.hydra
