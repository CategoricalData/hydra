## Pure code generation pipeline for bootstrapping Hydra across languages.
module hydra.core.codegen

import hydra.core.adapt
import hydra.core.annotations
import hydra.core.coders
import hydra.core.constants
import hydra.core.decode.model as decode.model
import hydra.core.decode.packaging as decode.packaging
import hydra.core.encode.model as encode.model
import hydra.core.encode.packaging as encode.packaging
import hydra.core.environment
import hydra.core.errors
import hydra.core.formatting
import hydra.core.graph
import hydra.core.inference
import hydra.core.json.decode
import hydra.core.json.encode
import hydra.core.json.writer
import hydra.core.lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.math as math
import hydra.core.lib.optionals as optionals
import hydra.core.lib.ordering
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.markdown
import hydra.core.model
import hydra.core.names
import hydra.core.packaging
import hydra.core.print.model
import hydra.core.scoping
import hydra.core.strip

## Build a schema map (Name -> Type) from a graph's schema types
term buildSchemaMap = λg.maps.map (λts.deannotateType (TypeScheme[body] ts)) (Graph[schemaTypes] g)

## Decode a single module from a JSON value
term decodeModuleFromJson =
  λbsGraph,universeModules,jsonVal.
    let graph := modulesToGraph bsGraph universeModules universeModules in
    let schemaMap := buildSchemaMap graph in
    let modType := Type{variable = Name{"hydra.core.packaging.Module"}} in
    eithers.either
      (λerr.left(Error{other = wrap(OtherError){err}}))
      (λ`term`.eithers.either
          (λdecErr.left(Error{decoding = decErr}))
          (λmod.right(mod))
          (decode.packaging.module graph `term`))
      (fromJson schemaMap false Name{"hydra.core.packaging.Module"} modType jsonVal)

## Escape unescaped control characters inside JSON string literals
term escapeControlCharsInJson =
  λinput.
    let hexDigit := λn.ifElse (lt n 10:int32) (math.add 48:int32 n) (math.add 97:int32 (math.sub n 10:int32)) in
    let escapeToUnicode := λb.[
          92:int32,
          117:int32,
          48:int32,
          48:int32,
          hexDigit (optionals.withDefault 0:int32 (math.div b 16:int32)),
          hexDigit (optionals.withDefault 0:int32 (math.mod b 16:int32))] in
    let go := λinStr,esc,bytes.optionals.match
          (lists.uncons bytes)
          []
          (λuc.
            let b := first uc in
            let bs := second uc in
            ifElse
              esc
              (lists.cons b (go inStr false bs))
              (ifElse
                (and (equal b 92:int32) inStr)
                (lists.cons b (go inStr true bs))
                (ifElse
                  (equal b 34:int32)
                  (lists.cons b (go (not inStr) false bs))
                  (ifElse
                    (and inStr (lt b 32:int32))
                    (lists.concat2 (escapeToUnicode b) (go inStr false bs))
                    (lists.cons b (go inStr false bs)))))) in
    go false false input

## Format a primitive for the lexicon
term formatPrimitive =
  λprim.
    let name := Name[] (PrimitiveDefinition[name] (Primitive[definition] prim)) in
    let typ := termSignatureToTypeScheme (PrimitiveDefinition[signature] (Primitive[definition] prim)) in
    let typeStr := typeScheme typ in
    strings.concat2 (strings.concat2 (strings.concat2 "  " name) " : ") typeStr

## Format a term binding for the lexicon
term formatTermBinding =
  λbinding.
    let name := Name[] (Binding[name] binding) in
    let typeStr := optionals.match (Binding[typeScheme] binding) "?" (λscheme.typeScheme scheme) in
    strings.concat2 (strings.concat2 (strings.concat2 "  " name) " : ") typeStr

## Format a type binding for the lexicon
term formatTypeBinding =
  λgraph,binding.eithers.bind
      (eithers.bimap
        (λ`_e`.Error{decoding = `_e`})
        (λ`_a`.`_a`)
        (decode.model.type graph (Binding[`term`] binding)))
      (λtyp.right(strings.concat2
          (strings.concat2 (strings.concat2 "  " (Name[] (Binding[name] binding))) " = ")
          (`type` typ)))

## Generate encoder or decoder modules for a list of type modules
term generateCoderModules =
  λcodec,bsGraph,universeModules,typeModules,cx.
    let universe := maps.fromList
        (lists.map
          (λm.(Module[name] m, m))
          (lists.concat2 universeModules universeModules)) in
    let closureModules := moduleDepsTransitive universe universeModules in
    let schemaElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `type`=λtd.given((λname,typ.
                          let schemaTerm := Term{
                            variable = Name{"hydra.core.model.Type"}} in
                          let dataTerm := normalizeTermAnnotations
                              Term{
                                annotated = AnnotatedTerm{
                                  body = encode.model.type typ,
                                  annotation = wrapAnnotationMap
                                      (maps.fromList [(keyType, schemaTerm)])}} in
                          Binding{
                            name = name,
                            `term` = dataTerm,
                            typeScheme = given(TypeScheme{
                                variables = [],
                                body = Type{
                                  variable = Name{"hydra.core.model.Type"}},
                                constraints = maps.empty})})
                          (TypeDefinition[name] td)
                          (TypeScheme[body]
                            (TypeDefinition[body] td))),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          closureModules) in
    let dataElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `term`=λtd.given(Binding{
                          name = TermDefinition[name] td,
                          `term` = TermDefinition[body] td,
                          typeScheme = optionals.map
                              termSignatureToTypeScheme
                              (TermDefinition[signature] td)}),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          closureModules) in
    let schemaGraph := elementsToGraph bsGraph maps.empty schemaElements in
    let schemaTypes := eithers.either
        (λ`_`.maps.empty)
        (λ`_r`.`_r`)
        (schemaGraphToTypingEnvironment schemaGraph) in
    let allElements := lists.concat2 schemaElements dataElements in
    let graph := elementsToGraph bsGraph schemaTypes allElements in
    eithers.map
      (λresults.optionals.givens results)
      (eithers.mapList (λm.codec cx graph m) typeModules)

## Generate the lexicon content from a graph
term generateLexicon =
  λgraph.
    let bindings := graphToBindings graph in
    let primitives := maps.elems (Graph[primitives] graph) in
    let partitioned := lists.partition (λb.isNativeType b) bindings in
    let typeBindings := first partitioned in
    let termBindings := second partitioned in
    let sortedPrimitives := lists.sortBy (λp.PrimitiveDefinition[name] (Primitive[definition] p)) primitives in
    let sortedTypes := lists.sortBy (λb.Binding[name] b) typeBindings in
    let sortedTerms := lists.sortBy (λb.Binding[name] b) termBindings in
    eithers.bind
      (eithers.mapList (λb.formatTypeBinding graph b) sortedTypes)
      (λtypeLines.
        let termLines := lists.map (λb.formatTermBinding b) sortedTerms in
        let primitiveLines := lists.map (λp.formatPrimitive p) sortedPrimitives in
        right(strings.concat2
          (strings.concat2
            (strings.concat2
              (strings.concat2 (strings.concat2 "Primitives:\n" (unlines primitiveLines)) "\nTypes:\n")
              (unlines typeLines))
            "\nTerms:\n")
          (unlines termLines)))

## Generate a hydra.core.markdown Document describing a module's definitions
term generateModuleDoc =
  λmod.
    let sections := lists.map
        (λd.cases(Definition){
            `primitive`=λpd.
                let name := Name[] (PrimitiveDefinition[name] pd) in
                let mdoc := optionals.bind
                    (PrimitiveDefinition[metadata] pd)
                    (λem.EntityMetadata[description] em) in
                let sig := typeScheme
                    (termSignatureToTypeScheme
                      (PrimitiveDefinition[signature] pd)) in
                let provisions := optionals.withDefault
                    []
                    (optionals.map
                      (λem.EntityMetadata[provisions] em)
                      (PrimitiveDefinition[metadata] pd)) in
                let comments := optionals.withDefault
                    []
                    (optionals.map
                      (λem.EntityMetadata[comments] em)
                      (PrimitiveDefinition[metadata] pd)) in
                let mlifecycle := optionals.bind
                    (PrimitiveDefinition[metadata] pd)
                    (λem.EntityMetadata[lifecycle] em) in
                Section{
                  heading = Heading{
                    level = 2:int32,
                    content = [Inline{text = name}],
                    anchor = none},
                  content = lists.concat
                      [
                        [
                          Block{
                            paragraph = Paragraph{
                              content = [Inline{text = optionals.withDefault "*(undocumented)*" mdoc}],
                              anchor = none}},
                          Block{paragraph = Paragraph{content = [Inline{code = sig}], anchor = none}}],
                        lists.map
                          (λlc.Block{
                              paragraph = let mavail := LifecycleInfo[availableSince] lc in
                                let mdepr := LifecycleInfo[deprecatedSince] lc in
                                let availText := optionals.map
                                    (λv.strings.concat2 (strings.concat2 "Since: " (Version[] v)) ".")
                                    mavail in
                                let deprText := optionals.map
                                    (λv.strings.concat2 (strings.concat2 "Deprecated since: " (Version[] v)) ".")
                                    mdepr in
                                let parts := lists.concat2 (optionals.toList availText) (optionals.toList deprText) in
                                Paragraph{
                                  content = [Inline{emphasis = [Inline{text = strings.join " " parts}]}],
                                  anchor = none}})
                          (optionals.toList mlifecycle),
                        lists.map (λc.Block{paragraph = Paragraph{content = [Inline{text = c}], anchor = none}}) comments,
                        lists.map
                          (λp.Block{
                              paragraph = let pname := Provision[name] p in
                                let pkind := Provision[kind] p in
                                let pstatement := Provision[statement] p in
                                let kindStr := cases(ProvisionKind){requirement=λ`_`."requirement", recommendation=λ`_`."recommendation"}
                                    pkind in
                                let upperDashed := nameToUpperDashed pname in
                                Paragraph{
                                  content = [
                                    Inline{
                                      strong = [
                                        Inline{
                                          text = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "[" upperDashed) "] (") kindStr) ") "}]},
                                    Inline{text = pstatement}],
                                  anchor = given(upperDashed)}})
                          provisions],
                  anchor = none},
            `term`=λtd.
                let name := Name[] (TermDefinition[name] td) in
                let mdoc := optionals.bind
                    (TermDefinition[metadata] td)
                    (λem.EntityMetadata[description] em) in
                let sig := optionals.match
                    (optionals.map
                      termSignatureToTypeScheme
                      (TermDefinition[signature] td))
                    "?"
                    (λts.typeScheme ts) in
                let provisions := optionals.withDefault
                    []
                    (optionals.map
                      (λem.EntityMetadata[provisions] em)
                      (TermDefinition[metadata] td)) in
                let comments := optionals.withDefault
                    []
                    (optionals.map
                      (λem.EntityMetadata[comments] em)
                      (TermDefinition[metadata] td)) in
                let mlifecycle := optionals.bind
                    (TermDefinition[metadata] td)
                    (λem.EntityMetadata[lifecycle] em) in
                Section{
                  heading = Heading{
                    level = 2:int32,
                    content = [Inline{text = name}],
                    anchor = none},
                  content = lists.concat
                      [
                        [
                          Block{
                            paragraph = Paragraph{
                              content = [Inline{text = optionals.withDefault "*(undocumented)*" mdoc}],
                              anchor = none}},
                          Block{paragraph = Paragraph{content = [Inline{code = sig}], anchor = none}}],
                        lists.map
                          (λlc.Block{
                              paragraph = let mavail := LifecycleInfo[availableSince] lc in
                                let mdepr := LifecycleInfo[deprecatedSince] lc in
                                let availText := optionals.map
                                    (λv.strings.concat2 (strings.concat2 "Since: " (Version[] v)) ".")
                                    mavail in
                                let deprText := optionals.map
                                    (λv.strings.concat2 (strings.concat2 "Deprecated since: " (Version[] v)) ".")
                                    mdepr in
                                let parts := lists.concat2 (optionals.toList availText) (optionals.toList deprText) in
                                Paragraph{
                                  content = [Inline{emphasis = [Inline{text = strings.join " " parts}]}],
                                  anchor = none}})
                          (optionals.toList mlifecycle),
                        lists.map (λc.Block{paragraph = Paragraph{content = [Inline{text = c}], anchor = none}}) comments,
                        lists.map
                          (λp.Block{
                              paragraph = let pname := Provision[name] p in
                                let pkind := Provision[kind] p in
                                let pstatement := Provision[statement] p in
                                let kindStr := cases(ProvisionKind){requirement=λ`_`."requirement", recommendation=λ`_`."recommendation"}
                                    pkind in
                                let upperDashed := nameToUpperDashed pname in
                                Paragraph{
                                  content = [
                                    Inline{
                                      strong = [
                                        Inline{
                                          text = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "[" upperDashed) "] (") kindStr) ") "}]},
                                    Inline{text = pstatement}],
                                  anchor = given(upperDashed)}})
                          provisions],
                  anchor = none},
            `type`=λtyd.
                let name := Name[] (TypeDefinition[name] tyd) in
                let mdoc := optionals.bind
                    (TypeDefinition[metadata] tyd)
                    (λem.EntityMetadata[description] em) in
                let sig := typeScheme (TypeDefinition[body] tyd) in
                let provisions := optionals.withDefault
                    []
                    (optionals.map
                      (λem.EntityMetadata[provisions] em)
                      (TypeDefinition[metadata] tyd)) in
                let comments := optionals.withDefault
                    []
                    (optionals.map
                      (λem.EntityMetadata[comments] em)
                      (TypeDefinition[metadata] tyd)) in
                let mlifecycle := optionals.bind
                    (TypeDefinition[metadata] tyd)
                    (λem.EntityMetadata[lifecycle] em) in
                Section{
                  heading = Heading{
                    level = 2:int32,
                    content = [Inline{text = name}],
                    anchor = none},
                  content = lists.concat
                      [
                        [
                          Block{
                            paragraph = Paragraph{
                              content = [Inline{text = optionals.withDefault "*(undocumented)*" mdoc}],
                              anchor = none}},
                          Block{paragraph = Paragraph{content = [Inline{code = sig}], anchor = none}}],
                        lists.map
                          (λlc.Block{
                              paragraph = let mavail := LifecycleInfo[availableSince] lc in
                                let mdepr := LifecycleInfo[deprecatedSince] lc in
                                let availText := optionals.map
                                    (λv.strings.concat2 (strings.concat2 "Since: " (Version[] v)) ".")
                                    mavail in
                                let deprText := optionals.map
                                    (λv.strings.concat2 (strings.concat2 "Deprecated since: " (Version[] v)) ".")
                                    mdepr in
                                let parts := lists.concat2 (optionals.toList availText) (optionals.toList deprText) in
                                Paragraph{
                                  content = [Inline{emphasis = [Inline{text = strings.join " " parts}]}],
                                  anchor = none}})
                          (optionals.toList mlifecycle),
                        lists.map (λc.Block{paragraph = Paragraph{content = [Inline{text = c}], anchor = none}}) comments,
                        lists.map
                          (λp.Block{
                              paragraph = let pname := Provision[name] p in
                                let pkind := Provision[kind] p in
                                let pstatement := Provision[statement] p in
                                let kindStr := cases(ProvisionKind){requirement=λ`_`."requirement", recommendation=λ`_`."recommendation"}
                                    pkind in
                                let upperDashed := nameToUpperDashed pname in
                                Paragraph{
                                  content = [
                                    Inline{
                                      strong = [
                                        Inline{
                                          text = strings.concat2 (strings.concat2 (strings.concat2 (strings.concat2 "[" upperDashed) "] (") kindStr) ") "}]},
                                    Inline{text = pstatement}],
                                  anchor = given(upperDashed)}})
                          provisions],
                  anchor = none}}
            d)
        (Module[definitions] mod) in
    let introBlocks := let comments := optionals.withDefault
          []
          (optionals.map (λem.EntityMetadata[comments] em) (Module[metadata] mod))
      in lists.map
        (λc.Block{paragraph = Paragraph{content = [Inline{text = c}], anchor = none}})
        comments in
    Document{
      title = ModuleName[] (Module[name] mod),
      content = lists.cons
          Block{raw = "<!-- Note: this is an automatically generated file. Do not edit. -->"}
          (lists.concat2 introBlocks (lists.map (λs.Block{section = s}) sections))}

## Pure core of code generation: given a coder, language, infer flag, bootstrap graph, universe, and modules to generate, produce a list of (filePath, content) pairs. Emission flags doExpand/doHoistCaseStatements/doHoistPolymorphicLetBindings are derived from the absence of the matching LanguageFeature in lang.supportedFeatures: a target that lacks partialApplication needs eta expansion (doExpand=true), and so on.
term generateSourceFiles =
  λprintDefinitions,lang,doInfer,bsGraph,universeModules,modsToGenerate,cx.
    let namespaceMap := maps.fromList
        (lists.map
          (λm.(Module[name] m, m))
          (lists.concat2
            universeModules
            modsToGenerate)) in
    let constraints := Language[constraints] lang in
    let features := Language[supportedFeatures] lang in
    let doExpand := not
        (sets.member
          LanguageFeature{
            partialApplication}
          features) in
    let doHoistCaseStatements := not
        (sets.member
          LanguageFeature{
            nestedCaseStatements}
          features) in
    let doHoistPolymorphicLetBindings := not
        (sets.member
          LanguageFeature{
            nestedPolymorphicLetBindings}
          features) in
    let typeModulesToGenerate := lists.filter
        (λmod.not
            (lists.isEmpty
              (optionals.givens
                (lists.map
                  (λd.cases(Definition){
                      `type`=λtd.given((λname,typ.
                            let schemaTerm := Term{
                              variable = Name{"hydra.core.model.Type"}} in
                            let dataTerm := normalizeTermAnnotations
                                Term{
                                  annotated = AnnotatedTerm{
                                    body = encode.model.type typ,
                                    annotation = wrapAnnotationMap
                                        (maps.fromList [(keyType, schemaTerm)])}} in
                            Binding{
                              name = name,
                              `term` = dataTerm,
                              typeScheme = given(TypeScheme{
                                  variables = [],
                                  body = Type{
                                    variable = Name{"hydra.core.model.Type"}},
                                  constraints = maps.empty})})
                            (TypeDefinition[name] td)
                            (TypeScheme[body]
                              (TypeDefinition[body] td))),
                      `_`=none}
                      d)
                  (Module[definitions] mod)))))
        modsToGenerate in
    let termModulesToGenerate := lists.filter
        (λmod.not
            (lists.isEmpty
              (optionals.givens
                (lists.map
                  (λd.cases(Definition){
                      `term`=λtd.given(Binding{
                            name = TermDefinition[name] td,
                            `term` = TermDefinition[body] td,
                            typeScheme = optionals.map
                                termSignatureToTypeScheme
                                (TermDefinition[signature] td)}),
                      `_`=none}
                      d)
                  (Module[definitions] mod)))))
        modsToGenerate in
    let closureMods := moduleDepsTransitive
        namespaceMap
        (lists.concat2
          universeModules
          modsToGenerate) in
    let schemaElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `type`=λtd.given((λname,typ.
                          let schemaTerm := Term{
                            variable = Name{"hydra.core.model.Type"}} in
                          let dataTerm := normalizeTermAnnotations
                              Term{
                                annotated = AnnotatedTerm{
                                  body = encode.model.type typ,
                                  annotation = wrapAnnotationMap
                                      (maps.fromList [(keyType, schemaTerm)])}} in
                          Binding{
                            name = name,
                            `term` = dataTerm,
                            typeScheme = given(TypeScheme{
                                variables = [],
                                body = Type{
                                  variable = Name{"hydra.core.model.Type"}},
                                constraints = maps.empty})})
                          (TypeDefinition[name] td)
                          (TypeScheme[body]
                            (TypeDefinition[body] td))),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          closureMods) in
    let dataElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `term`=λtd.given(Binding{
                          name = TermDefinition[name] td,
                          `term` = TermDefinition[body] td,
                          typeScheme = optionals.map
                              termSignatureToTypeScheme
                              (TermDefinition[signature] td)}),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          closureMods) in
    let schemaGraph := elementsToGraph
        bsGraph
        maps.empty
        schemaElements in
    let schemaTypes2 := eithers.either
        (λ`_`.maps.empty)
        (λ`_r`.`_r`)
        (schemaGraphToTypingEnvironment
          schemaGraph) in
    let dataGraph := elementsToGraph
        bsGraph
        schemaTypes2
        dataElements in
    eithers.bind
      (ifElse
        (lists.isEmpty typeModulesToGenerate)
        right([])
        (let nameLists := lists.map
            (λm.optionals.givens
                (lists.map
                  (λd.cases(Definition){
                      `type`=λtd.given(TypeDefinition[name] td),
                      `_`=none}
                      d)
                  (Module[definitions] m)))
            typeModulesToGenerate
        in eithers.bind
          (schemaGraphToDefinitions
            constraints
            schemaGraph
            nameLists
            cx)
          (λschemaResult.
            let defLists := second schemaResult in
            let schemaGraphWithTypes := Graph{
              boundTerms = Graph[boundTerms] schemaGraph,
              boundTypes = Graph[boundTypes] schemaGraph,
              classConstraints = Graph[classConstraints] schemaGraph,
              lambdaVariables = Graph[lambdaVariables] schemaGraph,
              metadata = Graph[metadata] schemaGraph,
              primitives = Graph[primitives] schemaGraph,
              schemaTypes = schemaTypes2,
              typeVariables = Graph[typeVariables] schemaGraph} in
            eithers.map
              (λxs.lists.concat xs)
              (eithers.mapList
                (λp.
                  let mod := first p in
                  let defs := second p in
                  eithers.map
                    (λm.maps.toList m)
                    (printDefinitions
                      mod
                      (lists.map
                        (λd.Definition{`type` = d})
                        defs)
                      cx
                      schemaGraphWithTypes))
                (lists.zip typeModulesToGenerate defLists)))))
      (λschemaFiles.eithers.bind
          (ifElse
            (lists.isEmpty termModulesToGenerate)
            right([])
            (let namespaces := lists.map
                (λm.Module[name] m)
                termModulesToGenerate
            in eithers.bind
              (dataGraphToDefinitions
                constraints
                doInfer
                doExpand
                doHoistCaseStatements
                doHoistPolymorphicLetBindings
                dataElements
                dataGraph
                namespaces
                cx)
              (λdataResult.
                let g1 := first dataResult in
                let defLists := second dataResult in
                let defName := λd.cases(Definition){
                      `term`=λtd.TermDefinition[name] td,
                      `type`=λtd.TypeDefinition[name] td,
                      `primitive`=λpd.PrimitiveDefinition[name] pd}
                      d in
                let refreshModule := λels,m.Module{
                      name = Module[name] m,
                      metadata = Module[metadata] m,
                      dependencies = Module[dependencies] m,
                      definitions = optionals.givens
                          (lists.map
                            (λd.cases(Definition){
                                `type`=λtd.given(Definition{
                                      `type` = td}),
                                `term`=λtd.optionals.map
                                      (λb.Definition{
                                          `term` = TermDefinition{
                                            name = Binding[name] b,
                                            metadata = none,
                                            signature = optionals.map
                                                typeSchemeToTermSignature
                                                (Binding[typeScheme] b),
                                            body = Binding[`term`] b}})
                                      (lists.find
                                        (λb.equal
                                            (Binding[name] b)
                                            (TermDefinition[name] td))
                                        els),
                                `primitive`=λpd.given(Definition{
                                      `primitive` = pd})}
                                d)
                            (Module[definitions] m))} in
                let allBindings := graphToBindings g1 in
                let refreshedMods := lists.map
                    (λm.refreshModule allBindings m)
                    termModulesToGenerate in
                let termDefNames := λm.optionals.givens
                      (lists.map
                        (λd.cases(Definition){
                            `term`=λtd.given(TermDefinition[name] td),
                            `_`=none}
                            d)
                        (Module[definitions] m)) in
                let g1Primitives := Graph[primitives] g1 in
                eithers.bind
                  (eithers.mapList
                    (λp.
                      let original := first p in
                      let refreshed := second p in
                      let origNames := termDefNames original in
                      let refreshedNames := sets.fromList (termDefNames refreshed) in
                      let missing := lists.filter
                          (λn.and
                              (not (sets.member n refreshedNames))
                              (not (maps.member n g1Primitives)))
                          origNames in
                      ifElse
                        (lists.isEmpty missing)
                        right(refreshed)
                        left(Error{
                          other = OtherError{strings.concat
                            [
                              "refreshModule could not resolve ",
                              printInt32 (lists.length missing),
                              " term binding(s) in ",
                              ModuleName[] (Module[name] original),
                              " against the post-adaptation graph; the loaded universe is missing a dependency these ",
                              "bindings need. Offending name(s): ",
                              strings.join ", " (lists.map Name[] missing)]}}))
                    (lists.zip
                      termModulesToGenerate
                      refreshedMods))
                  (λrefreshedModsChecked.
                    let dedupDefs := λdefs.lists.sortBy
                          (λd.TermDefinition[name] d)
                          (maps.elems
                            (maps.fromList
                              (lists.map
                                (λd.(TermDefinition[name] d, d))
                                defs))) in
                    let dedupedDefLists := lists.map dedupDefs defLists in
                    eithers.map
                      (λxs.lists.concat xs)
                      (eithers.mapList
                        (λp.
                          let mod := first p in
                          let defs := second p in
                          eithers.map
                            (λm.maps.toList m)
                            (printDefinitions
                              mod
                              (lists.map
                                (λd.Definition{
                                    `term` = d})
                                defs)
                              cx
                              g1))
                        (lists.zip
                          refreshedModsChecked
                          dedupedDefLists))))))
          (λtermFiles.
            let mergeFileEntry := λacc,p.maps.alter
                  (λmv.given(optionals.match
                      mv
                      (second p)
                      (λexisting.strings.concat2
                          existing
                          (strings.concat2 "\n" (second p)))))
                  (first p)
                  acc
            in right(maps.toList
              (lists.foldl
                mergeFileEntry
                maps.empty
                (lists.concat2 schemaFiles termFiles)))))

## Perform type inference and generate the lexicon for a set of modules
term inferAndGenerateLexicon =
  λcx,bsGraph,kernelModules.
    let g0 := modulesToGraph bsGraph kernelModules kernelModules in
    let dataElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `term`=λtd.given(Binding{
                          name = TermDefinition[name] td,
                          `term` = TermDefinition[body] td,
                          typeScheme = optionals.map
                              termSignatureToTypeScheme
                              (TermDefinition[signature] td)}),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          kernelModules) in
    eithers.bind
      (inferGraphTypes cx dataElements g0)
      (λinferResultWithCx.
        let g1 := first (first inferResultWithCx) in
        let schemaElements := lists.concat
            (lists.map
              (λm.optionals.givens
                  (lists.map
                    (λd.cases(Definition){
                        `type`=λtd.given((λname,typ.
                              let schemaTerm := Term{
                                variable = Name{"hydra.core.model.Type"}} in
                              let dataTerm := normalizeTermAnnotations
                                  Term{
                                    annotated = AnnotatedTerm{
                                      body = encode.model.type typ,
                                      annotation = wrapAnnotationMap
                                          (maps.fromList [(keyType, schemaTerm)])}} in
                              Binding{
                                name = name,
                                `term` = dataTerm,
                                typeScheme = given(TypeScheme{
                                    variables = [],
                                    body = Type{
                                      variable = Name{"hydra.core.model.Type"}},
                                    constraints = maps.empty})})
                              (TypeDefinition[name] td)
                              (TypeScheme[body]
                                (TypeDefinition[body] td))),
                        `_`=none}
                        d)
                    (Module[definitions] m)))
              kernelModules) in
        let typeBoundTerms := maps.fromList
            (lists.map
              (λb.(Binding[name] b, Binding[`term`] b))
              schemaElements) in
        let typeBoundTypes := maps.fromList
            (optionals.givens
              (lists.map
                (λb.optionals.map
                    (λts.(Binding[name] b, ts))
                    (Binding[typeScheme] b))
                schemaElements)) in
        let g2 := Graph{
          boundTerms = maps.union
              typeBoundTerms
              (Graph[boundTerms] g1),
          boundTypes = Graph[boundTypes] g1,
          classConstraints = Graph[classConstraints] g1,
          lambdaVariables = Graph[lambdaVariables] g1,
          metadata = Graph[metadata] g1,
          primitives = Graph[primitives] g1,
          schemaTypes = Graph[schemaTypes] g1,
          typeVariables = Graph[typeVariables] g1} in
        let g3 := Graph{
          boundTerms = Graph[boundTerms] g2,
          boundTypes = maps.union
              typeBoundTypes
              (Graph[boundTypes] g2),
          classConstraints = Graph[classConstraints] g2,
          lambdaVariables = Graph[lambdaVariables] g2,
          metadata = Graph[metadata] g2,
          primitives = Graph[primitives] g2,
          schemaTypes = Graph[schemaTypes] g2,
          typeVariables = Graph[typeVariables] g2} in
        generateLexicon g3)

## Perform type inference on modules and reconstruct with inferred types
term inferModules =
  λcx,bsGraph,universeMods,targetMods.
    let g0 := modulesToGraph bsGraph universeMods targetMods in
    let dataElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `term`=λtd.given(Binding{
                          name = TermDefinition[name] td,
                          `term` = TermDefinition[body] td,
                          typeScheme = optionals.map
                              termSignatureToTypeScheme
                              (TermDefinition[signature] td)}),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          (lists.concat2 universeMods targetMods)) in
    eithers.bind
      (inferGraphTypes cx dataElements g0)
      (λinferResultWithCx.
        let inferResult := first inferResultWithCx in
        let inferredElements := second inferResult in
        right(lists.map (refreshModule inferredElements) targetMods))

## Infer types for target modules in the context of a typed universe
term inferModulesGiven =
  λcx,bsGraph,universeMods,targetMods.
    let g0 := modulesToGraph bsGraph universeMods targetMods in
    let nsMap := maps.fromList
        (lists.map
          (λm.(Module[name] m, m))
          (lists.concat2 universeMods targetMods)) in
    let closureMods := moduleDepsTransitive nsMap targetMods in
    let targetNamespaces := sets.fromList (lists.map Module[name] targetMods) in
    let termBindings := lists.concat
        (lists.map
          (λm.
            let isTarget := sets.member (Module[name] m) targetNamespaces in
            let bs := optionals.givens
                (lists.map
                  (λd.cases(Definition){
                      `term`=λtd.given(Binding{
                            name = TermDefinition[name] td,
                            `term` = TermDefinition[body] td,
                            typeScheme = optionals.map
                                termSignatureToTypeScheme
                                (TermDefinition[signature] td)}),
                      `_`=none}
                      d)
                  (Module[definitions] m)) in
            ifElse
              isTarget
              bs
              (lists.filter
                (λb.optionals.isNone (Binding[typeScheme] b))
                bs))
          closureMods) in
    let primitiveBindings := lists.concat
        (lists.map
          (λm.
            let isTarget := sets.member
                (Module[name] m)
                targetNamespaces in
            let bs := optionals.givens
                (lists.map
                  (λd.cases(Definition){
                      `primitive`=λpd.optionals.map
                            (λimpl.Binding{
                                name = PrimitiveDefinition[name] pd,
                                `term` = impl,
                                typeScheme = given(termSignatureToTypeScheme
                                    (PrimitiveDefinition[signature] pd))})
                            (PrimitiveDefinition[defaultImplementation]
                              pd),
                      `_`=none}
                      d)
                  (Module[definitions] m)) in
            ifElse isTarget bs [])
          closureMods) in
    let bindingsToInfer := lists.concat2 termBindings primitiveBindings in
    let untouchedTypedBindings := lists.concat
        (lists.map
          (λm.
            let isTarget := sets.member
                (Module[name] m)
                targetNamespaces in
            let bs := optionals.givens
                (lists.map
                  (λd.cases(Definition){
                      `term`=λtd.given(Binding{
                            name = TermDefinition[name] td,
                            `term` = TermDefinition[body] td,
                            typeScheme = optionals.map
                                termSignatureToTypeScheme
                                (TermDefinition[signature] td)}),
                      `_`=none}
                      d)
                  (Module[definitions] m)) in
            ifElse
              isTarget
              []
              (lists.filter
                (λb.optionals.isGiven (Binding[typeScheme] b))
                bs))
          closureMods) in
    eithers.bind
      (inferGraphTypes cx bindingsToInfer g0)
      (λinferResultWithCx.
        let inferResult := first inferResultWithCx in
        let newlyInferredBindings := second inferResult in
        let allInferredBindings := lists.concat2
            newlyInferredBindings
            untouchedTypedBindings in
        right(lists.map (refreshModule allInferredBindings) targetMods))

## Lower Definition.primitive arms to Definition.term arms with term-encoded PrimitiveDefinition
term lowerPrimitiveDefinitions =
  λm.
    let pkgNs := ModuleName{"hydra.core.packaging"} in
    let coreNs := ModuleName{"hydra.core.model"} in
    let primDefSig := typeSchemeToTermSignature
        TypeScheme{
          variables = [],
          body = Type{variable = Name{"hydra.core.packaging.PrimitiveDefinition"}},
          constraints = maps.empty} in
    let origDefs := Module[definitions] m in
    let hasPrim := lists.foldl
        (λacc,d.or acc (cases(Definition){`primitive`=λ`_`.true, `_`=false} d))
        false
        origDefs in
    ifElse
      (not hasPrim)
      m
      (let newDefs := lists.map
          (λd.cases(Definition){
              `primitive`=λpd.Definition{
                    `term` = TermDefinition{
                      name = PrimitiveDefinition[name] pd,
                      metadata = none,
                      signature = given(primDefSig),
                      body = encode.packaging.primitiveDefinition pd}},
              `_`=d}
              d)
          origDefs in
      let currentDeps := Module[dependencies] m in
      let filteredDeps := lists.filter
          (λdep.and
              (not (equal (ModuleDependency[`module`] dep) pkgNs))
              (not (equal (ModuleDependency[`module`] dep) coreNs)))
          currentDeps in
      let newDeps := lists.concat2
          filteredDeps
          [ModuleDependency{`module` = pkgNs, package = none}, ModuleDependency{`module` = coreNs, package = none}] in
      Module{name = Module[name] m, metadata = Module[metadata] m, dependencies = newDeps, definitions = newDefs})

## Compute transitive closure of dependencies for a set of modules
term moduleDepsTransitive =
  λnsMap,modules.
    let closure := sets.union
        (transitiveDeps
          (λm.lists.map (λdep.ModuleDependency[`module`] dep) (Module[dependencies] m))
          nsMap
          modules)
        (sets.fromList (lists.map (λm.Module[name] m) modules))
    in optionals.givens (lists.map (λn.maps.lookup n nsMap) (sets.toList closure))

## Convert a module name to a file path (e.g., hydra.core.model -> hydra/core)
term moduleNameToPath = λns.strings.join "/" (strings.splitOn "." (ModuleName[] ns))

## Convert a Module to a JSON string
term moduleToJson =
  λschemaMap,m.
    let `term` := encode.packaging.module m in
    let modType := Type{variable = Name{"hydra.core.packaging.Module"}} in
    eithers.map
      (λjson.printJson json)
      (eithers.bimap
        (λ`_e`.Error{other = wrap(OtherError){`_e`}})
        (λ`_a`.`_a`)
        (toJson schemaMap false Name{"hydra.core.packaging.Module"} modType `term`))

## Convert a generated Module into a Source module
term moduleToSourceModule =
  λm.
    let sourceNs := ModuleName{strings.concat2
      "hydra.sources."
      (strings.join
        "."
        (lists.drop 1:int32 (strings.splitOn "." (ModuleName[] (Module[name] m)))))} in
    let modTypeNs := ModuleName{"hydra.core.packaging"} in
    let moduleDef := Definition{
      `term` = TermDefinition{
        name = Name{strings.concat2 (ModuleName[] sourceNs) ".module_"},
        metadata = none,
        signature = given(typeSchemeToTermSignature
            TypeScheme{
              variables = [],
              body = Type{
                variable = Name{"hydra.core.packaging.Module"}},
              constraints = maps.empty}),
        body = encode.packaging.module m}} in
    Module{
      name = sourceNs,
      metadata = given(EntityMetadata{
          description = given(strings.concat2
              "Source module for "
              (ModuleName[] (Module[name] m))),
          comments = [],
          seeAlso = [],
          lifecycle = none,
          provisions = []}),
      dependencies = [ModuleDependency{`module` = modTypeNs, package = none}],
      definitions = [moduleDef]}

## Build a graph from universe modules and working modules, using an explicit bootstrap graph
term modulesToGraph =
  λbsGraph,universeModules,modules.
    let universe := maps.fromList
        (lists.map
          (λm.(Module[name] m, m))
          (lists.concat2 universeModules modules)) in
    let closureModules := moduleDepsTransitive
        universe
        (lists.concat2 universeModules modules) in
    let schemaElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `type`=λtd.given((λname,typ.
                          let schemaTerm := Term{
                            variable = Name{"hydra.core.model.Type"}} in
                          let dataTerm := normalizeTermAnnotations
                              Term{
                                annotated = AnnotatedTerm{
                                  body = encode.model.type typ,
                                  annotation = wrapAnnotationMap
                                      (maps.fromList [(keyType, schemaTerm)])}} in
                          Binding{
                            name = name,
                            `term` = dataTerm,
                            typeScheme = given(TypeScheme{
                                variables = [],
                                body = Type{
                                  variable = Name{"hydra.core.model.Type"}},
                                constraints = maps.empty})})
                          (TypeDefinition[name] td)
                          (TypeScheme[body]
                            (TypeDefinition[body] td))),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          closureModules) in
    let dataElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `term`=λtd.given(Binding{
                          name = TermDefinition[name] td,
                          `term` = TermDefinition[body] td,
                          typeScheme = optionals.map
                              termSignatureToTypeScheme
                              (TermDefinition[signature] td)}),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          closureModules) in
    let schemaGraph := elementsToGraph bsGraph maps.empty schemaElements in
    let schemaTypes := eithers.either
        (λ`_`.maps.empty)
        (λ`_r`.`_r`)
        (schemaGraphToTypingEnvironment schemaGraph) in
    let baseGraph := elementsToGraph bsGraph schemaTypes dataElements in
    let universeDataElements := lists.concat
        (lists.map
          (λm.optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `term`=λtd.given(Binding{
                          name = TermDefinition[name] td,
                          `term` = TermDefinition[body] td,
                          typeScheme = optionals.map
                              termSignatureToTypeScheme
                              (TermDefinition[signature] td)}),
                    `_`=none}
                    d)
                (Module[definitions] m)))
          universeModules) in
    let universeBoundTypes := maps.fromList
        (optionals.givens
          (lists.map
            (λb.optionals.map
                (λts.(Binding[name] b, ts))
                (Binding[typeScheme] b))
            universeDataElements)) in
    Graph{
      boundTerms = Graph[boundTerms] baseGraph,
      boundTypes = universeBoundTypes,
      classConstraints = Graph[classConstraints] baseGraph,
      lambdaVariables = Graph[lambdaVariables] baseGraph,
      metadata = Graph[metadata] baseGraph,
      primitives = Graph[primitives] baseGraph,
      schemaTypes = Graph[schemaTypes] baseGraph,
      typeVariables = Graph[typeVariables] baseGraph}

## Rebuild a module's term definitions using freshly inferred bindings
term refreshModule =
  λinferredElements,m.ifElse
      (not
        (not
          (lists.isEmpty
            (optionals.givens
              (lists.map
                (λd.cases(Definition){
                    `term`=λtd.given(Binding{
                          name = TermDefinition[name] td,
                          `term` = TermDefinition[body] td,
                          typeScheme = optionals.map
                              termSignatureToTypeScheme
                              (TermDefinition[signature] td)}),
                    `_`=none}
                    d)
                (Module[definitions] m))))))
      m
      Module{
        name = Module[name] m,
        metadata = Module[metadata] m,
        dependencies = Module[dependencies] m,
        definitions = optionals.givens
            (lists.map
              (λd.cases(Definition){
                  `type`=λtd.given(Definition{`type` = td}),
                  `term`=λtd.optionals.map
                        (λb.Definition{
                            `term` = TermDefinition{
                              name = Binding[name] b,
                              metadata = none,
                              signature = optionals.map
                                  typeSchemeToTermSignature
                                  (Binding[typeScheme] b),
                              body = Binding[`term`] b}})
                        (lists.find
                          (λb.equal
                              (Binding[name] b)
                              (TermDefinition[name] td))
                          inferredElements),
                  `primitive`=λpd.given(Definition{`primitive` = pd})}
                  d)
              (Module[definitions] m))}

## Compute transitive closure of module dependencies
term transitiveDeps =
  λgetDeps,nsMap,startMods.
    let initialDeps := sets.fromList
        (lists.concat
          (lists.map
            (λm.lists.filter (λdep.not (equal dep (Module[name] m))) (getDeps m))
            startMods)) in
    let go := λpending,visited.ifElse
          (sets.isEmpty pending)
          visited
          (let newVisited := sets.union visited pending in
          let nextDeps := sets.fromList
              (lists.concat
                (lists.map
                  (λnsv.optionals.match
                      (maps.lookup nsv nsMap)
                      []
                      (λdepMod.getDeps depMod))
                  (sets.toList pending))) in
          let newPending := sets.difference nextDeps newVisited in
          go newPending newVisited) in
    go initialDeps sets.empty