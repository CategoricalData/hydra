#^^^^^^ source.hydra keyword.control.import.hydra
#      ^ source.hydra
#       ^^^^^^^^^^^^^^^^ source.hydra entity.name.namespace.hydra
>import hydra.core.regex
#^^^^^^ source.hydra keyword.control.import.hydra
#      ^ source.hydra
#       ^^^^^^^^^^^^^^^^ source.hydra entity.name.namespace.hydra
