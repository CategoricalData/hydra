#    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>  anyOf: list<TermConstraint>,
#^^ source.hydra
#  ^^^^^ source.hydra variable.other.member.hydra
