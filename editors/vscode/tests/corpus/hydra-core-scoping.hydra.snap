>## Convert a forall type to a type scheme
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term fTypeToTypeScheme = λtyp.let stripAnnotations := λt.cases(model.Type){annotated=λat.stripAnnotations (model.AnnotatedType[body] at), `_`=t} t in let gatherForall := λvars,typ.cases(model.Type){`forall`=λft.gatherForall (lists.cons (model.ForallType[parameter] ft) vars) (model.ForallType[body] ft), `_`=model.TypeScheme{variables = lists.reverse vars, body = typ, constraints = maps.empty}} (stripAnnotations typ) in gatherForall [] typ
