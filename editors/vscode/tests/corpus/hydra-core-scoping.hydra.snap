>## Extend a graph by descending into a type lambda body
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term extendGraphForTypeLambda = λg,tlam.let name := model.TypeLambda[parameter] tlam in graph.Graph{boundTerms = graph.Graph[boundTerms] g, boundTypes = graph.Graph[boundTypes] g, classConstraints = graph.Graph[classConstraints] g, lambdaVariables = graph.Graph[lambdaVariables] g, metadata = graph.Graph[metadata] g, primitives = graph.Graph[primitives] g, schemaTypes = graph.Graph[schemaTypes] g, typeVariables = sets.insert name (graph.Graph[typeVariables] g)}
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                             ^ source.hydra
#                              ^ source.hydra keyword.operator.equals.hydra
