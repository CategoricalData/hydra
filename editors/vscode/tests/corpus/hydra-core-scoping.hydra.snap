>
>## Convert a TypeScheme to a TermSignature. Type variables and class constraints are preserved exactly. Value-parameter names are synthesized as arg0, arg1, .... Per-parameter descriptions are nothing and isLazy defaults to false.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term typeSchemeToTermSignature = λts.let variables := model.TypeScheme[variables] ts in let body := model.TypeScheme[body] ts in let constraintsMap := model.TypeScheme[constraints] ts in let typeParams := lists.map (λv.typing.TypeParameter{name = v, constraints = optionals.match (maps.lookup v constraintsMap) [] (λtvm.sets.toList (model.TypeVariableConstraints[classes] tvm))}) variables in let peel := λacc,t.cases(model.Type){function=λft.peel (lists.cons (model.FunctionType[domain] ft) acc) (model.FunctionType[codomain] ft), `_`=(lists.reverse acc, t)} t in let peeled := peel [] body in let paramTypes := pairs.first peeled in let resultType := pairs.second peeled in let params := lists.reverse (pairs.first (lists.foldl (λacc,ty.let pairAcc := pairs.first acc in let i := pairs.second acc in (lists.cons typing.Parameter{name = model.Name{strings.concat ["arg", literals.printInt32 i]}, description = none, `type` = ty, isLazy = false} pairAcc, math.add i 1:int32)) ([], 0:int32) paramTypes)) in let result := typing.Result{description = none, `type` = resultType} in typing.TermSignature{typeParameters = typeParams, parameters = params, result = result}
