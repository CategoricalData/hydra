>## Add bindings to an existing graph
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term extendGraphWithBindings = λbindings,g.let newTerms := maps.fromList (lists.map (λb.(model.Binding[name] b, model.Binding[`term`] b)) bindings) in let newTypes := maps.fromList (optionals.givens (lists.map (λb.optionals.map (λts.(model.Binding[name] b, ts)) (model.Binding[typeScheme] b)) bindings)) in graph.Graph{boundTerms = maps.union newTerms (graph.Graph[boundTerms] g), boundTypes = maps.union newTypes (graph.Graph[boundTypes] g), classConstraints = graph.Graph[classConstraints] g, lambdaVariables = graph.Graph[lambdaVariables] g, metadata = graph.Graph[metadata] g, primitives = graph.Graph[primitives] g, schemaTypes = graph.Graph[schemaTypes] g, typeVariables = graph.Graph[typeVariables] g}
