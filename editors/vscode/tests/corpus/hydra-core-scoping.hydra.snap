>## Convert a TermSignature to a TypeScheme, erasing parameter names, descriptions, and laziness flags.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term termSignatureToTypeScheme = λsig.let typeParams := typing.TermSignature[typeParameters] sig in let params := typing.TermSignature[parameters] sig in let result := typing.TermSignature[result] sig in let variables := lists.map (λtp.typing.TypeParameter[name] tp) typeParams in let body := lists.foldl (λacc,p.model.Type{function = model.FunctionType{domain = typing.Parameter[`type`] p, codomain = acc}}) (typing.Result[`type`] result) (lists.reverse params) in let constraints := maps.fromList (lists.map (λtp.(typing.TypeParameter[name] tp, model.TypeVariableConstraints{classes = sets.fromList (typing.TypeParameter[constraints] tp)})) typeParams) in model.TypeScheme{variables = variables, body = body, constraints = constraints}
