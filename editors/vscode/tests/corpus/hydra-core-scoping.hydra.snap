>## Convert a type scheme to a forall type
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term typeSchemeToFType = λts.let vars := model.TypeScheme[variables] ts in let body := model.TypeScheme[body] ts in lists.foldl (λt,v.model.Type{`forall` = model.ForallType{parameter = v, body = t}}) body (lists.reverse vars)
