>## Extend a graph by descending into a let body
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term extendGraphForLet = λforBinding,g,letrec.let bindings := model.Let[bindings] letrec in let g2 := extendGraphWithBindings bindings g in graph.Graph{boundTerms = maps.union (maps.fromList (lists.map (λb.(model.Binding[name] b, model.Binding[`term`] b)) bindings)) (graph.Graph[boundTerms] g), boundTypes = maps.union (maps.fromList (optionals.givens (lists.map (λb.optionals.map (λts.(model.Binding[name] b, ts)) (model.Binding[typeScheme] b)) bindings))) (graph.Graph[boundTypes] g), classConstraints = graph.Graph[classConstraints] g, lambdaVariables = lists.foldl (λs,b.sets.delete (model.Binding[name] b) s) (graph.Graph[lambdaVariables] g) bindings, metadata = graph.Graph[metadata] (lists.foldl (λgAcc,b.let m := graph.Graph[metadata] gAcc in let newMeta := optionals.match (forBinding gAcc b) (maps.delete (model.Binding[name] b) m) (λt.maps.insert (model.Binding[name] b) t m) in graph.Graph{boundTerms = graph.Graph[boundTerms] gAcc, boundTypes = graph.Graph[boundTypes] gAcc, classConstraints = graph.Graph[classConstraints] gAcc, lambdaVariables = graph.Graph[lambdaVariables] gAcc, metadata = newMeta, primitives = graph.Graph[primitives] gAcc, schemaTypes = graph.Graph[schemaTypes] gAcc, typeVariables = graph.Graph[typeVariables] gAcc}) g2 bindings), primitives = graph.Graph[primitives] g, schemaTypes = graph.Graph[schemaTypes] g, typeVariables = graph.Graph[typeVariables] g}
