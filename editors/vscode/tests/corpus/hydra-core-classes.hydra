## Registry of Hydra's built-in type classes.
module hydra.core.classes

import hydra.core.lib.equality
import hydra.core.lib.logic
import hydra.core.model
import hydra.core.strip
import hydra.core.typing

## Check whether a type is an instance of a constraint class, by the class's short name.
term classIsSatisfiedByType =
  λclassName,typ.
    let isIntegerLiteral := cases(Type){
        literal=λlt.cases(LiteralType){integer=λ`_`.true, `_`=false}
              lt,
        `_`=false}
        (deannotateType typ) in
    let isFloatLiteral := cases(Type){
        literal=λlt.cases(LiteralType){float=λ`_`.true, `_`=false} lt,
        `_`=false}
        (deannotateType typ) in
    ifElse
      (equal className Name{"equality"})
      true
      (ifElse
        (equal className Name{"ordering"})
        true
        (ifElse
          (equal className Name{"numeric"})
          (or isIntegerLiteral isFloatLiteral)
          (ifElse
            (equal className Name{"integral"})
            isIntegerLiteral
            (ifElse (equal className Name{"fractional"}) isFloatLiteral false))))

## The equality type class: instances support structural equality.
term equality = TypeClass{description = "Equality: instances support structural equality."}

## The fractional type class: instances support total floating-point division.
term fractional = TypeClass{description = "Fractional: instances support total floating-point division."}

## The integral type class: instances support integer division, modulus, remainder, and parity.
term integral =
  TypeClass{description = "Integral: instances support integer division, modulus, remainder, and parity."}

## The numeric type class: instances support arithmetic (addition, subtraction, multiplication, negation).
term numeric =
  TypeClass{description = "Numeric: instances support arithmetic (addition, subtraction, multiplication, negation)."}

## The ordering type class: instances support total ordering (and equality).
term ordering = TypeClass{description = "Ordering: instances support total ordering (and equality)."}