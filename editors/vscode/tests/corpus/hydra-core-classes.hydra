## Registry of Hydra's built-in type classes.
module hydra.core.classes

import hydra.core.lib.equality
import hydra.core.lib.lists as lists
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.model
import hydra.core.strip
import hydra.core.typing

## Check whether a type is an instance of a constraint class, by the class's short name, resolving nominal types through the given schema.
term classIsSatisfiedByType =
  λschema, className, typ.
    let isIntegerLiteral := cases(Type){
        literal = λlt.cases(LiteralType){integer = λ`_`.true, `_` = false}
              lt,
        `_` = false}
        (deannotateType typ) in
    let isFloatLiteral := cases(Type){
        literal = λlt.cases(LiteralType){float = λ`_`.true, `_` = false}
              lt,
        `_` = false}
        (deannotateType typ) in
    ifElse
      (equal className Name{"equality"})
      (isComparableType schema typ)
      (ifElse
        (equal className Name{"ordering"})
        (isComparableType schema typ)
        (ifElse
          (equal className Name{"numeric"})
          (or isIntegerLiteral isFloatLiteral)
          (ifElse
            (equal className Name{"integral"})
            isIntegerLiteral
            (ifElse (equal className Name{"fractional"}) isFloatLiteral false))))

## The equality type class: instances support structural equality.
term equality = TypeClass{description = "Equality: instances support structural equality."}

## The fractional type class: instances support total floating-point division.
term fractional = TypeClass{description = "Fractional: instances support total floating-point division."}

## The integral type class: instances support integer division, modulus, remainder, and parity.
term integral =
  TypeClass{description = "Integral: instances support integer division, modulus, remainder, and parity."}

## Check whether a type is comparable (an instance of equality and ordering), resolving nominal types through the given schema.
term isComparableType =
  λschema, typ.
    let go := λvisited, env, args, t.
        let goAll := λvisited2, ts.lists.foldl
              (λacc, t2.ifElse
                  (first acc)
                  (go (second acc) env [] t2)
                  acc)
              (true, visited2)
              ts in
        let allArgs := lists.foldl (λb1, b2.and b1 b2) true args in
        cases(Type){
          application = λat.
              let argResult := go
                  visited
                  env
                  []
                  (ApplicationType[argument] at)
              in go
                (second argResult)
                env
                (lists.cons (first argResult) args)
                (ApplicationType[function] at),
          `effect` = λ`_`.(false, visited),
          `either` = λet.goAll
                visited
                [EitherType[`left`] et, EitherType[`right`] et],
          `forall` = λft.match
                (lists.uncons args)
                (go
                  visited
                  (maps.insert
                    (ForallType[parameter] ft)
                    true
                    env)
                  []
                  (ForallType[body] ft))
                (λargsUc.go
                    visited
                    (maps.insert
                      (ForallType[parameter] ft)
                      (first argsUc)
                      env)
                    (second argsUc)
                    (ForallType[body] ft)),
          function = λ`_`.(false, visited),
          `list` = λlt.goAll visited [lt],
          `map` = λmt.goAll
                visited
                [MapType[keys] mt, MapType[values] mt],
          `optional` = λot.goAll visited [ot],
          pair = λpt.goAll
                visited
                [PairType[first] pt, PairType[second] pt],
          `record` = λfields.goAll
                visited
                (lists.map FieldType[`type`] fields),
          `set` = λst.goAll visited [st],
          `union` = λfields.goAll
                visited
                (lists.map FieldType[`type`] fields),
          variable = λv.match
                (maps.lookup v env)
                (match
                  (maps.lookup v schema)
                  (allArgs, visited)
                  (λts.
                    let params := TypeScheme[variables] ts in
                    let key := Name{strings.concat
                      (lists.cons
                        (Name[] v)
                        (lists.map (λb.ifElse b "+" "-") args))} in
                    ifElse
                      (sets.member key visited)
                      (true, visited)
                      (go
                        (sets.insert key visited)
                        (maps.fromList
                          (lists.zip
                            params
                            (lists.concat2
                              args
                              (lists.replicate (lists.length params) true))))
                        (lists.drop (lists.length params) args)
                        (TypeScheme[body] ts))))
                (λb.(and b allArgs, visited)),
          `wrap` = λwt.goAll visited [wt],
          `_` = (true, visited)}
          (deannotateType t)
    in first (go sets.empty maps.empty [] typ)

## The numeric type class: instances support arithmetic (addition, subtraction, multiplication, negation).
term numeric =
  TypeClass{description = "Numeric: instances support arithmetic (addition, subtraction, multiplication, negation)."}

## The ordering type class: instances support total ordering (and equality).
term ordering = TypeClass{description = "Ordering: instances support total ordering (and equality)."}