>## Render a single Unicode code point as a one-character string.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term printCodePoint = λc.strings.fromList [c]
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^^^^^ source.hydra entity.name.function.hydra
#                   ^ source.hydra
#                    ^ source.hydra keyword.operator.equals.hydra
#                     ^ source.hydra
#                      ^ source.hydra keyword.operator.lambda.hydra
#                       ^ source.hydra variable.parameter.hydra
#                        ^ source.hydra punctuation.separator.binder.hydra
#                         ^^^^^^^^^^^^^^^^ source.hydra variable.other.qualified.hydra
#                                         ^^ source.hydra
#                                           ^ source.hydra variable.other.hydra
#                                            ^^ source.hydra
>
>## Render a hydra.core.regex AST into POSIX ERE syntax. Identical to the canonical printer except that . (any incl. newline) becomes the grouped alternation (.|<newline>).
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term printRegex = λr.alternation r
#^^^^ source.hydra keyword.other.definition.hydra
#    ^ source.hydra
#     ^^^^^^^^^^ source.hydra entity.name.function.hydra
#               ^ source.hydra
#                ^ source.hydra keyword.operator.equals.hydra
#                 ^ source.hydra
#                  ^ source.hydra keyword.operator.lambda.hydra
#                   ^ source.hydra variable.parameter.hydra
#                    ^ source.hydra punctuation.separator.binder.hydra
#                     ^^^^^^^^^^^ source.hydra variable.other.hydra
#                                ^ source.hydra
#                                 ^ source.hydra variable.other.hydra
>
>## Render an atom followed by its quantifier suffix.
#^^ source.hydra comment.block.documentation.hydra
#  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.hydra comment.block.documentation.hydra
>term quantified = λqa.strings.concat2 (atom (regex.Quantified[atom] qa)) (quantifier (regex.Quantified[quantifier] qa))
