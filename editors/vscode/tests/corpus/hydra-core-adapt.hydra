## Simple, one-way adapters for types and terms
module hydra.core.adapt

import hydra.core.annotations
import hydra.core.coders
import hydra.core.dependencies
import hydra.core.environment
import hydra.core.errors
import hydra.core.graph
import hydra.core.hoisting
import hydra.core.inference
import hydra.core.lexical
import hydra.core.lib.eithers as eithers
import hydra.core.lib.equality
import hydra.core.lib.functions
import hydra.core.lib.lists as lists
import hydra.core.lib.literals
import hydra.core.lib.logic
import hydra.core.lib.maps as maps
import hydra.core.lib.optionals as optionals
import hydra.core.lib.pairs
import hydra.core.lib.sets as sets
import hydra.core.lib.strings as strings
import hydra.core.literals
import hydra.core.model
import hydra.core.names
import hydra.core.packaging
import hydra.core.print.model as model
import hydra.core.reduction
import hydra.core.reflect as reflect
import hydra.core.resolution
import hydra.core.rewriting
import hydra.core.scoping
import hydra.core.strip
import hydra.core.typing
import hydra.core.variables

## Adapt a graph and its schema to the given language constraints. The doExpand flag controls eta expansion of partial applications. Adaptation is type-preserving: binding-level TypeSchemes are adapted (not stripped). Note: case statement hoisting is done separately, prior to adaptation. The els0 parameter provides the original ordered bindings. Returns both the adapted graph and the ordered adapted bindings.
term adaptDataGraph =
  λconstraints,doExpand,els0,cx,graph0.
    let transformTerm := λg,`term`.
        let tx := g in
        let t1 := unshadowVariables
            (pushTypeAppsInward `term`) in
        let t2 := unshadowVariables
            (ifElse
              doExpand
              (pushTypeAppsInward (etaExpandTerm tx t1))
              t1) in
        liftLambdaAboveLet t2 in
    let transformBinding := λg,el.Binding{
          name = Binding[name] el,
          `term` = transformTerm g (Binding[`term`] el),
          typeScheme = Binding[typeScheme] el} in
    let litmap := adaptLiteralTypesMap constraints in
    let prims0 := Graph[primitives] graph0 in
    let schemaTypes0 := Graph[schemaTypes] graph0 in
    let schemaBindings := typesToDefinitions
        (maps.map (λts.typeSchemeToFType ts) schemaTypes0) in
    eithers.bind
      (ifElse
        (maps.isEmpty schemaTypes0)
        right(maps.empty)
        (eithers.bind
          (eithers.bimap
            (λe.Error{decoding = e})
            (λx.x)
            (graphAsTypes graph0 schemaBindings))
          (λtmap0.eithers.bind
              (adaptGraphSchema constraints litmap tmap0)
              (λtmap1.right(maps.map (λt.typeToTypeScheme t) tmap1)))))
      (λschemaResult.
        let adaptedSchemaTypes := schemaResult in
        let adaptBinding := λel.
            let transformed := transformBinding graph0 el in
            let wrapped := Term{
              `let` = Let{
                bindings = lists.singleton transformed,
                body = Term{
                  `unit`}}} in
            eithers.bind
              (adaptTerm
                constraints
                litmap
                cx
                graph0
                wrapped)
              (λadapted.rewriteTermM
                  (adaptLambdaDomains constraints litmap)
                  adapted) in
        eithers.bind
          (eithers.mapList adaptBinding els0)
          (λadaptedTerms.
            let els1Raw := lists.concat
                (lists.map termAsBindings adaptedTerms) in
            let processBinding := λel.eithers.bind
                  (rewriteTermM
                    (adaptNestedTypes constraints litmap)
                    (Binding[`term`] el))
                  (λnewTerm.eithers.bind
                      (optionals.match
                        (Binding[typeScheme] el)
                        right(none)
                        (λts.eithers.bind
                            (adaptTypeScheme constraints litmap ts)
                            (λts1.right(given(ts1)))))
                      (λadaptedType.right(Binding{
                          name = Binding[name] el,
                          `term` = newTerm,
                          typeScheme = adaptedType}))) in
            eithers.bind
              (eithers.mapList processBinding els1Raw)
              (λels1.eithers.bind
                  (eithers.mapList
                    (λkv.eithers.bind
                        (adaptPrimitive constraints litmap (second kv))
                        (λprim1.right((first kv, prim1))))
                    (maps.toList prims0))
                  (λprimPairs.
                    let prims1 := maps.fromList primPairs in
                    let adaptedGraphRaw := buildGraph els1 maps.empty prims1 in
                    let adaptedGraph := Graph{
                      boundTerms = Graph[boundTerms] adaptedGraphRaw,
                      boundTypes = Graph[boundTypes] adaptedGraphRaw,
                      classConstraints = Graph[classConstraints] adaptedGraphRaw,
                      lambdaVariables = Graph[lambdaVariables] adaptedGraphRaw,
                      metadata = Graph[metadata] adaptedGraphRaw,
                      primitives = Graph[primitives] adaptedGraphRaw,
                      schemaTypes = adaptedSchemaTypes,
                      typeVariables = Graph[typeVariables] adaptedGraphRaw} in
                    right((adaptedGraph, els1))))))

## Attempt to adapt a floating-point type using the given language constraints
term adaptFloatType =
  λconstraints,ft.
    let supported := sets.member ft (LanguageConstraints[floatTypes] constraints) in
    let alt := adaptFloatType constraints in
    let forUnsupported := λft.cases(FloatType){
          `float32`=λ`_`.alt FloatType{`float64`},
          `float64`=λ`_`.alt FloatType{`float32`}}
          ft in
    ifElse supported given(ft) (forUnsupported ft)

## Adapt a schema graph to the given language constraints
term adaptGraphSchema =
  λconstraints,litmap,types0.
    let mapPair := λpair.
        let name := first pair in
        let typ := second pair in
        eithers.bind
          (adaptType constraints litmap typ)
          (λtyp1.right((name, typ1)))
    in eithers.bind
      (eithers.mapList mapPair (maps.toList types0))
      (λpairs.right(maps.fromList pairs))

## Attempt to adapt an integer type using the given language constraints
term adaptIntegerType =
  λconstraints,it.
    let supported := sets.member it (LanguageConstraints[integerTypes] constraints) in
    let alt := adaptIntegerType constraints in
    let forUnsupported := λit.cases(IntegerType){
          `bigint`=λ`_`.none,
          `int8`=λ`_`.alt IntegerType{`uint16`},
          `int16`=λ`_`.alt IntegerType{`uint32`},
          `int32`=λ`_`.alt IntegerType{`uint64`},
          `int64`=λ`_`.alt IntegerType{`bigint`},
          `uint8`=λ`_`.alt IntegerType{`int16`},
          `uint16`=λ`_`.alt IntegerType{`int32`},
          `uint32`=λ`_`.alt IntegerType{`int64`},
          `uint64`=λ`_`.alt IntegerType{`bigint`}}
          it in
    ifElse supported given(it) (forUnsupported it)

## Rewrite callback for adapting lambda domain types in a term
term adaptLambdaDomains =
  λconstraints,litmap,recurse,`term`.eithers.bind
      (recurse `term`)
      (λrewritten.cases(Term){
          lambda=λl.eithers.bind
                (optionals.match
                  (Lambda[domain] l)
                  right(none)
                  (λdom.eithers.bind
                      (adaptType constraints litmap dom)
                      (λdom1.right(given(dom1)))))
                (λadaptedDomain.right(Term{
                    lambda = Lambda{
                      parameter = Lambda[parameter] l,
                      domain = adaptedDomain,
                      body = Lambda[body] l}})),
          `_`=right(rewritten)}
          rewritten)

## Convert a literal to a different type
term adaptLiteral =
  λlt,l.cases(Literal){
      `binary`=λb.cases(LiteralType){`string`=λ`_`.Literal{`string` = binaryToBase64 b}} lt,
      `boolean`=λb.cases(LiteralType){
            integer=λit.Literal{
                  integer = bigintToIntegerValue
                      it
                      (ifElse b 1:bigint 0:bigint)}}
            lt,
      `decimal`=λd.cases(LiteralType){
            float=λ`_`.Literal{
                  float = FloatValue{
                    `float64` = decimalToFloat64 d}},
            `string`=λ`_`.Literal{`string` = printDecimal d}}
            lt,
      float=λf.cases(LiteralType){
            float=λft.Literal{
                  float = cases(FloatType){
                      `float32`=λ`_`.FloatValue{
                            `float32` = cases(FloatValue){
                                `float32`=λf32.f32,
                                `float64`=λf64.float64ToFloat32 f64}
                                f},
                      `float64`=λ`_`.FloatValue{
                            `float64` = cases(FloatValue){
                                `float32`=λf32.float32ToFloat64 f32,
                                `float64`=λf64.f64}
                                f}}
                      ft}}
            lt,
      integer=λi.cases(LiteralType){
            integer=λit.Literal{
                  integer = bigintToIntegerValue
                      it
                      (integerValueToBigint i)}}
            lt}
      l

## Attempt to adapt a literal type using the given language constraints
term adaptLiteralType =
  λconstraints,lt.
    let forUnsupported := λlt.cases(LiteralType){
          `binary`=λ`_`.given(LiteralType{`string`}),
          `boolean`=λ`_`.optionals.map
                (λx.LiteralType{integer = x})
                (adaptIntegerType
                  constraints
                  IntegerType{`int8`}),
          `decimal`=λ`_`.given(LiteralType{
                float = FloatType{
                  `float64`}}),
          float=λft.optionals.map
                (λx.LiteralType{float = x})
                (adaptFloatType constraints ft),
          integer=λit.optionals.map
                (λx.LiteralType{integer = x})
                (adaptIntegerType constraints it),
          `_`=none}
          lt
    in ifElse (literalTypeSupported constraints lt) none (forUnsupported lt)

## Derive a map of adapted literal types for the given language constraints
term adaptLiteralTypesMap =
  λconstraints.
    let tryType := λlt.optionals.match (adaptLiteralType constraints lt) none (λlt2.given((lt, lt2)))
    in maps.fromList (optionals.givens (lists.map tryType reflect.literalTypes))

## Adapt a literal value using the given language constraints
term adaptLiteralValue =
  λlitmap,lt,l.optionals.match (maps.lookup lt litmap) Literal{`string` = model.literal l} (λlt2.adaptLiteral lt2 l)

## Rewrite callback for adapting nested let binding TypeSchemes in a term
term adaptNestedTypes =
  λconstraints,litmap,recurse,`term`.eithers.bind
      (recurse `term`)
      (λrewritten.cases(Term){
          `let`=λlt.
              let adaptB := λb.eithers.bind
                    (optionals.match
                      (Binding[typeScheme] b)
                      right(none)
                      (λts.eithers.bind
                          (adaptTypeScheme constraints litmap ts)
                          (λts1.right(given(ts1)))))
                    (λadaptedBType.right(Binding{
                        name = Binding[name] b,
                        `term` = Binding[`term`] b,
                        typeScheme = adaptedBType}))
              in eithers.bind
                (eithers.mapList adaptB (Let[bindings] lt))
                (λadaptedBindings.right(Term{
                    `let` = Let{
                      bindings = adaptedBindings,
                      body = Let[body] lt}})),
          `_`=right(rewritten)}
          rewritten)

## Adapt a primitive to the given language constraints, prior to inference
term adaptPrimitive =
  λconstraints,litmap,prim0.
    let def0 := Primitive[definition] prim0
    in eithers.bind
      (adaptTermSignature constraints litmap (PrimitiveDefinition[signature] def0))
      (λsig1.
        let def1 := PrimitiveDefinition{
          name = PrimitiveDefinition[name] def0,
          metadata = PrimitiveDefinition[metadata] def0,
          signature = sig1,
          isPure = PrimitiveDefinition[isPure] def0,
          isTotal = PrimitiveDefinition[isTotal] def0,
          defaultImplementation = PrimitiveDefinition[defaultImplementation]
              def0}
        in right(Primitive{definition = def1, implementation = Primitive[implementation] prim0}))

## Adapt a term using the given language constraints
term adaptTerm =
  λconstraints,litmap,cx,graph,term0.
    let rewrite := λrecurse,term0.
        let forSupported := λ`term`.cases(Term){
              literal=λl.
                  let lt := reflect.literalType l
                  in right(given(ifElse
                    (literalTypeSupported constraints lt)
                    `term`
                    Term{
                      literal = adaptLiteralValue litmap lt l})),
              `_`=right(given(`term`))}
              `term`, forUnsupported := λ`term`.
            let tryAlts := λalts.optionals.match
                  (lists.uncons alts)
                  right(none)
                  (λuc.eithers.bind
                      (tryTerm (first uc))
                      (λmterm.optionals.match
                          mterm
                          (tryAlts (second uc))
                          (λt.right(given(t)))))
            in eithers.bind
              (termAlternatives cx graph `term`)
              (λalts0.tryAlts alts0), tryTerm := λ`term`.
            let supportedVariant := sets.member
                (reflect.termVariant `term`)
                (LanguageConstraints[termVariants]
                  constraints)
            in ifElse
              supportedVariant
              (forSupported `term`)
              (forUnsupported `term`)
        in eithers.bind
          (recurse term0)
          (λterm1.cases(Term){
              annotated=λ`_`.right(term1),
              typeApplication=λta.eithers.bind
                    (adaptType
                      constraints
                      litmap
                      (TypeApplicationTerm[`type`] ta))
                    (λatyp.right(Term{
                        typeApplication = TypeApplicationTerm{
                          body = TypeApplicationTerm[body] ta,
                          `type` = atyp}})),
              typeLambda=λ`_`.right(term1),
              `_`=eithers.bind
                  (tryTerm term1)
                  (λmterm.optionals.match
                      mterm
                      left(Error{
                        other = OtherError{strings.concat2
                          "no alternatives for term: "
                          (model.term term1)}})
                      (λterm2.right(term2)))}
              term1)
    in rewriteTermM rewrite term0

## Adapt a term using the constraints of a given language
term adaptTermForLanguage =
  λlang,cx,g,`term`.
    let constraints := Language[constraints] lang in
    let litmap := adaptLiteralTypesMap constraints in
    adaptTerm constraints litmap cx g `term`

## Adapt the types within a term signature to the given language constraints, in place. Parameter names, descriptions, and per-parameter isLazy flags, as well as type parameters, are preserved; only the parameter and result types are adapted. Unlike routing through TypeScheme (the type-only view), this retains the full TermSignature metadata, including primitive laziness flags.
term adaptTermSignature =
  λconstraints,litmap,sig0.
    let result0 := TermSignature[result] sig0
    in eithers.bind
      (adaptType constraints litmap (Result[`type`] result0))
      (λresultType1.eithers.bind
          (eithers.mapList
            (λp.eithers.map
                (λty1.Parameter{
                    name = Parameter[name] p,
                    description = Parameter[description] p,
                    `type` = ty1,
                    isLazy = Parameter[isLazy] p})
                (adaptType constraints litmap (Parameter[`type`] p)))
            (TermSignature[parameters] sig0))
          (λparams1.right(TermSignature{
              typeParameters = TermSignature[typeParameters] sig0,
              parameters = params1,
              result = Result{
                description = Result[description] result0,
                `type` = resultType1}})))

## Adapt a type using the given language constraints
term adaptType =
  λconstraints,litmap,type0.
    let forSupported := λtyp.cases(Type){
          literal=λlt.ifElse
                (literalTypeSupported constraints lt)
                given(typ)
                (optionals.match
                  (maps.lookup lt litmap)
                  given(Type{literal = LiteralType{`string`}})
                  (λlt2.given(Type{literal = lt2}))),
          `_`=given(typ)}
          typ, forUnsupported := λtyp.
        let tryAlts := λalts.optionals.bind
              (lists.uncons alts)
              (λuc.optionals.match
                  (tryType (first uc))
                  (tryAlts (second uc))
                  (λt.given(t))) in
        let alts0 := typeAlternatives typ in
        tryAlts alts0, tryType := λtyp.
        let supportedVariant := sets.member
            (reflect.typeVariant typ)
            (LanguageConstraints[typeVariants] constraints)
        in ifElse supportedVariant (forSupported typ) (forUnsupported typ) in
    let rewrite := λrecurse,typ.eithers.bind
          (recurse typ)
          (λtype1.optionals.match
              (tryType type1)
              left(Error{
                other = OtherError{strings.concat2
                  "no alternatives for type: "
                  (model.type typ)}})
              (λtype2.right(type2))) in
    rewriteTypeM rewrite type0

## Adapt a type using the constraints of a given language
term adaptTypeForLanguage =
  λlang,typ.
    let constraints := Language[constraints] lang in
    let litmap := adaptLiteralTypesMap constraints in
    adaptType constraints litmap typ

## Adapt a type scheme to the given language constraints, prior to inference
term adaptTypeScheme =
  λconstraints,litmap,ts0.
    let vars0 := TypeScheme[variables] ts0 in
    let t0 := TypeScheme[body] ts0 in
    eithers.bind
      (adaptType constraints litmap t0)
      (λt1.right(TypeScheme{
          variables = vars0,
          body = t1,
          constraints = TypeScheme[constraints] ts0}))

## Compose two coders into a single coder
term composeCoders =
  λc1,c2.Coder{
      encode = λa.eithers.bind (Coder[encode] c1 a) (λb1.Coder[encode] c2 b1),
      decode = λc.eithers.bind (Coder[decode] c2 c) (λb2.Coder[decode] c1 b2)}

## Given a data graph along with language constraints, original ordered bindings, and a designated list of namespaces, adapt the graph to the language constraints, then return the processed graph along with term definitions grouped by namespace (in the order of the input namespaces). Inference is performed before adaptation if bindings lack type annotations. Hoisting must preserve type schemes; if any binding loses its type scheme after hoisting, the pipeline fails. Adaptation preserves type application/lambda wrappers and adapts embedded types. Post-adaptation inference is performed to ensure binding TypeSchemes are fully consistent. The doExpand flag controls eta expansion. The doHoistCaseStatements flag controls case statement hoisting (needed for Python). The doHoistPolymorphicLetBindings flag controls polymorphic let binding hoisting (needed for Java). The originalBindings parameter provides the original ordered bindings (from module elements).
term dataGraphToDefinitions =
  λconstraints,doInfer,doExpand,doHoistCaseStatements,doHoistPolymorphicLetBindings,originalBindings,graph0,namespaces,cx.
    let namespacesSet := sets.fromList namespaces in
    let isParentBinding := λb.optionals.match
          (moduleNameOf (Binding[name] b))
          false
          (λns.sets.member ns namespacesSet) in
    let hoistCases := λbindings.
        let stripped := lists.map
            (λb.Binding{
                name = Binding[name] b,
                `term` = stripTypeLambdas (Binding[`term`] b),
                typeScheme = Binding[typeScheme] b})
            bindings in
        let term0 := Term{
          `let` = Let{
            bindings = stripped,
            body = Term{
              `unit`}}} in
        let unshadowed0 := termAsBindings (unshadowVariables term0) in
        let hoisted := hoistCaseStatementsInGraph unshadowed0 in
        let term1 := Term{
          `let` = Let{
            bindings = hoisted,
            body = Term{
              `unit`}}} in
        termAsBindings (unshadowVariables term1) in
    let hoistPoly := λbindings.
        let letBefore := Let{
          bindings = bindings,
          body = Term{
            `unit`}} in
        let letAfter := hoistPolymorphicLetBindings
            isParentBinding
            letBefore in
        Let[bindings] letAfter in
    let qualifyUntyped := λb.
        let nm := Name[] (Binding[name] b)
        in optionals.match
          (moduleNameOf (Binding[name] b))
          (strings.concat2 "(no module) " nm)
          (λns.strings.concat
              [ModuleName[] ns, " :: ", nm]) in
    let checkBindingsTyped := λdebugLabel,bindings.
        let untypedBindings := lists.map
            qualifyUntyped
            (lists.filter
              (λb.not
                  (optionals.isGiven
                    (Binding[typeScheme] b)))
              bindings)
        in ifElse
          (lists.isEmpty untypedBindings)
          right(bindings)
          left(Error{
            other = OtherError{strings.concat
              [
                "Found ",
                printInt32 (lists.length untypedBindings),
                " untyped binding(s) (",
                debugLabel,
                "); each must carry a type scheme at this stage. ",
                "This usually means stale dist/json field shapes after a kernel record rename ",
                "(regenerate the affected package's JSON). Offending bindings (module :: name): ",
                strings.join ", " untypedBindings]}}) in
    let normalizeBindings := λbindings.lists.map
          (λb.Binding{
              name = Binding[name] b,
              `term` = pushTypeAppsInward (Binding[`term`] b),
              typeScheme = Binding[typeScheme] b})
          bindings in
    let rebuildGraph := λbindings.
        let g := buildGraph
            bindings
            maps.empty
            (Graph[primitives] graph0)
        in Graph{
          boundTerms = Graph[boundTerms] g,
          boundTypes = Graph[boundTypes] g,
          classConstraints = Graph[classConstraints] g,
          lambdaVariables = Graph[lambdaVariables] g,
          metadata = Graph[metadata] g,
          primitives = Graph[primitives] g,
          schemaTypes = Graph[schemaTypes] graph0,
          typeVariables = Graph[typeVariables] g} in
    let bins0 := originalBindings in
    let bins1 := ifElse
        doHoistCaseStatements
        (hoistCases bins0)
        bins0 in
    eithers.bind
      (ifElse
        doInfer
        (eithers.map
          (λresult.second (first result))
          (inferGraphTypes
            cx
            bins1
            (rebuildGraph bins1)))
        (checkBindingsTyped
          "after case hoisting"
          bins1))
      (λbins2.eithers.bind
          (ifElse
            doHoistPolymorphicLetBindings
            (checkBindingsTyped
              "after let hoisting"
              (hoistPoly bins2))
            right(bins2))
          (λbins3.eithers.bind
              (adaptDataGraph
                constraints
                doExpand
                bins3
                cx
                (rebuildGraph bins3))
              (λadaptResult.
                let adapted := first adaptResult in
                let adaptedBindings := second adaptResult in
                eithers.bind
                  (checkBindingsTyped
                    "after adaptation"
                    adaptedBindings)
                  (λbins4.
                    let bins5Raw := normalizeBindings bins4 in
                    let peelOne := λt.cases(Term){
                          typeLambda=λtl.TypeLambda[body] tl,
                          typeApplication=λta.TypeApplicationTerm[body] ta,
                          `_`=t}
                          t in
                    let extractAnn := λt.cases(Term){
                          annotated=λat.given(AnnotatedTerm[annotation] at),
                          `_`=none}
                          t in
                    let findAnn := λt.
                        let t1 := peelOne t in
                        let t2 := peelOne t1 in
                        let t3 := peelOne t2 in
                        optionals.match
                          (extractAnn t)
                          (optionals.match
                            (extractAnn t1)
                            (optionals.match
                              (extractAnn t2)
                              (extractAnn t3)
                              (λa.given(a)))
                            (λa.given(a)))
                          (λa.given(a)) in
                    let originalAnnotations := maps.fromList
                        (optionals.givens
                          (lists.map
                            (λb.optionals.match
                                (findAnn (Binding[`term`] b))
                                none
                                (λann.given((Binding[name] b, ann))))
                            originalBindings)) in
                    let reattachAnnotation := λb.optionals.match
                          (maps.lookup
                            (Binding[name] b)
                            originalAnnotations)
                          b
                          (λann.Binding{
                              name = Binding[name] b,
                              `term` = cases(Term){
                                  annotated=λat.Term{
                                        annotated = AnnotatedTerm{
                                          body = AnnotatedTerm[body] at,
                                          annotation = wrapAnnotationMap
                                              (maps.union
                                                (getAnnotationMap
                                                  (AnnotatedTerm[annotation] at))
                                                (getAnnotationMap ann))}},
                                  `_`=Term{
                                    annotated = AnnotatedTerm{
                                      body = Binding[`term`] b,
                                      annotation = ann}}}
                                  (Binding[`term`] b),
                              typeScheme = Binding[typeScheme] b}) in
                    let bins5 := lists.map reattachAnnotation bins5Raw in
                    let toDef := λel.optionals.map
                          (λts.TermDefinition{
                              name = Binding[name] el,
                              metadata = none,
                              signature = given(typeSchemeToTermSignature ts),
                              body = Binding[`term`] el})
                          (Binding[typeScheme] el) in
                    let selectedElements := lists.filter
                        (λel.optionals.match
                            (moduleNameOf (Binding[name] el))
                            false
                            (λns.sets.member ns namespacesSet))
                        bins5 in
                    let elementsByNamespace := lists.foldl
                        (λacc,el.optionals.match
                            (moduleNameOf (Binding[name] el))
                            acc
                            (λns.
                              let existing := optionals.match
                                  (maps.lookup ns acc)
                                  []
                                  identity
                              in maps.insert
                                ns
                                (lists.concat2 existing [el])
                                acc))
                        maps.empty
                        selectedElements in
                    let defsGrouped := lists.map
                        (λns.
                          let elsForNs := optionals.match
                              (maps.lookup ns elementsByNamespace)
                              []
                              identity
                          in optionals.givens
                            (lists.map toDef elsForNs))
                        namespaces in
                    let g := buildGraph
                        bins5
                        maps.empty
                        (Graph[primitives] adapted) in
                    right((
                      Graph{
                        boundTerms = Graph[boundTerms] g,
                        boundTypes = Graph[boundTypes] g,
                        classConstraints = Graph[classConstraints] g,
                        lambdaVariables = Graph[lambdaVariables] g,
                        metadata = Graph[metadata] g,
                        primitives = Graph[primitives] g,
                        schemaTypes = Graph[schemaTypes] adapted,
                        typeVariables = Graph[typeVariables] g},
                      defsGrouped))))))

## Check if a literal type is supported by the given language constraints
term literalTypeSupported =
  λconstraints,lt.
    let forType := λlt.cases(LiteralType){
          float=λft.sets.member
                ft
                (LanguageConstraints[floatTypes] constraints),
          integer=λit.sets.member
                it
                (LanguageConstraints[integerTypes] constraints),
          `_`=true}
          lt
    in ifElse
      (sets.member (reflect.literalTypeVariant lt) (LanguageConstraints[literalVariants] constraints))
      (forType lt)
      false

## Prepare a float type, substituting unsupported types
term prepareFloatType =
  λft.cases(FloatType){
      `float32`=λ`_`.(FloatType{`float32`}, (λv.cases(FloatValue){`float32`=λf.FloatValue{`float32` = f}, `_`=v} v, sets.empty)),
      `float64`=λ`_`.(FloatType{`float64`}, (λv.cases(FloatValue){`float64`=λf.FloatValue{`float64` = f}, `_`=v} v, sets.empty))}
      ft

## Prepare an integer type, substituting unsupported types
term prepareIntegerType =
  λit.cases(IntegerType){
      `bigint`=λ`_`.(
            IntegerType{`int64`},
            (
              λv.cases(IntegerValue){`bigint`=λi.IntegerValue{`int64` = bigintToInt64 i}, `_`=v} v,
              sets.fromList ["replace arbitrary-precision integers with 64-bit integers"])),
      `uint8`=λ`_`.(
            IntegerType{`int8`},
            (
              λv.cases(IntegerValue){`uint8`=λi.IntegerValue{`int8` = bigintToInt8 (uint8ToBigint i)}, `_`=v} v,
              sets.fromList ["replace unsigned 8-bit integers with signed 8-bit integers"])),
      `uint32`=λ`_`.(
            IntegerType{`int32`},
            (
              λv.cases(IntegerValue){`uint32`=λi.IntegerValue{`int32` = bigintToInt32 (uint32ToBigint i)}, `_`=v} v,
              sets.fromList ["replace unsigned 32-bit integers with signed 32-bit integers"])),
      `uint64`=λ`_`.(
            IntegerType{`int64`},
            (
              λv.cases(IntegerValue){`uint64`=λi.IntegerValue{`int64` = bigintToInt64 (uint64ToBigint i)}, `_`=v} v,
              sets.fromList ["replace unsigned 64-bit integers with signed 64-bit integers"])),
      `_`=prepareSame it}
      it

## Prepare a literal type, substituting unsupported types
term prepareLiteralType =
  λat.cases(LiteralType){
      `binary`=λ`_`.(
            LiteralType{`string`},
            (
              λv.cases(Literal){`binary`=λb.Literal{`string` = binaryToBase64 b}, `_`=v} v,
              sets.fromList ["replace binary strings with character strings"])),
      `decimal`=λ`_`.(
            LiteralType{float = FloatType{`float64`}},
            (
              λv.cases(Literal){`decimal`=λd.Literal{float = FloatValue{`float64` = decimalToFloat64 d}}, `_`=v} v,
              sets.fromList ["replace arbitrary-precision decimal numbers with 64-bit floating-point numbers (doubles)"])),
      float=λft.
          let result := prepareFloatType ft, rtyp := first result, rep := first (second result), msgs := second (second result)
          in (LiteralType{float = rtyp}, (λv.cases(Literal){float=λfv.Literal{float = rep fv}, `_`=v} v, msgs)),
      integer=λit.
          let result := prepareIntegerType it, rtyp := first result, rep := first (second result), msgs := second (second result)
          in (LiteralType{integer = rtyp}, (λv.cases(Literal){integer=λiv.Literal{integer = rep iv}, `_`=v} v, msgs)),
      `_`=prepareSame at}
      at

## Return a value unchanged with identity transform and no messages
term prepareSame = λx.(x, (λy.y, sets.empty))

## Prepare a type, substituting unsupported literal types
term prepareType =
  λcx,typ.cases(Type){
      literal=λat.
          let result := prepareLiteralType at, rtyp := first result, rep := first (second result), msgs := second (second result)
          in (Type{literal = rtyp}, (λv.cases(Term){literal=λav.Term{literal = rep av}, `_`=v} v, msgs)),
      `_`=prepareSame typ}
      (deannotateType typ)

## Normalize a term by pushing TermTypeApplication inward past TermApplication and TermLambda. This corrects structures produced by poly-let hoisting and eta expansion, where type applications from inference end up wrapping term applications or lambda abstractions instead of being directly on the polymorphic variable.
term pushTypeAppsInward =
  λ`term`.
    let push := λbody,typ.cases(Term){
          annotated=λat.Term{
                annotated = AnnotatedTerm{
                  body = push (AnnotatedTerm[body] at) typ,
                  annotation = AnnotatedTerm[annotation] at}},
          application=λa.go
                Term{
                  application = Application{
                    function = Term{
                      typeApplication = TypeApplicationTerm{
                        body = Application[function] a,
                        `type` = typ}},
                    argument = Application[argument] a}},
          lambda=λl.go
                Term{
                  lambda = Lambda{
                    parameter = Lambda[parameter] l,
                    domain = Lambda[domain] l,
                    body = Term{
                      typeApplication = TypeApplicationTerm{
                        body = Lambda[body] l,
                        `type` = typ}}}},
          `let`=λlt.go
                Term{
                  `let` = Let{
                    bindings = Let[bindings] lt,
                    body = Term{
                      typeApplication = TypeApplicationTerm{
                        body = Let[body] lt,
                        `type` = typ}}}},
          `_`=Term{
            typeApplication = TypeApplicationTerm{
              body = body,
              `type` = typ}}}
          body, go := λt.
        let forField := λfld.Field{name = Field[name] fld, `term` = go (Field[`term`] fld)} in
        let forCaseAlternative := λalt.CaseAlternative{
              name = CaseAlternative[name] alt,
              handler = go (CaseAlternative[handler] alt)} in
        let forLet := λlt.
            let mapBinding := λb.Binding{
                  name = Binding[name] b,
                  `term` = go (Binding[`term`] b),
                  typeScheme = Binding[typeScheme] b}
            in Let{
              bindings = lists.map mapBinding (Let[bindings] lt),
              body = go (Let[body] lt)} in
        let forMap := λm.
            let forPair := λp.(go (first p), go (second p))
            in maps.fromList (lists.map forPair (maps.toList m)) in
        cases(Term){
          annotated=λat.Term{
                annotated = AnnotatedTerm{
                  body = go (AnnotatedTerm[body] at),
                  annotation = AnnotatedTerm[annotation] at}},
          application=λa.Term{
                application = Application{
                  function = go (Application[function] a),
                  argument = go (Application[argument] a)}},
          `cases`=λcs.Term{
                `cases` = CaseStatement{
                  typeName = CaseStatement[typeName] cs,
                  default = optionals.map
                      go
                      (CaseStatement[default] cs),
                  `cases` = lists.map
                      forCaseAlternative
                      (CaseStatement[`cases`] cs)}},
          `either`=λe.Term{`either` = eithers.either (λl.left(go l)) (λr.right(go r)) e},
          lambda=λl.Term{
                lambda = Lambda{
                  parameter = Lambda[parameter] l,
                  domain = Lambda[domain] l,
                  body = go (Lambda[body] l)}},
          `let`=λlt.Term{`let` = forLet lt},
          `list`=λels.Term{`list` = lists.map go els},
          literal=λv.Term{literal = v},
          `map`=λm.Term{`map` = forMap m},
          `optional`=λm.Term{`optional` = optionals.map go m},
          pair=λp.Term{pair = (go (first p), go (second p))},
          `project`=λp.Term{`project` = p},
          `record`=λr.Term{
                `record` = Record{
                  typeName = Record[typeName] r,
                  fields = lists.map forField (Record[fields] r)}},
          `set`=λs.Term{`set` = sets.fromList (lists.map go (sets.toList s))},
          typeApplication=λtt.
              let body1 := go (TypeApplicationTerm[body] tt)
              in push body1 (TypeApplicationTerm[`type`] tt),
          typeLambda=λta.Term{
                typeLambda = TypeLambda{
                  parameter = TypeLambda[parameter] ta,
                  body = go (TypeLambda[body] ta)}},
          `inject`=λi.Term{
                `inject` = Injection{
                  typeName = Injection[typeName] i,
                  field = forField (Injection[field] i)}},
          `unit`=λ`_`.Term{`unit`},
          `unwrap`=λn.Term{`unwrap` = n},
          variable=λv.Term{variable = v},
          `wrap`=λwt.Term{
                `wrap` = WrappedTerm{
                  typeName = WrappedTerm[typeName] wt,
                  body = go (WrappedTerm[body] wt)}}}
          t
    in go `term`

## Given a schema graph along with language constraints and a designated list of element names, adapt the graph to the language constraints, then return a corresponding type definition for each element name.
term schemaGraphToDefinitions =
  λconstraints,graph,nameLists,cx.
    let litmap := adaptLiteralTypesMap constraints
    in eithers.bind
      (eithers.bimap
        (λe.Error{decoding = e})
        (λx.x)
        (graphAsTypes graph (graphToBindings graph)))
      (λtmap0.eithers.bind
          (adaptGraphSchema constraints litmap tmap0)
          (λtmap1.
            let toDef := λpair.TypeDefinition{
                  name = first pair,
                  metadata = none,
                  body = TypeScheme{
                    variables = [],
                    body = second pair,
                    constraints = maps.empty}}
            in right((
              tmap1,
              lists.map
                (λnames.lists.map toDef (optionals.mapOptional (λn.optionals.map (λt.(n, t)) (maps.lookup n tmap1)) names))
                nameLists))))

## Given a target language and a source type, produce an adapter which rewrites the type and its terms according to the language's constraints. The encode direction adapts terms; the decode direction is identity.
term simpleLanguageAdapter =
  λlang,cx,g,typ.
    let constraints := Language[constraints] lang in
    let litmap := adaptLiteralTypesMap constraints in
    eithers.bind
      (adaptType constraints litmap typ)
      (λadaptedType.right(Adapter{
          isLossy = false,
          source = typ,
          target = adaptedType,
          coder = Coder{
            encode = λ`term`.adaptTerm constraints litmap cx g `term`,
            decode = λ`term`.right(`term`)}}))

## Find a list of alternatives for a given term, if any
term termAlternatives =
  λcx,graph,`term`.cases(Term){
      annotated=λat.let term2 := AnnotatedTerm[body] at in right([term2]),
      `optional`=λot.right([Term{`list` = optionals.match ot [] (λterm2.[term2])}]),
      typeLambda=λabs.let term2 := TypeLambda[body] abs in right([term2]),
      typeApplication=λta.let term2 := TypeApplicationTerm[body] ta in right([term2]),
      `inject`=λinj.
          let tname := Injection[typeName] inj in
          let field := Injection[field] inj in
          let fname := Field[name] field in
          let fterm := Field[`term`] field in
          let forFieldType := λft.
              let ftname := FieldType[name] ft
              in Field{
                name = fname,
                `term` = Term{
                  `optional` = ifElse
                      (equal ftname fname)
                      given(fterm)
                      none}} in
          eithers.bind
            (requireUnionType cx graph tname)
            (λrt.right([Term{`record` = Record{typeName = tname, fields = lists.map forFieldType rt}}])),
      `unit`=λ`_`.right([Term{literal = Literal{`boolean` = true}}]),
      `wrap`=λwt.let term2 := WrappedTerm[body] wt in right([term2]),
      `_`=right([])}
      `term`

## Find a list of alternatives for a given type, if any
term typeAlternatives =
  λ`type`.cases(Type){
      annotated=λat.let type2 := AnnotatedType[body] at in [type2],
      `effect`=λet.[et],
      `optional`=λot.[Type{`list` = ot}],
      `union`=λrt.
          let toOptField := λf.FieldType{
                name = FieldType[name] f,
                `type` = Type{`optional` = FieldType[`type`] f}} in
          let optFields := lists.map toOptField rt in
          [Type{`record` = optFields}],
      `unit`=λ`_`.[Type{literal = LiteralType{`boolean`}}],
      `void`=λ`_`.[Type{`unit`}],
      `_`=[]}
      `type`