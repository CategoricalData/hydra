{
  "currentVersion": "0.17.7",
  "hostVersion": "0.17.6",
  "hostOverrides": {"python": "local", "java": "local"},
  "generators": {
    "default": "java",
    "bootstrapSeedHost": "haskell",
    "hosts": {
      "java": {
        "transform": "heads/java/bin/transform-json-to-target.sh",
        "driverSources": ["heads/java/src/main/java/hydra/TransformJsonToTarget.java"]
      },
      "haskell": {
        "transform": "heads/haskell/bin/transform-json-to-target.sh",
        "driverSources": [
          "heads/haskell/src/exec/bootstrap-from-json",
          "heads/haskell/src/main/haskell/Hydra/Generation.hs",
          "heads/haskell/src/main/haskell/Hydra/ExtGeneration.hs",
          "heads/haskell/src/main/haskell/Hydra/PackageRouting.hs"
        ]
      }
    }
  },
  "languages": {
    "haskell":     {"sourceExtension": "hs",    "coderPackage": "hydra-haskell",    "runtimeDir": "heads/haskell"},
    "java":        {"sourceExtension": "java",  "coderPackage": "hydra-java",       "runtimeDir": "heads/java"},
    "python":      {"sourceExtension": "py",    "coderPackage": "hydra-python",     "runtimeDir": "heads/python"},
    "scala":       {"sourceExtension": "scala", "coderPackage": "hydra-scala",      "runtimeDir": "heads/scala"},
    "go":          {"sourceExtension": "go",    "coderPackage": "hydra-go",         "runtimeDir": "heads/go"},
    "typescript":  {"sourceExtension": "ts",    "coderPackage": "hydra-typescript", "runtimeDir": "heads/typescript"},
    "lisp":        {"sourceExtension": "lisp",  "coderPackage": "hydra-lisp",       "runtimeDir": "heads/lisp"},
    "clojure":     {"sourceExtension": "clj",   "coderPackage": "hydra-lisp",       "runtimeDir": "heads/lisp"},
    "scheme":      {"sourceExtension": "scm",   "coderPackage": "hydra-lisp",       "runtimeDir": "heads/lisp"},
    "common-lisp": {"sourceExtension": "lisp",  "coderPackage": "hydra-lisp",       "runtimeDir": "heads/lisp"},
    "emacs-lisp":  {"sourceExtension": "el",    "coderPackage": "hydra-lisp",       "runtimeDir": "heads/lisp"}
  },
  "group": "net.fortytwo.hydra",
  "author": "Joshua Shinavier and collaborators",
  "url": "https://github.com/CategoricalData/hydra",
  "license": "Apache-2.0",
  "packages": [
    "hydra-kernel",
    "hydra-haskell",
    "hydra-java",
    "hydra-jvm",
    "hydra-python",
    "hydra-scala",
    "hydra-go",
    "hydra-lisp",
    "hydra-coq",
    "hydra-typescript",
    "hydra-wasm",
    "hydra-build",
    "hydra-pg",
    "hydra-rdf",
    "hydra-ext",
    "hydra-bench"
  ]
}
