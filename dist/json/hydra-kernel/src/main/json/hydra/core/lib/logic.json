        "name": "hydra.core.lib.logic.and",
        "metadata": {
          "description": "Compute the logical AND of two boolean values.",
          "comments": [
            "and(p, q) returns true iff both p and q are true.",
            "Evaluation is strict in both arguments at the primitive level; for short-circuiting behavior, use ifElse.",
            "Total. Corresponds to Haskell's (&&) :: Bool -> Bool -> Bool (but without short-circuit evaluation)."],
          "seeAlso": [],
          "provisions": []},
        "signature": {
          "typeParameters": [],
          "parameters": [
            {"name": "p", "description": "the first boolean operand", "type": {"literal": "boolean"}, "isLazy": false},
            {"name": "q", "description": "the second boolean operand", "type": {"literal": "boolean"}, "isLazy": false}],
          "result": {"type": {"literal": "boolean"}}},
        "isPure": true,
        "isTotal": true,
