                  {"name": "hint", "type": "unit"}]},
              "annotation": {
                "map": [
                  {
                    "key": {"variable": "description"},
                    "value": {"literal": {"string": "The severity of a diagnostic; encoded on the wire as an integer 1-4"}}}]}}},
          "constraints": []}}},
