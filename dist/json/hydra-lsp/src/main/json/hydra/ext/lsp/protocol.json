{
  "name": "hydra.ext.lsp.protocol",
  "metadata": {
    "description": "A subset of the Language Server Protocol 3.17 types, sufficient for diagnostics and formatting. Positions are 0-based; characters are UTF-16 code units. Enumerations (e.g. DiagnosticSeverity) are unions; the JSON codec maps them to the protocol's integers (error=1, warning=2, information=3, hint=4; TextDocumentSyncKind none=0, full=1, incremental=2).",
    "comments": [],
    "seeAlso": [],
    "provisions": []},
  "dependencies": [{"module": "hydra.core.json.model"}, {"module": "hydra.core.model"}],
