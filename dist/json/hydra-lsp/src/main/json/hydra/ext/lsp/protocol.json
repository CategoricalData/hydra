      "type": {
        "name": "hydra.ext.lsp.protocol.Diagnostic",
        "body": {
          "variables": [],
          "body": {
            "annotated": {
              "body": {
                "record": [
                  {"name": "range", "type": {"variable": "hydra.ext.lsp.protocol.Range"}},
                  {"name": "severity", "type": {"optional": {"variable": "hydra.ext.lsp.protocol.DiagnosticSeverity"}}},
                  {"name": "code", "type": {"optional": {"literal": "string"}}},
                  {"name": "source", "type": {"optional": {"literal": "string"}}},
                  {"name": "message", "type": {"literal": "string"}}]},
              "annotation": {
                "map": [
                  {
                    "key": {"variable": "description"},
                    "value": {"literal": {"string": "A diagnostic, such as a compiler error or warning"}}}]}}},
